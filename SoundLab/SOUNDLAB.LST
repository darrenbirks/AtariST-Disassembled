' Sound Lab 1.1 (version string 1.11, July 28, 1993) by Damien M. Jones: an Atari ST/STE sample editor.
' Loads and saves AVR, SPL, SAM, SMP, SND and WAV samples, records from a cartridge sampler, plays through
' the YM2149 or STE DMA sound, edits blocks, loops, echo, fades, rate conversion and stereo to mono.
' Runs in medium or high resolution, from the desktop or the AUTO folder, with its own forms, menus, file
' selector and (without AES) its own mouse driver.  Needs SOUNDLAB.COL (colour) or SOUNDLAB.MON (mono).
' Start-up: startup_check checks files and memory, program_init sets everything up, program_run runs the program.
' Keep the etv_critic ($404) handler address; program_init looks at it to tell whether AES is running.
critic_vector%=LPEEK(1028)
$B+
$I+
' Reads an Intel order (little-endian) 16-bit word at address addr%.  Used for WAV and DOS disk structures.
DEFFN le_word(addr%)=BYTE{addr%}+SHL&(BYTE{addr%+1},8)
' Neither forms nor system changes exist yet, so the error handler basic_err_report prints plain text and restores
' nothing.
dlgs_ready!=FALSE
sys_changed!=FALSE
' Any runtime error shows the error number and the author's address, restores the system and ENDs.
ON ERROR GOSUB basic_err_report
startup_check
program_init
program_run
END
' Start-up checks, before anything is changed.  Takes the command line (a sample to load), then checks that
' SOUNDLAB.COL (colour) or SOUNDLAB.MON (high res) is in the current folder and that at least 150000 bytes
' are free.  On failure it prints the reason, waits for a key and ENDs back to the desktop.
' Sets command_file$ (command line), cur_rez& (resolution) and memory_top% (memory shortfall, re-used later).
PROCEDURE startup_check
  ' Command line from the basepage: length byte at +128, text at +129.
  command_file$=UPPER$(TRIM$(LEFT$(CHAR{129+BASEPAGE},BYTE{BASEPAGE+128})))
  startup_failed!=FALSE
  ' Bytes missing to the 150000 the program needs.
  memory_top%=150000-FRE(0)
  cur_rez&=XBIOS(4)
  ' Colour resolutions need SOUNDLAB.COL, high resolution SOUNDLAB.MON.
  IF cur_rez&<>2 AND (NOT @fexists("SOUNDLAB.COL"))
    PRINT "Can't find SOUNDLAB.COL.  It should be in the same folder as SOUNDLAB.TOS,"
    PRINT "or in the root if SOUNDLAB.PRG is in the AUTO folder."
    startup_failed!=TRUE
  ELSE
    IF cur_rez&=2 AND (NOT @fexists("SOUNDLAB.MON"))
      PRINT "Can't find SOUNDLAB.MON.  It should be in the same folder as SOUNDLAB.TOS,"
      PRINT "or in the root if SOUNDLAB.PRG is in the AUTO folder."
      startup_failed!=TRUE
    ELSE
      IF memory_top%>0
        PRINT "Need AT LEAST another ";(memory_top%+1023) DIV 1024;"K to run Sound Lab."
        startup_failed!=TRUE
      ENDIF
    ENDIF
  ENDIF
  IF startup_failed!
    PRINT
    PRINT "Press any key to return to the Desktop."
    ~INP(2)
    END
  ENDIF
RETURN
' Program set-up.  Places all machine-code helpers (INLINE blocks), checks TOS version, DMA sound and AES,
' installs its own mouse driver when no GEM mouse is available, sets the palette and screen, builds the
' memory layout (work buffer, sample memory, title picture), loads SOUNDLAB.COL/MON and SOUNDLAB.PRF,
' sets the rate and draws the main screen.  On a bad set-up file it restores the system and ENDs.
' Memory layout of sample_buf_arr|(): work buffer 10240 (scratch_addr%), sample memory memory_top% bytes (sample_base%), then the
' title picture (20674 bytes, 20800 reserved).
PROCEDURE program_init
  ' Machine code and data blocks.  font_main% font, mform_busy%/arrow_form% mouse forms, panel_image%/panel_image_alt% button strips,
  ' serial_coded% serial number, dissolve_masks%/dissolve_out_tab% dissolve masks, volume_tables% volume tables, icon_note%..icon_stop% alert icons,
  ' font_mono% mono font, code_byte_map%..code_downsample% sample routines, asm_microwire% Microwire, pointer_vbl_code%/asm_mouse_packet%/asm_mouse_vbl_mono% mouse driver.
  INLINE font_main%,2634
  INLINE mform_busy%,74
  ' panel_image%, panel_image_alt%, icon_note%, icon_question% and icon_stop% are empty here and filled from SOUNDLAB.COL/MON below.
  INLINE panel_image%,2270
  INLINE panel_image_alt%,2270
  INLINE serial_coded%,14
  INLINE dissolve_masks%,144
  INLINE dissolve_out_tab%,144
  INLINE volume_tables%,25856
  INLINE arrow_form%,74
  INLINE icon_note%,518
  INLINE icon_question%,518
  INLINE icon_stop%,518
  INLINE font_mono%,4666
  INLINE code_byte_map%,92
  INLINE asm_reverse%,28
  INLINE code_sign_flip%,82
  INLINE asm_echo_checked%,116
  INLINE raster_code%,434
  INLINE code_fill%,90
  INLINE dissolve_code%,74
  INLINE asm_echo_fast%,102
  INLINE code_mix%,86
  INLINE pointer_vbl_code%,952
  INLINE asm_mouse_packet%,116
  INLINE asm_input_scope%,196
  INLINE code_halve%,32
  INLINE code_double%,36
  INLINE code_upsample%,76
  INLINE code_downsample%,120
  INLINE asm_microwire%,78
  INLINE asm_mouse_vbl_mono%,1334
  ' Buffer in which msgbox_show builds alert forms.
  DIM msgbox_tree_buf|(1023)
  msgbox_tree_buf%=V:msgbox_tree_buf|(0)
  DIM msgbox_part$(8)
  DIM acc_menu$(10)
  ' Menu bar strings (Desk / Done with ACCs) for the GEM menu shown while desk accessories run.
  FOR ix&=0 TO 10
    READ acc_menu$(ix&)
  NEXT ix&
  ' XBIOS 34 Kbdvbase: +16 is mousevec.  If it points at an RTS ($4E75) no GEM mouse driver is installed
  ' (started from the AUTO folder), so the program uses its own mouse driver (own_pointer!).
  vec_mouse_addr%=16+XBIOS(34)
  own_pointer!=FALSE
  IF DPEEK(LPEEK(vec_mouse_addr%))=20085
    own_pointer!=TRUE
  ENDIF
  own_mouse_start!=own_pointer!
  ' DMA sound: TOS 1.06 or later (sysbase $4F2 version word) and a '_SND' cookie with bit 1 (STE DMA) set.
  dma_sound!=DPEEK(LPEEK(1266)+2)>=262
  ' Default 4-colour palette: $777 white, $445, $223, $000 black.
  palette$=MKI$(1911)+MKI$(1093)+MKI$(547)+MKI$(0)
  IF dma_sound!
    dma_sound!=FALSE
    cookie_ptr%=LPEEK(1440)
    WHILE LPEEK(cookie_ptr%)<>0
      IF LPEEK(cookie_ptr%)=1599295044
        dma_sound!=BTST(LPEEK(cookie_ptr%+4),1)
      ENDIF
      ADD cookie_ptr%,8
    WEND
  ENDIF
  ' Busy mouse form as a string for DEFMOUSE.
  mform_busy_str$=SPACE$(74)
  BMOVE mform_busy%,V:mform_busy_str$,74
  ' Start path from GEMDOS Dgetdrv and the current folder.
  home_path$=CHR$(65+GEMDOS(25))+":"+DIR$(0)+"\"
  ' Save the $118 MFP ACIA (IKBD/MIDI) vector and the conterm byte ($484) for sys_restore.
  saved_vec_118%=LPEEK(280)
  saved_conterm&=PEEK(1156)
  ' Save the 16 colours of the desktop palette.
  palette_read(saved_palette$)
  ' Fill patterns: $FFFFFFFF solid, $AAAA5555 grey, $5555FFFF dark.
  pattern_solid%=-1
  pattern_grey%=-1431677611
  pattern_light%=1431699455
  ' XBIOS 3 Logbase and XBIOS 4 Getrez.  Low resolution is switched to medium (XBIOS 5 Setscreen), and then
  ' the own mouse driver is used too, as the GEM mouse does not know the new resolution.
  screen_addr%=XBIOS(3)
  start_rez&=XBIOS(4)
  IF start_rez&<>1 AND start_rez&<>2
    ~XBIOS(5,L:-1,L:-1,1)
    own_pointer!=TRUE
  ENDIF
  mono!=start_rez&=2
  removable_mouse!=TRUE
  ' High resolution uses the monochrome font and the mono mouse drawer.
  IF mono!
    font_main%=font_mono%
  ENDIF
  IF mono!
    pointer_vbl_code%=asm_mouse_vbl_mono%
  ENDIF
  ' Mouse drawer data: +4 screen, +8 saved background address (none), +24/26 pointer x/y, +156/158 last drawn
  ' x/y.  Packet handler asm_mouse_packet%: +4/+6 x/y, +8 buttons, +10 where to copy x/y (the drawer's +24).
  LONG{pointer_vbl_code%+4}=screen_addr%
  CARD{asm_mouse_packet%+4}=320
  CARD{asm_mouse_packet%+6}=100
  BYTE{asm_mouse_packet%+8}=0
  LONG{asm_mouse_packet%+10}=pointer_vbl_code%+24
  LONG{pointer_vbl_code%+8}=0
  CARD{pointer_vbl_code%+24}=320
  CARD{pointer_vbl_code%+26}=100
  CARD{pointer_vbl_code%+156}=320
  CARD{pointer_vbl_code%+158}=100
  ' The packet handler clamps y with immediate operands at +78 and +86: 399 in high res, else 199.
  IF mono!
    CARD{asm_mouse_packet%+78}=399
    CARD{asm_mouse_packet%+86}=399
    CARD{pointer_vbl_code%+26}=200
    CARD{pointer_vbl_code%+158}=200
    CARD{asm_mouse_packet%+6}=200
  ELSE
    CARD{asm_mouse_packet%+78}=199
    CARD{asm_mouse_packet%+86}=199
  ENDIF
  ' Own mouse: hook the packet handler into mousevec and the pointer drawer into a free VBL queue slot.
  IF own_pointer!
    removable_mouse!=FALSE
    saved_mousevec%=LPEEK(vec_mouse_addr%)
    SLPOKE vec_mouse_addr%,asm_mouse_packet%
    vbl_install(pointer_vbl_code%,vbl_slot%)
  ENDIF
  ' BIOS 11 Kbshift: clear Caps Lock.  XBIOS 6 Setpalette with the program palette.
  ~BIOS(11,BCLR(BIOS(11,-1),4))
  ~XBIOS(6,L:V:palette$)
  sys_changed!=TRUE
  ' Convert the font header to Motorola order and add it to the font chain as font 3.
  font_convert_intel(font_main%,3)
  ' VDI pen to hardware colour table, then show the busy mouse.
  vdi_colour_map_init
  pointer_hide
  pointer_busy(1)
  CLS
  ' Draw the "Loading, please wait..." screen: title line and patterned background.
  IF mono!
    ACLIP 1,0,0,639,399
    font_attr_set(0,0,0,0,3)
    font_attr_set(1,0,0,6,0)
    txt_centred(320,15,"Loading, please wait...",font_main%)
    ACLIP 1,0,0,639,399
    ARECT 0,20,639,21,1,0,V:pattern_grey%,1
    ARECT 0,22,639,25,3,0,V:pattern_solid%,1
    ARECT 0,26,639,399,1,0,V:pattern_light%,1
    ARECT 0,26,3,399,3,0,V:pattern_solid%,1
  ELSE
    ACLIP 1,0,0,639,199
    font_attr_set(0,0,0,0,3)
    font_attr_set(1,0,0,6,0)
    txt_centred(320,7,"Loading, please wait...",font_main%)
    ACLIP 1,0,0,639,199
    HLINE 0,10,639,1,0,V:pattern_solid%,1
    ARECT 0,11,639,12,3,0,V:pattern_solid%,1
    ARECT 0,13,639,199,2,0,V:pattern_solid%,1
    ARECT 0,13,3,199,3,0,V:pattern_solid%,1
  ENDIF
  ' Show the mouse again, then set up the own menu bar and the file handle tables.
  pointer_show
  mnu_build
  channel_table_init
  ' Colour only: 8 palettes for the title picture fade, filled by palette_fade_build.
  IF NOT mono!
    DIM fade_palettes$(7)
    FOR ix&=0 TO 7
      fade_palettes$(ix&)=SPACE$(32)
    NEXT ix&
  ENDIF
  ' One semitone, 2^(1/12), for the rate dialog semitone buttons.
  semitone=2^.0833333333333335
  shift_mode!=FALSE
  ' Microwire (LMC1992) defaults: master 40, left 20, right 20, treble 6, bass 6.
  mw_master&=40
  mw_left&=20
  mw_right&=20
  mw_bass&=6
  mw_treble&=6
  ' Version 1.1 preferences: file selector type, sampler offset, save/load formats for unknown extensions.
  fsel_type&=0
  opt_sampler_port&=0
  opt_save_format&=2
  opt_load_format&=0
  opt_signed_default!=FALSE
  ' etv_critic still points at the BIOS default "moveq #-1,d0 / rts" ($70FF4E75): AES is not running.
  no_aes!=LPEEK(critic_vector%)=1895779957
  no_aes!=own_pointer! OR no_aes!
  ' Take all memory but 98000 bytes, a multiple of 320 (one waveform page), and clear it to 128 (silence).
  memory_top%=FRE(0)-98000
  memory_top%=memory_top%-MOD(memory_top%,320)
  DIM sample_buf_arr|(memory_top%)
  memory_top%=memory_top%+-1280
  ' Work buffer first (10240 bytes), sample memory after it; the end is kept for the title picture (20800).
  sample_base%=V:sample_buf_arr|(0)
  scratch_addr%=sample_base%
  sample_base%=sample_base%+10240
  memory_top%=memory_top%+-10240
  memory_top%=memory_top%+-20800
  sample_loop_start%=0
  sample_loop_end%=memory_top%
  sample_loop_on!=FALSE
  ' The block and the sample cover the whole memory; the copy buffer at the end is empty.
  block_start%=0
  block_end%=memory_top%
  sample_end%=memory_top%
  buffer_start%=memory_top%
  zoom&=0
  all_selected!=FALSE
  ARRAYFILL sample_buf_arr|(),128
  sample_path$=""
  sample_file_offset%=0
  partial_loaded!=FALSE
  block_path$=""
  buffer_file_offset%=0
  ' Table 100 of the volume tables: the identity table used for playing.
  output_table%=volume_tables%+25600
  fade_shape&=0
  selector_folder$=""
  echo_path$=""
  disk_path$=""
  ' The shareware reminder appears after 60000 ticks (5 minutes at 200 Hz), then sooner each time.
  nag_interval%=60000
  nag_deadline%=TIMER
  setup_file$="SOUNDLAB.COL"
  IF mono!
    setup_file$="SOUNDLAB.MON"
  ENDIF
  ' Read the set-up file: title picture into the end of the buffer, the 3 alert icons, the 2 button strips,
  ' and the rest (file size - 26768) as the forms.  Any error leaves startup_failed! TRUE.
  length_bytes%=@fsize_of(setup_file$)
  startup_failed!=TRUE
  IF @fopen_channel("I",1,setup_file$)=0
    IF @fread_channel(1,sample_base%+memory_top%,20674)=0
      IF @fread_channel(1,icon_note%,518)=0
        IF @fread_channel(1,icon_question%,518)=0
          IF @fread_channel(1,icon_stop%,518)=0
            IF @fread_channel(1,panel_image%,2270)=0
              IF @fread_channel(1,panel_image_alt%,2270)=0
                length_bytes%=length_bytes%+-26768
                DIM rsc_arr|(length_bytes%)
                rsc_buffer%=V:rsc_arr|(0)
                IF @fread_channel(1,rsc_buffer%,length_bytes%)=0
                  ~@fclose_channel(1)
                  startup_failed!=FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' Bad set-up file: restore the system and quit.
  IF startup_failed!
    CLS
    PRINT "Error with file ";setup_file$;"."
    PRINT
    PRINT "Press any key to exit."
    ~INP(2)
    sys_restore
    END
  ENDIF
  ' Palette of the title picture: 32 bytes after a 2-byte header.
  title_palette$=SPACE$(32)
  BMOVE sample_base%+memory_top%+2,V:title_palette$,32
  ' Set up the forms, the own file selector, the player code, and the main window scroll bar.
  rsc_init(rsc_buffer%)
  dlgs_ready!=TRUE
  filesel_init
  player_code_setup
  slider_setup(4,26,0,memory_top%/320,-1,1,0,memory_top%/320)
  ' Off-screen copy at a 256-byte boundary in the work buffer (it runs into the sample start, so it is only
  ' used before a sample is loaded and when quitting).  XBIOS 5 makes it the logical screen.
  screen_back%=255+scratch_addr% AND 16776960
  ~XBIOS(5,L:screen_back%,L:screen_addr%,-1)
  ' Preference defaults: YM output, no file info, line waveform, fade preview from sample, seconds, zoom boxes,
  ' menus on hover, ask when a file exists, 9600 Hz.
  output_device&=0
  info_on!=FALSE
  trace_style&=1
  opt_preview_sample&=1
  seconds_on!=TRUE
  zoom_enabled!=TRUE
  menu_click_opt!=FALSE
  exists_option&=2
  default_rate&=9600
  ' SOUNDLAB.PRF, 1278 bytes: "SoundLab1.0Prefs" or "SoundLab1.1Prefs", palette (8), then words.  After the
  ' first 8 characters are cut off, +16 output, +18 file info, +20 waveform style, +22 fade preview,
  ' +24 seconds, +26 zoom boxes, +28 menu click, +30 file exists, +32 rate, +34..+42 Microwire,
  ' +44 8 file selector masks of 80 bytes, then the 1.1 words at +684, then 16-byte form positions.
  IF @fexists("SOUNDLAB.PRF")<>0
    work_text$=SPACE$(1278)
    IF @fopen_channel("I",1,"SOUNDLAB.PRF")=0
      IF @fread_channel(1,V:work_text$,1278)=0
        IF @fclose_channel(1)=0
          ' REPEAT ... EXIT IF ... UNTIL TRUE skips the rest of the block when the file header is wrong.
          REPEAT
            EXIT IF (LEFT$(work_text$,16)<>"SoundLab1.0Prefs") AND (LEFT$(work_text$,16)<>"SoundLab1.1Prefs")
            palette$=MID$(work_text$,17,8)
            work_text$=MID$(work_text$,9)
            ~XBIOS(6,L:V:palette$)
            output_device&=INT{V:work_text$+16}
            info_on!=INT{V:work_text$+18}
            trace_style&=INT{V:work_text$+20}
            opt_preview_sample&=INT{V:work_text$+22}
            seconds_on!=INT{V:work_text$+24}
            zoom_enabled!=INT{V:work_text$+26}
            menu_click_opt!=INT{V:work_text$+28}
            exists_option&=INT{V:work_text$+30}
            default_rate&=INT{V:work_text$+32}
            mw_master&=INT{V:work_text$+34}
            mw_left&=INT{V:work_text$+36}
            mw_right&=INT{V:work_text$+38}
            mw_bass&=INT{V:work_text$+40}
            mw_treble&=INT{V:work_text$+42}
            obj_ofs&=44
            ' File selector (form 2) objects 13 to 20: user file masks, 80 characters each.
            FOR ix&=13 TO 20
              obj_find(2,ix&,work_long%)
              BMOVE obj_ofs&+V:work_text$,16+(rsc_data%+LONG{work_long%+24}),80
              obj_ofs&=obj_ofs&+80
            NEXT ix&
            y_or_j&=35
            obj_ofs&=684
            ' Version 1.1 adds 5 words and 23 more form positions (forms 36-57 are skipped).
            IF LEFT$(work_text$,8)="1.1Prefs"
              opt_sampler_port&=INT{V:work_text$+684}
              fsel_type&=INT{V:work_text$+686}
              opt_load_format&=INT{V:work_text$+688}
              opt_save_format&=INT{V:work_text$+690}
              opt_signed_default!=INT{V:work_text$+692}
              obj_ofs&=obj_ofs&+10
              y_or_j&=58
            ENDIF
            ' Saved form positions (16 bytes each); all zero means none saved.  High res doubles y and height.
            FOR ix&=1 TO y_or_j&
              IF ix&=36
                ix&=58
              ENDIF
              IF LONG{obj_ofs&+V:work_text$} OR LONG{obj_ofs&+V:work_text$+4} OR LONG{obj_ofs&+V:work_text$+8} OR LONG{obj_ofs&+V:work_text$+12}
                tree_find(ix&,work_long%)
                IF work_long%<tree_end%
                  BMOVE obj_ofs&+V:work_text$,work_long%+4,16
                  IF mono!
                    CARD{work_long%+6}=MUL(INT{work_long%+6},2)
                    CARD{work_long%+14}=MUL(INT{work_long%+14},2)+1
                  ENDIF
                ENDIF
              ENDIF
              obj_ofs&=obj_ofs&+16
            NEXT ix&
          UNTIL TRUE
        ENDIF
      ENDIF
    ENDIF
    work_text$=""
  ENDIF
  ' Without AES the GEM file selector cannot be used.
  IF no_aes!
    fsel_type&=0
  ENDIF
  rate_from_prefs!=FALSE
  ' Start at the default rate, snapped to 614400/n Hz, and put it into the rate dialog (form 6 object 15).
  sample_rate&=default_rate&
  sample_rate&=614400/sample_rate&+.5
  sample_rate&=DIV(614400,sample_rate&)
  work_text$=STR$(sample_rate&/1000)
  work_text$=LEFT$(work_text$+"      ",6)
  obj_find(6,15,work_long%)
  BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
  choice&=1
  rate_timer_calc
  ' Cartridge sampler: reading $FB0001 (minus the offset) returns the converter value.
  cart_input%=16449537-opt_sampler_port&
  ' Never read anywhere.
  flag_7b2_unused!=TRUE
  ' Draw the main screen and its status fields.
  sample_filename$="UNTITLED.AVR"
  memory_size_draw
  status_zoom_draw
  echo_filename$="UNTITLED.EKO"
  screen_frame_draw
  status_name_draw
  status_block_draw
  memory_size_draw
  status_zoom_draw
  menubar_width&=315
  serial_number$=SPACE$(14)
  ' Decode the serial number (XOR 250) and put it into the Shareware form (27, object 99).
  BMOVE serial_coded%,V:serial_number$,14
  serial_decode
  obj_find(27,99,obj_found%)
  BMOVE V:serial_number$,12+(rsc_data%+LONG{obj_found%+24}),14
  ' MODE 1 sets the DATE$ format used in the "Saved from" text that goes into saved AVR headers.
  MODE 1
  saved_from_text$="Saved from Sound Lab 1.1, program "+TRIM$(serial_number$)+", "+DATE$+"."
  ' Colour: raster_code% mode 0 installs the idle Timer B handler (title raster split off).
  IF NOT mono!
    CARD{raster_code%+4}=0
    ~XBIOS(38,L:raster_code%)
    VSYNC
    VSYNC
  ENDIF
RETURN
' Runs the program: places the 16 drive entries of the Free Space menu (2 7) in a 4x4 grid, disables
' drives that do not exist, then runs the main window (form 4) in dialog_run until Quit, and finally
' restores the system state.
PROCEDURE program_run
  ' Drive submenu box, then the entries A: to P:, each 24x8 pixels.
  mnu_sub_rect("2 7",84,8,96,32)
  mnu_item_rect("2 7 1",0,0,24,8)
  mnu_item_rect("2 7 2",24,0,24,8)
  mnu_item_rect("2 7 3",48,0,24,8)
  mnu_item_rect("2 7 4",72,0,24,8)
  mnu_item_rect("2 7 5",0,8,24,8)
  mnu_item_rect("2 7 6",24,8,24,8)
  mnu_item_rect("2 7 7",48,8,24,8)
  mnu_item_rect("2 7 8",72,8,24,8)
  mnu_item_rect("2 7 9",0,16,24,8)
  mnu_item_rect("2 7 10",24,16,24,8)
  mnu_item_rect("2 7 11",48,16,24,8)
  mnu_item_rect("2 7 12",72,16,24,8)
  mnu_item_rect("2 7 13",0,24,24,8)
  mnu_item_rect("2 7 14",24,24,24,8)
  mnu_item_rect("2 7 15",48,24,24,8)
  mnu_item_rect("2 7 16",72,24,24,8)
  ' Without AES the Accessories entry of the Desk menu is disabled.
  IF no_aes!
    mnu_item_disable("1 3")
  ENDIF
  ' BIOS 10 Drvmap; with one floppy ($4A6 _nflops = 1) drive B is not real.
  drive_map&=BIOS(10)
  IF DPEEK(1190)=1
    SUB drive_map&,2
  ENDIF
  FOR ix&=0 TO 15
    IF (BTST(drive_map&,ix&))=FALSE
      mnu_item_disable("2 7 "+STR$(ix&+1))
    ENDIF
  NEXT ix&
  pointer_hide
  pointer_busy(0)
  pointer_show
  ' Main window event loop; returns when the program quits.
  dialog_run(4,choice&)
  sys_restore
RETURN
' Restores the system state for exit: removes the own mouse driver (VBL slot, mousevec), removes the font
' from the chain, restores the $118 vector, the resolution, the palette and the conterm byte.
PROCEDURE sys_restore
  ' Clear the VBL queue slot and put the old mousevec back.
  IF own_pointer!
    SLPOKE vbl_slot%,0
    SLPOKE vec_mouse_addr%,saved_mousevec%
  ENDIF
  font_restore_intel(font_main%)
  SLPOKE 280,saved_vec_118%
  ' Back to the start resolution if it was changed.
  IF start_rez&<>XBIOS(4)
    ~XBIOS(5,L:-1,L:-1,start_rez&)
  ENDIF
  ~XBIOS(6,L:V:saved_palette$)
  VSYNC
  SPOKE 1156,saved_conterm&
RETURN
' Handles a click on object obj_num& of form dialog_id& at form position origin_x&,origin_y&.  Form 4 is the main
' window (play, record, zoom, block editing, effects, load/save, quit); the other forms call their dialog
' handlers.  shift_mode! (Shift held) selects the alternate meaning of several buttons.
PROCEDURE action_dispatch(dialog_id&,obj_num&,origin_x&,origin_y&)
  LOCAL saved_inset_top&,saved_inset_bottom&
  $S&
  ' Form 4 main window buttons: 1 play, 2 monitor, 3 record, 4 rate, 5/6 zoom in/out, 7 select whole file,
  ' 8 cut, 9 copy, 10 clear, 11 insert, 12 overlay, 13 amplify, 14 remove/trim, 15 loop, 16 fade, 17 echo,
  ' 18 reverse, 19 sign, 20 load, 21 save, 22 help, 23 prefs/sound, 24 quit, 25-27 scroll, 28 waveform.
  SELECT dialog_id&
  CASE 4
    $S<
    SELECT obj_num&
    CASE 1
      ' Play.
      sample_play
    CASE 2
      ' Monitor (input display, or with Shift play-through).
      input_monitor
    CASE 3
      ' Record.
      sample_record
    CASE 4
      ' Rate: convert the block, or take the rate from the rate dialog and redraw.
      IF choice&=3
        block_rate_convert(0)
      ELSE
        rate_timer_calc
        status_zoom_draw
        memory_size_draw
        status_block_draw
      ENDIF
    CASE 5
      ' Zoom in one step (Shift: to 1x), not below the zoom the file length allows.
      prev_zoom&=zoom&
      IF zoom&<5
        IF shift_mode!
          zoom&=5
        ELSE
          INC zoom&
          IF zoom&<zoom_max&
            zoom&=zoom_max&
          ENDIF
        ENDIF
        zoom_apply
        status_zoom_draw
      ENDIF
    CASE 6
      ' Zoom out one step (Shift: whole file).
      prev_zoom&=zoom&
      IF zoom&>0
        IF shift_mode!
          zoom&=0
        ELSE
          DEC zoom&
          IF zoom&<zoom_max&
            zoom&=0
          ENDIF
        ENDIF
        zoom_apply
        status_zoom_draw
      ENDIF
    CASE 7
      ' Select whole file: save the block and mark the whole sample; a second click brings the old block back.
      IF all_selected!=FALSE
        all_selected!=TRUE
        saved_block_start%=block_start%
        saved_block_end%=block_end%
        block_start%=0
        block_end%=sample_end%
        trace_draw
        overview_bar_draw
        status_block_draw
        all_button_down
      ELSE
        all_selected!=FALSE
        block_start%=saved_block_start%
        block_end%=saved_block_end%
        trace_draw
        overview_bar_draw
        status_block_draw
        all_button_up
      ENDIF
    CASE 8
      ' Cut.
      block_cut
    CASE 9
      ' Copy.
      block_copy
    CASE 10
      ' Clear (block, buffer or everything).
      block_clear_gap
    CASE 11
      ' Insert file or buffer.
      block_insert
    CASE 12
      ' Overlay: with Shift from a file chosen in the file selector, else from the copy buffer.
      IF shift_mode!
        IF block_end%>block_start%
          saved_filename$=sample_filename$
          filesel_title_set("Overlay which sample?")
          filesel_run("*.AVR|*.SPL|*.SAM",selector_folder$,sample_filename$,ok_flag!)
          IF ok_flag!
            IF @fexists(selector_folder$+sample_filename$)<>0
              dialog_run(11,choice&)
              IF choice&=1
                overlay_mix
              ENDIF
            ENDIF
          ENDIF
          sample_filename$=saved_filename$
        ENDIF
      ELSE
        IF block_end%>block_start% AND memory_top%>buffer_start%
          dialog_run(11,choice&)
          IF choice&=1
            overlay_mix
          ENDIF
        ENDIF
      ENDIF
    CASE 13
      ' Amplify.
      volume_apply
    CASE 14
      ' Shift: trim to the block, else remove the block.
      IF shift_mode!
        block_trim
      ELSE
        block_remove
      ENDIF
    CASE 15
      ' Loop.
      sample_loop_menu
    CASE 16
      ' Fade.
      fade_apply
    CASE 17
      ' Echo dialog (form 14) with no button frame offsets; the echo is applied when it returns 1.
      saved_inset_top&=cursor_top&
      saved_inset_bottom&=cursor_bottom&
      cursor_top&=-1
      cursor_bottom&=0
      dialog_run(14,choice&)
      IF choice&=1 AND block_end%>block_start%
        echo_dialog_event
      ENDIF
      cursor_top&=saved_inset_top&
      cursor_bottom&=saved_inset_bottom&
    CASE 18
      ' Reverse.
      block_reverse
    CASE 19
      ' Sign flip (signed <-> unsigned).
      block_sign_flip
    CASE 20
      ' Load.
      sample_loader
    CASE 21
      ' Save.
      sample_saver
    CASE 22
      ' Help.
      help_menu
    CASE 23
      ' Shift: STE sound (Microwire) dialog, else the preferences.
      IF shift_mode!
        microwire_dialog_event
      ELSE
        prefs_dialog_event
      ENDIF
    CASE 24
      ' Quit.
      program_quit
    CASE 25 TO 27
      ' Scroll bar arrows: with Shift jump to the block start (25) or block end (27); 26 is the slider.
      IF shift_mode! AND obj_num&<>26
        slider_value_query(4,26,slider_value&,slider_size&)
        IF obj_num&=25
          slider_value&=block_start%/320
        ELSE
          slider_value&=PRED(block_end%/320)
        ENDIF
        IF slider_value&+slider_size&>DIV(sample_end%,320)
          slider_value&=sample_end%/320-slider_size&
        ENDIF
        IF slider_value&<0
          slider_value&=0
        ENDIF
        slider_set_pos(4,26,slider_value&,slider_size&)
        obj_find(4,26,work_ptr%)
        dialog_object_draw(work_ptr%,0,0,-1)
        trace_draw
      ELSE
        trace_draw
      ENDIF
    CASE 28
      ' Click in the waveform: mark a block with the mouse.
      block_mark_mouse
    CASE 29
      ' Sends 'p' and 'A' or 'Z' as keypresses for the keyboard handler.
      KEYPRESS 112
    CASE 30
      IF zoom&>0
        KEYPRESS 65
      ELSE
        KEYPRESS 90
      ENDIF
    ENDSELECT
  CASE 6
    ' Form 6: rate dialog.
    rate_dialog_handle
  CASE 8
    ' Form 8: amplify dialog.
    volume_dialog
  CASE 11
    ' Form 11: overlay dialog.
    overlay_dialog
  CASE 12
    ' Form 12: fade dialog.
    fade_dialog_event
  CASE 14
    ' Form 14: echo dialog.
    echo_dialog_event
  CASE 15
    ' Form 15: load block dialog.
    partial_dialog_events
  CASE 16
    ' Form 16: preferences dialog.
    prefs_dialog_event
  CASE 35
    ' Form 35: STE sound dialog.
    microwire_dialog_event
  ENDSELECT
RETURN
' Draws the visible part of the sample into the waveform area (y 48-303 in high res, 24-151 in colour),
' 640 pixels from scroll position slider_value& (pages of 320 bytes), slider_size&/2 bytes per pixel.  The loop is
' shown as a dotted frame, the block solid and the rest dotted (high res) or in colour 3 against colour 1.
' Style trace_style&: 1 lines, 2 bars from the centre line, else dots.  src_pos% and step_bytes% are not used.
PROCEDURE trace_draw
  LOCAL ix&,src_pos%,step_bytes%,y_centre&,offs_f,px_step_f,frame_left%,frame_right%,dot_style&
  ' Scroll position and width from the main window slider (form 4 object 26).
  slider_value_query(4,26,slider_value&,slider_size&)
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  dot_style&=21845
  offs_f=slider_value&*320
  px_step_f=slider_size&/2
  ' High resolution: centre line 176, sample byte added to 48.
  IF mono!
    ARECT 0,48,639,303,0,0,V:pattern_solid%,1
    ' Loop frame; at zoom Max the whole file fits, else only the parts of the frame that are on screen.
    IF sample_loop_on!
      IF zoom&=0
        frame_draw(sample_loop_start%*640/sample_end%,48,PRED(sample_loop_end%*640/sample_end%),303,1,0,dot_style&)
      ELSE
        frame_left%=(sample_loop_start%-offs_f) DIV px_step_f
        frame_right%=(sample_loop_end%-offs_f) DIV px_step_f-1
        IF frame_left%>=0 AND frame_left%<=639 AND frame_right%>=0 AND frame_right%<=639
          frame_draw(frame_left%,48,frame_right%,303,1,0,dot_style&)
        ELSE
          IF frame_left%>=0 AND frame_left%<=639
            HLINE frame_left%,48,639,1,0,V:dot_style&,0
            HLINE frame_left%,303,639,1,0,V:dot_style&,0
            ALINE frame_left%,49,frame_left%,302,1,dot_style&,0
          ELSE
            IF frame_right%>=0 AND frame_right%<=639
              HLINE 0,48,frame_right%,1,0,V:dot_style&,0
              HLINE 0,303,frame_right%,1,0,V:dot_style&,0
              ALINE frame_right%,49,frame_right%,302,1,dot_style&,0
            ELSE
              IF frame_left%<0 AND frame_right%>639
                HLINE 0,48,639,1,0,V:dot_style&,0
                HLINE 0,303,639,1,0,V:dot_style&,0
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' Lines from each sample to the next.
    IF trace_style&=1
      HLINE 0,176,639,1,0,V:pattern_solid%,1
      FOR ix&=0 TO 638
        IF offs_f>=block_start% AND offs_f<=block_end%
          y_centre&=-1
        ELSE
          y_centre&=dot_style&
        ENDIF
        ALINE ix&,48+BYTE{ADD(offs_f,sample_base%)},SUCC(ix&),48+BYTE{offs_f+sample_base%+px_step_f},1,y_centre&,0
        offs_f=offs_f+px_step_f
      NEXT ix&
    ELSE
      ' Bars from the centre line; outside the block every other bar is dotted.
      IF trace_style&=2
        FOR ix&=0 TO 639
          IF offs_f>=block_start% AND offs_f<=block_end%
            y_centre&=-1
          ELSE
            y_centre&=dot_style&
            dot_style&=NOT dot_style&
          ENDIF
          ALINE ix&,176,ix&,48+BYTE{ADD(offs_f,sample_base%)},1,y_centre&,0
          offs_f=offs_f+px_step_f
        NEXT ix&
      ELSE
        ' Dots.
        HLINE 0,176,639,1,0,V:pattern_solid%,1
        FOR ix&=0 TO 639
          IF offs_f>=block_start% AND offs_f<=block_end%
            y_centre&=1
          ELSE
            y_centre&=ODD(ix&)
          ENDIF
          PSET ix&,48+BYTE{ADD(offs_f,sample_base%)},y_centre&
          offs_f=offs_f+px_step_f
        NEXT ix&
      ENDIF
    ENDIF
  ELSE
    ' Colour: centre line 88, sample byte /2 added to 24.
    ARECT 0,24,639,151,0,0,V:pattern_solid%,1
    IF sample_loop_on!
      IF zoom&=0
        frame_draw(sample_loop_start%*640/sample_end%,24,PRED(sample_loop_end%*640/sample_end%),151,2,0,dot_style&)
      ELSE
        frame_left%=(sample_loop_start%-offs_f) DIV px_step_f
        frame_right%=(sample_loop_end%-offs_f) DIV px_step_f-1
        IF frame_left%>=0 AND frame_left%<=639 AND frame_right%>=0 AND frame_right%<=639
          frame_draw(frame_left%,24,frame_right%,151,2,0,dot_style&)
        ELSE
          IF frame_left%>=0 AND frame_left%<=639
            HLINE frame_left%,24,639,2,0,V:dot_style&,0
            HLINE frame_left%,151,639,2,0,V:dot_style&,0
            ALINE frame_left%,25,frame_left%,150,2,dot_style&,0
          ELSE
            IF frame_right%>=0 AND frame_right%<=639
              HLINE 0,24,frame_right%,2,0,V:dot_style&,0
              HLINE 0,151,frame_right%,2,0,V:dot_style&,0
              ALINE frame_right%,25,frame_right%,150,2,dot_style&,0
            ELSE
              IF frame_left%<0 AND frame_right%>639
                HLINE 0,24,639,2,0,V:dot_style&,0
                HLINE 0,151,639,2,0,V:dot_style&,0
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    IF trace_style&=1
      HLINE 0,88,639,1,0,V:pattern_solid%,1
      FOR ix&=0 TO 638
        IF offs_f>=block_start% AND offs_f<=block_end%
          y_centre&=3
        ELSE
          y_centre&=1
        ENDIF
        ALINE ix&,24+DIV(BYTE{ADD(offs_f,sample_base%)},2),SUCC(ix&),24+DIV(BYTE{offs_f+sample_base%+px_step_f},2),y_centre&,-1,0
        offs_f=offs_f+px_step_f
      NEXT ix&
    ELSE
      IF trace_style&=2
        FOR ix&=0 TO 639
          IF offs_f>=block_start% AND offs_f<=block_end%
            y_centre&=3
          ELSE
            y_centre&=1
          ENDIF
          ALINE ix&,88,ix&,24+DIV(BYTE{ADD(offs_f,sample_base%)},2),y_centre&,-1,0
          offs_f=offs_f+px_step_f
        NEXT ix&
      ELSE
        HLINE 0,88,639,1,0,V:pattern_solid%,1
        FOR ix&=0 TO 639
          IF offs_f>=block_start% AND offs_f<=block_end%
            y_centre&=3
          ELSE
            y_centre&=1
          ENDIF
          PSET ix&,24+DIV(BYTE{ADD(offs_f,sample_base%)},2),y_centre&
          offs_f=offs_f+px_step_f
        NEXT ix&
      ENDIF
    ENDIF
  ENDIF
  pointer_show
RETURN
' Draws the block length at the right of the status line ("Block: n sec" or bytes) and, when file info is
' on (info_on!), "File: nK" and "Offset:" (block start).  High res draws a shadow text first.
PROCEDURE status_block_draw
  LOCAL y_or_j&,work_ptr%,work_text$
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF mono!
    y_or_j&=43
    ARECT 488,30,639,45,1,0,V:pattern_grey%,1
    HLINE 488,46,639,0,0,V:pattern_solid%,0
  ELSE
    y_or_j&=21
    ARECT 488,15,639,22,1,0,V:pattern_solid%,1
  ENDIF
  ' Block length, in seconds at the current rate or in bytes ("Blk:" when it would not fit).
  work_ptr%=ABS(block_end%-block_start%)
  IF seconds_on!
    work_text$="Block: "+TRIM$(STR$(work_ptr%/sample_rate&,7,3))+" sec"
  ELSE
    IF work_ptr%<1000000
      work_text$="Block: "+STR$(work_ptr%)+" bytes"
    ELSE
      work_text$="Blk: "+STR$(work_ptr%)+" bytes"
    ENDIF
  ENDIF
  font_attr_set(0,0,0,0,3)
  wrmode_set(2)
  IF mono!
    font_attr_set(1,0,0,6,0)
    txt_right(632,y_or_j&+1,work_text$,font_main%)
  ENDIF
  font_attr_set(0,0,0,6,0)
  txt_right(631,y_or_j&,work_text$,font_main%)
  ' File size in K and block offset.
  IF info_on!
    IF mono!
      ARECT 120,30,367,45,1,0,V:pattern_grey%,1
      HLINE 120,46,367,0,0,V:pattern_solid%,0
    ELSE
      ARECT 120,15,367,22,1,0,V:pattern_solid%,1
    ENDIF
    IF mono!
      font_attr_set(1,0,0,6,0)
      txt_draw(121,y_or_j&+1,"File: "+STR$(sample_end% DIV 1024)+"K")
      font_attr_set(0,0,0,6,0)
    ENDIF
    txt_draw(120,y_or_j&,"File: "+STR$(sample_end% DIV 1024)+"K")
    IF seconds_on!
      work_text$="Offset: "+TRIM$(STR$(MIN(block_start%,block_end%)/sample_rate&,7,3))+" sec"
    ELSE
      work_text$="Offset: "+STR$(MIN(block_start%,block_end%))+" bytes"
    ENDIF
    IF mono!
      font_attr_set(1,0,0,6,0)
      txt_draw(209,y_or_j&+1,work_text$)
      font_attr_set(0,0,0,6,0)
    ENDIF
    txt_draw(208,y_or_j&,work_text$)
  ENDIF
  pointer_show
RETURN
' Draws the sample name in the status line, the name alone when file info is shown (104 pixels), else the
' full path (360 pixels), cutting characters off the end until it fits in font font_main%.
PROCEDURE status_name_draw
  LOCAL work_text$,width_name&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF mono!
    ARECT 0,30,367,45,1,0,V:pattern_grey%,1
    HLINE 0,46,367,0,0,V:pattern_solid%,0
  ELSE
    ARECT 0,15,367,22,1,0,V:pattern_solid%,1
  ENDIF
  font_attr_set(0,0,0,0,3)
  wrmode_set(2)
  IF info_on!
    work_text$=sample_filename$
    width_name&=104
  ELSE
    work_text$=selector_folder$+sample_filename$
    width_name&=360
  ENDIF
  ' pixel_width_of gives the text width in pixels.
  WHILE @pixel_width_of(font_main%,work_text$)>width_name&
    work_text$=LEFT$(work_text$,LEN(work_text$)-1)
  WEND
  IF mono!
    font_attr_set(1,0,0,6,0)
    txt_draw(9,44,work_text$)
    font_attr_set(0,0,0,6,0)
    txt_draw(8,43,work_text$)
  ELSE
    font_attr_set(0,0,0,6,0)
    txt_draw(8,21,work_text$)
  ENDIF
  pointer_show
RETURN
' Draws the overview bar under the waveform: the file is 595 pixels from x 20, the block part left empty.
PROCEDURE overview_bar_draw
  LOCAL ix&,y_or_j&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  ix&=block_start%*595/sample_end%+20
  y_or_j&=block_end%*595/sample_end%+20
  IF mono!
    ARECT 0,306,639,307,0,0,V:pattern_solid%,1
    ARECT 0,306,PRED(ix&),307,1,0,V:pattern_grey%,1
    ARECT SUCC(y_or_j&),306,639,307,1,0,V:pattern_grey%,1
  ELSE
    HLINE 0,153,639,0,0,V:pattern_solid%,1
    HLINE 0,153,PRED(ix&),1,0,V:pattern_solid%,1
    HLINE SUCC(y_or_j&),153,639,1,0,V:pattern_solid%,1
  ENDIF
  pointer_show
RETURN
' Draws the zoom factor (Max, 16x, 8x, 4x, 2x, 1x) and the sample rate in KHz in the status line.
PROCEDURE status_zoom_draw
  LOCAL work_text$,y_or_j&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF mono!
    y_or_j&=43
    ARECT 376,30,487,45,1,0,V:pattern_grey%,1
  ELSE
    y_or_j&=21
    ARECT 376,15,487,22,1,0,V:pattern_solid%,1
  ENDIF
  font_attr_set(0,0,0,0,3)
  wrmode_set(2)
  IF mono!
    font_attr_set(1,0,0,6,0)
    txt_draw(377,y_or_j&+1,MID$("Max16x8x 4x 2x 1x ",MUL(zoom&,3)+1,3))
  ENDIF
  font_attr_set(0,0,0,6,0)
  txt_draw(376,y_or_j&,MID$("Max16x8x 4x 2x 1x ",MUL(zoom&,3)+1,3))
  work_text$=STR$(sample_rate&/1000)+"KHz"
  IF mono!
    font_attr_set(1,0,0,6,0)
    txt_draw(409,y_or_j&+1,work_text$)
  ENDIF
  font_attr_set(0,0,0,6,0)
  txt_draw(408,y_or_j&,work_text$)
RETURN
' Draws "Memory Size:" centred in the top bar: the free sample memory (the copy buffer start buffer_start%), in
' seconds at the current rate or in bytes.
PROCEDURE memory_size_draw
  LOCAL y_or_j&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF mono!
    y_or_j&=15
    ARECT 363,0,607,17,0,0,V:pattern_solid%,1
  ELSE
    y_or_j&=7
    ARECT 363,0,607,8,0,0,V:pattern_solid%,1
  ENDIF
  font_attr_set(0,0,0,0,3)
  font_attr_set(1,0,0,6,0)
  IF seconds_on!
    txt_centred(484,y_or_j&,"Memory Size: "+TRIM$(STR$(buffer_start%/sample_rate&,7,3))+" sec",font_main%)
  ELSE
    txt_centred(484,y_or_j&,"Memory Size: "+STR$(buffer_start%)+" bytes",font_main%)
  ENDIF
RETURN
' Called after the sample length changed: rounds it up to 320 bytes, sets zoom to Max and the scroll bar
' to the whole file (at least 640 bytes), releases "select whole file", and redraws all status fields.
PROCEDURE sample_length_update
  LOCAL length_bytes%
  sample_end%=((sample_end%+319) DIV 320)*320
  length_bytes%=sample_end%
  length_bytes%=MAX(640,length_bytes%)
  length_bytes%=((length_bytes%+319) DIV 320)*320
  prev_zoom&=zoom&
  zoom&=0
  slider_setup(4,26,0,length_bytes%/320,-length_bytes%/320,length_bytes%/320,0,length_bytes%/320)
  obj_find(4,26,work_ptr%)
  dialog_object_draw(work_ptr%,0,0,-1)
  ' A changed file ends "select whole file"; redraw object 7 released.
  IF all_selected!
    all_selected!=FALSE
    all_button_up
    obj_find(4,7,work_ptr%)
    obj_draw_normal(work_ptr%+8,origin_x&,origin_y&,4,0)
  ENDIF
  zoom_limit_calc
  memory_size_draw
  trace_draw
  status_block_draw
  overview_bar_draw
  status_zoom_draw
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' Applies the zoom level zoom&: Max shows the whole file, levels 1-5 show 32, 16, 8, 4 or 2 pages of 320
' bytes.  When zooming in from Max the view centres on the block, else it keeps the old centre.
PROCEDURE zoom_apply
  LOCAL range_max&,rect_x1&,rect_x2&
  slider_value_query(4,26,slider_value&,slider_size&)
  ' New scroll position: old centre, or the block centre limited to the file.
  IF prev_zoom&<>0 OR zoom&=0
    slider_value&=slider_value&+DIV(slider_size&,2)
  ELSE
    rect_x1&=(block_end%+block_start%)/640
    rect_x2&=2^(5-zoom&)
    range_max&=sample_end% DIV 320-rect_x2&
    slider_value&=MIN(range_max&,MAX(rect_x1&,rect_x2&))
  ENDIF
  ' Slider range: the file in pages; the size is 64>>level pages, so a pixel shows 16, 8, 4, 2 or 1 bytes.
  SELECT zoom&
  CASE 0
    slider_setup(4,26,0,sample_end%/320,-1,1,0,sample_end%/320)
  CASE 1
    slider_setup(4,26,0,sample_end%/320,-32,32,-16+slider_value&,32)
  CASE 2
    slider_setup(4,26,0,sample_end%/320,-16,16,slider_value&-8,16)
  CASE 3
    slider_setup(4,26,0,sample_end%/320,-8,8,slider_value&-4,8)
  CASE 4
    slider_setup(4,26,0,sample_end%/320,-4,4,slider_value&-2,4)
  CASE 5
    slider_setup(4,26,0,sample_end%/320,-2,2,slider_value&-1,2)
  ENDSELECT
  ' Keep the slider inside the file, then redraw scroll bar and waveform.
  slider_value_query(4,26,slider_value&,slider_size&)
  IF slider_value&+slider_size&>DIV(sample_end%,320)
    slider_value&=sample_end%/320-slider_size&
  ENDIF
  IF slider_value&<0
    slider_value&=0
  ENDIF
  slider_set_pos(4,26,slider_value&,slider_size&)
  obj_find(4,26,work_ptr%)
  dialog_object_draw(work_ptr%,0,0,-1)
  trace_draw
RETURN
' Marks a block with the mouse in the waveform: while a button is held a cursor line follows the mouse,
' left button sets the block start, right button the block end, and the status line is updated.  Moving
' out of the waveform and releasing there restores the old block.
PROCEDURE block_mark_mouse
  LOCAL ix&,y_or_j&,k&,last_x&,button_previous&,work_long%,obj_found%
  ' Mouse x, y and buttons.
  pointer_state(ix&,y_or_j&,k&)
  IF k&>0
    work_long%=block_start%
    obj_found%=block_end%
    slider_value_query(4,26,slider_value&,slider_size&)
    button_previous&=k&
    ix&=-1
    ' Follow the mouse until the button state changes; x -1 means outside the waveform.
    REPEAT
      last_x&=ix&
      pointer_state(ix&,y_or_j&,k&)
      IF mono!
        IF y_or_j&<48 OR y_or_j&>303
          ix&=-1
        ENDIF
      ELSE
        IF y_or_j&<24 OR y_or_j&>151
          ix&=-1
        ENDIF
      ENDIF
      ' Move the XOR cursor line and set the block start or end from the pixel position.
      IF last_x&<>ix&
        pointer_hide
        IF last_x&>=0
          IF mono!
            ALINE last_x&,48,last_x&,303,3,-1,2
          ELSE
            ALINE last_x&,24,last_x&,151,3,-1,2
          ENDIF
        ENDIF
        ' Draw the cursor line at the new position.
        IF ix&>=0
          IF mono!
            ALINE ix&,48,ix&,303,3,-1,2
          ELSE
            ALINE ix&,24,ix&,151,3,-1,2
          ENDIF
        ENDIF
        ' Right button moves the block end, left button the block start.
        IF button_previous&=2
          block_end%=slider_value&*320+(ix&+1)*slider_size&/2
        ELSE
          block_start%=slider_value&*320+MUL(ix&,slider_size&)/2
        ENDIF
        status_block_draw
        pointer_show
      ENDIF
    UNTIL k&<>button_previous&
    ' Released inside: remove the cursor, order start and end, release "select whole file", redraw.
    IF ix&>=0
      pointer_hide
      IF mono!
        ALINE ix&,48,ix&,303,3,-1,2
      ELSE
        ALINE ix&,24,ix&,151,3,-1,2
      ENDIF
      pointer_show
      IF block_start%>block_end%
        SWAP block_start%,block_end%
      ENDIF
      IF all_selected!
        all_selected!=FALSE
        all_button_up
        obj_find(4,7,work_ptr%)
        obj_draw_normal(work_ptr%+8,origin_x&,origin_y&,4,0)
      ENDIF
      trace_draw
      overview_bar_draw
    ELSE
      ' Released outside: old block back.
      block_start%=work_long%
      block_end%=obj_found%
      status_block_draw
    ENDIF
  ENDIF
RETURN
' Shows main window object 7 (select whole file) pressed by setting its state byte to 0.
PROCEDURE all_button_down
  LOCAL work_ptr%
  obj_find(4,7,work_ptr%)
  BYTE{work_ptr%+5}=0
RETURN
' Shows main window object 7 (select whole file) released by setting its state byte to 4.
PROCEDURE all_button_up
  LOCAL work_ptr%
  obj_find(4,7,work_ptr%)
  BYTE{work_ptr%+5}=4
RETURN
' Sets zoom_max&, the highest zoom level worth using: 5 up to 1280 bytes, 4 to 2560, 3 to 5120, 2 to 10240,
' else 1.
PROCEDURE zoom_limit_calc
  IF sample_end%<=1280
    zoom_max&=5
  ELSE
    IF sample_end%<=2560
      zoom_max&=4
    ELSE
      IF sample_end%<=5120
        zoom_max&=3
      ELSE
        IF sample_end%<=10240
          zoom_max&=2
        ELSE
          zoom_max&=1
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Handles object obj_num& of the rate dialog (form 6).  1-11 preset rates, 15 the typed rate (snapped to
' 614400/n Hz, 4915-30720), 17-19 slider and arrows (divider 145-position), 20 test play at the dialog rate,
' 21-24 double, halve, a semitone up or down, 100 the current rate.  Writes the rate into object 15 and
' moves the slider to match.
PROCEDURE rate_dialog_handle
  LOCAL work_text$,work_long%,saved_rate&,saved_timer&
  work_text$=""
  SELECT obj_num&
  CASE 1
    work_text$="4.915"
  CASE 2
    work_text$="6.2693"
  CASE 3
    ' The 4 characters "7.68".
    work_text$=MKL$(925775416)
  CASE 4
    work_text$="9.6"
  CASE 5
    work_text$="10.971"
  CASE 6
    work_text$="12.538"
  CASE 7
    work_text$="14.985"
  CASE 8
    work_text$="19.819"
  CASE 9
    work_text$="21.942"
  CASE 10
    work_text$="24.576"
  CASE 11
    work_text$="30.72"
  CASE 15
    obj_text_query(6,15,work_text$)
    ' Typed rate in Hz, kept in range and snapped to 614400/n, the rates the MFP timer can make.
    num_val&=VAL(work_text$)*1000
    num_val&=MIN(30720,MAX(4915,num_val&))
    num_val&=614400/num_val&+.5
    num_val&=DIV(614400,num_val&)
    work_text$=STR$(num_val&/1000)
  CASE 17 TO 19
    ' Slider: rate = 614.4 KHz / (145 - position); the arrows pause a little between steps.
    slider_value_query(6,18,saved_timer&,saved_rate&)
    saved_timer&=145-saved_timer&
    work_text$=STR$(614.4/saved_timer&)
    IF obj_num&<>18
      PAUSE 3
    ENDIF
  CASE 20
    ' Test: play at the dialog rate, then put the real rate and timer setting back.
    saved_rate&=sample_rate&
    saved_timer&=mfp_timer_a&
    choice&=1
    rate_timer_calc
    sample_play
    sample_rate&=saved_rate&
    mfp_timer_a&=saved_timer&
  CASE 21 TO 24
    ' Double, halve, or one semitone up or down from the typed rate.
    obj_text_query(6,15,work_text$)
    work_long%=VAL(work_text$)*1000
    SELECT obj_num&
    CASE 21
      work_long%=work_long%*2
    CASE 22
      work_long%=work_long% DIV 2
    CASE 23
      work_long%=semitone*work_long%
    CASE 24
      work_long%=work_long%/semitone
    ENDSELECT
    num_val&=MIN(30720,MAX(4915,work_long%))
    num_val&=614400/num_val&+.5
    num_val&=DIV(614400,num_val&)
    work_text$=STR$(num_val&/1000)
  CASE 100
    work_text$=STR$(sample_rate&/1000)
  ENDSELECT
  ' Show the new rate (6 characters) and set the slider position from it.
  IF obj_num&<>20
    work_text$=LEFT$(work_text$+"      ",6)
    obj_find(6,15,work_long%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
    saved_timer&=614.4/VAL(work_text$)
    slider_setup(6,18,20,130,-5,5,145-saved_timer&,5)
  ENDIF
  ' Redraw the text and, unless it was dragged, the slider.
  IF obj_num&<>20 AND obj_num&<>100
    edit_object&=-1
    dialog_object_draw(work_long%,origin_x&,origin_y&,-1)
    IF obj_num&<17 OR obj_num&>19
      obj_find(6,18,work_long%)
      dialog_object_draw(work_long%,origin_x&,origin_y&,-1)
    ENDIF
    pointer_show
  ENDIF
RETURN
' When the rate dialog ended with OK (choice&=1): reads its rate text, limits it to 4915-30720 Hz, snaps it
' to 614400/n and sets mfp_timer_a&, the MFP Timer A setting for the player (prescaler code * 256 + data, from
' 2457600 Hz).  Sets sample_rate& to the rate.
PROCEDURE rate_timer_calc
  LOCAL work_text$,num_val&
  IF choice&=1
    obj_text_query(6,15,work_text$)
    num_val&=VAL(work_text$)*1000
    num_val&=MIN(30720,MAX(4915,num_val&))
    num_val&=614400/num_val&+.5
    num_val&=DIV(614400,num_val&)
    ' Known rates with their timer values: 4915 uses prescaler /100, 7680 and 9600 /64, the others /4.
    ' 10971 Hz gets data 55 ($137), which gives 11170 Hz; 614400/10971 is 56.  CASE "Mk" is 19819 ($4D6B).
    SELECT num_val&
    CASE 4915
      mfp_timer_a&=1541
    CASE 6269
      mfp_timer_a&=354
    CASE 7680
      mfp_timer_a&=1285
    CASE 9600
      mfp_timer_a&=1284
    CASE 10971
      mfp_timer_a&=311
    CASE 12538
      mfp_timer_a&=305
    CASE 14985
      mfp_timer_a&=297
    CASE "Mk"
      mfp_timer_a&=287
    CASE 21942
      mfp_timer_a&=284
    CASE 24576
      mfp_timer_a&=281
    CASE 30720
      mfp_timer_a&=276
    DEFAULT
      ' Any other rate: prescaler /4 with data 614400/rate, at least 20 (30720 Hz).
      mfp_timer_a&=256+DIV(614400,num_val&)
      IF mfp_timer_a&<276
        mfp_timer_a&=276
      ENDIF
      num_val&=DIV(614400,BYTE(mfp_timer_a&))
    ENDSELECT
    sample_rate&=num_val&
  ENDIF
RETURN
' Converts the marked block from the current rate sample_rate& to the rate typed in the rate field (tree 6 obj 15).
' mode_param& = 0 asks first (alert 30), 1 converts at once.  Rates are clamped to 4915..30720 Hz and rounded
' to 614400/n, the MFP timer clock (2457600 Hz / 4) divided by a whole timer count.
' A higher rate makes the block longer: the sample tail is moved up, offering Lose Sample / Lose Buffer /
' Convert to Fit when memory runs out.  A lower rate shrinks the block and fills the freed end with silence.
' Sets block_start%/block_end%/sample_end%/buffer_start% and the loop points, then updates the rate (rate_timer_calc) and the display.
PROCEDURE block_rate_convert(mode_param&)
  LOCAL work_text$,obj_found%,ratio,size_change%,src_pos%,dest_pos%,new_length%,move_length%,old_sample_end%,offs_f,decay_level
  obj_text_query(6,15,work_text$)
  ' Field text is in kHz; quantise the new rate to a timer count of the 614400 Hz MFP clock
  num_val&=VAL(work_text$)*1000
  num_val&=MIN(30720,MAX(4915,num_val&))
  num_val&=614400/num_val&+.5
  num_val&=DIV(614400,num_val&)
  ' Alert text "(from x KHz to y KHz)"
  work_text$=TRIM$(STR$(CARD(sample_rate&)/1000))+"KHz to "+TRIM$(STR$(num_val&/1000))+"KHz)"
  ' Only when the rate changes and a block is marked
  IF num_val&<>sample_rate& AND block_end%>block_start%
    IF mode_param&=0
      choice&=@msgbox_show(30,"[1][ Convert block?  (from | "+work_text$+" ][ Okay |   Cancel   ]")
    ELSE
      choice&=1
    ENDIF
    IF choice&=1
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' Up-sampling: the block grows by size_change% bytes
      IF num_val&>CARD(sample_rate&)
        ratio=num_val&/sample_rate&
        size_change%=(block_end%-block_start%)*(ratio-1)
        ' The longer sample would run into the buffer: alert 47 Lose Sample / Lose Buffer / Convert to Fit / Cancel
        IF sample_end%+size_change%>buffer_start%
          pointer_hide
          pointer_busy(0)
          pointer_show
          choice&=@msgbox_show(47,"[1][ Not enough memory | for Convert. ][ Lose Sample | Lose Buffer | Convert to Fit | Cancel ][^M|b|c|a]")
          pointer_hide
          pointer_busy(1)
          pointer_show
          ACLIP 1,0,0,639,screen_max_y&
        ELSE
          choice&=0
        ENDIF
        SELECT choice&
        CASE 0
          ' Choice 0 (enough memory): move the whole tail up by size_change%
          src_pos%=block_start%
          dest_pos%=block_start%+size_change%
          move_length%=sample_end%-block_start%
          new_length%=block_end%-block_start%
        CASE 1
          src_pos%=block_start%
          dest_pos%=block_start%+size_change%
          move_length%=buffer_start%-dest_pos%
          new_length%=MIN(block_end%-block_start%,move_length%)
        CASE 2
          src_pos%=block_start%
          dest_pos%=block_start%+size_change%
          move_length%=memory_top%-dest_pos%
          new_length%=MIN(block_end%-block_start%,move_length%)
        CASE 3
          size_change%=buffer_start%-sample_end%
          src_pos%=block_start%
          dest_pos%=block_start%+size_change%
          move_length%=sample_end%-block_start%
          new_length%=size_change%/(ratio-1)
        ENDSELECT
        IF choice&<4
          IF move_length%>0
            ' Open a gap of size_change% bytes at the block start; the old block now starts at block_start%+size_change%
            BMOVE sample_base%+src_pos%,sample_base%+dest_pos%,move_length%
            pointer_show
            ACLIP 1,0,0,639,screen_max_y&
          ENDIF
          old_sample_end%=sample_end%
          sample_end%=sample_end%+size_change%
          ' Shift the loop points behind the block start, then round the sample length up to whole 320-byte pages
          sample_loop_shift(block_start%,size_change%)
          sample_end%=MAX(640,((sample_end%+319) DIV 320)*320)
          IF block_end%=old_sample_end%
            block_end%=sample_end%
          ELSE
            block_end%=block_end%+size_change%
          ENDIF
          ' Lose Buffer: the buffer start moves up with the sample end
          IF buffer_start%<sample_end%
            buffer_start%=sample_end%
          ENDIF
          ' ratio is now old/new (below 1): the 16.16 step through the source for each output byte
          ratio=sample_rate&/num_val&
          new_length%=new_length%/ratio
          offs_f=block_start%+size_change%
          dest_pos%=block_start%
          ' Exactly double the rate: the 1:2 interpolating copy (INLINE code_double%)
          IF ABS(ratio-.5)<.0005
            ~C:code_double%(L:sample_base%+block_start%+size_change%,L:sample_base%+block_start%+new_length%,L:sample_base%+block_start%)
          ELSE
            ' Any other ratio: linear interpolation by the fractional step (INLINE code_upsample%)
            ~C:code_upsample%(L:sample_base%+block_start%,L:sample_base%+block_start%+size_change%,L:sample_base%+block_start%+new_length%,ratio*65536)
            ' decay_level is never set, so this writes the first byte of the block back unchanged
            BYTE{sample_base%+dest_pos%}=ADD(BYTE{sample_base%+src_pos%},decay_level*(BYTE{sample_base%+src_pos%+1}-BYTE{sample_base%+src_pos%}))
          ENDIF
          choice&=1
        ENDIF
      ELSE
        ' Down-sampling: ratio = old/new (above 1); move_length% and new_length% are set but never used in this branch
        ratio=CARD(sample_rate&)/num_val&
        size_change%=0
        move_length%=ratio*65536
        src_pos%=block_start%
        dest_pos%=block_start%
        obj_found%=block_end%-block_start%
        new_length%=0
        ' Exactly half the rate: average byte pairs in place (INLINE code_halve%)
        IF ABS(ratio-2)<.005
          ~C:code_halve%(L:sample_base%+block_start%,L:sample_base%+block_end%)
          dest_pos%=block_start%+DIV(obj_found%,2)
        ELSE
          ' Table that divides a sum of ratio samples back to one byte, for the averaging code code_downsample%
          FOR ix&=0 TO 255*ratio
            BYTE{scratch_addr%+ix&}=ROUND(ix&/ratio)
          NEXT ix&
          ~C:code_downsample%(L:sample_base%+block_start%,L:sample_base%+block_start%,L:sample_base%+block_start%+obj_found%,L:ratio*65536,L:scratch_addr%)
          dest_pos%=ADD(obj_found%/ratio,block_start%)
        ENDIF
        ' Move the tail down to the new block end and fill the freed end of the sample with silence (128)
        IF block_end%<sample_end%
          BMOVE sample_base%+block_end%,sample_base%+dest_pos%,sample_end%-block_end%
        ENDIF
        ~C:code_fill%(L:dest_pos%+(sample_base%+sample_end%-block_end%),L:block_end%-dest_pos%,128)
        old_sample_end%=sample_end%
        SUB sample_end%,block_end%-dest_pos%
        sample_loop_shift(block_start%,dest_pos%-block_end%)
        sample_end%=MAX(640,((sample_end%+319) DIV 320)*320)
        IF block_end%=old_sample_end%
          dest_pos%=sample_end%
        ENDIF
        block_end%=dest_pos%
      ENDIF
      pointer_hide
      pointer_busy(0)
      pointer_show
      ' Store the new rate and its timer value, then refresh the sample length display
      rate_timer_calc
      sample_length_update
    ENDIF
  ENDIF
RETURN
' Play button (main panel object 1, Space key).  Shift+Space (or the alt mode shift_mode!) plays the buffer
' buffer_start%..memory_top%; otherwise plays the whole sample with its loop when the loop is on, else the block.
' keyboard_scancode reads the last scancode from the keyboard ACIA ($FFFC02): 57 = Space pressed, 185 = released.
' block_played! is set when the sample (not the buffer) was played, so play_stop_cursor can show the stop position.
' shift_mode! is restored on exit.
PROCEDURE sample_play
  LOCAL saved_alt_mode!,buffer_labels_shown!
  saved_alt_mode!=shift_mode!
  buffer_labels_shown!=FALSE
  block_played!=FALSE
  ' Started with Space from the main panel: Shift held (Kbshift bits 0-1) means play the buffer
  IF @keyboard_scancode=57
    IF dialog_id&=4
      IF BIOS(11,-1) AND 3
        shift_mode!=TRUE
        ' Draw only a 70x8 part of the buffer label image, then restore its size 79x19
        CARD{panel_image_alt%}=70
        CARD{panel_image_alt%+2}=8
        pointer_hide
        image_blit(4,168,panel_image_alt%)
        pointer_show
        CARD{panel_image_alt%}=79
        CARD{panel_image_alt%+2}=19
        buffer_labels_shown!=TRUE
      ENDIF
    ENDIF
    ' Wait for Space to be released
    REPEAT
    UNTIL @keyboard_scancode=185
  ENDIF
  ' Bconstat/Bconin on the console: flush pending keys, then wait until Shift/Ctrl/Alt are released
  WHILE BIOS(1,2)
    ~INP(2)
  WEND
  DO
  LOOP WHILE BIOS(11,-1) AND 111
  pointer_hide
  ' Busy mouse; keyclick_off turns the key click off (conterm $484 bit 0) while playing
  pointer_busy(1)
  pointer_show
  VSYNC
  keyclick_off
  ' Buffer: play buffer_start%..memory_top% if it is not empty
  IF shift_mode!
    IF memory_top%>buffer_start%
      sample_run_range(output_device&,output_table%,sample_base%+buffer_start%,sample_base%+memory_top%,0,0,0,mfp_timer_a&)
    ENDIF
  ELSE
    ' Loop on: play the whole sample, looping sample_loop_start%..sample_loop_end% until a key or click
    IF sample_loop_on! AND sample_loop_end%>sample_loop_start%
      sample_run_range(output_device&,output_table%,sample_base%,sample_base%+sample_end%,sample_base%+sample_loop_start%,sample_base%+sample_loop_end%,sample_loop_on!,mfp_timer_a&)
    ELSE
      ' Otherwise play the marked block once
      IF block_end%>block_start%
        sample_run_range(output_device&,output_table%,sample_base%+block_start%,sample_base%+block_end%,0,0,0,mfp_timer_a&)
      ENDIF
    ENDIF
    block_played!=TRUE
  ENDIF
  ' Put the normal label image back
  IF buffer_labels_shown!
    CARD{panel_image%}=70
    CARD{panel_image%+2}=8
    pointer_hide
    image_blit(4,168,panel_image%)
    pointer_show
    CARD{panel_image%}=79
    CARD{panel_image%+2}=19
  ENDIF
  ' Key click back on, arrow mouse
  keyclick_on
  pointer_hide
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
  shift_mode!=saved_alt_mode!
RETURN
' Shows where playback stopped: called after the Play button is released when the sample was played.
' LONG{player_code%+14} is the player's current address.  If that position is inside the visible window
' (slider tree 4 obj 26, in 320-byte pages) an XOR vertical line blinks there every 80 ticks (0.4 s)
' until a mouse click or key, or until the mouse moves into the menu bar (where a menu may open).
PROCEDURE play_stop_cursor
  LOCAL range_pos%,ix&,work_ptr%,end_pointer%,cursor_drawn!,ms_x&,ms_y&,ms_b&
  ' Offset of the stop position, and the visible window from the scroll slider
  range_pos%=LONG{player_code%+14}-sample_base%
  slider_value_query(4,26,slider_value&,slider_size&)
  work_ptr%=MUL(slider_value&,320)
  end_pointer%=(slider_value&+slider_size&)*320
  IF range_pos%>=work_ptr% AND range_pos%<end_pointer%
    ' Screen x of the stop position
    ix&=(range_pos%-work_ptr%)*640/(end_pointer%-work_ptr%)
    cursor_drawn!=FALSE
    work_ptr%=TIMER
    pointer_busy(0)
    REPEAT
      ' Toggle the XOR line (mono display y 48..303, colour 24..151)
      IF work_ptr%<TIMER
        pointer_hide
        IF mono!
          ALINE ix&,48,ix&,303,3,-1,2
        ELSE
          ALINE ix&,24,ix&,151,3,-1,2
        ENDIF
        pointer_show
        cursor_drawn!=NOT cursor_drawn!
        work_ptr%=80+TIMER
      ENDIF
      ' Mouse over the menu titles (and clicked, or menus open on hover): leave so the menu can open
      pointer_state(ms_x&,ms_y&,ms_b&)
      EXIT IF ms_x&<menubar_width&+16 AND ms_y&<menubar_height& AND (ms_b& OR menu_click_opt!=FALSE)
    UNTIL ms_b& OR BIOS(1,2)
    ' Remove the line if it is still drawn
    IF cursor_drawn!
      pointer_hide
      IF mono!
        ALINE ix&,48,ix&,303,3,-1,2
      ELSE
        ALINE ix&,24,ix&,151,3,-1,2
      ENDIF
      pointer_show
    ENDIF
  ENDIF
RETURN
' Monitor button ('M').  Alt mode: records into the 10240-byte scratch buffer and plays it back in a loop
' (monitor through) until the M key (scancode 50) is released.  Normal: a live oscilloscope of the
' sampler cartridge input drawn by INLINE asm_input_scope% until a key is pressed.  Mouse reports are switched off
' at the IKBD during the scope and relative mouse mode is set again afterwards.
PROCEDURE input_monitor
  LOCAL ix&,y_or_j&,work_ptr%,end_pointer%,scan_code|,column_offsets$,row_offsets$
  IF shift_mode!
    ' Wait for the M key to be released first
    key_release_wait(50)
    pointer_hide
    pointer_busy(1)
    pointer_show
    VSYNC
    keyclick_off
    ' Mode +128 = record; record and play the scratch buffer scratch_addr%..sample_base% as an endless loop
    sample_run_range(128+output_device&,output_table%,scratch_addr%,sample_base%,scratch_addr%,sample_base%,-1,mfp_timer_a&)
    keyclick_on
    pointer_busy(0)
    pointer_show
    ACLIP 1,0,0,639,screen_max_y&
  ELSE
    ' IKBD $0A,$FF,$FF: mouse keycode mode with 255-step thresholds, so the mouse sends nothing
    OUT 4,10
    OUT& 4,-1
    pointer_hide
    pointer_busy(1)
    ' Logbase + line 24 (colour, second plane); mono uses line 48 (SUB 2 below)
    work_ptr%=3842+XBIOS(3)
    column_offsets$=SPACE$(80)
    row_offsets$=SPACE$(800)
    ' Tables for the scope code: column_offsets$ = byte offset of each 16-pixel column, row_offsets$ = line offset of
    ' each sample value (mono: one line per value; colour: two values per 160-byte line)
    IF mono!
      SUB work_ptr%,2
      FOR ix&=0 TO 39
        CARD{V:column_offsets$+ix&*2}=ix&*2
      NEXT ix&
      FOR ix&=0 TO 399
        CARD{V:row_offsets$+ix&*2}=MUL(ix&,80)
      NEXT ix&
    ELSE
      FOR ix&=0 TO 39
        CARD{V:column_offsets$+ix&*2}=SHL(ix&,2)
      NEXT ix&
      FOR ix&=0 TO 399 STEP 2
        CARD{V:row_offsets$+ix&*2}=MUL(ix&,80)
        CARD{V:row_offsets$+ix&*2+2}=MUL(ix&,80)
      NEXT ix&
    ENDIF
    ' Scope state: 640 previous values (silence) and the fade counters
    scope_state$=STRING$(640,128)+STRING$(1280,0)
    ' Clear the waveform area
    ACLIP 1,0,0,639,screen_max_y&
    ' Draw the centre line by XOR: dotted in mono, solid in colour
    IF mono!
      ARECT 0,48,639,303,0,0,V:pattern_solid%,1
    ELSE
      ARECT 0,24,639,151,0,0,V:pattern_solid%,1
    ENDIF
    IF mono!
      FOR ix&=0 TO 79 STEP 4
        LONG{10240+work_ptr%+ix&}=LONG{10240+work_ptr%+ix&} XOR 1431655765
      NEXT ix&
    ELSE
      FOR ix&=-2 TO 154 STEP 4
        LONG{10240+work_ptr%+ix&}=NOT LONG{10240+work_ptr%+ix&}
      NEXT ix&
    ENDIF
    pointer_show
    keyclick_off
    ' Plot the input byte at cart_input% column by column, XOR erasing old points, until Bconstat(2) is true
    ~C:asm_input_scope%(L:work_ptr%,L:V:column_offsets$,L:V:row_offsets$,L:V:scope_state$,L:cart_input%)
    keyclick_on
    ' Redraw the waveform, wait for the key to be released, restore relative mouse mode (IKBD $08)
    trace_draw
    key_release_wait(0)
    pointer_hide
    pointer_busy(0)
    pointer_show
    OUT 4,8
    ACLIP 1,0,0,639,screen_max_y&
  ENDIF
RETURN
' Record button.  With no block marked (block = whole sample) it records over the whole file, otherwise
' alert 57 asks File / Block / Cancel; File turns Select All on (main panel object 7) first.
' Alert 17 then asks Wait (start when the input leaves the 96..160 band) or Start now.
' Recording over the whole file sets the new sample length from where recording stopped.
PROCEDURE sample_record
  LOCAL blink_timer%
  ' Block covers the whole sample: record the file without asking
  IF block_start%=0 AND block_end%=sample_end%
    choice&=1
  ELSE
    choice&=@msgbox_show(57,"[1][ Record over entire file, or | just the marked block? ][ File | Block |   Cancel   ][^M|b|a]")
    IF choice&=1
      ' File chosen: press Select All so the block is the whole sample
      IF all_selected!=FALSE
        obj_find(4,7,work_ptr%)
        obj_draw_selected(work_ptr%+8,origin_x&,origin_y&,4,0)
        action_dispatch(4,7,0,0)
      ENDIF
    ENDIF
  ENDIF
  IF choice&<>3
    ' Wait for sound or start now; then flush keys and wait for Return (scancode 28) to be released
    choice&=@msgbox_show(17,"[1][ Wait for sound or | start recording now? ][ Wait | Start |   Cancel   ][^M|s|a]")
    WHILE BIOS(1,2)
      ~INP(2)
    WEND
    key_release_wait(28)
    IF choice&=1
      ' Wait: the mouse blinks (hidden/shown every 0.4 s) until the input byte is 32 or more from 128
      blink_timer%=TIMER
      pointer_hide
      pointer_busy(1)
      pointer_show
      WHILE ABS(BYTE{cart_input%}-128)<32
        IF TIMER-blink_timer%>160
          pointer_show
          blink_timer%=TIMER
        ELSE
          IF TIMER-blink_timer%>80
            pointer_hide
          ENDIF
        ENDIF
        EXIT IF BIOS(1,2)
      WEND
      ' A key while waiting cancels the recording
      IF BIOS(1,2)
        ~INP(2)
        pointer_hide
        pointer_busy(0)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
        choice&=3
      ENDIF
    ENDIF
    IF choice&<3
      pointer_hide
      pointer_busy(1)
      pointer_show
      VSYNC
      keyclick_off
      ' Whole file: record sample_base%..buffer_start% (all free memory up to the buffer); block: record the block only
      IF block_start%=0 AND block_end%=sample_end%
        sample_run_range(128+output_device&,output_table%,sample_base%,sample_base%+buffer_start%,0,0,0,mfp_timer_a&)
      ELSE
        IF block_end%>block_start%
          sample_run_range(128+output_device&,output_table%,sample_base%+block_start%,sample_base%+block_end%,0,0,0,mfp_timer_a&)
        ENDIF
      ENDIF
      keyclick_on
      ACLIP 1,0,0,639,screen_max_y&
      ' After a whole-file recording: silence the rest after the stop address, set the length to the next
      ' 320-byte page (at least 640), reset the scroll slider and make the block the whole new sample
      IF block_start%=0 AND block_end%=sample_end%
        IF LONG{player_code%+14}<sample_base%+sample_end%
          ~C:code_fill%(L:LONG{player_code%+14},L:sample_base%+sample_end%-LONG{player_code%+14},128)
        ENDIF
        length_bytes%=LONG{player_code%+14}-sample_base%
        length_bytes%=MAX(640,length_bytes%)
        length_bytes%=((length_bytes%+319) DIV 320)*320
        slider_setup(4,26,0,length_bytes%/320,-length_bytes%/320,length_bytes%/320,0,length_bytes%/320)
        obj_find(4,26,work_ptr%)
        dialog_object_draw(work_ptr%,0,0,-1)
        block_start%=0
        block_end%=length_bytes%
        sample_end%=length_bytes%
        ' Loop off and the loop markers reset
        sample_loop_on!=FALSE
        frame_left%=0
        frame_right%=sample_end%
        sample_length_update
      ELSE
        ' Block recording: redraw the waveform and the panel indicators
        trace_draw
        status_zoom_draw
        status_block_draw
        overview_bar_draw
      ENDIF
      pointer_busy(0)
      pointer_show
    ENDIF
  ENDIF
RETURN
' Reverse button (main panel object 18): reverses the bytes of the marked block with INLINE asm_reverse%
' (arguments start, middle, end) and redraws the waveform.  range_pos% is declared but unused.
PROCEDURE block_reverse
  LOCAL range_pos%
  pointer_hide
  pointer_busy(1)
  pointer_show
  IF block_end%>block_start%
    ~C:asm_reverse%(L:sample_base%+block_start%,L:ADD((block_start%+block_end%+1) DIV 2,sample_base%),L:sample_base%+block_end%)
  ENDIF
  pointer_busy(0)
  trace_draw
RETURN
' Sign button (main panel object 19): adds $80 to every byte of the marked block (INLINE code_sign_flip%),
' converting between signed and unsigned samples, and redraws.  range_pos% is declared but unused.
PROCEDURE block_sign_flip
  LOCAL range_pos%
  pointer_hide
  pointer_busy(1)
  pointer_show
  IF block_end%>block_start%
    ~C:code_sign_flip%(L:sample_base%+block_start%,L:sample_base%+block_end%)
  ENDIF
  pointer_busy(0)
  trace_draw
RETURN
' Cut button (main panel object 8): moves the marked block into the buffer at the top of memory.
' Memory layout: sample sample_base%+0..sample_end%, free space, buffer buffer_start%..memory_top%.  The old buffer is cleared
' and the block is rotated to the top in 10240-byte steps through the scratch buffer scratch_addr%.
' With less than 10240 bytes left after the cut the dialog tree 9 is shown instead.
PROCEDURE block_cut
  LOCAL tail_length&
  IF block_end%>block_start%
    ' Not enough room to rotate: show the warning dialog (tree 9)
    IF memory_top%-block_end%+block_start%<10240
      dialog_run(9,choice&)
    ELSE
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' Loop points inside the block move to the block start; sample_loop_shift shifts the ones behind it
      IF sample_loop_start%>block_start% AND sample_loop_start%<block_end%
        sample_loop_start%=block_start%
      ENDIF
      IF sample_loop_end%>block_start% AND sample_loop_end%<block_end%
        sample_loop_end%=block_start%
      ENDIF
      sample_loop_shift(block_start%,block_start%-block_end%)
      ' Throw away the old buffer contents (fill with silence) and make the buffer empty
      IF buffer_start%<memory_top%
        ~C:code_fill%(L:sample_base%+buffer_start%,L:memory_top%-buffer_start%,128)
        buffer_start%=memory_top%
      ENDIF
      ' Rotate one 10240-byte chunk: save it, move everything above it down, put it at the top of memory
      WHILE block_end%-block_start%>=10240
        BMOVE sample_base%+block_start%,scratch_addr%,10240
        BMOVE sample_base%+block_start%+10240,sample_base%+block_start%,memory_top%-block_start%-10240
        BMOVE scratch_addr%,sample_base%+memory_top%-10240,10240
        block_end%=block_end%+-10240
        sample_end%=sample_end%+-10240
        buffer_start%=buffer_start%+-10240
      WEND
      ' The last part of the block (below 10240 bytes) the same way
      IF block_end%>block_start%
        tail_length&=block_end%-block_start%
        BMOVE sample_base%+block_start%,scratch_addr%,tail_length&
        BMOVE sample_base%+block_end%,sample_base%+block_start%,memory_top%-block_end%
        BMOVE scratch_addr%,sample_base%+memory_top%-tail_length&,tail_length&
        SUB sample_end%,tail_length&
        SUB buffer_start%,tail_length&
        block_end%=block_start%
      ENDIF
      ' Everything was cut: the sample becomes the whole free memory (silence)
      IF sample_end%=0
        sample_end%=buffer_start%
        block_end%=buffer_start%
        sample_loop_end%=buffer_start%
      ENDIF
      sample_length_update
    ENDIF
  ENDIF
RETURN
' Copy button (main panel object 9): copies the marked block into the buffer at the top of memory
' (buffer_start%..memory_top%), replacing the old buffer.  Alert 9 when the free memory is too small.
PROCEDURE block_copy
  LOCAL kept_addr%
  IF block_end%<>block_start%
    IF block_end%-block_start%>memory_top%-sample_end%
      choice&=@msgbox_show(9,"[1][Not enough memory|for Copy.][  Oops, sorry, my mistake!  ]")
    ELSE
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' New buffer start = top of memory - block length
      kept_addr%=buffer_start%
      buffer_start%=memory_top%-(block_end%-block_start%)
      BMOVE sample_base%+block_start%,sample_base%+buffer_start%,block_end%-block_start%
      ' The buffer got smaller: silence the part of the old buffer below the new start
      IF buffer_start%>kept_addr%
        ~C:code_fill%(L:sample_base%+kept_addr%,L:buffer_start%-kept_addr%,128)
      ENDIF
      ' Redraw the buffer information
      memory_size_draw
      pointer_hide
      pointer_busy(0)
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
    ENDIF
  ENDIF
RETURN
' Insert button ('I').  Alt mode: inserts a sample file (file selector "Insert which sample?") at the
' block start, offering Lose Sample / Lose Buffer / Insert to Fit when memory is short, then converts
' it to mono and to the current rate on request.  Normal mode: inserts a copy of the buffer at the block
' start with the same memory choices.  The inserted data becomes the marked block.
' Bug: format_detect is never called here, so format_parameters uses the format (sample_format&) of the last loaded file,
' and the data is read from offset 0, so a file header is inserted as sound.
PROCEDURE block_insert
  LOCAL byte_count%,signed_sample!,header_stereo!
  IF shift_mode!
    ' Keep the current sample name and rate; the file selector changes sample_filename$
    saved_filename$=sample_filename$
    rate_before&=sample_rate&
    filesel_title_set("Insert which sample?")
    filesel_run("*.AVR|*.SPL|*.SAM|*.SMP|*.SND|*.WAV|*.#|*.#K",selector_folder$,sample_filename$,ok_flag!)
    IF ok_flag!
      IF @fexists(selector_folder$+sample_filename$)<>0
        pointer_hide
        pointer_busy(1)
        pointer_show
        ' File size; the REPEAT ... EXIT IF ... UNTIL TRUE block below skips the rest on any error or Cancel
        length_bytes%=@fsize_of(selector_folder$+sample_filename$)
        REPEAT
          EXIT IF @fopen_channel("I",1,selector_folder$+sample_filename$)<>0
          ' Read the first 128 bytes (the header) into the scratch buffer, parse it, close the file
          IF length_bytes%>=128
            EXIT IF @fread_channel(1,scratch_addr%,128)<>0
          ENDIF
          format_parameters
          ~@fclose_channel(1)
          source_length%=length_bytes%
          EXIT IF source_length%<=0
          ' Free space between the sample end and the buffer
          byte_count%=buffer_start%-sample_end%
          IF source_length%>byte_count%
            pointer_hide
            pointer_busy(0)
            pointer_show
            ' Alert 46: Lose Sample / Lose Buffer / Insert to Fit / Cancel (keys Return, b, i, a)
            choice&=@msgbox_show(46,"[1][ Not enough memory | to Insert File. ][ Lose Sample | Lose Buffer | Insert to Fit | Cancel ][^M|b|i|a]")
            pointer_hide
            pointer_busy(1)
            pointer_show
            ACLIP 1,0,0,639,screen_max_y&
          ELSE
            choice&=0
          ENDIF
          EXIT IF choice&=4
          SELECT choice&
          CASE 0
            ' Enough memory: open a gap of the file length at the block start
            BMOVE sample_base%+block_start%,sample_base%+block_start%+source_length%,sample_end%-block_start%
            sample_end%=sample_end%+source_length%
          CASE 1
            ' Lose Sample: the sample tail beyond the buffer start is lost
            byte_count%=buffer_start%-block_start%-source_length%
            IF byte_count%>0
              BMOVE sample_base%+block_start%,sample_base%+block_start%+source_length%,byte_count%
              sample_end%=sample_end%+source_length%
              IF sample_end%>buffer_start%
                sample_end%=buffer_start%
              ENDIF
            ELSE
              source_length%=buffer_start%-block_start%
              sample_end%=buffer_start%
            ENDIF
          CASE 2
            ' Lose Buffer: the sample may grow into the buffer up to the top of memory
            byte_count%=sample_end%-block_start%
            IF memory_top%-sample_end%<source_length%
              byte_count%=memory_top%-block_start%-source_length%
              IF byte_count%<0
                source_length%=memory_top%-block_start%
              ENDIF
            ENDIF
            IF byte_count%>0
              BMOVE sample_base%+block_start%,sample_base%+block_start%+source_length%,byte_count%
              sample_end%=block_start%+source_length%+byte_count%
            ELSE
              sample_end%=memory_top%
            ENDIF
            IF buffer_start%<sample_end%
              buffer_start%=sample_end%
            ENDIF
          CASE 3
            ' Insert to Fit: only as much of the file as fits in the free space
            source_length%=buffer_start%-sample_end%
            IF source_length%>0
              BMOVE sample_base%+block_start%,sample_base%+block_start%+source_length%,sample_end%-block_start%
              sample_end%=sample_end%+source_length%
            ENDIF
          ENDSELECT
          pointer_show
          ACLIP 1,0,0,639,screen_max_y&
          EXIT IF source_length%<=0
          ' Reopen the file and read the data into the gap (Fopen/Fread)
          EXIT IF @fopen_channel("I",1,selector_folder$+sample_filename$)<>0
          format_parameters
          signed_sample!=signed_samples!
          sample_rate&=header_rate%
          EXIT IF @fread_channel(1,sample_base%+block_start%,source_length%)<>0
          ~@fclose_channel(1)
          ' Signed file: convert to unsigned
          IF signed_sample!
            ~C:code_sign_flip%(L:sample_base%+block_start%,L:sample_base%+block_start%+source_length%)
          ENDIF
          ' Stereo flag of an AVR header (read for every format): alert 51 offers to convert to mono
          IF INT{scratch_addr%+12}
            pointer_busy(0)
            choice&=@msgbox_show(51,"[1][ This is a stereo | sample.  Convert | it to mono? ][    Yes    | No ]")
            pointer_hide
            pointer_busy(1)
            pointer_show
            IF choice&=1
              ' Average L/R pairs, silence the freed half and close the gap behind the inserted data
              ~C:code_halve%(L:sample_base%+block_start%,L:sample_base%+block_start%+source_length%)
              ~C:code_fill%(L:sample_base%+block_start%+DIV(source_length%,2),L:source_length% DIV 2,128)
              source_length%=source_length% DIV 2
              IF block_end%<sample_end%
                BMOVE sample_base%+block_end%,sample_base%+block_start%+source_length%,sample_end%-block_end%
                ~C:code_fill%(L:sample_base%+sample_end%-source_length%,L:source_length%,128)
                pointer_show
                SUB block_end%,source_length%
                SUB sample_end%,source_length%
              ENDIF
            ENDIF
          ENDIF
          ' The inserted data becomes the block; shift the loop points behind it
          block_end%=block_start%+source_length%
          sample_loop_shift(block_start%,source_length%)
        UNTIL TRUE
        sample_length_update
        pointer_hide
        pointer_busy(0)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
        ' The file had another rate: offer to convert the inserted block to the rate in the rate field, then
        ' take the current rate back from that field
        IF sample_rate&<>rate_before&
          block_rate_convert(0)
          obj_text_query(6,15,work_text$)
          sample_rate&=VAL(work_text$)*1000
        ENDIF
      ENDIF
    ENDIF
    sample_filename$=saved_filename$
  ELSE
    ' Normal mode: insert the buffer if it is not empty
    IF buffer_start%<memory_top%
      ' Free space is smaller than the buffer: alert 10 Lose Sample / Lose Buffer / Insert to Fit / Cancel
      IF buffer_start%-sample_end%<memory_top%-buffer_start%
        choice&=@msgbox_show(10,"[1][ Not enough memory | for Insert. ][ Lose Sample | Lose Buffer | Insert to Fit | Cancel ][^M|b|i|a]")
        IF choice&<>4
          pointer_hide
          pointer_busy(1)
          pointer_show
          ' Lose Sample: shift the sample up (losing its end) and copy the buffer in at the block start
          IF choice&=1
            byte_count%=memory_top%-buffer_start%
            IF block_start%+byte_count%<buffer_start%
              BMOVE sample_base%+block_start%,sample_base%+block_start%+byte_count%,buffer_start%-block_start%-byte_count%
              BMOVE sample_base%+buffer_start%,sample_base%+block_start%,byte_count%
            ELSE
              byte_count%=buffer_start%-block_start%
              BMOVE sample_base%+buffer_start%,sample_base%+block_start%,byte_count%
            ENDIF
            sample_end%=buffer_start%
            block_end%=block_start%+byte_count%
            sample_loop_shift(block_start%,byte_count%)
          ELSE
            ' Lose Buffer: rotate the buffer into the block in 10240-byte steps; afterwards the buffer keeps only
            ' the first bytes of the inserted data that fit in the memory left over
            IF choice&=2
              byte_count%=memory_top%-buffer_start%
              block_end%=block_start%
              WHILE byte_count%>=10240
                BMOVE sample_base%+buffer_start%,scratch_addr%,10240
                BMOVE sample_base%+block_end%,sample_base%+block_end%+10240,sample_end%-block_end%
                BMOVE scratch_addr%,sample_base%+block_end%,10240
                buffer_start%=buffer_start%+10240
                sample_end%=sample_end%+10240
                block_end%=block_end%+10240
                byte_count%=byte_count%+-10240
              WEND
              IF byte_count%>0
                BMOVE sample_base%+buffer_start%,scratch_addr%,byte_count%
                BMOVE sample_base%+block_end%,sample_base%+block_end%+byte_count%,sample_end%-block_end%
                BMOVE scratch_addr%,sample_base%+block_end%,byte_count%
                buffer_start%=buffer_start%+byte_count%
                sample_end%=sample_end%+byte_count%
                block_end%=block_end%+byte_count%
              ENDIF
              buffer_start%=sample_end%
              IF buffer_start%<memory_top%
                BMOVE sample_base%+block_start%,sample_base%+buffer_start%,memory_top%-buffer_start%
              ENDIF
            ELSE
              ' Insert to Fit: insert only the first part of the buffer that fits in the free space
              IF choice&=3
                byte_count%=buffer_start%-sample_end%
                IF byte_count%>0
                  BMOVE sample_base%+block_start%,sample_base%+block_start%+byte_count%,sample_end%-block_start%
                  BMOVE sample_base%+buffer_start%,sample_base%+block_start%,byte_count%
                ENDIF
                sample_end%=sample_end%+byte_count%
                block_end%=block_start%+byte_count%
                sample_loop_shift(block_start%,byte_count%)
              ENDIF
            ENDIF
          ENDIF
          sample_length_update
        ENDIF
      ELSE
        ' Enough memory: copy the buffer in at the block start
        pointer_hide
        pointer_busy(1)
        pointer_show
        byte_count%=memory_top%-buffer_start%
        BMOVE sample_base%+block_start%,sample_base%+block_start%+byte_count%,sample_end%-block_start%
        BMOVE sample_base%+buffer_start%,sample_base%+block_start%,byte_count%
        sample_end%=sample_end%+byte_count%
        block_end%=block_start%+byte_count%
        sample_loop_shift(block_start%,byte_count%)
        sample_length_update
      ENDIF
    ENDIF
  ENDIF
RETURN
' Event handler of the Overlay dialog (tree 11), called with the clicked object in obj_num&.
' Object 8 = level text of the existing sample (slider 6, parts 5-7); object 9 = level text of the
' overlaid sound (slider 3, parts 2-4); 100 = draw the preview.  A typed level (0..1) sets its slider,
' a slider move rewrites its text.  overlay_preview redraws the preview and returns the active level in factor.
' edit_object& (LOCAL of the dialog handler dialog_run) is the text field being edited.
PROCEDURE overlay_dialog
  LOCAL slider_value&,slider_size&,obj_found%,factor,level_log2
  $S>
  SELECT obj_num&
  CASE 8
    ' Leave the text field being edited: redraw it without the cursor
    IF edit_object&<>8
      obj_find(11,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    obj_text_query(11,8,work_text$)
    ' Slider position 0 = level 1.0 at the top, 100 = level 0
    factor=ROUND(100-VAL(work_text$)*100)
    factor=MIN(100,MAX(0,factor))
    slider_setup(11,6,0,110,-10,10,factor,10)
    obj_find(11,6,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    overlay_preview
    ' Write the level into the object text (4 characters) and redraw it
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(11,8,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 5 TO 7
    ' Slider of the existing level moved: update the preview and text 8
    IF edit_object&<>8
      obj_find(11,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    overlay_preview
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(11,8,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 9
    ' Text field 9: level of the overlaid sound, slider 3
    IF edit_object&<>9
      obj_find(11,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    obj_text_query(11,9,work_text$)
    factor=ROUND(100-VAL(work_text$)*100)
    factor=MIN(100,MAX(0,factor))
    slider_setup(11,3,0,110,-10,10,factor,10)
    obj_find(11,3,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    overlay_preview
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(11,9,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 2 TO 4
    ' Slider of the overlay level moved: update the preview and text 9
    IF edit_object&<>9
      obj_find(11,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    overlay_preview
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(11,9,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 100
    overlay_preview
  ENDSELECT
RETURN
' Overlay button (main panel object 12, 'O').  Mixes a sound into the marked block: in alt mode a sample
' file (converted on request to the current rate and to mono), otherwise the buffer buffer_start%..memory_top%.
' Levels: existing sample level_a (slider obj 6), overlaid sound level_b (slider obj 3), as two 256-word
' tables for INLINE code_mix% (dst = clip(tab1[dst]+tab2[src]+128)).  Length from radio group obj 1:
' 10 = block, 11 = overlaid sound, 12 = the longer, 13 = the shorter; obj 14 = repeat the overlaid sound.
' The whole procedure is one REPEAT ... EXIT IF ... UNTIL TRUE block: EXIT IF skips the rest.
' Bug: the file is closed before format_detect seeks past the header and is then reopened at offset 0, so
' the header bytes are mixed in as sound.
PROCEDURE overlay_mix
  LOCAL obj_found%,level_a,level_b,work_ptr%,end_pointer%,file_remaining%,aux_long%,range_pos%,obj_ofs&,ix&,chunk_len%,work_text$,signed_sample!,saved_rate&,rate_convert!,channels&,average_table$,read_chunk%,write_chunk%,ratio,pad_value&
  pointer_hide
  pointer_busy(1)
  pointer_show
  REPEAT
    ' File overlay: defaults are no rate conversion, mono, 10240-byte chunks
    IF shift_mode!
      rate_convert!=FALSE
      channels&=1
      read_chunk%=10240
      write_chunk%=10240
      ratio=1
      rate_before&=sample_rate&
      length_bytes%=@fsize_of(selector_folder$+sample_filename$)
      ' Read the 128-byte header into the scratch buffer, then detect the format and parse it
      IF length_bytes%>=128
        EXIT IF @fopen_channel("I",1,selector_folder$+sample_filename$)<>0
        EXIT IF @fread_channel(1,scratch_addr%,128)<>0
        EXIT IF @fclose_channel(1)<>0
      ENDIF
      source_length%=length_bytes%
      format_detect
      format_parameters
      signed_sample!=signed_samples!
      ' File rate rounded to a timer count of the 614400 Hz clock
      file_rate_quant%=header_rate%
      file_rate_quant%=614400/file_rate_quant%+.5
      file_rate_quant%=DIV(614400,file_rate_quant%)
      ' Alert 56: Convert file? Yes / No / Cancel
      IF sample_rate&<>WORD(file_rate_quant%)
        work_text$=TRIM$(STR$(header_rate%/1000))+"KHz to "+TRIM$(STR$(sample_rate&/1000))+"KHz)"
        pointer_busy(0)
        choice&=@msgbox_show(56,"[1][ Convert file?  (from | "+work_text$+" ][   Yes   | No |   Cancel   ][^M|n|a]")
        pointer_hide
        pointer_busy(1)
        pointer_show
        EXIT IF choice&=3
        IF choice&=1
          rate_convert!=TRUE
          ratio=header_rate%/sample_rate&
          ' File rate higher: averaging table for down-sampling; 10240 read bytes give 10240/ratio output bytes
          IF header_rate%>sample_rate&
            average_table$=SPACE$(255*ratio+1)
            FOR ix&=0 TO 255*ratio
              BYTE{ix&+V:average_table$}=ROUND(ix&/ratio)
            NEXT ix&
            write_chunk%=10240/ratio
          ELSE
            ' File rate lower: read fewer bytes so the up-sampled chunk is 10240 bytes
            read_chunk%=10240*ratio
          ENDIF
        ENDIF
      ENDIF
      ' Stereo file: alert 52 offers mono (pairs averaged, chunks halved); No mixes the interleaved bytes
      IF header_stereo!
        pointer_busy(0)
        choice&=@msgbox_show(52,"[1][ This is a stereo sample. | Convert it to mono? ][    Yes    | No |   Cancel   ][^M|n|a]")
        pointer_hide
        pointer_busy(1)
        pointer_show
        EXIT IF choice&=3
        IF choice&=1
          channels&=2
          read_chunk%=read_chunk% DIV 2
          write_chunk%=write_chunk% DIV 2
        ENDIF
      ENDIF
      ' Overlay length from the radio group, limited to the sample end
      radio_find_selected(11,1,obj_found%)
      SELECT INT{obj_found%}
      CASE 10
        mix_length%=block_end%-block_start%
      CASE 11
        mix_length%=source_length%
      CASE 12
        mix_length%=MAX(block_end%-block_start%,source_length%)
      CASE 13
        mix_length%=MIN(block_end%-block_start%,source_length%)
      ENDSELECT
      IF block_start%+mix_length%>sample_end%
        mix_length%=sample_end%-block_start%
      ENDIF
      ' Repeat the overlaid sound (object 14) or leave the rest of the length at the existing level only
      radio_find_selected(11,2,obj_found%)
      IF INT{obj_found%}=14
        overlay_repeat!=TRUE
      ELSE
        overlay_repeat!=FALSE
      ENDIF
      ' Levels from the sliders: position 0 = 1.0, 100 = 0
      slider_value_query(11,6,slider_value&,slider_size&)
      level_a=(100-slider_value&)/100
      slider_value_query(11,3,slider_value&,slider_size&)
      level_b=(100-slider_value&)/100
      ~C:code_fill%(L:scratch_addr%,L:10240,128)
      work_ptr%=sample_base%+block_start%
      file_remaining%=source_length%
      ' Mix tables: 256 words of (value-128)*level_a for the block, then 256 words of (value-128)*level_b for the file
      work_text$=SPACE$(1024)
      obj_ofs&=0
      FOR ix&=0 TO 255
        CARD{obj_ofs&+V:work_text$}=(ix&-128)*level_a
        ADD obj_ofs&,2
      NEXT ix&
      FOR ix&=0 TO 255
        CARD{obj_ofs&+V:work_text$}=(ix&-128)*level_b
        ADD obj_ofs&,2
      NEXT ix&
      EXIT IF source_length%<=0
      ' Reopen the file; pad_value& is the padding byte (silence) in the file's own sign format
      EXIT IF @fopen_channel("I",1,selector_folder$+sample_filename$)<>0
      pad_value&=128
      IF signed_samples!
        pad_value&=0
      ENDIF
      gem_error&=0
      ' The whole file fits in one chunk: read it, convert sign, channels and rate in the scratch buffer
      IF source_length%<=MUL(read_chunk%,channels&)
        EXIT IF @fread_channel(1,scratch_addr%,source_length%)<>0
        IF signed_sample!
          ~C:code_sign_flip%(L:scratch_addr%,L:scratch_addr%+source_length%)
        ENDIF
        IF channels&=2
          ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+source_length%)
          source_length%=source_length% DIV 2
        ENDIF
        IF rate_convert!
          ' Down-sample: 2:1 averages pairs, other ratios use the averaging code with the table average_table$
          IF file_rate_quant%>sample_rate&
            IF ABS(ratio-2)<.005
              ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+source_length%)
            ELSE
              ~C:code_downsample%(L:scratch_addr%,L:scratch_addr%,L:scratch_addr%+source_length%,L:ratio*65536,L:V:average_table$)
            ENDIF
          ELSE
            ' Up-sample: move the data to the end of the output area, then interpolate forwards to the start
            BMOVE scratch_addr%,ADD(source_length%*(1/ratio-1),scratch_addr%),source_length%
            pointer_show
            IF ABS(ratio-.5)<.0005
              ~C:code_double%(L:ADD(source_length%*(1/ratio-1),scratch_addr%),L:ADD(source_length%/ratio,scratch_addr%),L:scratch_addr%)
            ELSE
              ~C:code_upsample%(L:scratch_addr%,L:ADD(source_length%*(1/ratio-1),scratch_addr%),L:ADD(source_length%/ratio,scratch_addr%),ratio*65536)
            ENDIF
          ENDIF
          source_length%=source_length%/ratio
        ENDIF
        ' Repeat: mix the file again and again until the overlay length is used up
        IF overlay_repeat!
          WHILE mix_length%>source_length%
            ~C:code_mix%(L:work_ptr%,L:work_ptr%+source_length%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
            work_ptr%=work_ptr%+source_length%
            SUB mix_length%,source_length%
          WEND
          ~C:code_mix%(L:work_ptr%,L:work_ptr%+mix_length%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
        ELSE
          ' No repeat: mix once, then scale the rest of the length by the block level alone (byte map code_byte_map%)
          IF mix_length%>source_length%
            ~C:code_mix%(L:work_ptr%,L:work_ptr%+source_length%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
            work_ptr%=work_ptr%+source_length%
            SUB mix_length%,source_length%
            FOR ix&=0 TO 255
              BYTE{scratch_addr%+ix&}=MIN(255,MAX(0,(ix&-128)*level_a+128))
            NEXT ix&
            ~C:code_byte_map%(L:work_ptr%,L:work_ptr%+mix_length%,L:scratch_addr%)
          ELSE
            ~C:code_mix%(L:work_ptr%,L:work_ptr%+mix_length%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
          ENDIF
        ENDIF
      ELSE
        ' Large file: read, convert and mix chunk by chunk
        WHILE mix_length%>write_chunk%
          ' A full chunk is left in the file
          IF file_remaining%>=MUL(read_chunk%,channels&)
            gem_error&=@fread_channel(1,scratch_addr%,read_chunk%*channels&)
            SUB file_remaining%,read_chunk%*channels&
          ELSE
            ' The file ends inside this chunk
            gem_error&=@fread_channel(1,scratch_addr%,file_remaining%)
            EXIT IF gem_error&
            ' Repeat: seek back to the start (128 for an AVR, else 0; Fseek) and fill the chunk from there
            IF overlay_repeat!
              aux_long%=MUL(read_chunk%,channels&)-file_remaining%
              IF RIGHT$(sample_filename$,4)=".AVR"
                gem_error&=@fseek_abs(1,128)
              ELSE
                gem_error&=@fseek_abs(1,0)
              ENDIF
              EXIT IF gem_error&
              gem_error&=@fread_channel(1,scratch_addr%+file_remaining%,aux_long%)
              file_remaining%=source_length%-aux_long%
            ELSE
              ' No repeat: pad the chunk with silence
              ~C:code_fill%(L:scratch_addr%+file_remaining%,L:MUL(read_chunk%,channels&)-file_remaining%,pad_value&)
              file_remaining%=0
            ENDIF
          ENDIF
          EXIT IF gem_error&
          IF signed_sample!
            ~C:code_sign_flip%(L:scratch_addr%,L:scratch_addr%+MUL(read_chunk%,channels&))
          ENDIF
          IF channels&=2
            ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+read_chunk%*2)
          ENDIF
          IF rate_convert!
            IF file_rate_quant%>sample_rate&
              IF ABS(ratio-2)<.005
                ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+read_chunk%)
              ELSE
                ~C:code_downsample%(L:scratch_addr%,L:scratch_addr%,L:scratch_addr%+read_chunk%,L:ratio*65536,L:V:average_table$)
              ENDIF
            ELSE
              BMOVE scratch_addr%,ADD(read_chunk%*(1/ratio-1),scratch_addr%),read_chunk%
              pointer_show
              IF ABS(ratio-.5)<.0005
                ~C:code_double%(L:ADD(read_chunk%*(1/ratio-1),scratch_addr%),L:ADD(read_chunk%/ratio,scratch_addr%),L:scratch_addr%)
              ELSE
                ~C:code_upsample%(L:scratch_addr%,L:ADD(read_chunk%*(1/ratio-1),scratch_addr%),L:ADD(read_chunk%/ratio,scratch_addr%),ratio*65536)
              ENDIF
            ENDIF
          ENDIF
          ' Mix the converted chunk into the block
          ~C:code_mix%(L:work_ptr%,L:work_ptr%+write_chunk%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
          SUB mix_length%,write_chunk%
          work_ptr%=work_ptr%+write_chunk%
        WEND
        EXIT IF gem_error&
        ' The last partial chunk: convert the remaining output length into file bytes and do the same again
        mix_length%=ratio*mix_length%
        IF file_remaining%>=MUL(mix_length%,channels&)
          gem_error&=@fread_channel(1,scratch_addr%,mix_length%*channels&)
        ELSE
          gem_error&=@fread_channel(1,scratch_addr%,file_remaining%)
          EXIT IF gem_error&
          IF overlay_repeat!
            aux_long%=MUL(mix_length%,channels&)-file_remaining%
            IF RIGHT$(sample_filename$,4)=".AVR"
              gem_error&=@fseek_abs(1,128)
            ELSE
              gem_error&=@fseek_abs(1,0)
            ENDIF
            EXIT IF gem_error&
            gem_error&=@fread_channel(1,scratch_addr%+file_remaining%,aux_long%)
            file_remaining%=source_length%-aux_long%
          ELSE
            ~C:code_fill%(L:scratch_addr%+file_remaining%,L:MUL(mix_length%,channels&)-file_remaining%,pad_value&)
            file_remaining%=0
          ENDIF
        ENDIF
        EXIT IF gem_error&
        IF signed_sample!
          ~C:code_sign_flip%(L:scratch_addr%,L:scratch_addr%+MUL(mix_length%,channels&))
        ENDIF
        IF channels&=2
          ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+mix_length%*2)
        ENDIF
        IF rate_convert!
          IF file_rate_quant%>sample_rate&
            IF ABS(ratio-2)<.005
              ~C:code_halve%(L:scratch_addr%,L:scratch_addr%+mix_length%)
            ELSE
              ~C:code_downsample%(L:scratch_addr%,L:scratch_addr%,L:scratch_addr%+mix_length%,L:ratio*65536,L:V:average_table$)
            ENDIF
          ELSE
            BMOVE scratch_addr%,ADD(mix_length%*(1/ratio-1),scratch_addr%),mix_length%
            pointer_show
            IF ABS(ratio-.5)<.0005
              ~C:code_double%(L:ADD(mix_length%*(1/ratio-1),scratch_addr%),L:ADD(mix_length%/ratio,scratch_addr%),L:scratch_addr%)
            ELSE
              ~C:code_upsample%(L:scratch_addr%,L:ADD(mix_length%*(1/ratio-1),scratch_addr%),L:ADD(mix_length%/ratio,scratch_addr%),ratio*65536)
            ENDIF
          ENDIF
          mix_length%=mix_length%/ratio
        ENDIF
        ~C:code_mix%(L:work_ptr%,L:work_ptr%+mix_length%,L:scratch_addr%,L:V:work_text$,L:512+V:work_text$)
      ENDIF
      ' Close the file; the file overlay is finished
      ~@fclose_channel(1)
      EXIT IF TRUE
    ENDIF
    ' Buffer overlay: length from the radio group (11 = buffer length), limited to the sample end
    radio_find_selected(11,1,obj_found%)
    SELECT INT{obj_found%}
    CASE 10
      mix_length%=block_end%-block_start%
    CASE 11
      mix_length%=memory_top%-buffer_start%
    CASE 12
      mix_length%=MAX(block_end%-block_start%,memory_top%-buffer_start%)
    CASE 13
      mix_length%=MIN(block_end%-block_start%,memory_top%-buffer_start%)
    ENDSELECT
    IF block_start%+mix_length%>sample_end%
      mix_length%=sample_end%-block_start%
    ENDIF
    radio_find_selected(11,2,obj_found%)
    IF INT{obj_found%}=14
      overlay_repeat!=TRUE
    ELSE
      overlay_repeat!=FALSE
    ENDIF
    slider_value_query(11,6,slider_value&,slider_size&)
    level_a=(100-slider_value&)/100
    slider_value_query(11,3,slider_value&,slider_size&)
    level_b=(100-slider_value&)/100
    ' Pointers: block start, buffer start, top of memory; mix tables in the scratch buffer at +0 and +512
    work_ptr%=sample_base%+block_start%
    end_pointer%=sample_base%+buffer_start%
    file_remaining%=sample_base%+memory_top%
    aux_long%=512+scratch_addr%
    ~C:code_fill%(L:scratch_addr%,L:10240,128)
    obj_ofs&=0
    FOR ix&=0 TO 255
      CARD{scratch_addr%+obj_ofs&}=(ix&-128)*level_a
      ADD obj_ofs&,2
    NEXT ix&
    FOR ix&=0 TO 255
      CARD{scratch_addr%+obj_ofs&}=(ix&-128)*level_b
      ADD obj_ofs&,2
    NEXT ix&
    ' Length equals the buffer length, or the block is shorter than the buffer: one mix does it
    IF mix_length%=memory_top%-buffer_start%
      ~C:code_mix%(L:work_ptr%,L:work_ptr%+mix_length%,L:end_pointer%,L:scratch_addr%,L:aux_long%)
      EXIT IF TRUE
    ENDIF
    IF block_end%-block_start%<memory_top%-buffer_start%
      ~C:code_mix%(L:work_ptr%,L:work_ptr%+mix_length%,L:end_pointer%,L:scratch_addr%,L:aux_long%)
      EXIT IF TRUE
    ENDIF
    ' Repeat: mix the whole buffer again and again, the last pass up to the block end
    IF overlay_repeat!
      ' No repeat: mix the buffer once, then scale the rest of the block by the block level alone
      chunk_len%=memory_top%-buffer_start%
      WHILE mix_length%>chunk_len%
        ~C:code_mix%(L:work_ptr%,L:work_ptr%+chunk_len%,L:end_pointer%,L:scratch_addr%,L:aux_long%)
        SUB mix_length%,chunk_len%
        work_ptr%=work_ptr%+chunk_len%
      WEND
      ~C:code_mix%(L:work_ptr%,L:sample_base%+block_end%,L:end_pointer%,L:scratch_addr%,L:aux_long%)
      EXIT IF TRUE
    ENDIF
    chunk_len%=memory_top%-buffer_start%
    ~C:code_mix%(L:work_ptr%,L:work_ptr%+chunk_len%,L:end_pointer%,L:scratch_addr%,L:aux_long%)
    work_ptr%=work_ptr%+chunk_len%
    FOR ix&=0 TO 255
      BYTE{scratch_addr%+ix&}=MIN(255,MAX(0,(ix&-128)*level_a+128))
    NEXT ix&
    ~C:code_byte_map%(L:work_ptr%,L:sample_base%+block_end%,L:scratch_addr%)
  UNTIL TRUE
  pointer_hide
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
  trace_draw
RETURN
' Draws the preview of the Overlay dialog (tree 11) at dialog origin origin_x&+20,origin_y&: wave A at level
' level_a, wave B at level level_b and their sum, 299/300 columns, in the waveform style trace_style&
' (1 = lines, 2 = bars drawn longest first, else dots).  Mono uses patterns, colour uses colours 1-3.
' Returns in factor the level that belongs to the clicked object (obj_num& 5..8 = level A, else level B).
' step_bytes%, work_ptr% and end_pointer% are set but never used.
PROCEDURE overlay_preview
  LOCAL ix&,work_ptr%,end_pointer%,wave_y,scaled_y,wave_y_next,scaled_y_next,wave_b,plot_b,wave_b_next,plot_b_next,wave_mix,plot_mix,wave_mix_next,plot_mix_next,step_bytes%,amplitude,level_a,level_b,y_centre&,colour_work&,knob_start&,knob_end&,lo_n&,range_max&
  origin_x&=origin_x&+20
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  ' Clear the preview box and draw its centre line
  IF mono!
    ARECT origin_x&+5,origin_y&+26,304+origin_x&,153+origin_y&,0,0,V:pattern_solid%,1
    HLINE origin_x&+5,origin_y&+90,304+origin_x&,1,0,V:pattern_grey%,1
  ELSE
    ARECT origin_x&+5,origin_y&+13,304+origin_x&,origin_y&+76,0,0,V:pattern_solid%,1
    HLINE origin_x&+5,origin_y&+45,304+origin_x&,1,0,V:pattern_solid%,1
  ENDIF
  slider_value_query(11,6,slider_value&,slider_size&)
  level_a=(100-slider_value&)/100
  slider_value_query(11,3,slider_value&,slider_size&)
  level_b=(100-slider_value&)/100
  work_ptr%=sample_base%+block_start%
  end_pointer%=sample_base%+buffer_start%
  step_bytes%=mix_length%/300
  ' Mono: amplitude 32, clip -63..64, centre 90; patterns $5555 (A) and $7777 (B).  Colour: amplitude 16,
  ' clip -31..32, centre 45, solid lines in colours 1, 2 and 3
  IF mono!
    amplitude=32
    knob_start&=21845
    knob_end&=30583
    colour_work&=1
    lo_n&=-63
    range_max&=64
    y_centre&=90
  ELSE
    amplitude=16
    knob_start&=-1
    knob_end&=-1
    colour_work&=2
    lo_n&=-31
    range_max&=32
    y_centre&=45
  ENDIF
  SELECT trace_style&
  CASE 1
    ' Line style: a line from each column to the next for A, B and the mix
    FOR ix&=0 TO 298
      preview_waves
      scaled_y=level_a*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      plot_b=level_b*wave_b
      plot_b=MIN(MAX(plot_b,lo_n&),range_max&)
      plot_mix=MIN(MAX(wave_mix,lo_n&),range_max&)
      scaled_y_next=level_a*wave_y_next
      scaled_y_next=MIN(MAX(scaled_y_next,lo_n&),range_max&)
      plot_b_next=level_b*wave_b_next
      plot_b_next=MIN(MAX(plot_b_next,lo_n&),range_max&)
      plot_mix_next=MIN(MAX(wave_mix_next,lo_n&),range_max&)
      ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),origin_x&+6+ix&,SUB(origin_y&+y_centre&,scaled_y_next),1,knob_start&,0
      ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),origin_x&+6+ix&,SUB(origin_y&+y_centre&,plot_b_next),colour_work&,knob_end&,0
      ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),origin_x&+6+ix&,SUB(origin_y&+y_centre&,plot_mix_next),3,-1,0
      knob_end&=ROR&(knob_end&,2)
    NEXT ix&
  CASE 2
    ' Bar style: vertical bars from the centre line, the longest drawn first so the shorter stay visible
    FOR ix&=0 TO 299
      preview_waves
      scaled_y=level_a*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      plot_b=level_b*wave_b
      plot_b=MIN(MAX(plot_b,lo_n&),range_max&)
      plot_mix=MIN(MAX(wave_mix,lo_n&),range_max&)
      IF MAX(MAX(ABS(scaled_y),ABS(plot_b)),ABS(plot_mix))=ABS(scaled_y)
        ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1,knob_start&,0
        IF ABS(plot_b)>ABS(plot_mix)
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),colour_work&,knob_end&,0
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3,-1,0
        ELSE
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3,-1,0
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),colour_work&,knob_end&,0
        ENDIF
      ELSE
        IF ABS(plot_b)>ABS(plot_mix)
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),colour_work&,knob_end&,0
          IF ABS(scaled_y)>ABS(plot_mix)
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1,knob_start&,0
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3,-1,0
          ELSE
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3,-1,0
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1,knob_start&,0
          ENDIF
        ELSE
          ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3,-1,0
          IF ABS(scaled_y)>ABS(plot_b)
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1,knob_start&,0
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),colour_work&,knob_end&,0
          ELSE
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),colour_work&,knob_end&,0
            ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1,knob_start&,0
          ENDIF
        ENDIF
      ENDIF
      knob_end&=ROR&(knob_end&,2)
      knob_start&=NOT knob_start&
    NEXT ix&
  DEFAULT
    ' Dot style: in mono A on odd columns, B on every fourth, the mix on all
    FOR ix&=0 TO 299
      preview_waves
      scaled_y=level_a*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      plot_b=level_b*wave_b
      plot_b=MIN(MAX(plot_b,lo_n&),range_max&)
      plot_mix=MIN(MAX(wave_mix,lo_n&),range_max&)
      IF mono!=FALSE OR ODD(ix&)
        PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1
      ENDIF
      IF mono!=FALSE OR (ix& AND 3)<>0
        PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_b),2
      ENDIF
      PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,plot_mix),3
    NEXT ix&
  ENDSELECT
  pointer_show
  ' Return the level for the text field that belongs to the clicked object
  origin_x&=origin_x&+-20
  IF obj_num&>4 AND obj_num&<9
    factor=level_a
  ELSE
    factor=level_b
  ENDIF
RETURN
' Preview waves for column ix& (and the next column): wave A = sine with 6 degrees per column,
' wave B = sine with 2.4 degrees per column, both of amplitude amplitude; wave_mix/wave_mix_next = the mix
' A*level_a + B*level_b.  Works on the caller's locals (overlay_preview).
PROCEDURE preview_waves
  wave_y=SINQ(ix&*6)*amplitude
  wave_y_next=SINQ((ix&+1)*6)*amplitude
  wave_b=SINQ(ix&*2.4)*amplitude
  wave_b_next=SINQ((ix&+1)*2.4)*amplitude
  wave_mix=wave_y*level_a+wave_b*level_b
  wave_mix_next=wave_y_next*level_a+wave_b_next*level_b
RETURN
' Event handler of the Volume dialog (tree 8), called with the clicked object in obj_num&.
' Object 1 = play the block through the volume table (amplify_try), 2 = factor text (0.25..4),
' 5-7 = slider (32 steps per doubling, -64..64), 8 = draw the preview.  volume_preview_draw draws the preview
' and returns the factor in factor.  level_log2 holds log2 of the factor.
PROCEDURE volume_dialog
  LOCAL slider_value&,slider_size&,obj_found%,factor,level_log2
  SELECT obj_num&
  CASE 1
    amplify_try
  CASE 2
    obj_text_query(8,2,work_text$)
    factor=VAL(work_text$)
    ' Factor 0.25..4 to slider position -32*log2(factor) (up = louder)
    factor=MIN(4,MAX(.25,factor))
    level_log2=LOG(factor)/LOG(2)
    slider_setup(8,5,-64,80,-16,16,ROUND(-level_log2*32),16)
    obj_find(8,5,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    volume_preview_draw(0)
    ' Write the factor back into the text (5 characters) and redraw it
    work_text$=LEFT$(STR$(factor)+"     ",5)
    obj_find(8,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),5
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 5 TO 7
    volume_preview_draw(0)
    work_text$=LEFT$(STR$(factor)+"     ",5)
    obj_find(8,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),5
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 8
    volume_preview_draw(0)
  ENDSELECT
RETURN
' Volume button (main panel object 13): applies the Volume dialog when it was closed with OK
' (choice& = 1).  The factor is 2^(-slider/32); every byte of the block is mapped through a 256-byte
' table clip((value-128)*factor+128) by INLINE code_byte_map%.  range_pos% and line_pattern& are declared but unused.
PROCEDURE volume_apply
  LOCAL range_pos%,line_pattern&,ix&
  IF choice&=1 AND block_end%>block_start%
    pointer_hide
    pointer_busy(1)
    pointer_show
    slider_value_query(8,5,slider_value&,slider_size&)
    ' Build the volume map in the scratch buffer
    factor=2^(-slider_value&/32)
    FOR ix&=0 TO 255
      BYTE{scratch_addr%+ix&}=MIN(255,MAX(0,(ix&-128)*factor+128))
    NEXT ix&
    ~C:code_byte_map%(L:sample_base%+block_start%,L:sample_base%+block_end%,L:scratch_addr%)
    pointer_busy(0)
    trace_draw
  ENDIF
RETURN
' Draws the 300-column preview of the amplify dialog (mode_param& = 0) or the fade dialog (mode_param& = 1).
' Mode 0 reads the gain from slider 5 of dialog 8 (2^(-value/32)); mode 1 reads the start (slider 8) and
' end (slider 5) volumes of dialog 12 and first draws the envelope outline for shape fade_shape&.
' Then each column shows the original wave (grey/dotted) and the scaled wave (colour 3), as lines, bars or
' dots by trace_style&; the larger of the two is drawn first.  The wave is the block data or a test sine (opt_preview_sample&).
' On return in mode 1, factor holds the start or end factor, whichever control (obj_num&) was used.
PROCEDURE volume_preview_draw(mode_param&)
  LOCAL ix&,work_ptr%,wave_y,scaled_y,wave_y_next,scaled_y_next,step_bytes%,amplitude,level_a,level_b,level_step,factor_range,phase_offset&,line_pattern&,y_centre&,lo_n&,range_max&
  ' The fade preview area sits 20 pixels further right; undone at the end.
  IF mode_param&
    origin_x&=origin_x&+20
  ENDIF
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  ' Clear the preview area and draw the centre line (mono: 128 high, centre +90; colour: 64 high, +45).
  IF mono!
    ARECT origin_x&+5,origin_y&+26,304+origin_x&,153+origin_y&,0,0,V:pattern_solid%,1
    HLINE origin_x&+5,origin_y&+90,304+origin_x&,1,0,V:pattern_grey%,1
  ELSE
    ARECT origin_x&+5,origin_y&+13,304+origin_x&,origin_y&+76,0,0,V:pattern_solid%,1
    HLINE origin_x&+5,origin_y&+45,304+origin_x&,1,0,V:pattern_solid%,1
  ENDIF
  ' Amplify: constant gain from slider 5 of dialog 8, no slope.
  IF mode_param&=0
    slider_value_query(8,5,slider_value&,slider_size&)
    factor=2^(-slider_value&/32)
    level_step=0
  ELSE
    ' Fade: slider value 0..100 is inverted, factor = (100 - value) / 100.  Slider 8 = start, slider 5 = end.
    slider_value_query(12,8,slider_value&,slider_size&)
    level_a=(100-slider_value&)/100
    slider_value_query(12,5,slider_value&,slider_size&)
    level_b=(100-slider_value&)/100
    level_step=(level_b-level_a)/300  !linear slope per column
    factor=level_a
    factor_range=ABS(level_a-level_b)
    IF mono!
      line_pattern&=21845
      y_centre&=90
      range_max&=64
    ELSE
      line_pattern&=-1
      y_centre&=45
      range_max&=32
    ENDIF
    ' Shape 0: straight envelope lines above and below the centre.
    IF fade_shape&=0
      ALINE origin_x&+5,SUB(origin_y&+y_centre&,range_max&*level_a),304+origin_x&,SUB(origin_y&+y_centre&,range_max&*level_b),1,line_pattern&,0
      ALINE origin_x&+5,ADD(origin_y&+y_centre&,range_max&*MIN(.96875,level_a)),304+origin_x&,ADD(origin_y&+y_centre&,range_max&*MIN(.96875,level_b)),1,line_pattern&,0
    ELSE
      ' Shape 1: quarter sine (0.3 degrees per column, 90 degrees over 300 columns), phase picks rise or fall.
      IF fade_shape&=1
        IF level_a>level_b
          phase_offset&=90
        ELSE
          phase_offset&=0
        ENDIF
        factor=MIN(level_a,level_b)
        FOR ix&=0 TO 299
          scaled_y=(SINQ(ix&*.3+phase_offset&)*factor_range+factor)*range_max&
          IF mono!=FALSE OR ODD(ix&)
            PSET origin_x&+5+ix&,ADD(origin_y&+y_centre&,MIN(scaled_y,range_max&-1)),1
            PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1
          ENDIF
        NEXT ix&
      ELSE
        ' Shape 2: the other quarter sine (sine + 1 over 180..360 degrees).
        IF fade_shape&=2
          IF level_a>level_b
            phase_offset&=180
          ELSE
            phase_offset&=270
          ENDIF
          factor=MIN(level_a,level_b)
          FOR ix&=0 TO 299
            scaled_y=((SINQ(ix&*.3+phase_offset&)+1)*factor_range+factor)*range_max&
            IF mono!=FALSE OR ODD(ix&)
              PSET origin_x&+5+ix&,ADD(origin_y&+y_centre&,MIN(scaled_y,range_max&-1)),1
              PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1
            ENDIF
          NEXT ix&
        ELSE
          IF level_a>level_b
            phase_offset&=90
          ELSE
            phase_offset&=270
          ENDIF
          factor=MIN(level_a,level_b)
          FOR ix&=0 TO 299
            ' Shape 3: half sine S curve (0.6 degrees per column).
            scaled_y=(factor*2+(SINQ(ix&*.6+phase_offset&)+1)*factor_range)*range_max&/2
            IF mono!=FALSE OR ODD(ix&)
              PSET origin_x&+5+ix&,ADD(origin_y&+y_centre&,MIN(scaled_y,range_max&-1)),1
              PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),1
            ENDIF
          NEXT ix&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' Read pointer into the block and bytes per column for the 300 columns.
  work_ptr%=sample_base%+block_start%
  step_bytes%=(block_end%-block_start%)/300
  IF mono!
    amplitude=.5
    y_centre&=90
    line_pattern&=21845
    lo_n&=-63
    range_max&=64
  ELSE
    amplitude=.25
    y_centre&=45
    line_pattern&=-1
    lo_n&=-31
    range_max&=32
  ENDIF
  ' Draw style: 1 lines between columns, 2 vertical bars from the centre, otherwise dots.
  SELECT trace_style&
  CASE 1
    FOR ix&=0 TO 298
      preview_point_calc
      scaled_y=env_level*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      scaled_y_next=env_level_next*wave_y_next
      scaled_y_next=MIN(MAX(scaled_y_next,lo_n&),range_max&)
      IF env_level>1
        ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),origin_x&+6+ix&,SUB(origin_y&+y_centre&,scaled_y_next),3,-1,0
      ENDIF
      ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,wave_y),origin_x&+6+ix&,SUB(origin_y&+y_centre&,wave_y_next),1,line_pattern&,0
      IF env_level<=1
        ALINE origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),origin_x&+6+ix&,SUB(origin_y&+y_centre&,scaled_y_next),3,-1,0
      ENDIF
    NEXT ix&
  CASE 2
    FOR ix&=0 TO 299
      preview_point_calc
      scaled_y=env_level*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      IF env_level>1
        ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),3,-1,0
      ENDIF
      ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,wave_y),1,line_pattern&,0
      IF env_level<=1
        ALINE origin_x&+5+ix&,origin_y&+y_centre&,origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),3,-1,0
      ENDIF
      IF mono!
        line_pattern&=NOT line_pattern&
      ENDIF
    NEXT ix&
  DEFAULT
    FOR ix&=0 TO 299
      preview_point_calc
      scaled_y=env_level*wave_y
      scaled_y=MIN(MAX(scaled_y,lo_n&),range_max&)
      IF env_level>1
        PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),3
      ENDIF
      IF mono!=FALSE OR ODD(ix&)
        PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,wave_y),1
      ENDIF
      IF env_level<=1
        PSET origin_x&+5+ix&,SUB(origin_y&+y_centre&,scaled_y),3
      ENDIF
    NEXT ix&
  ENDSELECT
  ' Show the mouse again.
  pointer_show
  ' Restore the dialog x and hand the start or end factor back to the caller for its text field.
  IF mode_param&
    origin_x&=origin_x&+-20
    IF obj_num&>7 AND obj_num&<11 OR obj_num&=2
      factor=level_a
    ELSE
      factor=level_b
    ENDIF
  ENDIF
RETURN
' Helper of volume_preview_draw, called once per column ix&.
' Sets wave_y/wave_y_next to the original wave y of this and the next column, from the block bytes (128 = zero)
' when opt_preview_sample& is set, otherwise from a test sine (a faster, larger one for the fade preview).
' Sets env_level/env_level_next to the envelope factor of this and the next column for shape fade_shape&.
PROCEDURE preview_point_calc
  ' Unsigned sample bytes, 128 is the zero line; the pointer advances one column per call.
  IF opt_preview_sample&
    wave_y=(128-BYTE{work_ptr%})*amplitude
    work_ptr%=work_ptr%+step_bytes%
    wave_y_next=(128-BYTE{work_ptr%})*amplitude
  ELSE
    IF mode_param&
      wave_y=SINQ(ix&*4.8)*32
      wave_y_next=SINQ((ix&+1)*4.8)*32
    ELSE
      wave_y=SINQ(ix&*1.2)*16
      wave_y_next=SINQ((ix&+1)*1.2)*16
    ENDIF
  ENDIF
  ' Envelope factor of this and the next column: 0 linear (stepped by level_step), 1-3 the sine shapes.
  SELECT fade_shape&
  CASE 0
    env_level=factor
    factor=factor+level_step
    env_level_next=factor
  CASE 1
    env_level=SINQ(ix&*.3+phase_offset&)*factor_range+factor
    env_level_next=SINQ((ix&+1)*.3+phase_offset&)*factor_range+factor
  CASE 2
    env_level=(SINQ(ix&*.3+phase_offset&)+1)*factor_range+factor
    env_level_next=(SINQ((ix&+1)*.3+phase_offset&)+1)*factor_range+factor
  CASE 3
    env_level=(factor*2+(SINQ(ix&*.6+phase_offset&)+1)*factor_range)/2
    env_level_next=(factor*2+(SINQ((ix&+1)*.6+phase_offset&)+1)*factor_range)/2
  ENDSELECT
RETURN
' Try button of the amplify dialog 8: builds a 256-byte gain table in scratch_addr% from slider 5
' (gain 2^(-value/32), clipped to 0..255) and plays the block through it.
' The LOCAL output_table% makes the player use this table; the LOCAL shift_mode! = FALSE plays the block, not the buffer.
' counter& is declared but never used.
PROCEDURE amplify_try
  LOCAL ix&,y_or_j&,counter&,output_table%,shift_mode!
  shift_mode!=FALSE
  output_table%=scratch_addr%
  slider_value_query(8,5,slider_value&,slider_size&)
  factor=2^(-slider_value&/32)
  ' Table entry = (byte - 128) * gain + 128, clipped.
  FOR ix&=0 TO 255
    y_or_j&=(ix&-128)*factor+128
    y_or_j&=MIN(255,MAX(0,y_or_j&))
    BYTE{scratch_addr%+ix&}=y_or_j&
  NEXT ix&
  ' Play with the preview table.
  sample_play
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' Event handler of the fade dialog 12 (called by action_dispatch for each object event).
' Objects: 1 Try, 2 start text, 5..7 end slider, 8..10 start slider, 12 fade-in preset, 13 fade-out preset,
' 14 end text, 15 shape button (opens dialog 13), 100 redraw request for the preview.
' Text fields hold factors 0..1; sliders hold 100 - percent.  After a change the preview is redrawn and the
' matching text field is rewritten with factor from volume_preview_draw.  level_log2 is declared but never used.
PROCEDURE fade_dialog_event
  LOCAL slider_value&,slider_size&,obj_found%,factor,level_log2
  SELECT obj_num&
  CASE 1
    ' Try: play the block with the fade applied on the fly.
    fade_try
  CASE 2
    ' Start text typed: take the edit cursor off the current field (edit_object& = 0 redraws without cursor).
    IF edit_object&<>2
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    ' Convert the typed factor to a slider value 0..100 and set the start slider 8.
    obj_text_query(12,2,work_text$)
    factor=ROUND(100-VAL(work_text$)*100)
    factor=MIN(100,MAX(0,factor))
    slider_setup(12,8,0,110,-10,10,factor,10)
    obj_find(12,8,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    volume_preview_draw(1)
    ' Write the factor back into text 2 (spec text at +16); edit_object& = -1 redraws it with the cursor.
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(12,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 8 TO 10
    ' Start slider moved: update text 2 from the start factor.
    IF edit_object&<>2
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    volume_preview_draw(1)
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(12,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 12
    ' Fade in preset: end slider to 100% (value 0), start slider to 0% (value 100).
    IF edit_object&<>14
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    slider_setup(12,5,0,110,-10,10,0,10)
    obj_find(12,5,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    slider_setup(12,8,0,110,-10,10,100,10)
    obj_find(12,8,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    volume_preview_draw(1)
    ' "1   " into the end text 14, then "0   " into the start text 2.
    work_text$=MKL$(824188960)
    obj_find(12,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=0
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=MKL$(807411744)
    obj_find(12,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
  CASE 13
    ' Fade out preset: end 0%, start 100%; texts "0   " and "1   ".
    IF edit_object&<>14
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    slider_setup(12,5,0,110,-10,10,100,10)
    obj_find(12,5,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    slider_setup(12,8,0,110,-10,10,0,10)
    obj_find(12,8,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    volume_preview_draw(1)
    work_text$=MKL$(807411744)
    obj_find(12,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=0
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=MKL$(824188960)
    obj_find(12,2,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
  CASE 14
    ' End text typed: set the end slider 5 from it.
    IF edit_object&<>14
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    obj_text_query(12,14,work_text$)
    factor=ROUND(100-VAL(work_text$)*100)
    factor=MIN(100,MAX(0,factor))
    slider_setup(12,5,0,110,-10,10,factor,10)
    obj_find(12,5,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    volume_preview_draw(1)
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(12,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 5 TO 7
    ' End slider moved: update text 14 from the end factor.
    IF edit_object&<>14
      obj_find(12,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    volume_preview_draw(1)
    work_text$=LEFT$(STR$(factor)+"    ",4)
    obj_find(12,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 15
    ' Shape button: preselect radio fade_shape&+2 in group 1 of dialog 13 and run that dialog.
    radio_find_selected(13,1,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=0
    obj_find(13,fade_shape&+2,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=-1
    dialog_run(13,choice&)
    ' OK: the selected radio object (2..5) gives the new shape; redraw the preview if it changed.
    IF choice&=1
      radio_find_selected(13,1,obj_found%)
      IF fade_shape&<>SUB(INT{obj_found%},2)
        fade_shape&=INT{obj_found%}-2
        volume_preview_draw(1)
      ENDIF
    ENDIF
  CASE 100
    volume_preview_draw(1)
  ENDSELECT
RETURN
' Applies the fade of dialog 12 to the block (called from the main panel with choice& = 1 when OK was chosen).
' Start and end volumes in percent come from sliders 8 and 5.  Shape 0 splits the block into one segment
' per percent step and maps each through volume table volume_tables% + level * 256.  Other shapes get a segment list
' (table, start, end) from fade_curve_build in scratch_addr%, each segment mapped by the INLINE code_byte_map%.
PROCEDURE fade_apply
  LOCAL range_pos%,seg_end%,line_pattern&,ix&,fade_start_pct&,fade_end_pct&,fade_level&,fade_steps&
  IF choice&=1 AND block_end%>block_start%
    ' Hide the mouse, busy pointer.
    pointer_hide
    pointer_busy(1)
    pointer_show
    ' Start and end volume in percent; number of linear segments = difference + 1.
    slider_value_query(12,8,slider_value&,slider_size&)
    fade_start_pct&=100-slider_value&
    slider_value_query(12,5,slider_value&,slider_size&)
    fade_end_pct&=100-slider_value&
    fade_steps&=ABS(fade_end_pct&-fade_start_pct&)+1
    fade_level&=fade_start_pct&
    ' Curved shapes: build the segment list, then map each entry (list ends with a 0 table pointer).
    IF fade_shape&
      fade_curve_build(fade_shape&,fade_start_pct&/100,fade_end_pct&/100,sample_base%+block_start%,sample_base%+block_end%,scratch_addr%)
      range_pos%=scratch_addr%
      WHILE LONG{range_pos%}>0
        ~C:code_byte_map%(L:LONG{range_pos%+4},L:LONG{range_pos%+8},L:LONG{range_pos%})
        range_pos%=range_pos%+12
      WEND
    ELSE
      ' Linear: segment ends spread evenly over the block, table level stepped by one percent per segment.
      range_pos%=sample_base%+block_start%
      FOR step_counter&=1 TO fade_steps&
        seg_end%=sample_base%+block_start%+(MUL(block_end%-block_start%,step_counter&) DIV fade_steps&)
        IF seg_end%-range_pos%>0
          ~C:code_byte_map%(L:range_pos%,L:seg_end%,L:volume_tables%+SHL&(fade_level&,8))
        ENDIF
        range_pos%=seg_end%
        IF fade_end_pct&>fade_start_pct&
          INC fade_level&
        ELSE
          DEC fade_level&
        ENDIF
      NEXT step_counter&
    ENDIF
    ' Normal pointer, redraw the waveform.
    pointer_busy(0)
    trace_draw
  ENDIF
RETURN
' Try button of the fade dialog: builds the fade as a segment list in scratch_addr% (12 bytes per entry:
' volume table, start address, end address; 0 ends the list) without changing the sample, and plays the
' block through it with sample_run_list on output output_device&.
' range_pos%, seg_end%, fade_start_pct&..step_counter& are not LOCAL here and change the caller's or global copies.
PROCEDURE fade_try
  LOCAL segment_ptr%
  IF block_end%>block_start%
    ' Busy pointer, then read the start and end volume in percent.
    pointer_hide
    pointer_busy(1)
    pointer_show
    VSYNC
    slider_value_query(12,8,slider_value&,slider_size&)
    fade_start_pct&=100-slider_value&
    slider_value_query(12,5,slider_value&,slider_size&)
    fade_end_pct&=100-slider_value&
    fade_steps&=ABS(fade_end_pct&-fade_start_pct&)+1
    fade_level&=fade_start_pct&
    ' Curved shapes: fade_curve_build writes the segment list.
    IF fade_shape&
      fade_curve_build(fade_shape&,fade_start_pct&/100,fade_end_pct&/100,sample_base%+block_start%,sample_base%+block_end%,scratch_addr%)
    ELSE
      ' Linear: one list entry per percent step, as in fade_apply.
      segment_ptr%=scratch_addr%
      range_pos%=sample_base%+block_start%
      FOR step_counter&=1 TO fade_steps&
        seg_end%=sample_base%+block_start%+(MUL(block_end%-block_start%,step_counter&) DIV fade_steps&)
        IF seg_end%-range_pos%>0
          LONG{segment_ptr%}=volume_tables%+SHL&(fade_level&,8)
          LONG{segment_ptr%+4}=range_pos%
          LONG{segment_ptr%+8}=seg_end%
          segment_ptr%=segment_ptr%+12
        ENDIF
        range_pos%=seg_end%
        IF fade_end_pct&>fade_start_pct&
          INC fade_level&
        ELSE
          DEC fade_level&
        ENDIF
      NEXT step_counter&
      LONG{segment_ptr%}=0
    ENDIF
    ' Wait until the Space key (scan code 57) is released, key click off, play the list, key click on.
    key_release_wait(57)
    keyclick_off
    sample_run_list(output_device&,scratch_addr%,0,0,0,mfp_timer_a&)
    keyclick_on
    ' Normal pointer again.
    pointer_hide
    pointer_busy(0)
    pointer_show
    ACLIP 1,0,0,639,screen_max_y&
  ENDIF
RETURN
' Event handler of the echo dialog 14, and the echo apply when called from the main panel (dialog_id& = 4).
' Objects: 3..5 decay slider (value 0..100 percent, text 13 shows 0..1), 6..8 delay slider (0..5000 ms,
' text 14 shows seconds), 9..11 repeat slider (1..40, text 15), 13/14/15 typed values, 16 Load, 17 Save.
' Echo file *.EKO: 18 bytes, "SoundLabEcho" then three words: decay percent, delay ms, repeat count.
PROCEDURE echo_dialog_event
  LOCAL work_text$,echo_value,slider_value&,slider_size&,obj_found%
  SELECT obj_num&
  CASE 3 TO 5
    ' Decay slider moved: take the cursor off the current field and show the decay in text 13.
    IF edit_object&<>13
      obj_find(14,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    slider_value_query(14,4,slider_value&,slider_size&)
    work_text$=LEFT$(STR$(slider_value&/100)+"    ",4)
    obj_find(14,13,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 6 TO 8
    ' Delay slider moved: show the delay in seconds in text 14.
    IF edit_object&<>14
      obj_find(14,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    slider_value_query(14,7,slider_value&,slider_size&)
    work_text$=LEFT$(STR$(slider_value&/1000)+"     ",5)
    obj_find(14,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),5
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 9 TO 11
    ' Repeat slider moved: show the count in text 15.
    IF edit_object&<>15
      obj_find(14,edit_object&,obj_found%)
      edit_object&=0
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    slider_value_query(14,10,slider_value&,slider_size&)
    work_text$=LEFT$(STR$(slider_value&)+"  ",2)
    obj_find(14,15,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),2
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 13
    ' Decay typed: clamp to 0..1 and set slider 4 (range 0..110, page 10).
    obj_text_query(14,13,work_text$)
    echo_value=VAL(work_text$)
    echo_value=MIN(1,MAX(0,echo_value))
    slider_setup(14,4,0,110,-10,10,ROUND(100*echo_value),10)
    obj_find(14,4,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=LEFT$(STR$(echo_value)+"     ",4)
    obj_find(14,13,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 14
    ' Delay typed: clamp to 0.001..5 seconds and set slider 7 in ms (range 0..5500, page 500).
    obj_text_query(14,14,work_text$)
    echo_value=VAL(work_text$)
    echo_value=MIN(5,MAX(.001,echo_value))
    slider_setup(14,7,0,5500,-500,500,ROUND(1000*echo_value),500)
    obj_find(14,7,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=LEFT$(STR$(echo_value)+"     ",5)
    obj_find(14,14,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),5
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 15
    ' Repeats typed: clamp to 1..40 and set slider 10 (range 1..44, page 4).
    obj_text_query(14,15,work_text$)
    echo_value=VAL(work_text$)
    echo_value=MIN(40,MAX(1,echo_value))
    slider_setup(14,10,1,44,-4,4,ROUND(echo_value),4)
    obj_find(14,10,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=LEFT$(STR$(echo_value)+"     ",2)
    obj_find(14,15,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),2
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 16
    ' Load: file selector for *.EKO; the file must exist and be exactly 18 bytes long.
    filesel_title_set("Load which echo?")
    filesel_run("*.EKO",echo_path$,echo_filename$,ok_flag!)
    IF ok_flag!
      IF @fexists(echo_path$+echo_filename$)<>0
        IF @fsize_of(echo_path$+echo_filename$)=18
          pointer_hide
          pointer_busy(1)
          pointer_show
          ' Open for reading (handle 1), read 18 bytes, close.
          IF @fopen_channel("I",1,echo_path$+echo_filename$)=0
            work_text$=SPACE$(18)
            IF @fread_channel(1,V:work_text$,18)=0
              IF @fclose_channel(1)=0
                ' REPEAT ... EXIT IF ... UNTIL TRUE skips the rest when the header is not "SoundLabEcho".
                REPEAT
                  EXIT IF LEFT$(work_text$,12)<>"SoundLabEcho"
                  echo_decay&=INT{V:work_text$+12}
                  echo_delay_ms&=INT{V:work_text$+14}
                  echo_repeats&=INT{V:work_text$+16}
                  ' Set the three sliders and refresh each text field by calling this handler again for objects 4, 7, 10.
                  slider_setup(14,4,0,110,-10,10,echo_decay&,10)
                  obj_find(14,4,obj_found%)
                  dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
                  obj_num&=4
                  echo_dialog_event
                  slider_setup(14,7,0,5500,-500,500,echo_delay_ms&,500)
                  obj_find(14,7,obj_found%)
                  dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
                  obj_num&=7
                  echo_dialog_event
                  slider_setup(14,10,1,44,-4,4,echo_repeats&,4)
                  obj_find(14,10,obj_found%)
                  dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
                  obj_num&=10
                  echo_dialog_event
                UNTIL TRUE
              ENDIF
            ENDIF
          ENDIF
          pointer_hide
          pointer_busy(0)
          pointer_show
          ACLIP 1,0,0,639,screen_max_y&
        ENDIF
      ENDIF
    ENDIF
  CASE 17
    ' Called from the main panel after the dialog closed with OK: apply the echo.
    IF dialog_id&=4
      echo_apply
    ELSE
      ' Save: file selector for *.EKO, create the file ("N" asks first if it exists, per exists_option&).
      filesel_title_set("Save echo as...?")
      filesel_run("*.EKO",echo_path$,echo_filename$,ok_flag!)
      IF ok_flag!
        pointer_hide
        pointer_busy(1)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
        IF @fopen_channel("N",1,echo_path$+echo_filename$)=0
          ' Read decay, delay and repeats from the sliders and write the 18-byte record.
          slider_value_query(14,4,echo_decay&,slider_size&)
          slider_value_query(14,7,echo_delay_ms&,slider_size&)
          slider_value_query(14,10,echo_repeats&,slider_size&)
          work_text$="SoundLabEcho"+MKI$(echo_decay&)+MKI$(echo_delay_ms&)+MKI$(echo_repeats&)
          IF @fwrite_channel(1,V:work_text$,18)=0
            IF @fclose_channel(1)=0
              ' File shorter than 18 bytes on disk: disk full alert, then delete the file with GEMDOS Fdelete (65).
              ' Bug: it deletes echo_path$+sample_filename$ (the sample's name in the echo folder), not the echo file echo_filename$.
              IF @fsize_of(echo_path$+echo_filename$)<>18
                pointer_hide
                pointer_busy(0)
                pointer_show
                choice&=@msgbox_show(25,"[3][ Diskette is full. | Please try another disk. ][  Oops, sorry, my mistake!  ]")
                remove_path$=echo_path$+sample_filename$+CHR$(0)
                pointer_hide
                pointer_busy(1)
                pointer_show
                ~GEMDOS(65,L:V:remove_path$)
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' Force the file selector to read the directory again.
        filesel_listed$=""
        pointer_hide
        pointer_busy(0)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
      ENDIF
    ENDIF
  ENDSELECT
RETURN
' Applies the echo of dialog 14 to the block.  Decay d = slider 4 / 100, delay = slider 7 ms converted to
' bytes at sample_rate& Hz, n = slider 10 repeats.  Builds n gain tables of 256 bytes in scratch_addr%, table k scaling by
' d^(k+1); the INLINE echo routines add, for every byte, the n delayed bytes through these tables, clipped to
' 0..255.  They run from the end down to the start, so the taps read bytes not yet changed.
' seg_end%, echo_spare_long% and echo_spare_word& are declared but never used.
PROCEDURE echo_apply
  LOCAL echo_value,echo_delay_bytes%,echo_count&,slider_value&,slider_size&,range_pos%,seg_end%,y_centre&,decay_level,echo_spare_word&,echo_spare_long%,ix&
  ' Decay factor, delay in bytes, repeat count.
  slider_value_query(14,4,slider_value&,slider_size&)
  echo_value=slider_value&/100
  slider_value_query(14,7,slider_value&,slider_size&)
  echo_delay_bytes%=MUL(slider_value&,sample_rate&)/1000
  slider_value_query(14,10,slider_value&,slider_size&)
  echo_count&=slider_value&
  pointer_hide
  pointer_busy(1)
  pointer_show
  ' Gain tables: table k at scratch_addr% + k * 256 holds (x - 128) * d^(k+1) + 128.
  decay_level=echo_value
  FOR ix&=0 TO SHL(echo_count&,8)+-256 STEP 256
    FOR y_centre&=0 TO 255
      BYTE{y_centre&+(scratch_addr%+ix&)}=(y_centre&-128)*decay_level+128
    NEXT y_centre&
    MUL decay_level,echo_value
  NEXT ix&
  ' Total delay span.  The part beyond it uses the fast routine (all taps inside the block); the first span
  ' uses the checked routine that stops at the block start.  Both work from end down to just above start, so
  ' the byte at start + span is left without echo.
  range_pos%=echo_delay_bytes%*echo_count&
  IF block_end%-block_start%>range_pos%
    ~C:asm_echo_fast%(L:sample_base%+block_start%+range_pos%,L:sample_base%+block_end%,L:scratch_addr%,L:echo_delay_bytes%,echo_count&-1)
    ~C:asm_echo_checked%(L:sample_base%+block_start%,L:PRED(sample_base%+block_start%+range_pos%),L:scratch_addr%,L:echo_delay_bytes%,echo_count&-1)
  ELSE
    ~C:asm_echo_checked%(L:sample_base%+block_start%,L:sample_base%+block_end%,L:scratch_addr%,L:echo_delay_bytes%,echo_count&-1)  !block shorter than the span: checked pass only
  ENDIF
  pointer_busy(0)
  trace_draw
RETURN
' Preferences.  From the main panel (dialog_id& = 4) it opens dialog 16 with its radio groups set from the
' options: 1 output device, 2 name only, 3 draw style, 4 preview data, 5 seconds, 6 grow boxes, 7 menu click,
' 8 file-exists action; object 100 shows the default rate.  Exit 1 = Save (applies and writes SOUNDLAB.PRF),
' 2 = use, 3 = cancel.  As the handler of dialog 16 it serves object 3 (Microwire dialog 35),
' 21 (rate dialog 6 for the default rate) and 25 (dialog 58: sampler port, file selector, load/save formats).
PROCEDURE prefs_dialog_event
  LOCAL obj_found%,saved_rate&,saved_timer&,saved_default_rate&,work_text$,work_text2$,ix&,obj_ofs&
  ' Keep rate, timer and default rate: the nested rate dialog changes them.
  IF dialog_id&=4
    saved_rate&=sample_rate&
    saved_timer&=mfp_timer_a&
    saved_default_rate&=default_rate&
    ' Select the radio button of each option (booleans are -1/0, so 5 - info_on! gives 5 or 6, and so on).
    radio_set(16,1,output_device&+2)
    radio_set(16,2,5-info_on!)
    radio_set(16,3,trace_style&+7)
    radio_set(16,4,11-opt_preview_sample&)
    radio_set(16,5,13+seconds_on!)
    radio_set(16,6,15+zoom_enabled!)
    radio_set(16,7,16-menu_click_opt!)
    radio_set(16,8,18+exists_option&)
    work_text$=STR$(default_rate&/1000)+"KHz      "
    obj_find(16,100,obj_found%)
    BMOVE V:work_text$,12+(rsc_data%+LONG{obj_found%+24}),9
    ' Run the preferences dialog, then restore rate and timer.
    dialog_run(16,choice&)
    sample_rate&=saved_rate&
    mfp_timer_a&=saved_timer&
    ' Save or use: read every radio group back into the options.
    IF choice&<3
      radio_find_selected(16,1,obj_found%)
      output_device&=INT{obj_found%}-2
      radio_find_selected(16,2,obj_found%)
      info_on!=INT{obj_found%}=6
      radio_find_selected(16,3,obj_found%)
      trace_style&=INT{obj_found%}-7
      radio_find_selected(16,4,obj_found%)
      opt_preview_sample&=11-INT{obj_found%}
      radio_find_selected(16,5,obj_found%)
      seconds_on!=INT{obj_found%}=12
      radio_find_selected(16,6,obj_found%)
      zoom_enabled!=INT{obj_found%}=14
      radio_find_selected(16,7,obj_found%)
      menu_click_opt!=INT{obj_found%}=17
      radio_find_selected(16,8,obj_found%)
      exists_option&=INT{obj_found%}-18
      ' No DMA sound on this machine: fall back to the YM2149.
      IF output_device&=1 AND dma_sound!=FALSE
        output_device&=0
      ENDIF
      ' Redraw the status lines with the new options.
      status_name_draw
      status_block_draw
      memory_size_draw
      trace_draw
      ' Save: build SOUNDLAB.PRF (702-byte record, then 576 bytes of dialog positions).
      IF choice&=1
        pointer_hide
        pointer_busy(1)
        pointer_show
        ' 16-byte id, 8-byte palette, 9 option words, 5 Microwire words.
        work_text$="SoundLab1.1Prefs"
        work_text$=work_text$+palette$
        work_text$=work_text$+MKI$(output_device&)+MKI$(info_on!)+MKI$(trace_style&)+MKI$(opt_preview_sample&)
        work_text$=work_text$+MKI$(seconds_on!)+MKI$(zoom_enabled!)+MKI$(menu_click_opt!)+MKI$(exists_option&)
        work_text$=work_text$+MKI$(default_rate&)
        work_text$=work_text$+MKI$(mw_master&)+MKI$(mw_left&)+MKI$(mw_right&)+MKI$(mw_bass&)+MKI$(mw_treble&)
        ' The eight 80-character path entries of dialog 2 (objects 13..20).
        FOR ix&=13 TO 20
          obj_text_query(2,ix&,work_text2$)
          work_text$=work_text$+LEFT$(work_text2$+SPACE$(80),80)
        NEXT ix&
        ' The five dialog 58 options (new in version 1.1).
        work_text$=work_text$+MKI$(opt_sampler_port&)+MKI$(fsel_type&)+MKI$(opt_load_format&)+MKI$(opt_save_format&)+MKI$(opt_signed_default!)
        ' 36 dialog records (1..35 and 58), 16 bytes each from record offset +4; y values halved in mono so the
        ' file is resolution independent.  Missing dialogs are stored as zeros.
        work_text2$=SPACE$(576)
        obj_ofs&=0
        FOR ix&=1 TO 58
          IF ix&=36
            ix&=58
          ENDIF
          tree_find(ix&,obj_found%)
          IF obj_found%<tree_end%
            BMOVE obj_found%+4,obj_ofs&+V:work_text2$,16
            IF mono!
              CARD{obj_ofs&+V:work_text2$+2}=INT{obj_ofs&+V:work_text2$+2} DIV 2
              CARD{obj_ofs&+V:work_text2$+6}=INT{obj_ofs&+V:work_text2$+6} DIV 2
              CARD{obj_ofs&+V:work_text2$+10}=INT{obj_ofs&+V:work_text2$+10} DIV 2
              CARD{obj_ofs&+V:work_text2$+14}=INT{obj_ofs&+V:work_text2$+14} DIV 2
            ENDIF
          ELSE
            LONG{obj_ofs&+V:work_text2$}=0
            LONG{obj_ofs&+V:work_text2$+4}=0
            LONG{obj_ofs&+V:work_text2$+8}=0
            LONG{obj_ofs&+V:work_text2$+12}=0
          ENDIF
          obj_ofs&=obj_ofs&+16
        NEXT ix&
        ' Overwrite an old SOUNDLAB.PRF without asking: file-exists option forced to 0 (erase) while saving.
        ix&=exists_option&
        exists_option&=0
        IF @fopen_channel("N",1,"SOUNDLAB.PRF")=0
          IF @fwrite_channel(1,V:work_text$,702)=0
            IF @fwrite_channel(1,V:work_text2$,576)=0
              ~@fclose_channel(1)
            ENDIF
          ENDIF
        ENDIF
        exists_option&=ix&
        work_text$=""
        work_text2$=""
        pointer_hide
        pointer_busy(0)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
      ENDIF
    ELSE
      default_rate&=saved_default_rate&  !cancel: restore the default rate
    ENDIF
  ELSE
    ' Handler of dialog 16 (dialog_id& = 16).
    SELECT obj_num&
    CASE 3
      microwire_dialog_event  !Microwire dialog
    CASE 21
      ' Default rate: open the rate dialog 6 with default_rate& snapped to a rate the MFP can make (614400 / n Hz).
      rate_from_prefs!=TRUE
      sample_rate&=default_rate&
      sample_rate&=614400/sample_rate&+.5
      sample_rate&=DIV(614400,sample_rate&)
      work_text$=STR$(sample_rate&/1000)
      work_text$=LEFT$(work_text$+"      ",6)
      obj_find(6,15,work_long%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
      ' OK: rate_timer_calc reads the new rate; it becomes the default and object 100 is redrawn with it.
      dialog_run(6,choice&)
      IF choice&=1
        rate_timer_calc
        default_rate&=sample_rate&
        work_text$=STR$(default_rate&/1000)+"KHz      "
        obj_find(16,100,obj_found%)
        BMOVE V:work_text$,12+(rsc_data%+LONG{obj_found%+24}),9
        ARECT 290+origin_x&,origin_y&+110,372+origin_x&,origin_y&+119,1,0,V:pattern_solid%,1
        dialog_object_draw(obj_found%,origin_x&,origin_y&,0)
        pointer_show
        ACLIP 1,0,0,639,screen_max_y&
      ENDIF
      rate_from_prefs!=FALSE
    CASE 25
      ' Dialog 58: preselect sampler port, file selector type, load format, signed option and save format.
      radio_set(58,1,opt_sampler_port&+2)
      radio_set(58,2,fsel_type&+4)
      radio_set(58,3,opt_load_format&+6)
      radio_set(58,5,15+opt_signed_default!)
      ' Save format code to radio object: 2 -> 8, 0 -> 9, 7 -> 10, 3 -> 11, 1 -> 12, 8 -> 13.
      SELECT opt_save_format&
      CASE 2
        radio_set(58,4,8)
      CASE 0
        radio_set(58,4,9)
      CASE 7
        radio_set(58,4,10)
      CASE 3
        radio_set(58,4,11)
      CASE 1
        radio_set(58,4,12)
      CASE 8
        radio_set(58,4,13)
      ENDSELECT
      dialog_run(58,choice&)
      ' OK: read the groups back, mapping the save format radio to its code again.
      IF choice&=1
        radio_find_selected(58,1,obj_found%)
        opt_sampler_port&=INT{obj_found%}-2
        radio_find_selected(58,2,obj_found%)
        fsel_type&=INT{obj_found%}-4
        radio_find_selected(58,3,obj_found%)
        opt_load_format&=INT{obj_found%}-6
        radio_find_selected(58,5,obj_found%)
        opt_signed_default!=INT{obj_found%}=14
        radio_find_selected(58,4,obj_found%)
        SELECT INT{obj_found%}
        CASE 8
          opt_save_format&=2
        CASE 9
          opt_save_format&=0
        CASE 10
          opt_save_format&=7
        CASE 11
          opt_save_format&=3
        CASE 12
          opt_save_format&=1
        CASE 13
          opt_save_format&=8
        ENDSELECT
      ENDIF
      ' Cartridge sampler read address: $FB0001, or $FB0000 for port option 1.
      cart_input%=16449537-opt_sampler_port&
    ENDSELECT
  ENDIF
RETURN
' STE Microwire (LMC1992) settings, dialog 35.  From the main panel (shift mode, dialog_id& = 4) or the
' preferences (dialog_id& = 16) it opens the dialog: sliders 4 master 0..40, 7 left 0..20, 10 right 0..20,
' 20 bass and 23 treble -6..6 (stored +6); texts 13/14/15 show -80..0 / -40..0 dB, 17/18 show +-12 dB.
' After the dialog the values (new on OK, old on cancel) go to the INLINE asm_microwire% and are sent with
' XBIOS Supexec (38) on a DMA-sound machine.  As the dialog's handler it keeps sliders and texts in step.
PROCEDURE microwire_dialog_event
  LOCAL work_text$,obj_found%
  IF dialog_id&=4 OR dialog_id&=16
    ' Set the sliders from the current settings.
    slider_set_pos(35,4,mw_master&,4)
    slider_set_pos(35,7,mw_left&,2)
    slider_set_pos(35,10,mw_right&,2)
    slider_set_pos(35,20,mw_bass&-6,1)
    slider_set_pos(35,23,mw_treble&-6,1)
    ' Write the dB values into the text fields (2 dB per step).
    obj_find(35,13,obj_found%)
    work_text$=LEFT$(STR$(mw_master&*2-80)+"     ",4)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    obj_find(35,14,obj_found%)
    work_text$=LEFT$(STR$(mw_left&*2-40)+"     ",4)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    obj_find(35,15,obj_found%)
    work_text$=LEFT$(STR$(mw_right&*2-40)+"     ",4)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
    obj_find(35,17,obj_found%)
    work_text$=LEFT$(STR$((mw_bass&-6)*2)+"     ",3)
    IF mw_bass&>6
      work_text$="+"+work_text$
    ENDIF
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),3
    obj_find(35,18,obj_found%)
    work_text$=LEFT$(STR$((mw_treble&-6)*2)+"   ",3)
    IF mw_treble&>6
      work_text$="+"+work_text$
    ENDIF
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),3
    ' Edit cursor offsets -1/0 for this dialog, restored afterwards.
    saved_inset_top&=cursor_top&
    saved_inset_bottom&=cursor_bottom&
    cursor_top&=-1
    cursor_bottom&=0
    dialog_run(35,choice&)
    ' OK: read the sliders back into the settings.
    IF choice&=1
      slider_value_query(35,4,mw_master&,slider_size&)
      slider_value_query(35,7,mw_left&,slider_size&)
      slider_value_query(35,10,mw_right&,slider_size&)
      slider_value_query(35,20,mw_bass&,slider_size&)
      slider_value_query(35,23,mw_treble&,slider_size&)
      ADD mw_bass&,6
      ADD mw_treble&,6
    ENDIF
    ' Microwire data bytes of the INLINE: +4 master, +5 left, +6 right, +7 bass, +8 treble.
    BYTE{asm_microwire%+4}=mw_master&
    BYTE{asm_microwire%+5}=mw_left&
    BYTE{asm_microwire%+6}=mw_right&
    BYTE{asm_microwire%+7}=mw_bass&
    BYTE{asm_microwire%+8}=mw_treble&
    ' Supexec the routine: each value is ORed into its LMC1992 command and written to $FF8922 (data) with
    ' mask $07FF in $FF8924, waiting until the data register reads its old value again (word shifted out).
    IF dma_sound!
      ~XBIOS(38,L:asm_microwire%)
    ENDIF
    cursor_top&=saved_inset_top&
    cursor_bottom&=saved_inset_bottom&
  ELSE
    ' Handler of dialog 35.
    SELECT obj_num&
    CASE 16
      microwire_try  !Test button
    CASE 3 TO 5
      ' Master slider moved: show the dB value in text 13.
      IF edit_object&<>13
        obj_find(35,edit_object&,obj_found%)
        edit_object&=0
        dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      ENDIF
      slider_value_query(35,4,slider_value&,slider_size&)
      work_text$=LEFT$(STR$(slider_value&*2-80)+"    ",4)
      obj_find(35,13,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 6 TO 8
      ' Left slider moved: text 14.
      IF edit_object&<>14
        obj_find(35,edit_object&,obj_found%)
        edit_object&=0
        dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      ENDIF
      slider_value_query(35,7,slider_value&,slider_size&)
      work_text$=LEFT$(STR$(slider_value&*2-40)+"    ",4)
      obj_find(35,14,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 9 TO 11
      ' Right slider moved: text 15.
      IF edit_object&<>15
        obj_find(35,edit_object&,obj_found%)
        edit_object&=0
        dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      ENDIF
      slider_value_query(35,10,slider_value&,slider_size&)
      work_text$=LEFT$(STR$(slider_value&*2-40)+"    ",4)
      obj_find(35,15,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 19 TO 21
      ' Bass slider moved: text 17 with a + sign above 0 dB.
      IF edit_object&<>17
        obj_find(35,edit_object&,obj_found%)
        edit_object&=0
        dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      ENDIF
      slider_value_query(35,20,slider_value&,slider_size&)
      work_text$=LEFT$(STR$(slider_value&*2)+"    ",4)
      IF slider_value&>0
        work_text$="+"+work_text$
      ENDIF
      obj_find(35,17,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 22 TO 24
      ' Treble slider moved: text 18.
      IF edit_object&<>18
        obj_find(35,edit_object&,obj_found%)
        edit_object&=0
        dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      ENDIF
      slider_value_query(35,23,slider_value&,slider_size&)
      work_text$=LEFT$(STR$(slider_value&*2)+"    ",4)
      IF slider_value&>0
        work_text$="+"+work_text$
      ENDIF
      obj_find(35,18,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 13
      ' Master dB typed: half the value, forced negative, clamped to -40..0, slider = 40 + value.
      obj_text_query(35,13,work_text$)
      slider_value&=VAL(work_text$)/2
      IF slider_value&>0
        slider_value&=-slider_value&
      ENDIF
      slider_value&=MIN(0,MAX(-40,slider_value&))
      slider_set_pos(35,4,40+slider_value&,4)
      obj_find(35,4,obj_found%)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      work_text$=LEFT$(STR$(slider_value&*2)+"     ",4)
      obj_find(35,13,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 14
      ' Left dB typed: clamped to -20..0 steps, slider = 20 + value.
      obj_text_query(35,14,work_text$)
      slider_value&=VAL(work_text$)/2
      IF slider_value&>0
        slider_value&=-slider_value&
      ENDIF
      slider_value&=MIN(0,MAX(-20,slider_value&))
      slider_set_pos(35,7,20+slider_value&,2)
      obj_find(35,7,obj_found%)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      work_text$=LEFT$(STR$(slider_value&*2)+"     ",4)
      obj_find(35,14,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 15
      ' Right dB typed.
      obj_text_query(35,15,work_text$)
      slider_value&=VAL(work_text$)/2
      IF slider_value&>0
        slider_value&=-slider_value&
      ENDIF
      slider_value&=MIN(0,MAX(-20,slider_value&))
      slider_set_pos(35,10,20+slider_value&,2)
      obj_find(35,10,obj_found%)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      work_text$=LEFT$(STR$(slider_value&*2)+"     ",4)
      obj_find(35,15,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),4
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 17
      ' Bass dB typed: half the value, clamped to -12..12 although the slider and the chip only take -6..6.
      obj_text_query(35,17,work_text$)
      slider_value&=VAL(work_text$)/2
      slider_value&=MIN(12,MAX(-12,slider_value&))
      slider_set_pos(35,20,slider_value&,1)
      obj_find(35,20,obj_found%)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      work_text$=LEFT$(STR$(slider_value&*2)+"     ",4)
      IF slider_value&>0
        work_text$="+"+work_text$
      ENDIF
      obj_find(35,17,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),3
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    CASE 18
      ' Treble dB typed.
      obj_text_query(35,18,work_text$)
      slider_value&=VAL(work_text$)/2
      slider_value&=MIN(12,MAX(-12,slider_value&))
      slider_set_pos(35,23,slider_value&,1)
      obj_find(35,23,obj_found%)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      work_text$=LEFT$(STR$(slider_value&*2)+"     ",4)
      IF slider_value&>0
        work_text$="+"+work_text$
      ENDIF
      obj_find(35,18,obj_found%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),3
      edit_object&=-1
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
      pointer_show
    ENDSELECT
  ENDIF
RETURN
' Test button of the Microwire dialog: reads the five sliders into LOCAL copies of the settings, sends them
' to the LMC1992 (XBIOS Supexec of asm_microwire%) and plays the block through DMA sound, or the YM2149 on an ST.
' The globals stay unchanged; microwire_dialog_event sends the kept or new values when the dialog closes.
PROCEDURE microwire_try
  LOCAL mw_master&,mw_left&,mw_right&,mw_bass&,mw_treble&,shift_mode!,output_device&
  slider_value_query(35,4,mw_master&,slider_size&)
  slider_value_query(35,7,mw_left&,slider_size&)
  slider_value_query(35,10,mw_right&,slider_size&)
  slider_value_query(35,20,mw_bass&,slider_size&)
  slider_value_query(35,23,mw_treble&,slider_size&)
  ' Bass and treble sliders run -6..6; the chip wants 0..12.
  ADD mw_bass&,6
  ADD mw_treble&,6
  BYTE{asm_microwire%+4}=mw_master&
  BYTE{asm_microwire%+5}=mw_left&
  BYTE{asm_microwire%+6}=mw_right&
  BYTE{asm_microwire%+7}=mw_bass&
  BYTE{asm_microwire%+8}=mw_treble&
  ' Supexec the Microwire routine and play through DMA sound (local output_device& = 1).
  IF dma_sound!
    ~XBIOS(38,L:asm_microwire%)
    output_device&=1
  ELSE
    output_device&=0
  ENDIF
  ' Play the block, not the buffer.
  shift_mode!=FALSE
  sample_play
RETURN
' Clear button of the main panel (also key G).  In shift mode it inserts a gap of silence (128) the size of
' the block at the block start, moving the rest of the sample up; when memory is short alert 48 offers
' Lose Sample (the end falls off), Lose Buffer (the sample grows into the buffer), Insert to Fit (a smaller
' gap) or Cancel.  Otherwise alert 31 clears the block, the buffer or everything to silence (no undo).
' Loop points are moved with sample_loop_shift.
PROCEDURE block_clear_gap
  LOCAL chunk_len%,tail_len%,view_end_pos%
  ' Gap length = block length.  view_end_pos% = sample offset at the end of the zoom slider range.
  IF shift_mode!
    chunk_len%=block_end%-block_start%
    slider_value_query(4,26,slider_value&,slider_size&)
    view_end_pos%=slider_value&*320+slider_size&*319.5
    ' Block start equal to view_end_pos%: no gap, the sample is extended up to the buffer instead.
    IF view_end_pos%=block_start%
      sample_end%=buffer_start%
      chunk_len%=0
      sample_length_update
    ENDIF
    IF chunk_len%>0
      ' Not enough free memory between the sample end and the buffer.
      IF buffer_start%-sample_end%<chunk_len%
        choice&=@msgbox_show(48,"[1][ Not enough memory | for the Gap. ][ Lose Sample | Lose Buffer | Insert to Fit | Cancel ][^M|b|i|a]")
        IF choice&<4
          pointer_hide
          pointer_busy(1)
          pointer_show
          ' Lose Sample: shift up within the sample memory, the end beyond buffer_start% is lost.
          IF choice&=1
            IF block_end%<buffer_start%
              BMOVE sample_base%+block_start%,sample_base%+block_end%,buffer_start%-block_end%
            ENDIF
            pointer_show
            ~C:code_fill%(L:sample_base%+block_start%,L:chunk_len%,128)  !fill the gap with silence
            sample_end%=buffer_start%
            sample_loop_shift(block_start%,chunk_len%)
          ELSE
            ' Lose Buffer: move the rest up into the buffer area (limited to memory_top%), the buffer starts at the new end.
            IF choice&=2
              tail_len%=sample_end%-block_start%
              IF block_end%+tail_len%>memory_top%
                tail_len%=memory_top%-block_end%
              ENDIF
              IF tail_len%>0
                BMOVE sample_base%+block_start%,sample_base%+block_end%,tail_len%
              ENDIF
              pointer_show
              ~C:code_fill%(L:sample_base%+block_start%,L:chunk_len%,128)
              sample_end%=sample_end%+chunk_len%
              IF sample_end%>memory_top%
                sample_end%=memory_top%
              ENDIF
              buffer_start%=sample_end%
              sample_loop_shift(block_start%,chunk_len%)
            ELSE
              ' Insert to Fit: shrink the gap to the free memory, the block becomes the gap.
              IF choice&=3
                chunk_len%=buffer_start%-sample_end%
                block_end%=block_start%+chunk_len%
                IF chunk_len%>0
                  BMOVE sample_base%+block_start%,sample_base%+block_end%,sample_end%-block_start%
                  pointer_show
                  ~C:code_fill%(L:sample_base%+block_start%,L:chunk_len%,128)
                  sample_end%=buffer_start%
                  sample_loop_shift(block_start%,chunk_len%)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          pointer_busy(0)
          sample_length_update
        ENDIF
      ELSE
        ' Enough memory: move the rest up, fill the gap, lengthen the sample.
        pointer_hide
        pointer_busy(1)
        pointer_show
        BMOVE sample_base%+block_start%,sample_base%+block_end%,sample_end%-block_start%
        pointer_show
        ~C:code_fill%(L:sample_base%+block_start%,L:chunk_len%,128)
        sample_end%=sample_end%+chunk_len%
        sample_loop_shift(block_start%,chunk_len%)
        pointer_busy(0)
        sample_length_update
      ENDIF
    ENDIF
  ELSE
    choice&=@msgbox_show(31,"[1][ Clear what?  (No UNDO!) ][ Block | Buffer | Everything | Cancel ][^M|b|e|a]")
    ' Block: when the block is the whole sample, the sample is cleared and renamed UNTITLED.AVR with its
    ' length reset to all memory below the buffer; otherwise only the block is filled with silence.
    IF choice&=1
      IF block_start%=0 AND block_end%=sample_end%
        pointer_hide
        pointer_busy(1)
        pointer_show
        ~C:code_fill%(L:sample_base%,L:sample_end%,128)
        pointer_busy(0)
        sample_filename$="Untitled"
        status_name_draw
        sample_filename$="UNTITLED.AVR"
        sample_end%=buffer_start%
        block_end%=sample_end%
        sample_loop_on!=FALSE
        sample_loop_start%=0
        sample_loop_end%=sample_end%
        sample_length_update
      ELSE
        IF block_end%>block_start%
          pointer_hide
          pointer_busy(1)
          pointer_show
          ~C:code_fill%(L:sample_base%+block_start%,L:block_end%-block_start%,128)
          pointer_busy(0)
          trace_draw
        ENDIF
      ENDIF
    ELSE
      ' Buffer: fill buffer_start%..memory_top% with silence and mark the buffer empty (buffer_start% = memory_top%).
      IF choice&=2
        IF buffer_start%<memory_top%
          pointer_hide
          pointer_busy(1)
          pointer_show
          ~C:code_fill%(L:sample_base%+buffer_start%,L:memory_top%-buffer_start%,128)
          pointer_busy(0)
          buffer_start%=memory_top%
          memory_size_draw
          trace_draw
        ENDIF
      ELSE
        ' Everything: silence all memory, empty buffer, untitled sample of full length, loop off.
        IF choice&=3
          pointer_hide
          pointer_busy(1)
          pointer_show
          ~C:code_fill%(L:sample_base%,L:memory_top%,128)
          sample_filename$="Untitled"
          status_name_draw
          sample_filename$="UNTITLED.AVR"
          pointer_busy(0)
          buffer_start%=memory_top%
          sample_end%=memory_top%
          block_end%=memory_top%
          block_start%=0
          sample_loop_start%=0
          sample_loop_end%=sample_end%
          sample_loop_on!=FALSE
          sample_length_update
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Removes the block from the sample after alert 26 (no recovery): the data after the block moves down,
' the freed end is filled with silence, the sample shortens and the block becomes empty at its old start.
' Loop points inside the block move to the block start.  An emptied sample is reset to full length.
PROCEDURE block_remove
  LOCAL range_pos%,work_text$
  choice&=@msgbox_show(26,"[1][ Remove this block? | (No recovery!) ][    Yes    | No ]")
  IF choice&=1
    IF block_end%>block_start%
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' Loop start or end inside the block: move it to the block start.
      IF sample_loop_start%>block_start% AND sample_loop_start%<block_end%
        sample_loop_start%=block_start%
      ENDIF
      IF sample_loop_end%>block_start% AND sample_loop_end%<block_end%
        sample_loop_end%=block_start%
      ENDIF
      ' Close the hole, then silence the bytes freed at the end.
      IF block_end%<sample_end%
        BMOVE sample_base%+block_end%,sample_base%+block_start%,sample_end%-block_end%
      ENDIF
      pointer_show
      ~C:code_fill%(L:block_start%+(sample_base%+sample_end%-block_end%),L:block_end%-block_start%,128)
      ' Shorten the sample by the block length and shift the loop points after it.
      range_pos%=block_end%-block_start%
      block_end%=block_start%
      SUB sample_end%,range_pos%
      sample_loop_shift(block_start%,-range_pos%)
      IF sample_end%=0
        sample_end%=buffer_start%
        block_end%=buffer_start%
        sample_loop_end%=buffer_start%
      ENDIF
      sample_length_update
    ENDIF
  ENDIF
RETURN
' Trim (shift + Remove, key T) after alert 49: only the block is kept.  It moves to the sample start, the
' rest of the old sample is filled with silence and the sample length becomes the block length rounded up
' to 320 bytes.  Loop points move down by the old block start.
' Bug: the loop end uses MAX instead of MIN, so it is never pulled back inside the shorter sample.
PROCEDURE block_trim
  LOCAL range_pos%
  choice&=@msgbox_show(49,"[1][ Trim this block? | (No recovery!) ][    Yes    | No]")
  IF choice&=1
    IF block_end%>block_start%
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' Move the block to the start, silence what is left of the old sample.
      BMOVE sample_base%+block_start%,sample_base%,block_end%-block_start%
      IF sample_end%-block_end%+block_start%>0
        ~C:code_fill%(L:sample_base%+block_end%-block_start%,L:sample_end%-block_end%+block_start%,128)
      ENDIF
      ' The block is now 0..length; the sample is the block, rounded up to a multiple of 320.
      SUB block_end%,block_start%
      range_pos%=block_start%
      block_start%=0
      sample_end%=block_end%
      sample_end%=((sample_end%+319) DIV 320)*320
      ' Shift the loop points down; loop off if they cross.
      SUB sample_loop_start%,range_pos%
      SUB sample_loop_end%,range_pos%
      sample_loop_start%=MAX(0,sample_loop_start%)
      sample_loop_end%=MAX(sample_loop_end%,sample_end%)
      IF sample_loop_end%<sample_loop_start%
        sample_loop_end%=sample_loop_start%
        sample_loop_on!=FALSE
      ENDIF
      sample_length_update
    ENDIF
  ENDIF
RETURN
' Loop button of the main window.  Asks what to do with the loop:
'   Set Loop    - the loop becomes the marked block and looping is switched on
'   Reset Block - the marked block becomes the loop (un-hides a hidden block first)
'   Loop On/Off - toggles looping
' Redraws the waveform, the block bar and the block size afterwards.
PROCEDURE sample_loop_menu
  choice&=@msgbox_show(33,"[1][ Do what with looping? ][ Set Loop | Reset Block | Loop On/Off | Cancel ][^M|r|l|a]")  !keys: Return = Set Loop, r = Reset Block, l = Loop On/Off, a = Cancel
  $S<
  SELECT choice&
  CASE 1
    ' Set Loop: loop start/end = block start/end.
    sample_loop_on!=TRUE
    sample_loop_start%=block_start%
    sample_loop_end%=block_end%
    trace_draw
    overview_bar_draw
    status_block_draw
  CASE 2
    ' Reset Block: leave Hide Blk mode (deselect button 7 of tree 4) before moving the block.
    IF all_selected!
      all_selected!=FALSE
      all_button_up
      obj_find(4,7,work_ptr%)
      obj_draw_normal(work_ptr%+8,origin_x&,origin_y&,4,0)
    ENDIF
    sample_loop_on!=TRUE
    block_start%=MAX(0,sample_loop_start%)  !block = loop, clipped to the sample
    block_end%=MIN(sample_loop_end%,sample_end%)
    trace_draw
    overview_bar_draw
    status_block_draw
  CASE 3
    sample_loop_on!=NOT sample_loop_on!  !Loop On/Off
    trace_draw
    overview_bar_draw
    status_block_draw
  ENDSELECT
RETURN
' Keeps the loop points in step with an edit.  start_pos% is the offset where the edit happened,
' count% the length change: positive when data was inserted, negative when it was removed.
' Points after the edit move by count%; points inside a removed range move to start_pos%.
' The loop is clipped to the sample and switched off when it becomes empty.
PROCEDURE sample_loop_shift(start_pos%,count%)
  ' Insert: shift the loop points that lie after the insert position.
  IF count%>0
    IF sample_loop_start%>start_pos%
      sample_loop_start%=sample_loop_start%+count%
    ENDIF
    IF sample_loop_end%>start_pos%
      sample_loop_end%=sample_loop_end%+count%
    ENDIF
  ELSE
    ' Remove: a point inside the removed range goes to its start, a point after it moves back.
    IF sample_loop_start%>start_pos% AND sample_loop_start%<start_pos%-count%
      sample_loop_start%=start_pos%
    ELSE
      IF sample_loop_start%>start_pos%
        sample_loop_start%=sample_loop_start%+count%
      ENDIF
    ENDIF
    IF sample_loop_end%>start_pos% AND sample_loop_end%<start_pos%-count%
      sample_loop_end%=start_pos%
    ELSE
      IF sample_loop_end%>start_pos%
        sample_loop_end%=sample_loop_end%+count%
      ENDIF
    ENDIF
  ENDIF
  sample_loop_start%=MAX(0,sample_loop_start%)
  sample_loop_end%=MIN(sample_loop_end%,sample_end%)
  IF sample_loop_end%<sample_loop_start%  !empty loop: switch looping off
    sample_loop_end%=sample_loop_start%
    sample_loop_on!=FALSE
  ENDIF
RETURN
' Load.  Loads a sample file as the whole sample, into the marked block (block_load!) or into the
' buffer at the top of sample memory (buffer_load!, buffer mode shift_mode!).  Uses the command line file
' command_file$ once instead of the file selector.  Files longer than the space go through dialog 15,
' which picks the start offset of the part to load.  Detects the format (format_detect/12ec4),
' converts signed data, offers stereo to mono, and handles the sample rate of the file:
' block loads are rate-converted to the current rate, whole loads above 30KHz offer a conversion.
' Restores sample_filename$ unless the whole sample was replaced.
PROCEDURE sample_loader
  LOCAL block_load!,work_ptr%,buffer_load!,saved_filename$,length_bytes%,work_long%,obj_found%,signed_samples!,header_stereo!,header_rate%,work_text$
  saved_filename$=sample_filename$
  rate_before&=sample_rate&  !remember the rate before the load
  ' Buffer mode: always a buffer load.
  IF shift_mode!
    filesel_title_set("Load which sample into buffer?")
    block_load!=FALSE
    buffer_load!=TRUE
    choice&=0
  ELSE
    ' No block marked (block = whole sample): plain load, else ask File or Block.
    IF block_start%=0 AND block_end%=sample_end%
      filesel_title_set("Load which sample?")
      block_load!=FALSE
      buffer_load!=FALSE
      choice&=0
    ELSE
      choice&=@msgbox_show(37,"[1][ Load entire file, or just | the marked block? ][ File | Block |   Cancel   ][^M|b|a]")  !keys: Return = File, b = Block, a = Cancel
      IF choice&=2
        filesel_title_set("Load which sample as a block?")
        block_load!=TRUE
        buffer_load!=FALSE
      ELSE
        IF choice&=1
          ' Whole-file load with a block marked: press Hide Blk (button 7 of tree 4) first.
          IF all_selected!=FALSE
            obj_find(4,7,work_ptr%)
            obj_draw_selected(work_ptr%+8,origin_x&,origin_y&,4,0)
            action_dispatch(4,7,0,0)
          ENDIF
          filesel_title_set("Load which sample?")
          block_load!=FALSE
          buffer_load!=FALSE
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' A file name from the command line is split into folder and name and used only once.
  IF command_file$<>""
    selector_folder$=LEFT$(command_file$,RINSTR(command_file$,"\"))
    sample_filename$=MID$(command_file$,LEN(selector_folder$)+1)
    command_file$=""
    ok_flag!=TRUE
  ELSE
    IF choice&<3
      filesel_run("*.AVR|*.SPL|*.SAM|*.SMP|*.SND|*.WAV|*.#|*.#K",selector_folder$,sample_filename$,ok_flag!)  !file selector; *.# and *.#K are raw files named by their rate
    ELSE
      ok_flag!=FALSE
    ENDIF
  ENDIF
  IF ok_flag!
    IF @fexists(selector_folder$+sample_filename$)<>0
      pointer_hide
      pointer_busy(1)
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
      ' REPEAT ... UNTIL TRUE runs once; each EXIT IF skips the rest of the load.
      REPEAT
        EXIT IF @fopen_channel("I",1,selector_folder$+sample_filename$)<>0  !open the file for reading as handle 1
        ' Remember which file was loaded; a new file starts its partial-load offset at 0.
        IF buffer_load!=FALSE AND block_load!=FALSE
          IF (selector_folder$+sample_filename$)<>sample_path$
            sample_path$=selector_folder$+sample_filename$
            sample_file_offset%=0
            partial_loaded!=FALSE
          ENDIF
        ELSE
          IF (selector_folder$+sample_filename$)<>block_path$
            block_path$=selector_folder$+sample_filename$
            buffer_file_offset%=0
          ENDIF
        ENDIF
        length_bytes%=@fsize_of(selector_folder$+sample_filename$)  !file size
        IF length_bytes%>=128
          EXIT IF @fread_channel(1,scratch_addr%,128)<>0  !read the first 128 bytes for the header check
        ENDIF
        format_detect  !detect the format, seek to the data, length_bytes% = data length
        ' Buffer load: room between the sample end and the memory end, keeping 10K for the sample.
        ' A longer file may overwrite the end of the sample (the buffer grows down over it).
        IF buffer_load!
          work_ptr%=MIN(memory_top%-sample_end%,memory_top%-10240)
          IF length_bytes%>work_ptr%
            pointer_busy(0)
            choice&=@msgbox_show(32,"[1][ Overwrite last part | of sample? ][    Yes    | No ]")
            pointer_hide
            pointer_busy(1)
            pointer_show
            IF choice&=1
              work_ptr%=MIN(length_bytes%,memory_top%-10240)
            ELSE
              EXIT IF work_ptr%<1024  !No: give up when less than 1K of room is left
            ENDIF
          ENDIF
        ELSE
          ' Block load: room = block length.  Whole load: room = everything below the buffer.
          IF block_load!
            work_ptr%=block_end%-block_start%
          ELSE
            work_ptr%=buffer_start%
            saved_filename$=sample_filename$
          ENDIF
        ENDIF
        ' The file does not fit: dialog 15 asks for the start offset of the part to load.  The offset
        ' starts at the last offset used for this file; the slider shows the file and window size in K.
        IF length_bytes%>work_ptr%
          work_long%=0
          IF sample_path$=(selector_folder$+sample_filename$)
            work_long%=sample_file_offset%+block_start%
          ELSE
            IF block_path$=(selector_folder$+sample_filename$)
              work_long%=buffer_file_offset%
            ENDIF
          ENDIF
          slider_setup(15,4,0,length_bytes% DIV 1024,-work_ptr% DIV 1024,work_ptr% DIV 1024,work_long% DIV 1024,work_ptr% DIV 1024)  !slider object 4: total = file size, window = room, position = offset
          obj_find(15,6,obj_found%)
          work_text$=LEFT$(STR$(work_long%)+"       ",7)
          BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),7  !offset text into edit field 6
          pointer_hide
          pointer_busy(0)
          pointer_show
          partial_length%=work_ptr%  !window length for the slider handler partial_dialog_events
          dialog_run(15,choice&)
          pointer_hide
          pointer_busy(1)
          pointer_show
          ACLIP 1,0,0,639,screen_max_y&
          ' OK: clamp the offset, skip that far into the data (Fseek relative) and remember it.
          IF choice&=1
            obj_text_query(15,6,work_text$)
            work_long%=VAL(work_text$)
            work_long%=MIN(MAX(0,work_long%),length_bytes%-work_ptr%)
            length_bytes%=work_ptr%
            IF @fseek_rel(1,work_long%)<>0
              length_bytes%=0
            ELSE
              IF block_load! OR buffer_load!
                buffer_file_offset%=work_long%
              ELSE
                sample_file_offset%=work_long%
                partial_loaded!=TRUE  !the sample is a part of a longer file (allows a partial save)
              ENDIF
            ENDIF
          ELSE
            length_bytes%=0  !Cancel
          ENDIF
        ELSE
          IF block_load!=FALSE AND buffer_load!=FALSE
            partial_loaded!=FALSE
          ENDIF
        ENDIF
        ' Bug: on this exit (and the ones before the file is read) header_rate% is still 0, so the rate code
        ' after UNTIL takes 0 as the file rate: a whole load sets the rate to 4.9152KHz, a block load
        ' calls the resampler with a source rate of 0.
        EXIT IF length_bytes%=0
        ' Whole load shorter than the old sample: fill the rest with silence (128).
        IF length_bytes%<sample_end% AND block_load!=FALSE AND buffer_load!=FALSE
          ~C:code_fill%(L:sample_base%+length_bytes%,L:sample_end%-length_bytes%,128)
        ENDIF
        ' Buffer load smaller than the old buffer: silence the part of the old buffer below the new one.
        IF memory_top%-buffer_start%>length_bytes% AND buffer_load!
          ~C:code_fill%(L:sample_base%+buffer_start%,L:memory_top%-length_bytes%-buffer_start%,128)
        ENDIF
        ' Destination: buffer = top of memory (new buffer start), block = block start, whole = offset 0.
        IF buffer_load!
          work_ptr%=sample_base%+memory_top%-length_bytes%
          buffer_start%=memory_top%-length_bytes%
        ELSE
          IF block_load!
            work_ptr%=sample_base%+block_start%
          ELSE
            work_ptr%=sample_base%
            sample_loop_on!=FALSE
            sample_loop_start%=0
            sample_loop_end%=length_bytes%
          ENDIF
        ENDIF
        EXIT IF @fread_channel(1,work_ptr%,length_bytes%)<>0  !Fread the sample data
        ~@fclose_channel(1)  !Fclose
        format_parameters  !format -> signed signed_samples!, stereo header_stereo!, file rate header_rate%
        IF signed_samples!
          ~C:code_sign_flip%(L:work_ptr%,L:work_ptr%+length_bytes%)  !signed data: flip bit 7 of every byte to the unsigned form used in memory
        ENDIF
        IF header_stereo!
          pointer_busy(0)
          choice&=@msgbox_show(50,"[1][ This is a stereo | sample.  Convert | it to mono? ][    Yes    | No ]")
          pointer_hide
          pointer_busy(1)
          pointer_show
          IF choice&=1
            ~C:code_halve%(L:work_ptr%,L:work_ptr%+length_bytes%)  !average the left/right pairs into the first half, silence the second half
            ~C:code_fill%(L:work_ptr%+DIV(length_bytes%,2),L:length_bytes% DIV 2,128)
            length_bytes%=length_bytes% DIV 2
            ' The buffer must stay at the top of memory: move the mono data up by its length.
            IF buffer_load!
              BMOVE work_ptr%,work_ptr%+length_bytes%,length_bytes%
              pointer_show
              work_ptr%=work_ptr%+length_bytes%
              buffer_start%=buffer_start%+length_bytes%
            ENDIF
          ENDIF
        ENDIF
        ' Buffer: keeps the current rate.  If the buffer now overlaps the sample, cut the sample down
        ' to the buffer start, in steps of 320 bytes.
        IF buffer_load!
          header_rate%=sample_rate&
          memory_size_draw
          IF sample_end%>buffer_start%
            sample_end%=buffer_start%
            sample_end%=(sample_end% DIV 320)*320
            block_end%=MIN(block_end%,sample_end%)
            sample_length_update
          ENDIF
          EXIT IF TRUE
        ENDIF
        ' Block: the block now ends after the loaded data.
        IF block_load!
          block_end%=block_start%+length_bytes%
          overview_bar_draw
          trace_draw
          EXIT IF TRUE
        ENDIF
        ' Whole sample: length at least 640, rounded up to 320, block = whole sample, new title.
        ACLIP 1,0,0,639,screen_max_y&
        length_bytes%=MAX(640,length_bytes%)
        length_bytes%=((length_bytes%+319) DIV 320)*320
        block_start%=0
        block_end%=length_bytes%
        sample_end%=length_bytes%
        status_name_draw
        sample_length_update
      UNTIL TRUE
      pointer_hide
      pointer_busy(0)
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
      ' The file rate differs from the rate before the load.
      IF header_rate%<>rate_before&
        ' Block load: resample the block from the file rate to the current rate (block_rate_convert).
        IF block_load!
          sample_rate&=header_rate%
          block_rate_convert(0)
          sample_rate&=rate_before&
        ELSE
          ' Whole load above 30.72KHz: offer to resample to 30KHz or half the rate (keys Return, h, a).
          IF header_rate%>30720
            choice&=@msgbox_show(57,"[1][ This sample is too | fast - "+STR$(header_rate%/1000)+"KHz. | Convert it to... ][  30KHz  | Half | Cancel ][^M|h|a]")
            IF choice&<3
              IF choice&=1
                sample_rate&=30720
              ELSE
                IF choice&=2
                  sample_rate&=header_rate% DIV 2
                ENDIF
              ENDIF
              work_text$=STR$(sample_rate&/1000)  !target rate into the rate field (tree 6 object 15), then resample from the file rate
              work_text$=LEFT$(work_text$+"      ",6)
              obj_find(6,15,work_long%)
              BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
              pointer_show
              sample_rate&=header_rate%
              block_rate_convert(1)
              obj_text_query(6,15,work_text$)
              header_rate%=VAL(work_text$)*1000
            ENDIF
          ENDIF
        ENDIF
        ' Clamp to 4.9152-30.72KHz and snap to the nearest rate 614400/n, show it and set it.
        header_rate%=MIN(30720,MAX(4915,header_rate%))
        sample_rate&=header_rate%
        sample_rate&=614400/sample_rate&+.5
        sample_rate&=DIV(614400,sample_rate&)
        work_text$=STR$(sample_rate&/1000)
        work_text$=LEFT$(work_text$+"      ",6)
        obj_find(6,15,work_long%)
        BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
        choice&=1
        rate_timer_calc
        status_zoom_draw
        pointer_show
      ENDIF
    ENDIF
  ENDIF
  sample_filename$=saved_filename$
RETURN
' Event handler of dialog 15 (partial load), called by the dialog loop with obj_num& = object.
' Objects 3-5 (slider): the slider position (in K) is written to the start offset field 6.
' Object 6 (offset field): the typed offset is clamped and the slider is moved to it.
' Uses length_bytes% (file length), partial_length% (window length) and work_text$ of sample_loader.
PROCEDURE partial_dialog_events
  LOCAL slider_value&,slider_size&,obj_found%,src_pos%
  $S>
  SELECT obj_num&
  CASE 3 TO 5
    slider_value_query(15,4,slider_value&,slider_size&)  !slider position and size of object 4
    work_text$=LEFT$(STR$(slider_value&*1024)+"       ",7)
    obj_find(15,6,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),7
    edit_object&=-1  !no edit field active while the field is redrawn
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  CASE 6
    obj_text_query(15,6,work_text$)
    src_pos%=VAL(work_text$)
    src_pos%=MIN(MAX(0,src_pos%),length_bytes%-partial_length%)  !the window must stay inside the file
    slider_setup(15,4,0,length_bytes% DIV 1024,-partial_length% DIV 1024,partial_length% DIV 1024,src_pos% DIV 1024,partial_length% DIV 1024)
    obj_find(15,4,obj_found%)
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    work_text$=LEFT$(STR$(src_pos%)+"       ",7)
    obj_find(15,6,obj_found%)
    BMOVE V:work_text$,16+(rsc_data%+LONG{obj_found%+24}),7
    edit_object&=-1
    dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    pointer_show
  ENDSELECT
RETURN
' Save.  Saves the whole sample, the marked block (block_load!) or the buffer (buffer_load!) in the format
' given by the extension (.SPL .SAM .AVR .WAV .SMP) or the preferred format opt_save_format&; formats 7 and
' 8 put the rate into the extension (.125 = 12.5KHz, .12K).  A sample loaded as part of a file
' can be written back into that file at its offset (partial_save!).  Signed formats are converted
' before writing and back afterwards.  A short write means a full disk: the file is deleted.
PROCEDURE sample_saver
  LOCAL block_load!,length_bytes%,saved_filename$,buffer_load!,work_ptr%,partial_save!
  partial_save!=FALSE
  ' Buffer mode: always save the buffer.
  IF shift_mode!
    filesel_title_set("Save buffer as...?")
    block_load!=FALSE
    buffer_load!=TRUE
    choice&=0
  ELSE
    IF block_start%=0 AND block_end%=sample_end%
      filesel_title_set("Save sample as...?")
      block_load!=FALSE
      buffer_load!=FALSE
      choice&=0
    ELSE
      choice&=@msgbox_show(53,"[1][ Save entire file, or just | the marked block? ][ File | Block |   Cancel   ][^M|b|a]")  !keys: Return = File, b = Block, a = Cancel
      IF choice&=2
        filesel_title_set("Save block as...?")
        block_load!=TRUE
        buffer_load!=FALSE
      ELSE
        IF choice&=1
          ' Saving the whole file with a block marked: press Hide Blk (button 7 of tree 4) first.
          IF all_selected!=FALSE
            obj_find(4,7,work_ptr%)
            obj_draw_selected(work_ptr%+8,origin_x&,origin_y&,4,0)
            action_dispatch(4,7,0,0)
          ENDIF
          filesel_title_set("Save sample as...?")
          block_load!=FALSE
          buffer_load!=FALSE
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  saved_filename$=sample_filename$
  IF choice&<3
    filesel_run("*.AVR|*.SPL|*.SAM|*.SMP|*.SND|*.WAV|*.#|*.#K",selector_folder$,sample_filename$,ok_flag!)
  ELSE
    ok_flag!=FALSE
  ENDIF
  IF ok_flag!
    ' Format from the extension: .SPL 0, .SAM 1, .AVR 2, .WAV 3, .SMP 4, else the preferred format.
    SELECT RIGHT$(sample_filename$,4)
    CASE "PL"
      sample_format&=0
    CASE "AM"
      sample_format&=1
    CASE "VR"
      sample_format&=2
    CASE "AV"
      sample_format&=3
    CASE "MP"
      sample_format&=4
    DEFAULT
      sample_format&=opt_save_format&
    ENDSELECT
    ' Signed formats: SAM and SMP always, AVR when the preferences say so; SPL, WAV and 7/8 unsigned.
    SELECT sample_format&
    CASE 0,3,7,8
      signed_samples!=FALSE
    CASE 1,4
      signed_samples!=TRUE
    CASE 2
      signed_samples!=opt_signed_default!
    ENDSELECT
    pointer_hide
    pointer_busy(1)
    ' Whole sample: the saved name becomes the sample name.
    IF block_load!=FALSE AND buffer_load!=FALSE
      saved_filename$=sample_filename$
      status_name_draw
      status_block_draw
    ENDIF
    pointer_show
    ACLIP 1,0,0,639,screen_max_y&
    ' Saving a partially loaded sample over its own file: write back the part (Partial) or
    ' replace the file (Whole); Cancel clears the name, which skips the save.
    IF block_load!=FALSE AND buffer_load!=FALSE AND ((selector_folder$+sample_filename$)=sample_path$) AND @fexists(sample_path$) AND partial_loaded!
      pointer_hide
      pointer_busy(0)
      choice&=@msgbox_show(34,"[1][ Save partial back to file, | or erase file and make | this the whole file? ][ Partial | Whole |   Cancel   ][^M|w|a]")
      pointer_hide
      pointer_busy(1)
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
      IF choice&=1
        partial_save!=TRUE
      ELSE
        IF choice&=3
          sample_filename$=""
        ENDIF
      ENDIF
    ENDIF
    ' REPEAT ... UNTIL TRUE runs once; each EXIT IF skips the rest of the save.
    REPEAT
      EXIT IF sample_filename$=""
      ' Partial save: open the file for update, check its header and seek to the part's offset.
      ' Bug: length_bytes% is still 0 here, so format_detect skips the header check and the format comes from
      ' the extension; the write starts 128 bytes plus sample_file_offset% into the file, right only for AVR.
      IF partial_save!
        EXIT IF @fopen_channel("U",1,selector_folder$+sample_filename$)<>0
        IF @fsize_of(selector_folder$+sample_filename$)>128
          EXIT IF @fread_channel(1,scratch_addr%,128)<>0
          format_detect
          format_parameters
        ENDIF
        EXIT IF @fseek_rel(1,sample_file_offset%)<>0
        work_ptr%=sample_base%
        length_bytes%=sample_end%
        IF signed_samples!
          ~C:code_sign_flip%(L:work_ptr%,L:work_ptr%+length_bytes%)
        ENDIF
      ELSE
        ' Format 7: extension = rate in 100Hz, 3 digits.
        IF sample_format&=7
          IF INSTR(sample_filename$,".")<>0
            sample_filename$=LEFT$(sample_filename$,INSTR(sample_filename$,".")-1)
          ENDIF
          sample_filename$=sample_filename$+"."+RIGHT$("000"+STR$((sample_rate&+50) DIV 100),3)
          IF block_load!=FALSE AND buffer_load!=FALSE
            saved_filename$=sample_filename$
            status_name_draw
            status_block_draw
          ENDIF
          pointer_show
        ELSE
          ' Format 8: extension = rate in KHz followed by K.
          IF sample_format&=8
            IF INSTR(sample_filename$,".")<>0
              sample_filename$=LEFT$(sample_filename$,INSTR(sample_filename$,".")-1)
            ENDIF
            sample_filename$=sample_filename$+"."+STR$((sample_rate&+500) DIV 1000)+"K"
            IF block_load!=FALSE AND buffer_load!=FALSE
              saved_filename$=sample_filename$
              status_name_draw
              status_block_draw
            ENDIF
            pointer_show
          ENDIF
        ENDIF
        IF sample_format&=4
          ' SoundWizard (.SMP) samples are 12.5KHz; ask before saving another rate.
          IF sample_rate&<>12538
            pointer_hide
            pointer_busy(0)
            pointer_show
            choice&=@msgbox_show(59,"[1][ This sample is not | at 12.5KHz.  Save in | SoundWizard format | anyway? ][   Yes   | No ]")
            EXIT IF choice&=2
            pointer_hide
            pointer_busy(1)
            pointer_show
          ENDIF
        ENDIF
        EXIT IF @fopen_channel("N",1,selector_folder$+sample_filename$)<>0  !create the file as handle 1
        ' Data range: buffer = buffer_start% to the memory end, otherwise the block.
        IF buffer_load!
          work_ptr%=sample_base%+buffer_start%
          length_bytes%=memory_top%-buffer_start%
        ELSE
          work_ptr%=sample_base%+block_start%
          length_bytes%=block_end%-block_start%
        ENDIF
        ~C:code_fill%(L:scratch_addr%,L:128,0)  !clear the header buffer
        ' AVR header (128 bytes): "2BIT", name (8 chars, from the file name), +12 stereo 0,
        ' +14 resolution 8, +16 signed flag, +18 loop flag, +20 MIDI note $FFFF, +22 rate with top
        ' byte $FF, +26 length, +30/+34 loop start/end, +64 user text saved_from_text$.
        IF sample_format&=2
          LONG{scratch_addr%}=843204948  !"2BIT"
          BMOVE V:sample_filename$,scratch_addr%+4,INSTR(sample_filename$,".")-1
          pointer_show
          BYTE{scratch_addr%+15}=8
          CARD{scratch_addr%+16}=signed_samples!
          CARD{scratch_addr%+20}=-1
          CARD{scratch_addr%+22}=-256
          CARD{scratch_addr%+24}=sample_rate&
          LONG{scratch_addr%+26}=length_bytes%
          ' The loop is saved only with the whole sample.
          IF block_load!=FALSE AND buffer_load!=FALSE
            CARD{scratch_addr%+18}=sample_loop_on!
            IF sample_loop_on!
              LONG{scratch_addr%+30}=sample_loop_start%
              LONG{scratch_addr%+34}=sample_loop_end%
            ENDIF
          ENDIF
          CHAR{scratch_addr%+64}=saved_from_text$
          EXIT IF @fwrite_channel(1,scratch_addr%,128)<>0  !Fwrite the header
        ELSE
          ' WAV header (44 bytes, little-endian): RIFF size, "WAVEfmt ", chunk size 16, PCM 1, 1 channel,
          ' rate, bytes per second = rate, block align 1, 8 bits, "data" length.
          IF sample_format&=3
            LONG{scratch_addr%}=1380533830  !"RIFF"
            intel_long_store(scratch_addr%+4,36+length_bytes%)
            CHAR{scratch_addr%+8}="WAVEfmt "
            BYTE{scratch_addr%+16}=16
            BYTE{scratch_addr%+20}=1
            BYTE{scratch_addr%+22}=1
            intel_long_store(24+scratch_addr%,sample_rate&)
            intel_long_store(28+scratch_addr%,sample_rate&)
            BYTE{scratch_addr%+32}=1
            BYTE{scratch_addr%+34}=8
            CHAR{scratch_addr%+36}="data"
            intel_long_store(40+scratch_addr%,length_bytes%)
            EXIT IF @fwrite_channel(1,scratch_addr%,44)<>0
          ELSE
            ' SoundWizard SMP header (12 bytes): $7E817E81, word 4, word 0, length.
            IF sample_format&=4
              LONG{scratch_addr%}=2122415745
              CARD{scratch_addr%+4}=4
              CARD{scratch_addr%+6}=0
              LONG{scratch_addr%+8}=length_bytes%
              EXIT IF @fwrite_channel(1,scratch_addr%,12)<>0
            ENDIF
          ENDIF
        ENDIF
        IF signed_samples!
          ~C:code_sign_flip%(L:work_ptr%,L:work_ptr%+length_bytes%)  !convert to signed for writing
        ENDIF
      ENDIF
      obj_found%=chan_pos%(1)  !file position after the header
      EXIT IF @fwrite_channel(1,work_ptr%,length_bytes%)<>0  !Fwrite the sample data
      ~@fclose_channel(1)
      IF signed_samples!
        ~C:code_sign_flip%(L:work_ptr%,L:work_ptr%+length_bytes%)  !back to unsigned
      ENDIF
      ' Data written = file size - header size; less than the length means the disk is full.
      work_ptr%=@fsize_of(selector_folder$+sample_filename$)
      SUB work_ptr%,obj_found%
      IF length_bytes%<>work_ptr% AND partial_save!=FALSE
        pointer_hide
        pointer_busy(0)
        pointer_show
        choice&=@msgbox_show(25,"[3][ Diskette is full. | Please try another disk. ][  Oops, sorry, my mistake!  ]")
        remove_path$=selector_folder$+sample_filename$+CHR$(0)
        pointer_hide
        pointer_busy(1)
        pointer_show
        ~GEMDOS(65,L:V:remove_path$)  !Fdelete the incomplete file
      ENDIF
    UNTIL TRUE
    filesel_listed$=""  !filesel_listed$ is never set to anything else
    pointer_hide
    pointer_busy(0)
    pointer_show
    ACLIP 1,0,0,639,screen_max_y&
  ENDIF
  sample_filename$=saved_filename$
RETURN
' Help.  With SOUNDLAB.HLP in the program folder, dialog 38 lists the help topics: topics 0-7
' start help entry 38+n (help_page_play), button 8 shows the key summary.  Without the help file the
' key summary is shown.  The Help key is off meanwhile and comes back unless a help
' demonstration is now replaying (tour_active!).
PROCEDURE help_menu
  help_allowed!=FALSE
  IF @fexists(home_path$+"SoundLab.HLP")<>0
    dialog_run(38,choice&)
    IF choice&<8
      help_page_play(38+choice&)
    ELSE
      IF choice&=8
        key_summary_screen
      ENDIF
    ENDIF
    IF tour_active!=FALSE
      help_allowed!=TRUE
    ENDIF
  ELSE
    key_summary_screen
    help_allowed!=TRUE
  ENDIF
RETURN
' Key summary: draws a table of keys and their functions over the waveform area, three pairs of
' columns (keys, names) of 16 rows; the column headings "Edit Functions" and "Menu Items" are
' drawn in a different style.  Waits for a key or a mouse click, then redraws the waveform.
PROCEDURE key_summary_screen
  LOCAL key_table$,y_centre&,line_pattern&,ix&,y_or_j&,work_text$
  ' Entries are '|' separated: a column of 16 keys, then the column of their 16 names, and so on.
  key_table$="|Space|m|Return|p|z|a|h|x|c|Home|i|o|v|Delete|u|"
  key_table$=key_table$+"Edit Functions|Play|Monitor|Record|Speed|Zoom In|Zoom Out|Hide Blk|"
  key_table$=key_table$+"Cut|Copy|Clear|Insert|Overlay|Volume|Remove|Loop|"
  key_table$=key_table$+"f|e|r|b|l|s|Help|?|Undo|Space|M|Z|A|g|I|O|"
  key_table$=key_table$+"Fade|Echo|Reverse|High Bit|Load|Save|Help|Prefs|"
  key_table$=key_table$+"Quit|Play Buf|Listen|Min Zoom|Max Zoom|Gap|Ins File|Ovly File|"
  key_table$=key_table$+"t|L|S|F1-F10|F20|||^I|^S|^T|^N|^D|^C|^R|^F|A-P|"
  key_table$=key_table$+"Trim|Load Buf|Save Buf|4.915-24.576KHz|30KHz||Menu Items|Sound Lab|"
  key_table$=key_table$+"Shareware|Thanks|Rename File|Delete File(s)|Create Folder|Remove Folder|Format|Free Space|"
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF mono!
    ARECT 0,48,639,303,0,0,V:pattern_solid%,1  !clear the waveform area (mono)
  ELSE
    ARECT 0,24,639,151,0,0,V:pattern_solid%,1
  ENDIF
  line_pattern&=1
  y_centre&=0
  ix&=10
  IF mono!
    y_or_j&=48
  ELSE
    y_or_j&=24
  ENDIF
  font_attr_set(0,0,0,0,3)  !text style for the table
  font_attr_set(1,0,0,6,0)
  WHILE line_pattern&<=LEN(key_table$)
    work_text$=MID$(key_table$,line_pattern&,INSTR(key_table$,"|",line_pattern&)-line_pattern&)  !next entry
    line_pattern&=line_pattern&+(LEN(work_text$)+1)
    ' The two headings (column 1 row 0, column 5 row 6) get text effect 1.
    IF y_centre&=5 AND y_or_j&=72 AND mono!=FALSE OR (y_centre&=1 AND y_or_j&=24 AND mono!=FALSE) OR (y_centre&=5 AND y_or_j&=144 AND mono!) OR (y_centre&=1 AND y_or_j&=48 AND mono!)
      font_attr_set(1,1,0,6,0)
    ELSE
      font_attr_set(1,0,0,6,0)
    ENDIF
    txt_blit(ix&,y_or_j&,work_text$)
    ADD y_or_j&,8
    ' Next row (16 pixels mono, 8 colour); after 16 rows go to the next column's x position.
    IF mono!
      ADD y_or_j&,8
      IF y_or_j&=304
        y_or_j&=48
        INC y_centre&
        SELECT y_centre&
        CASE 1
          ix&=80
        CASE 2
          ix&=213
        CASE 3
          ix&=273
        CASE 4
          ix&=417
        CASE 5
          ix&=487
        ENDSELECT
      ENDIF
    ELSE
      IF y_or_j&=152
        y_or_j&=24
        INC y_centre&
        SELECT y_centre&
        CASE 1
          ix&=80
        CASE 2
          ix&=213
        CASE 3
          ix&=273
        CASE 4
          ix&=417
        CASE 5
          ix&=487
        ENDSELECT
      ENDIF
    ENDIF
  WEND
  ' Wait for a key (BIOS Bconstat) or a mouse button, then for the button release.
  REPEAT
  UNTIL BIOS(1,2) OR @pointer_buttons
  REPEAT
  UNTIL @pointer_buttons=0
  IF BIOS(1,2)
    ~INP(2)
  ENDIF
  key_table$=""
  trace_draw  !redraw the waveform
RETURN
' Quit.  After the alert the screen is dissolved to black in 9 steps: an empty 32000-byte screen
' is copied over the screen through the mask tables of dissolve_masks% (dissolve_code%, 200 lines of 80 words).
' Then the system is restored (sys_restore) and the program ends.
PROCEDURE program_quit
  choice&=@msgbox_show(7,"[1][ Really want to quit? ][    Yes    |No]")
  IF choice&=1
    pointer_hide
    ~C:code_fill%(L:screen_back%,L:32000,0)  !clear the work screen
    FOR ix&=0 TO 128 STEP 16
      VSYNC
      ~C:dissolve_code%(L:screen_back%,L:screen_addr%,L:dissolve_masks%+ix&,L:16+(dissolve_masks%+ix&),L:5177543)
    NEXT ix&
    sys_restore  !restore vectors, palette and resolution
    pointer_show
    END
  ENDIF
RETURN
' Key handler of the main window (tree 4) for the keys not handled elsewhere.  key_code& is the
' key code: ASCII, or scan code + 128 for Alt and function keys.
'   Alt+A..Alt+P        - Free Space of that drive (menu "2 7 n"), if the drive exists
'   ^I ^S ^T            - About (unless title_freed!), Shareware, Thanks
'   ^N ^D ^C ^R ^F      - Rename, Delete, Create Folder, Remove Folder, Format
'   M Z A G I O T L S   - the button functions in buffer mode (Listen, Min/Max Zoom, Gap, Insert
'                         File, Overlay File, Trim, Load Buffer, Save Buffer)
'   F1-F10, Shift+F10   - set the sample rate 4.9152-24.576KHz, 30.72KHz
' shift_mode! is LOCAL here, so the buffer mode set by buttons_buffer_mode ends when this returns.
PROCEDURE main_shifted_keys(key_code&)
  LOCAL work_text$,key_inp&,work_long%,shift_mode!
  ' Alt+A..Alt+P codes: the A..P scan codes + 128.
  work_text$="ž°® ’¡¢£—¤¥¦²±˜™"
  key_inp&=INSTR(work_text$,CHR$(key_code&))
  ' Not a drive key.
  IF key_inp&=0
    mnu_path$=""
    $S<
    SELECT key_code&
    CASE 9
      IF NOT title_freed!
        mnu_path$="1 1 1"
      ENDIF
    CASE 19
      mnu_path$="1 1 2"  !^S Shareware
    CASE 20
      mnu_path$="1 1 3"  !^T Thanks
    CASE 14
      mnu_path$="2 1"  !^N Rename File
    CASE 4
      mnu_path$="2 2"  !^D Delete File(s)
    CASE 3
      mnu_path$="2 4"  !^C Create Folder
    CASE 18
      mnu_path$="2 5"  !^R Remove Folder
    CASE 6
      mnu_path$="2 8"  !^F Format
    CASE 77
      ' M: Listen through the buffer.  Every buffer key shows the buffer buttons, highlights the
      ' button (tree 4 object n), runs the function, then deselects it and shows the normal buttons.
      buttons_buffer_mode
      obj_find(4,2,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      DO
      LOOP WHILE BIOS(11,-1) AND 15  !wait until Shift, Control and Alt are released (BIOS Kbshift)
      input_monitor
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 90
      ' Z: Min Zoom (zoom level 5).
      buttons_buffer_mode
      obj_find(4,5,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      prev_zoom&=zoom&
      zoom&=5
      zoom_apply
      status_zoom_draw
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 65
      ' A: Max Zoom (zoom level 0).
      buttons_buffer_mode
      obj_find(4,6,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      prev_zoom&=zoom&
      zoom&=0
      zoom_apply
      status_zoom_draw
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 71,103
      ' G: Gap.
      buttons_buffer_mode
      obj_find(4,10,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      block_clear_gap
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 73
      ' I: Insert File into the buffer.
      buttons_buffer_mode
      obj_find(4,11,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      block_insert
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 79
      ' O: Overlay File.
      buttons_buffer_mode
      obj_find(4,12,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      overlay_dialog
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 116,84
      ' T: Trim the buffer.
      buttons_buffer_mode
      obj_find(4,14,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      block_trim
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 76
      ' L: Load Buffer.
      buttons_buffer_mode
      obj_find(4,20,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      sample_loader
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 83
      ' S: Save Buffer.
      buttons_buffer_mode
      obj_find(4,21,work_long%)
      obj_draw_selected(work_long%+8,origin_x&,origin_y&,4,0)
      sample_saver
      obj_draw_normal(work_long%+8,origin_x&,origin_y&,4,0)
      buttons_normal_mode
    CASE 187 TO 196,221
      ' F1-F10 (codes 187-196) and Shift+F10 (221) pick a rate; written to the rate field
      ' (tree 6 object 15) and set with rate_timer_calc.
      SELECT key_code&+-186
      CASE 1
        work_text$="4.9152"
      CASE 2
        work_text$="6.2693"
      CASE 3
        work_text$=MKL$(925775416)  !"7.68"
      CASE 4
        work_text$="9.6"
      CASE 5
        work_text$="10.971"
      CASE 6
        work_text$="12.538"
      CASE 7
        work_text$="14.985"
      CASE 8
        work_text$="19.819"
      CASE 9
        work_text$="21.942"
      CASE 10
        work_text$="24.576"
      CASE 35
        work_text$="30.72"
      ENDSELECT
      work_text$=LEFT$(work_text$+"      ",6)
      obj_find(6,15,work_long%)
      BMOVE V:work_text$,16+(rsc_data%+LONG{work_long%+24}),6
      choice&=1
      rate_timer_calc
      status_zoom_draw
      IF seconds_on!  !sizes in seconds depend on the rate: redraw them
        status_block_draw
        memory_size_draw
      ENDIF
      pointer_show
    ENDSELECT
    IF mnu_path$<>""
      mnu_dispatch(mnu_path$)  !run the menu entry
    ENDIF
  ELSE
    ' Alt+drive letter: BIOS Drvmap; with one floppy (_nflops $4A6 = 1) drive B is not real.
    drive_map&=BIOS(10)
    IF DPEEK(1190)=1
      SUB drive_map&,2
    ENDIF
    IF BTST(drive_map&,PRED(key_inp&))
      mnu_path$="2 7 "+STR$(key_inp&)
      mnu_dispatch(mnu_path$)
    ENDIF
  ENDIF
RETURN
' Key handler of the fade dialog (tree 12): F1-F4 (codes 187-190) choose the fade curve type
' fade_shape& 0-3 (0 = linear) and redraw the curve preview.
PROCEDURE fade_curve_keys(key_code&)
  IF key_code&>186 AND key_code&<191
    fade_shape&=-187+key_code&
    volume_preview_draw(1)
  ENDIF
RETURN
' Decodes the program serial string serial_number$ in place: every byte XOR 250.
PROCEDURE serial_decode
  LOCAL ix&
  FOR ix&=0 TO LEN(serial_number$)-1
    BYTE{ix&+V:serial_number$}=BYTE{ix&+V:serial_number$} XOR 250
  NEXT ix&
RETURN
' Draws the five normal button strip images (panel_image%) at the bottom of the main window and
' clears buffer mode shift_mode!.  Redraws the marker line at x 240 when Hide Blk is on.
PROCEDURE buttons_normal_mode
  LOCAL rect_ay&,y_bottom&
  IF mono!  !y positions of the two button rows, mono or colour
    rect_ay&=332
    y_bottom&=354
  ELSE
    rect_ay&=166
    y_bottom&=177
  ENDIF
  pointer_hide
  image_blit(0,rect_ay&,panel_image%)
  image_blit(80,y_bottom&,panel_image%+406)
  image_blit(240,rect_ay&,panel_image%+812)
  image_blit(464,y_bottom&,panel_image%+1438)
  image_blit(320,y_bottom&,panel_image%+2084)
  shift_mode!=FALSE
  IF all_selected!
    IF mono!
      ARECT 240,336,240,353,1,0,V:pattern_grey%,1
    ELSE
      ALINE 240,168,240,176,1,-1,0
    ENDIF
  ENDIF
  pointer_show
RETURN
' Draws the five buffer-mode button strip images (panel_image_alt%) and sets buffer mode shift_mode!, so the
' buttons act on the buffer.  Redraws the marker line at x 240 when Hide Blk is on.
PROCEDURE buttons_buffer_mode
  LOCAL rect_ay&,y_bottom&
  IF mono!
    rect_ay&=332
    y_bottom&=354
  ELSE
    rect_ay&=166
    y_bottom&=177
  ENDIF
  pointer_hide
  image_blit(0,rect_ay&,panel_image_alt%)
  image_blit(80,y_bottom&,panel_image_alt%+406)
  image_blit(240,rect_ay&,panel_image_alt%+812)
  image_blit(464,y_bottom&,panel_image_alt%+1438)
  image_blit(320,y_bottom&,panel_image_alt%+2084)
  pointer_show
  shift_mode!=TRUE
  IF all_selected!
    IF mono!
      ARECT 240,336,240,353,1,0,V:pattern_grey%,1
    ELSE
      ALINE 240,168,240,176,1,-1,0
    ENDIF
  ENDIF
RETURN
' Builds the segment list for a curved fade.  curve_type& = curve type 1-3, level_a/level_b = start and
' end level 0..1, start_pos%..stop_pos% = address range, list_ptr% = list buffer.  Walks the level from
' start to end in steps of 0.005 and works out where each level is reached on the curve:
' type 1 a quarter sine, type 2 the other quarter sine, type 3 a half sine (S curve).
' Each entry is 12 bytes: volume table address (volume_tables% + level*256), start, end; a 0 long
' ends the list.  The caller runs the volume table routine code_byte_map% over every entry.
PROCEDURE fade_curve_build(curve_type&,level_a,level_b,start_pos%,stop_pos%,list_ptr%)
  LOCAL range_pos%,seg_end%,factor,factor_range,angle_offset,angle,ratio,level_step,level
  ratio=(stop_pos%-start_pos%)*2/PI  !address units per radian of a quarter sine
  factor_range=ABS(level_a-level_b)
  factor=MIN(level_a,level_b)
  level_step=SGN(level_b-level_a)*.005
  range_pos%=start_pos%
  IF factor_range>0  !reciprocal of the level range
    factor_range=1/factor_range
  ENDIF
  IF curve_type&=1
    IF level_a>level_b
      angle_offset=PI/2
    ELSE
      angle_offset=0
    ENDIF
    level=level_a
    DO
      EXIT IF ABS(level-level_b)<.0025  !end level reached
      level=level+level_step
      angle=ASIN((level-factor)*factor_range)
      IF angle<angle_offset
        angle=PI-angle
      ENDIF
      SUB angle,angle_offset
      seg_end%=ADD(ratio*angle,start_pos%)
      seg_end%=MIN(seg_end%,stop_pos%)
      IF seg_end%>range_pos%
        LONG{list_ptr%}=volume_tables%+SHL&(INT((level-level_step)*100),8)  !volume table of the previous level for this segment
        LONG{list_ptr%+4}=range_pos%
        LONG{list_ptr%+8}=seg_end%
        list_ptr%=list_ptr%+12
        range_pos%=seg_end%
      ENDIF
      level=level+level_step
    LOOP
  ELSE
    IF curve_type&=2
      IF level_a>level_b
        angle_offset=PI
      ELSE
        angle_offset=0
      ENDIF
      level=level_a
      DO
        EXIT IF ABS(level-level_b)<.0025
        level=level+level_step
        angle=ASIN((level-factor)*factor_range-1)
        IF angle_offset<>0
          angle=PI-angle
        ELSE
          angle=angle+PI/2
        ENDIF
        SUB angle,angle_offset
        seg_end%=ADD(ratio*angle,start_pos%)
        seg_end%=MIN(seg_end%,stop_pos%)
        IF seg_end%>range_pos%
          LONG{list_ptr%}=volume_tables%+SHL&(INT((level-level_step)*100),8)
          LONG{list_ptr%+4}=range_pos%
          LONG{list_ptr%+8}=seg_end%
          list_ptr%=list_ptr%+12
          range_pos%=seg_end%
        ENDIF
        level=level+level_step
      LOOP
    ELSE
      ' Type 3: half sine over the whole range.
      DIV ratio,2
      IF level_a>level_b
        angle_offset=1
      ELSE
        angle_offset=0
      ENDIF
      level=level_a
      DO
        EXIT IF ABS(level-level_b)<.0025
        level=level+level_step
        angle=ASIN((level-factor)*factor_range*2-1)
        IF angle_offset<>0
          angle=-angle
        ENDIF
        angle=angle+PI/2
        seg_end%=ADD(ratio*angle,start_pos%)
        seg_end%=MIN(seg_end%,stop_pos%)
        IF seg_end%>range_pos%
          LONG{list_ptr%}=volume_tables%+SHL&(INT((level-level_step)*100),8)
          LONG{list_ptr%+4}=range_pos%
          LONG{list_ptr%+8}=seg_end%
          list_ptr%=list_ptr%+12
          range_pos%=seg_end%
        ENDIF
        level=level+level_step
      LOOP
    ENDIF
  ENDIF
  ' The rest of the range gets the end level and the list end marker.
  IF range_pos%<stop_pos%
    LONG{list_ptr%}=ADD(25600*level_b,volume_tables%)
    LONG{list_ptr%+4}=range_pos%
    LONG{list_ptr%+8}=stop_pos%
    LONG{list_ptr%+12}=0
  ENDIF
RETURN
' Slows the mouse to a stop: XBIOS Initmous relative mode with the parameter bytes 0,0,127,127
' (top mode, buttons, x and y threshold 127), mouse vector from Kbdvbase+16.  Used while playing.
PROCEDURE pointer_freeze
  LOCAL work_text$,pointer_vector%
  work_text$=MKI$(0)+MKI$(32639)
  pointer_vector%=LPEEK(16+XBIOS(34))
  ~XBIOS(0,1,L:V:work_text$,L:pointer_vector%)
  work_text$=""
RETURN
' Normal mouse again: XBIOS Initmous relative mode with x and y threshold 1.
PROCEDURE pointer_normal
  LOCAL work_text$,pointer_vector%
  work_text$=MKI$(0)+MKI$(257)
  pointer_vector%=LPEEK(16+XBIOS(34))
  ~XBIOS(0,1,L:V:work_text$,L:pointer_vector%)
  work_text$=""
RETURN
' Waits until a key is let go.  key_code& = scan code of the key that started the action, or 0 for
' any key: if the keyboard ACIA last sent that key's make code, waits for its break code (+128).
' Then waits until no Shift, Control, Alt or Alt+Clr/Insert mouse key is held (Kbshift AND 111)
' and empties the keyboard buffer.
PROCEDURE key_release_wait(key_code&)
  LOCAL scan_code|
  scan_code|=@keyboard_scancode
  IF scan_code|=key_code& AND key_code&>0 OR (key_code&=0 AND scan_code|<128 AND scan_code|>10)
    scan_code|=scan_code|+128
    REPEAT
    UNTIL @keyboard_scancode=scan_code|
  ENDIF
  DO
  LOOP WHILE BIOS(11,-1) AND 111
  WHILE BIOS(1,2)
    ~INP(2)
  WEND
RETURN
$F<
' Returns the last byte received by the keyboard ACIA: GEMDOS Super, read the status $FFFC00
' and the data $FFFC02, back to user mode.  Make codes are below 128, break codes 128 and up.
FUNCTION keyboard_scancode
  $F%
  saved_ssp%=GEMDOS(32,L:0)
  ~BYTE{-1024}
  acia_byte|=BYTE{-1022}
  ~GEMDOS(32,L:saved_ssp%)
  saved_ssp%=0
  RETURN acia_byte|
ENDFUNC
' Clears the screen and draws the main window: title bar boxes, the shaded frame, the info line,
' the waveform area and the button rows, with the mono (640x400) or colour (640x200) layout.
' The version text " Sound Lab 1.11  July 28, 1993 " is centred at x 165 in the title bar.
PROCEDURE screen_frame_draw
  CLS
  IF mono!
    ACLIP 1,0,0,639,399
    pointer_hide
    ARECT 0,22,639,399,3,0,V:pattern_light%,1
    ARECT 337,4,360,21,3,0,V:pattern_light%,1
    ARECT 614,4,639,21,3,0,V:pattern_light%,1
    ARECT 0,26,3,399,3,0,V:pattern_solid%,1
    ARECT 0,22,336,25,3,0,V:pattern_solid%,1
    ARECT 333,4,336,21,3,0,V:pattern_solid%,1
    ARECT 333,0,360,3,3,0,V:pattern_solid%,1
    ARECT 365,22,613,25,3,0,V:pattern_solid%,1
    ARECT 610,4,613,21,3,0,V:pattern_solid%,1
    ARECT 610,0,639,3,3,0,V:pattern_solid%,1
    ARECT 0,20,332,21,1,0,V:pattern_grey%,1
    ARECT 331,0,332,19,1,0,V:pattern_grey%,1
    ARECT 361,20,609,21,1,0,V:pattern_grey%,1
    ARECT 361,0,362,19,1,0,V:pattern_grey%,1
    ARECT 608,0,609,19,1,0,V:pattern_grey%,1
    ARECT 0,28,639,45,1,0,V:pattern_grey%,1
    ARECT 0,46,639,307,0,0,V:pattern_solid%,1
    ARECT 0,308,639,325,1,0,V:pattern_grey%,1
    ARECT 0,326,639,329,3,0,V:pattern_solid%,1
    font_attr_set(0,0,0,0,3)
    wrmode_set(2)
    font_attr_set(1,0,0,6,0)
    txt_centred(165,15," Sound Lab 1.11  July 28, 1993 ",font_main%)
  ELSE
    ' Colour layout, half the heights.
    ACLIP 1,0,0,639,199
    pointer_hide
    ARECT 0,11,639,199,2,0,V:pattern_solid%,1
    ARECT 337,2,360,10,2,0,V:pattern_solid%,1
    ARECT 614,2,639,10,2,0,V:pattern_solid%,1
    ARECT 0,13,3,199,3,0,V:pattern_solid%,1
    ARECT 0,11,336,12,3,0,V:pattern_solid%,1
    ARECT 333,2,336,10,3,0,V:pattern_solid%,1
    ARECT 333,0,360,1,3,0,V:pattern_solid%,1
    ARECT 365,11,613,12,3,0,V:pattern_solid%,1
    ARECT 610,2,613,10,3,0,V:pattern_solid%,1
    ARECT 610,0,639,1,3,0,V:pattern_solid%,1
    HLINE 0,10,332,1,0,V:pattern_solid%,1
    ARECT 331,0,332,9,1,0,V:pattern_solid%,1
    HLINE 361,10,609,1,0,V:pattern_solid%,1
    ARECT 361,0,362,9,1,0,V:pattern_solid%,1
    ARECT 608,0,609,9,1,0,V:pattern_solid%,1
    ARECT 0,14,639,22,1,0,V:pattern_solid%,1
    ARECT 0,23,639,153,0,0,V:pattern_solid%,1
    ARECT 0,154,639,162,1,0,V:pattern_solid%,1
    ARECT 0,163,639,164,3,0,V:pattern_solid%,1
    font_attr_set(0,0,0,0,3)
    wrmode_set(2)
    font_attr_set(1,0,0,6,0)
    txt_centred(165,7," Sound Lab 1.11  July 28, 1993 ",font_main%)
  ENDIF
RETURN
' Detects the format of the file whose first 128 bytes are in scratch_addr% and whose size is length_bytes%.
' Sets sample_format&, seeks handle 1 to the sample data and makes length_bytes% the data length:
'   "2BIT" AVR (2), "RIFF" WAV (3, 44-byte header), $7E817E81 SoundWizard SMP (4, 12 bytes),
'   'G' 8-byte header with a rate code (5), first byte 0-7 = rate code with a 2-byte header (6).
' Otherwise the extension decides: .SPL (0), .SAM (1), a number or number+K (7), else the
' preferred format for headerless files opt_load_format&.
PROCEDURE format_detect
  IF length_bytes%>=128
    IF LONG{scratch_addr%}=843204948  !"2BIT": AVR, data after the 128-byte header
      sample_format&=2
      length_bytes%=MIN(length_bytes%,128+LONG{scratch_addr%+26})
    ELSE
      IF LONG{scratch_addr%}=1380533830  !"RIFF": WAV, data length little-endian at +40
        sample_format&=3
        ~@fseek_abs(1,44)
        obj_found%=BYTE{scratch_addr%+40}+BYTE{scratch_addr%+41}*256+BYTE{scratch_addr%+42}*65536+BYTE{scratch_addr%+43}*16777216
        length_bytes%=MIN(length_bytes%,44+obj_found%)
      ELSE
        IF LONG{scratch_addr%}=2122415745  !SoundWizard SMP, length at +8
          sample_format&=4
          ~@fseek_abs(1,12)
          length_bytes%=MIN(length_bytes%,12+LONG{scratch_addr%+8})
        ELSE
          IF BYTE{scratch_addr%}=71  !'G': length at +2, rate code at +6
            sample_format&=5
            ~@fseek_abs(1,8)
            length_bytes%=MIN(length_bytes%,LONG{scratch_addr%+2}+8)
          ELSE
            IF BYTE{scratch_addr%}>=0 AND BYTE{scratch_addr%}<=7
              sample_format&=6
              ~@fseek_abs(1,2)
            ELSE
              sample_format&=-1
              ~@fseek_abs(1,0)
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    SUB length_bytes%,chan_pos%(1)  !minus the header (the file position after the seek)
  ELSE
    sample_format&=-1
  ENDIF
  ' No header found: decide by the extension.
  IF sample_format&<0
    work_text$=MID$(sample_filename$,RINSTR(sample_filename$,".")+1)
    IF RIGHT$(sample_filename$,4)=".SPL"
      sample_format&=0
    ELSE
      IF RIGHT$(sample_filename$,4)=".SAM"
        sample_format&=1
      ELSE
        IF (RIGHT$(work_text$)="K") AND VAL?(work_text$)+1=LEN(work_text$) OR VAL?(work_text$)=LEN(work_text$)  !the extension is all digits, or digits followed by K
          sample_format&=7
        ELSE
          sample_format&=opt_load_format&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Sets the sample parameters for the format sample_format& found by format_detect, from the header in scratch_addr%
' or fixed values: signed_samples! signed data, header_stereo! stereo, header_rate% sample rate in Hz.
' Raw SPL and SAM keep the current rate; AVR also brings its loop when the whole sample is loaded.
PROCEDURE format_parameters
  SELECT sample_format&
  CASE 0
    ' SPL: unsigned, mono.
    signed_samples!=FALSE
    header_stereo!=FALSE
    header_rate%=sample_rate&
  CASE 1
    ' SAM: signed, mono.
    signed_samples!=TRUE
    header_stereo!=FALSE
    header_rate%=sample_rate&
  CASE 2
    ' AVR: signed flag, stereo flag and rate from the header; loop points for a whole-sample load.
    signed_samples!=INT{scratch_addr%+16}
    header_stereo!=INT{scratch_addr%+12}
    header_rate%=CARD{scratch_addr%+24}
    IF buffer_load!=FALSE AND block_load!=FALSE
      IF INT{scratch_addr%+18}
        sample_loop_start%=LONG{scratch_addr%+30}
        sample_loop_end%=LONG{scratch_addr%+34}
        sample_loop_on!=TRUE
      ENDIF
    ENDIF
  CASE 3
    ' WAV: unsigned 8-bit, channels - 1 = stereo, rate from the low word (little-endian).
    signed_samples!=FALSE
    header_stereo!=BYTE{scratch_addr%+22}-1
    header_rate%=BYTE{scratch_addr%+24}+SHL(BYTE{scratch_addr%+25},8)
  CASE 4
    ' SoundWizard SMP: signed, 12.538KHz.
    signed_samples!=TRUE
    header_stereo!=FALSE
    header_rate%=12538
  CASE 5
    ' 'G' format: signed, rate from the code at +6.
    signed_samples!=TRUE
    header_stereo!=FALSE
    SELECT BYTE{scratch_addr%+6}
    CASE 0
      header_rate%=32336
    CASE 1
      header_rate%=26713
    CASE 2
      header_rate%=21186
    CASE 3
      header_rate%=16605
    CASE 4
      header_rate%=13072
    CASE 5
      header_rate%=8192
    CASE 6
      header_rate%=6334
    CASE 7
      header_rate%=4015
    ENDSELECT
  CASE 6
    ' Rate-byte format: unsigned, rate from the code in the first byte.
    signed_samples!=FALSE
    header_stereo!=FALSE
    SELECT BYTE{scratch_addr%}
    CASE 0
      header_rate%=4915
    CASE 1
      header_rate%=7680
    CASE 2
      header_rate%=9600
    CASE 3
      header_rate%=14985
    CASE 4
      header_rate%=19819
    CASE 5
      header_rate%=30720
    CASE 6
      header_rate%=38400
    CASE 7
      header_rate%=49152
    ENDSELECT
  CASE 7
    ' Rate in the extension: .##K = KHz, otherwise hundreds of Hz.
    signed_samples!=FALSE
    header_stereo!=FALSE
    work_text$=MID$(sample_filename$,RINSTR(sample_filename$,".")+1)
    IF RIGHT$(sample_filename$)="K"
      header_rate%=VAL(work_text$)*1000
    ELSE
      header_rate%=VAL(work_text$)*100
    ENDIF
  ENDSELECT
RETURN
' Stores the long long_value% at addr% in Intel (little-endian) byte order, for WAV headers.
PROCEDURE intel_long_store(addr%,long_value%)
  BYTE{addr%}=long_value% AND 255
  BYTE{addr%+1}=SHR(long_value%,8) AND 255
  BYTE{addr%+2}=SHR(long_value%,16) AND 255
  BYTE{addr%+3}=SHR(long_value%,24) AND 255
RETURN
' Stores the word short_value& at addr% in Intel (little-endian) byte order.  Never called.
PROCEDURE intel_word_store(addr%,short_value&)
  BYTE{addr%}=short_value& AND 255
  BYTE{addr%+1}=SHR&(short_value&,8) AND 255
RETURN
' Reads the 16 colour registers with XBIOS Setcolor(n,-1), 12 bits each, into palette_str$
' (32 bytes, the XBIOS Setpalette layout).
PROCEDURE palette_read(VAR palette_str$)
  LOCAL ix&
  palette_str$=""
  FOR ix&=0 TO 15
    palette_str$=palette_str$+MKI$(XBIOS(7,ix&,-1) AND 4095)
  NEXT ix&
RETURN
' Draws work_text$ centred on x = ix&, top at y = y_or_j&.
' The width is measured with font header font_ptr%; the string is drawn with the current font font_current%.
PROCEDURE txt_centred(ix&,y_or_j&,work_text$,font_ptr%)
  txt_draw(ix&-@pixel_width_of(font_ptr%,work_text$)/2,y_or_j&,work_text$)
RETURN
' Draws work_text$ right-aligned so that it ends at x = ix&, top at y = y_or_j&.
' The width is measured with font header font_ptr%; the string is drawn with the current font font_current%.
PROCEDURE txt_right(ix&,y_or_j&,work_text$,font_ptr%)
  txt_draw(ix&-@pixel_width_of(font_ptr%,work_text$),y_or_j&,work_text$)
RETURN
' Builds the 8 fade palettes fade_palettes$(0..7) for the title screen.
' palette_str$ is the palette at step 0, palette_to$ the palette at step 7 (16 ST colour words each).
' Each colour is split into its 3-bit red, green and blue nibbles and blended linearly per step.
PROCEDURE palette_fade_build(palette_to$,palette_str$)
  LOCAL ix&,col_from,pal_index&,r_from,g_from,b_from,palette_unused$,col_to,r_to,g_to,b_to,r_mix,gb_mix
  FOR ix&=0 TO 7
    FOR pal_index&=0 TO 15
      col_from=INT{V:palette_str$+pal_index&*2}
      col_to=INT{V:palette_to$+pal_index&*2}
      ' Split target and start colours into red, green and blue.
      r_to=col_to DIV 256
      g_to=col_to MOD 256 DIV 16
      b_to=col_to MOD 16
      r_from=col_from DIV 256
      g_from=col_from MOD 256 DIV 16
      b_from=col_from MOD 16
      ' Blend: red in r_mix, green*16+blue in gb_mix.
      r_mix=INT((r_to-r_from)*ix&/7)+r_from
      gb_mix=(INT((g_to-g_from)*ix&/7)+g_from)*16+b_from+INT((b_to-b_from)*ix&/7)
      CARD{V:fade_palettes$(ix&)+pal_index&*2}=r_mix*256+gb_mix
    NEXT pal_index&
  NEXT ix&
RETURN
' Counts the free space of drive drive_no& by reading its FAT directly with BIOS Rwabs.
' scratch_addr% is a work buffer of at least 10K; the result (free bytes) is returned in byte_count%.
' The boot sector gives the BPB; the FAT is read in 10K chunks and every 0 entry is a free cluster.
' Bugs: each chunk is scanned as 5120 entries, which is right only for a 16-bit FAT, and the
' last two clusters are never checked (entries 2..count-1 instead of 2..count+1).
PROCEDURE disk_free_space(drive_no&,scratch_addr%,VAR byte_count%)
  LOCAL fat_secs_left&,root_secs&,secs_per_clus&,reserved_secs&,root_first&,data_first&,clus_left&,ix&,seg_end%,clus_bytes&,aux&,total_secs&,num_val&,free_clus&,sec_bytes&,chunk_secs&
  byte_count%=0
  ' Force a media change first so the boot sector and FAT are current.
  media_change_force(drive_no&)
  ' Read sector 0 (boot sector).  Rwabs flag 2 = read, ignoring media change.
  rwabs_retry(2,scratch_addr%,1,0,drive_no&)
  IF gem_error&=0
    ' BPB from the boot sector (Intel byte order): bytes/sector at 11, sectors/FAT at 22,
    ' root entries at 17 (/16 = root sectors), sectors/cluster at 13, total sectors at 19.
    sec_bytes&=FNle_word(11+scratch_addr%)
    fat_secs_left&=FNle_word(22+scratch_addr%)
    root_secs&=FNle_word(17+scratch_addr%) DIV 16
    secs_per_clus&=BYTE{scratch_addr%+13}
    reserved_secs&=1
    root_first&=SUCC(fat_secs_left&*2)
    data_first&=root_first&+root_secs&
    total_secs&=FNle_word(19+scratch_addr%)
    clus_left&=DIV(total_secs&-data_first&,secs_per_clus&)
    ' Sectors that fit in the 10K buffer.
    chunk_secs&=DIV(10240,sec_bytes&)
    ' BIOS Getbpb: bflags at offset 16, bit 0 set = 16-bit FAT.
    fat16&=INT{BIOS(7,drive_no&)+16}
    free_clus&=0
    clus_bytes&=sec_bytes&*secs_per_clus&
    aux&=0
    ' Read and scan the FAT in full 10K chunks; the first chunk skips the two reserved entries.
    WHILE fat_secs_left&>chunk_secs&
      rwabs_retry(2,scratch_addr%,chunk_secs&,aux&+1,drive_no&)
      EXIT IF gem_error&
      IF aux&=0
        num_val&=2
      ELSE
        num_val&=0
      ENDIF
      FOR fat_loop&=num_val& TO 5119
        fat_entry_fetch(scratch_addr%,fat_loop&,fat16&,seg_end%)
        IF seg_end%=0
          INC free_clus&
        ENDIF
      NEXT fat_loop&
      clus_left&=clus_left&+-5120
      SUB fat_secs_left&,chunk_secs&
      aux&=aux&+chunk_secs&
    WEND
    IF gem_error&=0
      ' Read the last (partial) chunk of the FAT and scan the remaining entries.
      rwabs_retry(2,scratch_addr%,fat_secs_left&,aux&+1,drive_no&)
      IF gem_error&=0
        IF aux&=0
          num_val&=2
        ELSE
          num_val&=0
        ENDIF
        FOR fat_loop&=num_val& TO PRED(clus_left&)
          fat_entry_fetch(scratch_addr%,fat_loop&,fat16&,seg_end%)
          IF seg_end%=0
            INC free_clus&
          ENDIF
        NEXT fat_loop&
        byte_count%=free_clus&*clus_bytes&  !free clusters * bytes per cluster
      ENDIF
    ENDIF
  ENDIF
RETURN
' Fetches FAT entry fat_index% from the FAT buffer addr% into fat_entry%.
' obj_type& <> 0: 16-bit FAT, the Intel-order word is byte-swapped with ROR.W #8.
' Otherwise 12-bit FAT: two entries share 3 bytes; values $F00 and up are extended to $FFxx.
PROCEDURE fat_entry_fetch(addr%,fat_index%,obj_type&,VAR fat_entry%)
  IF obj_type&
    addr%=addr%+SHL&(fat_index%,1)
    fat_entry%=ROR&(INT{addr%},8)
  ELSE
    ' Odd entry: high nibble of byte 1 and all of byte 2.  Even entry: byte 0 and low nibble of byte 1.
    IF ODD(fat_index%)
      fat_index%=addr%+MUL(fat_index% DIV 2,3)
      fat_entry%=SHR|(BYTE{fat_index%+1},4)+SHL&(BYTE{fat_index%+2},4)
    ELSE
      fat_index%=addr%+MUL(fat_index% DIV 2,3)
      fat_entry%=BYTE{fat_index%}+SHL&(BYTE{fat_index%+1} AND 15,8)
    ENDIF
    IF fat_entry%>=3840
      fat_entry%=fat_entry%+61440
    ENDIF
  ENDIF
RETURN
' BIOS Rwabs (BIOS 4): rw_flag& = flag, addr% = buffer, sec_count& = sector count, range_start& = first
' sector, drive_no& = drive.  The result is left in gem_error&; errors are shown by dos_error_alert.
' Bug: dos_error_alert sets gem_error& to -999 for Retry, but the loop tests 999, so it never retries.
PROCEDURE rwabs_retry(rw_flag&,addr%,sec_count&,range_start&,drive_no&)
  REPEAT
    gem_error&=BIOS(4,rw_flag&,L:addr%,sec_count&,range_start&,drive_no&)
    IF gem_error&
      dos_error_alert(gem_error&)
    ENDIF
  UNTIL gem_error&<>999
RETURN
' Installs the routine at vbl_routine% in the first free slot of the VBL queue.
' $454 = nvbls (slot count), $456 = _vblqueue (slot table).  The slot address is returned in vbl_slot%.
' If no slot is free, the long just after the table is overwritten.
PROCEDURE vbl_install(vbl_routine%,VAR vbl_slot%)
  LOCAL vbl_count&,vbl_queue%,ix&
  vbl_count&=DPEEK(1108)
  vbl_queue%=LPEEK(1110)
  FOR ix&=0 TO SHL(vbl_count&,2)-1 STEP 4
    EXIT IF LPEEK(vbl_queue%+ix&)=0
  NEXT ix&
  vbl_slot%=vbl_queue%+ix&
  SLPOKE vbl_slot%,vbl_routine%
RETURN
' Makes GEMDOS treat drive drive_no& as changed, so its directory and FAT are read again.
' A tiny 68000 routine is built in work_text$ and put in hdv_mediach ($47E):
'   MOVE.L #old_vector,$47E(A5) / MOVEQ #2,D0 / RTS
' It restores the old vector and answers "media changed" once; it relies on A5 being 0 in the BIOS.
' Fsfirst (GEMDOS 78) on "X:\*.*" then makes GEMDOS ask the drive.
PROCEDURE media_change_force(drive_no&)
  LOCAL work_text$,kept_addr%,work_ptr%,path_z$
  path_z$=CHR$(drive_no&+65)+":\*.*"+CHR$(0)
  work_text$=SPACE$(524)
  kept_addr%=LPEEK(1150)
  work_ptr%=V:work_text$
  CARD{work_ptr%}=11132  !$2B7C: MOVE.L #imm,d16(A5)
  LONG{work_ptr%+2}=kept_addr%
  CARD{work_ptr%+6}=1150
  CARD{work_ptr%+8}=28674  !$7002 MOVEQ #2,D0 and $4E75 RTS
  CARD{work_ptr%+10}=20085
  SLPOKE 1150,work_ptr%  !hdv_mediach -> the routine in work_text$
  ~GEMDOS(78,L:V:path_z$,-1)
  pointer_show
  work_text$=""
  path_z$=""
RETURN
' Calls the AES file selector directly through GEMSYS.
' work_str$ = title, path_dir$ = path with mask, fname_arg$ = default file name.
' Returns full_path$ = folder of the path + chosen name, result_value& = exit button (1 = OK).
PROCEDURE selector_call(work_str$,path_dir$,fname_arg$,VAR full_path$,result_value&)
  LOCAL work_text$
  path_dir$=LEFT$(path_dir$+STRING$(127,0),127)+CHR$(0)
  fname_arg$=LEFT$(fname_arg$+STRING$(127,0),127)+CHR$(0)
  work_str$=work_str$+CHR$(0)
  work_text$=path_dir$+fname_arg$
  ' TOS 1.04 or later (sysbase $4F2 + 2 = version >= $0104): fsel_exinput (91) with a title;
  ' otherwise fsel_input (90).
  IF DPEEK(LPEEK(1266)+2)>=260
    GCONTRL(0)=91
  ELSE
    GCONTRL(0)=90
  ENDIF
  GCONTRL(1)=0
  GCONTRL(2)=2
  GCONTRL(3)=3
  GCONTRL(4)=0
  ' addrin: path buffer (128 bytes), file buffer (128 bytes), title.
  ADDRIN(0)=V:work_text$
  ADDRIN(1)=128+V:work_text$
  ADDRIN(2)=V:work_str$
  GEMSYS
  path_dir$=CHAR{V:work_text$}
  fname_arg$=CHAR{128+V:work_text$}
  result_value&=GINTOUT(1)
  full_path$=LEFT$(path_dir$,RINSTR(path_dir$,"\"))+fname_arg$
  work_text$=""
RETURN
' Sets the text attributes used by txt_draw/txt_blit.
' font_no& > 0: selects font font_no& (2 is treated as 1) and sets font_current% to its header.
' font_no& = 0: y_centre& = VDI colour index (mapped with vdi_to_hw_colour&), num_val& = text style,
' item_height& = top offset (doubled + 1 in high res).  aux& is not used.
PROCEDURE font_attr_set(y_centre&,num_val&,aux&,item_height&,font_no&)
  IF font_no&>0
    IF font_no&=2
      font_no&=1
    ENDIF
    font_current%=@font_find(font_no&)
    font_id&=font_no&
  ELSE
    text_colour&=vdi_to_hw_colour&(y_centre&)
    text_top&=item_height&
    text_style&=num_val&
    IF mono!
      text_top&=SUCC(item_height&*2)
    ENDIF
    linea_text_setup(text_colour&,text_style&,0,text_top&,font_current%)
  ENDIF
RETURN
' Draws work_text$ at x = ix& with its top at y = y_or_j& (the font top offset text_top& is subtracted).
PROCEDURE txt_draw(ix&,y_or_j&,work_text$)
  txt_blit(ix&,y_or_j&-text_top&,work_text$)
RETURN
' Sets writing mode mode_param& (1 replace, 2 transparent, 3 XOR, 4 reverse transparent).
' linea_wrmode& gets the Line-A WRT_MODE (0-3); GRAPHMODE is only set when the GEM pointer is in use.
' wrmode_flag& is set but never read.
PROCEDURE wrmode_set(mode_param&)
  wrmode_flag&=-(mode_param&<>0)
  linea_wrmode&=mode_param&-1
  IF NOT own_pointer!
    GRAPHMODE mode_param&
  ENDIF
RETURN
' Fills the Line-A TEXTBLT variables from font header font_ptr%.
' text_fg& = text colour, text_effects& = style, text_rotation& = CHUP rotation; unused_param& is not used.
' Offsets in the Line-A block: 36 WRT_MODE, 66 DDA_INC, 68 T_SCLSTS, 70 MONO_STATUS,
' 84 FBASE, 88 FWIDTH, 90 STYLE, 92 LITEMASK, 94 SKEWMASK, 96 WEIGHT, 98 R_OFF, 100 L_OFF,
' 102 SCALE, 104 CHUP, 106 TEXT_FG, 108 SCRTCHP (work buffer scratch_addr%), 112 SCRPT2, 114 TEXT_BG.
PROCEDURE linea_text_setup(text_fg&,text_effects&,text_rotation&,unused_param&,font_ptr%)
  LOCAL base_ptr%
  base_ptr%=L~A
  CARD{base_ptr%+66}=-1
  CARD{base_ptr%+68}=1
  CARD{base_ptr%+102}=0
  CARD{base_ptr%+36}=linea_wrmode&
  CARD{base_ptr%+90}=text_effects&
  CARD{base_ptr%+104}=text_rotation&
  CARD{base_ptr%+106}=text_fg&
  CARD{base_ptr%+114}=0
  CARD{base_ptr%+70}=1
  ' Font header: 76 data, 80 form width, 62 lighten, 64 skew, 58 thicken, 56/54 right/left offset.
  LONG{base_ptr%+84}=LONG{font_ptr%+76}
  CARD{base_ptr%+88}=INT{font_ptr%+80}
  CARD{base_ptr%+92}=INT{font_ptr%+62}
  CARD{base_ptr%+94}=INT{font_ptr%+64}
  CARD{base_ptr%+96}=INT{font_ptr%+58}
  CARD{base_ptr%+98}=INT{font_ptr%+56}
  CARD{base_ptr%+100}=INT{font_ptr%+54}
  LONG{base_ptr%+108}=scratch_addr%
  CARD{base_ptr%+112}=64
RETURN
' Draws work_text$ at x = blit_x&, y = blit_y& one character at a time with Line-A TEXTBLT ($A008).
' The font header font_current% gives the offset table (72), first character (36) and form height (82).
PROCEDURE txt_blit(blit_x&,blit_y&,work_text$)
  LOCAL ix&,y_or_j&,linea_call%,linea_code%,base_ptr%,src_pos%,font_ptr%
  linea_code%=-1610068363  !$A008 $4E75: Line-A TextBlt, RTS
  linea_call%=V:linea_code%
  base_ptr%=L~A
  font_ptr%=font_current%
  src_pos%=LONG{font_ptr%+72}
  CARD{base_ptr%+36}=linea_wrmode&
  FOR ix&=0 TO LEN(work_text$)-1
    y_or_j&=BYTE{ix&+V:work_text$}-INT{font_ptr%+36}
    ' SOURCEX = character's offset in the font form, DELX = its width, DELY = form height.
    CARD{base_ptr%+72}=INT{src_pos%+y_or_j&*2}
    CARD{base_ptr%+74}=0
    CARD{base_ptr%+76}=blit_x&
    CARD{base_ptr%+78}=blit_y&
    CARD{base_ptr%+80}=INT{src_pos%+y_or_j&*2+2}-INT{src_pos%+y_or_j&*2}
    CARD{base_ptr%+82}=INT{font_ptr%+82}
    blit_x&=blit_x&+INT{base_ptr%+80}
    ~C:linea_call%()
  NEXT ix&
RETURN
' Holds the 2778-byte machine-code play/record routine (player_code%); its parameter block is set by
' sample_run_range and sample_run_list.
PROCEDURE player_code_setup
  INLINE player_code%,2778
RETURN
' Plays (or records, player_mode& + 128) one range through the player routine player_code% in supervisor mode.
' player_mode& = device (1 = STE DMA), seg_table% = table, start_pos%..stop_pos% = range,
' loop_from%..loop_to% = loop range, loop_on! = loop on, rate_code& = rate code (mfp_timer_a&).
' Player block: +4 mode, +6 segment list (here the one entry at +10: table, start, end, 0),
' +26/+30 loop start/end, +34 loop flag, +36 rate code, +38 cartridge sampler address.
' work_ptr% is not LOCAL here, so the caller's or the global work_ptr% is overwritten.
PROCEDURE sample_run_range(player_mode&,seg_table%,start_pos%,stop_pos%,loop_from%,loop_to%,loop_on!,rate_code&)
  ' STE DMA output: run the DMA set-up routine first (XBIOS 38 Supexec).
  IF output_device&=1
    ~XBIOS(38,L:asm_microwire%)
  ENDIF
  CARD{player_code%+4}=player_mode&
  LONG{player_code%+6}=player_code%+10
  LONG{player_code%+10}=seg_table%
  LONG{player_code%+14}=start_pos%
  LONG{player_code%+18}=stop_pos%
  LONG{player_code%+22}=0
  LONG{player_code%+26}=loop_from%
  LONG{player_code%+30}=loop_to%
  CARD{player_code%+34}=loop_on!
  CARD{player_code%+36}=rate_code&
  LONG{player_code%+38}=cart_input%
  ' Stop mouse packets and hide the pointer while the routine runs.
  pointer_freeze
  pointer_show
  ' Run the player routine in supervisor mode (XBIOS 38 Supexec).
  ~XBIOS(38,L:player_code%)
  VSYNC
  OUT& 4,136  !IKBD $88: mouse mode status inquiry
  pointer_show
  VSYNC
  ' Wait for the buttons to be released, give the mouse back and flush the keyboard.
  REPEAT
  UNTIL @pointer_buttons=0
  pointer_normal
  WHILE BIOS(1,2)
    ~INP(2)
  WEND
  pointer_show
  ' The 200 Hz clock stops while the routine runs: move the shareware nag time nag_deadline% back by
  ' the time played (bytes played / rate * 200).
  work_ptr%=LONG{player_code%+14}-start_pos%
  work_ptr%=work_ptr%/sample_rate&*200
  SUB nag_deadline%,work_ptr%
RETURN
' Plays a list of ranges through the player routine player_code% (see sample_run_range).
' list_ptr% = list of 12-byte entries (table, start, end) ending with a 0 long.
' loop_from%..loop_to% = loop range, loop_on! = loop on, rate_code& = rate code.
PROCEDURE sample_run_list(player_mode&,list_ptr%,loop_from%,loop_to%,loop_on!,rate_code&)
  LOCAL work_ptr%
  IF output_device&=1
    ~XBIOS(38,L:asm_microwire%)
  ENDIF
  CARD{player_code%+4}=player_mode&
  LONG{player_code%+6}=list_ptr%
  LONG{player_code%+26}=loop_from%
  LONG{player_code%+30}=loop_to%
  CARD{player_code%+34}=loop_on!
  CARD{player_code%+36}=rate_code&
  LONG{player_code%+38}=cart_input%
  pointer_freeze
  pointer_show
  ' Run the player (XBIOS 38 Supexec), then wait for buttons up and flush the keyboard.
  ~XBIOS(38,L:player_code%)
  VSYNC
  OUT 4,136
  pointer_show
  VSYNC
  REPEAT
  UNTIL @pointer_buttons=0
  pointer_normal
  WHILE BIOS(1,2)
    ~INP(2)
  WEND
  pointer_show
  ' Add up the list's lengths and move the shareware nag time nag_deadline% back by the time played.
  work_ptr%=0
  WHILE LONG{list_ptr%}
    work_ptr%=work_ptr%+LONG{list_ptr%+8}-LONG{list_ptr%+4}
    list_ptr%=list_ptr%+12
  WEND
  work_ptr%=work_ptr%/sample_rate&*200
  SUB nag_deadline%,work_ptr%
RETURN
' Turns the key click off: clears bit 0 of conterm ($484).
PROCEDURE keyclick_off
  conterm_tmp|=PEEK(1156)
  SPOKE 1156,conterm_tmp| AND -2
RETURN
' Turns the key click on: sets bit 0 of conterm ($484).
' The setting from before keyclick_off is not restored: the click is always switched on.
PROCEDURE keyclick_on
  conterm_tmp|=PEEK(1156)
  SPOKE 1156,conterm_tmp| OR 1
RETURN
' One step of the help tour player.  SoundLab.HLP entries are scripts of word commands at
' scratch_addr%+128 that move the pointer, click, drag dialogs and show text boxes; tour_ptr% reads them.
' Called through pointer_state while tour_active! is set; runs a step every 3 ticks of the 200 Hz clock.
' Uses dialog_id&, origin_x&, origin_y& and obj_end% of the dialog loop dialog_run that is running.
' Commands: 0 glide to x,y and set buttons; 1 drag the dialog to x,y; 2 flash the pointer;
' 3 wait n seconds; 4 text box; 5 end (chain to help entry n if n >= 0); 6 drag a dialog back;
' 7 click an object; 8 glide to an object; 128/129 redraw the bottom panel graphics.
PROCEDURE tour_step
  LOCAL work_text$,work_ptr%,pix_width&,ix&,y_or_j&,counter&,obj_clicked%,object_x&,object_y&
  ~@keys_pending
  IF tour_next_tick%<=TIMER
    tour_next_tick%=TIMER+3
    ' Read the real pointer state (buttons only: the packet handler writes to a dummy position).
    tour_active!=FALSE
    pointer_state(sim_mouse_x&,sim_mouse_y&,sim_mouse_k&)
    tour_active!=TRUE
    ' Right button, or a key between commands: abort.  The script is rewritten as one
    ' "drag back" (6) per dialog the tour has moved, then "end" (5) with no chained entry.
    IF sim_mouse_k&=2 OR tour_key_hit! AND tour_abortable! AND tour_state&=0
      tour_box_remove
      tour_ptr%=128+scratch_addr%
      WHILE tour_moved_trees$<>""
        CARD{tour_ptr%}=6
        ADD tour_ptr%,2
        tour_moved_trees$=MID$(tour_moved_trees$,5)
      WEND
      CARD{tour_ptr%}=5
      CARD{tour_ptr%+2}=-1
      tour_abortable!=FALSE
      tour_ptr%=128+scratch_addr%
      sim_mouse_k&=0
    ENDIF
    ' tour_state& state: 0 read the next command, 1 drag, 3 wait, 4 flash, 5 glide, 6 glide then drag.
    SELECT tour_state&
    CASE 0
      ' Read the next command word.
      tour_cmd&=INT{tour_ptr%}
      ADD tour_ptr%,2
      SELECT tour_cmd&
      CASE 0
        ' Command 0: x, y, buttons after the glide.  The y in all coordinates is doubled in high res.
        tour_state&=5
        tour_target_x&=INT{tour_ptr%}
        tour_target_y&=INT{tour_ptr%+2}
        IF mono!
          MUL tour_target_y&,2
        ENDIF
        tour_buttons&=INT{tour_ptr%+4}
        ADD tour_ptr%,6
        tour_move_setup
      CASE 1
        ' Command 1: save the dialog position on tour_moved_trees$, glide to its top-left corner, then drag it
        ' with the left button held to the script position.
        tour_state&=6
        tour_moved_trees$=MKI$(origin_x&)+MKI$(origin_y&)+tour_moved_trees$
        tour_drag_x&=INT{tour_ptr%}+6
        tour_drag_y&=INT{tour_ptr%+2}+4
        IF mono!
          MUL tour_drag_y&,2
        ENDIF
        ADD tour_ptr%,4
        tour_target_x&=origin_x&+6
        tour_target_y&=origin_y&+4-mono!*4
        tour_buttons&=0
        tour_move_setup
      CASE 2
        ' Command 2: flash the pointer 5 times.
        tour_state&=4
        tour_steps_left&=5
        tour_wait_until%=TIMER
      CASE 3
        ' Command 3: wait n seconds (a click ends it early).
        tour_wait_until%=TIMER+MUL(INT{tour_ptr%},200)
        ADD tour_ptr%,2
        tour_state&=3
      CASE 4
        ' Command 4: text box at x, y, width, then the text (length, characters).
        tour_box_remove
        tour_box_x&=INT{tour_ptr%}
        tour_box_y&=INT{tour_ptr%+2}
        IF mono!
          MUL tour_box_y&,2
        ENDIF
        tour_box_w&=INT{tour_ptr%+4}
        tour_text_len&=INT{tour_ptr%+6}
        ' Word wrap: lines are stored as C strings at scratch_addr%+8192, counter& counts them.
        work_text$=SPACE$(tour_text_len&)
        BMOVE tour_ptr%+8,V:work_text$,tour_text_len&
        tour_ptr%=tour_ptr%+(tour_text_len&+8)
        work_text$=work_text$+" "
        work_ptr%=8192+scratch_addr%
        tour_box_w&=tour_box_w&+-14
        k&=0
        pix_width&=0
        ix&=0
        y_or_j&=0
        counter&=0
        WHILE ix&<tour_text_len&
          ' Add the character's width; past the box width, end the line at the last word end y_or_j&
          ' and skip the spaces after it.
          ADD pix_width&,@pixel_width_of(font_main%,CHR$(BYTE{ix&+V:work_text$}))
          IF pix_width&>tour_box_w&
            SUB pix_width&,@pixel_width_of(font_main%,MID$(work_text$,SUCC(k&),y_or_j&-k&+1))
            BMOVE k&+V:work_text$,work_ptr%,y_or_j&-k&+1
            work_ptr%=work_ptr%+(y_or_j&-k&+2)
            BYTE{work_ptr%-1}=0
            k&=y_or_j&+1
            WHILE BYTE{k&+V:work_text$}=32 AND k&<tour_text_len&
              INC k&
              SUB pix_width&,8
            WEND
            INC counter&
          ENDIF
          ' Remember the end of each word.
          IF BYTE{ix&+V:work_text$}<>32 AND BYTE{ix&+V:work_text$+1}=32
            y_or_j&=ix&
          ENDIF
          INC ix&
        WEND
        ' Store the last line.
        IF k&<tour_text_len&
          BMOVE k&+V:work_text$,work_ptr%,y_or_j&-k&+1
          INC counter&
          BYTE{work_ptr%+y_or_j&-k&+1}=0
        ENDIF
        pointer_hide
        tour_box_w&=tour_box_w&+13
        ' Box height: 20 pixels a line in high res (grey fill), 10 in colour (solid fill).
        IF mono!
          tour_box_h&=11+MUL(counter&,20)
          obj_clicked%=-1431677611
          pix_width&=1
        ELSE
          tour_box_h&=MUL(counter&,10)+5
          obj_clicked%=-1
          pix_width&=2
        ENDIF
        ' Save the screen under the box and its shadow, then draw the box, frame and shadow.
        GET tour_box_x&,tour_box_y&,tour_box_x&+tour_box_w&+shadow_dx&,tour_box_y&+tour_box_h&+shadow_dy&,tour_box_bg$
        ARECT tour_box_x&,tour_box_y&,tour_box_x&+tour_box_w&,tour_box_y&+tour_box_h&,1,0,V:obj_clicked%,1
        ALINE tour_box_x&,SUCC(tour_box_y&),tour_box_x&,tour_box_y&+tour_box_h&-1,0,-1,0
        HLINE tour_box_x&,tour_box_y&,tour_box_x&+tour_box_w&-1,0,0,V:pattern_solid%,1
        ALINE tour_box_x&+tour_box_w&,tour_box_y&,tour_box_x&+tour_box_w&,tour_box_y&+tour_box_h&-1,pix_width&,-1,0
        HLINE SUCC(tour_box_x&),tour_box_y&+tour_box_h&,tour_box_x&+tour_box_w&,pix_width&,0,V:pattern_solid%,1
        ARECT tour_box_x&+4,tour_box_y&+tour_box_h&+1,tour_box_x&+tour_box_w&+4,tour_box_y&+tour_box_h&+shadow_dy&,3,0,V:pattern_solid%,1
        ARECT tour_box_x&+tour_box_w&+1,tour_box_y&+shadow_dy&,tour_box_x&+tour_box_w&+4,tour_box_y&+tour_box_h&,3,0,V:pattern_solid%,1
        tour_box_w&=tour_box_x&
        tour_box_h&=tour_box_y&
        ADD tour_box_w&,5
        IF mono!
          tour_box_h&=tour_box_h&+19
        ELSE
          tour_box_h&=tour_box_h&+9
        ENDIF
        work_ptr%=8192+scratch_addr%
        ' Font 3; every line is drawn twice, the offset copy first as a shadow.
        font_attr_set(0,0,0,0,3)
        FOR ix&=1 TO counter&
          work_text$=CHAR{work_ptr%}
          work_ptr%=work_ptr%+SUCC(LEN(work_text$))
          font_attr_set(1,0,0,6,0)
          txt_draw(tour_box_w&+4,tour_box_h&+shadow_dy&,work_text$)
          font_attr_set(0,0,0,6,0)
          txt_draw(tour_box_w&,tour_box_h&,work_text$)
          tour_box_h&=tour_box_h&+10
          IF mono!
            tour_box_h&=tour_box_h&+10
          ENDIF
        NEXT ix&
        pointer_show
      CASE 5
        ' Command 5: end of script, then start help entry n if n >= 0.
        tour_buttons&=0
        tour_stop
        IF INT{tour_ptr%}>=0
          help_page_play(INT{tour_ptr%})
        ENDIF
      CASE 6
        ' Command 6: drag a dialog back to the position popped from tour_moved_trees$.
        tour_state&=6
        tour_drag_x&=INT{V:tour_moved_trees$}+6
        tour_drag_y&=INT{V:tour_moved_trees$+2}+4-mono!*4
        tour_moved_trees$=MID$(tour_moved_trees$,5)
        tour_target_x&=origin_x&+6
        tour_target_y&=origin_y&+4-mono!*4
        tour_buttons&=0
        tour_move_setup
      CASE 7,8
        ' Commands 7 and 8: glide to near the bottom-right corner of object n of the current dialog;
        ' 7 then clicks it (glide-then-drag to the same place), 8 only glides.
        k&=INT{tour_ptr%}
        ADD tour_ptr%,2
        obj_find(dialog_id&,k&,work_ptr%)
        IF work_ptr%<obj_end%
          obj_abs_pos(dialog_id&,k&,origin_x&,origin_y&,object_x&,object_y&)
          tour_target_x&=object_x&-INT{work_ptr%+8}+INT{work_ptr%+16}-5
          tour_target_y&=object_y&-INT{work_ptr%+10}+INT{work_ptr%+18}-3
          tour_buttons&=0
          IF tour_cmd&=8
            tour_state&=5
          ELSE
            tour_state&=6
            tour_drag_x&=tour_target_x&
            tour_drag_y&=tour_target_y&
          ENDIF
          tour_move_setup
        ENDIF
      CASE 128
        ' Command 128: redraw the bottom panel graphics from panel_image_alt%.
        buttons_buffer_mode
      CASE 129
        ' Command 129: redraw the bottom panel graphics from panel_image%.
        buttons_normal_mode
      ENDSELECT
    CASE 1,5,6
      ' Gliding: a real click jumps straight to the target.
      IF sim_mouse_k& AND tour_steps_left&>0 AND tour_steps_left&<tour_steps_total&
        tour_steps_left&=0
        CARD{pointer_vbl_code%+24}=tour_target_x&
        CARD{pointer_vbl_code%+26}=tour_target_y&
        sim_mouse_x&=tour_target_x&
        sim_mouse_y&=tour_target_y&
        VSYNC
      ENDIF
      ' Glide finished: 5 is done, 1 and 6 go on to their second phase.
      IF tour_steps_left&=0
        SELECT tour_state&
        CASE 1
          tour_steps_left&=-1
        CASE 5
          tour_state&=0
        CASE 6
          tour_steps_left&=-1
        ENDSELECT
      ELSE
        ' Second phase: 6 starts the drag with the left button held, 1 releases the button.
        IF tour_steps_left&<0
          IF tour_state&=6
            tour_state&=1
            tour_target_x&=tour_drag_x&
            tour_target_y&=tour_drag_y&
            tour_buttons&=1
            tour_move_setup
          ELSE
            tour_buttons&=0
            tour_state&=0
          ENDIF
        ELSE
          ' First frame of a glide only waits.
          IF tour_steps_left&>=tour_steps_total&
            DEC tour_steps_left&
          ELSE
            ' Move one step and update the own pointer's position (VBL routine +24/+26).
            tour_pos_x=tour_pos_x+tour_step_x
            tour_pos_y=tour_pos_y+tour_step_y
            sim_mouse_x&=tour_pos_x
            sim_mouse_y&=tour_pos_y
            CARD{pointer_vbl_code%+24}=sim_mouse_x&
            CARD{pointer_vbl_code%+26}=sim_mouse_y&
            VSYNC
            DEC tour_steps_left&
          ENDIF
        ENDIF
      ENDIF
    CASE 3
      ' Waiting: while the real button is held, wait for its release and end the wait.
      IF sim_mouse_k&
        tour_wait_until%=TIMER
        tour_active!=FALSE
        REPEAT
          pointer_state(sim_mouse_x&,sim_mouse_y&,sim_mouse_k&)
        UNTIL sim_mouse_k&<>1
        tour_active!=TRUE
      ENDIF
      IF tour_wait_until%<=TIMER
        tour_state&=0
        tour_box_remove
      ENDIF
    CASE 4
      ' Flashing: a click ends it.  The pointer shows for 0.4 s and hides for 0.4 s.
      IF sim_mouse_k&
        tour_state&=0
        pointer_show
      ELSE
        IF TIMER-tour_wait_until%>160
          tour_wait_until%=TIMER
          pointer_show
          DEC tour_steps_left&
          IF tour_steps_left&=0
            tour_state&=0
          ENDIF
        ELSE
          IF TIMER-tour_wait_until%>80
            pointer_hide
          ENDIF
        ENDIF
      ENDIF
    ENDSELECT
    sim_mouse_k&=tour_buttons&  !the buttons the tour reports for this step
  ENDIF
RETURN
' Restores the screen under the tour text box from tour_box_bg$ and frees it.
PROCEDURE tour_box_remove
  IF tour_box_bg$<>""
    pointer_hide
    image_blit(tour_box_x&,tour_box_y&,V:tour_box_bg$)
    pointer_show
    tour_box_bg$=""
  ENDIF
RETURN
' Sets up a glide of the tour pointer from sim_mouse_x&,sim_mouse_y& to tour_target_x&,tour_target_y&.
' The number of frames tour_steps_total& is the distance / 3 + 1, plus one waiting frame.
PROCEDURE tour_move_setup
  tour_pos_x=sim_mouse_x&
  tour_pos_y=sim_mouse_y&
  tour_steps_total&=INT(SQR(MUL(sim_mouse_x&-tour_target_x&,sim_mouse_x&-tour_target_x&)+MUL(sim_mouse_y&-tour_target_y&,sim_mouse_y&-tour_target_y&))/3)+1
  tour_step_x=(tour_target_x&-sim_mouse_x&)/tour_steps_total&
  tour_step_y=(tour_target_y&-sim_mouse_y&)/tour_steps_total&
  tour_steps_left&=tour_steps_total&+1
  INC tour_steps_total&
RETURN
' Ends the help tour: removes the text box, waits for the buttons to be released and points the
' mouse packet handler back at the pointer position.  If the own pointer was only borrowed for
' the tour (removable_mouse!), mousevec and the VBL slot are restored and the GEM pointer comes back.
PROCEDURE tour_stop
  tour_box_remove
  tour_active!=FALSE
  REPEAT
  UNTIL @pointer_buttons=0
  LONG{asm_mouse_packet%+10}=pointer_vbl_code%+24
  IF removable_mouse!
    pointer_hide
    SLPOKE vec_mouse_addr%,saved_mousevec%
    SLPOKE vbl_slot%,0
    own_pointer!=FALSE
    SHOWM
  ENDIF
  help_allowed!=TRUE
RETURN
' Returns Bconstat for the console (BIOS 1, device 2).
' During a tour it returns 0 and eats the keys; the Help key (226) also eats the next byte,
' any other key sets tour_key_hit! to abort the tour.
FUNCTION keys_pending
  $F%
  LOCAL key_inp&
  IF tour_active!
    WHILE BIOS(1,2)
      key_inp&=INP(2)
      IF key_inp&=226
        ~INP(2)
      ELSE
        tour_key_hit!=TRUE
      ENDIF
    WEND
    RETURN 0
  ELSE
    RETURN BIOS(1,2)
  ENDIF
ENDFUNC
' Hides the pointer.  Own pointer: stops the VBL routine drawing it and puts back the 16 lines
' of screen it saved (+8 address, +28 saved data; 80-byte lines in high res, 160 in medium res),
' only inside the screen.  +156 = -1 forces a redraw when shown again.  GEM: HIDEM.
' Both reset the Line-A clip to the whole screen.
PROCEDURE pointer_hide
  LOCAL ix&,kept_addr%,screen_limit%,bg_buf_ptr%
  IF own_pointer!
    LONG{pointer_vbl_code%+12}=0
    kept_addr%=LONG{pointer_vbl_code%+8}
    LONG{pointer_vbl_code%+8}=0
    IF kept_addr%
      screen_limit%=screen_addr%+32000
      bg_buf_ptr%=pointer_vbl_code%+28
      IF mono!
        FOR ix&=0 TO 15
          IF kept_addr%>=screen_addr% AND kept_addr%<screen_limit%
            LONG{kept_addr%}=LONG{bg_buf_ptr%}
          ENDIF
          kept_addr%=kept_addr%+80
          ADD bg_buf_ptr%,4
        NEXT ix&
      ELSE
        FOR ix&=0 TO 15
          IF kept_addr%>=screen_addr% AND kept_addr%<screen_limit%
            LONG{kept_addr%}=LONG{bg_buf_ptr%}
          ENDIF
          ADD kept_addr%,4
          ADD bg_buf_ptr%,4
          IF kept_addr%>=screen_addr% AND kept_addr%<screen_limit%
            LONG{kept_addr%}=LONG{bg_buf_ptr%}
          ENDIF
          kept_addr%=kept_addr%+156
          ADD bg_buf_ptr%,4
        NEXT ix&
      ENDIF
    ENDIF
    LONG{pointer_vbl_code%+156}=-1
  ELSE
    HIDEM
  ENDIF
  ACLIP 1,0,0,screen_max_x&,screen_max_y&
RETURN
' Shows the pointer.  Own pointer: gives the VBL routine the form data and mask and forces a
' redraw.  GEM: SHOWM.  Both reset the Line-A clip to the whole screen.
PROCEDURE pointer_show
  IF own_pointer!
    LONG{pointer_vbl_code%+12}=pointer_data%
    LONG{pointer_vbl_code%+16}=pointer_mask%
    LONG{pointer_vbl_code%+156}=-1
  ELSE
    SHOWM
  ENDIF
  ACLIP 1,0,0,screen_max_x&,screen_max_y&
RETURN
' Sets the pointer form: busy& = 0 arrow, other = busy bee.
' Own pointer: picks the MFORM mask (+10) and data (+42) and the hot spot (0,0 or 7,7); the
' visible pointer changes at once only if it is shown.  GEM: DEFMOUSE.
PROCEDURE pointer_busy(busy&)
  IF own_pointer!
    IF busy&=0
      pointer_mask%=arrow_form%+10
      pointer_data%=arrow_form%+42
      CARD{pointer_vbl_code%+20}=0
      CARD{pointer_vbl_code%+22}=0
    ELSE
      pointer_mask%=mform_busy%+10
      pointer_data%=mform_busy%+42
      CARD{pointer_vbl_code%+20}=7
      CARD{pointer_vbl_code%+22}=7
    ENDIF
    IF LONG{pointer_vbl_code%+12}<>0
      LONG{pointer_vbl_code%+12}=pointer_data%
      LONG{pointer_vbl_code%+16}=pointer_mask%
    ENDIF
  ELSE
    IF busy&=0
      DEFMOUSE 0
    ELSE
      DEFMOUSE mform_busy_str$
    ENDIF
    OUT 4,136  !IKBD $88: mouse mode status inquiry
  ENDIF
RETURN
' Returns pointer x, y and buttons in ix&, y_or_j&, k&.
' During a tour it runs a tour step and returns the simulated values.
' Own pointer: position from the VBL routine, buttons from the packet handler (bits 0 and 1
' swapped to GEM order).  Otherwise MOUSE.
PROCEDURE pointer_state(VAR ix&,y_or_j&,k&)
  IF tour_active!
    tour_step
    ix&=sim_mouse_x&
    y_or_j&=sim_mouse_y&
    k&=sim_mouse_k&
  ELSE
    IF own_pointer!
      ix&=INT{pointer_vbl_code%+24}
      y_or_j&=INT{pointer_vbl_code%+26}
      k&=BYTE{asm_mouse_packet%+8} AND 3
      IF k&=1 OR k&=2
        k&=3-k&
      ENDIF
    ELSE
      MOUSE ix&,y_or_j&,k&
    ENDIF
  ENDIF
RETURN
' Returns the pointer x (tour, own pointer or MOUSEX).
FUNCTION pointer_x
  $F%
  IF tour_active!
    pointer_state(sim_mouse_x&,sim_mouse_y&,sim_mouse_k&)
    RETURN sim_mouse_x&
  ELSE
    IF own_pointer!
      RETURN INT{pointer_vbl_code%+24}
    ELSE
      RETURN MOUSEX
    ENDIF
  ENDIF
ENDFUNC
' Returns the pointer y (tour, own pointer or MOUSEY).
FUNCTION pointer_y
  $F%
  IF tour_active!
    pointer_state(sim_mouse_x&,sim_mouse_y&,sim_mouse_k&)
    RETURN sim_mouse_y&
  ELSE
    IF own_pointer!
      RETURN INT{pointer_vbl_code%+26}
    ELSE
      RETURN MOUSEY
    ENDIF
  ENDIF
ENDFUNC
' Returns the pointer buttons (tour, own pointer with bits swapped to GEM order, or MOUSEK).
FUNCTION pointer_buttons
  $F%
  LOCAL k&
  IF tour_active!
    pointer_state(sim_mouse_x&,sim_mouse_y&,sim_mouse_k&)
    RETURN sim_mouse_k&
  ELSE
    IF own_pointer!
      k&=BYTE{asm_mouse_packet%+8} AND 3
      IF k&=1 OR k&=2
        k&=3-k&
      ENDIF
      RETURN k&
    ELSE
      RETURN MOUSEK
    ENDIF
  ENDIF
ENDFUNC
' Desk menu.  mnu_path$ holds the rest of the menu path: item 1 is the submenu
' (1 Sound Lab info, 2 Shareware, 3 Thanks); any other item is Accessories.
PROCEDURE desk_menu
  menu_choice&=@path_number_pop(mnu_path$)
  IF menu_choice&=1
    menu_choice&=@path_number_pop(mnu_path$)
    ON menu_choice& GOSUB info_screen,shareware_dialog,thanks_dialog
  ELSE
    accessories_menu
  ENDIF
RETURN
' Desk > Sound Lab: the title picture screen, also shown at start-up (info_at_startup! set).
' The picture is kept after the end of sample memory (sample_base%+memory_top%, 34-byte header first).
' With Alternate held (Kbshift bit 3) the picture's 20800 bytes are given to sample memory instead.
' The screen stays up until a key or click, or a timeout (short when a file is on the command line).
PROCEDURE info_screen
  LOCAL white_pal$,ix&,num_val&,y_or_j&,work_text$,counter&,flag_state!,work_ptr%
  flag_state!=(command_file$<>"")
  title_freed!=FALSE
  ' Alternate not held: show the picture.
  IF (BTST(BIOS(11,-1),3))=FALSE
    ' High res: dissolve the picture onto the screen below the menu with dissolve_code%.
    IF mono!
      picture_ptr%=sample_base%+memory_top%
      pointer_hide
      FOR ix&=0 TO 128 STEP 16
        VSYNC
        ~C:dissolve_code%(L:picture_ptr%+34,L:screen_addr%+3840,L:dissolve_masks%+ix&,L:16+(dissolve_masks%+ix&),L:5177472)
      NEXT ix&
      ' Timeout: 2 s with a command-line file, 1 hour otherwise.
      IF flag_state!
        work_ptr%=400+TIMER
      ELSE
        work_ptr%=720000+TIMER
      ENDIF
      REPEAT
      UNTIL BIOS(1,2) OR @pointer_buttons OR work_ptr%<TIMER
      IF BIOS(1,2)
        ~INP(2)
      ENDIF
      REPEAT
      UNTIL @pointer_buttons=0
      ' Wipe the picture with vertical lines 17 columns apart (17 and 640 share no factor, so all
      ' 640 columns are hit), then redraw the waveform and the block bar.
      num_val&=0
      FOR ix&=0 TO 639
        ALINE num_val&,48,num_val&,307,0,-1,0
        num_val&=(num_val&+17) MOD 640
      NEXT ix&
      overview_bar_draw
      trace_draw
      pointer_show
    ELSE
      ' Colour: the picture is low res, shown above the medium-res panel by the Timer B raster split.
      pointer_hide
      ACLIP 1,0,0,639,screen_max_y&
      ARECT 0,24,639,153,0,0,V:pattern_solid%,1
      picture_ptr%=sample_base%+memory_top%
      ' Fade palettes from white to the picture's palette; the split gets fade step 0 for the top
      ' and palette$ for the panel below.
      white_pal$=STRING$(16,MKI$(1911))
      palette_fade_build(title_palette$,white_pal$)
      BMOVE V:fade_palettes$(0),raster_code%+6,32
      BMOVE V:palette$,raster_code%+38,8
      pointer_freeze
      ' At start-up the picture is already on screen at full colour: start at fade step 7.
      IF info_at_startup!
        num_val&=7
      ELSE
        num_val&=1
      ENDIF
      ' Timeout in frames: 2.4 s with a command-line file, 7.2 minutes otherwise (at 50 Hz).
      IF flag_state!
        work_ptr%=120
      ELSE
        work_ptr%=21600
      ENDIF
      keyclick_off
      WHILE BIOS(1,2)
        ~INP(2)
      WEND
      ' Install the raster split (mode 1, XBIOS 38).  +54 is its line counter: below 5 at the top of
      ' a frame, above 160 after the split, so each wait pair below is one frame.
      CARD{raster_code%+54}=200
      VSYNC
      VSYNC
      CARD{raster_code%+4}=1
      ~XBIOS(38,L:raster_code%)
      REPEAT
      UNTIL INT{raster_code%+54}<5
      REPEAT
      UNTIL INT{raster_code%+54}>160
      ' Copy the picture data (129 lines of 160 bytes) to screen line 24.
      IF info_at_startup!=FALSE
        BMOVE picture_ptr%+34,3840+XBIOS(3),20640
      ENDIF
      ' Fade in, one step every 2 frames.
      FOR ix&=num_val& TO 7
        REPEAT
        UNTIL INT{raster_code%+54}<5
        BMOVE V:fade_palettes$(ix&),raster_code%+6,32
        REPEAT
        UNTIL INT{raster_code%+54}>160
        REPEAT
        UNTIL INT{raster_code%+54}<5
        REPEAT
        UNTIL INT{raster_code%+54}>160
      NEXT ix&
      ' At start-up the picture is dissolved again with the second table set.
      IF info_at_startup!
        FOR ix&=0 TO 128 STEP 16
          ~C:dissolve_code%(L:picture_ptr%+34,L:screen_addr%+3840,L:dissolve_out_tab%+ix&,L:16+(dissolve_out_tab%+ix&),L:5177472)
        NEXT ix&
      ENDIF
      ' Wait for a key, a click or the timeout, counting frames.
      REPEAT
        REPEAT
        UNTIL INT{raster_code%+54}>160
        REPEAT
        UNTIL INT{raster_code%+54}<5
        DEC work_ptr%
      UNTIL BIOS(1,2) OR @pointer_buttons OR work_ptr%<=0
      WHILE BIOS(1,2)
        ~INP(2)
      WEND
      REPEAT
      UNTIL @pointer_buttons=0
      ' Fade out to white, clear the area and remove the raster split (mode 2).
      FOR ix&=6 DOWNTO 0
        REPEAT
        UNTIL INT{raster_code%+54}<5
        BMOVE V:fade_palettes$(ix&),raster_code%+6,32
        REPEAT
        UNTIL INT{raster_code%+54}>160
      NEXT ix&
      ARECT 0,24,639,153,0,0,V:pattern_solid%,1
      REPEAT
      UNTIL INT{raster_code%+54}<5
      CARD{raster_code%+4}=2
      ~XBIOS(38,L:raster_code%)
      pointer_normal
      keyclick_on
      HLINE 0,152,639,0,0,V:pattern_solid%,1
      overview_bar_draw
      trace_draw
      pointer_show
    ENDIF
  ELSE
    ' Alternate held: at start-up in colour the raster split is removed.
    IF info_at_startup! AND mono!=FALSE
      CARD{raster_code%+4}=2
      ~XBIOS(38,L:raster_code%)
    ENDIF
    ' Free the picture: move the free tail of sample memory up 20800 bytes and fill the gap
    ' with 128 (silence), then grow the memory size (and the sample if it filled memory).
    IF buffer_start%<memory_top%
      BMOVE sample_base%+buffer_start%,sample_base%+buffer_start%+20800,memory_top%-buffer_start%
    ENDIF
    ~C:code_fill%(L:sample_base%+buffer_start%,L:20800,128)
    IF info_at_startup! OR sample_end%=memory_top%
      sample_end%=sample_end%+20800
      block_end%=block_end%+20800
      sample_loop_end%=sample_loop_end%+20800
    ENDIF
    memory_top%=memory_top%+20800
    buffer_start%=buffer_start%+20800
    sample_length_update
    pointer_show
    ' Desk > Sound Lab is disabled: the picture is gone.
    mnu_item_disable("1 1 1")
    title_freed!=TRUE
  ENDIF
RETURN
' Desk > Shareware: shows dialog 27.
PROCEDURE shareware_dialog
  dialog_run(27,choice&)
RETURN
' Desk > Thanks: shows dialog 28.
PROCEDURE thanks_dialog
  dialog_run(28,choice&)
RETURN
' Desk > Accessories: shows a real GEM menu bar (Desk with the accessories and "Done with ACCs")
' on a cleared screen so desk accessories can run.  Any menu choice ends the loop; then the
' whole Sound Lab screen is redrawn without zoom effects, and zoom boxes open and close it.
PROCEDURE accessories_menu
  LOCAL saved_flag!
  zoom_box_anim(zoom_x1&,zoom_y1&,zoom_x2&,zoom_y2&,0,0,screen_max_x&,screen_max_y&)
  MENU acc_menu$()
  ~FORM_DIAL(3,0,0,0,0,0,0,1280,960)  !FMD_FINISH: send redraws for the whole screen
  ON MENU GOSUB acc_menu_done
  acc_loop_done!=FALSE
  REPEAT
    ON MENU
  UNTIL acc_loop_done!
  ' Redraw the background, the main panel (tree 4), waveform and the status fields.
  saved_flag!=zoom_enabled!
  zoom_enabled!=FALSE
  screen_frame_draw
  dialog_draw(4)
  trace_draw
  status_name_draw
  status_block_draw
  memory_size_draw
  status_zoom_draw
  overview_bar_draw
  zoom_enabled!=saved_flag!
  zoom_box_anim(0,0,screen_max_x&,screen_max_y&,zoom_x1&,zoom_y1&,zoom_x2&,zoom_y2&)
RETURN
' ON MENU handler for the accessory menu bar: removes the bar and ends the loop.
PROCEDURE acc_menu_done
  MENU OFF
  MENU KILL
  acc_loop_done!=TRUE
RETURN
' File/Disk menu: 1 Rename File, 2 Delete File(s), 4 Create Folder, 5 Remove Folder,
' 7 Free Space (drive submenu), 8 Format Disk, 10 Quit; 3, 6 and 9 are separators.
PROCEDURE filedisk_menu
  menu_choice&=@path_number_pop(mnu_path$)
  ON menu_choice& GOSUB cmd_rename_file,cmd_delete_files,menu_nop,cmd_create_folder,cmd_remove_folder,menu_nop,cmd_free_space,cmd_format_disk,menu_nop,program_quit
RETURN
' File/Disk > Rename File.  The file is picked with the selector, then dialog 18 shows the
' old name (object 5) and an editable new name (object 3), both in 8.3 form.
' GEMDOS 86 Frename renames it; errors offer Retry.
PROCEDURE cmd_rename_file
  LOCAL folder_path$,chosen_file$,obj_found%,cursor_top&,cursor_bottom&,work_text$
  folder_path$=disk_path$
  filesel_title_set("Rename which file?")
  chosen_file$=""
  filesel_run("*.*",folder_path$,chosen_file$,ok_flag!)
  IF ok_flag!<>FALSE
    ' REPEAT ... UNTIL TRUE: EXIT IF skips the rest when cancelled or nothing changed.
    REPEAT
      EXIT IF chosen_file$=""
      fname_pad_83(chosen_file$)
      obj_find(18,3,obj_found%)
      BMOVE V:chosen_file$,16+(rsc_data%+LONG{obj_found%+24}),12
      obj_find(18,5,obj_found%)
      BMOVE V:chosen_file$,12+(rsc_data%+LONG{obj_found%+24}),12
      ' Objects are drawn without the usual extra 2 pixels above and below.
      cursor_top&=0
      cursor_bottom&=0
      dialog_run(18,choice&)
      EXIT IF choice&=2  !Cancel
      obj_text_query(18,3,work_text$)
      strip_spaces(work_text$)
      EXIT IF work_text$=chosen_file$
      EXIT IF work_text$=""
      chosen_file$=folder_path$+chosen_file$
      work_text$=folder_path$+work_text$
      pointer_hide
      pointer_busy(1)
      pointer_show
      REPEAT
        gem_error&=GEMDOS(86,0,L:V:chosen_file$,L:V:work_text$)  !Frename
        IF gem_error&<0
          dos_error_alert(gem_error&)
        ELSE
          filesel_listed$=""  !the selector must read the folder again
        ENDIF
      UNTIL gem_error&<>-999
    UNTIL TRUE
  ENDIF
  disk_path$=folder_path$
  pointer_hide
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' File/Disk > Delete File(s).  Repeats until the selector is cancelled: the chosen name (wildcards
' allowed) is confirmed by alert 22, then every matching file is deleted with GEMDOS 65 Fdelete.
' work_text$ is not LOCAL here, so the caller's string is used.
PROCEDURE cmd_delete_files
  LOCAL folder_path$,chosen_file$,obj_found%,gem_error&
  folder_path$=disk_path$
  filesel_title_set("Delete which file(s)?")
  DO
    chosen_file$=""
    filesel_run("*.*",folder_path$,chosen_file$,ok_flag!)
    EXIT IF ok_flag!=FALSE
    EXIT IF chosen_file$=""
    ' Shorten the path for the alert: CHR$(4) marks cut text until it is under 168 pixels wide.
    work_text$=RIGHT$(folder_path$+chosen_file$,32)
    IF @pixel_width_of(font_main%,work_text$)>=168
      MID$(work_text$,1,1)=(CHR$(4))
      WHILE @pixel_width_of(font_main%,work_text$)>=168
        work_text$=CHR$(4)+MID$(work_text$,3)
      WEND
    ENDIF
    choice&=@msgbox_show(22,"[1][Delete file(s):|"+work_text$+"|(No recovery!)][ Okay |   Cancel   ]")
    IF choice&=1
      pointer_hide
      pointer_busy(1)
      pointer_show
      ' Fgetdta, then Fsfirst/Fsnext (GEMDOS 78/79) over the matches.
      obj_found%=GEMDOS(47)
      gem_error&=FSFIRST(folder_path$+chosen_file$,-1)
      WHILE gem_error&>=0
        work_text$=folder_path$+CHAR{30+obj_found%}+CHR$(0)
        ' Skip folders and volume labels (attributes $10 and $08).
        IF (BYTE{obj_found%+21} AND 24)=0
          REPEAT
            gem_error&=GEMDOS(65,L:V:work_text$)
            IF gem_error&<0
              dos_error_alert(gem_error&)
            ENDIF
          UNTIL gem_error&<>-999
        ENDIF
        gem_error&=GEMDOS(79)
      WEND
      filesel_listed$=""
      pointer_hide
      pointer_busy(0)
      pointer_show
    ENDIF
  LOOP
  disk_path$=folder_path$
RETURN
' File/Disk > Create Folder: the name typed in the selector is created with GEMDOS 57 Dcreate.
' Bug: disk_path$ keeps the new folder's name and a NUL, so the next File/Disk selector starts with
' that string as its path.
PROCEDURE cmd_create_folder
  LOCAL folder_path$,chosen_file$
  folder_path$=disk_path$
  filesel_title_set("Create folder...")
  chosen_file$=""
  filesel_run("*.*",folder_path$,chosen_file$,ok_flag!)
  IF ok_flag!<>FALSE
    ' REPEAT ... UNTIL TRUE: EXIT IF skips the rest when no name was typed.
    REPEAT
      EXIT IF chosen_file$=""
      folder_path$=folder_path$+chosen_file$+CHR$(0)
      pointer_hide
      pointer_busy(1)
      pointer_show
      REPEAT
        gem_error&=GEMDOS(57,L:V:folder_path$)
        IF gem_error&<0
          dos_error_alert(gem_error&)
        ELSE
          filesel_listed$=""
        ENDIF
      UNTIL gem_error&<>-999
    UNTIL TRUE
  ENDIF
  disk_path$=folder_path$
  pointer_hide
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' File/Disk > Remove Folder: the user opens the folder in the selector (no file name) and it is
' deleted with GEMDOS 58 Ddelete.  Remembered paths inside it are cut back to the parent.
PROCEDURE cmd_remove_folder
  LOCAL folder_path$,chosen_file$,alert_line1$,alert_line2$,obj_found%
  folder_path$=disk_path$
  filesel_title_set("Remove which folder?")
  chosen_file$=""
  filesel_run("*.*",folder_path$,chosen_file$,ok_flag!)
  IF ok_flag!<>FALSE
    ' REPEAT ... UNTIL TRUE: EXIT IF skips the rest when a file name was given.
    REPEAT
      EXIT IF chosen_file$<>""
      folder_path$=folder_path$+CHR$(0)
      pointer_hide
      pointer_busy(1)
      pointer_show
      REPEAT
        gem_error&=GEMDOS(58,L:V:folder_path$)
        IF gem_error&<0
          ' Access denied: the folder is not empty.  Dialog 25 ("Diskette is full") is reused with
          ' its two text lines patched, shown, and patched back.
          IF gem_error&=-36
            alert_line1$="That folder is not empty."
            alert_line2$="  Please empty it. "
            obj_find(25,4,obj_found%)
            BMOVE V:alert_line1$,12+(rsc_data%+LONG{obj_found%+24}),25
            obj_find(25,5,obj_found%)
            BMOVE V:alert_line2$,12+(rsc_data%+LONG{obj_found%+24}),19
            pointer_hide
            pointer_busy(0)
            pointer_show
            dialog_run(25,choice&)
            alert_line1$="Diskette is full.  Please"
            alert_line2$="try another disk..."
            obj_find(25,4,obj_found%)
            BMOVE V:alert_line1$,12+(rsc_data%+LONG{obj_found%+24}),25
            obj_find(25,5,obj_found%)
            BMOVE V:alert_line2$,12+(rsc_data%+LONG{obj_found%+24}),19
          ELSE
            dos_error_alert(gem_error&)
          ENDIF
        ELSE
          ' Cut the sample, echo and selector drive paths back to the parent folder.
          IF (selector_folder$+CHR$(0))=folder_path$
            selector_folder$=LEFT$(selector_folder$,RINSTR(selector_folder$,"\",LEN(selector_folder$)-1))
          ENDIF
          IF (echo_path$+CHR$(0))=folder_path$
            echo_path$=LEFT$(echo_path$,RINSTR(echo_path$,"\",LEN(echo_path$)-1))
          ENDIF
          IF (drive_paths$(filesel_drive&)+CHR$(0))=folder_path$
            drive_paths$(filesel_drive&)=LEFT$(drive_paths$(filesel_drive&),RINSTR(drive_paths$(filesel_drive&),"\",LEN(drive_paths$(filesel_drive&))-1))
          ENDIF
          folder_path$=LEFT$(folder_path$,RINSTR(folder_path$,"\",LEN(folder_path$)-1))
          filesel_listed$=""
        ENDIF
      UNTIL gem_error&<>-999
    UNTIL TRUE
  ENDIF
  disk_path$=folder_path$
  pointer_hide
  pointer_busy(0)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' File/Disk > Free Space > drive: counts the free bytes with disk_free_space and shows them.
PROCEDURE cmd_free_space
  LOCAL obj_found%
  pointer_hide
  pointer_busy(1)
  pointer_show
  menu_choice&=@path_number_pop(mnu_path$)
  disk_free_space(menu_choice&-1,scratch_addr%,byte_count%)
  work_text$="Drive "+CHR$(menu_choice&+64)+": has "+@thousands_commas$(byte_count%)
  work_text$=work_text$+" | bytes ("+@thousands_commas$(byte_count% DIV 1024)+"K) free."
  pointer_hide
  pointer_busy(0)
  pointer_show
  choice&=@msgbox_show(23,"[1][ "+work_text$+" ][    It does, does it?    ]")
RETURN
' File/Disk > Format Disk.  Dialog 24 picks the drive (radio group 1) and the sides (group 2).
' Formats 80 tracks of 10 sectors with XBIOS 10 Flopfmt (track 79 down to 0), then writes an
' own boot sector with XBIOS 9 Flopwr: 800K double sided or 400K single sided.
PROCEDURE cmd_format_disk
  LOCAL obj_found%,gem_error&,ix&,double_sided&,drive_no&,virgin_word&
  dialog_run(24,choice&)
  radio_find_selected(24,1,obj_found%)
  drive_no&=INT{obj_found%}-2
  radio_find_selected(24,2,obj_found%)
  double_sided&=INT{obj_found%}-4
  ' Drive B only if _nflops ($4A6) is 2.
  IF choice&=1 AND (drive_no&=0 OR DPEEK(1190)=2)
    choice&=@msgbox_show(29,"[1][ Format disk? | This will erase all of | the files on the disk! ][ Okay |   Cancel   ]")
    IF choice&=1
      pointer_hide
      pointer_busy(1)
      pointer_show
      FOR ix&=79 DOWNTO 0
        ' A key or click asks whether to stop.
        IF BIOS(1,2) OR @pointer_buttons
          pointer_busy(0)
          gem_error&=@msgbox_show(55,"[1][ Stop format now? ][    Yes!!!    | No ]")
          pointer_hide
          pointer_busy(1)
          pointer_show
          gem_error&=2-gem_error&
        ENDIF
        EXIT IF gem_error&
        ' Track 0 is filled with 0 so the FAT and root directory start empty; the rest with $E5E5.
        IF ix&=0
          virgin_word&=0
        ELSE
          virgin_word&=-6683
        ENDIF
        REPEAT
          ' Flopfmt side 0: 10 sectors, interleave 1, magic $87654321.
          gem_error&=XBIOS(10,L:scratch_addr%,L:0,drive_no&,10,ix&,L:1,L:-2023406815,virgin_word&)
          IF gem_error&
            dos_error_alert(gem_error&)
          ENDIF
        UNTIL gem_error&<>-999
        EXIT IF gem_error&
        ' Double sided: format side 1 too.
        IF double_sided&
          REPEAT
            gem_error&=XBIOS(10,L:scratch_addr%,L:0,drive_no&,10,ix&,L:65537,L:-2023406815,virgin_word&)
            IF gem_error&
              dos_error_alert(gem_error&)
            ENDIF
          UNTIL gem_error&<>-999
        ENDIF
        EXIT IF gem_error&
      NEXT ix&
      IF gem_error&=0
        ' Build the boot sector: serial number from XBIOS 17 Random, 512 bytes/sector, 2 sectors/cluster,
        ' 1 reserved sector, 2 FATs, 112 root entries, 1600 sectors, media $FE, 5 sectors/FAT,
        ' 10 sectors/track, 2 sides (800, 1 side when single sided).
        ~C:code_fill%(L:scratch_addr%,L:512,0)
        CHAR{scratch_addr%+4}="dmjþ"
        LONG{scratch_addr%+8}=SHL(XBIOS(17),8)
        BYTE{scratch_addr%+12}=2
        BYTE{scratch_addr%+13}=2
        BYTE{scratch_addr%+14}=1
        BYTE{scratch_addr%+16}=2
        BYTE{scratch_addr%+17}=112
        BYTE{scratch_addr%+19}=64
        BYTE{scratch_addr%+20}=6
        BYTE{scratch_addr%+21}=-2
        BYTE{scratch_addr%+22}=5
        BYTE{scratch_addr%+24}=10
        BYTE{scratch_addr%+26}=2
        IF double_sided&=0
          BYTE{scratch_addr%+19}=32
          BYTE{scratch_addr%+20}=3
          BYTE{scratch_addr%+26}=1
        ENDIF
        ' The message names version 1.0, although the program is 1.1.
        CHAR{scratch_addr%+60}="This disk formatted from Sound Lab 1.0, "+TIME$+", "+DATE$+"."
        REPEAT
          ' Flopwr sector 1, track 0, side 0, 1 sector.  Then force a media change.
          gem_error&=XBIOS(9,L:scratch_addr%,L:0,drive_no&,L:65536,L:1)
          IF gem_error&
            dos_error_alert(gem_error&)
          ENDIF
        UNTIL gem_error&<>-999
        IF gem_error&=0
          media_change_force(drive_no&)
        ENDIF
      ENDIF
      pointer_hide
      pointer_busy(0)
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
    ENDIF
  ELSE
    IF choice&=1
      ~@msgbox_show(54,"[1][ You don't have | a drive B. ][   Oh, yeah...   ]")
    ENDIF
  ENDIF
RETURN
' Empty: the File/Disk menu separators lead here.
PROCEDURE menu_nop
RETURN
' Sets up the resource pointers from the loaded SOUNDLAB.COL/.MON data at addr%
' (long 0 = tree data size, long 4 = object data size, data from offset 8), then the GUI defaults.
' rsc_data_end% is set but never read.
PROCEDURE rsc_init(addr%)
  tree_first%=addr%+8
  rsc_data%=tree_first%+LONG{addr%}
  rsc_data_end%=rsc_data%+LONG{addr%+4}
  tree_end%=rsc_data%
  screen_metrics_init
  ' 20-byte point buffer.
  INLINE poly_points%,20
  ' Fill patterns: solid, $AAAA5555 grey, $55557FFF.
  pattern_solid%=-1
  pattern_grey%=-1431677611
  pattern_light%=1431699455
  DIM blit_params%(22)
  cursor_top&=-2
  cursor_bottom&=2
  dlgs_ready!=TRUE
  help_allowed!=TRUE
  zoom_enabled!=TRUE
  tour_active!=FALSE
  ' The first zoom box starts from the screen centre.
  zoom_x1&=screen_max_x& DIV 2
  zoom_y1&=screen_max_y& DIV 2
  zoom_x2&=zoom_x1&+1
  zoom_y2&=zoom_y1&+1
RETURN
' Sets the resolution-dependent sizes used by the dialog code from XBIOS(4) Getrez.
' shadow_dx&/shadow_dy& are the shadow offsets, screen_max_x&/screen_max_y& the screen limits, blit_nxwd& the bytes between
' words of one plane, screen_planes& the plane count, screen_line_bytes& the bytes per line (Line-A BITBLT values) and
' dialog_text_dy& the extra text offset of the 8x16 font in high resolution.
PROCEDURE screen_metrics_init
  cur_rez&=XBIOS(4)  !Getrez: 0 low, 1 medium, 2 high
  ' Low resolution: 320x200, 4 planes, 160 bytes per line
  shadow_dx&=2
  shadow_dy&=2
  screen_max_x&=319
  screen_max_y&=199
  blit_nxwd&=8
  screen_planes&=4
  screen_line_bytes&=160
  dialog_text_dy&=0
  ' Medium and high: 640 wide, 2 planes
  IF cur_rez&>0
    shadow_dx&=4
    screen_max_x&=639
    blit_nxwd&=4
    screen_planes&=2
  ENDIF
  ' High resolution: 640x400 monochrome, 1 plane, 80 bytes per line, 16-pixel font
  IF cur_rez&=2
    shadow_dy&=4
    screen_max_y&=399
    blit_nxwd&=2
    screen_planes&=1
    screen_line_bytes&=80
    dialog_text_dy&=8
  ENDIF
RETURN
' Builds vdi_to_hw_colour&(), the map from a VDI pen number to the hardware colour register it uses
' (pen 1 is register 15, pen 2 register 1, and so on). Used to pick the colour of the edit cursor.
PROCEDURE vdi_colour_map_init
  DIM vdi_to_hw_colour&(15)
  vdi_to_hw_colour&(0)=0
  vdi_to_hw_colour&(1)=15
  vdi_to_hw_colour&(2)=1
  vdi_to_hw_colour&(3)=2
  vdi_to_hw_colour&(4)=4
  vdi_to_hw_colour&(5)=6
  vdi_to_hw_colour&(6)=3
  vdi_to_hw_colour&(7)=5
  vdi_to_hw_colour&(8)=7
  vdi_to_hw_colour&(9)=8
  vdi_to_hw_colour&(10)=9
  vdi_to_hw_colour&(11)=10
  vdi_to_hw_colour&(12)=12
  vdi_to_hw_colour&(13)=14
  vdi_to_hw_colour&(14)=11
  vdi_to_hw_colour&(15)=13
RETURN
' Runs dialog dialog_id& from the resource until an exit object is chosen; result_value& returns that object's
' exit value. Dialog records (from tree_first% to tree_end%): INT +0 id, +2 record length, +4..+14 frame,
' then 28-byte objects from +20: INT +0 id, byte +3 type (1 toggle, 2 radio, 3 button, 4 exit,
' 5 edit field, 6 slider arrow, 7/8 h/v slider, 10 move bar, 128+ line/box/image/text, drawn only),
' byte +4 action (see object_action_call), byte +5 flags (low nibble border style, bit 4 touch exit),
' INT +6 parent id, +8..+18 rectangle, LONG +24 offset of the object's data from rsc_data%.
' Button data: LONG +0 normal image, +4 selected image, INT +8 state or exit value, +10 key or group.
' Dialog 4 is the main screen, which also brings in the start-up picture and intro.
PROCEDURE dialog_run(dialog_id&,VAR result_value&)
  LOCAL y_centre&,origin_x&,origin_y&,dialog_done!,click_x&,click_y&,click_buttons&,button_previous&,click_outside!,dialog_background$,cursor_pos&,edit_object&,work_ptr%,obj_ptr%,obj_end%,scan_ptr%,saved_bg$,cursor_in_ext!,background_x&,background_y&,obj_scan%,edit_mouse_x&,edit_mouse_y&,saved_zoom_x1&,saved_zoom_x2&,saved_zoom_y1&,saved_zoom_y2&,active_dialog&
  ' Keep the zoom-box rectangle of the caller; it is put back on exit
  saved_zoom_x1&=zoom_x1&
  saved_zoom_y1&=zoom_y1&
  saved_zoom_x2&=zoom_x2&
  saved_zoom_y2&=zoom_y2&
  active_dialog&=dialog_id&
  edit_object&=-1
  edit_mouse_x&=-1
  edit_mouse_y&=-1
  tree_find(dialog_id&,obj_ptr%)  !find the dialog record
  ' Only when the dialog exists in the resource
  IF obj_ptr%<tree_end%
    dialog_draw(dialog_id&)  !save background and draw the dialog
    ' Main screen start-up: show both screens as XBIOS(5) Setscreen, then wipe the picture in 16 mask
    ' steps with the INLINE wipe (Alternate held skips the wipe and copies it at once)
    IF dialog_id&=4
      ~XBIOS(5,L:screen_addr%,L:screen_addr%,-1)
      IF (BTST(BIOS(11,-1),3))=FALSE
        pointer_hide
        FOR ix&=0 TO 128 STEP 16
          VSYNC
          ~C:dissolve_code%(L:screen_back%,L:screen_addr%,L:dissolve_masks%+ix&,L:16+(dissolve_masks%+ix&),L:5177543)
        NEXT ix&
      ELSE
        BMOVE screen_back%,screen_addr%,32000
      ENDIF
      ~C:code_fill%(L:screen_back%,L:32000,128)  !fill the picture buffer with $80 bytes
      ' BIOS(1,3) Bconstat MIDI: while MIDI bytes come in, ask for the MIDI equipment to be switched off
      ' and empty the MIDI input with BIOS(2,3) Bconin
      WHILE BIOS(1,3)
        choice&=@msgbox_show(36,"[1][ Please disconnect or shut | off your MIDI equipment. ][     All right...     ]")
        WHILE BIOS(1,3)
          ~BIOS(2,3)
        WEND
        PAUSE 100
      WEND
      ' Start-up intro runs with info_at_startup! set
      info_at_startup!=TRUE
      info_screen
      info_at_startup!=FALSE
      pointer_show
      ' A sample named on the command line that exists is loaded now, with the Load button (object 20)
      ' drawn pressed while it loads
      IF (command_file$<>"") AND @fexists(command_file$)
        obj_find(4,20,obj_found%)
        obj_draw_selected(obj_found%+8,0,0,BYTE{obj_found%+5},0)
        sample_loader
        obj_find(4,20,obj_found%)
        obj_draw_normal(obj_found%+8,0,0,BYTE{obj_found%+5},0)
      ENDIF
    ENDIF
    ACLIP 1,0,0,screen_max_x&,screen_max_y&
    obj_end%=obj_ptr%+INT{obj_ptr%+2}  !end of this dialog's objects
    ' Dialog origin, rounded up to an even position
    origin_x&=INT{obj_ptr%+4}
    origin_y&=INT{obj_ptr%+6}
    origin_x&=origin_x&+(ODD(origin_x&))
    origin_y&=origin_y&+(ODD(origin_y&))
    dialog_done!=FALSE
    click_buttons&=0
    ' Main dialog loop: read the mouse, run any pending edit-field action, then handle clicks and keys
    REPEAT
      button_previous&=click_buttons&
      pointer_state(click_x&,click_y&,click_buttons&)
      edit_action_flush(1)
      IF dialog_id&=4
        ' Repeats the info dialog 27 every nag_interval% ticks (5 minutes at first, 10% shorter each time) when
        ' no demo runs. The program carries a hand patch here: tour_active! reads as TRUE in this test, so the
        ' IF never runs and the dialog never comes back.
        IF nag_deadline%<TIMER AND tour_active!=FALSE
          dialog_run(27,choice&)
          nag_interval%=nag_interval%*.900000000000002
          nag_deadline%=nag_interval%+TIMER
        ENDIF
        menubar_poll  !drop-down menu when the mouse is in the menu bar
      ENDIF
      ' A mouse button is down
      IF click_buttons&
        IF button_previous&=0
          y_centre&=0
        ENDIF
        ' Right button on the main screen shows the second set of command buttons while held
        IF button_previous&<>2 AND click_buttons&=2 AND dialog_id&=4
          buttons_buffer_mode
        ENDIF
        IF click_buttons&<>2 AND button_previous&=2 AND dialog_id&=4
          buttons_normal_mode
        ENDIF
        ' Inside the dialog frame: find the clickable object under the mouse and handle it
        IF @rect_hit(click_x&,click_y&,obj_ptr%+4)<>0
          click_outside!=FALSE
          obj_scan%=20+obj_ptr%
          WHILE obj_scan%<obj_end%
            EXIT IF @obj_hit(click_x&,click_y&,origin_x&,origin_y&,obj_scan%)<>0
            obj_scan%=obj_scan%+28
          WEND
          IF obj_scan%<obj_end%
            obj_rect_store(obj_scan%,origin_x&,origin_y&)
            dialog_object_click(obj_scan%,origin_x&,origin_y&)
          ENDIF
        ELSE
          ' Click outside the dialog: after 200 loop passes with the button held, ring the bell (OUT 2,7)
          click_outside!=TRUE
          INC y_centre&
          IF y_centre&>=200
            OUT 2,7
            pointer_show
          ENDIF
        ENDIF
      ELSE
        ' Button released
        IF button_previous&
          button_released!=TRUE
        ENDIF
        IF button_previous&=2 AND dialog_id&=4
          buttons_normal_mode
        ENDIF
        ' Short click outside the dialog: bell
        IF y_centre&>0 AND button_previous&>0 AND click_outside!
          OUT 2,7
          pointer_show
        ENDIF
      ENDIF
      ' A key is waiting: key_inp& is the key (INP(2) gives scan code + 128 for keys without ASCII),
      ' shift_state& the BIOS(11,-1) Kbshift state
      IF @keys_pending<>0
        key_inp&=INP(2)
        shift_state&=BIOS(11,-1)
        ' Find the object with this shortcut key: buttons and toggles keep it at data +10, radio buttons
        ' at data +14
        obj_scan%=20+obj_ptr%
        WHILE obj_scan%<obj_end%
          EXIT IF INT{obj_scan%+2}=4 OR INT{obj_scan%+2}=3 AND key_inp&=INT{rsc_data%+LONG{obj_scan%+24}+10}
          EXIT IF INT{obj_scan%+2}=1 AND key_inp&=INT{rsc_data%+LONG{obj_scan%+24}+10}
          EXIT IF INT{obj_scan%+2}=2 AND key_inp&=INT{rsc_data%+LONG{obj_scan%+24}+14}
          obj_scan%=obj_scan%+28
        WEND
        ' A shortcut key matched: handle the object as a click
        IF obj_scan%<obj_end%
          edit_action_flush(0)
          obj_rect_store(obj_scan%,origin_x&,origin_y&)
          ' Button: flash it, open its sub-dialog (data +8) if any, run its action, draw it normal
          IF INT{obj_scan%+2}=3
            obj_draw_selected(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}+4})
            PAUSE 5
            IF INT{rsc_data%+LONG{obj_scan%+24}+8}
              dialog_run(INT{rsc_data%+LONG{obj_scan%+24}+8},choice&)
            ENDIF
            IF BYTE{obj_scan%+4}
              object_action_call(BYTE{obj_scan%+4},dialog_id&,INT{obj_scan%},origin_x&,origin_y&)
            ENDIF
            obj_draw_normal(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}})
            IF dialog_id&=4 AND INT{obj_scan%}=1 AND block_played!  !main screen object 1 after playback: show the play position
              play_stop_cursor
            ENDIF
          ELSE
            ' Toggle: flip the state at data +8 and redraw
            IF INT{obj_scan%+2}=1
              button_state!=NOT INT{rsc_data%+LONG{obj_scan%+24}+8}
              IF button_state!
                obj_draw_selected(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}+4})
              ELSE
                obj_draw_normal(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}})
              ENDIF
              CARD{rsc_data%+LONG{obj_scan%+24}+8}=button_state!
              IF BYTE{obj_scan%+4}
                object_action_call(BYTE{obj_scan%+4},dialog_id&,INT{obj_scan%},origin_x&,origin_y&)
              ENDIF
            ELSE
              ' Radio button: select it if not selected and clear the rest of its group
              IF INT{obj_scan%+2}=2
                button_state!=INT{rsc_data%+LONG{obj_scan%+24}+8}
                IF button_state!=FALSE
                  obj_draw_selected(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}+4})
                  CARD{rsc_data%+LONG{obj_scan%+24}+8}=-1
                  radio_others_off(dialog_id&,INT{rsc_data%+LONG{obj_scan%+24}+10},origin_x&,origin_y&,obj_scan%)
                  IF BYTE{obj_scan%+4}
                    object_action_call(BYTE{obj_scan%+4},dialog_id&,INT{obj_scan%},origin_x&,origin_y&)
                  ENDIF
                ENDIF
              ELSE
                obj_draw_selected(obj_scan%+8,origin_x&,origin_y&,BYTE{obj_scan%+5},LONG{rsc_data%+LONG{obj_scan%+24}+4})
                PAUSE 5
                ' Exit object (drawn selected above): end the dialog with its exit value (data +8)
                dialog_done!=TRUE
                result_value&=INT{rsc_data%+LONG{obj_scan%+24}+8}
                IF BYTE{obj_scan%+4}
                  object_action_call(BYTE{obj_scan%+4},dialog_id&,INT{obj_scan%},origin_x&,origin_y&)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ELSE
          ' Help key ($62+128): show the help text of this dialog
          IF key_inp&=226
            edit_action_flush(0)
            IF help_allowed!
              help_page_play(dialog_id&)
            ENDIF
          ELSE
            ' Other keys go to the active edit field. Field data: INT +0 kind, +2 cursor colour, +4 font,
            ' +6 alignment, +8 text y offset, +14 length, text from +16 (blank filled)
            IF edit_object&>0
              obj_find(dialog_id&,edit_object&,obj_scan%)
              work_ptr%=rsc_data%+LONG{obj_scan%+24}
              edit_mouse_x&=click_x&
              edit_mouse_y&=click_y&
              ' Up arrow ($48+128): previous edit field; with Shift the first one
              ' Down arrow ($50+128): next edit field; with Shift the last one
              ' Left/right arrows (203/205) move the cursor, the right one not past the text end
              ' Esc clears the field, Backspace and Delete remove a character
              SELECT key_inp&
              CASE 200
                edit_action_flush(0)
                IF shift_state&
                  scan_ptr%=20+obj_ptr%
                  WHILE edit_object&<>INT{scan_ptr%} AND BYTE{scan_ptr%+3}<>5
                    scan_ptr%=scan_ptr%+28
                  WEND
                  IF edit_object&<>INT{scan_ptr%}
                    edit_object&=0
                    dialog_object_draw(obj_scan%,origin_x&,origin_y&,-1)
                    edit_object&=-1
                    obj_scan%=scan_ptr%
                  ENDIF
                ELSE
                  scan_ptr%=obj_scan%+-28
                  WHILE scan_ptr%>obj_ptr% AND BYTE{scan_ptr%+3}<>5
                    scan_ptr%=scan_ptr%+-28
                  WEND
                  IF scan_ptr%>obj_ptr%
                    edit_object&=0
                    dialog_object_draw(obj_scan%,origin_x&,origin_y&,-1)
                    edit_object&=-1
                    obj_scan%=scan_ptr%
                  ENDIF
                ENDIF
              CASE 208
                edit_action_flush(0)
                IF shift_state&
                  scan_ptr%=obj_end%+-28
                  WHILE edit_object&<>INT{scan_ptr%} AND BYTE{scan_ptr%+3}<>5
                    scan_ptr%=scan_ptr%+-28
                  WEND
                  IF edit_object&<>INT{scan_ptr%}
                    edit_object&=0
                    dialog_object_draw(obj_scan%,origin_x&,origin_y&,-1)
                    edit_object&=-1
                    obj_scan%=scan_ptr%
                  ENDIF
                ELSE
                  scan_ptr%=28+obj_scan%
                  WHILE scan_ptr%<obj_end% AND BYTE{scan_ptr%+3}<>5
                    scan_ptr%=scan_ptr%+28
                  WEND
                  IF scan_ptr%<obj_end%
                    edit_object&=0
                    dialog_object_draw(obj_scan%,origin_x&,origin_y&,-1)
                    edit_object&=-1
                    obj_scan%=scan_ptr%
                  ENDIF
                ENDIF
              CASE 203
                IF cursor_pos&>0
                  DEC cursor_pos&
                ENDIF
              CASE 205
                scan_ptr%=work_ptr%+16+cursor_pos&
                WHILE scan_ptr%<work_ptr%+16+INT{work_ptr%+14} AND BYTE{scan_ptr%}=32
                  INC scan_ptr%
                WEND
                IF scan_ptr%<work_ptr%+16+INT{work_ptr%+14}
                  INC cursor_pos&
                ENDIF
              CASE 27
                FOR scan_ptr%=16+work_ptr% TO PRED(work_ptr%+16+INT{work_ptr%+14})
                  BYTE{scan_ptr%}=32
                NEXT scan_ptr%
                cursor_pos&=0
              CASE 8
                IF INT{work_ptr%}=7 AND cursor_pos&=9 AND LONG{work_ptr%+24}=773857312  !filename field: cursor just after ". " ($2E202020) of an empty extension
                  INC cursor_pos&
                ENDIF
                IF cursor_pos&>0
                  fname_field_dot_remove(work_ptr%)
                  DEC cursor_pos&
                  IF cursor_pos&<PRED(INT{work_ptr%+14})
                    BMOVE work_ptr%+17+cursor_pos&,work_ptr%+16+cursor_pos&,PRED(INT{work_ptr%+14}-cursor_pos&)  !close the gap
                  ENDIF
                  BYTE{work_ptr%+15+INT{work_ptr%+14}}=32
                  fname_field_dot_insert(work_ptr%)
                ENDIF
                ' Filename field: shift the extension back so the dot stays at position 8
                IF INT{work_ptr%}=7 AND cursor_pos&<8
                  fname_field_dot_remove(work_ptr%)
                  BMOVE work_ptr%+23,work_ptr%+24,3
                  BYTE{work_ptr%+23}=32
                  fname_field_dot_insert(work_ptr%)
                ENDIF
              CASE 127
                fname_field_dot_remove(work_ptr%)
                IF cursor_pos&<PRED(INT{work_ptr%+14})
                  BMOVE work_ptr%+17+cursor_pos&,work_ptr%+16+cursor_pos&,PRED(INT{work_ptr%+14}-cursor_pos&)
                ENDIF
                BYTE{work_ptr%+15+INT{work_ptr%+14}}=32
                fname_field_dot_insert(work_ptr%)
                IF INT{work_ptr%}=7 AND cursor_pos&<9
                  fname_field_dot_remove(work_ptr%)
                  BMOVE work_ptr%+23,work_ptr%+24,3
                  BYTE{work_ptr%+23}=32
                  fname_field_dot_insert(work_ptr%)
                ENDIF
              CASE 9
              CASE 243
              CASE 244
              DEFAULT
                ' Printable key with room in the field: filter it by the field kind; a rejected key becomes 0
                IF cursor_pos&<INT{work_ptr%+14}
                  key_original&=key_inp&
                  SELECT INT{work_ptr%}
                    '
                  CASE 0
                  CASE 1
                    IF key_inp&<32  !kind 1: any character from space up
                      key_inp&=0
                    ENDIF
                  CASE 2
                    IF key_inp&<32 OR key_inp&>127  !kind 2: ASCII 32 to 127
                      key_inp&=0
                    ENDIF
                  CASE 3
                    IF NOT key_inp&=32 OR (key_inp&>64 AND key_inp&<91) OR (key_inp&>96 AND key_inp&<123) OR (key_inp&>47 AND key_inp&<58)  !kind 3: letters, digits, space
                      key_inp&=0
                    ENDIF
                  CASE 4
                    IF NOT key_inp&=32 OR (key_inp&>64 AND key_inp&<91) OR (key_inp&>96 AND key_inp&<123)  !kind 4: letters, space
                      key_inp&=0
                    ENDIF
                  CASE 5
                    IF key_inp&<46 OR key_inp&>57 OR key_inp&=47  !kind 5: decimal number (digits and point)
                      key_inp&=0
                    ENDIF
                  CASE 6
                    IF key_inp&<48 OR (key_inp&>57 AND key_inp&<65) OR key_inp&>70  !kind 6: hexadecimal digits
                      key_inp&=0
                    ENDIF
                  CASE 7
                    ' Kind 7: 8.3 filename in upper case; a typed dot moves what follows the cursor into the extension
                    ' and puts the cursor after the dot
                    IF key_inp&>96 AND key_inp&<123
                      key_inp&=key_inp&+-32
                    ENDIF
                    IF key_inp&=46
                      IF cursor_pos&<9
                        fname_field_dot_remove(work_ptr%)
                        IF BYTE{work_ptr%+16+cursor_pos&}<>32
                          LONG{work_ptr%+24}=538976288
                          BMOVE work_ptr%+16+cursor_pos&,work_ptr%+24,3
                          WHILE cursor_pos&<=7
                            BYTE{work_ptr%+16+cursor_pos&}=32
                            INC cursor_pos&
                          WEND
                        ENDIF
                        fname_field_dot_insert(work_ptr%)
                        cursor_pos&=9
                        BYTE{work_ptr%+24}=46
                      ENDIF
                      key_inp&=0
                    ELSE
                      IF INSTR("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789?*_",CHR$(key_inp&))=0  !name characters and wildcards
                        key_inp&=0
                      ENDIF
                    ENDIF
                  CASE 8
                    IF key_inp&>96 AND key_inp&<123
                      key_inp&=key_inp&+-32
                    ENDIF
                    IF INSTR("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789?*_.|",CHR$(key_inp&))=0  !kind 8: path or wildcard list in upper case
                      key_inp&=0
                    ENDIF
                  DEFAULT
                    ' Kind 9 and up: walks the resource string list to entry kind-9 (the list is not used further)
                    shift_state&=INT{work_ptr%}-9
                    scan_ptr%=rsc_data%
                    WHILE shift_state&>0
                      saved_bg$=CHAR{scan_ptr%}
                      scan_ptr%=scan_ptr%+SUCC(LEN(saved_bg$))
                      DEC shift_state&
                    WEND
                  ENDSELECT
                  ' Accepted key: insert it at the cursor, shifting the rest of the field right
                  IF key_inp&>0
                    IF INT{work_ptr%}=7
                      scan_ptr%=LONG{work_ptr%+24}
                      IF cursor_pos&=9
                        cursor_in_ext!=TRUE
                      ELSE
                        cursor_in_ext!=FALSE
                      ENDIF
                    ENDIF
                    fname_field_dot_remove(work_ptr%)
                    IF INT{work_ptr%}=7 AND cursor_pos&<9 AND cursor_in_ext!=FALSE  !filename: never leave a gap before the cursor
                      WHILE BYTE{work_ptr%+15+cursor_pos&}=32 AND cursor_pos&>0
                        DEC cursor_pos&
                      WEND
                    ENDIF
                    IF cursor_pos&<PRED(INT{work_ptr%+14})
                      BMOVE work_ptr%+16+cursor_pos&,work_ptr%+17+cursor_pos&,PRED(INT{work_ptr%+14}-cursor_pos&)
                    ENDIF
                    BYTE{work_ptr%+16+cursor_pos&}=key_inp&
                    INC cursor_pos&
                    fname_field_dot_insert(work_ptr%)
                    IF INT{work_ptr%}=7 AND cursor_pos&<9
                      LONG{work_ptr%+24}=scan_ptr%
                    ENDIF
                  ELSE
                    dialog_key_dispatch(key_original&)  !rejected key goes to the dialog's own key handler
                  ENDIF
                ELSE
                  dialog_key_dispatch(key_inp&)  !field full: key goes to the dialog's key handler
                ENDIF
              ENDSELECT
              ' Ctrl+left ($73+128) puts the cursor at the start, Ctrl+right ($74+128) after the last character
              SELECT key_inp&
              CASE 243
                cursor_pos&=0
              CASE 244
                cursor_pos&=INT{work_ptr%+14}
                WHILE BYTE{work_ptr%+15+cursor_pos&}=32 AND cursor_pos&>0
                  DEC cursor_pos&
                WEND
              ENDSELECT
              dialog_object_draw(obj_scan%,origin_x&,origin_y&,-1)  !redraw the field with its cursor
              pointer_show
            ELSE
              dialog_key_dispatch(key_inp&)  !no edit field: dialog key handler
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    UNTIL dialog_done!
    pointer_hide
    ' Put the saved background back and zoom the box in to the caller's rectangle
    IF dialog_background$<>""
      image_blit(background_x&,background_y&,V:dialog_background$)
      dialog_background$=""
      zoom_box_anim(INT{obj_ptr%+4},INT{obj_ptr%+6},INT{obj_ptr%+12},INT{obj_ptr%+14},saved_zoom_x1&,saved_zoom_y1&,saved_zoom_x2&,saved_zoom_y2&)
    ENDIF
    pointer_show
  ENDIF
  zoom_x1&=saved_zoom_x1&
  zoom_y1&=saved_zoom_y1&
  zoom_x2&=saved_zoom_x2&
  zoom_y2&=saved_zoom_y2&
RETURN
' Handles a mouse click on object obj_ptr% of dialog dialog_id& at dialog origin origin_x&,origin_y& (VAR: a
' move bar click changes them). Toggles, radio buttons, buttons and exit objects are tracked with
' button_track; arrows step their slider while held; sliders are dragged; type 10 moves the dialog.
' The object's action (byte +4) runs at the end unless the type already ran it.
PROCEDURE dialog_object_click(obj_ptr%,VAR origin_x&,origin_y&)
  LOCAL obj_draw_mode&,button_state!,object_x&,object_y&,work_ptr%,end_pointer%,parent_obj&,group_id&,click_x&,click_y&,click_buttons&,step_counter&,box_x1&,rect_y1&,box_x2&,rect_y2&,obj_clicked%,action_done!,slider_last&
  action_done!=FALSE
  object_x&=origin_x&
  object_y&=origin_y&
  obj_clicked%=obj_ptr%
  ' Add the offsets of all parents to get the object's screen origin object_x&,object_y&
  IF INT{obj_ptr%+6}
    work_ptr%=obj_ptr%
    DO
      parent_obj&=INT{obj_ptr%+6}
      EXIT IF parent_obj&=0
      obj_find(dialog_id&,parent_obj&,obj_ptr%)
      object_x&=object_x&+INT{obj_ptr%+8}
      object_y&=object_y&+INT{obj_ptr%+10}
    LOOP
    obj_ptr%=work_ptr%
  ENDIF
  obj_draw_mode&=BYTE{obj_ptr%+5} DIV 16 AND 1  !flags bit 4: touch exit, act on press without waiting for release
  SELECT BYTE{obj_ptr%+3}
    '
  CASE 0
  CASE 1
    ' Toggle: track the click and store the new state
    button_state!=INT{rsc_data%+LONG{obj_ptr%+24}+8}
    button_track(obj_ptr%,object_x&,object_y&,button_state!)
    CARD{rsc_data%+LONG{obj_ptr%+24}+8}=button_state!
  CASE 2
    ' Radio button: a second click on the same one within 50 ticks of the release is a double click
    ' and presses Return (KEYPRESS 13)
    button_state!=INT{rsc_data%+LONG{obj_ptr%+24}+8}
    IF button_released! AND dblclick_time%>TIMER AND dblclick_object&=INT{obj_ptr%}
      KEYPRESS 13
    ELSE
      dblclick_time%=50+TIMER
      dblclick_object&=INT{obj_ptr%}
      button_released!=FALSE
    ENDIF
    ' Track it when not selected yet, or when data +12 allows deselecting; then clear its group
    IF button_state!=FALSE OR INT{rsc_data%+LONG{obj_ptr%+24}+12}
      button_track(obj_ptr%,object_x&,object_y&,button_state!)
      CARD{rsc_data%+LONG{obj_ptr%+24}+8}=button_state!
      IF button_state!
        group_id&=INT{rsc_data%+LONG{obj_ptr%+24}+10}
        work_ptr%=obj_ptr%
        radio_others_off(dialog_id&,group_id&,origin_x&,origin_y&,work_ptr%)
      ENDIF
    ENDIF
  CASE 3
    ' Button: when released over it, open its sub-dialog (data +8), run its action and draw it normal
    button_state!=FALSE
    button_track(obj_ptr%,object_x&,object_y&,button_state!)
    IF button_state!
      IF INT{rsc_data%+LONG{obj_ptr%+24}+8}
        dialog_run(INT{rsc_data%+LONG{obj_ptr%+24}+8},choice&)
      ENDIF
      IF BYTE{obj_clicked%+4} AND action_done!=FALSE
        object_action_call(BYTE{obj_clicked%+4},dialog_id&,INT{obj_clicked%},origin_x&,origin_y&)
      ENDIF
      obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
      IF dialog_id&=4 AND INT{obj_ptr%}=1 AND block_played!  !main screen object 1 after playback: show the play position
        play_stop_cursor
      ENDIF
    ENDIF
    action_done!=TRUE
  CASE 4
    ' Exit object: released over it ends the dialog with data +8 as the result
    button_state!=FALSE
    button_track(obj_ptr%,object_x&,object_y&,button_state!)
    IF button_state!
      dialog_done!=TRUE
      result_value&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
    ELSE
      action_done!=TRUE
    ENDIF
  CASE 5
    ' Edit field: move the cursor to this field and redraw the old and new fields
    IF edit_object&<>INT{obj_ptr%}
      obj_find(dialog_id&,edit_object&,work_ptr%)
      edit_object&=0
      dialog_object_draw(work_ptr%,origin_x&,origin_y&,-1)
      edit_object&=-1
      dialog_object_draw(obj_ptr%,origin_x&,origin_y&,-1)
      pointer_show
    ENDIF
  CASE 6
    ' Slider arrow: data +8 is the slider object, data +10 the step added on each pass while held
    action_done!=TRUE
    button_state!=FALSE
    obj_find(dialog_id&,INT{rsc_data%+LONG{obj_ptr%+24}+8},end_pointer%)
    work_ptr%=rsc_data%+LONG{end_pointer%+24}
    step_counter&=INT{rsc_data%+LONG{obj_ptr%+24}+10}
    REPEAT
      pointer_state(click_x&,click_y&,click_buttons&)
      EXIT IF click_buttons&=0
      IF @rect_hit(click_x&-object_x&,click_y&-object_y&,obj_ptr%+8)<>0
        IF button_state!=FALSE
          button_state!=TRUE
          obj_draw_selected(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}+4})
        ENDIF
        ' Step only while the slider can still move that way; clamp to min and max-visible
        IF INT{work_ptr%+8}>INT{work_ptr%} AND step_counter&<0 OR (INT{work_ptr%+8}+INT{work_ptr%+10}<INT{work_ptr%+2} AND step_counter&>0)
          CARD{work_ptr%+8}=step_counter&+INT{work_ptr%+8}
          IF INT{work_ptr%+8}+INT{work_ptr%+10}>INT{work_ptr%+2}
            CARD{work_ptr%+8}=INT{work_ptr%+2}-INT{work_ptr%+10}
          ENDIF
          IF INT{work_ptr%+8}<INT{work_ptr%}
            CARD{work_ptr%+8}=INT{work_ptr%}
          ENDIF
          dialog_object_draw(end_pointer%,object_x&,object_y&,-1)
          IF BYTE{obj_clicked%+4}
            object_action_call(BYTE{obj_clicked%+4},dialog_id&,INT{obj_clicked%},origin_x&,origin_y&)
          ENDIF
          pointer_show
        ENDIF
      ELSE
        IF button_state!
          button_state!=FALSE
          obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
        ENDIF
      ENDIF
    UNTIL click_buttons&=0 OR button_state!=FALSE
    IF button_state!
      obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
    ENDIF
  CASE 7
    hslider_drag(obj_ptr%,object_x&,object_y&)  !horizontal slider
    action_done!=TRUE
  CASE 8
    vslider_drag(obj_ptr%,object_x&,object_y&)  !vertical slider
    action_done!=TRUE
  CASE 9
  CASE 10
    ' Move bar: drag an outline of the dialog frame over the screen, then redraw it at the new place
    tree_find(dialog_id&,work_ptr%)
    box_x1&=INT{work_ptr%+4}
    rect_y1&=INT{work_ptr%+6}
    box_x2&=INT{work_ptr%+12}
    rect_y2&=INT{work_ptr%+14}
    zoom_x1&=box_x1&
    zoom_y1&=rect_y1&
    zoom_x2&=box_x2&
    zoom_y2&=rect_y2&
    rect_drag(-1,0,0,0,screen_max_x&-shadow_dx&,screen_max_y&-shadow_dy&,box_x1&,rect_y1&,box_x2&,rect_y2&)
    ' Moved: store the new frame, restore the old background and draw the dialog again
    IF box_x1&<>origin_x& OR rect_y1&<>origin_y&
      box_x2&=box_x2&+box_x1&
      rect_y2&=rect_y2&+rect_y1&
      CARD{work_ptr%+4}=box_x1&
      CARD{work_ptr%+6}=rect_y1&
      CARD{work_ptr%+12}=box_x2&
      CARD{work_ptr%+14}=rect_y2&
      origin_x&=box_x1&
      origin_y&=rect_y1&
      origin_x&=origin_x&+(ODD(origin_x&))
      origin_y&=origin_y&+(ODD(origin_y&))
      pointer_hide
      image_blit(background_x&,background_y&,V:dialog_background$)
      dialog_background$=""
      dialog_draw(dialog_id&)
    ENDIF
  ENDSELECT
  IF BYTE{obj_clicked%+4} AND action_done!=FALSE
    object_action_call(BYTE{obj_clicked%+4},dialog_id&,INT{obj_clicked%},origin_x&,origin_y&)
  ENDIF
RETURN
' Tracks the mouse while the button is held over object obj_ptr% at origin object_x&,object_y&: the object
' is drawn selected while the mouse is over it and in its old state when not. flag_state! (VAR) holds
' the state on entry and returns the state when the button is released. With the touch-exit flag
' (obj_draw_mode& of the caller) it returns after one pass.
PROCEDURE button_track(obj_ptr%,object_x&,object_y&,VAR flag_state!)
  LOCAL button_state!
  button_state!=flag_state!
  REPEAT
    pointer_state(click_x&,click_y&,click_buttons&)
    IF @rect_hit(click_x&-object_x&,click_y&-object_y&,obj_ptr%+8)<>0
      IF flag_state!=FALSE AND button_state!=FALSE
        button_state!=TRUE
        obj_draw_selected(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}+4})
      ELSE
        IF flag_state! AND button_state!
          button_state!=FALSE
          obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
        ENDIF
      ENDIF
    ELSE
      IF flag_state!=FALSE AND button_state!
        button_state!=FALSE
        obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
      ELSE
        IF flag_state! AND button_state!=FALSE
          button_state!=TRUE
          obj_draw_selected(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}+4})
        ENDIF
      ENDIF
    ENDIF
  UNTIL obj_draw_mode& OR click_buttons&=0
  flag_state!=button_state!
RETURN
' Horizontal slider obj_ptr% at origin object_x&,object_y&. Slider data: INT +0 min, +2 max, +4 step
' left, +6 step right, +8 value, +10 visible size, +12 knob colour, +14 shadow colour (-1 none),
' +16 track colour. slider_thumb_h sets work_ptr% to the data and knob_start&..knob_end& to the knob pixels.
' The action routine runs whenever the value changes.
PROCEDURE hslider_drag(obj_ptr%,object_x&,object_y&)
  LOCAL aux&,num_val&,knob_start&,knob_end&,work_ptr%,button_state!,box_x1&,box_x2&,rect_y1&,rect_y2&
  slider_thumb_h(obj_ptr%)
  slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
  button_state!=FALSE
  REPEAT
    pointer_state(click_x&,click_y&,click_buttons&)
    EXIT IF click_buttons&=0
    SUB click_x&,object_x&
    SUB click_y&,object_y&
    IF @rect_hit(click_x&,click_y&,obj_ptr%+8)<>0
      ' Right button: centre the knob on the mouse at once, then wait for the release
      IF click_buttons&=2
        box_x2&=INT{obj_ptr%+16}-INT{obj_ptr%+8}
        knob_start&=ADD(INT{work_ptr%},(MUL(INT{work_ptr%+2}-INT{work_ptr%},click_x&-INT{obj_ptr%+8})+(box_x2& DIV 2)) DIV box_x2&)
        knob_start&=MAX(MIN(knob_start&-DIV(INT{work_ptr%+10},2),INT{work_ptr%+2}-INT{work_ptr%+10}),INT{work_ptr%})
        CARD{work_ptr%+8}=knob_start&
        dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
        slider_thumb_h(obj_ptr%)
        pointer_show
        IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
          slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
          IF BYTE{obj_ptr%+4}
            object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
          ENDIF
        ENDIF
        REPEAT
        UNTIL @pointer_buttons=0
      ELSE
        ' Left button left of the knob: step left (+4)
        button_state!=TRUE
        IF click_x&<knob_start&
          CARD{work_ptr%+8}=INT{work_ptr%+8}+INT{work_ptr%+4}
          IF INT{work_ptr%+8}<INT{work_ptr%}
            CARD{work_ptr%+8}=INT{work_ptr%}
          ENDIF
          dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
          slider_thumb_h(obj_ptr%)
          pointer_show
          IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
            slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
            IF BYTE{obj_ptr%+4}
              object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
            ENDIF
          ENDIF
        ELSE
          ' Right of the knob: step right (+6), clamped
          IF click_x&>knob_end&
            CARD{work_ptr%+8}=INT{work_ptr%+8}+INT{work_ptr%+6}
            IF INT{work_ptr%+8}+INT{work_ptr%+10}>INT{work_ptr%+2}
              CARD{work_ptr%+8}=INT{work_ptr%+2}-INT{work_ptr%+10}
            ENDIF
            IF INT{work_ptr%+8}<INT{work_ptr%}
              CARD{work_ptr%+8}=INT{work_ptr%}
            ENDIF
            dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
            slider_thumb_h(obj_ptr%)
            pointer_show
            IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
              slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
              IF BYTE{obj_ptr%+4}
                object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
              ENDIF
            ENDIF
          ELSE
            ' On the knob: clear the slot, drag the knob with rect_drag inside the track, then work out the
            ' new value from its position
            knob_colour&=INT{work_ptr%+12}
            colour_work&=INT{work_ptr%+16}
            box_x1&=knob_start&+object_x&
            rect_y1&=object_y&+INT{obj_ptr%+10}
            box_x2&=knob_end&+object_x&
            rect_y2&=object_y&+INT{obj_ptr%+18}
            pointer_hide
            ACLIP 1,0,0,639,screen_max_y&
            IF mono!
              ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_grey%,1
            ELSE
              IF INT{work_ptr%+14}=-1
                ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%+16},0,V:pattern_solid%,1
              ELSE
                ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_solid%,1
              ENDIF
            ENDIF
            pointer_show
            ACLIP 1,0,0,639,screen_max_y&
            IF (BYTE{obj_ptr%+5} AND 15)=2
              box_x1&=box_x1&+shadow_dx&
              rect_y1&=rect_y1&+shadow_dy&
              box_x2&=box_x2&+shadow_dx&
              rect_y2&=rect_y2&+shadow_dy&
              rect_drag(knob_colour&,colour_work&,object_x&+INT{obj_ptr%+8}+shadow_dx&,object_y&+INT{obj_ptr%+10}+shadow_dy&,object_x&+INT{obj_ptr%+16}+shadow_dx&,object_y&+INT{obj_ptr%+18}+shadow_dy&,box_x1&,rect_y1&,box_x2&,rect_y2&)
              SUB box_x1&,shadow_dx&
              SUB rect_y1&,shadow_dy&
              SUB box_x2&,shadow_dx&
              SUB rect_y2&,shadow_dy&
            ELSE
              rect_drag(knob_colour&,colour_work&,object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},box_x1&,rect_y1&,box_x2&,rect_y2&)
            ENDIF
            ' Value = min + (max-min)*knob offset/track length, rounded, clamped to min..max-visible
            box_x2&=INT{obj_ptr%+16}-INT{obj_ptr%+8}
            knob_start&=ADD(INT{work_ptr%},(MUL(INT{work_ptr%+2}-INT{work_ptr%},box_x1&-object_x&-INT{obj_ptr%+8})+(box_x2& DIV 2)) DIV box_x2&)
            knob_start&=MAX(MIN(knob_start&,INT{work_ptr%+2}-INT{work_ptr%+10}),INT{work_ptr%})
            CARD{work_ptr%+8}=knob_start&
            dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
            slider_thumb_h(obj_ptr%)
            pointer_show
            IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
              slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
              IF BYTE{obj_ptr%+4}
                object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ELSE
      button_state!=FALSE
    ENDIF
  UNTIL click_buttons&=0 OR button_state!=FALSE
RETURN
' Vertical slider obj_ptr% at origin object_x&,object_y&; the same as hslider_drag with y in place of x.
' slider_thumb_v sets work_ptr% to the slider data and knob_start&..knob_end& to the knob pixels.
PROCEDURE vslider_drag(obj_ptr%,object_x&,object_y&)
  LOCAL aux&,num_val&,knob_start&,knob_end&,work_ptr%,button_state!,box_x1&,box_x2&,rect_y1&,rect_y2&
  slider_thumb_v(obj_ptr%)
  slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
  button_state!=FALSE
  REPEAT
    pointer_state(click_x&,click_y&,click_buttons&)
    EXIT IF click_buttons&=0
    SUB click_x&,object_x&
    SUB click_y&,object_y&
    IF @rect_hit(click_x&,click_y&,obj_ptr%+8)<>0
      ' Right button: centre the knob on the mouse at once, then wait for the release
      IF click_buttons&=2
        rect_y2&=INT{obj_ptr%+18}-INT{obj_ptr%+10}
        knob_start&=ADD(INT{work_ptr%},(MUL(INT{work_ptr%+2}-INT{work_ptr%},click_y&-INT{obj_ptr%+10})+(rect_y2& DIV 2)) DIV rect_y2&)
        knob_start&=MAX(MIN(knob_start&-DIV(INT{work_ptr%+10},2),INT{work_ptr%+2}-INT{work_ptr%+10}),INT{work_ptr%})
        CARD{work_ptr%+8}=knob_start&
        dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
        slider_thumb_v(obj_ptr%)
        pointer_show
        IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
          slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
          IF BYTE{obj_ptr%+4}
            object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
          ENDIF
        ENDIF
        REPEAT
        UNTIL @pointer_buttons=0
      ELSE
        ' Left button above the knob: step up (+4)
        button_state!=TRUE
        IF click_y&<knob_start&
          CARD{work_ptr%+8}=INT{work_ptr%+8}+INT{work_ptr%+4}
          IF INT{work_ptr%+8}<INT{work_ptr%}
            CARD{work_ptr%+8}=INT{work_ptr%}
          ENDIF
          dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
          slider_thumb_v(obj_ptr%)
          pointer_show
          IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
            slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
            IF BYTE{obj_ptr%+4}
              object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
            ENDIF
          ENDIF
        ELSE
          ' Below the knob: step down (+6), clamped
          IF click_y&>knob_end&
            CARD{work_ptr%+8}=INT{work_ptr%+8}+INT{work_ptr%+6}
            IF INT{work_ptr%+8}+INT{work_ptr%+10}>INT{work_ptr%+2}
              CARD{work_ptr%+8}=INT{work_ptr%+2}-INT{work_ptr%+10}
            ENDIF
            IF INT{work_ptr%+8}<INT{work_ptr%}
              CARD{work_ptr%+8}=INT{work_ptr%}
            ENDIF
            dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
            slider_thumb_v(obj_ptr%)
            pointer_show
            IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
              slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
              IF BYTE{obj_ptr%+4}
                object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
              ENDIF
            ENDIF
          ELSE
            ' On the knob: clear the slot, drag the knob inside the track, then work out the new value
            knob_colour&=INT{work_ptr%+12}
            colour_work&=INT{work_ptr%+16}
            box_x1&=object_x&+INT{obj_ptr%+8}
            rect_y1&=knob_start&+object_y&
            box_x2&=object_x&+INT{obj_ptr%+16}
            rect_y2&=knob_end&+object_y&
            pointer_hide
            ACLIP 1,0,0,639,screen_max_y&
            IF mono!
              ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_grey%,1
            ELSE
              IF INT{work_ptr%+14}=-1
                ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%+16},0,V:pattern_solid%,1
              ELSE
                ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_solid%,1
              ENDIF
            ENDIF
            pointer_show
            ACLIP 1,0,0,639,screen_max_y&
            IF (BYTE{obj_ptr%+5} AND 15)=2
              box_x1&=box_x1&+shadow_dx&
              rect_y1&=rect_y1&+shadow_dy&
              box_x2&=box_x2&+shadow_dx&
              rect_y2&=rect_y2&+shadow_dy&
              rect_drag(knob_colour&,colour_work&,object_x&+INT{obj_ptr%+8}+shadow_dx&,object_y&+INT{obj_ptr%+10}+shadow_dy&,object_x&+INT{obj_ptr%+16}+shadow_dx&,object_y&+INT{obj_ptr%+18}+shadow_dy&,box_x1&,rect_y1&,box_x2&,rect_y2&)
              SUB box_x1&,shadow_dx&
              SUB rect_y1&,shadow_dy&
              SUB box_x2&,shadow_dx&
              SUB rect_y2&,shadow_dy&
            ELSE
              rect_drag(knob_colour&,colour_work&,object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},box_x1&,rect_y1&,box_x2&,rect_y2&)
            ENDIF
            ' Value = min + (max-min)*knob offset/track length, rounded, clamped to min..max-visible
            rect_y2&=INT{obj_ptr%+18}-INT{obj_ptr%+10}
            knob_start&=ADD(INT{work_ptr%},(MUL(INT{work_ptr%+2}-INT{work_ptr%},rect_y1&-object_y&-INT{obj_ptr%+10})+(rect_y2& DIV 2)) DIV rect_y2&)
            knob_start&=MAX(MIN(knob_start&,INT{work_ptr%+2}-INT{work_ptr%+10}),INT{work_ptr%})
            CARD{work_ptr%+8}=knob_start&
            dialog_object_draw(obj_ptr%,object_x&,object_y&,-1)
            slider_thumb_v(obj_ptr%)
            pointer_show
            IF slider_last&<>INT{rsc_data%+LONG{obj_ptr%+24}+8}
              slider_last&=INT{rsc_data%+LONG{obj_ptr%+24}+8}
              IF BYTE{obj_ptr%+4}
                object_action_call(BYTE{obj_ptr%+4},dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ELSE
      button_state!=FALSE
    ENDIF
  UNTIL click_buttons&=0 OR button_state!=FALSE
RETURN
' Drags box box_x1&,rect_y1&..box_x2&,rect_y2& (VAR) with the mouse until the button is released,
' keeping it inside rect_x1&,rect_ay&..rect_x2&,y_bottom& (top at least 11, below the menu bar).
' Knob colour knob_colour& -1 drags an XOR outline (dialog move); otherwise the track is filled with
' colour colour_work& and the box with knob_colour& at each new position. Returns the final box position
' (x2/y2 come back as width and height).
PROCEDURE rect_drag(knob_colour&,colour_work&,rect_x1&,rect_ay&,rect_x2&,y_bottom&,VAR box_x1&,rect_y1&,box_x2&,rect_y2&)
  LOCAL grab_dx&,grab_dy&,last_x&,last_y&
  last_x&=box_x1&
  last_y&=rect_y1&
  rect_ay&=MAX(11,rect_ay&)
  SUB box_x2&,box_x1&  !x2/y2 become width/height
  SUB rect_y2&,rect_y1&
  pointer_state(click_x&,click_y&,click_buttons&)
  grab_dx&=box_x1&-click_x&  !grab offset from the mouse
  grab_dy&=rect_y1&-click_y&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  ' Outline: XOR the four sides (HLINE/ALINE mode 2)
  IF knob_colour&=-1
    HLINE box_x1&,rect_y1&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
    HLINE box_x1&,rect_y1&+rect_y2&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
    ALINE box_x1&,SUCC(rect_y1&),box_x1&,rect_y1&+rect_y2&-1,3,-1,2
    ALINE box_x1&+box_x2&,SUCC(rect_y1&),box_x1&+box_x2&,rect_y1&+rect_y2&-1,3,-1,2
  ELSE
    IF mono!
      ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_grey%,1
    ELSE
      ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_solid%,1
    ENDIF
    ARECT box_x1&,rect_y1&,box_x1&+box_x2&,rect_y1&+rect_y2&,knob_colour&,0,V:pattern_solid%,1
  ENDIF
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
  ' Follow the mouse, clamped to the bounds; redraw only when the position changes
  REPEAT
    pointer_state(click_x&,click_y&,click_buttons&)
    box_x1&=click_x&+grab_dx&
    rect_y1&=click_y&+grab_dy&
    box_x1&=MAX(box_x1&,rect_x1&)
    rect_y1&=MAX(rect_y1&,rect_ay&)
    box_x1&=MIN(box_x1&,rect_x2&-box_x2&)
    rect_y1&=MIN(rect_y1&,y_bottom&-rect_y2&)
    IF last_x&<>box_x1& OR last_y&<>rect_y1&
      pointer_hide
      ACLIP 1,0,0,639,screen_max_y&
      IF knob_colour&=-1
        HLINE last_x&,last_y&,last_x&+box_x2&,3,2,V:pattern_solid%,1
        HLINE last_x&,last_y&+rect_y2&,last_x&+box_x2&,3,2,V:pattern_solid%,1
        ALINE last_x&,SUCC(last_y&),last_x&,last_y&+rect_y2&-1,3,-1,2
        ALINE last_x&+box_x2&,SUCC(last_y&),last_x&+box_x2&,last_y&+rect_y2&-1,3,-1,2
        HLINE box_x1&,rect_y1&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
        HLINE box_x1&,rect_y1&+rect_y2&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
        ALINE box_x1&,SUCC(rect_y1&),box_x1&,rect_y1&+rect_y2&-1,3,-1,2
        ALINE box_x1&+box_x2&,SUCC(rect_y1&),box_x1&+box_x2&,rect_y1&+rect_y2&-1,3,-1,2
      ELSE
        IF mono!
          ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_grey%,1
        ELSE
          ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_solid%,1
        ENDIF
        ARECT box_x1&,rect_y1&,box_x1&+box_x2&,rect_y1&+rect_y2&,knob_colour&,0,V:pattern_solid%,1
      ENDIF
      pointer_show
      ACLIP 1,0,0,639,screen_max_y&
    ENDIF
    last_x&=box_x1&
    last_y&=rect_y1&
  UNTIL click_buttons&=0  !then a last draw removes the outline or draws the final box
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  IF knob_colour&=-1
    HLINE box_x1&,rect_y1&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
    HLINE box_x1&,rect_y1&+rect_y2&,box_x1&+box_x2&,3,2,V:pattern_solid%,1
    ALINE box_x1&,SUCC(rect_y1&),box_x1&,rect_y1&+rect_y2&-1,3,-1,2
    ALINE box_x1&+box_x2&,SUCC(rect_y1&),box_x1&+box_x2&,rect_y1&+rect_y2&-1,3,-1,2
  ELSE
    IF mono!
      ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_grey%,1
    ELSE
      ARECT rect_x1&,rect_ay&,rect_x2&,y_bottom&,colour_work&,0,V:pattern_solid%,1
    ENDIF
    ARECT box_x1&,rect_y1&,box_x1&+box_x2&,rect_y1&+rect_y2&,knob_colour&,0,V:pattern_solid%,1
  ENDIF
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
RETURN
' Draws dialog dialog_id&: saves the screen under it (with shadow) in dialog_background$ (not for the main screen
' 4, which covers it all), zooms a box out from zoom_x1&.. to the dialog frame, then draws all
' objects: first plain, calling the action of each drawn-only object that has one, then a second
' pass with the selected states, sliders and edit cursor.
PROCEDURE dialog_draw(dialog_id&)
  LOCAL action_kind&,origin_x&,origin_y&,work_text$,font_ptr%,obj_ptr%
  pointer_hide
  ACLIP 1,0,0,screen_max_x&,screen_max_y&
  tree_find(dialog_id&,obj_ptr%)
  obj_end%=obj_ptr%+INT{obj_ptr%+2}
  shape_bounds(obj_ptr%+4,background_x&,background_y&,box_x1&,rect_y1&)  !bounding box of the frame objects
  background_x&=background_x&+(ODD(background_x&))
  background_y&=background_y&+(ODD(background_y&))
  IF dialog_id&<>4
    GET background_x&,background_y&,box_x1&+shadow_dx&,rect_y1&+shadow_dy&,dialog_background$
  ELSE
    dialog_background$=""
  ENDIF
  zoom_box_anim(zoom_x1&,zoom_y1&,zoom_x2&,zoom_y2&,INT{obj_ptr%+4},INT{obj_ptr%+6},INT{obj_ptr%+12},INT{obj_ptr%+14})  !zoom box
  origin_x&=INT{obj_ptr%+4}
  origin_y&=INT{obj_ptr%+6}
  origin_x&=origin_x&+(ODD(origin_x&))
  origin_y&=origin_y&+(ODD(origin_y&))
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  obj_ptr%=obj_ptr%+20
  work_ptr%=obj_ptr%
  ' First pass: plain objects
  WHILE obj_ptr%<obj_end%
    action_kind&=BYTE{obj_ptr%+4}
    IF action_kind&<>0 AND BYTE{obj_ptr%+3}>127
      object_action_call(action_kind&,dialog_id&,INT{obj_ptr%},origin_x&,origin_y&)
    ENDIF
    dialog_object_draw(obj_ptr%,origin_x&,origin_y&,0)
    obj_ptr%=obj_ptr%+28
  WEND
  obj_ptr%=work_ptr%
  ' Second pass: states, sliders and edit fields
  WHILE obj_ptr%<obj_end%
    dialog_object_draw(obj_ptr%,origin_x&,origin_y&,-1)
    obj_ptr%=obj_ptr%+28
  WEND
  pointer_show
RETURN
' Draws object obj_ptr% of the current dialog at dialog origin origin_x&,origin_y&. With full_draw! TRUE it
' draws the live parts: selected buttons, slider knobs and the edit field background with its
' cursor. With FALSE it draws the plain object: 128 line, 129 box, 130 image, 131 text (an
' indirect image 132 is followed to its image). An edit field is drawn as its text object.
PROCEDURE dialog_object_draw(obj_ptr%,origin_x&,origin_y&,full_draw!)
  LOCAL object_x&,object_y&,parent_obj&,work_ptr%,obj_type&,y_centre&,line_pattern&,pattern_addr%,aux&,num_val&,knob_start&,knob_end&,font_ptr%,pix_width&
  pointer_hide
  ACLIP 1,0,0,639,screen_max_y&
  obj_type&=BYTE{obj_ptr%+3}  !object type
  object_x&=origin_x&
  object_y&=origin_y&
  ' Add the parents' offsets to get the screen origin object_x&,object_y&
  IF INT{obj_ptr%+6}
    work_ptr%=obj_ptr%
    DO
      parent_obj&=INT{obj_ptr%+6}
      EXIT IF parent_obj&=0
      obj_find(dialog_id&,parent_obj&,obj_ptr%)
      object_x&=object_x&+INT{obj_ptr%+8}
      object_y&=object_y&+INT{obj_ptr%+10}
    LOOP
    obj_ptr%=work_ptr%
  ENDIF
  work_ptr%=rsc_data%+LONG{obj_ptr%+24}  !object data
  ' Indirect image: data +0 is the offset of the real image
  IF obj_type&=132
    work_ptr%=rsc_data%+LONG{work_ptr%}
    obj_type&=130
  ELSE
    ' Edit field: the first one drawn becomes the active field, cursor at the end of its text
    IF full_draw! AND obj_type&=5
      IF edit_object&=-1
        edit_object&=INT{obj_ptr%}
        cursor_pos&=INT{work_ptr%+14}
      ENDIF
      ' Mono: grey dither fill for the field, its phase chosen by the parent id
      IF mono!
        IF ODD(INT{obj_ptr%+6})
          pattern_solid%=1431677610
        ELSE
          pattern_solid%=-1431677611
        ENDIF
      ENDIF
      ' Clear the field background, extended by the cursor height (cursor_top&/cursor_bottom&) on the active field
      IF edit_object&=INT{obj_ptr%} OR edit_object&=0
        ' Clamp the cursor to the end of the text; cursor_keep! is never set TRUE, so this always runs and the
        ' ELSE branch is never used
        IF cursor_keep!=FALSE
          y_centre&=INT{work_ptr%+14}
          WHILE BYTE{work_ptr%+15+y_centre&}=32 AND y_centre&>0
            DEC y_centre&
          WEND
          cursor_pos&=MIN(cursor_pos&,y_centre&)
        ELSE
          cursor_keep!=TRUE
        ENDIF
        IF INT{work_ptr%+6}=-1
          ARECT object_x&+INT{obj_ptr%+8},cursor_top&+(object_y&+INT{obj_ptr%+10}),SUCC(object_x&+INT{obj_ptr%+16}),cursor_bottom&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+2},0,V:pattern_solid%,1
        ELSE
          ARECT object_x&+INT{obj_ptr%+8},cursor_top&+(object_y&+INT{obj_ptr%+10}),SUCC(shadow_dx&+(object_x&+INT{obj_ptr%+16})),cursor_bottom&+(shadow_dy&+(object_y&+INT{obj_ptr%+18})),INT{work_ptr%+2},0,V:pattern_solid%,1
        ENDIF
      ELSE
        IF INT{work_ptr%+6}=-1
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%+2},0,V:pattern_solid%,1
        ELSE
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+2},0,V:pattern_solid%,1
        ENDIF
      ENDIF
      IF mono!
        pattern_solid%=-1
      ENDIF
      ' Draw the field's text as a type 131 text object (its data starts at +4)
      ADD work_ptr%,4
      obj_type&=131
      full_draw!=FALSE
    ENDIF
  ENDIF
  IF full_draw!
    SELECT obj_type&
    CASE 1,2
      ' Toggle, radio: draw selected when the state is set
      IF INT{rsc_data%+LONG{obj_ptr%+24}+8}
        obj_draw_selected(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}+4})
      ENDIF
    CASE 7
      ' Horizontal slider: track (grey dither on mono), knob, knob shadow
      slider_thumb_h(obj_ptr%)
      IF mono!
        ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_grey%,1
      ELSE
        IF INT{work_ptr%+14}=-1
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%+16},0,V:pattern_solid%,1
        ELSE
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_solid%,1
        ENDIF
      ENDIF
      ARECT object_x&+knob_start&,object_y&+INT{obj_ptr%+10},object_x&+knob_end&,object_y&+INT{obj_ptr%+18},INT{work_ptr%+12},0,V:pattern_solid%,1
      IF INT{work_ptr%+14}<>-1
        ARECT object_x&+knob_start&+shadow_dx&,SUCC(object_y&+INT{obj_ptr%+18}),object_x&+knob_end&+shadow_dx&,shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+14},0,V:pattern_solid%,1
        ARECT MAX(SUCC(object_x&+knob_end&),object_x&+knob_start&+shadow_dx&),shadow_dy&+(object_y&+INT{obj_ptr%+10}),object_x&+knob_end&+shadow_dx&,object_y&+INT{obj_ptr%+18},INT{work_ptr%+14},0,V:pattern_solid%,1
      ENDIF
    CASE 8
      ' Vertical slider: track, knob, knob shadow
      slider_thumb_v(obj_ptr%)
      IF mono!
        ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_grey%,1
      ELSE
        IF INT{work_ptr%+14}=-1
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%+16},0,V:pattern_solid%,1
        ELSE
          ARECT object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},shadow_dx&+(object_x&+INT{obj_ptr%+16}),shadow_dy&+(object_y&+INT{obj_ptr%+18}),INT{work_ptr%+16},0,V:pattern_solid%,1
        ENDIF
      ENDIF
      ARECT object_x&+INT{obj_ptr%+8},object_y&+knob_start&,object_x&+INT{obj_ptr%+16},object_y&+knob_end&,INT{work_ptr%+12},0,V:pattern_solid%,1
      IF INT{work_ptr%+14}<>-1
        ARECT shadow_dx&+(object_x&+INT{obj_ptr%+8}),MAX(SUCC(object_y&+knob_end&),object_y&+knob_start&+shadow_dy&),shadow_dx&+(object_x&+INT{obj_ptr%+16}),object_y&+knob_end&+shadow_dy&,INT{work_ptr%+14},0,V:pattern_solid%,1
        ARECT SUCC(object_x&+INT{obj_ptr%+16}),object_y&+knob_start&+shadow_dy&,shadow_dx&+(object_x&+INT{obj_ptr%+16}),object_y&+knob_end&,INT{work_ptr%+14},0,V:pattern_solid%,1
      ENDIF
    CASE 9
    ENDSELECT
  ELSE
    SELECT obj_type&
    CASE 128
      ALINE object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},object_x&+INT{obj_ptr%+16},object_y&+INT{obj_ptr%+18},INT{work_ptr%},INT{work_ptr%+2},0  !line: data colour, pattern
    CASE 129
      shape_paint(obj_ptr%+8,object_x&,object_y&,INT{work_ptr%},INT{work_ptr%+2},work_ptr%+4)  !box: colour, pattern, fill
    CASE 130
      pointer_hide
      image_blit(object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10},work_ptr%)  !image: bit image by Line-A BITBLT
    CASE 131
      ' Text: data +10 length, +12 characters; trailing blanks removed
      work_text$=SPACE$(INT{work_ptr%+10})
      IF work_text$<>""
        BMOVE work_ptr%+12,V:work_text$,LEN(work_text$)
      ENDIF
      letter_index&=LEN(work_text$)-1
      WHILE BYTE{letter_index&+V:work_text$}=32 AND letter_index&>0
        DEC letter_index&
      WEND
      work_text$=LEFT$(work_text$,SUCC(letter_index&))
      font_ptr%=INT{work_ptr%+4}  !font: 0-2 system font, else loaded font from font_find
      IF font_ptr%>2
        font_ptr%=@font_find(font_ptr%)
      ENDIF
      ' Cut the text to the object width
      pix_width&=SUCC(INT{obj_ptr%+16}-INT{obj_ptr%+8})
      letter_index&=LEN(work_text$)
      WHILE @pixel_width_of(font_ptr%,LEFT$(work_text$,letter_index&))>pix_width&
        DEC letter_index&
      WEND
      work_text$=LEFT$(work_text$,letter_index&)
      ' Data +6 bit 7 centres the text, bit 6 aligns it right
      IF BTST(INT{work_ptr%+6},7)
        ADD object_x&,(INT{obj_ptr%+16}-INT{obj_ptr%+8}-@pixel_width_of(font_ptr%,work_text$)) DIV 2
      ELSE
        IF BTST(INT{work_ptr%+6},6)
          ADD object_x&,INT{obj_ptr%+16}-INT{obj_ptr%+8}-@pixel_width_of(font_ptr%,work_text$)
        ENDIF
      ENDIF
      ' Active edit field: find the cursor pixel x; when the cursor is past the visible text, scroll
      ' the text so the cursor and up to 5 characters after it fit in the field
      IF edit_object&=INT{obj_ptr%}
        IF cursor_pos&>LEN(work_text$)
          work_text$=SPACE$(INT{work_ptr%+10})
          BMOVE work_ptr%+12,V:work_text$,LEN(work_text$)
          letter_index&=LEN(work_text$)-1
          WHILE BYTE{letter_index&+V:work_text$}=32 AND letter_index&>0
            DEC letter_index&
          WEND
          work_text$=LEFT$(work_text$,SUCC(letter_index&))
          cursor_pixel_x&=@pixel_width_of(font_ptr%,LEFT$(work_text$,cursor_pos&))
          letter_index&=1
          DO
            line_pattern&=0
            FOR y_centre&=letter_index& TO MIN(LEN(work_text$),cursor_pos&+5)
              IF font_ptr%<3
                ADD line_pattern&,8
              ELSE
                font_hdr%=LONG{font_ptr%+72}+MUL(2,BYTE{y_centre&+V:work_text$-1}-BYTE{font_ptr%+37})  !GDOS font: offset table entry of the character (+72 table, +37 first character)
                line_pattern&=line_pattern&+(INT{font_hdr%+2}-INT{font_hdr%})
              ENDIF
            NEXT y_centre&
            EXIT IF line_pattern&<=pix_width&
            INC letter_index&
          LOOP
          SUB cursor_pixel_x&,@pixel_width_of(font_ptr%,LEFT$(work_text$,PRED(letter_index&)))
          work_text$=MID$(work_text$,letter_index&,cursor_pos&-letter_index&+6)
        ELSE
          cursor_pixel_x&=@pixel_width_of(font_ptr%,LEFT$(work_text$,cursor_pos&))
        ENDIF
      ENDIF
      wrmode_set(2)  !transparent writing
      ' Data +2 shadow colour (-1 none): text shadow and its cursor, offset by shadow_dx&,shadow_dy&
      IF INT{work_ptr%+2}>=0
        font_attr_set(0,0,0,0,INT{work_ptr%+4})
        font_attr_set(INT{work_ptr%+2},INT{work_ptr%+6},0,INT{work_ptr%+8},0)
        txt_draw(object_x&+INT{obj_ptr%+8}+shadow_dx&,shadow_dy&+(object_y&+INT{obj_ptr%+10})+INT{work_ptr%+8}+dialog_text_dy&,work_text$)
        IF edit_object&=INT{obj_ptr%}
          ALINE cursor_pixel_x&+(shadow_dx&+(object_x&+INT{obj_ptr%+8})),cursor_top&+(shadow_dy&+(object_y&+INT{obj_ptr%+10})),cursor_pixel_x&+(shadow_dx&+(object_x&+INT{obj_ptr%+8})),cursor_bottom&+(shadow_dy&+(object_y&+INT{obj_ptr%+18})),vdi_to_hw_colour&(INT{work_ptr%+2}),-1,0
        ENDIF
      ENDIF
      ' White text without shadow on mono: black outline one pixel down/right
      IF INT{work_ptr%}=0 AND INT{work_ptr%+2}=-1 AND mono!
        font_attr_set(0,0,0,0,INT{work_ptr%+4})
        font_attr_set(1,INT{work_ptr%+6},0,INT{work_ptr%+8},0)
        txt_draw(SUCC(object_x&+INT{obj_ptr%+8}),SUCC(object_y&+INT{obj_ptr%+10})+INT{work_ptr%+8}+dialog_text_dy&,work_text$)
      ENDIF
      font_attr_set(0,0,0,0,INT{work_ptr%+4})
      ' Text in data +0 colour, then the cursor line in the hardware colour of that pen
      font_attr_set(INT{work_ptr%},INT{work_ptr%+6},0,INT{work_ptr%+8},0)
      txt_draw(object_x&+INT{obj_ptr%+8},object_y&+INT{obj_ptr%+10}+INT{work_ptr%+8}+dialog_text_dy&,work_text$)
      IF edit_object&=INT{obj_ptr%}
        ALINE cursor_pixel_x&+(object_x&+INT{obj_ptr%+8}),cursor_top&+(object_y&+INT{obj_ptr%+10}),cursor_pixel_x&+(object_x&+INT{obj_ptr%+8}),cursor_bottom&+(object_y&+INT{obj_ptr%+18}),vdi_to_hw_colour&(INT{work_ptr%}),-1,0
      ENDIF
    ENDSELECT
  ENDIF
RETURN
' Calls the action routine of object obj_num& of dialog dialog_id& at origin origin_x&,origin_y&.
' Action kind action_kind& 1: dialog handlers (filesel_obj_action for dialogs 0-3, msgbox_draw for 4 and up);
' kind 2: the main command dispatcher action_dispatch.
PROCEDURE object_action_call(action_kind&,dialog_id&,obj_num&,origin_x&,origin_y&)
  IF action_kind&=1
    IF dialog_id&<4
      filesel_obj_action(dialog_id&,obj_num&,origin_x&,origin_y&)
    ELSE
      msgbox_draw(dialog_id&,obj_num&,origin_x&,origin_y&)
    ENDIF
  ELSE
    IF action_kind&=2
      action_dispatch(dialog_id&,obj_num&,origin_x&,origin_y&)
    ENDIF
  ENDIF
RETURN
' Runs the pending action of the active edit field (edit_object&) after typing, set up by
' edit_mouse_x&/edit_mouse_y& (mouse position at the edit, -1 = nothing pending). It runs when flush_force& is 0, a
' mouse button is down or the mouse has moved.
PROCEDURE edit_action_flush(flush_force&)
  LOCAL obj_scan%,click_x&,click_y&,click_buttons&
  IF edit_mouse_x&>=0
    pointer_state(click_x&,click_y&,click_buttons&)
    IF click_buttons& OR (flush_force&=0 OR click_x&<>edit_mouse_x& OR click_y&<>edit_mouse_y&)
      obj_find(dialog_id&,edit_object&,obj_scan%)
      IF BYTE{obj_scan%+4}
        object_action_call(BYTE{obj_scan%+4},dialog_id&,INT{obj_scan%},origin_x&,origin_y&)
      ENDIF
      edit_mouse_x&=-1
    ENDIF
  ENDIF
RETURN
' Sound Lab's own alert box.  msg_spec$ is "[icon][line|line...][button|button...][keys][LEFT]":
' icon 1/2/3 picks icon_note%/icon_question%/icon_stop%, keys are one per button ("^M" = Control-M, a CHR$(127) prefix
' adds 128 for a scan-code key), LEFT left-aligns the text.  The box is built as a dialog tree with id
' dialog_id& (also its help topic) in the msgbox_tree_buf% buffer, centred on screen, and run by dialog_run.
' Returns the number (1..4) of the button chosen.
FUNCTION msgbox_show(dialog_id&,msg_spec$)
  LOCAL tree_first%,tree_end%,rsc_data%,ix&,y_or_j&,counter&,obj_ofs&,spec_ofs&,work_text$,work_text2$
  ' Split the "[...]" fields into msgbox_part$(0..4): icon, text lines, buttons, keys, alignment.
  msgbox_part$(3)=""
  msgbox_part$(4)=""
  ix&=0
  WHILE msg_spec$<>""
    y_or_j&=INSTR(msg_spec$,"]")
    msgbox_part$(ix&)=MID$(msg_spec$,2,SUB(y_or_j&,2))
    INC ix&
    msg_spec$=MID$(msg_spec$,SUCC(y_or_j&))
  WEND
  ' Icon image for the box.
  SELECT msgbox_part$(0)
  CASE "1"
    msgbox_icon%=icon_note%
  CASE "2"
    msgbox_icon%=icon_question%
  CASE "3"
    msgbox_icon%=icon_stop%
  ENDSELECT
  msgbox_lines_str$=msgbox_part$(1)+"|"
  msgbox_buttons_str$=msgbox_part$(2)+"|"
  msgbox_keys$=msgbox_part$(3)+"|"
  msgbox_left&=0
  IF UPPER$(msgbox_part$(4))="LEFT"
    msgbox_left&=1
  ENDIF
  ix&=0
  msgbox_text_w&=0
  ' Text lines into msgbox_part$(0..), msgbox_text_w& = widest line in the system font.
  WHILE msgbox_lines_str$<>""
    y_or_j&=INSTR(msgbox_lines_str$,"|")
    msgbox_part$(ix&)=LEFT$(msgbox_lines_str$,PRED(y_or_j&))
    msgbox_text_w&=MAX(msgbox_text_w&,@pixel_width_of(font_main%,msgbox_part$(ix&)))
    msgbox_lines_str$=MID$(msgbox_lines_str$,SUCC(y_or_j&))
    INC ix&
  WEND
  msgbox_line_count&=ix&
  ix&=5
  msgbox_button_w&=0
  ' Button labels into msgbox_part$(5..), msgbox_button_w& = widest label, msgbox_button_count& = button count.
  WHILE msgbox_buttons_str$<>""
    y_or_j&=INSTR(msgbox_buttons_str$,"|")
    msgbox_part$(ix&)=LEFT$(msgbox_buttons_str$,PRED(y_or_j&))
    msgbox_button_w&=MAX(msgbox_button_w&,@pixel_width_of(font_main%,msgbox_part$(ix&)))
    msgbox_buttons_str$=MID$(msgbox_buttons_str$,SUCC(y_or_j&))
    INC ix&
  WEND
  msgbox_button_count&=ix&-5
  work_text$=""
  ' Decode the shortcut keys into one character per button.
  WHILE msgbox_keys$<>""
    y_or_j&=0
    IF LEFT$(msgbox_keys$,3)=""  !three CHR$(127) characters give key code 128
      y_or_j&=128
      msgbox_keys$=MID$(msgbox_keys$,5)
    ELSE
      IF LEFT$(msgbox_keys$)=CHR$(127)
        y_or_j&=128
        msgbox_keys$=MID$(msgbox_keys$,2)
      ENDIF
      IF LEFT$(msgbox_keys$)="^"  !^x = Control-x
        y_or_j&=y_or_j&+-64
        msgbox_keys$=MID$(msgbox_keys$,2)
      ENDIF
      y_or_j&=y_or_j&+ASC(msgbox_keys$)
      msgbox_keys$=MID$(msgbox_keys$,3)
      IF y_or_j&<0
        y_or_j&=y_or_j&+64
      ENDIF
    ENDIF
    work_text$=work_text$+CHR$(y_or_j&)
  WEND
  ' No key list (or a single key): the button answers Return.
  IF LEN(work_text$)=1
    work_text$=CHR$(13)
  ENDIF
  msgbox_keys$=work_text$
  ' Key count does not match the buttons: Return for the first button, Undo (128+$61) for the last.
  IF msgbox_button_count&<>LEN(msgbox_keys$)
    IF msgbox_button_count&=1
      msgbox_keys$=CHR$(13)
    ELSE
      msgbox_keys$=CHR$(13)+STRING$(SUB(msgbox_button_count&,2),0)+"á"
    ENDIF
  ENDIF
  ' Box height: two rows of buttons when there are 4; doubled in high resolution.
  IF mono!
    msgbox_h&=132-(msgbox_button_count&=4)*28
  ELSE
    msgbox_h&=66-(msgbox_button_count&=4)*14
  ENDIF
  ' Box width: text plus icon area, or the button row (2x2 grid for 4 buttons).
  IF msgbox_button_count&=4
    msgbox_w&=MAX(msgbox_text_w&+116,48+msgbox_button_w&*2)
  ELSE
    msgbox_w&=MAX(msgbox_text_w&+116,ADD((msgbox_button_count&+1)*16,msgbox_button_count&*msgbox_button_w&))
  ENDIF
  ' Tree header: id, size, box x1,y1 at +4/+6 and x2,y2 at +12/+14, centred on the screen.
  CARD{msgbox_tree_buf%}=dialog_id&
  CARD{msgbox_tree_buf%+2}=1000
  CARD{msgbox_tree_buf%+4}=(screen_max_x&-msgbox_w&) DIV 2
  CARD{msgbox_tree_buf%+6}=(screen_max_y&-msgbox_h&) DIV 2
  LONG{msgbox_tree_buf%+8}=0
  CARD{msgbox_tree_buf%+12}=PRED(msgbox_w&+((screen_max_x&-msgbox_w&) DIV 2))
  CARD{msgbox_tree_buf%+14}=PRED(msgbox_h&+((screen_max_y&-msgbox_h&) DIV 2))
  LONG{msgbox_tree_buf%+16}=0
  ' Objects of 28 bytes start at offset 20, their spec data at offset 800.
  obj_ofs&=20
  spec_ofs&=800
  IF msgbox_button_count&=4
    ix&=(msgbox_w&-16-msgbox_button_w&*2) DIV 2
  ELSE
    ix&=(msgbox_w&-(msgbox_button_count&-1)*16-MUL(msgbox_button_count&,msgbox_button_w&)) DIV 2
  ENDIF
  IF mono!
    y_or_j&=102
  ELSE
    y_or_j&=51
  ENDIF
  ' One button object per label: number, type 4 (exit button), draw type 2 (pressed look by shifting),
  ' rectangle, spec offset; spec +8 = button number, +10 = its shortcut key.
  FOR counter&=5 TO msgbox_button_count&+4
    CARD{msgbox_tree_buf%+obj_ofs&}=SUB(counter&,4)
    CARD{msgbox_tree_buf%+obj_ofs&+2}=4
    CARD{msgbox_tree_buf%+obj_ofs&+4}=2
    CARD{msgbox_tree_buf%+obj_ofs&+6}=0
    CARD{msgbox_tree_buf%+obj_ofs&+8}=ix&
    CARD{msgbox_tree_buf%+obj_ofs&+10}=y_or_j&
    LONG{msgbox_tree_buf%+obj_ofs&+12}=0
    CARD{msgbox_tree_buf%+obj_ofs&+16}=ix&+msgbox_button_w&-1
    CARD{msgbox_tree_buf%+obj_ofs&+18}=y_or_j&+9-mono!*10
    LONG{msgbox_tree_buf%+obj_ofs&+20}=0
    LONG{msgbox_tree_buf%+obj_ofs&+24}=spec_ofs&
    LONG{msgbox_tree_buf%+spec_ofs&}=0
    LONG{msgbox_tree_buf%+spec_ofs&+4}=0
    CARD{msgbox_tree_buf%+spec_ofs&+8}=SUB(counter&,4)
    CARD{msgbox_tree_buf%+spec_ofs&+10}=ASC(MID$(msgbox_keys$,SUB(counter&,4),1))
    obj_ofs&=obj_ofs&+28
    spec_ofs&=spec_ofs&+12
    ix&=ix&+(16+msgbox_button_w&)
    IF counter&=6 AND msgbox_button_count&=4  !with 4 buttons, buttons 3 and 4 go on a second row
      ix&=(msgbox_w&-16-msgbox_button_w&*2) DIV 2
      y_or_j&=y_or_j&+14
      IF mono!
        y_or_j&=y_or_j&+14
      ENDIF
    ENDIF
  NEXT counter&
  ' Closing object 5: type 129 (not clickable), 1x1 at 1,2, spec words 1,0,-1.
  CARD{msgbox_tree_buf%+obj_ofs&}=5
  CARD{msgbox_tree_buf%+obj_ofs&+2}=129
  CARD{msgbox_tree_buf%+obj_ofs&+4}=256
  CARD{msgbox_tree_buf%+obj_ofs&+6}=0
  CARD{msgbox_tree_buf%+obj_ofs&+8}=1
  CARD{msgbox_tree_buf%+obj_ofs&+10}=2
  LONG{msgbox_tree_buf%+obj_ofs&+12}=0
  CARD{msgbox_tree_buf%+obj_ofs&+16}=1
  CARD{msgbox_tree_buf%+obj_ofs&+18}=2
  LONG{msgbox_tree_buf%+obj_ofs&+20}=0
  LONG{msgbox_tree_buf%+obj_ofs&+24}=spec_ofs&
  CARD{msgbox_tree_buf%+spec_ofs&}=1
  CARD{msgbox_tree_buf%+spec_ofs&+2}=0
  CARD{msgbox_tree_buf%+spec_ofs&+4}=-1
  obj_ofs&=obj_ofs&+28
  CARD{msgbox_tree_buf%+2}=obj_ofs&
  ' tree_first%, tree_end% and rsc_data% are LOCAL here, so dialog_run sees only the message box tree.
  tree_first%=msgbox_tree_buf%
  tree_end%=msgbox_tree_buf%+obj_ofs&
  rsc_data%=msgbox_tree_buf%
  dialog_run(dialog_id&,choice&)
  RETURN choice&
ENDFUNC
' Draws the message box tree built by msgbox_show (called through object_action_call for trees from 4 up).
' dialog_id& = tree id, origin_x&,origin_y& = box origin; obj_num& is not used.
' Draws the patterned background, raised frame and drop shadow, the icon, the text lines in
' msgbox_part$(0..) and the button frames with their centred labels in msgbox_part$(5..).
PROCEDURE msgbox_draw(dialog_id&,obj_num&,origin_x&,origin_y&)
  LOCAL obj_found%,ix&,y_or_j&,counter&,pix_width&,y_centre&,pattern_val%
  ' High resolution: checkerboard pattern and black edges; colour: solid colour 1 and colour 2 edges.
  IF mono!
    y_centre&=1
    pattern_val%=-1431677611
  ELSE
    y_centre&=2
    pattern_val%=-1
  ENDIF
  pointer_hide
  tree_find(dialog_id&,obj_found%)
  ' Background, then light top/left edges and dark bottom/right edges.
  ARECT INT{obj_found%+4}+1,INT{obj_found%+6}+1,INT{obj_found%+12}-1,INT{obj_found%+14}-1,1,0,V:pattern_val%,1
  ALINE INT{obj_found%+4},INT{obj_found%+14},INT{obj_found%+4},INT{obj_found%+6}+1,0,-1,0
  HLINE INT{obj_found%+4},INT{obj_found%+6},INT{obj_found%+12}-1,0,0,V:pattern_solid%,1
  ALINE INT{obj_found%+12},INT{obj_found%+6},INT{obj_found%+12},INT{obj_found%+14}-1,y_centre&,-1,0
  HLINE INT{obj_found%+4}+1,INT{obj_found%+14},INT{obj_found%+12},y_centre&,0,V:pattern_solid%,1
  ' Drop shadow below and to the right of the box.
  ARECT shadow_dx&+INT{obj_found%+4},INT{obj_found%+14}+1,shadow_dx&+INT{obj_found%+12},shadow_dy&+INT{obj_found%+14},3,0,V:pattern_solid%,1
  ARECT INT{obj_found%+12}+1,shadow_dy&+INT{obj_found%+6},shadow_dx&+INT{obj_found%+12},INT{obj_found%+14},3,0,V:pattern_solid%,1
  ' Alert icon at the top left.
  image_blit(origin_x&+17+mono!,origin_y&+9-mono!*10,msgbox_icon%)
  font_attr_set(0,0,0,0,3)
  IF mono!
    y_or_j&=52-msgbox_line_count&*10
  ELSE
    y_or_j&=26-msgbox_line_count&*5
  ENDIF
  ' Text area width (box width less the icon area); lines are centred in it unless left aligned.
  pix_width&=INT{msgbox_tree_buf%+12}-INT{msgbox_tree_buf%+4}-115
  ' Each line is drawn first in colour 1 shifted by the shadow offset, then in colour 0 on top.
  FOR counter&=0 TO PRED(msgbox_line_count&)
    IF msgbox_left&
      ix&=97
    ELSE
      ix&=97+((pix_width&-@pixel_width_of(font_main%,msgbox_part$(counter&))) DIV 2)
    ENDIF
    font_attr_set(1,0,0,6,0)
    txt_blit(origin_x&+ix&+shadow_dx&,origin_y&+y_or_j&+shadow_dy&,msgbox_part$(counter&))
    font_attr_set(0,0,0,6,0)
    txt_blit(origin_x&+ix&,origin_y&+y_or_j&,msgbox_part$(counter&))
    y_or_j&=y_or_j&+10
    IF mono!
      y_or_j&=y_or_j&+10
    ENDIF
  NEXT counter&
  ' Buttons: raised frame, shadow, then the label centred; the label shadow is drawn in high res only.
  FOR counter&=1 TO msgbox_button_count&
    obj_find(dialog_id&,counter&,obj_found%)
    ALINE origin_x&+INT{obj_found%+8},SUCC(origin_y&+INT{obj_found%+10}),origin_x&+INT{obj_found%+8},origin_y&+INT{obj_found%+18},0,-1,0
    ALINE origin_x&+INT{obj_found%+16},origin_y&+INT{obj_found%+10},origin_x&+INT{obj_found%+16},PRED(origin_y&+INT{obj_found%+18}),y_centre&,-1,0
    HLINE origin_x&+INT{obj_found%+8},origin_y&+INT{obj_found%+10},PRED(origin_x&+INT{obj_found%+16}),0,0,V:pattern_solid%,1
    HLINE SUCC(origin_x&+INT{obj_found%+8}),origin_y&+INT{obj_found%+18},origin_x&+INT{obj_found%+16},y_centre&,0,V:pattern_solid%,1
    ARECT shadow_dx&+(origin_x&+INT{obj_found%+8}),SUCC(origin_y&+INT{obj_found%+18}),shadow_dx&+(origin_x&+INT{obj_found%+16}),shadow_dy&+(origin_y&+INT{obj_found%+18}),3,0,V:pattern_solid%,1
    ARECT SUCC(origin_x&+INT{obj_found%+16}),shadow_dy&+(origin_y&+INT{obj_found%+10}),shadow_dx&+(origin_x&+INT{obj_found%+16}),origin_y&+INT{obj_found%+18},3,0,V:pattern_solid%,1
    IF mono!
      font_attr_set(1,0,0,6,0)
      txt_blit(origin_x&+INT{obj_found%+8}+1+((INT{obj_found%+16}-INT{obj_found%+8}+1-@pixel_width_of(font_main%,msgbox_part$(counter&+4))) DIV 2),origin_y&+INT{obj_found%+10}+2-mono!,msgbox_part$(counter&+4))
      font_attr_set(0,0,0,6,0)
    ENDIF
    txt_blit(origin_x&+INT{obj_found%+8}+((INT{obj_found%+16}-INT{obj_found%+8}+1-@pixel_width_of(font_main%,msgbox_part$(counter&+4))) DIV 2),origin_y&+INT{obj_found%+10}+1-mono!,msgbox_part$(counter&+4))
  NEXT counter&
RETURN
' Starts help topic dialog_id& (a dialog tree id or a help menu entry).  SOUNDLAB.HLP starts with a
' 600-byte index of 100 entries (LONG offset after the index, WORD length); the page is a pointer
' script that tour_step plays back, moving the mouse, clicking and typing in the real dialogs.
' Sets tour_active! (playback running) and keeps help_allowed! FALSE while it runs.
' Bug: when a read or seek fails the file on channel 2 is never closed.
PROCEDURE help_page_play(dialog_id&)
  IF @fexists(home_path$+"SoundLab.HLP")<>0
    help_allowed!=FALSE
    ' Open the help file on channel 2 and read its index to scratch_addr%+128.
    IF @fopen_channel("I",2,home_path$+"SoundLab.HLP")=0
      IF @fread_channel(2,128+scratch_addr%,600)=0
        help_page_ofs%=LONG{scratch_addr%+128+dialog_id&*6}
        tour_text_len&=INT{scratch_addr%+128+dialog_id&*6+4}
        IF tour_text_len&  !topics without a page have length 0
          ' Seek to the page and read it over the index.
          IF @fseek_abs(2,help_page_ofs%+600)=0
            IF @fread_channel(2,128+scratch_addr%,tour_text_len&)=0
              ~@fclose_channel(2)
              ' Reset the playback state and point the script at the start of the loaded page.
              tour_active!=TRUE
              tour_ptr%=128+scratch_addr%
              tour_state&=0
              tour_buttons&=0
              tour_next_tick%=TIMER
              tour_key_hit!=FALSE
              tour_moved_trees$=""
              ms_dummy%=0
              tour_abortable!=TRUE
              ' The mouse packet handler now writes real mouse movement into a dummy long.
              LONG{asm_mouse_packet%+10}=V:ms_dummy%
              ' Install the own mouse pointer: hook mousevec (Kbdvbase, XBIOS 34, +16) and add the VBL routine.
              IF NOT own_pointer!
                HIDEM
                vec_mouse_addr%=16+XBIOS(34)
                saved_mousevec%=LPEEK(vec_mouse_addr%)
                SLPOKE vec_mouse_addr%,asm_mouse_packet%
                LONG{pointer_vbl_code%+8}=0
                CARD{pointer_vbl_code%+24}=MOUSEX
                CARD{pointer_vbl_code%+26}=MOUSEY
                CARD{pointer_vbl_code%+156}=MOUSEX
                CARD{pointer_vbl_code%+158}=MOUSEY
                vbl_install(pointer_vbl_code%,vbl_slot%)
                own_pointer!=TRUE
                pointer_busy(0)
                pointer_show
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' Help could not start: allow the Help key again.
    IF tour_active!=FALSE
      help_allowed!=TRUE
    ENDIF
  ELSE
    help_missing_msg
  ENDIF
RETURN
' Alert (tree 5): SOUNDLAB.HLP is not in the folder Sound Lab was started from.
' The Help key is disabled while the alert is shown.
PROCEDURE help_missing_msg
  help_allowed!=FALSE
  choice&=@msgbox_show(5,"[3][I'm unable to locate the Help|file!  SOUNDLAB.HLP should|be in the same folder you|ran Sound Lab from...][  Let me find the docs...  ][^M][LEFT]")
  help_allowed!=TRUE
RETURN
' Passes key key_code& to the key handler of the dialog being run.  dialog_id& is not a parameter here:
' it is the tree id of the calling dialog_run.  Tree 1 = file selector, 4 = main screen, 12 = fade_curve_keys.
PROCEDURE dialog_key_dispatch(key_code&)
  IF dialog_id&=1
    filesel_key(key_code&)
  ELSE
    IF dialog_id&=4
      main_shifted_keys(key_code&)
    ELSE
      IF dialog_id&=12
        fade_curve_keys(key_code&)
      ENDIF
    ENDIF
  ENDIF
RETURN
' Zoom box animation from rectangle rect_x1&,rect_ay&-rect_x2&,y_bottom& to box_x1&,rect_y1&-box_x2&,rect_y2&,
' drawn only when zoom_enabled! is set.  Five XOR frames are drawn, then drawn again to erase them.
' Growing boxes double their step from 1/16 to 1, shrinking ones halve from 1 to 1/16 (starting at
' the large box), boxes of the same size move in linear quarters.
PROCEDURE zoom_box_anim(rect_x1&,rect_ay&,rect_x2&,y_bottom&,box_x1&,rect_y1&,box_x2&,rect_y2&)
  LOCAL ix&,y_or_j&,zoom_t,zoom_t0,zoom_step,zoom_unused,zoom_dy1&,zoom_dx2&,zoom_dy2&,zoom_cur_x1&,zoom_cur_x2&,zoom_cur_y1&,zoom_cur_y2&,area_from%,area_to%,zoom_geometric!
  IF zoom_enabled!
    pointer_hide
    ACLIP 1,0,0,639,screen_max_y&  !the clip width is 639 in every resolution
    ' Corner deltas; zoom_dx1& is a global, not one of the LOCALs.
    zoom_dx1&=box_x1&-rect_x1&
    zoom_dy1&=rect_y1&-rect_ay&
    zoom_dx2&=box_x2&-rect_x2&
    zoom_dy2&=rect_y2&-y_bottom&
    area_from%=(rect_x2&-rect_x1&)*(y_bottom&-rect_ay&)
    area_to%=(box_x2&-box_x1&)*(rect_y2&-rect_y1&)
    ' Shrinking: swap the rectangles; .8408964^4 = 0.5, factors 1, 1/2 .. 1/16.
    IF area_from%>area_to%
      zoom_step=.8408964152537
      zoom_t=1
      SWAP rect_x1&,box_x1&
      SWAP rect_x2&,box_x2&
      SWAP rect_ay&,rect_y1&
      SWAP y_bottom&,rect_y2&
      zoom_dx1&=-zoom_dx1&
      zoom_dy1&=-zoom_dy1&
      zoom_dx2&=-zoom_dx2&
      zoom_dy2&=-zoom_dy2&
      zoom_step=zoom_step^4
      zoom_geometric!=TRUE
    ELSE
      ' Same size: linear 0, .25, .5, .75, 1.
      IF area_from%=area_to%
        zoom_t=0
        zoom_step=.25
        zoom_geometric!=FALSE
      ELSE
        ' Growing: 1.189207^4 = 2, factors 1/16, 1/8 .. 1.
        zoom_t=.03125
        zoom_step=1.189207115003
        zoom_step=zoom_step^4
        zoom_geometric!=TRUE
        MUL zoom_t,zoom_step
      ENDIF
    ENDIF
    zoom_t0=zoom_t
    ' Pass 0 draws the frames, pass 1 draws them again to remove them (XOR, colour 15).
    FOR y_or_j&=0 TO 1
      zoom_t=zoom_t0
      FOR ix&=0 TO 4
        VSYNC
        zoom_cur_x1&=ADD(zoom_dx1&*zoom_t,rect_x1&)
        zoom_cur_y1&=ADD(zoom_dy1&*zoom_t,rect_ay&)
        zoom_cur_x2&=ADD(zoom_dx2&*zoom_t,rect_x2&)
        zoom_cur_y2&=ADD(zoom_dy2&*zoom_t,y_bottom&)
        ALINE zoom_cur_x1&,SUCC(zoom_cur_y1&),zoom_cur_x1&,PRED(zoom_cur_y2&),15,-1,2
        ALINE zoom_cur_x2&,SUCC(zoom_cur_y1&),zoom_cur_x2&,PRED(zoom_cur_y2&),15,-1,2
        HLINE zoom_cur_x1&,zoom_cur_y1&,zoom_cur_x2&,15,2,V:pattern_solid%,1
        HLINE zoom_cur_x1&,zoom_cur_y2&,zoom_cur_x2&,15,2,V:pattern_solid%,1
        IF zoom_geometric!
          MUL zoom_t,zoom_step
        ELSE
          zoom_t=zoom_t+zoom_step
        ENDIF
      NEXT ix&
    NEXT y_or_j&
  ENDIF
RETURN
' Stores the absolute rectangle of object addr% (origin origin_x&,origin_y&) in zoom_x1&..zoom_y2&,
' the box the next dialog zooms out of.
PROCEDURE obj_rect_store(addr%,origin_x&,origin_y&)
  zoom_x1&=origin_x&+INT{addr%+8}
  zoom_y1&=origin_y&+INT{addr%+10}
  zoom_x2&=origin_x&+INT{addr%+16}
  zoom_y2&=origin_y&+INT{addr%+18}
RETURN
' Draws object shape shape_p% (obj+8) at offset ofs_x&,ofs_y& in its selected look.  Draw type
' obj_draw_mode& (low 4 bits): 1 = invert the shape, 2/4 = move the image down-right by the shadow offset
' and fill the uncovered top/left strip (4 = lighter pattern), 3 = draw the selected image at
' spec offset image_ofs%.  The object shape is 4 points; points 2 and 4 zero = plain rectangle.
PROCEDURE obj_draw_selected(shape_p%,ofs_x&,ofs_y&,obj_draw_mode&,image_ofs%)
  LOCAL ix&,lo_n&,range_max&,rect_x1&,box_x1&,rect_ay&,rect_y1&,work_ptr%
  obj_draw_mode&=obj_draw_mode& AND 15
  rect_x1&=ofs_x&+INT{shape_p%}
  rect_ay&=ofs_y&+INT{shape_p%+2}
  box_x1&=ofs_x&+INT{shape_p%+8}
  rect_y1&=ofs_y&+INT{shape_p%+10}
  $S>
  SELECT obj_draw_mode&
  CASE 1
    pointer_hide
    ' Rectangle: XOR fill; otherwise a 4-point polygon through APOLY.
    IF LONG{shape_p%+4}=0 AND LONG{shape_p%+12}=0
      FOR ix&=0 TO 12 STEP 4
        CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
        CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
      NEXT ix&
      ARECT INT{poly_points%},INT{poly_points%+2},INT{poly_points%+8},INT{poly_points%+10},15,2,V:pattern_solid%,1
    ELSE
      lo_n&=screen_max_y&
      range_max&=0
      FOR ix&=0 TO 12 STEP 4
        CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
        CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
        lo_n&=MIN(lo_n&,INT{poly_points%+ix&+2})
        range_max&=MAX(range_max&,INT{poly_points%+ix&+2})
      NEXT ix&
      LONG{poly_points%+16}=LONG{poly_points%}
      APOLY poly_points%,4,lo_n&,range_max&,15,2,V:pattern_solid%,1
    ENDIF
    pointer_show
  CASE 2,4
    pointer_hide
    ' Line-A BITBLT block: width, height, planes, colours 15/0, replace ($03030303), source at the
    ' object, destination shifted by shadow_dx&,shadow_dy&, both on the screen.
    blit_params%(0)=box_x1&-rect_x1&+1
    blit_params%(1)=rect_y1&-rect_ay&+1
    blit_params%(2)=screen_planes&
    blit_params%(3)=15
    blit_params%(4)=0
    blit_params%(5)=50529027
    blit_params%(6)=ofs_x&+INT{shape_p%}
    blit_params%(7)=ofs_y&+INT{shape_p%+2}
    blit_params%(8)=XBIOS(3)
    blit_params%(9)=blit_nxwd&
    blit_params%(10)=screen_line_bytes&
    blit_params%(11)=2
    blit_params%(12)=shadow_dx&+(ofs_x&+INT{shape_p%})
    blit_params%(13)=shadow_dy&+(ofs_y&+INT{shape_p%+2})
    blit_params%(14)=XBIOS(3)
    blit_params%(15)=blit_nxwd&
    blit_params%(16)=screen_line_bytes&
    blit_params%(17)=2
    blit_params%(18)=0
    blit_params%(19)=0
    blit_params%(20)=0
    blit_params%(21)=0
    blit_params%(22)=0
    BITBLT blit_params%()
    ' Fill the strip left at the top and left edge.
    IF mono!
      image_ofs%=pattern_grey%
      IF obj_draw_mode&=4
        image_ofs%=pattern_light%
      ENDIF
      ARECT rect_x1&,rect_ay&,box_x1&,rect_ay&+shadow_dy&-1,1,0,V:image_ofs%,1
      ARECT rect_x1&,rect_ay&+shadow_dy&,rect_x1&+shadow_dx&-1,rect_y1&,1,0,V:image_ofs%,1
    ELSE
      ARECT rect_x1&,rect_ay&,box_x1&,rect_ay&+shadow_dy&-1,1-(obj_draw_mode&=4),0,V:pattern_solid%,1
      ARECT rect_x1&,rect_ay&+shadow_dy&,rect_x1&+shadow_dx&-1,rect_y1&,1-(obj_draw_mode&=4),0,V:pattern_solid%,1
    ENDIF
    pointer_show
  CASE 3
    pointer_hide
    image_blit(ofs_x&+INT{shape_p%},ofs_y&+INT{shape_p%+2},rsc_data%+image_ofs%)
    pointer_show
  ENDSELECT
RETURN
' Draws object shape shape_p% at offset ofs_x&,ofs_y& in its normal look: the reverse of obj_draw_selected.
' Type 1 inverts again, 2/4 move the image back up-left and draw the shadow strip below and to the
' right in colour 15, 3 draws the normal image at spec offset image_ofs%.
PROCEDURE obj_draw_normal(shape_p%,ofs_x&,ofs_y&,obj_draw_mode&,image_ofs%)
  LOCAL ix&,lo_n&,range_max&,rect_x1&,box_x1&,rect_ay&,rect_y1&,work_ptr%
  obj_draw_mode&=obj_draw_mode& AND 15
  rect_x1&=ofs_x&+INT{shape_p%}
  rect_ay&=ofs_y&+INT{shape_p%+2}
  box_x1&=ofs_x&+INT{shape_p%+8}
  rect_y1&=ofs_y&+INT{shape_p%+10}
  SELECT obj_draw_mode&
  CASE 1
    pointer_hide
    IF LONG{shape_p%+4}=0 AND LONG{shape_p%+12}=0
      FOR ix&=0 TO 12 STEP 4
        CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
        CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
      NEXT ix&
      ARECT INT{poly_points%},INT{poly_points%+2},INT{poly_points%+8},INT{poly_points%+10},15,2,V:pattern_solid%,1
    ELSE
      lo_n&=screen_max_y&
      range_max&=0
      FOR ix&=0 TO 12 STEP 4
        CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
        CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
        lo_n&=MIN(lo_n&,INT{poly_points%+ix&+2})
        range_max&=MAX(range_max&,INT{poly_points%+ix&+2})
      NEXT ix&
      LONG{poly_points%+16}=LONG{poly_points%}
      APOLY poly_points%,4,lo_n&,range_max&,15,2,V:pattern_solid%,1
    ENDIF
    pointer_show
  CASE 2,4
    pointer_hide
    ' Source is the shifted image, destination the object position.
    blit_params%(0)=box_x1&-rect_x1&+1
    blit_params%(1)=rect_y1&-rect_ay&+1
    blit_params%(2)=screen_planes&
    blit_params%(3)=15
    blit_params%(4)=0
    blit_params%(5)=50529027
    blit_params%(6)=shadow_dx&+(ofs_x&+INT{shape_p%})
    blit_params%(7)=shadow_dy&+(ofs_y&+INT{shape_p%+2})
    blit_params%(8)=XBIOS(3)
    blit_params%(9)=blit_nxwd&
    blit_params%(10)=screen_line_bytes&
    blit_params%(11)=2
    blit_params%(12)=ofs_x&+INT{shape_p%}
    blit_params%(13)=ofs_y&+INT{shape_p%+2}
    blit_params%(14)=XBIOS(3)
    blit_params%(15)=blit_nxwd&
    blit_params%(16)=screen_line_bytes&
    blit_params%(17)=2
    blit_params%(18)=0
    blit_params%(19)=0
    blit_params%(20)=0
    blit_params%(21)=0
    blit_params%(22)=0
    BITBLT blit_params%()
    ' Shadow strips along the bottom and right edge.
    ARECT rect_x1&+shadow_dx&,SUCC(rect_y1&),box_x1&+shadow_dx&,rect_y1&+shadow_dy&,15,0,V:pattern_solid%,1
    ARECT SUCC(box_x1&),rect_ay&+shadow_dy&,box_x1&+shadow_dx&,rect_y1&,15,0,V:pattern_solid%,1
    pointer_show
  CASE 3
    pointer_hide
    image_blit(ofs_x&+INT{shape_p%},ofs_y&+INT{shape_p%+2},rsc_data%+image_ofs%)
    pointer_show
  ENDSELECT
RETURN
' Copies image work_ptr% to the screen at ofs_x&,ofs_y& with the Line-A BITBLT.  Image format:
' WORD width-1, WORD height-1, WORD planes, then the data interleaved like the screen.
PROCEDURE image_blit(ofs_x&,ofs_y&,work_ptr%)
  blit_params%(0)=INT{work_ptr%}+1
  blit_params%(1)=INT{work_ptr%+2}+1
  blit_params%(2)=INT{work_ptr%+4}
  blit_params%(3)=15
  blit_params%(4)=0
  blit_params%(5)=50529027
  blit_params%(6)=0
  blit_params%(7)=0
  blit_params%(8)=work_ptr%+6
  blit_params%(9)=MUL(INT{work_ptr%+4},2)
  blit_params%(10)=((INT{work_ptr%}+16) DIV 16)*blit_nxwd&
  blit_params%(11)=2
  blit_params%(12)=ofs_x&
  blit_params%(13)=ofs_y&
  blit_params%(14)=XBIOS(3)
  blit_params%(15)=blit_nxwd&
  blit_params%(16)=screen_line_bytes&
  blit_params%(17)=2
  blit_params%(18)=0
  blit_params%(19)=0
  blit_params%(20)=0
  blit_params%(21)=0
  blit_params%(22)=0
  BITBLT blit_params%()
RETURN
' Fills object shape shape_p% at offset ofs_x&,ofs_y& with colour y_centre&, pattern pattern_addr% and writing
' mode line_pattern&: a rectangle when points 2 and 4 are zero, else a 4-point polygon.
PROCEDURE shape_paint(shape_p%,ofs_x&,ofs_y&,y_centre&,line_pattern&,pattern_addr%)
  LOCAL ix&,lo_n&,range_max&
  IF LONG{shape_p%+4}=0 AND LONG{shape_p%+12}=0
    FOR ix&=0 TO 12 STEP 4
      CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
      CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
    NEXT ix&
    ARECT INT{poly_points%},INT{poly_points%+2},INT{poly_points%+8},INT{poly_points%+10},y_centre&,0,pattern_addr%,line_pattern&
  ELSE
    lo_n&=screen_max_y&
    range_max&=0
    FOR ix&=0 TO 12 STEP 4
      CARD{poly_points%+ix&}=ofs_x&+INT{shape_p%+ix&}
      CARD{poly_points%+ix&+2}=ofs_y&+INT{shape_p%+ix&+2}
      lo_n&=MIN(lo_n&,INT{poly_points%+ix&+2})
      range_max&=MAX(range_max&,INT{poly_points%+ix&+2})
    NEXT ix&
    LONG{poly_points%+16}=LONG{poly_points%}
    APOLY poly_points%,4,lo_n&,range_max&,y_centre&,0,pattern_addr%,line_pattern&
  ENDIF
RETURN
' Returns the bounding box of object shape shape_p% in rect_x1&,rect_ay&-box_x1&,rect_y1&.
' Points 2 and 4 are counted only for polygon shapes.
PROCEDURE shape_bounds(shape_p%,VAR rect_x1&,rect_ay&,box_x1&,rect_y1&)
  LOCAL ix&
  rect_x1&=screen_max_x&
  box_x1&=0
  rect_ay&=screen_max_y&
  rect_y1&=0
  FOR ix&=0 TO 12 STEP 4
    IF ix&<>4 AND ix&<>12 OR LONG{shape_p%+4}<>0 OR LONG{shape_p%+12}<>0
      rect_x1&=MIN(rect_x1&,INT{shape_p%+ix&})
      box_x1&=MAX(box_x1&,INT{shape_p%+ix&})
      rect_ay&=MIN(rect_ay&,INT{shape_p%+ix&+2})
      rect_y1&=MAX(rect_y1&,INT{shape_p%+ix&+2})
    ENDIF
  NEXT ix&
RETURN
' Horizontal slider obj_ptr%: works out the thumb's x range knob_start&..knob_end& from the spec
' (+0 min, +2 max, +8 position, +10 visible size).  With min = max the thumb fills the slider.
PROCEDURE slider_thumb_h(obj_ptr%)
  work_ptr%=rsc_data%+LONG{obj_ptr%+24}
  IF INT{work_ptr%}=INT{work_ptr%+2}
    knob_start&=INT{obj_ptr%+8}
    knob_end&=INT{obj_ptr%+16}
  ELSE
    aux&=INT{work_ptr%+2}-INT{work_ptr%}
    num_val&=SUCC(INT{obj_ptr%+16}-INT{obj_ptr%+8})
    knob_start&=MUL(num_val&,INT{work_ptr%+8}-INT{work_ptr%}) DIV aux&+INT{obj_ptr%+8}
    knob_end&=PRED(MUL(num_val&,INT{work_ptr%+8}+INT{work_ptr%+10}-INT{work_ptr%}) DIV aux&+INT{obj_ptr%+8})
    knob_start&=MAX(knob_start&,INT{obj_ptr%+8})
    ' Keep the thumb inside the slider and at least one pixel wide.
    knob_end&=MIN(knob_end&,INT{obj_ptr%+16})
    IF knob_end&<knob_start&
      knob_end&=knob_start&
    ENDIF
  ENDIF
RETURN
' Vertical slider obj_ptr%: the thumb's y range knob_start&..knob_end&, as slider_thumb_h.
PROCEDURE slider_thumb_v(obj_ptr%)
  work_ptr%=rsc_data%+LONG{obj_ptr%+24}
  IF INT{work_ptr%}=INT{work_ptr%+2}
    knob_start&=INT{obj_ptr%+10}
    knob_end&=INT{obj_ptr%+18}
  ELSE
    aux&=INT{work_ptr%+2}-INT{work_ptr%}
    num_val&=SUCC(INT{obj_ptr%+18}-INT{obj_ptr%+10})
    knob_start&=MUL(num_val&,INT{work_ptr%+8}-INT{work_ptr%}) DIV aux&+INT{obj_ptr%+10}
    knob_end&=PRED(MUL(num_val&,INT{work_ptr%+8}+INT{work_ptr%+10}-INT{work_ptr%}) DIV aux&+INT{obj_ptr%+10})
    knob_start&=MAX(knob_start&,INT{obj_ptr%+10})
    knob_end&=MIN(knob_end&,INT{obj_ptr%+18})
    IF knob_end&<knob_start&
      knob_end&=knob_start&
    ENDIF
  ENDIF
RETURN
' Finds tree header dialog_id& between tree_first% and tree_end%; returns its address in obj_ptr%
' (tree_end% when not found).  Header: +0 id, +2 size of the tree in bytes.
PROCEDURE tree_find(dialog_id&,VAR obj_ptr%)
  obj_ptr%=tree_first%
  WHILE obj_ptr%<tree_end%
    EXIT IF dialog_id&=INT{obj_ptr%}
    obj_ptr%=obj_ptr%+INT{obj_ptr%+2}
  WEND
RETURN
' Finds object obj_num& of tree dialog_id& and returns its address in obj_ptr%.  Objects are 28 bytes from
' header+20: +0 number, +3 type, +5 draw type, +6 parent, +8 shape (4 points), +24 spec offset.
PROCEDURE obj_find(dialog_id&,obj_num&,VAR obj_ptr%)
  LOCAL obj_end%
  tree_find(dialog_id&,obj_ptr%)
  obj_end%=obj_ptr%+INT{obj_ptr%+2}
  obj_ptr%=obj_ptr%+20
  WHILE obj_ptr%<obj_end%
    EXIT IF obj_num&=INT{obj_ptr%}
    obj_ptr%=obj_ptr%+28
  WEND
RETURN
' Finds the selected radio button (type 2, spec +10 = group group_id&, spec +8 set) in tree dialog_id&.
' Returns its address in obj_ptr%, or 0 when no button of the group is selected.
PROCEDURE radio_find_selected(dialog_id&,group_id&,VAR obj_ptr%)
  LOCAL obj_end%
  tree_find(dialog_id&,obj_ptr%)
  obj_end%=obj_ptr%+INT{obj_ptr%+2}
  obj_ptr%=obj_ptr%+20
  WHILE obj_ptr%<obj_end%
    EXIT IF BYTE{obj_ptr%+3}=2 AND group_id&=INT{rsc_data%+LONG{obj_ptr%+24}+10} AND INT{rsc_data%+LONG{obj_ptr%+24}+8}
    obj_ptr%=obj_ptr%+28
  WEND
  IF obj_ptr%=obj_end%
    obj_ptr%=0
  ENDIF
RETURN
' Returns spec +8 (slider position) and +10 (size) of object obj_num& in tree dialog_id&.
PROCEDURE slider_value_query(dialog_id&,obj_num&,VAR slider_value&,slider_size&)
  LOCAL work_ptr%
  obj_find(dialog_id&,obj_num&,work_ptr%)
  work_ptr%=rsc_data%+LONG{work_ptr%+24}
  slider_value&=INT{work_ptr%+8}
  slider_size&=INT{work_ptr%+10}
RETURN
' Returns the text of object obj_num& in tree dialog_id& (spec +14 length, +16 text), trailing spaces cut.
PROCEDURE obj_text_query(dialog_id&,obj_num&,VAR txt$)
  LOCAL obj_found%
  obj_find(dialog_id&,obj_num&,obj_found%)
  obj_found%=rsc_data%+LONG{obj_found%+24}
  txt$=SPACE$(INT{obj_found%+14})
  BMOVE obj_found%+16,V:txt$,INT{obj_found%+14}
  WHILE RIGHT$(txt$)=" "
    txt$=LEFT$(txt$,LEN(txt$)-1)
  WEND
RETURN
' Absolute position object_x&,object_y& of the object at work_ptr% (the caller's variable, obj_num& is not
' used) in a dialog at origin_x&,origin_y&, adding the offsets of every parent object.
PROCEDURE obj_abs_pos(dialog_id&,obj_num&,origin_x&,origin_y&,VAR object_x&,object_y&)
  object_x&=origin_x&
  object_y&=origin_y&
  IF INT{work_ptr%+6}
    obj_clicked%=work_ptr%
    DO
      parent_obj&=INT{work_ptr%+6}
      EXIT IF parent_obj&=0
      obj_find(dialog_id&,parent_obj&,work_ptr%)
      object_x&=object_x&+INT{work_ptr%+8}
      object_y&=object_y&+INT{work_ptr%+10}
    LOOP
    work_ptr%=obj_clicked%
  ENDIF
  object_x&=object_x&+INT{work_ptr%+8}
  object_y&=object_y&+INT{work_ptr%+10}
RETURN
' Draws every other selected button of radio group group_id& in tree dialog_id& (dialog at origin_x&,origin_y&)
' in its normal look and clears its selected flag.  work_ptr% is the button being selected now.
PROCEDURE radio_others_off(dialog_id&,group_id&,origin_x&,origin_y&,work_ptr%)
  LOCAL obj_ptr%,obj_end%,end_pointer%,object_x&,object_y&
  pointer_hide
  tree_find(dialog_id&,obj_ptr%)
  obj_end%=obj_ptr%+INT{obj_ptr%+2}
  obj_ptr%=obj_ptr%+20
  WHILE obj_ptr%<obj_end%
    IF BYTE{obj_ptr%+3}=2
      IF group_id&=INT{rsc_data%+LONG{obj_ptr%+24}+10} AND obj_ptr%<>work_ptr%
        IF INT{rsc_data%+LONG{obj_ptr%+24}+8}
          object_x&=origin_x&
          object_y&=origin_y&
          ' Absolute position through the parent chain.
          IF INT{obj_ptr%+6}
            end_pointer%=obj_ptr%
            DO
              parent_obj&=INT{obj_ptr%+6}
              EXIT IF parent_obj&=0
              obj_find(dialog_id&,parent_obj&,obj_ptr%)
              object_x&=object_x&+INT{obj_ptr%+8}
              object_y&=object_y&+INT{obj_ptr%+10}
            LOOP
            obj_ptr%=end_pointer%
          ENDIF
          obj_draw_normal(obj_ptr%+8,object_x&,object_y&,BYTE{obj_ptr%+5},LONG{rsc_data%+LONG{obj_ptr%+24}})
          CARD{rsc_data%+LONG{obj_ptr%+24}+8}=0
        ENDIF
      ENDIF
    ENDIF
    obj_ptr%=obj_ptr%+28
  WEND
RETURN
' Selects radio button obj_num& of tree dialog_id& (group group_id&) and clears the other buttons of the group.
' Only the flags change; nothing is redrawn.
PROCEDURE radio_set(dialog_id&,group_id&,obj_num&)
  LOCAL obj_ptr%,obj_end%,work_ptr%
  obj_find(dialog_id&,obj_num&,work_ptr%)
  tree_find(dialog_id&,obj_ptr%)
  obj_end%=obj_ptr%+INT{obj_ptr%+2}
  obj_ptr%=obj_ptr%+20
  WHILE obj_ptr%<obj_end%
    IF BYTE{obj_ptr%+3}=2
      IF group_id&=INT{rsc_data%+LONG{obj_ptr%+24}+10} AND obj_ptr%<>work_ptr%
        IF INT{rsc_data%+LONG{obj_ptr%+24}+8}
          CARD{rsc_data%+LONG{obj_ptr%+24}+8}=0
        ENDIF
      ENDIF
    ENDIF
    obj_ptr%=obj_ptr%+28
  WEND
  CARD{rsc_data%+LONG{work_ptr%+24}+8}=-1
RETURN
' Sets slider obj_num& of tree dialog_id&: spec +0 min, +2 max, +4 step down, +6 step up (arrow clicks),
' +8 position, +10 visible size.
PROCEDURE slider_setup(dialog_id&,obj_num&,lo_n&,range_max&,delta_down&,delta_up&,slider_value&,slider_size&)
  LOCAL work_ptr%
  obj_find(dialog_id&,obj_num&,work_ptr%)
  work_ptr%=rsc_data%+LONG{work_ptr%+24}
  CARD{work_ptr%}=lo_n&
  CARD{work_ptr%+2}=range_max&
  CARD{work_ptr%+4}=delta_down&
  CARD{work_ptr%+6}=delta_up&
  CARD{work_ptr%+8}=slider_value&
  CARD{work_ptr%+10}=slider_size&
RETURN
' Sets position slider_value& and size slider_size& of slider obj_num& in tree dialog_id&.
PROCEDURE slider_set_pos(dialog_id&,obj_num&,slider_value&,slider_size&)
  LOCAL work_ptr%
  obj_find(dialog_id&,obj_num&,work_ptr%)
  work_ptr%=rsc_data%+LONG{work_ptr%+24}
  CARD{work_ptr%+8}=slider_value&
  CARD{work_ptr%+10}=slider_size&
RETURN
' TRUE when point ix&,y_or_j& lies in rectangle shape obj_ptr%.  For polygon shapes it returns
' without a value, which gives 0.
FUNCTION rect_hit(ix&,y_or_j&,obj_ptr%)
  $F%
  IF LONG{obj_ptr%+4}=0 AND LONG{obj_ptr%+12}=0
    IF ix&>=INT{obj_ptr%} AND ix&<=INT{obj_ptr%+8} AND y_or_j&>=INT{obj_ptr%+2} AND y_or_j&<=INT{obj_ptr%+10}
      RETURN -1
    ELSE
      RETURN 0
    ENDIF
  ENDIF
ENDFUNC
' TRUE when the mouse is inside clickable object obj_ptr% (type below 128) of a dialog at origin_x&,origin_y&.
' It tests the caller's click_x&,click_y& instead of ix&,y_or_j& (callers pass the same values) and
' uses the caller's dialog_id& as the tree id.
FUNCTION obj_hit(ix&,y_or_j&,origin_x&,origin_y&,obj_ptr%)
  $F%
  LOCAL object_x&,object_y&,work_ptr%
  IF BYTE{obj_ptr%+3}<128
    object_x&=origin_x&
    object_y&=origin_y&
    ' Add the offsets of the parent objects.
    IF INT{obj_ptr%+6}
      work_ptr%=obj_ptr%
      DO
        parent_obj&=INT{obj_ptr%+6}
        EXIT IF parent_obj&=0
        obj_find(dialog_id&,parent_obj&,obj_ptr%)
        object_x&=object_x&+INT{obj_ptr%+8}
        object_y&=object_y&+INT{obj_ptr%+10}
      LOOP
      obj_ptr%=work_ptr%
    ENDIF
    IF click_x&>=object_x&+INT{obj_ptr%+8} AND click_x&<=object_x&+INT{obj_ptr%+16} AND click_y&>=object_y&+INT{obj_ptr%+10} AND click_y&<=object_y&+INT{obj_ptr%+18}
      RETURN -1
    ELSE
      RETURN 0
    ENDIF
  ELSE
    RETURN 0
  ENDIF
ENDFUNC
' File selector.  mask_spec$ = filter list ("*.AVR|*.SPL|..."), path_dir$ = folder (updated), fname$ =
' file name (updated), ok_flag! = TRUE when a file was chosen.  With fsel_type&=1 it calls the GEM file
' selector and redraws the main screen, else it runs Sound Lab's own selector (tree 1) with a path
' remembered per drive, a filter popup (tree 2) and the title set by filesel_title_set.
PROCEDURE filesel_run(mask_spec$,VAR path_dir$,fname$,ok_flag!)
  LOCAL obj_found%,cursor_top&,cursor_bottom&,work_str$,aux&,saved_flag!
  IF fsel_type&=1
    ' No folder yet: current drive (GEMDOS 25 Dgetdrv) and folder.
    IF path_dir$=""
      path_dir$=CHR$(65+GEMDOS(25))+":"+DIR$(0)+"\"
    ENDIF
    work_str$=SPACE$(32)
    ' Title text from tree 1 object 37 (spec +12, 32 characters).
    obj_find(1,37,obj_found%)
    BMOVE 12+(rsc_data%+LONG{obj_found%+24}),V:work_str$,32
    work_str$=TRIM$(work_str$)
    ' fsel_exinput on AES 1.04 and later, else fsel_input.
    selector_call(work_str$,path_dir$+"*.*",fname$,work_str$,aux&)
    ok_flag!=aux&<>0
    IF ok_flag!
      path_dir$=LEFT$(work_str$,RINSTR(work_str$,"\"))
      fname$=MID$(work_str$,LEN(path_dir$)+1)
    ENDIF
    ' Redraw the main screen and its panels without zoom effects.
    saved_flag!=zoom_enabled!
    zoom_enabled!=FALSE
    screen_frame_draw
    dialog_draw(4)
    IF shift_mode!
      buttons_buffer_mode
    ENDIF
    ' active_dialog& and obj_num& belong to the calling dialog_run: show the main screen button pressed again.
    IF active_dialog&=4
      obj_find(4,obj_num&,obj_found%)
      obj_draw_selected(obj_found%+8,0,0,BYTE{obj_found%+5},0)
    ENDIF
    trace_draw
    status_name_draw
    status_block_draw
    memory_size_draw
    status_zoom_draw
    overview_bar_draw
    ' Called from the echo dialog (tree 14): redraw it over the main screen.
    SELECT active_dialog&
    CASE 14
      obj_find(4,17,obj_found%)
      obj_draw_selected(obj_found%+8,0,0,BYTE{obj_found%+5},0)
      dialog_draw(14)
      obj_find(14,obj_num&,obj_found%)
      obj_draw_selected(obj_found%+8,origin_x&,origin_y&,BYTE{obj_found%+5},0)
    ENDSELECT
    zoom_enabled!=saved_flag!
  ELSE
    ' Own selector: start in the folder last used on this drive, else the drive's current folder.
    IF path_dir$=""
      path_dir$=drive_paths$(filesel_drive&)
      IF path_dir$=""
        path_dir$=CHR$(filesel_drive&+65)+":"+DIR$(SUCC(filesel_drive&))+"\"
      ENDIF
    ENDIF
    filesel_drive&=ASC(path_dir$)-65
    ' Clear the file picked last time.
    IF filesel_picked_obj&>0
      obj_find(1,filesel_picked_obj&,obj_found%)
      CARD{rsc_data%+LONG{obj_found%+24}+8}=0
      filesel_picked_obj&=0
    ENDIF
    filesel_filter$=mask_spec$
    radio_find_selected(2,1,obj_found%)
    ' A new filter list: select its entry (object 3) in the popup and re-read the directory.
    IF mask_spec$<>filesel_prev_filter$
      filesel_listed$=""
      CARD{rsc_data%+LONG{obj_found%+24}+8}=0
      obj_find(2,3,obj_found%)
      CARD{rsc_data%+LONG{obj_found%+24}+8}=-1
    ELSE
      ' Same list as last time: keep the filter picked then (4 = *.*, 5..12 = user filters).
      IF INT{obj_found%}>4
        obj_text_query(2,INT{obj_found%}+8,mask_spec$)
      ELSE
        IF INT{obj_found%}=4
          mask_spec$="*.*"
        ENDIF
      ENDIF
    ENDIF
    ' File name in 8+4 layout into the name field (object 34).
    fname_pad_83(fname$)
    obj_find(1,34,obj_found%)
    BMOVE V:fname$,16+(rsc_data%+LONG{obj_found%+24}),12
    cursor_top&=-2-mono!
    cursor_bottom&=2
    ' Floppy drive: force a media change, then read the directory.
    IF filesel_drive&<2
      media_change_force(filesel_drive&)
      filesel_dir_scan(path_dir$)
    ENDIF
    dialog_run(1,choice&)
    obj_text_query(1,34,fname$)
    strip_spaces(fname$)
    filesel_prev_filter$=filesel_filter$
    drive_paths$(filesel_drive&)=path_dir$
    IF choice&=1  !button 1 = OK
      ok_flag!=TRUE
    ELSE
      ok_flag!=FALSE
    ENDIF
    ~FRE(0)
  ENDIF
RETURN
' Sets the title of the next file selector (tree 1 object 37, 32 characters padded with spaces).
PROCEDURE filesel_title_set(work_str$)
  LOCAL obj_found%
  work_str$=work_str$+SPACE$(32)
  obj_find(1,37,obj_found%)
  BMOVE V:work_str$,12+(rsc_data%+LONG{obj_found%+24}),32
RETURN
' User-object handler of the own file selector (trees 1-3), for drawing and for clicks.
' obj_num& = object, origin_x&,origin_y& = dialog origin.  Objects: 2 drive_popup, 3 re-read, 4 filter
' popup, 5 parent folder, 6 path line, 7..30 the 24 list slots, 31/33 scroll up/down, 32 list
' slider, 41 filter text, 60 path, list and drive letter.
PROCEDURE filesel_obj_action(dialog_id&,obj_num&,origin_x&,origin_y&)
  LOCAL obj_found%,work_long%,ix&,work_text$
  $S<
  SELECT obj_num&
  CASE 60
    ' Object 60: path line, directory read, whole list, drive letter.
    filesel_path_draw(path_dir$)
    filesel_dir_scan(path_dir$)
    filesel_list_draw(0,23)
    filesel_drive_draw(0,0)
  CASE 7 TO 30
    ' List slot clicked: entry number = slot - 7 + scroll position (list slider spec +8).
    obj_find(1,32,obj_found%)
    obj_found%=SUCC(rsc_data%+LONG{obj_found%+24})+7
    IF obj_num&<>filesel_picked_obj&
      IF filesel_entry_count&>PRED(obj_num&+INT{obj_found%})-6
        ' A ">" entry is a folder: open it.
        IF BYTE{ADD((obj_num&+INT{obj_found%}-7)*16,filesel_list_addr%)}=62
          filesel_picked_obj&=obj_num&
          work_text$=CHAR{ADD((obj_num&+INT{obj_found%}-7)*16,filesel_list_addr%)+1}
          strip_spaces(work_text$)
          path_dir$=path_dir$+work_text$+"\"
          filesel_refresh
        ELSE
          ' A file: copy its name into the name field (object 34) and redraw it.
          obj_find(1,34,work_long%)
          BMOVE ADD((obj_num&+INT{obj_found%}-7)*16,filesel_list_addr%)+1,16+(rsc_data%+LONG{work_long%+24}),12
          edit_object&=-1
          dialog_object_draw(work_long%,origin_x&,origin_y&,-1)
          pointer_show
          filesel_picked_obj&=obj_num&
        ENDIF
      ELSE
        ' Click below the last entry: nothing picked.
        filesel_picked_obj&=0
        pointer_show
      ENDIF
    ENDIF
  CASE 5
    ' Object 5: go up to the parent folder.
    IF LEN(path_dir$)>3
      path_dir$=LEFT$(path_dir$,RINSTR(path_dir$,"\",LEN(path_dir$)-1))
      filesel_refresh
    ENDIF
  CASE 4
    ' Object 4: filter popup; take the filter chosen in tree 2 (3 = caller's list, 4 = *.*).
    cursor_top&=-2
    cursor_bottom&=2
    work_text$=mask_spec$
    radio_find_selected(2,1,obj_found%)
    SELECT INT{obj_found%}
    CASE 3
      mask_spec$=filesel_filter$
    CASE 4
      mask_spec$="*.*"
    CASE 5 TO 12
      obj_text_query(2,INT{obj_found%}+8,mask_spec$)
      IF mask_spec$=""
        mask_spec$=work_text$
      ENDIF
    ENDSELECT
    IF mask_spec$<>work_text$
      filesel_listed$=""  !forces the directory to be read again
      filesel_refresh
    ENDIF
  CASE 3
    ' Object 3: re-read the directory.
    filesel_listed$=""
    filesel_refresh
  CASE 2
    drive_popup
  CASE 31
    filelist_scroll_up
  CASE 32
    ' Object 32 (list slider): drop the pick and align the scroll position to a whole row of 3.
    IF filesel_picked_obj&>0
      obj_find(1,filesel_picked_obj&,obj_found%)
      CARD{rsc_data%+LONG{obj_found%+24}+8}=0
      filesel_picked_obj&=0
    ENDIF
    obj_find(1,32,obj_found%)
    work_long%=SUCC(rsc_data%+LONG{obj_found%+24})+7
    IF INT{work_long%} MOD 3<>0
      CARD{work_long%}=INT{work_long%}-MOD(INT{work_long%},3)
      dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
    ENDIF
    filesel_list_draw(0,23)
    pointer_show
  CASE 33
    filelist_scroll_down
  CASE 6
    ' Object 6 (path line): cut the path after the folder under the mouse pointer.
    obj_found%=@font_find(3)
    ix&=@pointer_x-origin_x&-4
    work_text$=LEFT$(path_dir$,3)
    WHILE @pixel_width_of(obj_found%,work_text$)<ix& AND (work_text$<>path_dir$)
      work_text$=LEFT$(path_dir$,INSTR(path_dir$,"\",LEN(work_text$)+1))
    WEND
    path_dir$=work_text$
    IF path_dir$<>filesel_listed$
      filesel_refresh
    ENDIF
  CASE 41
    ' Object 41: the caller's filter list, at most 21 characters, with a shadow.
    pointer_hide
    font_attr_set(0,0,0,0,1)
    font_attr_set(1,0,0,6,0)
    work_text$=filesel_filter$
    IF LEN(work_text$)>22
      work_text$=LEFT$(work_text$,21)
    ENDIF
    IF mono!
      ix&=43
    ELSE
      ix&=21
    ENDIF
    txt_draw(33+origin_x&,origin_y&+ix&+shadow_dy&,work_text$)
    font_attr_set(0,0,0,6,0)
    txt_draw(29+origin_x&,origin_y&+ix&,work_text$)
    cursor_top&=0
    cursor_bottom&=-2
  ENDSELECT
RETURN
' Re-reads the directory path_dir$ (when not already listed) and redraws the path line and the list.
' Uses the caller's obj_found%, origin_x& and origin_y&.
PROCEDURE filesel_refresh
  IF filesel_picked_obj&>0
    obj_find(1,filesel_picked_obj&,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=0
    filesel_picked_obj&=0
  ENDIF
  filesel_path_draw(path_dir$)
  filesel_dir_scan(path_dir$)
  filesel_list_draw(0,23)
  obj_find(1,32,obj_found%)
  dialog_object_draw(obj_found%,origin_x&,origin_y&,-1)
  pointer_show
RETURN
' Sets up the own file selector: drive_paths$() = last path per drive A..P, a 6400-byte list buffer
' (400 entries of 16 bytes), the current drive, and empty filters.
PROCEDURE filesel_init
  LOCAL ix&,unused_l%
  DIM drive_paths$(15)
  ' Does nothing: the loop only skips B: when one floppy is connected (_nflops, $4A6).
  FOR ix&=0 TO 15
    IF ix&=1 AND DPEEK(1190)=1
      INC ix&
    ENDIF
  NEXT ix&
  DIM filesel_list|(6399)
  filesel_list_addr%=V:filesel_list|(0)
  ARRAYFILL filesel_list|(),0
  filesel_listed$=""
  filesel_picked_obj&=0
  filesel_drive&=GEMDOS(25)  !Dgetdrv
  filesel_filter$=""
  filesel_prev_filter$=""
RETURN
' File selector keys.  Alt+A..Alt+P (128 + the letters' scan codes) switch drive when the drive
' exists; the current drive's key re-reads it.  F1..F10 (128 + $3B..$44) pick a filter:
' F1 the caller's list, F2 *.*, F3..F10 the user filters (popup objects 5..12, text in 13..20).
PROCEDURE filesel_key(key_code&)
  LOCAL work_text$,key_inp&,obj_found%
  work_text$="ž°® ’¡¢£—¤¥¦²±˜™"
  key_inp&=INSTR(work_text$,CHR$(key_code&))
  IF key_inp&=0
    SELECT key_code&
    CASE 187 TO 196
      work_text$=mask_spec$
      SELECT key_code&+-184
      CASE 3
        mask_spec$=filesel_filter$
      CASE 4
        mask_spec$="*.*"
      CASE 5 TO 12
        obj_find(2,-176+key_code&,obj_found%)
        obj_text_query(2,INT{obj_found%},mask_spec$)
      ENDSELECT
      ' New filter: select its popup entry and re-read the directory.
      IF (mask_spec$<>work_text$) AND (mask_spec$<>"")
        radio_find_selected(2,1,obj_found%)
        CARD{rsc_data%+LONG{obj_found%+24}+8}=0
        obj_find(2,-184+key_code&,obj_found%)
        CARD{rsc_data%+LONG{obj_found%+24}+8}=-1
        filesel_listed$=""
        filesel_refresh
      ENDIF
    ENDSELECT
  ELSE
    ' Drvmap; with one floppy (_nflops = 1) B: is removed.
    drive_map&=BIOS(10)
    IF DPEEK(1190)=1
      SUB drive_map&,2
    ENDIF
    IF BTST(drive_map&,PRED(key_inp&))
      sel_index&=key_inp&-1
    ELSE
      sel_index&=-1
    ENDIF
    ' Another drive: save this drive's path, take the other's (or its current folder), redraw.
    IF sel_index&<>-1 AND sel_index&<>filesel_drive&
      drive_paths$(filesel_drive&)=path_dir$
      path_dir$=drive_paths$(sel_index&)
      filesel_drive&=sel_index&
      IF path_dir$=""
        path_dir$=CHR$(filesel_drive&+65)+":"+DIR$(SUCC(filesel_drive&))+"\"
        drive_paths$(sel_index&)=path_dir$
      ENDIF
      filesel_refresh
      filesel_drive_draw(0,0)
    ELSE
      ' Same drive: re-read it.
      IF sel_index&<>-1
        filesel_listed$=""
        filesel_refresh
      ENDIF
    ENDIF
  ENDIF
RETURN
' Reads folder path_dir$ into the list buffer filesel_list_addr%: 16 bytes per entry, ">" + name for folders and
' " " + name for files that match filter mask_spec$, sorted with folders first, at most 400 entries.
' A missing path is cut back folder by folder.  Sets filesel_entry_count& (entries), the list slider and filesel_listed$.
PROCEDURE filesel_dir_scan(VAR path_dir$)
  LOCAL ix&,y_or_j&,counter&,dta_addr%,list_bytes&,fs_status&,attr_byte|,fname$,obj_found%
  IF path_dir$<>filesel_listed$
    pointer_busy(1)  !busy pointer
    pointer_show
    dta_addr%=GEMDOS(47)  !Fgetdta
    list_bytes&=0
    fs_status&=FSFIRST(path_dir$+"*.*",-1)
    ' Path not found (EPTHNF): go up one folder.
    WHILE fs_status&=-34
      path_dir$=LEFT$(path_dir$,RINSTR(path_dir$,"\",LEN(path_dir$)-1))
      filesel_path_draw(path_dir$)
      fs_status&=FSFIRST(path_dir$+"*.*",-1)
    WEND
    DO
      EXIT IF fs_status&
      ' DTA +21 attributes, +30 name.
      attr_byte|=BYTE{dta_addr%+21}
      fname$=CHAR{30+dta_addr%}
      ' Folder (not . or ..): stored with CHR$(7) so it sorts before the files.
      IF BTST(attr_byte|,4)
        IF (fname$<>".") AND (fname$<>"..")
          fname_pad_83(fname$)
          CHAR{filesel_list_addr%+list_bytes&}=CHR$(7)+fname$
          list_bytes&=list_bytes&+16
        ENDIF
      ELSE
        ' File (not the volume label) matching the filter.
        IF (BTST(attr_byte|,3))=FALSE
          IF @wildcard_match(mask_spec$,fname$)<>0
            fname_pad_83(fname$)
            CHAR{filesel_list_addr%+list_bytes&}=" "+fname$
            list_bytes&=list_bytes&+16
          ENDIF
        ENDIF
      ENDIF
      fs_status&=GEMDOS(79)  !Fsnext
      IF list_bytes&=6400  !the buffer is full
        fs_status&=1
      ENDIF
    LOOP
    obj_found%=filesel_list_addr%
    fname$=SPACE$(16)
    ' Selection sort of the 16-byte entries.
    IF list_bytes&>1
      FOR ix&=0 TO SUB(list_bytes&,32) STEP 16
        counter&=ix&
        FOR y_or_j&=16+ix& TO SUB(list_bytes&,16) STEP 16
          IF CHAR{obj_found%+counter&}>CHAR{obj_found%+y_or_j&}
            counter&=y_or_j&
          ENDIF
        NEXT y_or_j&
        IF counter&<>ix&
          BMOVE obj_found%+counter&,V:fname$,16
          BMOVE obj_found%+ix&,obj_found%+counter&,16
          BMOVE V:fname$,obj_found%+ix&,16
        ENDIF
      NEXT ix&
    ENDIF
    ' Mark folders with ">".
    FOR ix&=0 TO SUB(list_bytes&,16) STEP 16
      IF BYTE{obj_found%+ix&}=7
        BYTE{obj_found%+ix&}=62
      ENDIF
    NEXT ix&
    filesel_entry_count&=list_bytes& DIV 16
    list_bytes&=(list_bytes&+47) DIV 48
    ' List slider (object 32): size = rows of 3 entries, position 0.
    obj_find(1,32,obj_found%)
    obj_found%=rsc_data%+LONG{obj_found%+24}
    CARD{obj_found%+2}=MUL(list_bytes&,3)
    CARD{obj_found%+8}=0
    filesel_listed$=path_dir$
    pointer_busy(0)
    pointer_show
    ACLIP 1,0,0,screen_max_x&,screen_max_y&
  ENDIF
RETURN
' Draws the file list rows range_start&..range_end& (0, 3 .. 21; 3 entries per row, 8 rows) from the scroll
' position.  Slot objects 7..30 get draw type 17 when they hold an entry, 16 when empty.
' A full redraw (0 to 23) clears the area first and unselects every slot.
PROCEDURE filesel_list_draw(range_start&,range_end&)
  LOCAL ix&,y_or_j&,counter&,pix_width&,fname_arg$,obj_found%,work_long%,redraw_all!,item_font%
  obj_find(1,32,obj_found%)
  obj_found%=rsc_data%+LONG{obj_found%+24}
  ADD obj_found%,8  !scroll position
  obj_find(1,7,work_long%)
  pointer_hide
  IF range_start&=0 AND range_end&=23
    redraw_all!=TRUE
    IF mono!
      ARECT origin_x&+9,origin_y&+58,344+origin_x&,185+origin_y&,0,0,V:pattern_solid%,1
    ELSE
      ARECT origin_x&+9,origin_y&+29,344+origin_x&,origin_y&+92,0,0,V:pattern_solid%,1
    ENDIF
  ELSE
    redraw_all!=FALSE
  ENDIF
  font_attr_set(0,0,0,0,1)
  font_attr_set(1,0,0,6,0)
  IF mono!
    y_or_j&=58+origin_y&
  ELSE
    y_or_j&=29+origin_y&
  ENDIF
  FOR counter&=0 TO 23 STEP 3
    ix&=13+origin_x&
    FOR pix_width&=0 TO 2
      IF filesel_entry_count&>counter&+pix_width&+INT{obj_found%}
        BYTE{work_long%+5}=17
        IF counter&>=range_start& AND counter&<=range_end&
          txt_blit(ix&,y_or_j&,CHAR{filesel_list_addr%+(pix_width&+(counter&+INT{obj_found%}))*16})
        ENDIF
      ELSE
        BYTE{work_long%+5}=16
      ENDIF
      IF redraw_all!<>FALSE
        CARD{rsc_data%+LONG{work_long%+24}+8}=0
      ENDIF
      work_long%=work_long%+28
      ix&=ix&+112
    NEXT pix_width&
    ADD y_or_j&,8
    IF mono!
      ADD y_or_j&,8
    ENDIF
  NEXT counter&
RETURN
' Draws path path_dir$ on the path line of the file selector, cut to 364 pixels, with a shadow.
PROCEDURE filesel_path_draw(path_dir$)
  LOCAL font_ptr%,y_or_j&
  font_ptr%=@font_find(3)
  WHILE @pixel_width_of(font_ptr%,path_dir$)>364
    path_dir$=LEFT$(path_dir$,LEN(path_dir$)-1)
  WEND
  pointer_hide
  IF mono!
    y_or_j&=43
    ARECT origin_x&+5,origin_y&+30,372+origin_x&,origin_y&+49,1,0,V:pattern_grey%,1
  ELSE
    y_or_j&=21
    ARECT origin_x&+5,origin_y&+15,372+origin_x&,origin_y&+24,1,0,V:pattern_solid%,1
  ENDIF
  font_attr_set(0,0,0,0,3)
  font_attr_set(1,0,0,6,0)
  txt_draw(9+origin_x&,origin_y&+y_or_j&+shadow_dy&,path_dir$)
  font_attr_set(0,0,0,6,0)
  txt_draw(origin_x&+5,origin_y&+y_or_j&,path_dir$)
RETURN
' Draws the current drive letter (filesel_drive&) centred in the drive box, moved by ix&,y_or_j&.
PROCEDURE filesel_drive_draw(ix&,y_or_j&)
  LOCAL font_ptr%
  pointer_hide
  font_ptr%=@font_find(3)
  IF mono!
    MUL y_or_j&,2
    ARECT 278+origin_x&+ix&,origin_y&+8+y_or_j&,295+origin_x&+ix&,origin_y&+23+y_or_j&,1,0,V:pattern_grey%,1
  ELSE
    ARECT 278+origin_x&+ix&,origin_y&+4+y_or_j&,295+origin_x&+ix&,origin_y&+11+y_or_j&,1,0,V:pattern_solid%,1
  ENDIF
  font_attr_set(0,0,0,0,3)
  IF mono!
    font_attr_set(1,0,0,6,0)
    txt_draw(ix&+origin_x&+288-@pixel_width_of(font_ptr%,CHR$(filesel_drive&+65)+":")/2,y_or_j&+origin_y&+22,CHR$(filesel_drive&+65)+":")
    font_attr_set(0,0,0,6,0)
    txt_draw(ix&+origin_x&+287-@pixel_width_of(font_ptr%,CHR$(filesel_drive&+65)+":")/2,y_or_j&+origin_y&+21,CHR$(filesel_drive&+65)+":")
  ELSE
    font_attr_set(0,0,0,6,0)
    txt_draw(ix&+origin_x&+287-@pixel_width_of(font_ptr%,CHR$(filesel_drive&+65)+":")/2,y_or_j&+origin_y&+10,CHR$(filesel_drive&+65)+":")
  ENDIF
RETURN
' Drive button of the file selector: pops up a panel of 16 drive buttons A-P (4 per row) next to the
' dialog at origin_x&,origin_y&.  Drives missing from the BIOS drive map are drawn greyed and cannot be picked.
' The button under the pointer is drawn pressed while the button is held; on release the panel is removed
' and, if another drive was chosen, the current path is stored for the old drive, the new drive's last
' path (or its current GEMDOS directory) becomes path_dir$, the list is re-read and the drive label redrawn.
PROCEDURE drive_popup
  LOCAL ix&,y_or_j&,counter&,drive_map&,k&,sel_index&,saved_bg$,button_img$,obj_found%,font_ptr%,ok_flag!
  pointer_hide
  IF mono!
    ' Save the screen under the panel, then draw the panel with its shadow edges (mono: 2x height).
    GET 273+origin_x&,SUCC(origin_y&),372+origin_x&,origin_y&+101,saved_bg$
    ARECT 273+origin_x&,origin_y&+2,372+origin_x&,origin_y&+101,1,0,V:pattern_light%,1
    ARECT 273+origin_x&,origin_y&+2,276+origin_x&,origin_y&+101,3,0,V:pattern_solid%,1
    ARECT 277+origin_x&,origin_y&+2,372+origin_x&,origin_y&+5,3,0,V:pattern_solid%,1
  ELSE
    GET 273+origin_x&,SUCC(origin_y&),372+origin_x&,origin_y&+50,saved_bg$
    ARECT 273+origin_x&,SUCC(origin_y&),372+origin_x&,origin_y&+50,2,0,V:pattern_solid%,1
    ARECT 273+origin_x&,SUCC(origin_y&),276+origin_x&,origin_y&+50,3,0,V:pattern_solid%,1
    ARECT 277+origin_x&,SUCC(origin_y&),372+origin_x&,origin_y&+2,3,0,V:pattern_solid%,1
  ENDIF
  font_ptr%=@font_find(3)  !font 3 = the Sound Lab font
  font_attr_set(0,0,0,0,3)
  IF mono!
    y_or_j&=origin_y&+6
  ELSE
    y_or_j&=origin_y&+3
  ENDIF
  ix&=277+origin_x&
  drive_map&=BIOS(10)  !BIOS Drvmap: bit n set = drive n present
  ' _nflops ($4A6) = 1: drive B is only the second face of A, so take it out of the map.
  IF DPEEK(1190)=1
    SUB drive_map&,2
  ENDIF
  ' Draw the 16 buttons: shadow, face and the drive letter centred on it.
  FOR counter&=0 TO 15
    IF (BTST(drive_map&,counter&))=FALSE
      ok_flag!=FALSE
      IF mono!
        font_attr_set(1,0,0,6,0)
      ELSE
        font_attr_set(0,2,0,6,0)
      ENDIF
    ELSE
      ok_flag!=TRUE
      font_attr_set(0,0,0,6,0)
    ENDIF
    IF mono!
      ARECT ix&+4,y_or_j&+4,ix&+23,y_or_j&+23,15,0,V:pattern_solid%,1
      ARECT ix&,y_or_j&,ix&+19,y_or_j&+19,1,0,V:pattern_grey%,1
      IF ok_flag!
        font_attr_set(1,0,0,6,0)
        txt_draw(ix&+11-@pixel_width_of(font_ptr%,CHR$(counter&+65))/2,16+y_or_j&,CHR$(counter&+65))
        font_attr_set(0,0,0,6,0)
      ENDIF
      txt_draw(ix&+10-@pixel_width_of(font_ptr%,CHR$(counter&+65))/2,15+y_or_j&,CHR$(counter&+65))
    ELSE
      ARECT ix&+4,y_or_j&+2,ix&+23,y_or_j&+11,15,0,V:pattern_solid%,1
      ARECT ix&,y_or_j&,ix&+19,y_or_j&+9,1,0,V:pattern_solid%,1
      txt_draw(ix&+10-@pixel_width_of(font_ptr%,CHR$(counter&+65))/2,y_or_j&+7,CHR$(counter&+65))
    ENDIF
    ' Next button; after four buttons start a new row.
    ix&=ix&+24
    IF ix&>=373+origin_x&
      ix&=277+origin_x&
      y_or_j&=y_or_j&+12
      IF mono!
        y_or_j&=y_or_j&+12
      ENDIF
    ENDIF
  NEXT counter&
  pointer_show
  ' Track the pointer until the button is released.  sel_index& = drive drawn pressed (-1 none).
  sel_index&=-1
  REPEAT
    ' Turn the pointer position into a grid offset; the buttons are 24 wide and 12 (mono 24) high.
    pointer_state(ix&,y_or_j&,k&)
    SUB ix&,277+origin_x&
    SUB y_or_j&,origin_y&+3
    IF mono!
      y_or_j&=(y_or_j&-3) DIV 2
    ENDIF
    IF ix&>=0 AND y_or_j&>=0 AND ix&<=95 AND y_or_j&<=47
      counter&=(y_or_j& DIV 12)*4+(ix& DIV 24)  !drive number under the pointer
      IF counter&<>sel_index&
        ' Redraw the previous drive as a raised button (image moved back up-left, shadow redrawn).
        IF sel_index&>=0
          pointer_hide
          ix&=origin_x&+277+(sel_index& MOD 4)*24
          IF mono!
            y_or_j&=origin_y&+6+(sel_index& DIV 4)*24
            GET ix&+4,y_or_j&+4,ix&+23,y_or_j&+23,button_img$
            image_blit(ix&,y_or_j&,V:button_img$)
            ARECT ix&+4,y_or_j&+20,ix&+23,y_or_j&+23,15,0,V:pattern_solid%,1
            ARECT ix&+20,y_or_j&+4,ix&+23,y_or_j&+19,15,0,V:pattern_solid%,1
          ELSE
            y_or_j&=origin_y&+3+(sel_index& DIV 4)*12
            GET ix&+4,y_or_j&+2,ix&+23,y_or_j&+11,button_img$
            image_blit(ix&,y_or_j&,V:button_img$)
            ARECT ix&+4,y_or_j&+10,ix&+23,y_or_j&+11,15,0,V:pattern_solid%,1
            ARECT ix&+20,y_or_j&+2,ix&+23,y_or_j&+9,15,0,V:pattern_solid%,1
          ENDIF
          pointer_show
        ENDIF
        ' A present drive: draw it pressed by moving its image 4 pixels down-right.
        IF BTST(drive_map&,counter&)
          sel_index&=counter&
          pointer_hide
          ix&=origin_x&+277+(sel_index& MOD 4)*24
          IF mono!
            y_or_j&=origin_y&+6+(sel_index& DIV 4)*24
            GET ix&,y_or_j&,ix&+19,y_or_j&+19,button_img$
            image_blit(ix&+4,y_or_j&+4,V:button_img$)
            ARECT ix&,y_or_j&,ix&+19,y_or_j&+3,1,0,V:pattern_light%,1
            ARECT ix&,y_or_j&+4,ix&+3,y_or_j&+19,1,0,V:pattern_light%,1
          ELSE
            y_or_j&=origin_y&+3+(sel_index& DIV 4)*12
            GET ix&,y_or_j&,ix&+19,y_or_j&+9,button_img$
            image_blit(ix&+4,y_or_j&+2,V:button_img$)
            ARECT ix&,y_or_j&,ix&+19,SUCC(y_or_j&),2,0,V:pattern_solid%,1
            ARECT ix&,y_or_j&+2,ix&+3,y_or_j&+9,2,0,V:pattern_solid%,1
          ENDIF
          pointer_show
        ELSE
          sel_index&=-1
        ENDIF
      ENDIF
    ENDIF
  UNTIL k&=0
  pointer_hide
  ' Button released: put back the screen under the panel.
  image_blit(273+origin_x&,origin_y&+1,V:saved_bg$)
  saved_bg$=""
  font_attr_set(0,0,0,6,0)
  ' A different drive was chosen: switch the selector to its stored path and re-read the directory.
  IF sel_index&<>-1 AND sel_index&<>filesel_drive&
    drive_paths$(filesel_drive&)=path_dir$
    path_dir$=drive_paths$(sel_index&)
    filesel_drive&=sel_index&
    IF path_dir$=""
      path_dir$=CHR$(filesel_drive&+65)+":"+DIR$(SUCC(filesel_drive&))+"\"
      drive_paths$(sel_index&)=path_dir$
    ENDIF
    filesel_refresh
    filesel_drive_draw(4,2)
  ENDIF
  button_img$=""
  pointer_show
RETURN
' File selector up arrow (object 31): the 8 rows x 3 columns file list moves down one row on screen
' with RC_COPY, the freed top row is cleared and its three names are drawn (filesel_list_draw(0,2)).
' The selected file slot filesel_picked_obj& moves down a row with it (+3); when it leaves the list it is cleared.
PROCEDURE filelist_scroll_up
  pointer_hide
  IF mono!
    RC_COPY XBIOS(3),origin_x&+9,origin_y&+58,336,112 TO XBIOS(3),origin_x&+9,origin_y&+74  !mono: rows are 16 pixels
    ARECT origin_x&+9,origin_y&+58,344+origin_x&,origin_y&+73,0,0,V:pattern_solid%,1
  ELSE
    RC_COPY XBIOS(3),origin_x&+9,origin_y&+29,336,56 TO XBIOS(3),origin_x&+9,origin_y&+37  !colour: rows are 8 pixels
    ARECT origin_x&+9,origin_y&+29,344+origin_x&,origin_y&+36,0,0,V:pattern_solid%,1
  ENDIF
  filesel_list_draw(0,2)
  ' Clear the selected state of the old slot, then select the slot one row lower.
  IF filesel_picked_obj&>0
    obj_find(1,filesel_picked_obj&,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=0
  ENDIF
  IF filesel_picked_obj&<27 AND filesel_picked_obj&>0
    ADD filesel_picked_obj&,3
    obj_find(1,filesel_picked_obj&,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=-1
  ELSE
    filesel_picked_obj&=0
  ENDIF
RETURN
' File selector down arrow (object 33): the file list moves up one row on screen, the freed bottom row is
' cleared and its three names are drawn (filesel_list_draw(21,23)).  The selected slot moves up a row (-3).
' The clearing ARECTs use V:pattern_val%, a variable never set at this level, so the pattern is 0; in replace
' mode with colour 0 that still clears the row.
PROCEDURE filelist_scroll_down
  pointer_hide
  IF mono!
    RC_COPY XBIOS(3),origin_x&+9,origin_y&+74,336,112 TO XBIOS(3),origin_x&+9,origin_y&+58
    ARECT origin_x&+9,170+origin_y&,344+origin_x&,185+origin_y&,0,0,V:pattern_val%,1
  ELSE
    RC_COPY XBIOS(3),origin_x&+9,origin_y&+37,336,56 TO XBIOS(3),origin_x&+9,origin_y&+29
    ARECT origin_x&+9,origin_y&+85,344+origin_x&,origin_y&+92,0,0,V:pattern_val%,1
  ENDIF
  filesel_list_draw(21,23)
  ' Clear the selected state of the old slot, then select the slot one row higher.
  IF filesel_picked_obj&>0
    obj_find(1,filesel_picked_obj&,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=0
  ENDIF
  IF filesel_picked_obj&>9
    SUB filesel_picked_obj&,3
    obj_find(1,filesel_picked_obj&,obj_found%)
    CARD{rsc_data%+LONG{obj_found%+24}+8}=-1
  ELSE
    filesel_picked_obj&=0
  ENDIF
RETURN
' For a filename edit field (type 7) holding "NAME    .EXT" (text at +16, length at +14): takes the "."
' at position 8 out so the text is 11 characters, and moves the cursor cursor_pos& back past the dot.
' fname_field_dot_insert undoes this after the edit.  Other field types are left alone.
PROCEDURE fname_field_dot_remove(work_ptr%)
  IF INT{work_ptr%}=7
    CARD{work_ptr%+14}=11  !field length without the dot
    BMOVE work_ptr%+25,work_ptr%+24,3
    BYTE{work_ptr%+27}=32
    IF cursor_pos&>8
      DEC cursor_pos&
    ENDIF
  ENDIF
RETURN
' For a filename edit field (type 7): opens a gap at position 8 again (length 12) and puts a "." there
' unless the extension is blank, then moves the cursor cursor_pos& forward over the dot.
PROCEDURE fname_field_dot_insert(work_ptr%)
  IF INT{work_ptr%}=7
    CARD{work_ptr%+14}=12
    BMOVE work_ptr%+24,work_ptr%+25,3
    IF BYTE{work_ptr%+24}<>32  !"." (46) only if an extension follows
      BYTE{work_ptr%+24}=46
    ENDIF
    IF cursor_pos&>8
      INC cursor_pos&
    ENDIF
  ENDIF
RETURN
' Pads a filename to the fixed 12-character "NAME    .EXT" layout used in the file list and the edit
' field: name padded to 8 characters, then the extension with its dot padded to 4.  fname_arg$ is VAR.
PROCEDURE fname_pad_83(VAR fname_arg$)
  LOCAL ix&
  ix&=INSTR(fname_arg$,".")
  IF ix&=0
    fname_arg$=LEFT$(fname_arg$+"            ",12)
  ELSE
    fname_arg$=LEFT$(LEFT$(fname_arg$,PRED(ix&))+"        ",8)+LEFT$(MID$(fname_arg$,ix&)+"    ",4)
  ENDIF
RETURN
' Removes every space from the VAR string fname_arg$ (turns the padded 8.3 layout back into a filename).
PROCEDURE strip_spaces(VAR fname_arg$)
  LOCAL work_text$,ix&
  work_text$=""
  FOR ix&=1 TO LEN(fname_arg$)
    IF MID$(fname_arg$,ix&,1)<>" "
      work_text$=work_text$+MID$(fname_arg$,ix&,1)
    ENDIF
  NEXT ix&
  fname_arg$=work_text$
RETURN
' Wildcard test: returns TRUE if filename fname$ matches one of the patterns in pattern_list$, separated by "|".
' Pattern characters: "*" any run up to the next pattern character, "?" any one character, "#" a run of
' digits, anything else must be equal.  A name without a dot gets one when the pattern has a dot.
' A pattern fails if it is not used up, unless what is left is a final "*" or "#".
FUNCTION wildcard_match(pattern_list$,fname$)
  $F%
  LOCAL work_text$,pat_char|,fname_char|,ix&,y_or_j&,counter&,ok_flag!
  IF INSTR(fname$,".")=0 AND INSTR(pattern_list$,".")>0
    fname$=fname$+"."
  ENDIF
  ' Take the next pattern work_text$ up to the next "|" (ix& jumps to that "|").
  FOR ix&=1 TO LEN(pattern_list$)
    y_or_j&=INSTR(pattern_list$,"|",ix&)
    IF y_or_j&=0
      work_text$=MID$(pattern_list$,ix&)
      ix&=LEN(pattern_list$)
    ELSE
      work_text$=MID$(pattern_list$,ix&,y_or_j&-ix&)
      ix&=y_or_j&
    ENDIF
    ' Compare the name character by character; counter& is the position in the pattern, pat_char| its character.
    ok_flag!=TRUE
    counter&=1
    pat_char|=ASC(work_text$)
    FOR y_or_j&=1 TO LEN(fname$)
      fname_char|=ASC(MID$(fname$,y_or_j&,1))
      ' "*": skip name characters until one equals the pattern character after the "*", then go past both.
      IF pat_char|=42
        IF counter&<LEN(work_text$)
          IF fname_char|=ASC(MID$(work_text$,SUCC(counter&),1))
            ADD counter&,2
            IF counter&<=LEN(work_text$)
              pat_char|=ASC(MID$(work_text$,counter&,1))
            ELSE
              pat_char|=FALSE
            ENDIF
          ENDIF
        ENDIF
      ELSE
        ' "#": a non-digit ends the digit run; the same name character is tried against the next pattern char.
        IF pat_char|=35
          IF fname_char|<48 OR fname_char|>57
            IF counter&=LEN(work_text$)
              ok_flag!=FALSE
            ELSE
              INC counter&
              pat_char|=ASC(MID$(work_text$,counter&,1))
              DEC y_or_j&
            ENDIF
          ENDIF
        ELSE
          ' "?": matches any one character.
          IF pat_char|=63
            INC counter&
            IF counter&<=LEN(work_text$)
              pat_char|=ASC(MID$(work_text$,counter&,1))
            ELSE
              pat_char|=FALSE
            ENDIF
          ELSE
            ' Literal character: must be equal, otherwise this pattern fails.
            IF pat_char|=fname_char|
              INC counter&
              IF counter&<=LEN(work_text$)
                pat_char|=ASC(MID$(work_text$,counter&,1))
              ELSE
                pat_char|=FALSE
              ENDIF
            ELSE
              ok_flag!=FALSE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      EXIT IF NOT ok_flag!
    NEXT y_or_j&
    ' Pattern not used up (except a last "*" or "#"): no match.
    IF counter&<LEN(work_text$) OR (counter&=LEN(work_text$) AND (RIGHT$(work_text$)<>"*") AND (RIGHT$(work_text$)<>"#"))
      ok_flag!=FALSE
    ENDIF
    EXIT IF ok_flag!
  NEXT ix&
  RETURN ok_flag!
ENDFUNC
' Prepares a GEM font in memory (font_hdr%) stored in Intel byte order: swaps the bytes of every word from the
' start of the header up to the character data (header, horizontal offset and character offset tables),
' then turns the hor_table (+68), off_table (+72) and dat_table (+76) offsets into absolute pointers.
' With dialog_id&>0 the font is linked into the system font chain as font id dialog_id&.
PROCEDURE font_convert_intel(font_hdr%,dialog_id&)
  LOCAL conv_len&,range_pos%
  conv_len&=PEEK(76+font_hdr%)+SHL(PEEK(77+font_hdr%),8)  !dat_table offset read in Intel order = bytes to swap
  FOR range_pos%=font_hdr% TO PRED(font_hdr%+conv_len&) STEP 2
    CARD{range_pos%}=PEEK(range_pos%)+SHL(PEEK(range_pos%+1),8)
  NEXT range_pos%
  LONG{font_hdr%+68}=font_hdr%+DPEEK(68+font_hdr%)
  LONG{font_hdr%+72}=font_hdr%+DPEEK(72+font_hdr%)
  LONG{font_hdr%+76}=font_hdr%+DPEEK(76+font_hdr%)
  IF dialog_id&>0
    font_link(font_hdr%,dialog_id&)
  ENDIF
RETURN
' Under GEM (own_pointer! FALSE) appends font header font_hdr% to the end of the system font chain (next_font
' pointer at +84) and gives it font id dialog_id&.  Without GEM the font is used directly (font_find).
PROCEDURE font_link(font_hdr%,dialog_id&)
  IF NOT own_pointer!
    font_chain_last
    LONG{font_last%+84}=font_hdr%
    CARD{font_hdr%}=dialog_id&
  ENDIF
RETURN
' Sets font_last% to the last font header of the system font chain (the one whose next_font at +84 is 0).
PROCEDURE font_chain_last
  font_chain_first
  font_last%=font_chain%
  WHILE LPEEK(font_last%+84)<>0
    font_last%=LPEEK(font_last%+84)
  WEND
RETURN
' Sets font_chain% to the first system font header for the current resolution.
' Without GEM: runs Line-A init ($A000, move.l a1,d0, rts) to get the font header table and takes the
' 8x8 font (+4) or, in mono, the 8x16 font (+8).  Under GEM: the font pointer in the Line-A variable at
' -452, moved on to the next font in mono.
PROCEDURE font_chain_first
  LOCAL linea_code$,base_ptr%
  IF own_pointer!
    linea_code$=MKL$(-1610604535)+"Nu"  !$A000 $2009 $4E75 as code
    base_ptr%=V:linea_code$
    font_chain%=LONG{C:base_ptr%()+4-4*mono!}  !8x8 font, 8x16 in mono
  ELSE
    font_chain%=LONG{L~A-452}  !GEM: current font pointer from the Line-A variables
    IF mono!
      font_chain%=LONG{font_chain%+84}
    ENDIF
  ENDIF
RETURN
' Selects font 1, then under GEM takes font header base_ptr% out of the system font chain by pointing its
' predecessor's next_font (+84) at the font that follows it.
PROCEDURE font_unlink(base_ptr%)
  font_attr_set(0,0,0,0,1)
  IF NOT own_pointer!
    font_chain_first
    WHILE base_ptr%<>LPEEK(font_chain%+84)
      font_chain%=LPEEK(font_chain%+84)
    WEND
    LONG{font_chain%+84}=LPEEK(84+base_ptr%)
  ENDIF
RETURN
' Undoes font_convert_intel at exit: unlinks the font, turns its table pointers back into offsets and swaps the
' bytes of the words back to Intel order.
PROCEDURE font_restore_intel(base_ptr%)
  LOCAL conv_len&,range_pos%
  font_unlink(base_ptr%)
  CARD{base_ptr%+68}=LPEEK(68+base_ptr%)-base_ptr%
  CARD{base_ptr%+72}=LPEEK(72+base_ptr%)-base_ptr%
  CARD{base_ptr%+76}=LPEEK(76+base_ptr%)-base_ptr%
  conv_len&=DPEEK(76+base_ptr%)
  FOR range_pos%=base_ptr% TO PRED(base_ptr%+conv_len&) STEP 2
    CARD{range_pos%}=PEEK(range_pos%)+SHL(PEEK(range_pos%+1),8)
  NEXT range_pos%
RETURN
' Returns the width in pixels of string txt$ in font font_ptr%.  A value below 3 means a fixed 8-pixel
' font; otherwise each character's width comes from the font's off_table (+72): next offset minus this
' one, indexed from the first character code (low byte of the word at +36).
FUNCTION pixel_width_of(font_ptr%,txt$)
  $F%
  LOCAL counter&,font_hdr%,pix_total&
  pix_total&=0
  FOR counter&=1 TO LEN(txt$)
    IF font_ptr%<3
      ADD pix_total&,8
    ELSE
      font_hdr%=LONG{font_ptr%+72}+MUL(2,ASC(MID$(txt$,counter&,1))-BYTE{font_ptr%+37})
      pix_total&=pix_total&+(INT{font_hdr%+2}-INT{font_hdr%})
    ENDIF
  NEXT counter&
  RETURN pix_total&
ENDFUNC
' Returns the font header pointer for font id dialog_id& (also left in font_chain%).  Without GEM ids below 3 give
' the Line-A system font and any other id the Sound Lab font font_main%.  Under GEM the system font chain is
' walked for the id; if it is not there the last font of the chain is returned.
FUNCTION font_find(dialog_id&)
  $F%
  IF own_pointer!
    IF dialog_id&<3
      font_chain_first
    ELSE
      font_chain%=font_main%
    ENDIF
  ELSE
    font_chain_first
    WHILE dialog_id&<>DPEEK(font_chain%) AND LPEEK(font_chain%+84)<>0
      font_chain%=LPEEK(font_chain%+84)
    WEND
  ENDIF
  RETURN font_chain%
ENDFUNC
' Runs a menu choice.  mnu_path$ is the menu path ("1 ..." Desk menu, "2 ..." File/Disk menu).  The LOCAL
' zoom_x1&..zoom_y2& give the centre of the screen as the start rectangle of the dialog zoom box; the menu
' procedures called here see them.
PROCEDURE mnu_dispatch(mnu_path$)
  LOCAL zoom_x1&,zoom_x2&,zoom_y1&,zoom_y2&
  zoom_x1&=319
  zoom_y1&=screen_max_y& DIV 2
  zoom_x2&=320
  zoom_y2&=zoom_y1&+1
  menu_choice&=@path_number_pop(mnu_path$)
  ON menu_choice& GOSUB desk_menu,filedisk_menu
RETURN
' Disables the menu item named by path mnu_path$: sets bit 6 (disabled) and bit 1 (light text) of the flag
' byte at +9 of its record.
PROCEDURE mnu_item_disable(mnu_path$)
  LOCAL base_ptr%
  mnu_item_find(mnu_path$,base_ptr%)
  BYTE{base_ptr%+9}=BSET(BYTE{base_ptr%+9},6)
  BYTE{base_ptr%+9}=BSET(BYTE{base_ptr%+9},1)
RETURN
' Sets the rectangle of the menu item named by path mnu_path$: x, y, width, height at record +0..+6.
' A negative value leaves that field as it is.  In mono y and height are doubled.
PROCEDURE mnu_item_rect(mnu_path$,ix&,y_or_j&,pix_width&,item_height&)
  LOCAL base_ptr%
  IF mono!
    MUL y_or_j&,2
    MUL item_height&,2
  ENDIF
  mnu_item_find(mnu_path$,base_ptr%)
  IF ix&>=0
    CARD{base_ptr%}=ix&
  ENDIF
  IF y_or_j&>=0
    CARD{base_ptr%+2}=y_or_j&
  ENDIF
  IF pix_width&>=0
    CARD{base_ptr%+4}=pix_width&
  ENDIF
  IF item_height&>=0
    CARD{base_ptr%+6}=item_height&
  ENDIF
RETURN
' Sets the box of the submenu of the menu item named by path mnu_path$ (x, y, width, height, relative to the
' item).  Skips the item's text (or image) to reach the submenu header, which starts with its length word.
' Only y uses -1 as "keep"; the others use any negative value.
PROCEDURE mnu_sub_rect(mnu_path$,ix&,y_or_j&,pix_width&,item_height&)
  LOCAL base_ptr%
  IF mono!
    MUL y_or_j&,2
    MUL item_height&,2
  ENDIF
  mnu_item_find(mnu_path$,base_ptr%)
  ' Image item: skip the image data; text item: skip the null-terminated text (padded to even).
  IF BTST(BYTE{base_ptr%+11},2)
    base_ptr%=base_ptr%+(14+INT{base_ptr%+12})
  ELSE
    base_ptr%=base_ptr%+11
    REPEAT
      ADD base_ptr%,2
    UNTIL BYTE{base_ptr%}=0
    INC base_ptr%
  ENDIF
  ADD base_ptr%,2
  IF ix&>=0
    CARD{base_ptr%}=ix&
  ENDIF
  IF y_or_j&<>-1
    CARD{base_ptr%+2}=y_or_j&
  ENDIF
  IF pix_width&>=0
    CARD{base_ptr%+4}=pix_width&
  ENDIF
  IF item_height&>=0
    CARD{base_ptr%+6}=item_height&
  ENDIF
RETURN
' Builds the menu bar data mnu_data$ from the DATA lines and sets the screen and menu metrics.
' Each menu record: +0 x, +2 y, +4 width, +6 height, +8 font id (bit 7 = separator line), +9 flags
' (bit 6 disabled, bit 5 centred, low bits text effects), +10 high nibble fill colour, low nibble text
' colour, +11 bits 3-7 text height, bit 2 image item, bit 1 has a submenu, bit 0 outline highlight;
' then the null-terminated text padded to even.  A record with a submenu is followed by the submenu header
' (length, x, y, width, height) and the submenu's records.
PROCEDURE mnu_build
  LOCAL item_header$,work_str$,item_attr$,font_ptr%,slider_size&,y_or_j&,origin_y&,mnu_item_h&
  ' pen_map&() maps colour numbers 0-15 to VDI pen indexes.
  DIM pen_map&(15)
  pen_map&(0)=0
  pen_map&(15)=1
  pen_map&(1)=2
  pen_map&(2)=3
  pen_map&(4)=4
  pen_map&(6)=5
  pen_map&(3)=6
  pen_map&(5)=7
  pen_map&(7)=8
  pen_map&(8)=9
  pen_map&(9)=10
  pen_map&(10)=11
  pen_map&(12)=12
  pen_map&(14)=13
  pen_map&(11)=14
  pen_map&(13)=15
  ' Screen limits, submenu shadow size and the mono text offset from the resolution (XBIOS Getrez).
  scr_max_x&=319
  scr_max_y&=199
  shadow_w&=2
  shadow_h&=2
  txt_y_adj&=0
  cur_rez&=XBIOS(4)
  IF cur_rez&
    scr_max_x&=639
    shadow_w&=4
    IF cur_rez&=2
      scr_max_y&=399
      shadow_h&=4
      txt_y_adj&=3
    ENDIF
  ENDIF
  ' Default attributes $01001030: font 1, no flags, fill 1, text colour 0, text height 6.
  ' mnu_item_h& = item height, menubar_height& = menu bar height (doubled in mono).
  item_attr$=MKL$(16781104)
  mnu_item_h&=8
  menubar_height&=10
  IF XBIOS(4)=2
    item_attr$=MKL$(16781104)
    mnu_item_h&=16
    menubar_height&=20
    scr_max_y&=399
    shadow_h&=4
  ENDIF
  sep_pattern&=21845  !$5555 dotted line for separators
  mnu_pattern%=-1
  mnu_shadows!=TRUE  !submenus get drop shadows
  mnu_data$=""
  item_header$=""
  ' Read the titles: each title is placed after the previous one at x menubar_width&, y 1, and its menu items are
  ' read by mnu_list_build.  An empty string ends the menu bar.
  menubar_width&=16
  DO
    READ work_str$
    EXIT IF work_str$=""
    mnu_item_parse(work_str$)
    work_str$=" "+work_str$+" "
    font_ptr%=@font_find(BCLR(ASC(MID$(item_header$,9,1)),7))
    slider_size&=@pixel_width_of(font_ptr%,work_str$)
    ' No explicit position: x, y 1, text width, bar height - 1.
    IF LEFT$(item_header$,8)=(MKL$(0)+MKL$(0))
      MID$(item_header$,1,8)=(MKI$(menubar_width&)+MKI$(1)+MKI$(slider_size&)+MKI$(PRED(menubar_height&)))
    ENDIF
    REPEAT
      work_str$=work_str$+CHR$(0)
    UNTIL EVEN(LEN(work_str$))
    work_str$=item_header$+work_str$
    menubar_width&=menubar_width&+slider_size&
    mnu_list_build(0,menubar_height&,work_str$)
    mnu_data$=mnu_data$+work_str$
  LOOP
  ' Walk all title records and set menubar_width&/menubar_height& to the right and bottom edge of the bar.
  menubar_width&=0
  menubar_height&=0
  y_or_j&=0
  DO
    EXIT IF y_or_j&>=LEN(mnu_data$)
    menubar_width&=MAX(menubar_width&,INT{y_or_j&+V:mnu_data$}+INT{y_or_j&+V:mnu_data$+4})
    menubar_height&=MAX(menubar_height&,INT{y_or_j&+V:mnu_data$+2}+INT{y_or_j&+V:mnu_data$+6})
    origin_y&=INT{y_or_j&+V:mnu_data$+10}
    ' Bug: an image item's length is read from the first record (V:mnu_data$+12), not from this one.
    ' No item uses an image, so it has no effect.
    IF BTST(origin_y&,2)
      y_or_j&=y_or_j&+12+INT{V:mnu_data$+12}
    ELSE
      y_or_j&=y_or_j&+11
      REPEAT
        ADD y_or_j&,2
      UNTIL BYTE{y_or_j&+V:mnu_data$}=0
      INC y_or_j&
    ENDIF
    IF BTST(origin_y&,1)
      y_or_j&=y_or_j&+INT{y_or_j&+V:mnu_data$}
      ADD y_or_j&,2
    ENDIF
  LOOP
RETURN
' Reads the items of one menu from DATA until an empty string and appends them as a submenu to the record
' string work_str$ (VAR): submenu header (length, x subm_x&, y subm_y&, widest width subm_width&, total height
' subm_height&) followed by the item records.  A "*" makes the items that follow (to the next empty string) a
' submenu of the previous item, built by a recursive call.  Items stack downwards with height mnu_item_h&
' (separators 3, mono 5); "^n" adds n pixels of space above an item.
PROCEDURE mnu_list_build(subm_x&,subm_y&,VAR work_str$)
  LOCAL subm_width&,subm_height&,subm_records$,y_or_j&,origin_y&,prev_record$
  subm_width&=0
  subm_height&=0
  y_or_j&=0
  subm_records$=""
  prev_record$=""
mnu_item_next:
  DO
    READ item_text$
    EXIT IF item_text$=""
    ' Submenu of the previous item: build it onto prev_record$ and carry on reading this menu.
    IF item_text$="*"
      mnu_list_build(0,mnu_item_h&,prev_record$)
      GOTO mnu_item_next
    ENDIF
    subm_records$=subm_records$+prev_record$
    mnu_item_parse(item_text$)
    y_or_j&=y_or_j&+item_gap&
    ' No explicit position: place the item below the previous ones.
    IF LEFT$(item_header$,8)=(MKL$(0)+MKL$(0))
      origin_y&=mnu_item_h&
      IF BTST(ASC(MID$(item_header$,9,1)),7)
        IF mono!
          origin_y&=5
        ELSE
          origin_y&=3
        ENDIF
      ENDIF
      MID$(item_header$,1,8)=(MKI$(0)+MKI$(y_or_j&)+MKI$(0)+MKI$(origin_y&))
      y_or_j&=y_or_j&+origin_y&
    ENDIF
    ' No explicit width: use the text width in the item's font.
    IF INT{V:item_header$+4}=0
      font_ptr%=@font_find(BCLR(ASC(MID$(item_header$,9,1)),7))
      slider_size&=@pixel_width_of(font_ptr%,item_text$)
    ELSE
      slider_size&=INT{V:item_header$+4}
    ENDIF
    REPEAT
      item_text$=item_text$+CHR$(0)
    UNTIL EVEN(LEN(item_text$))
    prev_record$=item_header$+item_text$
    subm_width&=MAX(subm_width&,slider_size&+INT{V:item_header$})
    subm_height&=MAX(subm_height&,INT{V:item_header$+2}+INT{V:item_header$+6})
  LOOP
  subm_records$=subm_records$+prev_record$
  ' Second pass: give every item without a width the widest width, and put every submenu 32 pixels in from
  ' the right edge of its item.
  y_or_j&=0
  DO
    EXIT IF y_or_j&>=LEN(subm_records$)
    IF INT{y_or_j&+V:subm_records$+4}=0
      CARD{y_or_j&+V:subm_records$+4}=subm_width&
    ENDIF
    origin_y&=INT{y_or_j&+V:subm_records$+10}
    IF BTST(origin_y&,2)
      y_or_j&=y_or_j&+12+INT{V:subm_records$+12}
    ELSE
      y_or_j&=y_or_j&+11
      REPEAT
        ADD y_or_j&,2
      UNTIL BYTE{y_or_j&+V:subm_records$}=0
      INC y_or_j&
    ENDIF
    IF BTST(origin_y&,1)
      CARD{y_or_j&+V:subm_records$+2}=SUB(subm_width&,32)
      y_or_j&=y_or_j&+INT{y_or_j&+V:subm_records$}
      ADD y_or_j&,2
    ENDIF
  LOOP
  ' Mark the parent record as having a submenu (bit 1 of +11) and append the submenu header and records.
  MID$(work_str$,12,1)=(CHR$(BSET(ASC(MID$(work_str$,12,1)),1)))
  work_str$=work_str$+MKI$(LEN(subm_records$)+8)+MKI$(subm_x&)+MKI$(subm_y&)+MKI$(subm_width&)+MKI$(subm_height&)+subm_records$
RETURN
' Finds the menu record named by path mnu_path$ ("2 7 3": title 2, item 7, submenu item 3) and returns its
' address in addr% (VAR), or 0 if it is not there.  Each number skips records in the current level;
' a record with a submenu narrows the search to that submenu for the next number.
PROCEDURE mnu_item_find(mnu_path$,VAR addr%)
  LOCAL counter&,ix&,y_or_j&,rec_flags&,range_end&
  counter&=0
  range_end&=LEN(mnu_data$)
  WHILE counter&<range_end& AND (mnu_path$<>"")
    y_or_j&=@path_number_pop(mnu_path$)
    ix&=1
    ' Skip y_or_j&-1 records, each with its text (or image) and any submenu.
    WHILE ix&<y_or_j& AND counter&<range_end&
      INC ix&
      rec_ptr%=counter&+V:mnu_data$
      rec_flags&=INT{rec_ptr%+10}
      IF BTST(rec_flags&,2)
        counter&=counter&+12+INT{V:mnu_data$+12}
      ELSE
        counter&=counter&+11
        REPEAT
          ADD counter&,2
        UNTIL BYTE{counter&+V:mnu_data$}=0
        INC counter&
      ENDIF
      IF BTST(rec_flags&,1)
        counter&=counter&+INT{counter&+V:mnu_data$}
        ADD counter&,2
      ENDIF
    WEND
    EXIT IF counter&>=range_end&
    addr%=counter&+V:mnu_data$
    ' The record has a submenu: the next number searches its records only.
    IF BTST(BYTE{addr%+11},1)
      counter&=counter&+11
      REPEAT
        ADD counter&,2
      UNTIL BYTE{counter&+V:mnu_data$}=0
      INC counter&
      range_end&=counter&+2+INT{counter&+V:mnu_data$}
      counter&=counter&+10
    ELSE
      mnu_path$=""
    ENDIF
  WEND
  IF counter&>=range_end&
    addr%=0
  ENDIF
RETURN
' Parses the prefixes of a menu DATA string item_text$ (VAR) into the record header item_header$ (owned by the
' caller): "%n" sets the default font to n and reads the next string; "*" followed by 24 hex digits
' gives the whole 12-byte header; "^n" sets the space above the item (item_gap&); "-text" is a disabled
' item; "-" alone is a separator line; a first character above $80 adds its low 6 bits to the flags.
PROCEDURE mnu_item_parse(VAR item_text$)
  IF LEFT$(item_text$)="%"  !"%n": default font for the following items
    MID$(item_attr$,1,1)=(CHR$(VAL(MID$(item_text$,2))))
    READ item_text$
  ENDIF
  IF LEFT$(item_text$)="*"  !"*" + 24 hex digits: explicit 12-byte header
    item_header$=MKL$(VAL("&H"+MID$(item_text$,2,8)))+MKL$(VAL("&H"+MID$(item_text$,10,8)))+MKL$(VAL("&H"+MID$(item_text$,18,8)))
    item_text$=MID$(item_text$,26)
  ELSE
    item_header$=MKL$(0)+MKL$(0)+item_attr$
  ENDIF
  item_gap&=0
  IF LEFT$(item_text$)="^"  !"^n": n pixels of space above the item
    item_gap&=VAL(MID$(item_text$,2))
    item_text$=MID$(item_text$,VAL?(MID$(item_text$,2))+2)
  ENDIF
  ' "-text": disabled (bit 6) and light text (bit 1).  "-": separator (+8 bit 7), disabled.
  IF (LEFT$(item_text$)="-") AND (item_text$<>"-")
    item_text$=MID$(item_text$,2)
    MID$(item_header$,10,1)=(CHR$(BSET(ASC(MID$(item_header$,10,1)),6)))
    MID$(item_header$,10,1)=(CHR$(BSET(ASC(MID$(item_header$,10,1)),1)))
  ELSE
    IF item_text$="-"
      MID$(item_header$,9,1)=(CHR$(BSET(ASC(MID$(item_header$,9,1)),7)))
      MID$(item_header$,10,1)=(CHR$(BSET(ASC(MID$(item_header$,10,1)),6)))
      item_text$=""
    ENDIF
  ENDIF
  IF LEFT$(item_text$)>"€"
    MID$(item_header$,10,1)=(CHR$(ASC(MID$(item_header$,10,1)) OR (ASC(item_text$) AND 63)))
    item_text$=MID$(item_text$,2)
  ENDIF
RETURN
' Menu bar handler, called from the dialog loop.  When the pointer is on the menu bar and a button is
' down (or menus drop on touch, menu_click_opt! FALSE): saves the bar area, draws the bar, tracks the menus
' with mnu_track, runs the choice, empties the keyboard buffer and puts the bar area back.
PROCEDURE menubar_poll
  pointer_state(ms_x&,ms_y&,ms_b&)
  IF ms_x&<menubar_width&+16 AND ms_y&<menubar_height& AND (ms_b& OR menu_click_opt!=FALSE)
    pointer_hide
    GET 0,0,menubar_width&+15,PRED(menubar_height&),menubar_bg$
    menubar_draw
    mnu_choice$=""
    mnu_track(0,LEN(mnu_data$),0,0,menubar_width&,menubar_height&,0,0)  !track from the menu bar level
    pointer_show
    IF mnu_choice$<>""
      mnu_dispatch(mnu_choice$)
    ENDIF
    ' BIOS Bconstat/Bconin on the console: throw away keys pressed during the menu.
    WHILE BIOS(1,2)
      ~INP(2)
    WEND
    pointer_hide
    PUT 0,0,menubar_bg$
    menubar_bg$=""
    pointer_show
  ENDIF
RETURN
' Draws the menu bar: clears it, draws the line under it (dotted $AAAA5555 in mono) and all title records.
PROCEDURE menubar_draw
  pointer_hide
  ACLIP 1,0,0,scr_max_x&,scr_max_y&
  ARECT 0,0,menubar_width&+15,PRED(menubar_height&),0,0,V:mnu_pattern%,1
  IF mono!
    mnu_pattern%=-1431677611
  ENDIF
  HLINE 0,menubar_height&,menubar_width&+16,1,0,V:mnu_pattern%,1
  IF mono!
    mnu_pattern%=-1
  ENDIF
  mnu_records_draw(0,0,0,LEN(mnu_data$),0)
  pointer_show
RETURN
' Draws the menu records of mnu_data$ from offset obj_ofs& for slider_size& bytes, at origin ix&,y_or_j&.
' num_val& non-zero greys the text (effect 2) of the whole run, as for a disabled title's menu.
' Per record: background fill if its fill colour is not 0, then a dotted line (separator), the image
' (image item) or the text in the record's font, colour, effects and height, centred if flag bit 5.
PROCEDURE mnu_records_draw(ix&,y_or_j&,obj_ofs&,slider_size&,num_val&)
  LOCAL origin_y&,counter&,rec_ptr%,origin_x&,rec_flags&,item_height&,work_text$,item_font%
  pointer_hide
  IF num_val&
    num_val&=2
  ENDIF
  slider_size&=slider_size&+obj_ofs&
  counter&=obj_ofs&
  wrmode_set(2)  !transparent mode
  DO
    EXIT IF counter&>=slider_size&
    rec_ptr%=counter&+V:mnu_data$
    origin_x&=ix&+INT{rec_ptr%}
    origin_y&=y_or_j&+INT{rec_ptr%+2}
    rec_flags&=INT{rec_ptr%+10}
    IF BYTE{rec_ptr%+10} DIV 16<>0
      ARECT origin_x&,origin_y&,PRED(origin_x&+INT{rec_ptr%+4}),PRED(origin_y&+INT{rec_ptr%+6}),BYTE{rec_ptr%+10} DIV 16,0,V:mnu_pattern%,1
    ENDIF
    ' Separator: a dotted line across the item.
    IF BTST(BYTE{rec_ptr%+8},7)
      IF mono!
        HLINE origin_x&,origin_y&+2,PRED(origin_x&+INT{rec_ptr%+4}),15,0,V:sep_pattern&,0
      ELSE
        HLINE origin_x&,SUCC(origin_y&),PRED(origin_x&+INT{rec_ptr%+4}),15,0,V:sep_pattern&,0
      ENDIF
    ELSE
      ' Image item: the length is at +12 and the GET image data at +14.
      IF BTST(rec_flags&,2)
        item_height&=INT{rec_ptr%+12}
        work_text$=SPACE$(item_height&)
        BMOVE rec_ptr%+14,V:work_text$,item_height&
        PUT origin_x&,origin_y&,work_text$
        work_text$=""
      ELSE
        ' Text item: set font, then colour, effects and height.
        item_height&=BYTE{rec_ptr%+11} DIV 8
        font_attr_set(0,0,0,0,BYTE{rec_ptr%+8})
        font_attr_set(pen_map&(BYTE{rec_ptr%+10} AND 15),num_val& OR (BYTE{rec_ptr%+9} AND 63),0,item_height&,0)
        IF BTST(BYTE{rec_ptr%+9},5)
          work_text$=CHAR{12+rec_ptr%}
          item_font%=@font_find(BYTE{rec_ptr%+8})
          txt_draw(origin_x&+((INT{rec_ptr%+4}-@pixel_width_of(item_font%,work_text$)) DIV 2),txt_y_adj&+PRED(origin_y&+((item_height&+INT{rec_ptr%+6}) DIV 2)),work_text$)
        ELSE
          txt_draw(origin_x&,txt_y_adj&+PRED(origin_y&+((item_height&+INT{rec_ptr%+6}) DIV 2)),CHAR{12+rec_ptr%})
        ENDIF
      ENDIF
    ENDIF
    ' Step over the record's text or image, and over its submenu if it has one.
    ' Bug: as in mnu_build the image length comes from the first record; no image items exist.
    IF BTST(rec_flags&,2)
      counter&=counter&+12+INT{V:mnu_data$+12}
    ELSE
      counter&=counter&+11
      REPEAT
        ADD counter&,2
      UNTIL BYTE{counter&+V:mnu_data$}=0
      INC counter&
    ENDIF
    IF BTST(rec_flags&,1)
      counter&=counter&+INT{counter&+V:mnu_data$}
      ADD counter&,2
    ENDIF
  LOOP
RETURN
' Tracks the pointer over a menu level: records range_start&..range_end& of mnu_data$, drawn at rect_x1&,rect_ay&, area up
' to rect_x2&,y_bottom&; sel_index& = depth (0 = menu bar), num_val& = level greyed.  The item under the pointer is
' highlighted (XOR box, or outline if flag bit 0); an item with a submenu opens it (background saved in
' subm_bg$, frame, optional shadow) and the pointer inside it recurses one level deeper.
' The menu bar level stays until the button is released; then mnu_choice$ gets the path of the item under the
' pointer.  ms_b&=-1 ends all levels.
PROCEDURE mnu_track(range_start&,range_end&,rect_x1&,rect_ay&,rect_x2&,y_bottom&,sel_index&,num_val&)
  LOCAL old_rec&,subm_bg$,subm_hdr&,origin_x&,origin_y&,value_edge&,parent_rec%,cur_rec&
  cur_rec&=-1
  old_rec&=-1
  subm_hdr&=-1
  ' GFA gives AND priority over OR: the menu bar level (sel_index&=0) loops whatever the pointer position.
  DO WHILE ms_x&>=PRED(rect_x1&) AND ms_y&>=PRED(rect_ay&) AND ms_x&<=rect_x2& AND ms_y&<=y_bottom& AND ms_b&>=0 OR sel_index&=0
    ' cur_rec& = record under the pointer; when it changes the old one is unhighlighted and the new one lit.
    mnu_hit_test(ms_x&-rect_x1&,ms_y&-rect_ay&,range_start&,range_end&,cur_rec&)
    IF cur_rec&<>old_rec& AND (cur_rec&>=0 OR sel_index&>0)
      ' Unhighlight the old item: close its submenu by putting back the saved background.
      IF old_rec&>=0
        pointer_hide
        IF BTST(BYTE{old_rec&+V:mnu_data$+11},1)
          PUT PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{subm_hdr&+V:mnu_data$+2}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{subm_hdr&+V:mnu_data$+4}),subm_bg$
          subm_bg$=""
        ENDIF
        IF BTST(BYTE{old_rec&+V:mnu_data$+11},0)
          frame_draw(rect_x1&+INT{old_rec&+V:mnu_data$},rect_ay&+INT{old_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{old_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{old_rec&+V:mnu_data$+6}),15,2,-1)
        ELSE
          ARECT rect_x1&+INT{old_rec&+V:mnu_data$},rect_ay&+INT{old_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{old_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{old_rec&+V:mnu_data$+6}),15,2,V:mnu_pattern%,1
        ENDIF
        pointer_show
      ENDIF
      subm_hdr&=-1
      ' Highlight the new item.
      IF cur_rec&>=0
        pointer_hide
        IF BTST(BYTE{cur_rec&+V:mnu_data$+11},0)
          frame_draw(rect_x1&+INT{cur_rec&+V:mnu_data$},rect_ay&+INT{cur_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{cur_rec&+V:mnu_data$}+INT{cur_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{cur_rec&+V:mnu_data$+2}+INT{cur_rec&+V:mnu_data$+6}),15,2,-1)
        ELSE
          ARECT rect_x1&+INT{cur_rec&+V:mnu_data$},rect_ay&+INT{cur_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{cur_rec&+V:mnu_data$}+INT{cur_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{cur_rec&+V:mnu_data$+2}+INT{cur_rec&+V:mnu_data$+6}),15,2,V:mnu_pattern%,1
        ENDIF
        ' The new item has a submenu: find its header, save the screen under it, draw the frame and clear it.
        IF BTST(BYTE{cur_rec&+V:mnu_data$+11},1)
          subm_hdr&=11+cur_rec&
          REPEAT
            ADD subm_hdr&,2
          UNTIL BYTE{subm_hdr&+V:mnu_data$}=0
          INC subm_hdr&
          origin_x&=rect_x1&+INT{cur_rec&+V:mnu_data$}+INT{subm_hdr&+V:mnu_data$+2}
          origin_y&=rect_ay&+INT{cur_rec&+V:mnu_data$+2}+INT{subm_hdr&+V:mnu_data$+4}
          GET PRED(origin_x&),PRED(origin_y&),shadow_w&+(origin_x&+INT{subm_hdr&+V:mnu_data$+6}),shadow_h&+(origin_y&+INT{subm_hdr&+V:mnu_data$+8}),subm_bg$
          frame_draw(origin_x&-1,origin_y&-1,origin_x&+INT{subm_hdr&+V:mnu_data$+6},origin_y&+INT{subm_hdr&+V:mnu_data$+8},15,0,-1)
          ARECT origin_x&,origin_y&,PRED(origin_x&+INT{subm_hdr&+V:mnu_data$+6}),PRED(origin_y&+INT{subm_hdr&+V:mnu_data$+8}),0,0,V:mnu_pattern%,1
          ' Drop shadow along the right and bottom edges, kept inside the parent menu's area.
          IF mnu_shadows!
            value_edge&=rect_x2&+shadow_w&-1
            IF y_bottom&<origin_y&+INT{subm_hdr&+V:mnu_data$+8}
              value_edge&=origin_x&+shadow_w&-1
            ENDIF
            ARECT value_edge&,SUCC(origin_y&+INT{subm_hdr&+V:mnu_data$+8}),shadow_w&+(origin_x&+INT{subm_hdr&+V:mnu_data$+6}),shadow_h&+(origin_y&+INT{subm_hdr&+V:mnu_data$+8}),15,0,V:mnu_pattern%,1
            value_edge&=y_bottom&+shadow_h&-1
            IF rect_x2&<origin_x&+INT{subm_hdr&+V:mnu_data$+6}
              value_edge&=origin_y&+shadow_h&-1
            ENDIF
            ARECT SUCC(origin_x&+INT{subm_hdr&+V:mnu_data$+6}),value_edge&,shadow_w&+(origin_x&+INT{subm_hdr&+V:mnu_data$+6}),origin_y&+INT{subm_hdr&+V:mnu_data$+8},15,0,V:mnu_pattern%,1
          ENDIF
          ' Draw the submenu items, greyed if the item or its level is disabled.
          mnu_records_draw(origin_x&,origin_y&,subm_hdr&+V:mnu_data$+10-V:mnu_data$,INT{subm_hdr&+V:mnu_data$}-8,num_val& OR BTST(BYTE{cur_rec&+V:mnu_data$+9},6))
        ENDIF
        pointer_show
      ENDIF
      old_rec&=cur_rec&
    ENDIF
    prev_button&=ms_b&
    pointer_state(ms_x&,ms_y&,ms_b&)
    IF ms_y&=0
      ms_y&=1
    ENDIF
    ' Pointer inside the open submenu: track it one level deeper.
    IF subm_hdr&>=0
      IF ms_x&>=PRED(origin_x&) AND ms_y&>=PRED(origin_y&) AND ms_x&<=origin_x&+INT{subm_hdr&+V:mnu_data$+6} AND ms_y&<=origin_y&+INT{subm_hdr&+V:mnu_data$+8}
        parent_rec%=cur_rec&+V:mnu_data$
        IF parent_rec%=0  !never true: V:mnu_data$ is added, so cur_rec&=-1 gives V:mnu_data$-1
          parent_rec%=old_rec&+V:mnu_data$
        ENDIF
        mnu_track(subm_hdr&+V:mnu_data$+10-V:mnu_data$,subm_hdr&+V:mnu_data$+INT{subm_hdr&+V:mnu_data$}+2-V:mnu_data$,origin_x&,origin_y&,origin_x&+INT{subm_hdr&+V:mnu_data$+6},origin_y&+INT{subm_hdr&+V:mnu_data$+8},sel_index&+1,num_val& OR BTST(BYTE{parent_rec%+9},6))
      ENDIF
    ENDIF
    ' Button released: end tracking at every level and build the choice path.  An item with a submenu is no
    ' choice unless flag bit 7 of +9 is set, so tracking carries on.
    IF ms_b&=0 AND prev_button&=1
      ms_b&=-1
      IF cur_rec&>=0
        mnu_path_build(cur_rec&+V:mnu_data$,mnu_choice$)
        IF BTST(BYTE{cur_rec&+V:mnu_data$+11},1) AND (BTST(BYTE{cur_rec&+V:mnu_data$+9},7))=FALSE
          ms_b&=0
          mnu_choice$=""
          cur_rec&=-1
        ENDIF
      ENDIF
    ENDIF
  LOOP UNTIL ms_b&=-1
  ' Leaving this level: unhighlight the last item and close its submenu.
  IF old_rec&>=0
    pointer_hide
    IF BTST(BYTE{old_rec&+V:mnu_data$+11},1)
      PUT PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{subm_hdr&+V:mnu_data$+2}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{subm_hdr&+V:mnu_data$+4}),subm_bg$
      subm_bg$=""
    ENDIF
    IF BTST(BYTE{old_rec&+V:mnu_data$+11},0)
      frame_draw(rect_x1&+INT{old_rec&+V:mnu_data$},rect_ay&+INT{old_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{old_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{old_rec&+V:mnu_data$+6}),15,2,-1)
    ELSE
      ARECT rect_x1&+INT{old_rec&+V:mnu_data$},rect_ay&+INT{old_rec&+V:mnu_data$+2},PRED(rect_x1&+INT{old_rec&+V:mnu_data$}+INT{old_rec&+V:mnu_data$+4}),PRED(rect_ay&+INT{old_rec&+V:mnu_data$+2}+INT{old_rec&+V:mnu_data$+6}),15,2,V:mnu_pattern%,1
    ENDIF
    pointer_show
  ENDIF
RETURN
' Hit test: walks the records from offset range_start& to range_end& and returns in cur_rec& (VAR) the offset of the
' first one containing point ix&,y_or_j&, or -1.  A record counts if it is enabled and its level is not
' greyed (num_val& of the calling mnu_track), or if it has a submenu.
PROCEDURE mnu_hit_test(ix&,y_or_j&,range_start&,range_end&,VAR cur_rec&)
  LOCAL counter&,rec_ptr%,origin_x&,origin_y&,rec_flags&,target_rec%
  target_rec%=-1
  counter&=range_start&
  DO
    EXIT IF counter&>=range_end&
    rec_ptr%=counter&+V:mnu_data$
    origin_x&=INT{rec_ptr%}
    origin_y&=INT{rec_ptr%+2}
    rec_flags&=INT{rec_ptr%+10}
    IF ix&>=origin_x& AND y_or_j&>=origin_y& AND ix&<origin_x&+INT{rec_ptr%+4} AND y_or_j&<origin_y&+INT{rec_ptr%+6}
      ' num_val& here is the caller's parameter (GFA locals are visible to called procedures).
      IF (BTST(BYTE{rec_ptr%+9},6))=FALSE AND num_val&=0 OR BTST(BYTE{rec_ptr%+11},1)
        target_rec%=rec_ptr%
      ENDIF
    ENDIF
    EXIT IF target_rec%>=0
    IF BTST(rec_flags&,2)
      counter&=counter&+12+INT{V:mnu_data$+12}
    ELSE
      counter&=counter&+11
      REPEAT
        ADD counter&,2
      UNTIL BYTE{counter&+V:mnu_data$}=0
      INC counter&
    ENDIF
    IF BTST(rec_flags&,1)
      counter&=counter&+INT{counter&+V:mnu_data$}
      ADD counter&,2
    ENDIF
  LOOP
  IF target_rec%>=0
    cur_rec&=target_rec%-V:mnu_data$
  ELSE
    cur_rec&=-1
  ENDIF
RETURN
' Builds the menu path of record target_rec%: walks all records counting them per level (one byte per level
' in mnu_path$), with a stack of submenu end offsets in nest_stack$ to step back out of a level.  Returns the
' numbers as text separated by spaces ("2 7 3") in mnu_path$ (VAR), or "" if the record is not found.
PROCEDURE mnu_path_build(target_rec%,VAR mnu_path$)
  LOCAL sel_index&,counter&,rec_ptr%,nest_stack$,rec_flags&
  mnu_path$=CHR$(0)
  nest_stack$=""
  counter&=0
  DO
    EXIT IF counter&>=LEN(mnu_data$)
    ' End of a submenu reached: drop back to the parent level.
    WHILE counter&=CVI(RIGHT$(nest_stack$,2)) AND (nest_stack$<>"")
      nest_stack$=LEFT$(nest_stack$,LEN(nest_stack$)-2)
      mnu_path$=LEFT$(mnu_path$,LEN(mnu_path$)-1)
    WEND
    MID$(mnu_path$,LEN(mnu_path$),1)=(CHR$(ASC(RIGHT$(mnu_path$))+1))  !count this record at the current level
    rec_ptr%=counter&+V:mnu_data$
    EXIT IF rec_ptr%=target_rec%
    rec_flags&=INT{rec_ptr%+10}
    IF BTST(rec_flags&,2)
      counter&=counter&+12+INT{V:mnu_data$+12}
    ELSE
      counter&=counter&+11
      REPEAT
        ADD counter&,2
      UNTIL BYTE{counter&+V:mnu_data$}=0
      INC counter&
    ENDIF
    ' The record has a submenu: open a new level and push the submenu's end offset.
    IF BTST(rec_flags&,1)
      mnu_path$=mnu_path$+CHR$(0)
      nest_stack$=nest_stack$+MKI$(counter&+2+INT{counter&+V:mnu_data$})
      counter&=counter&+10
    ENDIF
  LOOP
  IF counter&=LEN(mnu_data$)
    mnu_path$=""
  ELSE
    nest_stack$=mnu_path$
    mnu_path$=""
    FOR ix&=1 TO LEN(nest_stack$)
      mnu_path$=mnu_path$+STR$(ASC(MID$(nest_stack$,ix&,1)))+" "
    NEXT ix&
    mnu_path$=LEFT$(mnu_path$,LEN(mnu_path$)-1)
  ENDIF
RETURN
' Returns the first number of the path string mnu_path$ (VAR) and removes it and the space after it.
FUNCTION path_number_pop(VAR mnu_path$)
  $F%
  LOCAL value_edge&
  value_edge&=VAL(mnu_path$)
  mnu_path$=MID$(mnu_path$,VAL?(mnu_path$)+2)
  RETURN value_edge&
ENDFUNC
' Draws the outline of rectangle rect_x1&,rect_ay&-rect_x2&,y_bottom& in colour y_centre&, graphics mode mode_param&,
' line pattern line_pattern&: two vertical lines with ALINE and two horizontal lines with HLINE.
PROCEDURE frame_draw(rect_x1&,rect_ay&,rect_x2&,y_bottom&,y_centre&,mode_param&,line_pattern&)
  ALINE rect_x1&,SUCC(rect_ay&),rect_x1&,PRED(y_bottom&),y_centre&,line_pattern&,mode_param&
  ALINE rect_x2&,SUCC(rect_ay&),rect_x2&,PRED(y_bottom&),y_centre&,line_pattern&,mode_param&
  HLINE rect_x1&,rect_ay&,rect_x2&,y_centre&,mode_param&,V:line_pattern&,0
  HLINE rect_x1&,y_bottom&,rect_x2&,y_centre&,mode_param&,V:line_pattern&,0
RETURN
' DIMs the file tables for channels 0-99: chan_handles&() GEMDOS handle, chan_pos%() file position.
PROCEDURE channel_table_init
  DIM chan_handles&(99)
  DIM chan_pos%(99)
RETURN
' Opens file fname_z$ on channel channel&.  Mode access_mode$: "I", "O", "U", "A", or "N" for a new file.
' "N": if the file exists, the file-exists option exists_option& (2 = ask with an alert) chooses Erase (Fdelete),
' Rename (old file renamed to .BAK) or Cancel (-36); then the file is created (Fcreate, Fclose) and opened
' as "O".  Every GEMDOS call repeats while dos_error_alert answers Retry (-999).
' Returns 0 and stores the handle, or the GEMDOS error.  last_file_op& is set but never read.
' Bug: Fopen gets INSTR("IOUA",access_mode$) = 1-4, one above GEMDOS's 0 read / 1 write / 2 read-write.
FUNCTION fopen_channel(access_mode$,channel&,fname_z$)
  $F%
  last_file_op&=1
  IF RIGHT$(fname_z$)<>CHR$(0)
    fname_z$=fname_z$+CHR$(0)
  ENDIF
  IF access_mode$="N"
    IF @fexists(fname_z$)<>0
      ACLIP 1,0,0,639,screen_max_y&
      ' Ask: alert 19 "A file with that name already exists." Erase / Rename / Cancel.
      IF exists_option&=2
        pointer_busy(0)
        pointer_show
        choice&=@msgbox_show(19,"[1][ A file with that name | already exists. ][ Erase | Rename |   Cancel   ][^M|r|a]")
        pointer_busy(1)
        pointer_show
      ELSE
        choice&=exists_option&+1
      ENDIF
      SELECT choice&
      CASE 1
        REPEAT
          dos_result&=GEMDOS(65,L:V:fname_z$)  !Fdelete
          IF dos_result&<0
            dos_error_alert(dos_result&)
          ENDIF
        UNTIL dos_result&<>-999
      CASE 2
        ' Rename: delete an old .BAK file, then Frename the file to .BAK (assumes a 3-letter extension).
        bak_fname$=LEFT$(fname_z$,INSTR(fname_z$,CHR$(0))-4)+"BAK"+CHR$(0)
        IF @fexists(bak_fname$)<>0
          REPEAT
            dos_result&=GEMDOS(65,L:V:bak_fname$)
            IF dos_result&<0
              dos_error_alert(dos_result&)
            ENDIF
          UNTIL dos_result&<>-999
        ELSE
          dos_result&=0
        ENDIF
        IF dos_result&=0
          REPEAT
            dos_result&=GEMDOS(86,0,L:V:fname_z$,L:V:bak_fname$)  !Frename
            IF dos_result&<0
              dos_error_alert(dos_result&)
            ENDIF
          UNTIL dos_result&<>-999
        ENDIF
      CASE 3
        dos_result&=-36  !Cancel: EACCDN
      ENDSELECT
    ELSE
      ACLIP 1,0,0,639,screen_max_y&
      dos_result&=0
    ENDIF
    IF dos_result&>=0
      REPEAT
        dos_result&=GEMDOS(60,L:V:fname_z$,0)  !Fcreate, normal attributes
        IF dos_result&<0
          dos_error_alert(dos_result&)
        ENDIF
      UNTIL dos_result&<>-999
      IF dos_result&>=0
        REPEAT
          dos_result&=GEMDOS(62,dos_result&)  !Fclose
          IF dos_result&<0
            dos_error_alert(dos_result&)
          ENDIF
        UNTIL dos_result&<>-999
      ENDIF
    ENDIF
    access_mode$=CHR$(79)  !now open it as "O"
  ELSE
    dos_result&=0
  ENDIF
  IF dos_result&>=0
    REPEAT
      dos_result&=GEMDOS(61,L:V:fname_z$,INSTR("IOUA",access_mode$))  !Fopen
      IF dos_result&<0
        dos_error_alert(dos_result&)
      ENDIF
    UNTIL dos_result&<>-999
    IF dos_result&>=0
      chan_handles&(channel&)=dos_result&
      chan_pos%(channel&)=0
      RETURN 0
    ENDIF
  ENDIF
  RETURN dos_result&
ENDFUNC
' Reads count% bytes from channel channel& to address addr% (GEMDOS Fread), repeating on Retry.
' Returns 0 and moves the stored position on by count%, or the GEMDOS error.
FUNCTION fread_channel(channel&,addr%,count%)
  $F%
  last_file_op&=2
  REPEAT
    io_count%=GEMDOS(63,chan_handles&(channel&),L:count%,L:addr%)  !Fread
    IF io_count%<0
      dos_result&=io_count%
    ELSE
      dos_result&=0
    ENDIF
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF io_count%>=0
    ADD chan_pos%(channel&),count%
    RETURN 0
  ELSE
    RETURN io_count%
  ENDIF
ENDFUNC
' Writes count% bytes from address addr% to channel channel& (GEMDOS Fwrite), repeating on Retry.
' Returns 0 and moves the stored position on by count%, or the GEMDOS error.
FUNCTION fwrite_channel(channel&,addr%,count%)
  $F%
  last_file_op&=2
  REPEAT
    io_count%=GEMDOS(64,chan_handles&(channel&),L:count%,L:addr%)  !Fwrite
    IF io_count%<0
      dos_result&=io_count%
    ELSE
      dos_result&=0
    ENDIF
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF io_count%>=0
    ADD chan_pos%(channel&),count%
    RETURN 0
  ELSE
    RETURN io_count%
  ENDIF
ENDFUNC
' Closes channel channel& (GEMDOS Fclose), repeating on Retry; returns the GEMDOS result.
FUNCTION fclose_channel(channel&)
  $F%
  last_file_op&=4
  REPEAT
    dos_result&=GEMDOS(62,chan_handles&(channel&))
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  RETURN dos_result&
ENDFUNC
' Returns the length of file path_z$ from the DTA after Fsfirst (attributes $27: read-only, hidden,
' system, archive), or the GEMDOS error.  Uses the DTA from Fgetdta.
FUNCTION fsize_of(path_z$)
  $F%
  last_file_op&=5
  base_ptr%=GEMDOS(47)  !Fgetdta
  REPEAT
    dos_result&=FSFIRST(path_z$,39)
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF dos_result&>=0
    RETURN LPEEK(26+base_ptr%)  !d_length
  ELSE
    RETURN dos_result&
  ENDIF
ENDFUNC
' Reads one byte from channel channel& and returns it, or the error.  Never called.
FUNCTION fread_byte(channel&)
  $F%
  last_file_op&=6
  got_byte|=FALSE
  REPEAT
    dos_result&=@fread_channel(channel&,V:got_byte|,1)
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF dos_result&>=0
    RETURN got_byte|
  ELSE
    RETURN dos_result&
  ENDIF
ENDFUNC
' Reads one word from channel channel& and returns it, or the error.  Never called.
FUNCTION fread_word(channel&)
  $F%
  last_file_op&=7
  got_word&=0
  REPEAT
    dos_result&=@fread_channel(channel&,V:got_word&,2)
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF dos_result&>=0
    RETURN got_word&
  ELSE
    RETURN dos_result&
  ENDIF
ENDFUNC
' Moves channel channel& to byte fpos_seek% from the start of the file (GEMDOS Fseek mode 0), repeating on
' Retry.  Returns 0 and stores the position, or the GEMDOS error.
FUNCTION fseek_abs(channel&,fpos_seek%)
  $F%
  last_file_op&=8
  REPEAT
    dos_result&=MIN(0,GEMDOS(66,L:fpos_seek%,chan_handles&(channel&),0))
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF dos_result&>=0
    chan_pos%(channel&)=fpos_seek%
    RETURN 0
  ELSE
    RETURN dos_result&
  ENDIF
ENDFUNC
' Moves channel channel& on by fpos_seek% bytes (GEMDOS Fseek mode 1), repeating on Retry.
' Returns 0 and adds to the stored position, or the GEMDOS error.
FUNCTION fseek_rel(channel&,fpos_seek%)
  $F%
  last_file_op&=9
  REPEAT
    dos_result&=MIN(0,GEMDOS(66,L:fpos_seek%,chan_handles&(channel&),1))
    IF dos_result&<0
      dos_error_alert(dos_result&)
    ENDIF
  UNTIL dos_result&<>-999
  IF dos_result&>=0
    ADD chan_pos%(channel&),fpos_seek%
    RETURN 0
  ELSE
    RETURN dos_result&
  ENDIF
ENDFUNC
' Returns -1 if file fname_z$ exists (Fsfirst with all attributes), else 0.  No error alert.
' Also shows the mouse and resets the clip rectangle, as callers expect after an alert or dialog.
FUNCTION fexists(fname_z$)
  $F%
  fname_z$=fname_z$+CHR$(0)
  dta_addr%=GEMDOS(47)  !Fgetdta, not used further
  dos_result&=FSFIRST(fname_z$,-1)
  pointer_show
  ACLIP 1,0,0,639,screen_max_y&
  IF dos_result&=0
    RETURN -1
  ELSE
    RETURN 0
  ENDIF
ENDFUNC
' Shows a Retry/Cancel alert (alert 21) for GEMDOS error gem_error& (VAR): -1 general error, -4/-10/-11/-16
' CRC, write, read and bad sector errors, -13 write-protected, -14 media change, -33 file not found,
' -34 path not found, -35 no handles left, -36 access denied, -64 range error, anything else by number.
' Retry sets gem_error& to -999, which makes the caller repeat the GEMDOS call.
' too_many_files! is set for -35 but never used.
PROCEDURE dos_error_alert(VAR gem_error&)
  LOCAL work_text$,too_many_files!,work_ptr%
  SELECT gem_error&
  CASE -1
    work_text$="[ Insert a disk, or | remove write-protect. ]"
  CASE -4,-10,-11,-16
    work_text$="[ I'm having trouble with | the disk.  It may be | damaged... ]"
  CASE -13
    work_text$="[ That disk is | write-protected! ]"
  CASE -14
    work_text$="[ That's not the | right disk... ]"
  CASE -33
    work_text$="[ I can't find the | file you want... ]"
  CASE -34
    work_text$="[ I can't find the | folder you want... ]"
  CASE -35
    work_text$="[ There are too many | files open at one time. ]"
    too_many_files!=TRUE
  CASE -36
    work_text$="[ I can't change | that file. ]"
  CASE -64
    work_text$="[ Unexpected end | of file. ]"
  DEFAULT
    work_text$="[ Unrecognized GEMDOS | error (#"+STR$(-gem_error&)+")... ]"
  ENDSELECT
  pointer_hide
  pointer_busy(0)  !arrow pointer for the alert
  choice&=@msgbox_show(21,"[3]"+work_text$+"[ Retry |   Cancel   ]")
  pointer_hide
  pointer_busy(1)
  pointer_show
  IF choice&=1
    gem_error&=-999
  ENDIF
RETURN
' ON ERROR handler (set at the start of the program): reports the GFA BASIC error number with the author's
' address, in an alert if alerts can be shown (dlgs_ready!), otherwise as text on a cleared screen waiting for
' a key.  Then restores the system if it was changed (sys_changed!, sys_restore) and ends the program.
PROCEDURE basic_err_report
  IF dlgs_ready!
    work_text$=STR$(ERR)
    pointer_busy(0)
    pointer_show
    ~@msgbox_show(20,"[2][ GFA BASIC Error #"+work_text$+" | Write: Damien M. Jones |        PSC 8 Box 657 |        APO AE 09109 ][  I'll do it now.  ][][LEFT]")
  ELSE
    CLS
    PRINT
    PRINT "GFA BASIC Error ";ERR;"."
    PRINT
    PRINT "Please notify the author:"
    PRINT
    PRINT "     Damien M. Jones"
    PRINT "     PSC 8 Box 657"
    PRINT "     APO AE 09109"
    PRINT
    PRINT "Press any key to exit..."
    ~INP(2)
  ENDIF
  IF sys_changed!
    sys_restore
  ENDIF
  END
RETURN
' Returns number num_value% as a string with a comma before every group of three digits ("1,234,567").
FUNCTION thousands_commas$(num_value%)
  LOCAL work_text$,digits$
  digits$=STR$(num_value%)
  work_text$=""
  WHILE LEN(digits$)>3
    work_text$=","+RIGHT$(digits$,3)+work_text$
    digits$=LEFT$(digits$,LEN(digits$)-3)
  WEND
  work_text$=digits$+work_text$
  RETURN work_text$
ENDFUNC
DATA Desk,  Done with ACCs  ,------------------,1,2,3,4,5,6,,,%3,Desk,„  Info...  ,*,  Sound Lab  ,  Shareware  
DATA   Thanks  ,,-,  Accessories  ,,File/Disk,  Rename File  ,  Delete File(s)  ,-,  Create Folder  ,  Remove Folder  
DATA -,  Free Space  ,*, A, B, C, D, E, F, G, H, I, J, K, L, M, N, O, P,,  Format Disk  ,-,  Quit,,
