    Until Inner_index%>3
    Inc Loop_index%
  Until Loop_index%>16
  Restore Data_social_class_names  ! the social classes
  Read Social_class%  ! the number of social classes
  Dim Social_class_names$(Social_class%)  ! lower lower to upper upper
  Loop_index%=1
  Repeat
