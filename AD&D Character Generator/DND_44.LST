    Inner_index%=1
    Repeat
      Read Armor_prices%(Loop_index%,Inner_index%)  ! the price in one coin type
      Inc Inner_index%
    Until Inner_index%>4
    Inner_index%=1  ! every class
    Repeat
      Read Armor_usable!(Loop_index%,Inner_index%)  ! may this class wear this armor
      Inc Inner_index%
    Until Inner_index%>Character_class%  ! the next class
    Inc Loop_index%  ! the next item
  Until Loop_index%>Armor_count%
