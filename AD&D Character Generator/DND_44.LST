  Restore Data_armor_prices  ! the armor price list
  Read Armor_count%  ! the number of armor items
  Dim Armor_names$(Armor_count%)  ! the armor names
  Dim Armor_prices%(Armor_count%,4)  ! the price of each in each coin type
  Dim Armor_usable!(Armor_count%,Character_class%)  ! which classes may wear each
  Dim Armour_owned%(Armor_count%)  ! how many the character bought
  Read Chain_mail%
  Read Field_plate%
  Read Full_plate_mail%
  Read Plate_mail%
  Loop_index%=1
  Repeat
    Read Work_text$  ! the item name, padded with spaces
