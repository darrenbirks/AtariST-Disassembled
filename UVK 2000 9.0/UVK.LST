' DATA table: the number of days in each month, January to December, 12 decimal strings (February 28).
' get_weekday_name READs month-1 of them.
days_in_month:
DATA 31,28,31,30,31,30,31,31,30,31,30,31
' DATA table: the weekday names "SUN" to "SAT" (7 strings). get_weekday_name READs (days MOD 7)+1 of them and keeps
' the last.
weekday_names:
DATA SUN,MON,TUE,WED,THU,FRI,SAT
' DATA table: 28 decimal strings, the number of the first restore list entry starting with each letter, A..Z, then
' the entries starting with "1" and "5" (items 26 and 27). find_first_disk_for_letter READs up to the wanted item.
first_disk_per_letter:
