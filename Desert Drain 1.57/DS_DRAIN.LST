  ' Assembler customize: section, absolute short, branch size, mul/div, moveq, movem, linea, ds, OPT, remark
  ac_text&=2
  obj_asm_sect_2&=3
  obj_asm_sect_1&=4
  obj_asm_sect_3&=5
  ac_abs_word&=7
  obj_asm_bcc_s&=8
