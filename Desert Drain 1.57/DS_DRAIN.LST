  si_get_long&=22
  ' Memory: relative bytes per line or absolute lines, usage figures, speed, OK, Install
  mem_relative&=1
  obj_lay_bpl_text&=2
  obj_lay_bpl_data&=4
  obj_lay_bpl_bss&=6
  obj_lay_fixed&=8
  obj_lay_fixed_lines&=9
  mem_lines_used&=13
  mem_lines_max&=15
  mem_free&=18
  mem_line_usage&=21
