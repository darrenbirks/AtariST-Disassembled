' Desert Drain 1.57 (09.94), a 680x0 disassembler for the Atari ST/STE by Volker Hemsen, written in
' GFA BASIC 3 with assembler INLINE routines.  It loads a program, program part, routine, RAM/ROM area,
' resource or data file, disassembles it into an editor window (with labels, DATA-in-TEXT ranges, replaced
' symbols and GEM/TOS trap names from the help file DS_HILFE.TXT) and saves the source as ASCII.
' Files: DS_DRAIN.RSC resource, DS_DRAIN.INF settings, DS_DRAIN.REG registration, *.PAR source settings.
' The main program sets up, loads a file named on the command line, then runs the event loop until an
' Installation restart is asked for, saves the settings, clears everything and starts over.
'
' The texts of this source are German, as the program was compiled.  The distributed DS_DRAIN.PRG is that
' compile with its texts translated to English in the program file, each in the room of its German text, and
' its library's error texts too: DS_DRAIN.PAT holds those bytes (see README.txt).
'
' Rebuilt from DS_DRAIN.PRG by Darren Birks, 24 November 2026.  GFA BASIC Compiler 3.03 D (a build with
' 3.03 E's code generator, gfadec's "3.03 D late synthetic") with the patched GFA3BLIB:
'   gfadec -compile DS_DRAIN.GFA DS_DRAIN.PRG -compiler "3.03 D late synthetic" -patch DS_DRAIN.PAT
'
$E$
$I+
$B+
' 60-byte INLINE buffer used as the disk transfer address
INLINE value%,60
~GEMDOS(26,L:value%)  !Fsetdta
command_line$=CHAR{129+BASEPAGE}  !command line text from the basepage
program_init
' A file name on the command line (the last word) is loaded at once; "%D" also disassembles it and shows
' the editor window
IF LEN(command_line$)
  program_path$=MID$(command_line$,RINSTR(command_line$," ")+1)
  program_load(0)  !load the program without a file selector
  IF INSTR(command_line$,"%D")<>0
    command_execute(mi_disassemble&)  !menu Disassemble
    command_execute(mi_editor&)  !menu Editor
  ENDIF
ENDIF
restart_loop:
DO
  ' Event loop; it ends only when Installation asks for a restart
  REPEAT
    event_handle
  UNTIL restart_wanted!
  ' Restart: save the settings, close windows and dialogs, clear all variables and set up again
  DEFMOUSE 2
  inf_save(0)  !save DS_DRAIN.INF without a file selector
  gem_shutdown  !close the window dialog and both windows
  CLEAR
  program_init
  restart_wanted!=FALSE
LOOP
END  !never reached
' Start-up and restart initialisation.  Sets version and date, finds the program folder, reads the
' registration file (quits without it), installs the error handler, reads the install part of
' DS_DRAIN.INF and reserves memory accordingly, DIMs the global arrays, reads screen, TOS and AES data,
' sets up the INLINE routines and the option defaults, loads the resource, creates the two windows,
' reads the rest of the INF file, loads the help file and reopens the windows saved in the INF file.
PROCEDURE program_init
  version_bcd&=343  !version $157 = 1.57 as BCD
  release_date_bcd&=2452  !date $0994 = 09.94 as BCD
  program_folder$=@env_lookup$("DS_DRAIN")  !folder the program was started from
  work_str$="ds_drain.reg"
  ' DS_DRAIN.REG: a word with the registration number, then the encoded user name ending in a zero byte
  IF @path_locate(work_str$)<>0
    OPEN "i",#1,work_str$
    reg_number&=INP&(#1)
    reg_name$=@cstring_from_file$
    reg_name_decode(reg_name$)
    CLOSE #1
  ELSE
    ' Without the registration file the program waits for a key and ends
    PRINT "kein Programmzugriff mîglich!"
    ~INP(2)
    END
  ENDIF
  ON ERROR GOSUB fault_handler
  ON BREAK CONT  !Control-Shift-Alternate does not stop the program
  vdi_text_align(0,3)  !vst_alignment: text left aligned, bottom line
  ' Install defaults: leave 20 Kb free (or reserve 512 Kb), extended dialogs on
  reserve_keep_free!=TRUE
  ram_free_kb&=20
  ram_reserve_kb&=512
  custom_objects!=TRUE
  inf_path$="DS_DRAIN.INF"
  ~@path_locate(inf_path$)  !puts the folder in front of DS_DRAIN.INF
  inf_read_head  !reads the install part of DS_DRAIN.INF
  ' RESERVE with a negative size leaves that many Kb free for other programs; a positive one keeps that
  ' many Kb for the program itself
  IF reserve_keep_free!
    RESERVE -MUL(ram_free_kb&,1024)
  ELSE
    RESERVE MUL(ram_reserve_kb&,1024)
  ENDIF
  help_path$="DS_HILFE.TXT"
  rsc_file$="DS_DRAIN.RSC"
  files_dir$=@current_dir_path$+"daten\"  !default folder for the .PAR source settings files
  par_path$=files_dir$
  ' Global arrays: USERBLKs, window title buffer, saved window positions, find history, menu enable states,
  ' font metrics, list dialog state, dialog positions
  DIM userblk_check%(1)
  DIM userblk_radio%(1)
  DIM userblk_radio_box%(1)
  DIM title_buffer&(60)
  DIM saved_window_pos&(9)
  DIM find_history$(9)
  DIM mbar_enabled!(90)
  DIM font_table&(2,1)
  DIM lists_enabled!(1)
  DIM lst_cur&(1)
  DIM lst_top&(1)
  DIM lst_dim&(1)
  DIM lst_dim_set&(1)
  DIM unused_strings$(1)
  DIM wdialog_x&(10)
  DIM wdialog_y&(10)
  DIM wdialog_edits&(10)
  ' Screen size and centre from the workstation, number of colours
  screen_max_x&=WORK_OUT(0)
  screen_w&=screen_max_x&+1
  screen_mid_x&=SHR&(screen_w&,1)
  screen_max_y&=WORK_OUT(1)
  screen_h&=screen_max_y&+1
  screen_mid_y&=SHR&(screen_h&,1)
  num_colours&=WORK_OUT(13)
  DIM screen_mfdb%(5)
  tos_version&=INT{LPEEK(1266)+2}  !TOS version from the OS header at _sysbase ($4F2)
  aes_version&=INT{LONG{GB+4}}  !AES version from global[0]
  ' Addresses of the VDI arrays, passed to the INLINE text routines and the USERDEF code
  DIM vdi_pb%(4)
  vdi_pb%(0)=CONTRL
  vdi_pb%(1)=INTIN
  vdi_pb%(2)=PTSIN
  vdi_pb%(3)=INTOUT
  vdi_pb%(4)=PTSOUT
  vdi_pb_ptr%=V:vdi_pb%(0)
  INLINE gtext_lines_code%,126
  INLINE asm_draw_text%,66
  INLINE userdef_code%,470
  LONG{userdef_code%+6}=V:vdi_pb%(0)  !the USERDEF code finds the VDI arrays here
  INLINE bitfield_code%,34
  INLINE linea_init_code%,28
  ' Option defaults; DS_DRAIN.INF and the .PAR files overwrite them
  fast_save!=TRUE
  win_align_x!=TRUE
  use_symbols!=TRUE
  trap_comments!=TRUE
  col_mnemonic&=16  !tab columns: instruction 16, operand 24, remark 40
  col_operands&=24
  col_comment&=40
  cpu_mask&=0  !no 68010-68040 instructions
  mem_real_addr!=TRUE
  grow_effects!=TRUE
  calc_hex!=TRUE
  num_hex!=TRUE
  imm_byte_check!=TRUE
  dc_values_hex!=TRUE
  dc_line_len&=40
  dc_ascii_mode&=2
  label_names_hex!=TRUE
  hex_display!=TRUE
  layout_tabs!=TRUE
  bss_size_comment!=TRUE
  unused_flag!=TRUE
  hilite_jumps!=TRUE
  hilite_calls!=TRUE
  hilite_branches!=TRUE
  lst_dim_set&(0)=50  !both list tables 50 entries, Field not active
  lists_enabled!(0)=FALSE
  lst_dim_set&(1)=50
  lists_enabled!(1)=FALSE
  bpl_text&=3  !relative memory: TEXT 3, DATA 10, BSS 6 bytes per editor line
  bpl_data&=10
  bpl_bss&=6
  fixed_line_count%=25000  !absolute memory: 25000 editor lines
  ' GEM traps: AES identified by ",D0", VDI by ",D1", Supopcode byte 2, examine 3 lines back
  aes_reg_pat$=",D0"
  vdi_reg_pat$=",D1"
  vdi_sub_byte|=2
  gem_search_lines|=3
  tos_search_back!=TRUE
  tos_stack_parse!=TRUE
  ' TOS traps: identified by ",-(SP)" or ",D0", examine 2 lines back
  tos_stack_pat$=",-(SP)"
  tos_reg_pat$=",D0"
  tos_search_lines|=2
  font_sizes_scan  !reads the character and line heights of the system font sizes
  ' Large font on screens higher than 200 lines
  IF screen_max_y&>200
    font_idx&=2
  ELSE
    font_idx&=1
  ENDIF
  DIM window_open!(1)
  DIM window_handle&(1)
  DIM window_lines%(1,1)
  DIM slider_pending!(1)
  window_kind&=495  !window gadgets: name, closer, fuller, mover, sizer, arrows, vertical slider
  rsc_init  !loads and fixes up DS_DRAIN.RSC
  mnemonic_tables_init  !builds name tables from DATA lines
  ' Creates the editor window (0) and the help window (1) with the whole screen below the menu bar as maximum
  FOR win_idx|=FALSE TO 1
    window_handle&(win_idx|)=WIND_CREATE(window_kind&,-1,cell_box_h&,screen_w&+1,screen_h&+1)
  NEXT win_idx|
  screen_redraw  !full-screen redraw
  inf_read_rest  !reads the rest of DS_DRAIN.INF
  code_loaded!=FALSE  !was the INF-valid flag; no code is loaded yet
  ' Loads the help file without a file selector and reopens the windows saved in the INF file
  ~@path_locate(help_path$)
  help_file_reload(0)
  windows_restore
  ' DIMs the DATA-in-TEXT range table and the replaced-symbol table at their set lengths
  lst_dim&(0)=lst_dim_set&(0)
  DIM area_ranges%(lst_dim&(0),1)
  DIM area_inactive!(lst_dim&(0))
  lst_dim&(1)=lst_dim_set&(1)
  DIM label_addrs%(lst_dim&(1))
  DIM label_names$(lst_dim&(1))
  memory_max%=FRE(0)  !free memory, shown as maximum memory in the Memory dialog
  DEFMOUSE 0
RETURN
' Decodes the registration name read from DS_DRAIN.REG, in place.
' work_str$: encoded string of words; each word gives one character.  The key starts at 0 and becomes
' 4660 + (word - key) for each word; its low byte is the character.  The result is half as long.
PROCEDURE reg_name_decode(VAR work_str$)
  LOCAL rect_w&,loop_i&
  FOR loop_i&=0 TO LEN(work_str$)-2 STEP 2
    rect_w&=4660+(INT{loop_i&+V:work_str$}-rect_w&)  !4660 = $1234
    BYTE{V:work_str$+SHR(loop_i&,1)}=rect_w&
  NEXT loop_i&
  work_str$=LEFT$(work_str$,SHR(LEN(work_str$),1))  !keep the decoded half
RETURN
' Loads DS_DRAIN.RSC.  When it is not found the user may locate it with the file selector; cancelling or a
' defective file ends the program.  The object constants and tables are set only on the first start
' (progress_objs&() is not DIMmed yet), then the trees are fixed up and the menu bar is shown.
PROCEDURE rsc_init
  IF @path_locate(rsc_file$)=0
    IF @fsel_choose(".RSC","Wo ist die Resource-Datei?",rsc_file$)=0
      program_quit
    ENDIF
  ENDIF
  IF RSRC_LOAD(rsc_file$)=0
    ~FORM_ALERT(1,"[3][|Defekte|RSC-Datei! ][ Ende ]")
    program_quit
  ENDIF
  IF DIM?(progress_objs&())=0  !first start, not a restart
    rsc_constants_set
    rsc_tables_set
  ENDIF
  rsc_objects_fix
RETURN
' Sets the tree indices and object indices of DS_DRAIN.RSC, as a resource editor would list them.
' Trees 0-20 first, then the objects of each tree in tree order.
PROCEDURE rsc_constants_set
  ' Tree indices: 0 menu, 1 About, 2 File options, 3 Installation, 4 Program part, 5 Routine, 6 RAM/ROM,
  ' 7 System info, 8 Memory, 9 Segments, 10 Disassembler options, 11 Assembler customize, 12 DATA in TEXT,
  ' 13 GEM traps, 14 TOS traps, 15 progress, 16 Editor options, 17 Find text, 18 Replaced symbols,
  ' 19 Replace symbol, 20 Edit remark
  tree_menu&=0
  tree_about&=1
  tree_file_opts&=2
  tree_install&=3
  tree_prog_part&=4
  tree_routine&=5
  tree_ramrom&=6
  tree_sysinfo&=7
  tree_memory&=8
  tree_segments&=9
  tree_dis_opts&=10
  tree_asm_opts&=11
  tree_data_in_text&=12
  tree_gem_traps&=13
  tree_tos_traps&=14
  tree_progress&=15
  tree_edit_opts&=16
  tree_find_text&=17
  tree_symbols&=18
  tree_replace&=19
  tree_remark&=20
  ' Menu items: File 11-34, Source 36-45, Disassembler 47-60, Editor 62-72, Process 74-86
  mi_about&=11
  mi_ascii_load&=20
  mi_ascii_save&=21
  mi_file_options&=22
  mi_help_load&=24
  mi_help_clear&=25
  mi_settings_load&=27
  mi_settings_save&=28
  mi_installation&=30
  mi_launch&=31
  mi_file_delete&=32
  mi_quit&=34
  ' Source menu: Program, Program part, Routine, RAM/ROM, Resource, Data, System info, Memory
  mi_src_program&=36
  mi_src_prog_part&=37
  mi_src_routine&=39
  mi_src_ramrom&=40
  mi_src_resource&=41
  mi_src_data&=42
  mi_sysinfo&=44
  mi_memory&=45
  ' Disassembler menu: Segment info, Options, Customization, Data in Text, Block start/end, GEM/TOS traps,
  ' source settings, Disassemble
  mi_segment_info&=47
  mi_dis_options&=48
  mi_customization&=49
  mi_data_in_text&=51
  mi_block_start&=52
  mi_block_end&=53
  mi_gem_traps&=55
  mi_tos_traps&=56
  mi_src_settings_load&=57
  mi_src_settings_save&=58
  mi_disassemble&=60
  ' Editor menu: Editor, Help, Options, Text size, find text/remark/label/call
  mi_editor&=62
  mi_help&=63
  mi_edit_options&=65
  mi_text_size&=66
  mi_find_text&=68
  mi_find_remark&=69
  mi_find_label&=71
  mi_find_call&=72
  ' Process menu: replaced symbols, replace symbol/label, Opcode->Data, Edit remark, trap numbers
  mi_replaced_symbols&=74
  mi_replace_symbol&=75
  mi_replace_this_sym&=76
  mi_replace_this_label&=77
  mi_opcode_to_data&=79
  mi_edit_remark&=80
  mi_aes_number&=82
  mi_vdi_number&=83
  mi_gemdos_number&=84
  mi_bios_number&=85
  mi_xbios_number&=86
  ' About: version, date, registration text
  about_version&=4
  about_date&=5
  about_reg_text&=7
  ' File options: STORE, line address files on save and load, ASCII options, Cancel, OK
  obj_file_store&=2
  obj_file_zla_save&=5
  obj_file_qed&=7
  obj_file_zla_load&=10
  fo_cancel&=12
  fo_ok&=13
  ' Installation: Kb free / Kb reserved radio buttons and fields, Extended dialogs, Restart, OK, Cancel
  obj_inst_keep_free&=3
  obj_inst_keep_kb&=4
  inst_reserve_radio&=6
  obj_inst_reserve_kb&=7
  obj_inst_custom_objs&=10
  obj_inst_restart&=12
  obj_inst_ok&=13
  inst_cancel&=14
  ' Load program part: file, size, from, to, Cancel, OK
  pp_file&=4
  pp_size_dec&=6
  pp_size_hex&=7
  obj_part_start&=9
  obj_part_end&=10
  pp_cancel&=11
  pp_ok&=12
  ' Load routine: file, size, Load all / Load part, from, to, Cancel, OK
  rt_file&=4
  rt_size_dec&=6
  rt_size_hex&=7
  rt_load_all&=10
  obj_rout_range&=11
  obj_rout_start&=13
  obj_rout_end&=14
  rt_cancel&=15
  rt_ok&=16
  ' RAM/ROM area: start, end, Absolute addresses, OK, Cancel
  obj_mem_start&=3
  obj_mem_end&=4
  obj_mem_origin&=5
  obj_mem_ok&=7
  rr_cancel&=8
  ' System info: TOS/AES/GEMDOS versions and the calculator with its buttons
  si_tos_version&=2
  si_input_field&=3
  si_aes_version&=5
  si_gemdos_version&=7
  si_result_field&=8
  si_ascii_field&=9
