' Dialog module function 24: splits an alert text split_alert_text$ into up to eight lines of 50 bytes in
' alert_line_buffer|(). Not called; the copy into alert_text_lines$() after the call (copy_alert_text_lines) is
' never reached. Call to the dialog module MODUL2.OVL: the function number goes to
' CARD{dialog_module_block%+40}, words to +4.., longs and addresses to +20.., then its entry
' dialog_module_entry% is called. It only does anything when the module is loaded (dialog_module_loaded!); when
' it is not, the code runs on into the routine that follows (the RETURN stands inside the IF), which is harmless
' as the program ends without the module.
FUNCTION dial_split_alert_text(split_alert_text$,VAR alert_text_lines$(),alert_line_count&,alert_button_count&)
  $F%
  IF dialog_module_loaded!
    CARD{dialog_module_block%+40}=24
    ' eight lines of 50 bytes
    DIM alert_line_buffer|(400)
    split_alert_text$=split_alert_text$+CHR$(0)
    LONG{dialog_module_block%+20}=V:split_alert_text$
    LONG{dialog_module_block%+24}=V:alert_line_buffer|(0)
    LONG{dialog_module_block%+28}=V:alert_line_count&
    LONG{dialog_module_block%+32}=V:alert_button_count&
    RETURN C:dialog_module_entry%()
    alert_text_lines$(0)=CHAR{V:alert_line_buffer|(0)}
    alert_text_lines$(1)=CHAR{V:alert_line_buffer|(50)}
    alert_text_lines$(2)=CHAR{V:alert_line_buffer|(100)}
    alert_text_lines$(3)=CHAR{V:alert_line_buffer|(150)}
    alert_text_lines$(4)=CHAR{V:alert_line_buffer|(200)}
    alert_text_lines$(5)=CHAR{V:alert_line_buffer|(250)}
    alert_text_lines$(6)=CHAR{V:alert_line_buffer|(300)}
    alert_text_lines$(7)=CHAR{V:alert_line_buffer|(350)}
    ERASE alert_line_buffer|()
  ENDIF
ENDFUNC
