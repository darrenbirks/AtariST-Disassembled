                                                        ' ? =") / ELSE
                                                        show_prompt_text("TIEFE: ? =")
                                                      ELSE
                                                        IF field_index|=0 AND ((line_head_thirteen$="CYCL DEF 1.3 ") OR (line_head_thirteen$="CYCL DEF 3.3 ") OR (line_head_thirteen$="CYCL DEF 4.3 ") OR (line_head_thirteen$="CYCL DEF 5.3 "))
                                                          ' ? =") / ELSE
