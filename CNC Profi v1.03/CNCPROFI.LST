                                                            show_prompt_text("ZUSTELLUNG: ? =")
                                                          ELSE
                                                            IF field_index|=0 AND (line_head_thirteen$="CYCL DEF 5.4 ")
                                                              ' ? =") / ELSE
                                                              show_prompt_text("RADIUS: ? =")
                                                            ELSE
                                                              IF field_index|=0 AND ((line_head_thirteen$="CYCL DEF 3.4 ") OR (line_head_thirteen$="CYCL DEF 3.5 ") OR (line_head_thirteen$="CYCL DEF 4.4 ") OR (line_head_thirteen$="CYCL DEF 4.5 ") OR (line_head_thirteen$="CYCL DEF 7.1 ") OR (line_head_thirteen$="CYCL DEF 7.2 ") OR (line_head_thirteen$="CYCL DEF 7.3 "))
                                                                ' ? =") / ELSE
                                                                show_prompt_text("KOORDINATEN: ? =")
