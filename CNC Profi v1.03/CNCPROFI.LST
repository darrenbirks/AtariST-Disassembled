' Lets the user choose the radius correction at x field_text_x&, line screen_y&: L, R, 0 (Enter) or space, or
' Return to end the block with the previous values; the letter is added to the line. Nothing calls it in the
' demo version. Parameter: screen_y& = y of the line.
PROCEDURE input_radius_correction_choice(screen_y&)
  LOCAL mouse_x&,mouse_y&,search_done!,work_text$,inner_index|,key_event%,key_scan_code&,loop_index|,clicked_icon&
  DEFTEXT 1,1,0,text_height|
  GRAPHMODE 3
  search_done!=FALSE
  REPEAT
    key_event%=0
    REPEAT
      MOUSE mouse_x&,mouse_y&,inner_index|
      key_event%=GEMDOS(6,255)
    UNTIL inner_index| OR key_event%<>0
    IF inner_index|
      mouse_x&=mouse_x&+work_x&
      mouse_y&=mouse_y&+work_y&
      loop_index|=FALSE
      REPEAT
        INC loop_index|
        clicked_icon&=OBJC_FIND(icon_tree%,loop_index|,0,mouse_x&,mouse_y&)
      UNTIL loop_index|=icon_count| OR clicked_icon&<>-1
      key_scan_code&=0
      PAUSE 5
      IF clicked_icon&<>-1
        OB_STATE(icon_tree%,clicked_icon&)=1
        ~OBJC_DRAW(icon_tree%,clicked_icon&,0,work_x&,work_y&,work_w&,work_h&)
      ENDIF
    ELSE
      clicked_icon&=-1
      key_scan_code&=255 AND SHR(key_event%,16)
    ENDIF
    IF clicked_icon&=42 OR key_scan_code&=38
      work_text$=CHR$(76)
      search_done!=TRUE
    ENDIF
    IF clicked_icon&=43 OR key_scan_code&=19
      work_text$=CHR$(82)
      search_done!=TRUE
    ENDIF
    ' R0 (Enter)
    IF clicked_icon&=44 OR key_scan_code&=114
      work_text$=CHR$(48)
      search_done!=TRUE
    ENDIF
    ' no change (space)
    IF clicked_icon&=39 OR key_scan_code&=57
      work_text$=CHR$(32)
      search_done!=TRUE
    ENDIF
    ' Return: end the block
    IF clicked_icon&=40 OR key_scan_code&=28
      GRAPHMODE 1
      take_value_from_previous_line(-1)
      GRAPHMODE 3
      IF block_end_pressed!
        search_done!=TRUE
      ENDIF
    ENDIF
    IF clicked_icon&<>-1 AND key_scan_code&=0
      OB_STATE(icon_tree%,clicked_icon&)=0
      ~OBJC_DRAW(icon_tree%,clicked_icon&,0,work_x&,work_y&,work_w&,work_h&)
    ENDIF
  UNTIL search_done!
  TEXT field_text_x&,screen_y&,work_text$
  IF field_edit_active!
    MID$(program_lines$(cursor_line&),SUCC(field_column|),1)=(work_text$)
  ELSE
    program_lines$(cursor_line&)=program_lines$(cursor_line&)+work_text$
  ENDIF
  GRAPHMODE 1
  DEFTEXT 1,0,0,text_height|
RETURN
