' Keypad ^T: TOOL CALL. In manual mode asks for the spindle speed and shows it. In the editor (no field being
' edited) it only shows the alert "Diese Funktion ist nur in der VOLLVERSION aktiv!" (this function is only
' active in the full version): TOOL CALL lines cannot be entered in the demo version.
PROCEDURE enter_tool_call_block
  LOCAL screen_x&,screen_y&,work_text$,mouse_x&,mouse_y&,inner_index|,key_event%,key_scan_code&,loop_index|,clicked_icon&,search_done!,alert_button|
  GRAPHMODE 1
  ~WIND_UPDATE(1)
  IF manual_mode!
    DEFTEXT 1,0,0,text_height|
    screen_x&=line_text_x&+MUL(char_width|,6)
    TEXT prompt_line_x&,message_line_y&,"Drehzahl=?"
    ' read the spindle speed
    input_field_value(4,0,screen_x&,message_line_y&,0,10,0)
    spindle_speed_shown&=input_value
    TEXT prompt_line_x&,message_line_y&,"                                         "
    screen_y&=-16+panel_bottom&
    screen_x&=speed_readout_x&+MUL(char_width|,2)
    DEFTEXT ,,,13
    TEXT screen_x&,screen_y&,STR$(spindle_speed_shown&)+"    "
    DEFTEXT ,,,text_height|
  ELSE
    ' editor and no field edited
    IF editor_mode! AND (NOT field_edit_active!)
      ALERT 3,"Diese Funktion ist nur|in der VOLLVERSION aktiv!",1," Weiter ",alert_button|
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
RETURN
' Keypad L while a radius correction field is edited: puts "L" (RL) into the field.
PROCEDURE set_radius_correction_left
  LOCAL screen_y&
  ' not in a radius correction field
  IF field_column|<>43 OR block_type|=3 OR block_type|=4 OR block_type|=24 OR block_type|=25
    show_key_without_function
  ELSE
    ~WIND_UPDATE(1)
    DEFTEXT 1,1,0,text_height|
    screen_y&=(cursor_line&-top_line&)*listing_row_height&
    screen_y&=screen_y&+first_line_y&
    GRAPHMODE 4
    TEXT field_text_x&,screen_y&," "
    GRAPHMODE 3
    TEXT field_text_x&,screen_y&,"L"
    MID$(program_lines$(cursor_line&),SUCC(field_column|),1)=("L")
    GRAPHMODE 1
    DEFTEXT 1,0
    ~WIND_UPDATE(0)
  ENDIF
RETURN
