' Keypad S: STOP block. In manual mode asks for the M function on the prompt line and shows it. In the editor
' (no field being edited) it only shows the alert "Diese Funktion ist nur in der VOLLVERSION aktiv!" (this
' function is only active in the full version): STOP lines cannot be entered in the demo version.
PROCEDURE enter_stop_block
  LOCAL screen_x&,screen_y&,alert_button|
  ~WIND_UPDATE(1)
  IF manual_mode!
    DEFTEXT 1,0,0,text_height|
    TEXT prompt_line_x&,message_line_y&,"ZUSATZFUNKTION M = "
    screen_x&=line_text_x&+MUL(char_width|,15)
    ' read the M function number
    input_field_value(2,0,screen_x&,message_line_y&,0,0,0)
    aux_m_function|=input_value
    TEXT prompt_line_x&,message_line_y&,"                                           "
    screen_y&=panel_bottom&-char_cell_height|
    screen_x&=function_readout_x&+MUL(char_width|,2)
    DEFTEXT ,,,13
    TEXT screen_x&,screen_y&,STR$(aux_m_function|)+"  "
    DEFTEXT ,,,text_height|
  ELSE
    IF NOT field_edit_active!
      ALERT 3,"Diese Funktion ist nur|in der VOLLVERSION aktiv!",1," Weiter ",alert_button|
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
RETURN
