' Extern > Programm drucken: prints the program in memory. Shows the print dialog (tree 4) for a comment line
' and the form feed option, checks the printer is ready (GEMDOS 17), then prints the printer set-up code, the
' comment with the date, and every line with its number (bracketed lines get a "{"), with a page number every
' lines_per_page& lines. Cancelling the dialog restores the old comment and option.
PROCEDURE print_program
  LOCAL alert_button|,print_comment_backup$,format_exit_object&,dialog_status&,line_index&,page_number&,text_length&,form_feed_state_backup&,form_feed_at_end!
  ' no program in memory
  IF program_lines$(0)=""
    ALERT 3,"Es befindet sich kein|Programm im Speicher !",1,"Abbruch",alert_button|
  ELSE
    DEFMOUSE 0
    print_comment_backup$=program_print_comment$
    form_feed_state_backup&=OB_STATE(print_program_dialog%,form_feed_object&)
    ' show the last comment in the dialog
    CHAR{LONG{OB_SPEC(print_program_dialog%,print_comment_object&)}}=program_print_comment$
    ~WIND_UPDATE(1)
    format_exit_object&=@dial_run(print_program_dialog%,0,-1,1,1,10,10,dialog_status&)
    ~WIND_UPDATE(0)
    IF dialog_status&=0
      ~FORM_DIAL(3,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&)
    ENDIF
    ON MENU
    ' Drucken pressed
    IF format_exit_object&=program_print_button&
      program_print_comment$=CHAR{LONG{OB_SPEC(print_program_dialog%,print_comment_object&)}}
      ' form feed at the end ticked
      form_feed_at_end!=OB_STATE(print_program_dialog%,form_feed_object&)=17
      ' printer not ready
      IF GEMDOS(17)=0
        ALERT 3,"Drucker ist nicht|empfangsbereit !!",1,"Abbruch",alert_button|
      ELSE
        ~WIND_UPDATE(1)
        DEFMOUSE 2
        ' printer set-up code
        IF printer_codes$(7)<>""
          LPRINT printer_codes$(7);
        ENDIF
        LPRINT "    ";program_print_comment$;SPC(60-LEN(program_print_comment$));DATE$
        LPRINT
        LPRINT
        page_number&=0
        FOR line_index&=0 TO last_line&
          ' spaces to align the line text after the number
          text_length&=6-LEN(STR$(line_index&))
          ' a bracketed line is printed with a leading brace
          IF RIGHT$(program_lines$(line_index&))="}"
            DEC text_length&
            LPRINT "        ";line_index&;SPC(text_length&);"{";program_lines$(line_index&)
          ELSE
            LPRINT "        ";line_index&;SPC(text_length&);program_lines$(line_index&)
          ENDIF
          ' end of a page
          IF line_index& MOD lines_per_page&=0 AND line_index&>1
            INC page_number&
            LPRINT
            LPRINT
            LPRINT SPC(30);"Seite ";page_number&
            LPRINT CHR$(12);
            LPRINT
            LPRINT
          ENDIF
        NEXT line_index&
        ' a part page is left
        IF line_index& MOD lines_per_page&
          INC page_number&
          LPRINT
          LPRINT SPC(30);"Seite ";page_number&
          IF form_feed_at_end!
            LPRINT CHR$(12);
          ELSE
            LPRINT
            LPRINT
            LPRINT
          ENDIF
        ENDIF
      ENDIF
      ~WIND_UPDATE(0)
    ELSE
      program_print_comment$=print_comment_backup$
      OB_STATE(print_program_dialog%,form_feed_object&)=form_feed_state_backup&
    ENDIF
    DEFMOUSE 3
  ENDIF
RETURN
' Extern > alle Programme drucken: prints every .CNC program of a chosen directory one after another (at most
' 100). The program in memory is saved in offset_contour_elements$() and put back at the end. Each file is read
' like load_program reads it: plain text, or the CNCPROFI format (a seed in bytes +128 ended by 194, then lines
' XORed with a key made from the seed, 255 ending a line and codes below 26 standing for runs of spaces).
PROCEDURE print_all_programs
  LOCAL loop_index|,alert_button|,unused_print_text$,print_line_index&,text_length&,line_index&,edit_work_text$,directory_backup$,saved_last_line&,cipher_seed%,seed_top_byte|,seed_second_byte|,cipher_key|,file_byte|,work_text$
  ALERT 1,"WÑhlen Sie bitte das Ver-|zeichnis aus, aus dem ALLE|'.CNC'-Dateien an den Drucker|ausgegeben werden sollen.",1," Weiter |Abbruch",alert_button|
  IF alert_button|=1
    directory_backup$=program_directory$
    ' choose the directory with the file selector
    edit_work_text$=@select_file$("Druckverzeichnis auswÑhlen",program_directory$+"*.CNC","")
    ON MENU
    IF edit_work_text$<>""
      IF RIGHT$(edit_work_text$)<>"\"
        scan_index&=LEN(edit_work_text$)
        ' cut the file name off the path
        WHILE MID$(edit_work_text$,scan_index&,1)<>"\"
          DEC scan_index&
        WEND
        edit_work_text$=LEFT$(edit_work_text$,scan_index&)
      ENDIF
      IF GEMDOS(17)=0
        ALERT 3,"Drucker ist nicht|empfangsbereit !!",1,"Abbruch",choice_number|
      ELSE
        ~WIND_UPDATE(1)
        DEFMOUSE 2
        IF printer_codes$(7)<>""
          LPRINT printer_codes$(7);
        ENDIF
        ' save the program in memory
        FOR line_index&=0 TO last_line&
          offset_contour_elements$(0,line_index&)=program_lines$(line_index&)
        NEXT line_index&
        saved_last_line&=last_line&
        program_directory$=edit_work_text$
        list_cnc_files
        loop_index|=FALSE
        DEFMOUSE 2
        IF cnc_file_list$(0)=""
          ALERT 3,"Es existieren im ausgewÑhlten|Verzeichnis keine Dateien!",1,"Abbruch",alert_button|
        ELSE
          ' read the seed: digits stored +128, ended by 194
          REPEAT
            OPEN "i",#1,program_directory$+cnc_file_list$(loop_index|)
            INPUT #1,edit_work_text$
            IF edit_work_text$<>"CNCPROFI"
              SEEK 1,0
              RECALL #1,program_lines$(),max_program_lines&,lines_loaded%
            ELSE
              edit_work_text$=""
              REPEAT
                file_byte|=INP(#1)
                IF file_byte|<>194
                  edit_work_text$=edit_work_text$+CHR$(file_byte|-128)
                ENDIF
              UNTIL file_byte|=194
              cipher_seed%=VAL(edit_work_text$)
              ' top byte of the seed
              seed_top_byte|=BYTE(ROL(-16777216 AND cipher_seed%,8))
              ' second byte of the seed
              seed_second_byte|=BYTE(ROR(65280 AND cipher_seed%,8))
              IF seed_second_byte|=0
                INC seed_second_byte|
              ENDIF
              ' XOR key of the file
              cipher_key|=BYTE(138 XOR seed_top_byte| MOD seed_second_byte|)
              line_index&=0
              edit_work_text$=""
              REPEAT
                file_byte|=cipher_key| XOR INP(#1)
                ' 255 ends a line
                IF file_byte|=255
                  program_lines$(line_index&)=edit_work_text$
                  edit_work_text$=""
                  INC line_index&
                ELSE
                  IF file_byte|
                    ' codes 1 to 25 are digits of a space count
                    IF file_byte|<26
                      work_text$=""
                      REPEAT
                        work_text$=work_text$+CHR$(32+file_byte|)
                        file_byte|=cipher_key| XOR INP(#1)
                      UNTIL file_byte|<0 OR file_byte|>25
                      ' expand the run of spaces
                      edit_work_text$=edit_work_text$+SPACE$(VAL(work_text$))
                      RELSEEK 1,-1
                    ELSE
                      edit_work_text$=edit_work_text$+CHR$(file_byte|)
                    ENDIF
                  ENDIF
                ENDIF
                ' 0 ends the file
              UNTIL file_byte|=0 OR line_index&>max_program_lines&
              lines_loaded%=line_index&
            ENDIF
            CLOSE #1
            IF FRE(0)<1000
              ALERT 3,"Der Speicher ist fÅr|ein geladenes Programm|zu klein!",1," Weiter ",alert_button|
              last_line&=lines_loaded%-1
            ELSE
              IF lines_loaded%>=max_program_lines&
                ALERT 3,"Die Anzahl der maximalen|ProgrammsÑtze ist zu gering!|Das Programm kann nicht|vollstÑndig geladen werden!",1," Weiter ",alert_button|
                last_line&=max_program_lines&
                line_index&=13
                REPEAT
                  INC line_index&
                UNTIL MID$(program_lines$(0),line_index&,1)=" "
                program_lines$(last_line&)="END     PGM "+MID$(program_lines$(0),13,line_index&-13)
              ELSE
                last_line&=lines_loaded%-1
              ENDIF
            ENDIF
            line_index&=0
            page_number&=0
            FOR print_line_index&=0 TO last_line&
              text_length&=6-LEN(STR$(print_line_index&))
              IF RIGHT$(program_lines$(print_line_index&))="}"
                DEC text_length&
                LPRINT "        ";print_line_index&;SPC(text_length&);"{";program_lines$(print_line_index&)
              ELSE
                LPRINT "        ";print_line_index&;SPC(text_length&);program_lines$(print_line_index&)
              ENDIF
              IF line_index& MOD lines_per_page&=0 AND line_index&>1
                INC page_number&
                LPRINT
                LPRINT
                LPRINT SPC(30);"Seite ";page_number&
                IF form_feed_at_end!
                  LPRINT CHR$(12);
                ENDIF
                LPRINT
                LPRINT
              ENDIF
              INC line_index&
            NEXT print_line_index&
            INC loop_index|
            LPRINT CHR$(12);
          UNTIL (cnc_file_list$(loop_index|)="") OR loop_index|>=100
          IF line_index& MOD lines_per_page&
            INC page_number&
            LPRINT
            LPRINT SPC(30);"Seite ";page_number&
            IF form_feed_at_end!
              LPRINT CHR$(12);
            ELSE
              LPRINT
              LPRINT
              LPRINT
            ENDIF
          ENDIF
          IF loop_index|>100
            ALERT 3,"Es kînnen maximal 100|Programme hintereinander|ausgedruckt werden!",1," Weiter ",alert_button|
          ENDIF
        ENDIF
        last_line&=saved_last_line&
        ' put the program in memory back
        FOR line_index&=0 TO last_line&
          program_lines$(line_index&)=offset_contour_elements$(0,line_index&)
        NEXT line_index&
        DEFMOUSE 3
        ~WIND_UPDATE(0)
      ENDIF
    ENDIF
    program_directory$=directory_backup$
    DEFMOUSE 3
  ENDIF
RETURN
' Keypad ^B: the block functions dialog (tree 2). Kopieren (copy) only shows the alert "Diese Funktion ist nur
' in der VOLLVERSION aktiv!" (this function is only active in the full version); Laden (load) and Speichern
' (save) call load_or_save_block_demo, which shows the same alert, and redraw the list. Move copies the marked
' block to the cursor (copy_block_to_cursor) and deletes the original; Deaktivieren removes the block marking;
' Loeschen deletes the block after a confirmation; Umdrehen reverses the block (reverse_marked_block); Drucken
' prints it. Not available while a field is being edited.
PROCEDURE block_functions_dialog
  LOCAL format_exit_object&,dialog_status&,line_index&,block_copy_ok!
  ' not while a field is edited
  IF NOT field_edit_active!
    DEFMOUSE 0
    ~WIND_UPDATE(1)
    format_exit_object&=@dial_run(block_functions_tree%,0,-1,1,1,10,10,dialog_status&)
    ~WIND_UPDATE(0)
    DEFMOUSE 3
    IF dialog_status&=0
      ~FORM_DIAL(3,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&)
    ENDIF
    ON MENU
    ~WIND_UPDATE(1)
    IF format_exit_object&<>block_cancel_button&
      ' lines in the block
      line_index&=block_end_line&-block_start_line&
      INC line_index&
      SELECT format_exit_object&
      CASE block_copy_button&
        ALERT 3,"Diese Funktion ist nur|in der VOLLVERSION aktiv!",1," Weiter ",alert_button|
      CASE block_move_button&
        IF NOT block_marked!
          show_no_block_message
        ELSE
          ' Verschieben: copy the block to the cursor, then delete the original
          copy_block_to_cursor(block_copy_ok!,line_index&)
          IF block_copy_ok!
            ' the copy went in before the block, so the block moved down
            IF cursor_line&<block_start_line&
              block_end_line&=block_end_line&+line_index&
              cursor_line&=cursor_line&+line_index&
              top_line&=cursor_line&-half_visible_lines&
            ENDIF
            delete_marked_block
            block_start_line&=-1
            block_end_line&=-1
          ENDIF
        ENDIF
      CASE block_load_button&
        ' Laden (load), and Speichern (save) below with 0: load_or_save_block_demo only shows the full-version alert
        load_or_save_block_demo(-1)
        IF drawn_cursor_line&=-2
          DEC drawn_cursor_line&
        ELSE
          drawn_cursor_line&=-2
        ENDIF
        list_redraw_needed!=TRUE
        draw_program_listing
      CASE block_save_button&
        load_or_save_block_demo(0)
        IF drawn_cursor_line&=-2
          DEC drawn_cursor_line&
        ELSE
          drawn_cursor_line&=-2
        ENDIF
        list_redraw_needed!=TRUE
        draw_program_listing
      CASE block_deactivate_button&
        ' Deaktivieren: remove the block marking
        IF NOT block_marked!
          show_no_block_message
        ELSE
          IF block_highlight_shown!
            GRAPHMODE 2
            DEFFILL 0,2,1
            PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
            GRAPHMODE 1
            DEFFILL 0,1,1
          ENDIF
          block_marked!=FALSE
          block_highlight_shown!=FALSE
          block_start_line&=-1
          block_end_line&=-1
        ENDIF
      CASE block_delete_button&
        IF NOT block_marked!
          show_no_block_message
        ELSE
          ALERT 2,"Wollen Sie den|     BLOCK|wirklich lîschen ?",1,"   JA   |  NEIN  ",choice_number|
          IF choice_number|=1
            ' cursor inside the block: put it before the block
            IF cursor_line&>=block_start_line& AND cursor_line&<=block_end_line&
              cursor_line&=block_start_line&-1
              top_line&=cursor_line&-half_visible_lines&
            ELSE
              SUB cursor_line&,line_index&
              IF cursor_line&<0
                cursor_line&=0
              ENDIF
            ENDIF
            delete_marked_block
            SUB last_line&,line_index&
            block_start_line&=-1
            block_end_line&=-1
          ENDIF
        ENDIF
      CASE block_reverse_button&
        IF NOT block_marked!
          show_no_block_message
        ELSE
          reverse_marked_block
        ENDIF
      CASE block_functions_print&
        print_marked_block
      ENDSELECT
      IF top_line&<0
        top_line&=0
      ENDIF
    ENDIF
    drawn_cursor_line&=-2
    field_index|=255
    list_redraw_needed!=TRUE
    ~WIND_UPDATE(0)
  ELSE
    show_key_without_function
  ENDIF
RETURN
' Inserts a copy of the marked block (block_start_line& to block_end_line&) after the cursor line cursor_line&,
' from the last line backwards. Refused, with a message, when the cursor is inside the block or the program
' would get too long; stops when memory runs out. Returns: block_copy_ok! = TRUE when the copy was made,
' search_block& = lines not copied when it stopped early.
PROCEDURE copy_block_to_cursor(VAR block_copy_ok!,search_block&)
  LOCAL line_index&,scan_index&,program_line$,search_done!
  ' the cursor is inside the block
  IF cursor_line&>=block_start_line& AND cursor_line&<block_end_line&
    block_copy_ok!=FALSE
    GRAPHMODE 1
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    GRAPHMODE 3
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    PRINT CHR$(7);
    show_message_text("AKTUELLE ZEILE LIEGT IM BLOCK")
    PAUSE 70
    GRAPHMODE 1
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  ELSE
    ' the program would get too long
    IF max_program_lines&<=SUCC(cursor_line&+(block_end_line&-block_start_line&))
      block_copy_ok!=FALSE
      GRAPHMODE 1
      PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
      GRAPHMODE 3
      PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
      PRINT CHR$(7);
      show_message_text("BLOCK ZU GROSS! MAX. ZEILENANZAHL WIRD UEBERSCHRITTEN!")
      PAUSE 70
      GRAPHMODE 1
      PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    ELSE
      DEFMOUSE 2
      block_copy_ok!=TRUE
      scan_index&=block_end_line&
      line_index&=cursor_line&+1
      search_done!=FALSE
      INC scan_index&
      REPEAT
        DEC scan_index&
        ' copy the lines from the end of the block backwards
        program_line$=program_lines$(scan_index&)
        IF FRE(0)<2000
          search_done!=TRUE
          PRINT CHR$(7);
          show_message_text("DER SPEICHER REICHT FöR DIESE OPERATION NICHT AUS!")
        ELSE
          INSERT program_lines$(line_index&)=program_line$
          ' inserting before the block shifts it down by one
          IF scan_index&>line_index&
            INC scan_index&
            INC block_start_line&
          ENDIF
        ENDIF
      UNTIL scan_index&=block_start_line& OR search_done!
      IF search_done!
        search_block&=block_end_line&-scan_index&
      ENDIF
      DEFMOUSE 3
    ENDIF
  ENDIF
RETURN
' Deletes the lines of the marked block from the program and removes the block marking and its highlight.
PROCEDURE delete_marked_block
  LOCAL scan_index&
  FOR scan_index&=block_start_line& TO block_end_line&
    DELETE program_lines$(block_start_line&)
  NEXT scan_index&
  IF block_highlight_shown!
    GRAPHMODE 2
    DEFFILL 0,2,1
    PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
    GRAPHMODE 1
    DEFFILL 0,1,1
  ENDIF
  block_marked!=FALSE
  block_highlight_shown!=FALSE
RETURN
' Block functions > Drucken: prints the lines of the marked block, like print_program prints the whole program,
' with the block print dialog (tree 10) for the comment and form feed option.
PROCEDURE print_marked_block
  LOCAL alert_button|,block_comment_backup$,format_exit_object&,dialog_status&,line_index&,page_number&,form_feed_state_backup&,form_feed_at_end!,text_length&
  IF NOT block_marked!
    show_no_block_message
  ELSE
    DEFMOUSE 0
    block_comment_backup$=block_print_comment$
    CHAR{LONG{OB_SPEC(print_block_dialog%,block_comment_object&)}}=block_print_comment$
    form_feed_state_backup&=OB_STATE(print_block_dialog%,block_form_feed_object&)
    ~WIND_UPDATE(1)
    format_exit_object&=@dial_run(print_block_dialog%,0,-1,1,1,10,10,dialog_status&)
    ~WIND_UPDATE(0)
    IF dialog_status&=0
      ~FORM_DIAL(3,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&)
    ENDIF
    ON MENU
    IF format_exit_object&=block_print_button&
      block_print_comment$=CHAR{LONG{OB_SPEC(print_block_dialog%,block_comment_object&)}}
      form_feed_at_end!=OB_STATE(print_block_dialog%,block_form_feed_object&)=17
      IF GEMDOS(17)=0
        ALERT 3,"Drucker ist nicht|empfangsbereit !!",1,"Abbruch",alert_button|
      ELSE
        ~WIND_UPDATE(1)
        DEFMOUSE 2
        LPRINT "    ";block_print_comment$;SPC(60-LEN(block_print_comment$));DATE$
        LPRINT
        LPRINT
        page_number&=0
        FOR line_index&=block_start_line& TO block_end_line&
          text_length&=6-LEN(STR$(line_index&))
          IF RIGHT$(program_lines$(line_index&))="}"
            DEC text_length&
            LPRINT "        ";line_index&;SPC(text_length&);"{";program_lines$(line_index&)
          ELSE
            LPRINT "        ";line_index&;SPC(text_length&);program_lines$(line_index&)
          ENDIF
          IF line_index& MOD lines_per_page&=0 AND line_index&>1
            INC page_number&
            LPRINT
            LPRINT
            LPRINT SPC(30);"Seite ";page_number&
            IF printer_codes$(7)<>""
              LPRINT CHR$(12);printer_codes$(7)
            ELSE
              LPRINT CHR$(12)
            ENDIF
            LPRINT
            LPRINT
          ENDIF
        NEXT line_index&
        IF form_feed_at_end!
          LPRINT CHR$(12)
        ELSE
          LPRINT
          LPRINT
          LPRINT
        ENDIF
      ENDIF
      ~WIND_UPDATE(0)
    ELSE
      block_print_comment$=block_comment_backup$
      OB_STATE(print_block_dialog%,block_form_feed_object&)=form_feed_state_backup&
    ENDIF
    DEFMOUSE 3
  ENDIF
RETURN
' Demo version stub: only shows the alert "Diese Funktion ist nur in der VOLLVERSION aktiv!" (this function is
' only active in the full version). In the full version: Block functions > Laden / Speichern. loading!=TRUE
' loads a .BLK file (plain text or CNCPROFI format, BEGIN and END lines skipped) and inserts its lines after the
' cursor; FALSE saves the marked block as a .BLK file in the CNCPROFI format with a random seed (only reached in
' the full version). Parameter: loading! = TRUE to load, FALSE to save.
PROCEDURE load_or_save_block_demo(loading!)
  LOCAL alert_button|
  ALERT 3,"Diese Funktion ist nur|in der VOLLVERSION aktiv!",1," Weiter ",alert_button|
RETURN
' Sets the RS-232 baud rate (Rsconf), then with loading!=TRUE reads program lines from the port into the lines
' after the cursor until a mouse button is pressed or nothing has arrived for 2 seconds, showing the line count;
' a mouse button throws the last line away. Nothing calls it in the demo version. Parameter: loading! = TRUE to
' receive.
PROCEDURE receive_program_by_rs232(loading!)
  LOCAL program_line$,unused_receive_flag!,inner_index|,scan_index&,last_receive_time%,received_char&,arc_start_layer&
  ~XBIOS(15,baud_rate_index|,0,L:-1,L:-1)
  IF loading!
    scan_index&=0
    arc_start_layer&=cursor_line&
    INC cursor_line&
    INSERT program_lines$(cursor_line&)=""
    PRINT AT(18,10);"Eingelesene Zeile:"
    last_receive_time%=TIMER
    REPEAT
      inner_index|=MOUSEK
      ' a character waiting
      IF GEMDOS(18)
        last_receive_time%=TIMER
        received_char&=GEMDOS(3)
        program_lines$(cursor_line&)=program_lines$(cursor_line&)+CHR$(received_char&)
        PRINT AT(38,10);scan_index&
        ' line feed ends the line
        IF received_char&=10
          INC cursor_line&
          INSERT program_lines$(cursor_line&)=""
        ENDIF
      ENDIF
      ' mouse button or 2 seconds without data
    UNTIL inner_index| OR (TIMER-last_receive_time%>400 AND (program_lines$(1)<>""))
    DELETE program_lines$(cursor_line&)
    IF inner_index|
      DEC cursor_line&
    ELSE
      IF inner_index|=0
        last_line&=last_line&+(cursor_line&-arc_start_layer&)
      ENDIF
    ENDIF
  ENDIF
RETURN
' Block functions > Umdrehen: reverses the marked block so the contour is cut in the opposite direction. The
' block must start with an L line with absolute X, Y and Z, have more than one line and no bracketed lines. The
' lines are rebuilt last to first in offset_contour_elements$(): end points become start points, incremental
' values change sign, arc directions DR+/DR- and CR radii R+/R- swap, radius corrections RL/RR swap, CT and CTP
' arcs become C arcs with a new CC centre, polar lines get their angle and radius recalculated, and LBL / CALL
' LBL / CYCL lines are kept in a valid order. On an error the line goes to the error list (error_blocks&(),
' error_messages$()).
PROCEDURE reverse_marked_block
  LOCAL line_index&,rect_width&,scan_index&,item_count&,search_line&,screen_x&,screen_y&,unused_reverse_count&,point_distance,work_point_y,cut_depth,x_axis_flag!,y_axis_flag!,z_axis_flag!,line_has_x!,line_has_y!,line_has_z!,program_line$,lookahead_third_block_text$,search_done!,corner_text_h$,corner_text_v$,z_value_text$,third_block_text$,feed_source_line&,radius_correction_text$,correction_source_line&,x_absolute_line&,y_absolute_line&,z_absolute_line&,element_count&,input_column&,input_row&,z_value_column&,first_crossing_x,first_crossing_y,z_increment,saved_x_absolute_line&,saved_y_absolute_line&,saved_z_absolute_line&,added_line_count&,last_point_first,last_point_second,centre_search_line&,last_point_depth,element_arc_radius,angle_offset,edit_work_text$,result_text$,alert_button|,direction_x,direction_y
  ~WIND_UPDATE(1)
  block_reverse_running!=TRUE
  datum_shift_on!=FALSE
  mirror_x!=FALSE
  mirror_y!=FALSE
  mirror_z!=FALSE
  mirror_reverses_direction!=FALSE
  mirror_x_after_rotation!=TRUE
  mirror_y_after_rotation!=TRUE
  mirror_z_after_rotation!=TRUE
  rotation_active!=FALSE
  rotation_angle=0
  rotation_spare_value=0
  scaling_active!=FALSE
  ARRAYFILL datum_shift(),0
  ARRAYFILL datum_shift_in_plane(),0
  run_aborted!=FALSE
  error_blocks&(0)=-1
  x_axis_flag!=FALSE
  y_axis_flag!=FALSE
  z_axis_flag!=FALSE
  program_line$=program_lines$(block_start_line&)
  lookahead_third_block_text$=program_lines$(block_end_line&)
  search_done!=FALSE
  line_index&=block_start_line&-1
  REPEAT
    INC line_index&
    ' bracketed lines are not allowed
    IF RIGHT$(program_lines$(line_index&))="}"
      show_message_text("ES DARF KEIN SATZ AUSGEKLAMMERT SEIN !")
      search_done!=TRUE
    ENDIF
  UNTIL line_index&=block_end_line& OR search_done!
  IF NOT search_done!
    ' fewer than two lines
    IF block_end_line&-block_start_line&<=1
      show_message_text("ES MöSSEN MEHR ALS 1 SATZ BEARBEITET WERDEN !")
      search_done!=TRUE
    ELSE
      IF (LEFT$(program_line$,3)<>"L  ") OR LEN(program_line$)<20 OR (MID$(program_line$,7,1)="A")
        show_message_text("ERSTER SATZ MUSS EINE LINIE (MIT KART.KOORD.) SEIN!")
        search_done!=TRUE
      ELSE
        IF MID$(program_line$,axis_value_columns|(1)-3,2)=" X"
          x_axis_flag!=TRUE
          corner_text_h$=MID$(program_line$,PRED(axis_value_columns|(1)),9)
        ENDIF
        IF MID$(program_line$,axis_value_columns|(2)-3,2)=" Y"
          y_axis_flag!=TRUE
          corner_text_v$=MID$(program_line$,PRED(axis_value_columns|(2)),9)
        ENDIF
        IF MID$(program_line$,axis_value_columns|(3)-3,2)=" Z"
          z_axis_flag!=TRUE
          z_value_text$=MID$(program_line$,PRED(axis_value_columns|(3)),9)
        ENDIF
        IF (NOT x_axis_flag!) OR (NOT y_axis_flag!) OR (NOT z_axis_flag!)
          show_message_text("KOORDINATEN MöSSEN IM 1. SATZ ABSOLUT DEFINIERT SEIN!")
          search_done!=TRUE
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF NOT search_done!
    DEFMOUSE 2
    show_message_text("EINEN MOMENT BITTE !")
    scan_index&=block_end_line&+1
    third_block_text$=MKL$(538976288)
    REPEAT
      DEC scan_index&
      ' the feed of the last line of the block
      IF LEN(program_lines$(scan_index&))>50
        third_block_text$=MID$(program_lines$(scan_index&),48,4)
      ENDIF
    UNTIL (third_block_text$<>"    ") OR scan_index&<block_start_line&
    IF scan_index&<block_start_line&
      third_block_text$=MKL$(807411744)
    ENDIF
    feed_source_line&=scan_index&
    correction_source_line&=block_end_line&
    x_absolute_line&=block_end_line&
    y_absolute_line&=block_end_line&
    z_absolute_line&=block_end_line&
    corner_text_h$=""
    corner_text_v$=""
    z_value_text$=""
    element_count&=0
    added_line_count&=0
    ARRAYFILL label_blocks&(),0
    item_count&=0
    line_index&=block_end_line&+1
    ' the new first line: an L line to the old end point
    program_line$="L     X+   0.000  Y+   0.000  Z+   0.000  R   F      M  "
    x_axis_flag!=TRUE
    y_axis_flag!=TRUE
    z_axis_flag!=TRUE
    input_column&=axis_value_columns|(1)-1
    input_row&=axis_value_columns|(2)-1
    z_value_column&=axis_value_columns|(3)-1
    ' absolute position at the end of the block
    find_absolute_axis_values(-1,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
    DEC line_index&
    carry_correction_and_feed(line_index&,program_line$,radius_correction_text$,correction_source_line&,third_block_text$,feed_source_line&)
    offset_contour_elements$(0,item_count&)=program_line$
    INC item_count&
    REPEAT
      program_line$=program_lines$(line_index&)
      lookahead_third_block_text$=LEFT$(program_line$,3)
      point_distance=0
      work_point_y=0
      cut_depth=0
      IF (lookahead_third_block_text$="L  ") AND LEN(program_line$)>20 AND (MID$(program_line$,7,1)<>"A") OR (lookahead_third_block_text$="C  ") OR (lookahead_third_block_text$="CT ") OR (lookahead_third_block_text$="CR ")
        scan_index&=4
        IF lookahead_third_block_text$="L  "
          x_axis_flag!=TRUE
          y_axis_flag!=TRUE
          z_axis_flag!=TRUE
          input_column&=axis_value_columns|(1)-1
          input_row&=axis_value_columns|(2)-1
          z_value_column&=axis_value_columns|(3)-1
        ELSE
          x_axis_flag!=FALSE
          y_axis_flag!=FALSE
          z_axis_flag!=FALSE
          line_has_x!=FALSE
          line_has_y!=FALSE
          line_has_z!=FALSE
          REPEAT
            INC scan_index&
            IF MID$(program_line$,scan_index&,1)="X"
              x_axis_flag!=TRUE
              line_has_x!=TRUE
              input_column&=scan_index&+1
            ELSE
              IF MID$(program_line$,scan_index&,1)="Y"
                y_axis_flag!=TRUE
                line_has_y!=TRUE
                input_row&=scan_index&+1
              ELSE
                IF MID$(program_line$,scan_index&,1)="Z"
                  z_axis_flag!=TRUE
                  line_has_z!=TRUE
                  z_value_column&=scan_index&+1
                ENDIF
              ENDIF
            ENDIF
          UNTIL scan_index&=33
        ENDIF
        IF x_axis_flag! AND line_index&>x_absolute_line&
          x_axis_flag!=FALSE
          ' incremental X: reverse its sign and take it off the position
          IF MID$(program_line$,SUB(input_column&,2),1)="I"
            IF MID$(program_line$,input_column&,1)="-"
              MID$(program_line$,input_column&,1)=("+")
            ELSE
              MID$(program_line$,input_column&,1)=("-")
            ENDIF
            first_crossing_x=VAL(MID$(program_line$,SUCC(input_column&),8))
            IF MID$(program_line$,input_column&,1)="-"
              first_crossing_x=-first_crossing_x
            ENDIF
            SUB point_distance,first_crossing_x
          ELSE
            ' absolute X: blanked in an L line, else the earlier value
            IF LEFT$(program_line$)="L"
              MID$(program_line$,SUB(input_column&,2),11)=("           ")
            ELSE
              MID$(program_line$,input_column&,9)=(corner_text_h$)
            ENDIF
          ENDIF
        ENDIF
        IF y_axis_flag! AND line_index&>y_absolute_line&
          y_axis_flag!=FALSE
          IF MID$(program_line$,SUB(input_row&,2),1)="I"
            IF MID$(program_line$,input_row&,1)="-"
              MID$(program_line$,input_row&,1)=("+")
            ELSE
              MID$(program_line$,input_row&,1)=("-")
            ENDIF
            first_crossing_y=VAL(MID$(program_line$,SUCC(input_row&),8))
            IF MID$(program_line$,input_row&,1)="-"
              first_crossing_y=-first_crossing_y
            ENDIF
            SUB work_point_y,first_crossing_y
          ELSE
            IF LEFT$(program_line$)="L"
              MID$(program_line$,SUB(input_row&,2),11)=("           ")
            ELSE
              MID$(program_line$,input_row&,9)=(corner_text_v$)
            ENDIF
          ENDIF
        ENDIF
        IF z_axis_flag! AND line_index&>z_absolute_line&
          z_axis_flag!=FALSE
          IF MID$(program_line$,SUB(z_value_column&,2),1)="I"
            IF MID$(program_line$,z_value_column&,1)="-"
              MID$(program_line$,z_value_column&,1)=("+")
            ELSE
              MID$(program_line$,z_value_column&,1)=("-")
            ENDIF
            z_increment=VAL(MID$(program_line$,SUCC(z_value_column&),8))
            IF MID$(program_line$,z_value_column&,1)="-"
              z_increment=-z_increment
            ENDIF
            SUB cut_depth,z_increment
          ELSE
            IF LEFT$(program_line$)="L"
              MID$(program_line$,SUB(z_value_column&,2),11)=("           ")
            ELSE
              MID$(program_line$,z_value_column&,9)=(z_value_text$)
            ENDIF
          ENDIF
        ENDIF
        find_absolute_axis_values(-1,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
        carry_correction_and_feed(line_index&,program_line$,radius_correction_text$,correction_source_line&,third_block_text$,feed_source_line&)
        ' CR arc: reverse the radius sign
        IF lookahead_third_block_text$="CR "
          IF MID$(program_line$,40,2)="R+"
            MID$(program_line$,40,2)=("R-")
          ELSE
            IF MID$(program_line$,40,2)="R-"
              MID$(program_line$,40,2)=("R+")
            ENDIF
          ENDIF
          offset_contour_elements$(0,item_count&)=program_line$
        ELSE
          ' CT arc: turned into a C arc with a CC centre
          IF lookahead_third_block_text$="CT "
            move_end(1)=point_distance
            move_end(2)=work_point_y
            move_end(3)=cut_depth
            end_x_text$=corner_text_h$
            end_y_text$=corner_text_v$
            end_z_text$=z_value_text$
            IF line_has_x!
              x_axis_flag!=TRUE
            ENDIF
            IF line_has_y!
              y_axis_flag!=TRUE
            ENDIF
            IF line_has_z!
              z_axis_flag!=TRUE
            ENDIF
            saved_x_absolute_line&=x_absolute_line&
            saved_y_absolute_line&=y_absolute_line&
            saved_z_absolute_line&=z_absolute_line&
            point_distance=0
            work_point_y=0
            cut_depth=0
            rect_width&=line_index&-1
            find_absolute_axis_values(0,rect_width&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
            x_absolute_line&=saved_x_absolute_line&
            y_absolute_line&=saved_y_absolute_line&
            z_absolute_line&=saved_z_absolute_line&
            previous_block_start(1)=point_distance
            previous_block_start(2)=work_point_y
            previous_block_start(3)=cut_depth
            edit_work_text$=LEFT$(program_lines$(rect_width&))
            result_text$=LEFT$(program_lines$(rect_width&),3)
            ' the line before a CT must be a C or L line with the same axes
            IF NOT (edit_work_text$="L") AND LEN(program_lines$(rect_width&))>20 AND (MID$(program_lines$(rect_width&),7,1)<>"A") OR ((edit_work_text$="C") AND (result_text$<>"CC ") AND (result_text$<>"CYC") AND (result_text$<>"CAL"))
              ALERT 3,"Vor einem CT-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              error_blocks&(0)=line_index&
              error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
            ELSE
              IF edit_work_text$="C"
                after_line_element!=FALSE
                IF result_text$="CR "
                  start_point(1)=point_distance
                  start_point(2)=work_point_y
                  start_point(3)=cut_depth
                  interpret_radius_arc(program_lines$(rect_width&))
                  move_arc_direction$=MID$(program_lines$(rect_width&),40,1)
                ELSE
                  IF edit_work_text$="C"
                    centre_search_line&=rect_width&
                    REPEAT
                      DEC centre_search_line&
                      edit_work_text$=LEFT$(program_lines$(centre_search_line&),2)
                    UNTIL (edit_work_text$="CC") OR centre_search_line&=0
                    IF centre_search_line&=0
                      ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      error_blocks&(0)=rect_width&
                      error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
                    ELSE
                      set_plane_from_centre(program_lines$(centre_search_line&))
                      programmed_position(1)=point_distance
                      programmed_position(2)=work_point_y
                      programmed_position(3)=cut_depth
                      read_circle_centre(program_lines$(centre_search_line&))
                      move_arc_direction$=MID$(program_lines$(rect_width&),32,1)
                      previous_centre(first_plane_axis|)=circle_centre(first_plane_axis|)
                      previous_centre(second_plane_axis|)=circle_centre(second_plane_axis|)
                    ENDIF
                  ENDIF
                ENDIF
              ELSE
                after_line_element!=TRUE
              ENDIF
              IF NOT run_aborted!
                start_point(1)=move_end(1)
                start_point(2)=move_end(2)
                start_point(3)=move_end(3)
                end_point(1)=last_point_first
                end_point(2)=last_point_second
                end_point(3)=last_point_depth
                current_block&=line_index&
                current_draw_block&=rect_width&
                ' work out the centre of the CT arc
                interpret_tangential_arc(program_lines$(line_index&))
                circle_centre(first_plane_axis|)=ROUND(circle_centre(first_plane_axis|)*1000)/1000
                format_coordinate_text(circle_centre(first_plane_axis|),corner_text_h$)
                circle_centre(second_plane_axis|)=ROUND(circle_centre(second_plane_axis|)*1000)/1000
                format_coordinate_text(circle_centre(second_plane_axis|),corner_text_v$)
                IF line_has_x! AND line_has_y!
                  ' the new CC line
                  offset_contour_elements$(0,item_count&)="CC    X"+corner_text_h$+"  Y"+corner_text_v$
                ELSE
                  IF line_has_x! AND line_has_z!
                    offset_contour_elements$(0,item_count&)="CC    Z"+corner_text_h$+"  X"+corner_text_v$
                  ELSE
                    IF line_has_y! AND line_has_z!
                      offset_contour_elements$(0,item_count&)="CC    Y"+corner_text_h$+"  Z"+corner_text_v$
                    ENDIF
                  ENDIF
                ENDIF
                INC item_count&
                IF line_has_x! AND line_has_y!
                  ' reverse the direction of rotation
                  IF arc_direction$="+"
                    program_line$="C     X"+end_x_text$+"  Y"+end_y_text$+"  DR-         "+RIGHT$(program_line$,14)
                  ELSE
                    program_line$="C     X"+end_x_text$+"  Y"+end_y_text$+"  DR+         "+RIGHT$(program_line$,14)
                  ENDIF
                ELSE
                  IF line_has_x! AND line_has_z!
                    IF arc_direction$="+"
                      program_line$="C     X"+end_x_text$+"  Z"+end_z_text$+"  DR-         "+RIGHT$(program_line$,14)
                    ELSE
                      program_line$="C     X"+end_x_text$+"  Z"+end_z_text$+"  DR+         "+RIGHT$(program_line$,14)
                    ENDIF
                  ELSE
                    IF line_has_y! AND line_has_z!
                      IF arc_direction$="+"
                        program_line$="C     Y"+end_y_text$+"  Z"+end_z_text$+"  DR-         "+RIGHT$(program_line$,14)
                      ELSE
                        program_line$="C     Y"+end_y_text$+"  Z"+end_z_text$+"  DR+         "+RIGHT$(program_line$,14)
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                point_distance=start_point(1)
                work_point_y=start_point(2)
                point_distance=start_point(3)
                offset_contour_elements$(0,item_count&)=program_line$
                INC added_line_count&
              ENDIF
            ENDIF
          ELSE
            IF lookahead_third_block_text$="L  "
              offset_contour_elements$(0,item_count&)=program_line$
            ELSE
              ' C arc: reverse the direction of rotation
              IF MID$(program_line$,32,2)="R+"
                MID$(program_line$,32,2)=("R-")
              ELSE
                IF MID$(program_line$,32,2)="R-"
                  MID$(program_line$,32,2)=("R+")
                ENDIF
              ENDIF
              rect_width&=line_index&
              REPEAT
                DEC rect_width&
                ' find the CC centre of the arc
              UNTIL (LEFT$(program_lines$(rect_width&),2)="CC") OR rect_width&=0
              IF rect_width&=0
                ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=line_index&
                error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
              ELSE
                IF rect_width&=PRED(line_index&)
                  offset_contour_elements$(0,item_count&)=program_lines$(rect_width&)
                  INC item_count&
                  offset_contour_elements$(0,item_count&)=program_line$
                  DEC line_index&
                ELSE
                  offset_contour_elements$(0,item_count&)=program_lines$(rect_width&)
                  INC item_count&
                  offset_contour_elements$(0,item_count&)=program_line$
                  INC added_line_count&
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ELSE
        ' polar line or arc
        IF (lookahead_third_block_text$="LP ") OR (lookahead_third_block_text$="CP ")
          search_line&=line_index&
          REPEAT
            DEC search_line&
          UNTIL (LEFT$(program_lines$(search_line&),2)="CC") OR search_line&=0
          IF search_line&=0
            x_axis_flag!=TRUE
            y_axis_flag!=TRUE
            z_axis_flag!=TRUE
          ELSE
            x_axis_flag!=FALSE
            y_axis_flag!=FALSE
            z_axis_flag!=FALSE
            REPEAT
              INC scan_index&
              IF MID$(program_lines$(search_line&),scan_index&,1)="X"
                x_axis_flag!=TRUE
              ELSE
                IF MID$(program_lines$(search_line&),scan_index&,1)="Y"
                  y_axis_flag!=TRUE
                ELSE
                  IF MID$(program_lines$(search_line&),scan_index&,1)="Z"
                    z_axis_flag!=TRUE
                  ENDIF
                ENDIF
              ENDIF
            UNTIL scan_index&=25
          ENDIF
          find_absolute_axis_values(0,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
          end_point(1)=point_distance
          end_point(2)=work_point_y
          end_point(3)=cut_depth
          IF search_line&=0
            ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=line_index&
            error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
          ELSE
            end_x_text$=corner_text_h$
            end_y_text$=corner_text_v$
            end_z_text$=z_value_text$
            IF line_has_x!
              x_axis_flag!=TRUE
            ENDIF
            IF line_has_y!
              y_axis_flag!=TRUE
            ENDIF
            IF line_has_z!
              z_axis_flag!=TRUE
            ENDIF
            saved_x_absolute_line&=x_absolute_line&
            saved_y_absolute_line&=y_absolute_line&
            saved_z_absolute_line&=z_absolute_line&
            point_distance=0
            work_point_y=0
            cut_depth=0
            find_absolute_axis_values(0,search_line&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
            x_absolute_line&=saved_x_absolute_line&
            y_absolute_line&=saved_y_absolute_line&
            z_absolute_line&=saved_z_absolute_line&
            corner_text_h$=end_x_text$
            corner_text_v$=end_y_text$
            z_value_text$=end_z_text$
            programmed_position(1)=point_distance
            programmed_position(2)=work_point_y
            programmed_position(3)=cut_depth
            set_plane_from_centre(program_lines$(search_line&))
            read_circle_centre(program_lines$(search_line&))
          ENDIF
          IF NOT run_aborted!
            scan_index&=4
            REPEAT
              INC scan_index&
            UNTIL MID$(program_line$,scan_index&,1)="A"
            INC scan_index&
            offset_contour_elements$(0,item_count&)=program_lines$(search_line&)
            INC item_count&
            IF search_line&<>PRED(line_index&)
              INC added_line_count&
            ENDIF
            ' polar angle of the new start point
            direction_x=end_point(first_plane_axis|)-circle_centre(first_plane_axis|)
            direction_y=end_point(second_plane_axis|)-circle_centre(second_plane_axis|)
            element_arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
            IF element_arc_radius<.0001
              angle_offset=0
            ELSE
              angle_offset=direction_x/element_arc_radius
              angle_offset=@clamped_arc_cosine(angle_offset)
              IF direction_y<0
                angle_offset=two_pi-angle_offset
              ENDIF
              MUL angle_offset,180/PI
            ENDIF
            format_coordinate_text(angle_offset,formatted_value$)
            MID$(program_line$,scan_index&,9)=(formatted_value$)
            IF MID$(program_line$,SUB(scan_index&,3),1)="I"
              MID$(program_line$,SUB(scan_index&,3),1)=(" ")
            ENDIF
            IF lookahead_third_block_text$="LP "
              scan_index&=4
              REPEAT
                INC scan_index&
              UNTIL MID$(program_line$,scan_index&,1)="R"
              INC scan_index&
              format_coordinate_text(element_arc_radius,formatted_value$)
              MID$(program_line$,scan_index&,9)=(formatted_value$)
            ENDIF
            ' correction and feed for the reversed line
            carry_correction_and_feed(line_index&,program_line$,radius_correction_text$,correction_source_line&,third_block_text$,feed_source_line&)
            IF lookahead_third_block_text$="CP "
              IF MID$(program_line$,32,2)="R+"
                MID$(program_line$,32,2)=("R-")
              ELSE
                IF MID$(program_line$,32,2)="R-"
                  MID$(program_line$,32,2)=("R+")
                ENDIF
              ENDIF
            ENDIF
            offset_contour_elements$(0,item_count&)=program_line$
          ENDIF
          point_distance=end_point(1)
          work_point_y=end_point(2)
          cut_depth=end_point(3)
          IF search_line&=PRED(line_index&)
            DEC line_index&
          ENDIF
        ELSE
          ' polar tangential arc
          IF lookahead_third_block_text$="CTP"
            find_absolute_axis_values(0,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
            move_end(1)=point_distance
            move_end(2)=work_point_y
            move_end(3)=cut_depth
            end_x_text$=corner_text_h$
            end_y_text$=corner_text_v$
            end_z_text$=z_value_text$
            IF line_has_x!
              x_axis_flag!=TRUE
            ENDIF
            IF line_has_y!
              y_axis_flag!=TRUE
            ENDIF
            IF line_has_z!
              z_axis_flag!=TRUE
            ENDIF
            saved_x_absolute_line&=x_absolute_line&
            saved_y_absolute_line&=y_absolute_line&
            saved_z_absolute_line&=z_absolute_line&
            point_distance=0
            work_point_y=0
            cut_depth=0
            rect_width&=line_index&-1
            edit_work_text$=LEFT$(program_lines$(rect_width&))
            result_text$=LEFT$(program_lines$(rect_width&),3)
            IF result_text$="CC "
              DEC rect_width&
              edit_work_text$=LEFT$(program_lines$(rect_width&))
              result_text$=LEFT$(program_lines$(rect_width&),3)
              IF NOT (edit_work_text$="L") AND LEN(program_lines$(rect_width&))>20 AND (MID$(program_lines$(rect_width&),7,1)<>"A") OR ((edit_work_text$="C") AND (result_text$<>"CC ") AND (result_text$<>"CYC") AND (result_text$<>"CAL"))
                ALERT 3,"Vor einem CTP-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=current_block&
                error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
              ENDIF
            ELSE
              IF NOT (edit_work_text$="L") AND LEN(program_lines$(rect_width&))>20 AND (MID$(program_lines$(rect_width&),7,1)<>"A") OR ((edit_work_text$="C") AND (result_text$<>"CC ") AND (result_text$<>"CYC") AND (result_text$<>"CAL"))
                ALERT 3,"Vor einem CTP-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=current_block&
                error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
              ENDIF
            ENDIF
            IF NOT ctp_skip_lookup
              find_absolute_axis_values(0,rect_width&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
              x_absolute_line&=saved_x_absolute_line&
              y_absolute_line&=saved_y_absolute_line&
              z_absolute_line&=saved_z_absolute_line&
              previous_block_start(1)=point_distance
              previous_block_start(2)=work_point_y
              previous_block_start(3)=cut_depth
              IF edit_work_text$="C"
                after_line_element!=FALSE
                IF result_text$="CR "
                  start_point(1)=point_distance
                  start_point(2)=work_point_y
                  start_point(3)=cut_depth
                  interpret_radius_arc(program_lines$(rect_width&))
                  move_arc_direction$=MID$(program_lines$(rect_width&),40,1)
                ELSE
                  IF edit_work_text$="C"
                    centre_search_line&=rect_width&
                    REPEAT
                      DEC centre_search_line&
                      edit_work_text$=LEFT$(program_lines$(centre_search_line&),2)
                    UNTIL (edit_work_text$="CC") OR centre_search_line&=0
                    IF centre_search_line&=0
                      ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      error_blocks&(0)=rect_width&
                      error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
                    ELSE
                      set_plane_from_centre(program_lines$(centre_search_line&))
                      programmed_position(1)=point_distance
                      programmed_position(2)=work_point_y
                      programmed_position(3)=cut_depth
                      read_circle_centre(program_lines$(centre_search_line&))
                      move_arc_direction$=MID$(program_lines$(rect_width&),32,1)
                      previous_centre(first_plane_axis|)=circle_centre(first_plane_axis|)
                      previous_centre(second_plane_axis|)=circle_centre(second_plane_axis|)
                    ENDIF
                  ENDIF
                ENDIF
              ELSE
                after_line_element!=TRUE
              ENDIF
              IF NOT run_aborted!
                search_line&=line_index&
                REPEAT
                  DEC search_line&
                UNTIL (LEFT$(program_lines$(search_line&),2)="CC") OR search_line&=0
                IF search_line&=0
                  ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
                  run_aborted!=TRUE
                  error_blocks&(0)=line_index&
                  error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
                ELSE
                  scan_index&=6
                  line_has_x!=FALSE
                  line_has_y!=FALSE
                  line_has_z!=FALSE
                  REPEAT
                    INC scan_index&
                    IF MID$(program_lines$(search_line&),scan_index&,1)="X"
                      line_has_x!=TRUE
                    ELSE
                      IF MID$(program_lines$(search_line&),scan_index&,1)="Y"
                        line_has_y!=TRUE
                      ELSE
                        IF MID$(program_lines$(search_line&),scan_index&,1)="Z"
                          line_has_z!=TRUE
                        ENDIF
                      ENDIF
                    ENDIF
                  UNTIL scan_index&=25
                  set_plane_from_centre(program_lines$(search_line&))
                  programmed_position(1)=move_end(1)
                  programmed_position(2)=move_end(2)
                  programmed_position(3)=move_end(3)
                  read_circle_centre(program_lines$(search_line&))
                  start_point(1)=move_end(1)
                  start_point(2)=move_end(2)
                  start_point(3)=move_end(3)
                  current_block&=line_index&
                  current_draw_block&=rect_width&
                  interpret_polar_tangential_arc(program_lines$(line_index&))
                  circle_centre(first_plane_axis|)=ROUND(circle_centre(first_plane_axis|)*1000)/1000
                  format_coordinate_text(circle_centre(first_plane_axis|),corner_text_h$)
                  circle_centre(second_plane_axis|)=ROUND(circle_centre(second_plane_axis|)*1000)/1000
                  format_coordinate_text(circle_centre(second_plane_axis|),corner_text_v$)
                  IF line_has_x! AND line_has_y!
                    offset_contour_elements$(0,item_count&)="CC    X"+corner_text_h$+"  Y"+corner_text_v$
                  ELSE
                    IF line_has_x! AND line_has_z!
                      offset_contour_elements$(0,item_count&)="CC    Z"+corner_text_h$+"  X"+corner_text_v$
                    ELSE
                      IF line_has_y! AND line_has_z!
                        offset_contour_elements$(0,item_count&)="CC    Y"+corner_text_h$+"  Z"+corner_text_v$
                      ENDIF
                    ENDIF
                  ENDIF
                  INC item_count&
                  IF line_has_x! AND line_has_y!
                    IF arc_direction$="+"
                      program_line$="C     X"+end_x_text$+"  Y"+end_y_text$+"  DR-         "+RIGHT$(program_line$,14)
                    ELSE
                      program_line$="C     X"+end_x_text$+"  Y"+end_y_text$+"  DR+         "+RIGHT$(program_line$,14)
                    ENDIF
                  ELSE
                    IF line_has_x! AND line_has_z!
                      IF arc_direction$="+"
                        program_line$="C     X"+end_x_text$+"  Z"+end_z_text$+"  DR-         "+RIGHT$(program_line$,14)
                      ELSE
                        program_line$="C     X"+end_x_text$+"  Z"+end_z_text$+"  DR+         "+RIGHT$(program_line$,14)
                      ENDIF
                    ELSE
                      IF line_has_y! AND line_has_z!
                        IF arc_direction$="+"
                          program_line$="C     Y"+end_y_text$+"  Z"+end_z_text$+"  DR-         "+RIGHT$(program_line$,14)
                        ELSE
                          program_line$="C     Y"+end_y_text$+"  Z"+end_z_text$+"  DR+         "+RIGHT$(program_line$,14)
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  offset_contour_elements$(0,item_count&)=program_line$
                  point_distance=start_point(1)
                  work_point_y=start_point(2)
                  point_distance=start_point(3)
                  DEC line_index&
                ENDIF
              ENDIF
            ENDIF
          ELSE
            IF lookahead_third_block_text$="RND"
              carry_correction_and_feed(line_index&,program_line$,radius_correction_text$,correction_source_line&,third_block_text$,feed_source_line&)
              offset_contour_elements$(0,item_count&)=program_line$
            ELSE
              ' cycle lines are copied in their own order
              IF (LEFT$(program_line$,8)="CYCL DEF") OR (LEFT$(program_line$,9)="CYCL CALL")
                scan_index&=line_index&
                REPEAT
                  DEC scan_index&
                UNTIL (LEFT$(program_lines$(scan_index&),8)<>"CYCL DEF") OR scan_index&=0
                INC scan_index&
                FOR search_line&=scan_index& TO line_index&
                  offset_contour_elements$(0,item_count&)=program_lines$(search_line&)
                  INC item_count&
                NEXT search_line&
                line_index&=scan_index&
                DEC item_count&
              ELSE
                ' LBL 0 ends a subprogram: move it with its label
                IF LEFT$(program_line$,11)="LBL       0"
                  scan_index&=-1
                  search_done!=FALSE
                  REPEAT
                    INC scan_index&
                    IF line_index&=label_blocks&(scan_index&)
                      search_done!=TRUE
                    ENDIF
                  UNTIL scan_index&=99
                  IF NOT search_done!
                    scan_index&=line_index&
                    element_count&=0
                    search_done!=FALSE
                    REPEAT
                      DEC scan_index&
                      edit_work_text$=MID$(program_lines$(scan_index&),11,3)
                      rect_width&=VAL(edit_work_text$)
                      IF (LEFT$(program_lines$(scan_index&),3)="LBL") AND rect_width&<>0
                        IF element_count&=0
                          search_done!=TRUE
                        ELSE
                          DEC element_count&
                        ENDIF
                      ELSE
                        IF (LEFT$(program_lines$(scan_index&),11)="LBL       0") OR (LEFT$(program_lines$(scan_index&),8)="CALL LBL")
                          INC element_count&
                        ENDIF
                      ENDIF
                    UNTIL search_done! OR scan_index&=block_start_line&
                    IF scan_index&=block_start_line&
                      offset_contour_elements$(0,item_count&)=program_line$
                    ELSE
                      offset_contour_elements$(0,item_count&)="LBL       "+edit_work_text$
                      program_lines$(scan_index&)=program_line$
                      label_blocks&(VAL(edit_work_text$))=scan_index&
                    ENDIF
                  ELSE
                    offset_contour_elements$(0,item_count&)=program_line$
                  ENDIF
                ELSE
                  ' CALL LBL: keep the label before the call
                  IF LEFT$(program_line$,8)="CALL LBL"
                    edit_work_text$=MID$(program_line$,11,3)
                    rect_width&=VAL(edit_work_text$)
                    scan_index&=line_index&
                    search_done!=FALSE
                    REPEAT
                      DEC scan_index&
                      IF program_lines$(scan_index&)=("LBL       "+edit_work_text$)
                        search_done!=TRUE
                      ENDIF
                    UNTIL search_done! OR scan_index&=block_start_line&
                    IF scan_index&=block_start_line&
                      offset_contour_elements$(0,item_count&)=program_line$
                    ELSE
                      offset_contour_elements$(0,item_count&)="LBL       "+edit_work_text$
                      program_lines$(scan_index&)=program_line$
                    ENDIF
                  ELSE
                    offset_contour_elements$(0,item_count&)=program_line$
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      INC item_count&
      DEC line_index&
      last_point_first=point_distance
      last_point_second=work_point_y
      last_point_depth=cut_depth
      ' until the start of the block or an error
    UNTIL line_index&=block_start_line& OR run_aborted!
    IF NOT run_aborted!
      radius_correction_text$=MID$(program_lines$(line_index&),44,1)
      ' swap the radius correction of the first line
      IF radius_correction_text$="L"
        radius_correction_text$=CHR$(82)
      ELSE
        IF radius_correction_text$="R"
          radius_correction_text$=CHR$(76)
        ENDIF
      ENDIF
      MID$(program_lines$(line_index&),44,1)=(radius_correction_text$)
      scan_index&=0
      ' lines added for new CC lines
      WHILE scan_index&<added_line_count&
        INSERT program_lines$(block_end_line&)=" "
        INC block_end_line&
        INC last_line&
        INC cursor_line&
        INC top_line&
        INC scan_index&
      WEND
      scan_index&=block_start_line&
      ' copy the reversed lines back
      FOR search_line&=0 TO PRED(item_count&)
        program_lines$(scan_index&)=offset_contour_elements$(0,search_line&)
        INC scan_index&
      NEXT search_line&
      IF block_highlight_shown!
        GRAPHMODE 2
        DEFFILL 0,2,1
        PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
        GRAPHMODE 1
        DEFFILL 0,1,1
      ENDIF
      block_marked!=FALSE
      block_highlight_shown!=FALSE
      block_start_line&=-1
      block_end_line&=-1
    ENDIF
    drawn_cursor_line&=-2
    draw_program_listing
    GRAPHMODE 1
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    DEFMOUSE 3
  ELSE
    ' reversal failed
    ALERT 3,"Blockumdrehen ist|nicht mîglich!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    error_blocks&(0)=block_start_line&
    error_messages$(0)="BLOCKUMDREHEN IST NICHT MôGLICH!"
  ENDIF
  block_reverse_running!=FALSE
  ~WIND_UPDATE(0)
RETURN
' Walks back from line line_index& to find the absolute X, Y and Z position in force there, adding up
' incremental values (IX/IY/IZ) until an absolute value is found for every requested axis. Polar lines (LP, CP,
' CTP) are resolved through their CC centre, recursively. Parameters: write_coordinates! = TRUE to also write
' the values into program_line$ at columns input_column&/input_row&/z_value_column&; line_index& = line;
' x_axis_flag!/y_axis_flag!/z_axis_flag! = axes still wanted. Returns: point_distance/work_point_y/cut_depth =
' X/Y/Z, corner_text_h$/corner_text_v$/z_value_text$ = the values as text,
' x_absolute_line&/y_absolute_line&/z_absolute_line& = the lines where the absolute values were found.
PROCEDURE find_absolute_axis_values(write_coordinates!,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,VAR program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
  LOCAL work_text$,earlier_line_prefix$,rect_width&,scan_index&,search_line&,end_x_text$,end_y_text$,end_z_text$,line_has_x!,line_has_y!,line_has_z!,first_crossing_x,first_crossing_y,z_increment,saved_x_axis_flag!,saved_y_axis_flag!,saved_z_axis_flag!,saved_x_absolute_line&,saved_y_absolute_line&,saved_z_absolute_line&,edit_work_text$,result_text$,alert_button|,point_u,point_v,centre_search_line&
  REPEAT
    DEC line_index&
    work_text$=program_lines$(line_index&)
    earlier_line_prefix$=LEFT$(work_text$,3)
    IF (earlier_line_prefix$="L  ") AND LEN(work_text$)>20 AND (MID$(work_text$,7,1)<>"A") OR (earlier_line_prefix$="C  ") OR (earlier_line_prefix$="CT ") OR (earlier_line_prefix$="CR ")
      IF x_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="X") OR scan_index&=32
        IF scan_index&<32
          ' incremental X: add it up
          IF MID$(work_text$,PRED(scan_index&),1)="I"
            ' absolute X found
            INC scan_index&
            first_crossing_x=VAL(MID$(work_text$,SUCC(scan_index&),8))
            IF MID$(work_text$,scan_index&,1)="-"
              first_crossing_x=-first_crossing_x
            ENDIF
            point_distance=point_distance+first_crossing_x
          ELSE
            INC scan_index&
            x_absolute_line&=line_index&
            IF point_distance=0
              corner_text_h$=MID$(work_text$,scan_index&,9)
              IF write_coordinates!
                MID$(program_line$,PRED(input_column&),1)=("X")
                MID$(program_line$,input_column&,9)=(corner_text_h$)
              ENDIF
              point_distance=VAL(MID$(corner_text_h$,2,8))
              IF LEFT$(corner_text_h$)="-"
                point_distance=-point_distance
              ENDIF
              x_axis_flag!=FALSE
            ELSE
              first_crossing_x=VAL(MID$(work_text$,SUCC(scan_index&),8))
              IF MID$(work_text$,scan_index&,1)="-"
                first_crossing_x=-first_crossing_x
              ENDIF
              point_distance=point_distance+first_crossing_x
              format_coordinate_text(point_distance,corner_text_h$)
              IF write_coordinates!
                MID$(program_line$,PRED(input_column&),1)=("X")
                MID$(program_line$,input_column&,9)=(corner_text_h$)
              ENDIF
              x_axis_flag!=FALSE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      IF y_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="Y") OR scan_index&=32
        IF scan_index&<32
          IF MID$(work_text$,PRED(scan_index&),1)="I"
            INC scan_index&
            first_crossing_y=VAL(MID$(work_text$,SUCC(scan_index&),8))
            IF MID$(work_text$,scan_index&,1)="-"
              first_crossing_y=-first_crossing_y
            ENDIF
            work_point_y=work_point_y+first_crossing_y
          ELSE
            INC scan_index&
            y_absolute_line&=line_index&
            IF work_point_y=0
              corner_text_v$=MID$(work_text$,scan_index&,9)
              IF write_coordinates!
                MID$(program_line$,PRED(input_row&),1)=("Y")
                MID$(program_line$,input_row&,9)=(corner_text_v$)
              ENDIF
              work_point_y=VAL(MID$(corner_text_v$,2,8))
              IF LEFT$(corner_text_v$)="-"
                work_point_y=-work_point_y
              ENDIF
              y_axis_flag!=FALSE
            ELSE
              first_crossing_y=VAL(MID$(work_text$,SUCC(scan_index&),8))
              IF MID$(work_text$,scan_index&,1)="-"
                first_crossing_y=-first_crossing_y
              ENDIF
              work_point_y=work_point_y+first_crossing_y
              format_coordinate_text(work_point_y,corner_text_v$)
              IF write_coordinates!
                MID$(program_line$,PRED(input_row&),1)=("Y")
                MID$(program_line$,input_row&,9)=(corner_text_v$)
              ENDIF
              y_axis_flag!=FALSE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      IF z_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="Z") OR scan_index&=33
        IF scan_index&<33
          IF MID$(work_text$,PRED(scan_index&),1)="I"
            INC scan_index&
            z_increment=VAL(MID$(work_text$,SUCC(scan_index&),8))
            IF MID$(work_text$,scan_index&,1)="-"
              z_increment=-z_increment
            ENDIF
            cut_depth=cut_depth+z_increment
          ELSE
            INC scan_index&
            z_absolute_line&=line_index&
            IF cut_depth=0
              z_value_text$=MID$(work_text$,scan_index&,9)
              IF write_coordinates!
                MID$(program_line$,PRED(z_value_column&),1)=("Z")
                MID$(program_line$,z_value_column&,9)=(z_value_text$)
              ENDIF
              cut_depth=VAL(MID$(z_value_text$,2,8))
              IF LEFT$(z_value_text$)="-"
                cut_depth=-cut_depth
              ENDIF
              z_axis_flag!=FALSE
            ELSE
              z_increment=VAL(MID$(work_text$,SUCC(scan_index&),8))
              IF MID$(work_text$,scan_index&,1)="-"
                z_increment=-z_increment
              ENDIF
              cut_depth=cut_depth+z_increment
              format_coordinate_text(cut_depth,z_value_text$)
              IF write_coordinates!
                MID$(program_line$,PRED(z_value_column&),1)=("Z")
                MID$(program_line$,z_value_column&,9)=(z_value_text$)
              ENDIF
              z_axis_flag!=FALSE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ELSE
      ' a polar line: resolve it through its centre
      IF (earlier_line_prefix$="LP ") OR (earlier_line_prefix$="CP ") OR (earlier_line_prefix$="CTP") AND (x_axis_flag! OR y_axis_flag!)
        saved_x_axis_flag!=x_axis_flag!
        saved_y_axis_flag!=y_axis_flag!
        saved_z_axis_flag!=z_axis_flag!
        saved_x_absolute_line&=x_absolute_line&
        saved_y_absolute_line&=y_absolute_line&
        saved_z_absolute_line&=z_absolute_line&
        search_line&=line_index&
        REPEAT
          DEC search_line&
          ' find the CC centre
        UNTIL (LEFT$(program_lines$(search_line&),2)="CC") OR search_line&=0
        IF search_line&=0
          ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=line_index&
          error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
        ELSE
          x_axis_flag!=FALSE
          y_axis_flag!=FALSE
          z_axis_flag!=FALSE
          line_has_x!=FALSE
          line_has_y!=FALSE
          line_has_z!=FALSE
          REPEAT
            INC scan_index&
            IF MID$(program_lines$(search_line&),scan_index&,1)="X"
              x_axis_flag!=TRUE
              line_has_x!=TRUE
            ELSE
              IF MID$(program_lines$(search_line&),scan_index&,1)="Y"
                y_axis_flag!=TRUE
                line_has_y!=TRUE
              ELSE
                IF MID$(program_lines$(search_line&),scan_index&,1)="Z"
                  z_axis_flag!=TRUE
                  line_has_z!=TRUE
                ENDIF
              ENDIF
            ENDIF
          UNTIL scan_index&=25
          find_absolute_axis_values(0,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
          IF NOT run_aborted!
            move_end(1)=point_distance
            move_end(2)=work_point_y
            move_end(3)=cut_depth
            x_axis_flag!=TRUE
            y_axis_flag!=TRUE
            z_axis_flag!=TRUE
            point_distance=0
            work_point_y=0
            cut_depth=0
            find_absolute_axis_values(0,search_line&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
            programmed_position(1)=point_distance
            programmed_position(2)=work_point_y
            programmed_position(3)=cut_depth
            set_plane_from_centre(program_lines$(search_line&))
            read_circle_centre(program_lines$(search_line&))
            point_u=circle_centre(first_plane_axis|)
            point_v=circle_centre(second_plane_axis|)
            IF earlier_line_prefix$="LP "
              start_point(1)=point_distance
              start_point(2)=work_point_y
              start_point(3)=cut_depth
              current_block&=line_index&
              interpret_polar_line(work_text$)
            ELSE
              IF earlier_line_prefix$="CP "
                start_point(1)=point_distance
                start_point(2)=work_point_y
                start_point(3)=cut_depth
                current_block&=line_index&
                interpret_polar_arc(work_text$)
              ELSE
                x_axis_flag!=TRUE
                y_axis_flag!=TRUE
                z_axis_flag!=TRUE
                point_distance=0
                work_point_y=0
                cut_depth=0
                rect_width&=line_index&-1
                edit_work_text$=LEFT$(program_lines$(rect_width&))
                result_text$=LEFT$(program_lines$(rect_width&),3)
                IF result_text$="CC "
                  DEC rect_width&
                  edit_work_text$=LEFT$(program_lines$(rect_width&))
                  result_text$=LEFT$(program_lines$(rect_width&),3)
                  IF NOT (edit_work_text$="L") AND LEN(program_lines$(rect_width&))>20 AND (MID$(program_lines$(rect_width&),7,1)<>"A") OR ((edit_work_text$="C") AND (result_text$<>"CC ") AND (result_text$<>"CYC") AND (result_text$<>"CAL"))
                    ALERT 3,"Vor einem CTP-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    error_blocks&(0)=current_block&
                    error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
                  ENDIF
                ELSE
                  IF NOT (edit_work_text$="L") AND LEN(program_lines$(rect_width&))>20 AND (MID$(program_lines$(rect_width&),7,1)<>"A") OR ((edit_work_text$="C") AND (result_text$<>"CC ") AND (result_text$<>"CYC") AND (result_text$<>"CAL"))
                    ALERT 3,"Vor einem CTP-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    error_blocks&(0)=current_block&
                    error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
                  ENDIF
                ENDIF
                IF NOT ctp_skip_lookup
                  find_absolute_axis_values(0,rect_width&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$,x_absolute_line&,y_absolute_line&,z_absolute_line&,point_distance,work_point_y,cut_depth,corner_text_h$,corner_text_v$,z_value_text$)
                  previous_block_start(1)=point_distance
                  previous_block_start(2)=work_point_y
                  previous_block_start(3)=cut_depth
                  IF edit_work_text$="C"
                    after_line_element!=FALSE
                    IF result_text$="CR "
                      start_point(1)=point_distance
                      start_point(2)=work_point_y
                      start_point(3)=cut_depth
                      interpret_radius_arc(program_lines$(rect_width&))
                      move_arc_direction$=MID$(program_lines$(rect_width&),40,1)
                    ELSE
                      IF edit_work_text$="C"
                        centre_search_line&=rect_width&
                        REPEAT
                          DEC centre_search_line&
                          edit_work_text$=LEFT$(program_lines$(centre_search_line&),2)
                        UNTIL (edit_work_text$="CC") OR centre_search_line&=0
                        IF centre_search_line&=0
                          ALERT 3,"Kreismittelpunkt muû|vorher eingeben werden!",1,"Abbruch",alert_button|
                          run_aborted!=TRUE
                          error_blocks&(0)=rect_width&
                          error_messages$(0)="KREISMITTELPUNKT MUSS VORHER EINGEGEBEN WERDEN!"
                        ELSE
                          set_plane_from_centre(program_lines$(centre_search_line&))
                          programmed_position(1)=point_distance
                          programmed_position(2)=work_point_y
                          programmed_position(3)=cut_depth
                          read_circle_centre(program_lines$(centre_search_line&))
                          move_arc_direction$=MID$(program_lines$(rect_width&),32,1)
                          previous_centre(first_plane_axis|)=circle_centre(first_plane_axis|)
                          previous_centre(second_plane_axis|)=circle_centre(second_plane_axis|)
                        ENDIF
                      ELSE
                        after_line_element!=TRUE
                      ENDIF
                    ENDIF
                    IF NOT run_aborted!
                      circle_centre(first_plane_axis|)=point_u
                      circle_centre(second_plane_axis|)=point_v
                      start_point(1)=move_end(1)
                      start_point(2)=move_end(2)
                      start_point(3)=move_end(3)
                      current_block&=line_index&
                      current_draw_block&=rect_width&
                      interpret_polar_tangential_arc(work_text$)
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
            IF NOT run_aborted!
              x_axis_flag!=saved_x_axis_flag!
              y_axis_flag!=saved_y_axis_flag!
              z_axis_flag!=saved_z_axis_flag!
              x_absolute_line&=saved_x_absolute_line&
              y_absolute_line&=saved_y_absolute_line&
              z_absolute_line&=saved_z_absolute_line&
              IF first_plane_axis|=1
                seed_top_byte|=1
                seed_second_byte|=2
                tool_axis_index|=3
                plane_uses_x!=TRUE
                plane_uses_y!=TRUE
                plane_uses_z!=FALSE
              ELSE
                IF first_plane_axis|=2
                  seed_top_byte|=2
                  seed_second_byte|=3
                  tool_axis_index|=1
                  plane_uses_y!=TRUE
                  plane_uses_z!=TRUE
                  plane_uses_x!=FALSE
                ELSE
                  seed_top_byte|=3
                  seed_second_byte|=1
                  tool_axis_index|=2
                  plane_uses_z!=TRUE
                  plane_uses_x!=TRUE
                  plane_uses_y!=FALSE
                ENDIF
              ENDIF
              IF x_axis_flag!
                IF plane_uses_x!
                  point_distance=ROUND(end_point(1)*1000)/1000
                  format_coordinate_text(point_distance,corner_text_h$)
                ENDIF
                IF write_coordinates!
                  MID$(program_line$,PRED(input_column&),1)=("X")
                  MID$(program_line$,input_column&,9)=(corner_text_h$)
                ENDIF
                x_axis_flag!=FALSE
              ENDIF
              IF y_axis_flag!
                IF plane_uses_y!
                  work_point_y=ROUND(end_point(2)*1000)/1000
                  format_coordinate_text(work_point_y,corner_text_v$)
                ENDIF
                IF write_coordinates!
                  MID$(program_line$,PRED(input_row&),1)=("Y")
                  MID$(program_line$,input_row&,9)=(corner_text_v$)
                ENDIF
                y_axis_flag!=FALSE
              ENDIF
              IF z_axis_flag!
                IF plane_uses_z!
                  cut_depth=ROUND(end_point(3)*1000)/1000
                  format_coordinate_text(cut_depth,z_value_text$)
                ENDIF
                IF write_coordinates!
                  MID$(program_line$,PRED(z_value_column&),1)=("Z")
                  MID$(program_line$,z_value_column&,9)=(z_value_text$)
                ENDIF
                z_axis_flag!=FALSE
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' until every axis is found or the program start
  UNTIL run_aborted! OR ((NOT x_axis_flag!) AND (NOT y_axis_flag!) AND (NOT z_axis_flag!)) OR line_index&=0
  ' the program start: position 0
  IF line_index&=0
    point_distance=0
    work_point_y=0
    cut_depth=0
  ENDIF
RETURN
' Formats a coordinate as the 9-character program text: sign, three integer places padded with spaces and three
' decimals, for example "+ 12.500". An overflowing value gives 0. Parameters: second_operand = value. Returns:
' result_text$ = text.
PROCEDURE format_coordinate_text(second_operand,VAR result_text$)
  LOCAL loop_index|,scan_column|,edit_work_text$,field_text_length|,is_finished!,discriminant
  loop_index|=FALSE
  IF .0001>ABS(second_operand)
    second_operand=0
  ENDIF
  result_text$=STR$(second_operand)
  field_text_length|=LEN(result_text$)
  REPEAT
    INC loop_index|
  UNTIL (MID$(result_text$,loop_index|,1)=".") OR loop_index|=field_text_length|
  ' no decimal point: add .000
  IF loop_index|=field_text_length|
    edit_work_text$=MKL$(774910000)
  ELSE
    ' zeros to make three decimals
    edit_work_text$=STRING$(loop_index|+(3-field_text_length|),48)
  ENDIF
  is_finished!=FALSE
  IF second_operand=0
    result_text$="   0.000"
  ELSE
    discriminant=ABS(second_operand)
    IF discriminant>1
      scan_column|=4
      REPEAT
        DEC scan_column|
        ' pad to three integer places
        IF discriminant>=10^scan_column|
          result_text$=SPACE$(3-scan_column|)+STR$(discriminant)+edit_work_text$
          is_finished!=TRUE
        ENDIF
      UNTIL scan_column|=0 OR is_finished!
    ELSE
      result_text$="   "+STR$(discriminant)+edit_work_text$
    ENDIF
  ENDIF
  ' the sign goes first
  IF second_operand>=0
    result_text$="+"+result_text$
  ELSE
    result_text$="-"+result_text$
  ENDIF
RETURN
' For the block reversal: puts the radius correction (column 44, RL and RR swapped) and the feed (column 48)
' into reversed line program_line$, taken from the nearest earlier line of the block that has them. Parameters:
' line_index& = line; program_line$ = line text; radius_correction_text$ = correction; correction_source_line& /
' feed_source_line& = lines the correction and feed were last taken from; third_block_text$ = feed text.
PROCEDURE carry_correction_and_feed(line_index&,VAR program_line$,radius_correction_text$,correction_source_line&,third_block_text$,feed_source_line&)
  LOCAL scan_index&
  ' the correction must be fetched again
  IF correction_source_line&>=line_index&
    scan_index&=line_index&
    radius_correction_text$=CHR$(32)
    REPEAT
      DEC scan_index&
      IF LEN(program_lines$(scan_index&))>50
        radius_correction_text$=MID$(program_lines$(scan_index&),44,1)
      ENDIF
    UNTIL (radius_correction_text$<>" ") OR scan_index&<block_start_line&
    IF scan_index&<block_start_line&
      radius_correction_text$=CHR$(32)
    ELSE
      ' RL and RR swap in the reversed block
      IF radius_correction_text$="L"
        radius_correction_text$=CHR$(82)
      ELSE
        IF radius_correction_text$="R"
          radius_correction_text$=CHR$(76)
        ENDIF
      ENDIF
    ENDIF
    correction_source_line&=scan_index&
    MID$(program_line$,44,1)=(radius_correction_text$)
  ELSE
    MID$(program_line$,44,1)=(" ")
  ENDIF
  ' the feed must be fetched again
  IF feed_source_line&>line_index&
    scan_index&=line_index&+1
    ' four spaces: no feed
    third_block_text$=MKL$(538976288)
    REPEAT
      DEC scan_index&
      IF LEN(program_lines$(scan_index&))>50
        third_block_text$=MID$(program_lines$(scan_index&),48,4)
      ENDIF
    UNTIL (third_block_text$<>"    ") OR scan_index&<block_start_line&
    IF scan_index&<block_start_line&
      third_block_text$=MKL$(538976288)
    ENDIF
    feed_source_line&=scan_index&
    MID$(program_line$,48,4)=(third_block_text$)
  ELSE
    IF line_index&=block_end_line&
      MID$(program_line$,48,4)=(third_block_text$)
    ELSE
      MID$(program_line$,48,4)=("    ")
    ENDIF
  ENDIF
RETURN
' Shows "ES IST KEIN BLOCK VORHANDEN!" (no block marked) in the message box with a bell, for 0.8 seconds.
PROCEDURE show_no_block_message
  GRAPHMODE 1
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  GRAPHMODE 3
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  PRINT CHR$(7);
  show_message_text("ES IST KEIN BLOCK VORHANDEN!")
  PAUSE 40
  GRAPHMODE 1
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
RETURN
' Keypad O: marks the cursor line as the start of the block and redraws the block highlight.
PROCEDURE mark_block_start
  ' refused while a field is edited
  IF field_edit_active!
    show_key_without_function
  ELSE
    IF cursor_line&=0
      cursor_line&=1
    ENDIF
    block_start_line&=cursor_line&
    ' the block has an end after the start
    IF block_end_line&>block_start_line&
      block_marked!=TRUE
      IF block_highlight_shown!
        GRAPHMODE 2
        DEFFILL 0,2,1
        PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
        GRAPHMODE 1
        DEFFILL 0,1,1
      ENDIF
      IF field_edit_active!
        draw_block_highlight
      ENDIF
    ELSE
      block_marked!=FALSE
      IF block_highlight_shown!
        GRAPHMODE 2
        DEFFILL 0,2,1
        PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
        GRAPHMODE 1
        DEFFILL 0,1,1
      ENDIF
      block_highlight_shown!=FALSE
    ENDIF
    drawn_cursor_line&=-2
    list_redraw_needed!=TRUE
  ENDIF
RETURN
' Keypad U: marks the cursor line as the end of the block and redraws the block highlight.
PROCEDURE mark_block_end
  IF field_edit_active!
    show_key_without_function
  ELSE
    block_end_line&=cursor_line&
    ' the block has a start before the end
    IF block_end_line&>=block_start_line& AND block_start_line&>0
      block_marked!=TRUE
      IF block_highlight_shown!
        GRAPHMODE 2
        DEFFILL 0,2,1
        PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
        GRAPHMODE 1
        DEFFILL 0,1,1
      ENDIF
      IF field_edit_active!
        draw_block_highlight
      ENDIF
    ELSE
      block_marked!=FALSE
      IF block_highlight_shown!
        GRAPHMODE 2
        DEFFILL 0,2,1
        PBOX block_box_x1&,block_box_y1&,block_box_x2&,block_box_y2&
        GRAPHMODE 1
        DEFFILL 0,1,1
      ENDIF
      block_highlight_shown!=FALSE
    ENDIF
    drawn_cursor_line&=-2
    list_redraw_needed!=TRUE
  ENDIF
RETURN
' Draws the highlight of the marked block over the visible part of the listing, in replace mode with pattern
' fill, and keeps its rectangle in block_box_x1&/block_box_y1&/block_box_x2&/block_box_y2&;
' block_highlight_shown! says whether any of it is on screen.
PROCEDURE draw_block_highlight
  LOCAL scan_index&,item_count&,search_line&,listing_bottom_y&,box_top_y&,box_bottom_y&
  ' line after the last visible one
  scan_index&=top_line&+visible_lines&
  listing_bottom_y&=first_line_y&
  listing_bottom_y&=listing_bottom_y&+(line_text_height| DIV 2)
  listing_bottom_y&=listing_bottom_y&+PRED(visible_lines&)*listing_row_height&
  DEFFILL 1,2,1
  GRAPHMODE 2
  ' the block starts on the page
  IF block_start_line&>=top_line& AND block_start_line&<scan_index&
    item_count&=block_start_line&-top_line&
    box_top_y&=first_line_y&-list_line_step&+item_count&*listing_row_height&
    IF block_end_line&>=scan_index&
      PBOX block_box_x1&,box_top_y&,block_box_x2&,listing_bottom_y&
      block_box_y1&=box_top_y&
      block_box_y2&=listing_bottom_y&
    ELSE
      search_line&=block_end_line&-top_line&
      box_bottom_y&=first_line_y&
      box_bottom_y&=box_bottom_y&+(line_text_height| DIV 2)
      box_bottom_y&=box_bottom_y&+search_line&*listing_row_height&
      PBOX block_box_x1&,box_top_y&,block_box_x2&,box_bottom_y&
      block_box_y1&=box_top_y&
      block_box_y2&=box_bottom_y&
    ENDIF
    block_highlight_shown!=TRUE
  ELSE
    ' the block ends on the page
    IF block_end_line&>=top_line& AND block_end_line&<scan_index&
      search_line&=block_end_line&-top_line&
      box_top_y&=first_line_y&-list_line_step&
      box_bottom_y&=first_line_y&
      box_bottom_y&=box_bottom_y&+(line_text_height| DIV 2)
      box_bottom_y&=box_bottom_y&+search_line&*listing_row_height&
      PBOX block_box_x1&,box_top_y&,block_box_x2&,box_bottom_y&
      block_box_y1&=box_top_y&
      block_box_y2&=box_bottom_y&
      block_highlight_shown!=TRUE
    ELSE
      ' the block covers the whole page
      IF block_start_line&<top_line& AND block_end_line&>=scan_index&
        box_top_y&=first_line_y&-list_line_step&
        PBOX block_box_x1&,box_top_y&,block_box_x2&,listing_bottom_y&
        block_box_y1&=box_top_y&
        block_box_y2&=listing_bottom_y&
        block_highlight_shown!=TRUE
      ELSE
        block_highlight_shown!=FALSE
      ENDIF
    ENDIF
  ENDIF
  DEFFILL 0,1,1
  GRAPHMODE 1
RETURN
