' CNC Profi 1.03 - GFA BASIC 3.50 source of CNCPROFI.PRG
' Decompiled by Darren Birks, 3 November 2026
'
' REBUILDING IT ON AN ATARI ST
' Compiled with the GFA BASIC 3.50 D compiler and the library in LIBRARY\,
' this file gives CNCPROFI.PRG byte for byte (631018 bytes).  Compile the
' .GFA file, not CNCPROFI.LST: the compiled code depends on the order of the
' variables, which the .GFA file keeps and Merge of the .LST does not.
'  1. Copy MENU.PRG, GFA_BCOM.PRG and GL.PRG from the 3.50 compiler folder
'     to a new folder, with GFA3BLIB and GFA3BLIB.NDX from LIBRARY\ (not
'     the library from the 3.50 disk), and this file.
'  2. Run MENU.PRG and leave every option off: the Com: and Lnk: lines stay
'     empty.  The options the program needs ($m800000, $E$) are in the source.
'  3. Press P and change TEST.PRG to CNCPROFI.PRG, then F1 and choose
'     CNCPROFI.GFA.
'  4. F10 compiles and links.  Compare the new CNCPROFI.PRG with the released
'     one byte for byte (on a PC: fc /b); they are the same.
' The INLINE blocks are in the .GFA file.  The .bin files beside it hold the
' same bytes, to load into the INLINE lines (Help on the line) after a Merge.
'
' WHY THE LIBRARY IN LIBRARY\
' CNC Profi was linked with neither the GFA3BLIB of the 3.50 disk nor the
' 3.51 one.  Those two differ in two ways:
'  * 3.51 changes the code of 17 modules: FDIV, DEUTSCH, CLOSE, OPEN,
'    WINDCLIP, WINDOWS, INSERTS, INPUT, SELSTR, EXEC, SCRP_WRI, MOUSE, ASTOS,
'    MAT1MUL, SETDATA, MATDET and SHEL_ENV;
'  * 3.51 moves the SADDRIN routine (the code unchanged) out of saddrin.O,
'    in the middle of the library, into a new SADDRIN.O at its end, after a
'    new RADDRIN.O.
' The linker copies the modules a program uses in library order, so the two
' changes show in the program: CNC Profi has the 3.50 code of every one of
' the 17 modules, but SADDRIN after the other library routines.  It was
' linked with a library in between the released ones, with the second
' change and not the first.  LIBRARY\ holds that library, rebuilt from the
' two: the 3.51 library with the 17 modules put back to their 3.50 code.
' With the 3.50 disk's library SADDRIN lands 18 bytes further up and the
' file differs from there on; with the 3.51 one the 17 modules differ.  The
' program works the same either way.
'
' COMPILING WITH GFA BASIC 3.6 AND LATER
' LIBRARY\ is only for the byte-for-byte check above.  To go on working on
' the program, load CNCPROFI.GFA into the later editor and compile it with
' that version's own compiler and library as usual.  The program is then no
' longer byte for byte the released one, which is expected.
'
$m800000
$E$
version_text$=MKL$(825110579)
init_application
load_resource_module
load_dialog_module
set_resource_indexes
load_resource
build_menu_and_window
DEFMOUSE 3
starting_up!=TRUE
load_settings_files
calculate_text_layout
init_program_variables
load_help_text
SHOWM
REPEAT
UNTIL NOT (INKEY$<>"")
ON MENU MESSAGE GOSUB handle_window_message
ON MENU GOSUB handle_menu_choice
ON BREAK CONT
ON ERROR GOSUB handle_program_error
DEFFILL 0,1,1
DEFMOUSE 3
REPEAT
UNTIL NOT (INKEY$<>"")
DO
  ON MENU
LOOP
IF work_memory_block%>0
  ~GEMDOS(73,L:work_memory_block%)
ENDIF
shutdown_program
END
$P>
' Starts GEM and checks the screen: application_id&=APPL_INIT(), screen_width&/screen_height& screen width and
' height, screen_max_x&/screen_max_y& the largest x and y. A screen smaller than 640x400 gives an alert and the
' program ends. get_program_folder(program_folder$) gets the program folder; format_dialog_handle% is set to the
' INLINE block dat_9814a.
PROCEDURE init_application
  application_id&=APPL_INIT()
  char_cell_width_init&=8
  char_cell_height_init&=16
  screen_width&=WORK_OUT(0)+1
  screen_height&=WORK_OUT(1)+1
  screen_max_x&=screen_width&-1
  screen_max_y&=screen_height&-1
  ' the screen must be at least 640x400 pixels
  IF screen_width&<640 OR screen_height&<400
    ALERT 3,"|Das Programm benîtigt eine| Auflîsung von mindestens|     640x400 Pixeln !",1,"  ENDE  ",rsc_result|
    END
  ENDIF
  get_program_folder(program_folder$)
  INLINE format_dialog_handle%,36
RETURN
' Loads CNCPROFI.RSC from the program folder, or lets the user find it with the file selector when it is
' missing; an RSC that cannot be loaded ends the program. Fetches the addresses of the trees (icons
' icon_tree%, about about_tree%, parameter output fn15_dialog_tree%, overwrite overwrite_tree%, print program
' print_program_dialog%, block functions block_functions_tree%, print tool memory print_tools_tree%, format
' format_dialog_tree%, cutter icon cutter_icon_tree%, print block print_block_dialog%, baud rate pop-up
' baud_popup_tree%, parameter function pop-up function_popup_tree%, cycle pop-up cycle_popup_tree%), prepares
' the dialogs with dial_fix_tree, clears the parameter output fields and the print comments, and writes "
' CNCPROFI.PRG   Version 1.03 " (version_text$, set at the start of the program) into the about dialog.
PROCEDURE load_resource
  LOCAL rsc_result|
  ' memory kept free for GEM and the runtime
  ' (reserved_memory% is only ever added to, in allocate_graphic_buffers; nothing reads it, so no memory is
  ' actually kept back)
  reserved_memory%=42000
  IF resource_module_loaded!
    DIM overlay_word_table&(15)
  ENDIF
  rsc_module_start
  IF EXIST(program_folder$+"\CNCPROFI.RSC")<>0
    rsc_result|=@rsc_load_file(program_folder$+"\CNCPROFI.RSC")
    IF rsc_result|=0
      ALERT 3,"Fehler beim Laden der|RESOURCE-Datei !",1,"ABBRUCH",rsc_result|
      shutdown_program
      END
    ENDIF
  ELSE
    ALERT 3,"Die RESOURCE-Datei konnte|nicht gefunden werden!|Suchen Sie bitte diese mit|der Fileselectorbox!",1," Weiter ",rsc_result|
    selected_file$=@select_file$("Resource-Datei laden",program_folder$+"\*.RSC","CNCPROFI.RSC")
    DEFMOUSE 3
    IF RIGHT$(selected_file$,12)="CNCPROFI.RSC"
      rsc_result|=@rsc_load_file(selected_file$)
    ELSE
      rsc_result|=FALSE
    ENDIF
    IF rsc_result|=0
      ALERT 3,"Fehler beim Laden der|RESOURCE-Datei !",1,"ABBRUCH",rsc_result|
      shutdown_program
      END
    ENDIF
  ENDIF
  ' tree 0: the icons
  ~@rsc_get_address(0,tree_icons&,icon_tree%)
  ~@rsc_get_address(0,tree_about&,about_tree%)
  ~@rsc_get_address(0,tree_parameter_output&,fn15_dialog_tree%)
  ~@rsc_get_address(0,tree_overwrite&,overwrite_tree%)
  ~@rsc_get_address(0,tree_print_program&,print_program_dialog%)
  ~@rsc_get_address(0,tree_block_functions&,block_functions_tree%)
  ~@rsc_get_address(0,tree_print_tools&,print_tools_tree%)
  ~@rsc_get_address(0,tree_format_disk&,format_dialog_tree%)
  ~@rsc_get_address(0,tree_baud_popup&,baud_popup_tree%)
  ~@rsc_get_address(0,tree_cutter_icon&,cutter_icon_tree%)
  ~@rsc_get_address(0,tree_print_block&,print_block_dialog%)
  ~@rsc_get_address(0,tree_function_popup&,function_popup_tree%)
  ~@rsc_get_address(0,tree_cycle_popup&,cycle_popup_tree%)
  ~@dial_fix_tree(about_tree%,-1)
  ~@dial_fix_tree(fn15_dialog_tree%,-1)
  ~@dial_fix_tree(overwrite_tree%,-1)
  ~@dial_fix_tree(print_program_dialog%,-1)
  ~@dial_fix_tree(block_functions_tree%,-1)
  ~@dial_fix_tree(print_tools_tree%,-1)
  ~@dial_fix_tree(format_dialog_tree%,-1)
  ~@dial_fix_tree(cutter_icon_tree%,-1)
  ~@dial_fix_tree(print_block_dialog%,-1)
  ~@dial_fix_tree(function_popup_tree%,-1)
  ~@dial_fix_tree(cycle_popup_tree%,-1)
  ~@dial_center_tree(format_dialog_tree%)
  ' clears the six fields of the parameter output dialog
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_first_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_second_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_third_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fourth_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fifth_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_sixth_field&)}}=""
  ' program_print_comment$, tool_print_comment$, block_print_comment$: the comments of the print dialogs
  program_print_comment$=""
  tool_print_comment$=""
  block_print_comment$=""
  IF LEN(version_text$)=3
    CHAR{LONG{OB_SPEC(about_tree%,about_version_field&)}}=" CNCPROFI.PRG    Version "+version_text$+" "
  ELSE
    CHAR{LONG{OB_SPEC(about_tree%,about_version_field&)}}=" CNCPROFI.PRG   Version "+version_text$+" "
  ENDIF
RETURN
' Ends the program: switches the error handler off, closes the windows and the menu, frees the resource
' (rsc_free_file; END if that fails), releases the overlays (rsc_module_stop, dial_module_stop, dial_exit) and
' the overlay memory blocks modul_one_block% and modul_two_block%, then END.
PROCEDURE shutdown_program
  ON ERROR
  CLOSEW 1
  CLOSEW 2
  CLOSEW 0
  MENU KILL
  IF @rsc_free_file=0
    END
  ENDIF
  rsc_module_stop
  IF dialog_module_loaded!
    ~@dial_module_stop
    ~@dial_exit
  ENDIF
  ~GEMDOS(73,L:modul_one_block%)
  ~GEMDOS(73,L:modul_two_block%)
  END
RETURN
