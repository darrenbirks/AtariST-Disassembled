                                                                                  ' ? =") / ELSE
                                                                                  show_prompt_text("LABEL-NUMMER: ? =")
                                                                                ELSE
                                                                                  IF field_index|=1 AND ((line_head_thirteen$="CYCL DEF 6.1 ") OR (line_head_thirteen$="CYCL DEF 16.1") OR (line_head_thirteen$="CYCL DEF 15.1"))
                                                                                    ' ? =") / ELSE
                                                                                    show_prompt_text("TIEFE: ? =")
                                                                                  ELSE
                                                                                    IF field_index|=1 AND ((line_head_thirteen$="CYCL DEF 15.2") OR (line_head_thirteen$="CYCL DEF 6.2 ") OR (line_head_thirteen$="CYCL DEF 3.3 ") OR (line_head_thirteen$="CYCL DEF 4.3 ") OR (line_head_thirteen$="CYCL DEF 5.3 ") OR (line_head_thirteen$="CYCL DEF 6.3 ") OR (line_head_thirteen$="CYCL DEF 16.2"))
                                                                                      ' ? =") / ELSE
                                                                                      show_prompt_text("VORSCHUB: ? =")
                                                                                    ELSE
                                                                                      IF field_index|=1 AND ((line_head_thirteen$="CYCL DEF 4.6 ") OR (line_head_thirteen$="CYCL DEF 5.5 "))
                                                                                        ' IM UHRZEIGERSINN - ? =") / ELSE
                                                                                        show_prompt_text("DREHRICHTUNG: IM UHRZEIGERSINN - ? =")
                                                                                      ELSE
                                                                                        IF field_index|=1 OR field_index|=2 AND (line_head_thirteen$="CYCL DEF 8.1 ")
                                                                                          ' ? =") / ELSE
                                                                                          show_prompt_text("SPIEGEL-ACHSE: ? =")
                                                                                        ELSE
                                                                                          IF field_index|=2 AND ((line_head_thirteen$="CYCL DEF 15.2") OR (line_head_thirteen$="CYCL DEF 6.2 ") OR (line_head_thirteen$="CYCL DEF 3.3 ") OR (line_head_thirteen$="CYCL DEF 4.3 ") OR (line_head_thirteen$="CYCL DEF 5.3 "))
                                                                                            ' ? =") / ELSE
                                                                                            show_prompt_text("AUFMASS: ? =")
                                                                                          ELSE
                                                                                            IF field_index|=2 AND (line_head_thirteen$="CYCL DEF 16.2")
                                                                                              ' IM UHRZEIGERSINN - ? =") / ELSE
                                                                                              show_prompt_text("DREHRICHTUNG: IM UHRZEIGERSINN - ? =")
                                                                                            ELSE
                                                                                              IF field_index|=3 AND (line_head_thirteen$="CYCL DEF 16.2")
                                                                                                ' ? =") / ENDIF
                                                                                                show_prompt_text("VORSCHUB: ? =")
                                                                                              ENDIF
                                                                                            ENDIF
                                                                                          ENDIF
                                                                                        ENDIF
                                                                                      ENDIF
                                                                                    ENDIF
                                                                                  ENDIF
                                                                                ENDIF
                                                                              ENDIF
                                                                            ENDIF
                                                                          ENDIF
                                                                        ENDIF
                                                                      ENDIF
                                                                    ENDIF
                                                                  ENDIF
                                                                ENDIF
                                                              ENDIF
                                                            ENDIF
                                                          ENDIF
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ENDIF
                                                ENDIF
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                        ENDIF
                                      ENDIF
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' no field: clear the prompt box
  IF field_index|>=255
    DEFFILL 0
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    DEFFILL 0,1,1
  ENDIF
  DEFTEXT 1,0,0,text_height|
RETURN
' Shows the prompt text program_line$ inverted in the prompt box (message_box_x1&..message_box_y2&): drawn on
' the off-screen buffer (physical offscreen_buffer%) and copied to the window with blit_window_area, then the
' screen is switched back.
PROCEDURE show_prompt_text(program_line$)
  ' draw on the off-screen buffer
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  DEFFILL 1
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  GRAPHMODE 3
  ' XOR text on the filled box: inverted
  TEXT line_text_x&,message_line_y&,program_line$
  DEFFILL 0,1,1
  GRAPHMODE 1
  ' copy the box to the window
  blit_window_area(W_HAND(#1),message_box_x1&+work_x&,message_box_y1&+work_y&,message_box_x2&-message_box_x1&,message_box_y2&-message_box_y1&)
  ' back to the normal screen
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
RETURN
' Shows the message work_text$ in the prompt box in small text (clear box, then the text in XOR), drawn the same
' way as show_prompt_text.
PROCEDURE show_message_text(work_text$)
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  DEFTEXT 1,0,0,6
  DEFFILL 0,1,1
  GRAPHMODE 1
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  GRAPHMODE 3
  PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
  TEXT line_text_x&,message_line_y&,work_text$
  GRAPHMODE 1
  DEFTEXT ,,,text_height|
  blit_window_area(W_HAND(#1),message_box_x1&+work_x&,message_box_y1&+work_y&,message_box_x2&-message_box_x1&,message_box_y2&-message_box_y1&)
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
RETURN
' Shows the hint program_line$ on the prompt line directly on screen: clears 54 characters and writes the text
' in XOR.
PROCEDURE show_hint_text(program_line$)
  DEFTEXT 1,0,0,6
  GRAPHMODE 4
  TEXT line_text_x&,message_line_y&,SPACE$(54)
  GRAPHMODE 3
  TEXT line_text_x&,message_line_y&,program_line$
  GRAPHMODE 1
  DEFTEXT ,,,text_height|
RETURN
' Menu: start the graphic simulation. With the zoom ("Lupe") active it first checks that the program's BLK FORM
' still has the same spindle axis; the saved blank picture is copied back from the buffers, the frame and its
' corner coordinates are drawn and the simulation runs (run_graphic_simulation). Without the zoom the view is
' set up again with setup_simulation_view. Afterwards it waits for a key (unless stopped by an error) and puts
' back the menu and key handlers of program run mode.
PROCEDURE start_graphic_simulation
  LOCAL line_index&,work_text$,file_byte|,restore_flag!,alert_button|,screen_x&,screen_y&,corner_text_h$,corner_text_v$,legend_even_bands!
  ON MENU
  GRAPHMODE 1
  IF program_lines$(0)=""
    ALERT 3,"Es befindet sich noch|kein Programm im speicher!",1,"Abbruch",alert_button|
  ELSE
    ' restore_flag!: the blank form is unchanged
    restore_flag!=TRUE
    ' zoom active: the view must match the program
    IF zoom_active!
      line_index&=0
      REPEAT
        INC line_index&
        ' find BLK FORM 0.1
      UNTIL (RIGHT$(program_lines$(line_index&))<>"}") AND (LEFT$(program_lines$(line_index&),13)="BLK FORM  0.1")
      ' its spindle axis letter
      work_text$=MID$(program_lines$(line_index&),15,1)
      IF work_text$="X"
        file_byte|=1
      ELSE
        IF work_text$="Y"
          file_byte|=2
        ELSE
          file_byte|=3
        ENDIF
      ENDIF
      ' another spindle axis than the view
      IF file_byte|<>tool_axis|
        restore_flag!=FALSE
        show_message_text("ALTE BLOCK-FORM IST VON AKTUELLER VERSCHIEDEN !")
      ELSE
        DEFTEXT 1,0,0,13
        CLS
        DEFFILL 1,1,1
        HIDEM
        ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
        CLIP 0,0,graphic_width&,graphic_height& OFFSET 0,0
        DEFFILL ,0,0
        PBOX 0,0,graphic_width&,graphic_height&
        DEFFILL ,1,1
        blit_params%(0)=0
        blit_params%(1)=0
        blit_params%(2)=graphic_width&
        blit_params%(3)=graphic_height&
        blit_params%(4)=0
        blit_params%(5)=0
        blit_params%(6)=graphic_width&
        blit_params%(7)=graphic_height&
        blit_params%(8)=3
        ' line mode: only one picture
        IF wireframe_view!
          layer_mfdb%(0)=layer_bitmaps%(1)
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
        ELSE
          ' one picture for each depth level
          FOR loop_index|=FALSE TO depth_levels|
            layer_mfdb%(0)=layer_bitmaps%(loop_index|)
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          NEXT loop_index|
          ' and the depth legend
          layer_mfdb%(0)=graphic_buffer%
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          ARRAYFILL layer_used!(),0
        ENDIF
        ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
        CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
        ARRAYFILL layer_used!(),0
        BOUNDARY 1
        DEFFILL 1,1,1
        PBOX frame_left&+1,frame_top&+1,frame_right&+2,frame_bottom&+2
        PBOX frame_left&+3,frame_top&+3,frame_right&+4,frame_bottom&+4
        DEFFILL ,0,0
        PBOX frame_left&-1,frame_top&-1,frame_right&+1,frame_bottom&+1
        BOUNDARY 0
        DEFFILL ,1,1
        DEFTEXT 1,0,0,6
        corner_text_h$=STR$(ROUND(1000*view_max_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_max_v)/1000)
        ' room above the frame: write the top right corner there
        IF frame_top&>legend_height&+10
          ' legend_even_bands!: here it means the text went above the frame
          legend_even_bands!=TRUE
          screen_x&=-24+(frame_right&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)
          screen_y&=frame_top&-4
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          legend_even_bands!=FALSE
          ' no room right of the frame: write it on two lines
          IF frame_right&+VAL?(corner_text_h$)*8+VAL?(corner_text_v$)*8+32>work_right&
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","
            TEXT frame_right&+16,frame_top&+16,corner_text_v$+")"
          ELSE
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","+corner_text_v$+")"
          ENDIF
        ENDIF
        ' bottom left corner: min first axis, min second axis
        corner_text_h$=STR$(ROUND(1000*view_min_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_min_v)/1000)
        IF legend_even_bands!
          TEXT frame_left&,frame_bottom&+12,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          screen_x&=MAX(1,PRED(frame_left&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)-31)
          screen_y&=12+frame_bottom&
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ENDIF
        DEFTEXT 1,0,0,13
      ENDIF
    ELSE
      ' no zoom: menu items 35/36 off and set the view up again
      MENU 35,0
      MENU 36,0
      DEFTEXT 1,0,0,13
      CLS
      DEFFILL 1,1,1
      HIDEM
      setup_simulation_view(0)
    ENDIF
    IF restore_flag!
      IF NOT run_aborted!
        ' run the simulation
        run_graphic_simulation
        PRINT CHR$(7);
        PAUSE 2
        PRINT CHR$(7);
        DEFMOUSE 3
        SHOWM
        waiting_for_key!=TRUE
        IF NOT run_aborted!
          stop_requested!=FALSE
          ON MENU KEY GOSUB request_stop
          REPEAT
            ON MENU
          UNTIL stop_requested!=TRUE
          stop_requested!=FALSE
        ENDIF
        ' back to the program run handlers
        ON MENU GOSUB handle_menu_choice
        ON MENU KEY GOSUB key_run_mode
        ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB click_run_mode
        waiting_for_key!=FALSE
        simulation_running!=FALSE
        graphic_view_active!=FALSE
      ENDIF
    ENDIF
    rebuild_window_contents
    flush_key_events
  ENDIF
handle_redraw_request:
  ' a redraw was requested by the window handler
  IF redraw_requested!
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    CLS
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    drawn_top_line&=-2
    drawn_cursor_line&=-2
    list_redraw_needed!=TRUE
    run_aborted!=TRUE
    redraw_requested!=FALSE
    rebuild_window_contents
    enter_run_mode
    flush_key_events
  ENDIF
RETURN
' Redraws the simulation view from the saved picture: finds BLK FORM 0.1/0.2 in the program, reads the blank min
' and max points and compares them with the stored ones (blank_min_point()/blank_max_point()) and the spindle
' axis. If they match, the frame, corner coordinates and the depth levels are copied back from the buffers and,
' unless input_in_dialog! is set, the simulation runs and a key is awaited; otherwise "ALTE BLOCK-FORM IST VON
' AKTUELLER VERSCHIEDEN" (old blank differs from the current one) is shown or put in the error text.
PROCEDURE redraw_simulation_view(input_in_dialog!)
  LOCAL line_index&,blank_min_line&,blank_max_line&,loop_index|,search_found!,work_text$,file_byte|,alert_button|,corner_text_h$,corner_text_v$,screen_x&,screen_y&,restore_flag!
  ON MENU
  IF program_lines$(0)=""
    ALERT 3,"Es befindet sich noch|kein Programm im speicher!",1,"Abbruch",alert_button|
  ELSE
    DEFTEXT 1,0,0,13
    blank_min_line&=0
    blank_max_line&=0
    line_index&=1
    REPEAT
      IF RIGHT$(program_lines$(line_index&),1)<>"}"
        ' min point of the blank
        IF LEFT$(program_lines$(line_index&),13)="BLK FORM  0.1"
          blank_min_line&=line_index&
          work_text$=MID$(program_lines$(line_index&),15,1)
        ENDIF
        ' max point of the blank
        IF LEFT$(program_lines$(line_index&),13)="BLK FORM  0.2"
          blank_max_line&=line_index&
        ENDIF
      ENDIF
      INC line_index&
    UNTIL blank_min_line&<>0 AND blank_max_line&<>0 OR line_index&>last_line&
    IF line_index&>last_line&
      ' not quiet: message in the prompt box
      IF NOT input_in_dialog!
        show_message_text("DIE BLOCK-FORM WURDE NICHT DEFINIERT !")
        run_aborted!=TRUE
      ELSE
        ALERT 3,"Die BLOCK-FORM wurde|nicht definiert!",1," RETURN",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=0
        error_messages$(0)="BLOCK-FORM WURDE NICHT DEFINIERT!"
      ENDIF
    ELSE
      FOR loop_index|=1 TO 3
        ' X, Y and Z of the min point (the sign is the character before)
        program_blank_min(loop_index|)=VAL(MID$(program_lines$(blank_min_line&),21+PRED(loop_index|)*12,8))
        program_blank_max(loop_index|)=VAL(MID$(program_lines$(blank_max_line&),21+PRED(loop_index|)*12,8))
        IF MID$(program_lines$(blank_min_line&),20+PRED(loop_index|)*12,1)="-"
          program_blank_min(loop_index|)=-program_blank_min(loop_index|)
        ENDIF
        IF MID$(program_lines$(blank_max_line&),20+PRED(loop_index|)*12,1)="-"
          program_blank_max(loop_index|)=-program_blank_max(loop_index|)
        ENDIF
      NEXT loop_index|
      IF work_text$="X"
        file_byte|=1
      ELSE
        IF work_text$="Y"
          file_byte|=2
        ELSE
          file_byte|=3
        ENDIF
      ENDIF
      ' same spindle axis as the view
      IF file_byte|=tool_axis|
        search_found!=TRUE
        FOR loop_index|=1 TO 3
          IF blank_max_point(loop_index|)<>program_blank_max(loop_index|) OR blank_min_point(loop_index|)<>program_blank_min(loop_index|)
            search_found!=FALSE
          ENDIF
        NEXT loop_index|
      ELSE
        search_found!=FALSE
      ENDIF
      IF search_found!
        ' the plane axes for circles start as the view plane
        first_plane_axis|=tool_first_axis|
        second_plane_axis|=tool_second_axis|
        infeed_axis|=depth_axis|
        pending_first_axis|=tool_first_axis|
        pending_second_axis|=tool_second_axis|
        pending_tool_axis|=depth_axis|
        ' source and target rectangles of the picture copy
        bitmap_left&=view_min_x&+layer_offset_x&
        bitmap_top&=view_min_y&+layer_offset_y&
        bitmap_right&=view_max_x&+layer_offset_x&
        bitmap_bottom&=view_max_y&+layer_offset_y&
        window_left&=view_min_x&+view_origin_x&
        window_top&=view_min_y&+view_offset_y&
        window_right&=view_max_x&+view_origin_x&
        window_bottom&=view_max_y&+view_offset_y&
        GRAPHMODE 1
        CLS
        HIDEM
        BOUNDARY 1
        DEFFILL 1,1,1
        PBOX frame_left&+1,frame_top&+1,frame_right&+2,frame_bottom&+2
        PBOX frame_left&+3,frame_top&+3,frame_right&+4,frame_bottom&+4
        DEFFILL ,0,0
        PBOX frame_left&-1,frame_top&-1,frame_right&+1,frame_bottom&+1
        BOUNDARY 0
        DEFFILL ,1,1
        DEFTEXT 1,0,0,6
        corner_text_h$=STR$(ROUND(1000*view_max_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_max_v)/1000)
        IF frame_top&>legend_height&+10
          restore_flag!=TRUE
          screen_x&=-24+(frame_right&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)
          screen_y&=frame_top&-4
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          restore_flag!=FALSE
          IF frame_right&+VAL?(corner_text_h$)*8+VAL?(corner_text_v$)*8+32>work_right&
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","
            TEXT frame_right&+16,frame_top&+16,corner_text_v$+")"
          ELSE
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","+corner_text_v$+")"
          ENDIF
        ENDIF
        corner_text_h$=STR$(ROUND(1000*view_min_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_min_v)/1000)
        IF restore_flag!
          TEXT frame_left&,frame_bottom&+12,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          screen_x&=MAX(1,PRED(frame_left&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)-31)
          screen_y&=12+frame_bottom&
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ENDIF
        DEFTEXT 1,0,0,13
        ' build the picture on the off-screen buffer
        ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
        CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
        DEFFILL ,0,0
        PBOX view_min_x&,view_min_y&,view_max_x&,view_max_y&
        layer_mfdb%(0)=layer_bitmaps%(0)
        blit_params%(0)=window_left&
        blit_params%(1)=window_top&
        blit_params%(2)=window_right&
        blit_params%(3)=window_bottom&
        blit_params%(4)=bitmap_left&
        blit_params%(5)=bitmap_top&
        blit_params%(6)=bitmap_right&
        blit_params%(7)=bitmap_bottom&
        blit_params%(8)=3
        BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
        DEFFILL ,1,1
        IF wireframe_view!
          layer_mfdb%(0)=layer_bitmaps%(1)
        ELSE
          ' depth levels from the deepest up: each picture copied through its fill pattern
          FOR loop_index|=depth_levels_used| DOWNTO 1
            IF layer_used!(loop_index|)
              IF loop_index|=1
                DEFFILL ,1,1
              ELSE
                DEFFILL ,2,depth_level_colours|(loop_index|)
              ENDIF
              PBOX view_min_x&,view_min_y&,view_max_x&,view_max_y&
              layer_mfdb%(0)=layer_bitmaps%(loop_index|)
              blit_params%(0)=bitmap_left&
              blit_params%(1)=bitmap_top&
              blit_params%(2)=bitmap_right&
              blit_params%(3)=bitmap_bottom&
              blit_params%(4)=window_left&
              blit_params%(5)=window_top&
              blit_params%(6)=window_right&
              blit_params%(7)=window_bottom&
              blit_params%(8)=1
              BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
              layer_mfdb%(0)=layer_bitmaps%(0)
              blit_params%(0)=window_left&
              blit_params%(1)=window_top&
              blit_params%(2)=window_right&
              blit_params%(3)=window_bottom&
              blit_params%(4)=bitmap_left&
              blit_params%(5)=bitmap_top&
              blit_params%(6)=bitmap_right&
              blit_params%(7)=bitmap_bottom&
              blit_params%(8)=7
              BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            ENDIF
          NEXT loop_index|
          layer_mfdb%(0)=layer_bitmaps%(0)
        ENDIF
        blit_params%(0)=bitmap_left&
        blit_params%(1)=bitmap_top&
        blit_params%(2)=bitmap_right&
        blit_params%(3)=bitmap_bottom&
        blit_params%(4)=window_left&
        blit_params%(5)=window_top&
        blit_params%(6)=window_right&
        blit_params%(7)=window_bottom&
        blit_params%(8)=3
        ' copy the result to the screen
        BITBLT layer_mfdb%(),screen_mfdb%(),blit_params%()
        ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
        CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
        ' not quiet: run the simulation and wait
        IF NOT input_in_dialog!
          ' run the simulation
          run_graphic_simulation
          PRINT CHR$(7);
          PAUSE 2
          PRINT CHR$(7);
          DEFMOUSE 3
          SHOWM
          waiting_for_key!=TRUE
          IF NOT run_aborted!
            stop_requested!=FALSE
            ON MENU KEY GOSUB request_stop
            REPEAT
              ON MENU
            UNTIL stop_requested!=TRUE
            stop_requested!=FALSE
          ENDIF
          ON MENU GOSUB handle_menu_choice
          ON MENU KEY GOSUB key_run_mode
          ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB click_run_mode
          waiting_for_key!=FALSE
          simulation_running!=FALSE
          graphic_view_active!=FALSE
          rebuild_window_contents
          flush_key_events
        ENDIF
      ELSE
        DEFTEXT 1,0,0,6
        IF NOT input_in_dialog!
          show_message_text("ALTE BLOCK-FORM IST VON AKTUELLER VERSCHIEDEN !")
        ELSE
          error_messages$(0)="ALTE BLOCK-FORM IST VON AKTUELLER VERSCHIEDEN !"
        ENDIF
        DEFTEXT 1,0,0,text_height|
      ENDIF
    ENDIF
  ENDIF
RETURN
' Sets up the simulation view from the program's BLK FORM 0.1/0.2 lines: reads the blank min/max points, the
' spindle axis and from it the plane axes tool_first_axis|/tool_second_axis| and depth axis depth_axis|, checks
' the blank (min below max), works out the scale view_scale so the blank fits the window, the frame and the
' pixel origin of the view. Unless input_in_dialog! is set the picture buffers are cleared. Draws the frame and
' its corner coordinates. Errors go to the error line error_blocks&(0) / error_messages$(0) with run_aborted!
' set.
PROCEDURE setup_simulation_view(input_in_dialog!)
  LOCAL line_index&,blank_min_line&,blank_max_line&,loop_index|,listing_row_line&,rect_width&,work_text$,scale_by_width,scale_by_height,legend_text_width&,alert_button|,screen_x&,screen_y&,corner_text_h$,corner_text_v$,restore_flag!,grid_offset_min_h,grid_offset_max_h,grid_offset_max_v,grid_offset_min_v
  IF program_lines$(0)=""
    ALERT 3,"Es befindet sich noch|kein Programm im speicher!",1,"Abbruch",alert_button|
  ELSE
    blank_min_line&=0
    blank_max_line&=0
    line_index&=1
    REPEAT
      IF RIGHT$(program_lines$(line_index&),1)<>"}"
        IF LEFT$(program_lines$(line_index&),13)="BLK FORM  0.1"
          blank_min_line&=line_index&
          work_text$=MID$(program_lines$(line_index&),15,1)
        ENDIF
        IF LEFT$(program_lines$(line_index&),13)="BLK FORM  0.2"
          blank_max_line&=line_index&
        ENDIF
      ENDIF
      INC line_index&
    UNTIL blank_min_line&<>0 AND blank_max_line&<>0 OR line_index&>last_line&
    IF line_index&>last_line&
      ALERT 3,"Die BLOCK-FORM wurde|nicht definiert!",1," RETURN",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=0
      error_messages$(0)="BLOCK-FORM WURDE NICHT DEFINIERT!"
    ELSE
      FOR loop_index|=1 TO 3
        blank_min_point(loop_index|)=VAL(MID$(program_lines$(blank_min_line&),21+PRED(loop_index|)*12,8))
        blank_max_point(loop_index|)=VAL(MID$(program_lines$(blank_max_line&),21+PRED(loop_index|)*12,8))
        IF MID$(program_lines$(blank_min_line&),20+PRED(loop_index|)*12,1)="-"
          blank_min_point(loop_index|)=-blank_min_point(loop_index|)
        ENDIF
        IF MID$(program_lines$(blank_max_line&),20+PRED(loop_index|)*12,1)="-"
          blank_max_point(loop_index|)=-blank_max_point(loop_index|)
        ENDIF
      NEXT loop_index|
      ' tool along X: plane Y-Z, depth X
      IF work_text$="X"
        tool_axis|=1
        tool_first_axis|=2
        tool_second_axis|=3
        depth_axis|=1
      ELSE
        ' tool along Y: plane Z-X, depth Y
        IF work_text$="Y"
          tool_axis|=2
          tool_first_axis|=3
          tool_second_axis|=1
          depth_axis|=2
        ELSE
          ' tool along Z: plane X-Y, depth Z
          tool_axis|=3
          tool_first_axis|=1
          tool_second_axis|=2
          depth_axis|=3
        ENDIF
      ENDIF
      first_plane_axis|=tool_first_axis|
      second_plane_axis|=tool_second_axis|
      infeed_axis|=depth_axis|
      pending_first_axis|=tool_first_axis|
      pending_second_axis|=tool_second_axis|
      pending_tool_axis|=depth_axis|
      IF blank_min_point(tool_first_axis|)>=blank_max_point(tool_first_axis|) OR blank_min_point(tool_second_axis|)>=blank_max_point(tool_second_axis|) OR blank_min_point(depth_axis|)>=blank_max_point(depth_axis|)
        ALERT 3,"Die BLOCK-FORM ist|unzulÑssig definiert!",1," RETURN",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=blank_min_line&
        error_messages$(0)="BLOCK-FORM IST UNZULéSSIG DEFINIERT!"
      ELSE
        ' the blank in the plane: min/max first axis, max/min second axis
        area_min_h=blank_min_point(tool_first_axis|)
        area_max_h=blank_max_point(tool_first_axis|)
        area_max_v=blank_max_point(tool_second_axis|)
        area_min_v=blank_min_point(tool_second_axis|)
        ' depth range
        blank_top=blank_max_point(depth_axis|)
        blank_bottom=blank_min_point(depth_axis|)
        ' blank width and height
        view_width=area_max_h-area_min_h
        view_height=area_max_v-area_min_v
        blank_depth=blank_top-blank_bottom
        loop_index|=FALSE
        ' digits before the point of the depth: widens the legend
        work_text$=STR$(blank_depth)
        REPEAT
          INC loop_index|
        UNTIL (MID$(work_text$,loop_index|,1)=".") OR loop_index|>LEN(work_text$)
        legend_text_width&=legend_width&
        IF loop_index|>2
          SUB loop_index|,2
          legend_text_width&=legend_text_width&+loop_index|*char_width|
        ENDIF
        text_length&=work_even_w&-legend_text_width&*2-4
        box_width&=graphic_height&-4
        ' scale: the smaller of width and height fits
        scale_by_width=text_length&/view_width
        scale_by_height=box_width&/view_height
        IF scale_by_width<scale_by_height
          view_scale=scale_by_width
        ELSE
          view_scale=scale_by_height
        ENDIF
        text_length&=CINT(view_width*view_scale)
        box_width&=CINT(view_height*view_scale)
        listing_row_line&=CINT(text_length&/2)
        rect_width&=CINT(box_width&/2)
        view_left&=work_centre_x&-listing_row_line&
        view_right&=work_centre_x&+listing_row_line&
        view_top&=work_centre_y&-rect_width&
        view_bottom&=work_centre_y&+rect_width&
        view_clip_left&=view_left&+work_x&
        view_clip_right&=view_right&+work_x&
        view_clip_top&=view_top&+work_y&
        view_clip_bottom&=view_bottom&+work_y&
        frame_left&=MIN(view_left&,screen_max_x&-work_x&)+1
        frame_right&=MIN(view_right&,screen_max_x&-work_x&)-1
        frame_top&=MIN(view_top&,screen_max_y&-work_y&)+1
        frame_bottom&=MIN(view_bottom&,screen_max_y&-work_y&)+1
        IF area_min_h>0
          grid_offset_min_h=-(area_min_h MOD view_width)
          view_origin_x&=CINT(ABS(grid_offset_min_h)*view_scale)
          origin_x_pixels&=CINT((area_min_h-grid_offset_min_h)*view_scale)
          view_origin_x&=view_origin_x&+view_left&
        ELSE
          IF area_max_h<0
            grid_offset_max_h=-(area_max_h MOD view_width)
            view_origin_x&=-CINT(grid_offset_max_h*view_scale)
            origin_x_pixels&=CINT((area_max_h-grid_offset_max_h)*view_scale)
            view_origin_x&=view_origin_x&+view_right&
          ELSE
            view_origin_x&=CINT(ABS(area_min_h)*view_scale)
            origin_x_pixels&=0
            view_origin_x&=view_origin_x&+view_left&
          ENDIF
        ENDIF
        IF area_min_v>0
          grid_offset_min_v=-(area_min_v MOD view_height)
          view_origin_offset&=CINT(ABS(grid_offset_min_v)*view_scale)
          origin_y_pixels&=CINT((grid_offset_min_v-area_min_v)*view_scale)
          view_origin_offset&=view_origin_offset&+view_top&
        ELSE
          IF area_max_v<0
            grid_offset_max_v=-(area_max_v MOD view_height)
            view_origin_offset&=-CINT(grid_offset_max_v*view_scale)
            origin_y_pixels&=CINT((grid_offset_max_v-area_max_v)*view_scale)
            view_origin_offset&=view_origin_offset&+view_bottom&
          ELSE
            view_origin_offset&=CINT(ABS(area_min_v)*view_scale)
            origin_y_pixels&=0
            view_origin_offset&=view_origin_offset&+view_top&
          ENDIF
        ENDIF
        layer_offset_x&=view_origin_x&-legend_width&
        layer_offset_y&=work_even_h&-view_origin_offset&-legend_height&+4
        view_origin_offset&=screen_height&-work_bottom&+view_origin_offset&
        view_offset_y&=screen_height&-view_origin_offset&
        SUB view_offset_y&,work_y&
        view_min_x&=frame_left&-view_origin_x&
        view_min_y&=frame_top&-view_offset_y&
        view_max_x&=frame_right&-view_origin_x&+1
        view_max_y&=frame_bottom&-view_offset_y&
        work_min_x&=view_left&-view_origin_x&
        work_min_y&=view_top&-view_offset_y&
        work_max_x&=view_right&-view_origin_x&+1
        work_max_y&=view_bottom&-view_offset_y&+1
        work_offset_x&=view_origin_x&
        work_offset_y&=view_offset_y&
        view_offset_y&=view_offset_y&+work_y&
        view_origin_x&=view_origin_x&+work_x&
        INC view_bottom&
        INC view_clip_bottom&
        DEC frame_bottom&
        ' the visible area starts as the whole blank
        view_min_h=area_min_h
        view_max_h=area_max_h
        view_max_v=area_max_v
        view_min_v=area_min_v
        ' not quiet: clear the picture buffers
        IF NOT input_in_dialog!
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          CLIP 0,0,graphic_width&,graphic_height& OFFSET 0,0
          DEFFILL ,0,0
          PBOX 0,0,graphic_width&,graphic_height&
          DEFFILL ,1,1
          blit_params%(0)=0
          blit_params%(1)=0
          blit_params%(2)=graphic_width&
          blit_params%(3)=graphic_height&
          blit_params%(4)=0
          blit_params%(5)=0
          blit_params%(6)=graphic_width&
          blit_params%(7)=graphic_height&
          blit_params%(8)=3
          IF wireframe_view!
            layer_mfdb%(0)=layer_bitmaps%(1)
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          ELSE
            FOR loop_index|=FALSE TO depth_levels|
              layer_mfdb%(0)=layer_bitmaps%(loop_index|)
              BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            NEXT loop_index|
            layer_mfdb%(0)=graphic_buffer%
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            ARRAYFILL layer_used!(),0
          ENDIF
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
        ENDIF
        ~WIND_UPDATE(1)
        BOUNDARY 1
        DEFFILL ,1,1
        PBOX frame_left&+1,frame_top&+1,frame_right&+2,frame_bottom&+2
        PBOX frame_left&+3,frame_top&+3,frame_right&+4,frame_bottom&+4
        DEFFILL ,0,0
        PBOX frame_left&-1,frame_top&-1,frame_right&+1,frame_bottom&+1
        BOUNDARY 0
        DEFFILL ,1,1
        DEFTEXT 1,0,0,6
        corner_text_h$=STR$(ROUND(1000*view_max_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_max_v)/1000)
        IF frame_top&>legend_height&+10
          restore_flag!=TRUE
          screen_x&=-24+(frame_right&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)
          screen_y&=frame_top&-4
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          restore_flag!=FALSE
          IF frame_right&+VAL?(corner_text_h$)*8+VAL?(corner_text_v$)*8+32>work_right&
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","
            TEXT frame_right&+16,frame_top&+16,corner_text_v$+")"
          ELSE
            TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","+corner_text_v$+")"
          ENDIF
        ENDIF
        corner_text_h$=STR$(ROUND(1000*view_min_h)/1000)
        corner_text_v$=STR$(ROUND(1000*view_min_v)/1000)
        IF restore_flag!
          TEXT frame_left&,frame_bottom&+12,"("+corner_text_h$+","+corner_text_v$+")"
        ELSE
          screen_x&=MAX(1,PRED(frame_left&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)-31)
          screen_y&=12+frame_bottom&
          TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
        ENDIF
        DEFTEXT 1,0,0,13
        ~WIND_UPDATE(0)
      ENDIF
    ENDIF
  ENDIF
RETURN
' Menu: zoom ("Lupe"). zoom_in! TRUE zooms in further (menu item 35), FALSE starts from the whole blank (36).
' The smallest tool radius in the tool table limits the smallest window. The user chooses mouse or keyboard:
' with the mouse the top left corner is placed and the window dragged as a rubber box, the coordinates shown as
' it moves; with the keyboard the min and max of both axes are typed and checked. The chosen window is shown and
' confirmed, then the scale, frame and origin are worked out again for it.
PROCEDURE select_zoom_window(zoom_in!)
  LOCAL window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,loop_index|,mouse_x&,mouse_y&,inner_index|,alert_button|,point_distance,work_point_y,zoom_redraw_needed!,search_found!,scale_by_width,scale_by_height,draw_left_x&,box_top_y&,rect_right&,box_bottom_y&,first_crossing_x,first_crossing_y,second_crossing_x,second_crossing_y,legend_text_width&,listing_row_line&,rect_width&,smallest_tool_radius,zoom_box_minimum&,input_column&,input_row&,arc_radius,zoom_limit_min_h,zoom_limit_max_v,next_u,zoom_input_choice|,work_text$,edit_work_text$,restore_flag!,zoom_was_active!,direction_x,direction_y,shown_mouse_h&,shown_mouse_v&,grid_offset_min_h,grid_offset_max_h,grid_offset_max_v,grid_offset_min_v
  IF program_lines$(0)=""
    ALERT 3,"Es befindet sich noch|kein Programm im speicher!",1,"Abbruch",alert_button|
  ELSE
    ~WIND_UPDATE(1)
    zoom_redraw_needed!=FALSE
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    DEFTEXT 1,0,0,13
    IF blank_form_drawn!
      area_min_h=view_min_h
      area_max_h=view_max_h
      area_max_v=view_max_v
      area_min_v=view_min_v
      ' zoom in while the view already shows a smaller part of the blank
      IF zoom_in! AND (area_min_h<>blank_min_point(tool_first_axis|) OR area_max_h<>blank_max_point(tool_first_axis|) OR area_min_v<>blank_min_point(tool_second_axis|) OR area_max_v<>blank_max_point(tool_second_axis|))
        zoom_redraw_needed!=TRUE
        blank_form_drawn!=FALSE
        MENU 40,2
      ELSE
        ' check the view against the program quietly
        redraw_simulation_view(-1)
        IF error_messages$(0)="ALTE BLOCK-FORM IST VON AKTUELLER VERSCHIEDEN !"
          zoom_redraw_needed!=TRUE
          blank_form_drawn!=FALSE
          MENU 40,2
          error_messages$(0)=""
        ENDIF
      ENDIF
    ELSE
      zoom_redraw_needed!=TRUE
    ENDIF
    IF zoom_redraw_needed!
      CLS
      DEFFILL 1,1,1
      setup_simulation_view(-1)
    ENDIF
    rect_width&=0
    restore_flag!=TRUE
    ' smallest tool radius in the tool table
    REPEAT
      work_text$=program_lines$(rect_width&)
      IF LEFT$(work_text$,6)="TOOL D"
        point_distance=VAL(MID$(work_text$,32,8))
        IF point_distance>0
          IF restore_flag!
            smallest_tool_radius=point_distance
            restore_flag!=FALSE
          ELSE
            IF smallest_tool_radius>point_distance
              smallest_tool_radius=point_distance
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      INC rect_width&
    UNTIL rect_width&=100
    MUL smallest_tool_radius,2
    ' the zoom window must be at least one tool diameter
    zoom_box_minimum&=INT(smallest_tool_radius*view_scale)+1
    INC smallest_tool_radius
    direction_x=area_max_h-area_min_h
    direction_y=ABS(area_max_v-area_min_v)
    IF direction_x<smallest_tool_radius OR .1>ABS(direction_x-smallest_tool_radius) AND (direction_y<smallest_tool_radius OR .1>ABS(direction_y-smallest_tool_radius))
      zoom_active!=FALSE
      rebuild_window_contents
      show_message_text("LUPE IST NICHT MEHR MôGLICH!")
    ELSE
      IF run_aborted!
        zoom_active!=FALSE
      ELSE
        zoom_was_active!=zoom_active!
        zoom_active!=TRUE
        PAUSE 10
        ' mouse, keyboard or cancel (zoom_input_choice|)
        ALERT 1,"Legen Sie die|linke obere Ecke und die|Ausschnittsgrîûe fest!",1,"  Maus  |Tastatur|Abbruch",zoom_input_choice|
        IF zoom_input_choice|<3
          DEFLINE 1,1,0,0
          zoom_limit_min_h=ROUND(1000*area_min_h)/1000
          arc_radius=ROUND(1000*area_max_h)/1000
          zoom_limit_max_v=ROUND(1000*area_max_v)/1000
          next_u=ROUND(1000*area_min_v)/1000
          REPEAT
            IF zoom_input_choice|=1
              IF tool_axis|=1
                work_text$="Y-KOORDINATE : "
                ' " / ELSE
                edit_work_text$="Z-KOORDINATE : "
              ELSE
                IF tool_axis|=2
                  work_text$="Z-KOORDINATE : "
                  ' " / ELSE
                  edit_work_text$="X-KOORDINATE : "
                ELSE
                  work_text$="X-KOORDINATE : "
                  ' " / ENDIF
                  edit_work_text$="Y-KOORDINATE : "
                ENDIF
              ENDIF
              DEFMOUSE 6
              input_column&=(panel_left&+96)/char_width|
              first_value_column&=15+input_column&
              second_value_column&=41+input_column&
              input_row&=legend_height&
              input_row&=SHR&(DIV(input_row&,small_char_height|),1)
              mouse_limit_h&=frame_right&-zoom_box_minimum&
              mouse_limit_v&=frame_bottom&-zoom_box_minimum&
              PRINT AT(input_column&,input_row&);work_text$;SPC(11);edit_work_text$;
              shown_mouse_h&=0
              shown_mouse_v&=0
              REPEAT
                MOUSE mouse_x&,mouse_y&,inner_index|
                IF mouse_x&<frame_left&
                  mouse_x&=frame_left&
                ELSE
                  IF mouse_x&>mouse_limit_h&
                    mouse_x&=mouse_limit_h&
                  ENDIF
                ENDIF
                IF mouse_y&<frame_top&
                  mouse_y&=frame_top&
                ELSE
                  IF mouse_y&>mouse_limit_v&
                    mouse_y&=mouse_limit_v&
                  ENDIF
                ENDIF
                SETMOUSE mouse_x&+work_x&,mouse_y&+work_y&
                ' the corner in blank coordinates
                draw_left_x&=origin_x_pixels&+(mouse_x&-view_origin_x&+work_x&)
                box_top_y&=origin_y_pixels&+(mouse_y&-view_offset_y&+work_y&)
                first_crossing_x=draw_left_x&/view_scale
                first_crossing_y=box_top_y&/view_scale
                first_crossing_x=ROUND(1000*first_crossing_x)/1000
                first_crossing_y=-ROUND(1000*first_crossing_y)/1000
                ' show the coordinates when the mouse has moved
                IF shown_mouse_h&<>draw_left_x& OR shown_mouse_v&<>box_top_y&
                  PRINT AT(first_value_column&,input_row&);SPC(10);
                  PRINT AT(second_value_column&,input_row&);SPC(10);
                  PRINT AT(first_value_column&,input_row&);first_crossing_x;
                  PRINT AT(second_value_column&,input_row&);first_crossing_y;
                  SHOWM
                  shown_mouse_h&=draw_left_x&
                  shown_mouse_v&=box_top_y&
                ENDIF
              UNTIL inner_index|
              PAUSE 20
              draw_left_x&=mouse_x&
              box_top_y&=mouse_y&
              shown_mouse_h&=0
              shown_mouse_v&=0
              ' then the size: drag a rubber box from the corner
              REPEAT
                MOUSE mouse_x&,mouse_y&,inner_index|
                IF mouse_x&<draw_left_x&
                  mouse_x&=draw_left_x&
                ELSE
                  IF mouse_x&>frame_right&
                    mouse_x&=frame_right&
                  ENDIF
                ENDIF
                IF mouse_y&<box_top_y&
                  mouse_y&=box_top_y&
                ELSE
                  IF mouse_y&>frame_bottom&
                    mouse_y&=frame_bottom&
                  ENDIF
                ENDIF
                SETMOUSE mouse_x&+work_x&,mouse_y&+work_y&
                ~GRAF_RUBBERBOX(draw_left_x&+work_x&,box_top_y&+work_y&,zoom_box_minimum&,zoom_box_minimum&,rect_width&,rect_height&)
                rect_right&=draw_left_x&+rect_width&
                box_bottom_y&=box_top_y&+rect_height&
                segment_length=rect_width&/view_scale
                move_offset_v=rect_height&/view_scale
                second_crossing_x=first_crossing_x+segment_length
                second_crossing_x=ROUND(1000*second_crossing_x)/1000
                second_crossing_y=-first_crossing_y+move_offset_v
                second_crossing_y=-ROUND(1000*second_crossing_y)/1000
                IF shown_mouse_h&<>rect_right& OR shown_mouse_v&<>box_bottom_y&
                  PRINT AT(first_value_column&,input_row&);SPC(10);
                  PRINT AT(second_value_column&,input_row&);SPC(10);
                  PRINT AT(first_value_column&,input_row&);second_crossing_x;
                  PRINT AT(second_value_column&,input_row&);second_crossing_y;
                  SHOWM
                  shown_mouse_h&=rect_right&
                  shown_mouse_v&=box_bottom_y&
                ENDIF
              UNTIL inner_index|
              PRINT AT(input_column&,input_row&);SPC(55);
              SHOWM
              second_crossing_x=first_crossing_x+segment_length
              second_crossing_y=first_crossing_y-move_offset_v
              area_min_h=first_crossing_x
              area_max_h=second_crossing_x
              area_max_v=first_crossing_y
              area_min_v=second_crossing_y
              DEFMOUSE 3
            ELSE
              ' keyboard: type the limits one after the other
              editor_mode!=TRUE
              DEFTEXT ,,,13
              input_row&=legend_height&-list_line_step&
              input_column&=legend_width&
              TEXT input_column&,input_row&,SPACE$(65)
              IF tool_axis|=1
                edit_work_text$=CHR$(89)
              ELSE
                IF tool_axis|=2
                  edit_work_text$=CHR$(90)
                ELSE
                  edit_work_text$=CHR$(88)
                ENDIF
              ENDIF
              ' "MIN x-KOORDINATE (between ... and ...)" for the first axis
              work_text$="MIN "+edit_work_text$+"-KOORDINATE (ZW. "+STR$(zoom_limit_min_h)+" UND "+STR$(arc_radius-smallest_tool_radius)+" ) = "
              TEXT input_column&,input_row&,work_text$
              field_text_length|=LEN(work_text$)
              input_column&=input_column&+field_text_length|*char_width|
              search_found!=FALSE
              REPEAT
                ' read a number
                input_field_value(4,3,input_column&,input_row&,-1,1,-1)
                first_crossing_x=input_value
                ' leave room for one tool diameter
                IF first_crossing_x>=zoom_limit_min_h AND first_crossing_x<=arc_radius-smallest_tool_radius
                  search_found!=TRUE
                ELSE
                  TEXT input_column&,input_row&,"FALSCHE EINGABE !"
                  PAUSE 35
                  TEXT input_column&,input_row&,"                 "
                ENDIF
              UNTIL search_found!
              input_column&=legend_width&
              TEXT input_column&,input_row&,SPACE$(65)
              IF tool_axis|=1
                edit_work_text$=CHR$(89)
              ELSE
                IF tool_axis|=2
                  edit_work_text$=CHR$(90)
                ELSE
                  edit_work_text$=CHR$(88)
                ENDIF
              ENDIF
              work_text$="MAX "+edit_work_text$+"-KOORDINATE (ZW. "+STR$(first_crossing_x+smallest_tool_radius)+" UND "+STR$(arc_radius)+" ) = "
              TEXT input_column&,input_row&,work_text$
              field_text_length|=LEN(work_text$)
              input_column&=input_column&+field_text_length|*char_width|
              search_found!=FALSE
              REPEAT
                input_field_value(4,3,input_column&,input_row&,-1,1,-1)
                second_crossing_x=input_value
                IF second_crossing_x>=first_crossing_x+smallest_tool_radius AND second_crossing_x<=arc_radius
                  search_found!=TRUE
                ELSE
                  TEXT input_column&,input_row&,"FALSCHE EINGABE !"
                  PAUSE 35
                  TEXT input_column&,input_row&,"                 "
                ENDIF
              UNTIL search_found!
              input_column&=legend_width&
              TEXT input_column&,input_row&,SPACE$(65)
              IF tool_axis|=1
                edit_work_text$=CHR$(90)
              ELSE
                IF tool_axis|=2
                  edit_work_text$=CHR$(88)
                ELSE
                  edit_work_text$=CHR$(89)
                ENDIF
              ENDIF
              work_text$="MIN "+edit_work_text$+"-KOORDINATE (ZW. "+STR$(next_u)+" UND "+STR$(zoom_limit_max_v-smallest_tool_radius)+" ) = "
              TEXT input_column&,input_row&,work_text$
              field_text_length|=LEN(work_text$)
              input_column&=input_column&+field_text_length|*char_width|
              search_found!=FALSE
              REPEAT
                input_field_value(4,3,input_column&,input_row&,-1,1,-1)
                first_crossing_y=input_value
                IF first_crossing_y>=next_u AND first_crossing_y<=zoom_limit_max_v-smallest_tool_radius
                  search_found!=TRUE
                ELSE
                  TEXT input_column&,input_row&,"FALSCHE EINGABE !"
                  PAUSE 35
                  TEXT input_column&,input_row&,"                 "
                ENDIF
              UNTIL search_found!
              input_column&=legend_width&
              TEXT input_column&,input_row&,SPACE$(65)
              IF tool_axis|=1
                edit_work_text$=CHR$(90)
              ELSE
                IF tool_axis|=2
                  edit_work_text$=CHR$(88)
                ELSE
                  edit_work_text$=CHR$(89)
                ENDIF
              ENDIF
              work_text$="MAX "+edit_work_text$+"-KOORDINATE (ZW. "+STR$(first_crossing_y+smallest_tool_radius)+" UND "+STR$(zoom_limit_max_v)+" ) = "
              TEXT input_column&,input_row&,work_text$
              field_text_length|=LEN(work_text$)
              input_column&=input_column&+field_text_length|*char_width|
              search_found!=FALSE
              REPEAT
                input_field_value(4,3,input_column&,input_row&,-1,1,-1)
                second_crossing_y=input_value
                IF second_crossing_y>=first_crossing_y+smallest_tool_radius AND second_crossing_y<=zoom_limit_max_v
                  search_found!=TRUE
                ELSE
                  TEXT input_column&,input_row&,"FALSCHE EINGABE !"
                  PAUSE 35
                  TEXT input_column&,input_row&,"                 "
                ENDIF
              UNTIL search_found!
              editor_mode!=FALSE
              GRAPHMODE 1
              area_min_h=first_crossing_x
              area_max_h=second_crossing_x
              area_max_v=second_crossing_y
              area_min_v=first_crossing_y
              draw_left_x&=ROUND(first_crossing_x*view_scale)
              box_top_y&=-ROUND(first_crossing_y*view_scale)
              rect_right&=ROUND(second_crossing_x*view_scale)
              box_bottom_y&=-ROUND(second_crossing_y*view_scale)
              draw_left_x&=draw_left_x&+PRED(view_origin_x&-work_x&-origin_x_pixels&)
              box_top_y&=box_top_y&+PRED(view_offset_y&-work_y&-origin_y_pixels&)
              rect_right&=rect_right&+(view_origin_x&-work_x&-origin_x_pixels&+2)
              box_bottom_y&=box_bottom_y&+(view_offset_y&-work_y&-origin_y_pixels&+2)
            ENDIF
            ' show the window in XOR and ask whether it is right
            GRAPHMODE 3
            BOX draw_left_x&,box_top_y&,rect_right&,box_bottom_y&
            PAUSE 40
            REPEAT
            UNTIL (INKEY$<>"") OR MOUSEK
            ALERT 2,"Ist der gewÑhlte|Ausschnitt in Ordnung?",1,"   Ja   |  Nein  |Abbruch",alert_button|
            IF alert_button|=2
              PAUSE 5
              BOX draw_left_x&,box_top_y&,rect_right&,box_bottom_y&
            ENDIF
            GRAPHMODE 1
          UNTIL alert_button|=1 OR alert_button|=3
          ' accepted: scale and frame for the new window
          IF alert_button|=1
            ' remembered so that the next redraw of the view runs the simulation again in the new window instead of
            ' restoring the saved picture of the old one
            zoom_window_chosen!=TRUE
            blank_top=blank_max_point(depth_axis|)
            blank_bottom=blank_min_point(depth_axis|)
            view_width=area_max_h-area_min_h
            view_height=area_max_v-area_min_v
            blank_depth=blank_top-blank_bottom
            loop_index|=FALSE
            work_text$=STR$(blank_depth)
            REPEAT
              INC loop_index|
            UNTIL (MID$(work_text$,loop_index|,1)=".") OR loop_index|>LEN(work_text$)
            legend_text_width&=legend_width&
            IF loop_index|>2
              SUB loop_index|,2
              legend_text_width&=legend_text_width&+loop_index|*char_width|
            ENDIF
            text_length&=work_even_w&-legend_text_width&*2-4
            box_width&=graphic_height&-4
            scale_by_width=text_length&/view_width
            scale_by_height=box_width&/view_height
            IF scale_by_width<scale_by_height
              view_scale=scale_by_width
            ELSE
              view_scale=scale_by_height
            ENDIF
            text_length&=CINT(view_width*view_scale)
            box_width&=CINT(view_height*view_scale)
            listing_row_line&=CINT(text_length&/2)
            rect_width&=CINT(box_width&/2)
            view_left&=work_centre_x&-listing_row_line&
            view_right&=work_centre_x&+listing_row_line&
            view_top&=work_centre_y&-rect_width&
            view_bottom&=work_centre_y&+rect_width&
            view_clip_left&=view_left&+work_x&
            view_clip_right&=view_right&+work_x&
            view_clip_top&=view_top&+work_y&
            view_clip_bottom&=view_bottom&+work_y&
            frame_left&=MIN(view_left&,screen_max_x&-work_x&)+1
            frame_right&=MIN(view_right&,screen_max_x&-work_x&)-1
            frame_top&=MIN(view_top&,screen_max_y&-work_y&)+1
            frame_bottom&=MIN(view_bottom&,screen_max_y&-work_y&)+1
            IF area_min_h>0
              grid_offset_min_h=-(area_min_h MOD view_width)
              view_origin_x&=CINT(ABS(grid_offset_min_h)*view_scale)
              origin_x_pixels&=CINT((area_min_h-grid_offset_min_h)*view_scale)
              view_origin_x&=view_origin_x&+view_left&
            ELSE
              IF area_max_h<0
                grid_offset_max_h=-(area_max_h MOD view_width)
                view_origin_x&=-CINT(grid_offset_max_h*view_scale)
                origin_x_pixels&=CINT((area_max_h-grid_offset_max_h)*view_scale)
                view_origin_x&=view_origin_x&+view_right&
              ELSE
                view_origin_x&=CINT(ABS(area_min_h)*view_scale)
                origin_x_pixels&=0
                view_origin_x&=view_origin_x&+view_left&
              ENDIF
            ENDIF
            IF area_min_v>0
              grid_offset_min_v=-(area_min_v MOD view_height)
              view_origin_offset&=CINT(ABS(grid_offset_min_v)*view_scale)
              origin_y_pixels&=CINT((grid_offset_min_v-area_min_v)*view_scale)
              view_origin_offset&=view_origin_offset&+view_top&
            ELSE
              IF area_max_v<0
                grid_offset_max_v=-(area_max_v MOD view_height)
                view_origin_offset&=-CINT(grid_offset_max_v*view_scale)
                origin_y_pixels&=CINT((grid_offset_max_v-area_max_v)*view_scale)
                view_origin_offset&=view_origin_offset&+view_bottom&
              ELSE
                view_origin_offset&=CINT(ABS(area_min_v)*view_scale)
                origin_y_pixels&=0
                view_origin_offset&=view_origin_offset&+view_top&
              ENDIF
            ENDIF
            layer_offset_x&=view_origin_x&-legend_width&
            layer_offset_y&=work_even_h&-view_origin_offset&-legend_height&+4
            view_origin_offset&=screen_height&-work_bottom&+view_origin_offset&
            view_offset_y&=screen_height&-view_origin_offset&
            SUB view_offset_y&,work_y&
            view_min_x&=frame_left&-view_origin_x&
            view_min_y&=frame_top&-view_offset_y&
            view_max_x&=frame_right&-view_origin_x&+1
            view_max_y&=frame_bottom&-view_offset_y&
            work_min_x&=view_left&-view_origin_x&
            work_min_y&=view_top&-view_offset_y&
            work_max_x&=view_right&-view_origin_x&+1
            work_max_y&=view_bottom&-view_offset_y&+1
            work_offset_x&=view_origin_x&
            work_offset_y&=view_offset_y&
            view_offset_y&=view_offset_y&+work_y&
            view_origin_x&=view_origin_x&+work_x&
            INC view_bottom&
            INC view_clip_bottom&
            DEC frame_bottom&
            view_min_h=area_min_h
            view_max_h=area_max_h
            view_max_v=area_max_v
            view_min_v=area_min_v
          ELSE
            zoom_active!=zoom_was_active!
          ENDIF
        ELSE
          zoom_active!=zoom_was_active!
          IF zoom_active!
            ' menu item 35 (zoom in) or 36 (whole blank) ticked
            IF zoom_in!
              MENU 35,1
            ELSE
              MENU 36,1
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      rebuild_window_contents
    ENDIF
    ~WIND_UPDATE(0)
  ENDIF
  DEFTEXT 1,0,0,text_height|
  flush_key_events
RETURN
' Menu: show the simulation picture again (full screen) with the frame, corner coordinates and depth legend,
' copying the drawn levels from the buffers, and waits for a key ("WEITER MIT TASTE"). Then the menu and key
' handlers of the current mode are put back. Without a view it says "KEINE BLOCK-FORM VORHANDEN" (no blank).
PROCEDURE show_simulation_picture
  LOCAL window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,loop_index|,screen_x&,screen_y&,corner_text_h$,corner_text_v$,restore_flag!
  ~WIND_UPDATE(1)
  IF blank_form_drawn!
    ' in program entry: no field prompt
    IF field_edit_active!
      toggle_field_cursor
      field_index|=255
    ENDIF
    graphic_view_active!=TRUE
    PBOX message_box_x1&,message_box_y1&,message_box_x2&,message_box_y2&
    GRAPHMODE 1
    CLS
    HIDEM
    BOUNDARY 1
    DEFFILL 1,1,1
    PBOX frame_left&+1,frame_top&+1,frame_right&+2,frame_bottom&+2
    PBOX frame_left&+3,frame_top&+3,frame_right&+4,frame_bottom&+4
    DEFFILL ,0,0
    PBOX frame_left&-1,frame_top&-1,frame_right&+1,frame_bottom&+1
    BOUNDARY 0
    DEFFILL ,1,1
    DEFTEXT 1,0,0,6
    corner_text_h$=STR$(ROUND(1000*view_max_h)/1000)
    corner_text_v$=STR$(ROUND(1000*view_max_v)/1000)
    IF frame_top&>legend_height&+10
      restore_flag!=TRUE
      screen_x&=-24+(frame_right&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)
      screen_y&=frame_top&-4
      TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
    ELSE
      restore_flag!=FALSE
      IF frame_right&+VAL?(corner_text_h$)*8+VAL?(corner_text_v$)*8+32>work_right&
        TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","
        TEXT frame_right&+16,frame_top&+16,corner_text_v$+")"
      ELSE
        TEXT frame_right&+8,frame_top&+8,"("+corner_text_h$+","+corner_text_v$+")"
      ENDIF
    ENDIF
    corner_text_h$=STR$(ROUND(1000*view_min_h)/1000)
    corner_text_v$=STR$(ROUND(1000*view_min_v)/1000)
    IF restore_flag!
      TEXT frame_left&,frame_bottom&+12,"("+corner_text_h$+","+corner_text_v$+")"
    ELSE
      screen_x&=MAX(1,PRED(frame_left&-VAL?(corner_text_h$)*8-VAL?(corner_text_v$)*8)-31)
      screen_y&=12+frame_bottom&
      TEXT screen_x&,screen_y&,"("+corner_text_h$+","+corner_text_v$+")"
    ENDIF
    DEFTEXT 1,0,0,13
    draw_depth_legend(even_depth_bands!,-1)
    bitmap_left&=view_min_x&+layer_offset_x&
    bitmap_top&=view_min_y&+layer_offset_y&
    bitmap_right&=view_max_x&+layer_offset_x&-1
    bitmap_bottom&=view_max_y&+layer_offset_y&-1
    window_left&=view_min_x&+view_origin_x&
    window_top&=view_min_y&+view_offset_y&
    window_right&=view_max_x&+view_origin_x&-1
    window_bottom&=view_max_y&+view_offset_y&-1
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
    DEFFILL 1,0,0
    PBOX view_min_x&,view_min_y&,view_max_x&,view_max_y&
    layer_mfdb%(0)=layer_bitmaps%(0)
    blit_params%(0)=window_left&
    blit_params%(1)=window_top&
    blit_params%(2)=window_right&
    blit_params%(3)=window_bottom&
    blit_params%(4)=bitmap_left&
    blit_params%(5)=bitmap_top&
    blit_params%(6)=bitmap_right&
    blit_params%(7)=bitmap_bottom&
    blit_params%(8)=3
    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
    DEFFILL ,1,1
    IF wireframe_view!
      layer_mfdb%(0)=layer_bitmaps%(1)
    ELSE
      FOR loop_index|=depth_levels_used| DOWNTO 1
        IF layer_used!(loop_index|)
          IF loop_index|=1
            DEFFILL ,1,1
          ELSE
            DEFFILL ,2,depth_level_colours|(loop_index|)
          ENDIF
          PBOX view_min_x&,view_min_y&,view_max_x&,view_max_y&
          layer_mfdb%(0)=layer_bitmaps%(loop_index|)
          blit_params%(0)=bitmap_left&
          blit_params%(1)=bitmap_top&
          blit_params%(2)=bitmap_right&
          blit_params%(3)=bitmap_bottom&
          blit_params%(4)=window_left&
          blit_params%(5)=window_top&
          blit_params%(6)=window_right&
          blit_params%(7)=window_bottom&
          blit_params%(8)=1
          BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
          layer_mfdb%(0)=layer_bitmaps%(0)
          blit_params%(0)=window_left&
          blit_params%(1)=window_top&
          blit_params%(2)=window_right&
          blit_params%(3)=window_bottom&
          blit_params%(4)=bitmap_left&
          blit_params%(5)=bitmap_top&
          blit_params%(6)=bitmap_right&
          blit_params%(7)=bitmap_bottom&
          blit_params%(8)=7
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
        ENDIF
      NEXT loop_index|
      layer_mfdb%(0)=layer_bitmaps%(0)
    ENDIF
    blit_params%(0)=bitmap_left&
    blit_params%(1)=bitmap_top&
    blit_params%(2)=bitmap_right&
    blit_params%(3)=bitmap_bottom&
    blit_params%(4)=window_left&
    blit_params%(5)=window_top&
    blit_params%(6)=window_right&
    blit_params%(7)=window_bottom&
    blit_params%(8)=3
    BITBLT layer_mfdb%(),screen_mfdb%(),blit_params%()
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
    ' press a key to continue
    PRINT AT(text_column&+30,2);"WEITER MIT TASTE !";
    PAUSE 15
    stop_requested!=FALSE
    SHOWM
    graphic_view_stage|=1
    ON MENU GOSUB menu_title_off
    ON MENU KEY GOSUB request_stop
    ' mouse clicks in the work area go to the main handler
    ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB main
    ~WIND_UPDATE(0)
    REPEAT
      ON MENU
    UNTIL stop_requested!=TRUE
    ~WIND_UPDATE(1)
    graphic_view_active!=FALSE
    drawn_cursor_line&=-2
    drawn_top_line&=-2
    list_redraw_needed!=TRUE
    open_program_window
    flush_key_events
    ON MENU GOSUB handle_menu_choice
    ' put back the handlers of the current mode: manual, program run, program entry
    IF manual_mode!
      enter_manual_mode
      ON MENU KEY GOSUB key_manual_mode
      ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB click_manual_mode
    ELSE
      IF program_run_mode!
        ON MENU KEY GOSUB key_run_mode
        ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB click_run_mode
      ELSE
        IF editor_mode!
          ON MENU KEY GOSUB key_edit_mode
          ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB click_edit_mode
        ENDIF
      ENDIF
    ENDIF
    SHOWM
  ELSE
    IF editor_mode! OR program_run_mode!
      show_message_text("KEINE BLOCK-FORM VORHANDEN !")
    ELSE
      show_key_without_function
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
RETURN
' ON MENU GOSUB handler while waiting: only takes the menu title back to normal.
PROCEDURE menu_title_off
  MENU OFF
RETURN
' ON MENU KEY GOSUB handler while waiting: any key sets stop_requested! to end the wait.
PROCEDURE request_stop
  stop_requested!=TRUE
RETURN
' Finds the depth levels the program cuts to, for the depth colours of the simulation. It goes through every
' block for the active plane (three copies of the same scan, for tool axis Z, Y and X), keeping the last point
' in last_point_first/last_point_second/last_point_depth and collecting each new depth inside the blank in
' depth_level_heights(). Q parameters, unsupported cycles, incremental depths in subprograms
' (program_has_labels!) or too many levels set even_depth_bands!: the blank depth is then split into even bands
' instead. Builds the level boundaries depth_level_table() and fill patterns depth_level_colours|() and draws
' the legend.
PROCEDURE find_depth_levels(program_has_labels!)
  LOCAL point_distance,work_point_y,cut_depth,x_axis_flag!,y_axis_flag!,z_axis_flag!,last_point_first,last_point_second,last_point_depth,depth_level_count|,search_found!,program_line$,rnd_block_text$,following_block_text$,file_byte|,loop_index|,line_parameter,line_fraction,work_text$,edit_work_text$,result_text$,field_name$,depth_spare|,line_index&,rect_width&
  even_depth_bands!=FALSE
  depth_level_count|=FALSE
  ' the start depth counts as a level when it is inside the blank
  IF blank_top>start_point(depth_axis|) AND blank_bottom<start_point(depth_axis|)
    depth_level_heights(depth_level_count|)=start_point(depth_axis|)
    INC depth_level_count|
  ENDIF
  line_index&=0
  rect_width&=0
  skip_to_next_block(rect_width&)
  ' start point: the current position
  last_point_first=start_point(tool_first_axis|)
  last_point_second=start_point(tool_second_axis|)
  last_point_depth=start_point(depth_axis|)
  ' tool along Z
  IF tool_axis|=3
    REPEAT
      program_line$=program_lines$(line_index&)
      field_name$=program_lines$(rect_width&)
      IF LEFT$(program_line$,8)="CYCL DEF"
        ' cycle number
        file_byte|=VAL(MID$(program_line$,10,2))
        ' cycles that cut at their own depths: use even bands
        IF file_byte|<>0 AND file_byte|<7 OR file_byte|=15 OR file_byte|=16 OR (file_byte|=7 AND (MID$(program_line$,16,1)="Z"))
          even_depth_bands!=TRUE
        ELSE
          ' cycle 11 (scaling) is applied right away
          IF file_byte|=11
            next_block&=rect_width&
            apply_scaling_cycle
          ENDIF
        ENDIF
      ENDIF
      IF NOT even_depth_bands!
        search_found!=FALSE
        rnd_block_text$=LEFT$(program_line$)
        following_block_text$=LEFT$(program_line$,2)
        ' a straight line with coordinates
        IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND (MID$(program_line$,7,1)<>"A")
          read_radius_correction(program_line$)
          work_text$=MID$(program_line$,6,2)
          edit_work_text$=MID$(program_line$,18,2)
          result_text$=MID$(program_line$,30,2)
          IF result_text$<>"  "
            ' a Q parameter in a coordinate: the depth cannot be known
            IF (MID$(program_line$,9,1)="Q") OR (MID$(program_line$,21,1)="Q") OR (MID$(program_line$,33,1)="Q")
              even_depth_bands!=TRUE
            ELSE
              point_distance=VAL(MID$(program_line$,9,8))
              IF MID$(program_line$,8,1)="-"
                point_distance=-point_distance
              ENDIF
              work_point_y=VAL(MID$(program_line$,21,8))
              IF MID$(program_line$,20,1)="-"
                work_point_y=-work_point_y
              ENDIF
              cut_depth=VAL(MID$(program_line$,33,8))
              IF MID$(program_line$,32,1)="-"
                cut_depth=-cut_depth
              ENDIF
              IF scaling_active!
                MUL cut_depth,scaling_factor
              ENDIF
              ' incremental depth
              IF result_text$="IZ"
                IF program_has_labels!
                  even_depth_bands!=TRUE
                ELSE
                  cut_depth=cut_depth+last_point_depth
                ENDIF
              ENDIF
              x_axis_flag!=FALSE
              y_axis_flag!=FALSE
              IF point_distance=last_point_first
                x_axis_flag!=TRUE
              ELSE
                IF cut_depth=last_point_depth
                  x_axis_flag!=TRUE
                ENDIF
              ENDIF
              IF work_point_y=last_point_second
                y_axis_flag!=TRUE
              ELSE
                IF cut_depth=last_point_depth
                  y_axis_flag!=TRUE
                ENDIF
              ENDIF
              ' the line moves only in depth: a plunge
              IF (work_text$="IX") AND point_distance=0 OR x_axis_flag! OR (work_text$="  ") AND ((edit_work_text$="IY") AND work_point_y=0 OR y_axis_flag! OR (edit_work_text$="  "))
                ' a depth inside the blank
                IF cut_depth>blank_bottom AND cut_depth<blank_top
                  search_found!=TRUE
                ENDIF
              ELSE
                IF cut_depth<blank_top
                  even_depth_bands!=TRUE
                ENDIF
              ENDIF
              ' the line end is the next start point
              last_point_first=point_distance
              last_point_second=work_point_y
              last_point_depth=cut_depth
            ENDIF
          ENDIF
          ' a line before a rounding or another line
          IF (LEFT$(field_name$,3)="RND") OR ((LEFT$(field_name$,2)="L ") AND LEN(field_name$)<20 AND (MID$(field_name$,7,1)<>"A")) AND (radius_correction$="0")
            work_text$=RIGHT$(work_text$)
            edit_work_text$=RIGHT$(edit_work_text$)
            result_text$=RIGHT$(result_text$)
            ' neither axis of the plane given
            IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=result_text$))
              ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              error_blocks&(0)=line_index&
              error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
            ELSE
              IF (work_text$="Z") OR (edit_work_text$="Z") OR (result_text$="Z")
                even_depth_bands!=TRUE
              ENDIF
            ENDIF
          ENDIF
        ELSE
          IF following_block_text$="CC"
            IF (MID$(program_line$,7,1)="Z") OR (MID$(program_line$,19,1)="Z")
              even_depth_bands!=TRUE
            ENDIF
          ELSE
            IF rnd_block_text$="C"
              read_radius_correction(program_line$)
              IF following_block_text$="CR"
                work_text$=MID$(program_line$,5,1)
                edit_work_text$=MID$(program_line$,17,1)
                IF work_text$="X"
                  last_point_first=VAL(MID$(program_line$,7,8))
                  IF MID$(program_line$,6,1)="-"
                    last_point_first=-last_point_first
                  ENDIF
                ELSE
                  IF work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,19,8))
                    IF MID$(program_line$,18,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ENDIF
                ENDIF
                IF edit_work_text$="X"
                  last_point_first=VAL(MID$(program_line$,7,8))
                  IF MID$(program_line$,6,1)="-"
                    last_point_first=-last_point_first
                  ENDIF
                ELSE
                  IF edit_work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,19,8))
                    IF MID$(program_line$,18,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ENDIF
                ENDIF
              ELSE
                work_text$=MID$(program_line$,7,1)
                edit_work_text$=MID$(program_line$,19,1)
                IF work_text$="X"
                  last_point_first=VAL(MID$(program_line$,9,8))
                  IF MID$(program_line$,8,1)="-"
                    last_point_first=-last_point_first
                  ENDIF
                ELSE
                  IF work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,21,8))
                    IF MID$(program_line$,20,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ENDIF
                ENDIF
                IF edit_work_text$="X"
                  last_point_first=VAL(MID$(program_line$,9,8))
                  IF MID$(program_line$,8,1)="-"
                    last_point_first=-last_point_first
                  ENDIF
                ELSE
                  IF edit_work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,21,8))
                    IF MID$(program_line$,20,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
              IF (work_text$="Z") OR (edit_work_text$="Z")
                even_depth_bands!=TRUE
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' a new depth for the list
        IF search_found!
          loop_index|=TRUE
          depth_is_new!=TRUE
          REPEAT
            INC loop_index|
            IF cut_depth=depth_level_heights(loop_index|)
              depth_is_new!=FALSE
            ENDIF
          UNTIL loop_index|=depth_level_count|
          IF depth_is_new!=TRUE
            ' too many levels: even bands
            IF depth_level_count|=depth_levels_less_one|
              even_depth_bands!=TRUE
            ELSE
              depth_level_heights(depth_level_count|)=cut_depth
              INC depth_level_count|
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      line_index&=rect_width&
      skip_to_next_block(rect_width&)
      ' until the end, even bands, or an error
    UNTIL line_index&=last_line& OR even_depth_bands! OR run_aborted!
  ELSE
    ' tool along Y
    IF tool_axis|=2
      REPEAT
        program_line$=program_lines$(line_index&)
        field_name$=program_lines$(rect_width&)
        IF LEFT$(program_line$,8)="CYCL DEF"
          file_byte|=VAL(MID$(program_line$,10,2))
          IF file_byte|<>0 AND file_byte|<7 OR file_byte|=15 OR file_byte|=16 OR (file_byte|=7 AND (MID$(program_line$,16,1)="Y"))
            even_depth_bands!=TRUE
          ELSE
            IF file_byte|=11
              next_block&=rect_width&
              apply_scaling_cycle
            ENDIF
          ENDIF
        ENDIF
        IF NOT even_depth_bands!
          search_found!=FALSE
          rnd_block_text$=LEFT$(program_line$)
          following_block_text$=LEFT$(program_line$,2)
          IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND (MID$(program_line$,7,1)<>"A")
            work_text$=MID$(program_line$,6,2)
            edit_work_text$=MID$(program_line$,18,2)
            result_text$=MID$(program_line$,30,2)
            IF edit_work_text$<>"  "
              IF (MID$(program_line$,9,1)="Q") OR (MID$(program_line$,21,1)="Q") OR (MID$(program_line$,33,1)="Q")
                even_depth_bands!=TRUE
              ELSE
                point_distance=VAL(MID$(program_line$,9,8))
                IF MID$(program_line$,8,1)="-"
                  point_distance=-point_distance
                ENDIF
                work_point_y=VAL(MID$(program_line$,21,8))
                IF MID$(program_line$,20,1)="-"
                  work_point_y=-work_point_y
                ENDIF
                cut_depth=VAL(MID$(program_line$,33,8))
                IF MID$(program_line$,32,1)="-"
                  cut_depth=-cut_depth
                ENDIF
                IF scaling_active!
                  MUL work_point_y,scaling_factor
                ENDIF
                IF edit_work_text$="IY"
                  IF program_has_labels!
                    even_depth_bands!=TRUE
                  ELSE
                    work_point_y=work_point_y+last_point_second
                  ENDIF
                ENDIF
                x_axis_flag!=FALSE
                z_axis_flag!=FALSE
                IF point_distance=last_point_first
                  x_axis_flag!=TRUE
                ELSE
                  IF work_point_y=last_point_second
                    x_axis_flag!=TRUE
                  ENDIF
                ENDIF
                IF cut_depth=last_point_depth
                  z_axis_flag!=TRUE
                ELSE
                  IF work_point_y=last_point_second
                    z_axis_flag!=TRUE
                  ENDIF
                ENDIF
                IF (work_text$="IX") AND point_distance=0 OR x_axis_flag! OR (work_text$="  ") AND ((result_text$="IZ") AND cut_depth=0 OR z_axis_flag! OR (result_text$="  "))
                  IF work_point_y>blank_bottom AND work_point_y<blank_top
                    search_found!=TRUE
                  ENDIF
                ELSE
                  IF work_point_y<blank_top
                    even_depth_bands!=TRUE
                  ENDIF
                ENDIF
                last_point_first=point_distance
                last_point_second=work_point_y
                last_point_depth=cut_depth
              ENDIF
            ENDIF
            IF (LEFT$(field_name$,3)="RND") OR ((LEFT$(field_name$,2)="L ") AND LEN(field_name$)<20 AND (MID$(field_name$,7,1)<>"A")) AND (radius_correction$="0")
              work_text$=RIGHT$(work_text$)
              edit_work_text$=RIGHT$(edit_work_text$)
              result_text$=RIGHT$(result_text$)
              IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=result_text$))
                ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=line_index&
                error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
              ELSE
                IF (work_text$="Y") OR (edit_work_text$="Y") OR (result_text$="Y")
                  even_depth_bands!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ELSE
            IF following_block_text$="CC"
              IF (MID$(program_line$,7,1)="Y") OR (MID$(program_line$,19,1)="Y")
                even_depth_bands!=TRUE
              ENDIF
            ELSE
              IF rnd_block_text$="C"
                IF following_block_text$="CR"
                  work_text$=MID$(program_line$,5,1)
                  edit_work_text$=MID$(program_line$,17,1)
                  IF work_text$="X"
                    last_point_first=VAL(MID$(program_line$,7,8))
                    IF MID$(program_line$,6,1)="-"
                      last_point_first=-last_point_first
                    ENDIF
                  ELSE
                    IF work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,19,8))
                      IF MID$(program_line$,18,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                  IF edit_work_text$="X"
                    last_point_first=VAL(MID$(program_line$,7,8))
                    IF MID$(program_line$,6,1)="-"
                      last_point_first=-last_point_first
                    ENDIF
                  ELSE
                    IF edit_work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,19,8))
                      IF MID$(program_line$,18,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                ELSE
                  work_text$=MID$(program_line$,7,1)
                  edit_work_text$=MID$(program_line$,19,1)
                  IF work_text$="X"
                    last_point_first=VAL(MID$(program_line$,9,8))
                    IF MID$(program_line$,8,1)="-"
                      last_point_first=-last_point_first
                    ENDIF
                  ELSE
                    IF work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,21,8))
                      IF MID$(program_line$,20,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                  IF edit_work_text$="X"
                    last_point_first=VAL(MID$(program_line$,9,8))
                    IF MID$(program_line$,8,1)="-"
                      last_point_first=-last_point_first
                    ENDIF
                  ELSE
                    IF edit_work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,21,8))
                      IF MID$(program_line$,20,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                IF (work_text$="Y") OR (edit_work_text$="Y")
                  even_depth_bands!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF search_found!
            loop_index|=TRUE
            depth_is_new!=TRUE
            REPEAT
              INC loop_index|
              IF work_point_y=depth_level_heights(loop_index|)
                depth_is_new!=FALSE
              ENDIF
            UNTIL loop_index|=depth_level_count|
            IF depth_is_new!=TRUE
              IF depth_level_count|=depth_levels_less_one|
                even_depth_bands!=TRUE
              ELSE
                depth_level_heights(depth_level_count|)=work_point_y
                INC depth_level_count|
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        line_index&=rect_width&
        skip_to_next_block(rect_width&)
      UNTIL line_index&=last_line& OR even_depth_bands! OR run_aborted!
    ELSE
      REPEAT
        program_line$=program_lines$(line_index&)
        field_name$=program_lines$(rect_width&)
        IF LEFT$(program_line$,8)="CYCL DEF"
          file_byte|=VAL(MID$(program_line$,10,2))
          IF file_byte|<>0 AND file_byte|<7 OR file_byte|=15 OR file_byte|=16 OR (file_byte|=7 AND (MID$(program_line$,16,1)="X"))
            even_depth_bands!=TRUE
          ELSE
            IF file_byte|=11
              next_block&=rect_width&
              apply_scaling_cycle
            ENDIF
          ENDIF
        ENDIF
        IF NOT even_depth_bands!
          search_found!=FALSE
          rnd_block_text$=LEFT$(program_line$)
          following_block_text$=LEFT$(program_line$,2)
          IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND (MID$(program_line$,7,1)<>"A")
            work_text$=MID$(program_line$,6,2)
            edit_work_text$=MID$(program_line$,18,2)
            result_text$=MID$(program_line$,30,2)
            IF work_text$<>"  "
              IF (MID$(program_line$,9,1)="Q") OR (MID$(program_line$,21,1)="Q") OR (MID$(program_line$,33,1)="Q")
                even_depth_bands!=TRUE
              ELSE
                point_distance=VAL(MID$(program_line$,9,8))
                IF MID$(program_line$,8,1)="-"
                  point_distance=-point_distance
                ENDIF
                work_point_y=VAL(MID$(program_line$,21,8))
                IF MID$(program_line$,20,1)="-"
                  work_point_y=-work_point_y
                ENDIF
                cut_depth=VAL(MID$(program_line$,33,8))
                IF MID$(program_line$,32,1)="-"
                  cut_depth=-cut_depth
                ENDIF
                IF scaling_active!
                  MUL point_distance,scaling_factor
                ENDIF
                IF work_text$="IX"
                  IF program_has_labels!
                    even_depth_bands!=TRUE
                  ELSE
                    point_distance=point_distance+last_point_depth
                  ENDIF
                ENDIF
                y_axis_flag!=FALSE
                z_axis_flag!=FALSE
                IF work_point_y=last_point_second
                  y_axis_flag!=TRUE
                ELSE
                  IF point_distance=last_point_first
                    y_axis_flag!=TRUE
                  ENDIF
                ENDIF
                IF cut_depth=last_point_depth
                  z_axis_flag!=TRUE
                ELSE
                  IF point_distance=last_point_first
                    z_axis_flag!=TRUE
                  ENDIF
                ENDIF
                IF (edit_work_text$="IY") AND work_point_y=0 OR y_axis_flag! OR (edit_work_text$="  ") AND ((result_text$="IZ") AND cut_depth=0 OR z_axis_flag! OR (result_text$="  "))
                  IF point_distance>blank_bottom AND point_distance<blank_top
                    search_found!=TRUE
                  ENDIF
                ELSE
                  IF point_distance<blank_top
                    even_depth_bands!=TRUE
                  ENDIF
                ENDIF
                last_point_first=point_distance
                last_point_second=work_point_y
                last_point_depth=cut_depth
              ENDIF
            ENDIF
            IF (LEFT$(field_name$,3)="RND") OR ((LEFT$(field_name$,2)="L ") AND LEN(field_name$)<20 AND (MID$(field_name$,7,1)<>"A")) AND (radius_correction$="0")
              work_text$=RIGHT$(work_text$)
              edit_work_text$=RIGHT$(edit_work_text$)
              result_text$=RIGHT$(result_text$)
              IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=result_text$))
                ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=line_index&
                error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
              ELSE
                IF (work_text$="X") OR (edit_work_text$="X") OR (result_text$="X")
                  even_depth_bands!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ELSE
            IF following_block_text$="CC"
              IF (MID$(program_line$,7,1)="X") OR (MID$(program_line$,19,1)="X")
                even_depth_bands!=TRUE
              ENDIF
            ELSE
              IF rnd_block_text$="C"
                IF following_block_text$="CR"
                  work_text$=MID$(program_line$,5,1)
                  edit_work_text$=MID$(program_line$,17,1)
                  IF work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,7,8))
                    IF MID$(program_line$,6,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ELSE
                    IF work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,19,8))
                      IF MID$(program_line$,18,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                  IF edit_work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,7,8))
                    IF MID$(program_line$,6,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ELSE
                    IF edit_work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,19,8))
                      IF MID$(program_line$,18,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                ELSE
                  work_text$=MID$(program_line$,7,1)
                  edit_work_text$=MID$(program_line$,19,1)
                  IF work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,9,8))
                    IF MID$(program_line$,8,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ELSE
                    IF work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,21,8))
                      IF MID$(program_line$,20,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                  IF edit_work_text$="Y"
                    last_point_second=VAL(MID$(program_line$,9,8))
                    IF MID$(program_line$,8,1)="-"
                      last_point_second=-last_point_second
                    ENDIF
                  ELSE
                    IF edit_work_text$="Z"
                      last_point_depth=VAL(MID$(program_line$,21,8))
                      IF MID$(program_line$,20,1)="-"
                        last_point_depth=-last_point_depth
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                IF (work_text$="X") OR (edit_work_text$="X")
                  even_depth_bands!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF search_found!
            loop_index|=TRUE
            depth_is_new!=TRUE
            REPEAT
              INC loop_index|
              IF point_distance=depth_level_heights(loop_index|)
                depth_is_new!=FALSE
              ENDIF
            UNTIL loop_index|=depth_level_count|
            IF depth_is_new!=TRUE
              IF depth_level_count|=depth_levels_less_one|
                even_depth_bands!=TRUE
              ELSE
                depth_level_heights(depth_level_count|)=point_distance
                INC depth_level_count|
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        line_index&=rect_width&
        skip_to_next_block(rect_width&)
      UNTIL line_index&=last_line& OR even_depth_bands! OR run_aborted!
    ENDIF
  ENDIF
  ' even bands: split the blank depth into level-count bands
  IF even_depth_bands!
    layer_depth_count|=depth_levels|
    top_level|=SUCC(layer_depth_count|)
    depth_copy_less_one|=PRED(layer_depth_count|)
    IF depth_levels|<depth_levels_max|
      depth_levels_used|=layer_depth_count|
    ELSE
      depth_levels_used|=depth_levels_max|
    ENDIF
    depth_used_plus_one|=SUCC(depth_levels_used|)
    depth_used_less_one|=PRED(depth_levels_used|)
    line_parameter=blank_depth/depth_copy_less_one|
    line_fraction=blank_bottom
    FOR loop_index|=1 TO layer_depth_count|
      IF 1E-07>ABS(line_fraction-blank_top)
        line_fraction=blank_top
      ENDIF
      depth_level_table(loop_index|)=line_fraction
      line_fraction=line_fraction+line_parameter
    NEXT loop_index|
    depth_level_table(top_level|)=blank_top
    FOR loop_index|=2 TO depth_levels_used|
      depth_level_colours|(loop_index|)=first_depth_pattern|-loop_index|
    NEXT loop_index|
  ELSE
    ' the depths found, sorted
    QSORT depth_level_heights(),depth_level_count|
    INC depth_level_count|
    layer_depth_count|=depth_level_count|
    top_level|=SUCC(layer_depth_count|)
    depth_copy_less_one|=PRED(layer_depth_count|)
    depth_levels_used|=depth_level_count|
    depth_used_plus_one|=SUCC(depth_levels_used|)
    depth_used_less_one|=PRED(depth_levels_used|)
    depth_level_table(1)=blank_bottom
    FOR loop_index|=2 TO layer_depth_count|
      depth_level_table(loop_index|)=depth_level_heights(loop_index|-2)
    NEXT loop_index|
    depth_level_table(top_level|)=blank_top
    FOR loop_index|=2 TO depth_levels_used|
      depth_level_colours|(loop_index|)=first_depth_pattern|-loop_index|
    NEXT loop_index|
  ENDIF
  depth_level_table(0)=blank_bottom
  ' draw the legend
  draw_depth_legend(even_depth_bands!,-1)
RETURN
' Draws the depth legend at the left of the window: "Fraeser-hoehe" (cutter height) and a box with the fill
' pattern for each depth level with its value (even bands if legend_even_bands!, else the levels found), the
' axis symbol with its labels. If legend_to_window! is set the legend is also copied to every visible rectangle
' of the window.
PROCEDURE draw_depth_legend(legend_even_bands!,legend_to_window!)
  LOCAL scan_index&,basic_variables,move_offset_v,depth_scale_top,depth_scale_bottom,scan_column|,inner_index|,legend_depth_value,redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_y&,screen_x&,rect_width&,rect_height&
  ' drawn on the off-screen buffer
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  DEFFILL ,0,0
  PBOX 0,0,legend_width&*2,work_h&
  DEFTEXT 1,0,0,6
  IF wireframe_view!
    scan_column|=3
  ELSE
    BOUNDARY 1
    depth_scale_top=blank_top
    depth_scale_bottom=blank_bottom
    ' "Fraeser-hoehe": cutter height
    PRINT AT(1,7);"FrÑser-";
    PRINT AT(1,8);"hîhe:";
    DEFFILL ,0,0
    PBOX 1,71+SHL(scan_column|,3),15,79+SHL(scan_column|,3)
    legend_depth_value=ROUND(100*depth_scale_top)/100
    PRINT AT(3,10+scan_column|);CHR$(-14);legend_depth_value;
    scan_column|=FALSE
    ' even bands: boxes from the top of the blank down
    IF legend_even_bands!
      basic_variables=blank_depth/depth_used_less_one|
      inner_index|=1
      move_offset_v=depth_scale_top
      DEFFILL ,2,depth_level_colours|(depth_used_plus_one|-inner_index|)
      PBOX 1,87+SHL(scan_column|,3),15,95+SHL(scan_column|,3)
      legend_depth_value=ROUND(100*move_offset_v)/100
      PRINT AT(3,12+scan_column|);"<";legend_depth_value;
      ADD scan_column|,2
      INC inner_index|
      REPEAT
        SUB move_offset_v,basic_variables
        IF depth_used_plus_one|-inner_index|=1
          DEFFILL ,1,1
        ELSE
          DEFFILL ,2,depth_level_colours|(depth_used_plus_one|-inner_index|)
        ENDIF
        PBOX 1,87+SHL(scan_column|,3),15,95+SHL(scan_column|,3)
        legend_depth_value=ROUND(100*move_offset_v)/100
        PRINT AT(3,12+scan_column|);CHR$(-13);legend_depth_value;
        ADD scan_column|,2
        INC inner_index|
      UNTIL inner_index|=depth_levels_used|
    ELSE
      IF layer_depth_count|>1
        DEFFILL ,2,depth_level_colours|(depth_levels_used|)
        PBOX 1,87+SHL(scan_column|,3),15,95+SHL(scan_column|,3)
        move_offset_v=depth_level_table(depth_levels_used|)
        legend_depth_value=ROUND(100*move_offset_v)/100
        PRINT AT(3,12+scan_column|);"=";legend_depth_value;
        ADD scan_column|,2
        FOR inner_index|=depth_used_less_one| DOWNTO 2
          DEFFILL ,2,depth_level_colours|(inner_index|)
          PBOX 1,87+SHL(scan_column|,3),15,95+SHL(scan_column|,3)
          move_offset_v=depth_level_table(inner_index|)
          legend_depth_value=ROUND(100*move_offset_v)/100
          PRINT AT(3,12+scan_column|);"=";legend_depth_value;
          ADD scan_column|,2
        NEXT inner_index|
      ENDIF
    ENDIF
    DEFFILL ,1,1
    PBOX 1,87+SHL(scan_column|,3),15,95+SHL(scan_column|,3)
    legend_depth_value=ROUND(100*depth_scale_bottom)/100
    PRINT AT(3,12+scan_column|);CHR$(-13);legend_depth_value;
  ENDIF
  DEFFILL ,1,1
  screen_y&=145+SHL(scan_column|,3)
  ' the axis symbol icon under the legend
  OB_X(cutter_icon_tree%,cutter_icon_object&)=SUCC(work_x&)
  OB_Y(cutter_icon_tree%,cutter_icon_object&)=screen_y&+work_y&-36
  ~OBJC_DRAW(cutter_icon_tree%,cutter_icon_object&,0,work_x&,work_y&,work_w&,work_h&)
  IF tool_axis|=3
    TEXT 24,screen_y&-20,"+Y"
    TEXT 55,screen_y&+20,"+X"
    TEXT 50,screen_y&-5,"-Z"
  ELSE
    IF tool_axis|=2
      TEXT 24,screen_y&-20,"+X"
      TEXT 55,screen_y&+20,"+Z"
      TEXT 50,screen_y&-5,"-Y"
    ELSE
      TEXT 24,screen_y&-20,"+Z"
      TEXT 55,screen_y&+20,"+Y"
      TEXT 50,screen_y&-5,"-X"
    ENDIF
  ENDIF
  ' copy the legend to every visible rectangle of the window
  IF legend_to_window!
    redraw_x&=work_x&
    redraw_y&=work_y&
    scan_index&=VAL?(STR$(legend_depth_value))
    IF legend_depth_value=INT(legend_depth_value)
      ADD scan_index&,3
    ENDIF
    IF scan_index&>5
      redraw_width&=ADD(legend_width&,char_width|*(scan_index&-5))
    ELSE
      redraw_width&=legend_width&
    ENDIF
    redraw_height&=work_h&
    window_handle|=W_HAND(#1)
    IF redraw_x&<screen_width& AND redraw_y&<screen_height&
      ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
        IF screen_x&+rect_width&>screen_width&
          rect_width&=screen_width&-screen_x&
        ENDIF
        IF screen_y&+rect_height&>screen_height&
          rect_height&=screen_height&-screen_y&
        ENDIF
        DEC rect_width&
        DEC rect_height&
        blit_params%(0)=screen_x&
        blit_params%(1)=screen_y&
        blit_params%(2)=screen_x&+rect_width&
        blit_params%(3)=screen_y&+rect_height&
        blit_params%(4)=screen_x&
        blit_params%(5)=screen_y&
        blit_params%(6)=screen_x&+rect_width&
        blit_params%(7)=screen_y&+rect_height&
        blit_params%(8)=7
        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
      ENDIF
      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WHILE rect_height&<>0 OR rect_width&<>0
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WEND
    ENDIF
  ENDIF
  GRAPHMODE 1
  BOUNDARY 0
  DEFTEXT 1,0,0,13
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
RETURN
' Checks the program before a simulation: a TOOL DEF and a TOOL CALL must come before the first cutting block
' (RND, C.., L.. with coordinates), and BLK FORM 0.1 and 0.2 must both be there. A tool memory with at least
' two lines (tool_last_line& above 0) counts as tools defined from the start, so then only the TOOL CALL is
' needed. Errors go to the error line error_blocks&(0) / error_messages$(0) with run_aborted! set.
PROCEDURE check_tool_and_blank
  LOCAL tool_defined!,tool_called!,blank_form_min_seen!,blank_form_max_seen!,line_index&,program_line$,rnd_block_text$,lookahead_third_block_text$
  ' tools in the tool memory count as defined
  IF tool_last_line&>0
    tool_defined!=TRUE
  ELSE
    tool_defined!=FALSE
  ENDIF
  tool_called!=FALSE
  blank_form_min_seen!=FALSE
  blank_form_max_seen!=FALSE
  line_index&=0
  REPEAT
    INC line_index&
    program_line$=program_lines$(line_index&)
    rnd_block_text$=LEFT$(program_line$,1)
    lookahead_third_block_text$=LEFT$(program_line$,3)
    ' not a continuation line
    IF RIGHT$(program_line$,1)<>"}"
      IF LEFT$(program_line$,8)="TOOL DEF"
        tool_defined!=TRUE
      ELSE
        IF LEFT$(program_line$,9)="TOOL CALL"
          tool_called!=TRUE
        ELSE
          IF LEFT$(program_line$,13)="BLK FORM  0.1"
            blank_form_min_seen!=TRUE
          ELSE
            IF LEFT$(program_line$,13)="BLK FORM  0.2"
              blank_form_max_seen!=TRUE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      ' a cutting block before any TOOL DEF
      IF (NOT tool_defined!) AND ((lookahead_third_block_text$="RND") OR ((rnd_block_text$="C") AND (MID$(program_line$,2,1)<>"A")) OR ((rnd_block_text$="L") AND (MID$(program_line$,2,1)<>"B")))
        ALERT 3,"Es wurde zu FrÑsbeginn|kein Werkzeug definiert!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=line_index&
        error_messages$(0)="ES WURDE VORHER KEIN WERKZEUG DEFINIERT!"
      ELSE
        ' a cutting block before any TOOL CALL
        IF (NOT tool_called!) AND ((lookahead_third_block_text$="RND") OR ((rnd_block_text$="C") AND (MID$(program_line$,2,1)<>"A")) OR ((rnd_block_text$="L") AND (MID$(program_line$,2,1)<>"B")))
          ALERT 3,"Es wurde zu FrÑsbeginn|kein Werkzeug aufgerufen!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=line_index&
          error_messages$(0)="ES WURDE VORHER KEIN WERKZEUG AUFGERUFEN!"
        ENDIF
      ENDIF
    ENDIF
  UNTIL line_index&=PRED(last_line&) OR run_aborted!
  ' BLK FORM 0.1 or 0.2 missing
  IF (NOT run_aborted!) AND (blank_form_min_seen!=FALSE OR blank_form_max_seen!=FALSE)
    ALERT 3,"Es wurde keine|BLOCK-FORM definiert!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    error_blocks&(0)=0
    error_messages$(0)="ES WURDE KEINE BLOCK-FORM DEFINIERT!"
  ENDIF
RETURN
' The graphic simulation: runs the program block by block and draws the tool path. It resets the transformation
' state (datum, mirror, rotation, scale, Q parameters, labels), finds the subprogram labels and the depth
' levels, then for each block: M functions (M02/M30 end, M00/M06 wait), TOOL DEF/TOOL CALL (tool radius and the
' tool disc used to draw it), straight lines L/LP, circles CC/C/CP/CT/CR/CTP, rounding RND and chamfers with the
' tool radius compensation, CALL LBL, STOP, cycles 7, 8, 10, 11, 14 and the FN parameter functions. Space stops
' it. current_block& is the current block, next_block&/block_after_next&/third_block_ahead& the next three.
PROCEDURE run_graphic_simulation
  LOCAL program_line$,line_index&,work_text$,edit_work_text$,field_name$,next_block_text$,third_block_text$,point_distance,work_point_y,polar_radius,polar_angle,pole_start_angle,main_program_end_line&,segment_length,second_operand,settings_entry|,search_found!,search_done!,element_arc_radius,line_is_continuation!,rnd_block_text$,following_block_text$,lookahead_third_block_text$,line_head_five$,line_head_eight$,line_head_twelve$,line_head_thirteen$,block_correction_letter$,next_correction_letter$,tool_search_index&,axis_entry_count|,loop_index|,screen_x&,screen_y&,basic_variables,rect_width&,program_end_reached!,stop_flag_saved!,line_not_type_a!,tool_number|,program_has_labels!,alert_button|,saved_function_code|,search_block&,outer_label_number&,window_handle|,rect_width&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ' menu state 2: simulation running
  graphic_view_stage|=2
  ON MENU GOSUB menu_title_off
  ' Space stops it
  ON MENU KEY GOSUB stop_on_space_key
  ON MENU IBOX 1,work_x&,work_bottom&+-130,work_w&,130 GOSUB main
  simulation_running!=TRUE
  graphic_view_active!=TRUE
  ' cleared at every run; select_zoom_window sets it when a new window is chosen, and the redraw then runs the
  ' simulation again
  zoom_window_chosen!=FALSE
  window_handle|=W_HAND(#1)
  ' width of the status line
  status_line_width&=work_w&-2
  stop_requested!=FALSE
  program_end_reached!=FALSE
  end_point_stored!=FALSE
  centre_pending!=FALSE
  ' arc directions and corrections start as - and 0
  saved_arc_direction$=CHR$(45)
  arc_direction$=CHR$(45)
  spare_arc_direction$=CHR$(45)
  saved_correction_letter$=CHR$(48)
  radius_correction$=CHR$(48)
  compensation_side$=CHR$(48)
  previous_compensation$=CHR$(48)
  rounding_active!=FALSE
  cancel_compensation!=FALSE
  spare_pending_flag!=FALSE
  datum_shift_on!=FALSE
  mirror_x!=FALSE
  mirror_y!=FALSE
  mirror_z!=FALSE
  mirror_reverses_direction!=FALSE
  mirror_x_after_rotation!=TRUE
  mirror_y_after_rotation!=TRUE
  mirror_z_after_rotation!=TRUE
  rotation_active!=FALSE
  rotation_angle=0
  rotation_spare_value=0
  ' no scaling yet
  scaling_active!=FALSE
  scaling_factor=1
  pair_table_made!=FALSE
  rnd_ends_at_corner!=FALSE
  even_depth_bands!=TRUE
  finishing_allowance=0
  previous_allowance=-1
  corner_point_moved!=FALSE
  after_line_element!=FALSE
  arc_pending!=FALSE
  program_has_labels!=FALSE
  pair_table_stride&=0
  current_contour|=FALSE
  function_code|=255
  ' the larger side of the view area, used by simulate_arc_move to find arcs too large to draw as circles
  simulation_view_size=MAX(area_max_h-area_min_h,area_max_v-area_min_v)
  current_block&=0
  current_draw_block&=0
  next_block&=0
  block_after_next&=0
  third_block_ahead&=0
  cycle_start_line&=0
  tool_mark_offsets&(tool_first_axis|)=ROUND(reference_point_x*view_scale)
  tool_mark_offsets&(tool_second_axis|)=ROUND(reference_point_y*view_scale)
  ' start point: plane origin, depth at the top of the blank
  start_point(tool_first_axis|)=0
  start_point(tool_second_axis|)=0
  start_point(depth_axis|)=blank_top
  end_point(1)=start_point(1)
  end_point(2)=start_point(2)
  end_point(3)=start_point(3)
  programmed_position(1)=start_point(1)
  programmed_position(2)=start_point(2)
  programmed_position(3)=start_point(3)
  rotated_position(1)=start_point(1)
  rotated_position(2)=start_point(2)
  rotated_position(3)=start_point(3)
  start_tangent(tool_first_axis|)=0
  start_tangent(tool_second_axis|)=0
  ' rotated frame: unit vectors along the plane axes
  rotated_first_axis(tool_first_axis|)=1
  rotated_first_axis(tool_second_axis|)=0
  datum_first_axis(tool_first_axis|)=1
  datum_first_axis(tool_second_axis|)=0
  rotated_second_axis(tool_first_axis|)=0
  rotated_second_axis(tool_second_axis|)=1
  datum_second_axis(tool_first_axis|)=0
  datum_second_axis(tool_second_axis|)=1
  ARRAYFILL datum_shift(),0
  ARRAYFILL datum_shift_in_plane(),0
  ' no Q parameters, labels or tool definitions yet
  ARRAYFILL q_parameter_defined!(),0
  ARRAYFILL label_blocks&(),0
  ARRAYFILL defined_tools&(),0
  ARRAYFILL label_start_line&(),0
  ARRAYFILL label_end_line&(),0
  ARRAYFILL label_call_flags!(),0
  ARRAYFILL depth_level_heights(),start_point(infeed_axis|)
  parameter_number&=0
  line_index&=0
  REPEAT
    INC line_index&
    program_line$=program_lines$(line_index&)
    IF RIGHT$(program_line$,1)<>"}"
      ' LBL 0: end of a subprogram
      IF LEFT$(program_line$,11)="LBL       0"
        program_has_labels!=TRUE
        label_start_line&(parameter_number&)=main_program_end_line&
        label_end_line&(parameter_number&)=line_index&
      ELSE
        ' LBL n: start of a subprogram if it is called after this point
        IF LEFT$(program_line$,3)="LBL"
          program_has_labels!=TRUE
          outer_label_number&=parameter_number&
          parameter_number&=VAL(MID$(program_line$,11,3))
          label_blocks&(parameter_number&)=line_index&
          search_block&=line_index&
          REPEAT
            INC search_block&
            program_line$=program_lines$(search_block&)
          UNTIL search_block&=last_line& OR ((LEFT$(program_line$,8)="CALL LBL") AND VAL(MID$(program_line$,11,3))=parameter_number& AND (MID$(program_line$,22,2)<>"  "))
          IF search_block&<last_line&
            parameter_number&=outer_label_number&
          ELSE
            main_program_end_line&=line_index&
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  UNTIL line_index&=PRED(last_line&)
  ' the depth levels and legend
  find_depth_levels(program_has_labels!)
  PRINT AT(text_column&+4,prompt_row|);"Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!";
  IF NOT run_aborted!
    check_tool_and_blank
    IF NOT run_aborted!
      ' the tool sprite at the start point when it is inside the view
      ~WIND_GET(window_handle|,10,screen_x&,screen_y&,line_index&,rect_width&)
      IF sprite_shown! AND screen_x&=window_handle|
        IF area_min_v<=start_point(tool_second_axis|) AND area_max_v>=start_point(tool_second_axis|) AND area_min_h<=start_point(tool_first_axis|) AND area_max_h>=start_point(tool_first_axis|)
          screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*start_point(tool_first_axis|))))
          screen_y&=MIN(screen_max_y&,view_offset_y&-ROUND(view_scale*start_point(tool_second_axis|)))
          SPRITE tool_sprite$,screen_x&,screen_y&
        ENDIF
      ENDIF
      DEFTEXT 1,0,0,13
      REPEAT
      UNTIL NOT (INKEY$<>"")
      scaling_active!=FALSE
      scaling_factor=0
      current_block&=0
      stop_requested!=FALSE
      find_lookahead_blocks
      REPEAT
        ON MENU
        function_code|=255
        ' the block and its first characters
        program_line$=program_lines$(current_block&)
        rnd_block_text$=LEFT$(program_line$)
        following_block_text$=LEFT$(program_line$,2)
        lookahead_third_block_text$=LEFT$(program_line$,3)
        line_head_five$=LEFT$(program_line$,5)
        line_head_eight$=LEFT$(program_line$,8)
        line_head_twelve$=LEFT$(program_line$,12)
        line_head_thirteen$=LEFT$(program_line$,13)
        ' the next block and the one after
        next_block_text$=program_lines$(next_block&)
        third_block_text$=program_lines$(block_after_next&)
        ' a continuation line
        IF RIGHT$(program_line$,1)="}"
          line_is_continuation!=TRUE
        ELSE
          line_is_continuation!=FALSE
        ENDIF
        IF MID$(program_line$,7,1)="A"
          line_not_type_a!=FALSE
        ELSE
          line_not_type_a!=TRUE
        ENDIF
        block_correction_letter$=MID$(program_line$,44,1)
        next_correction_letter$=MID$(next_block_text$,44,1)
        ' an M function at the end of the block
        IF LEN(program_line$)>54 AND (NOT line_is_continuation!)
          IF RIGHT$(program_line$,2)<>"  "
            function_code|=VAL(RIGHT$(program_line$,2))
            SELECT function_code|
            CASE 30,2
              stop_requested!=TRUE
              program_end_reached!=TRUE
              IF after_line_element! OR arc_pending! AND (NOT run_aborted!)
                queue_simulated_move(current_block&,"-",-1)
              ENDIF
            CASE 95 TO 98
              ' M95-M98 are not available yet
              ALERT 3,"Die Zusatzfunktionen M95-M98|werden noch nicht unterstÅtzt.|Die Implementierung ist|geplant!",1," Weiter ",alert_button|
            ENDSELECT
          ENDIF
        ENDIF
        ON MENU
        IF line_is_continuation!
        ELSE
          IF (lookahead_third_block_text$="LBL") AND (LEFT$(program_line$,11)<>"LBL       0")
          ELSE
            ' remember where each tool is defined
            IF line_head_eight$="TOOL DEF"
              tool_number|=VAL(MID$(program_line$,11,2))
              IF tool_number|
                defined_tools&(tool_number|)=current_block&
              ENDIF
            ELSE
              ' TOOL CALL: take the tool from the program or the tool table
              IF line_head_eight$="TOOL CAL"
                IF after_line_element!
                  queue_simulated_move(line_index&,"-",-1)
                ELSE
                  IF arc_pending!
                    queue_simulated_move(line_index&,"-",-1)
                  ENDIF
                ENDIF
                tool_number|=VAL(MID$(program_line$,11,2))
                set_plane_for_tool_axis(program_line$,15)
                ' not defined in the program: look in the tool table
                IF defined_tools&(tool_number|)=0
                  IF tool_last_line&>-1
                    search_found!=FALSE
                    tool_search_index&=0
                    REPEAT
                      IF tool_number|=VAL(MID$(tool_memory_lines$(tool_search_index&),11,2))
                        search_found!=TRUE
                      ENDIF
                      INC tool_search_index&
                    UNTIL search_found! OR tool_search_index&=SUCC(tool_last_line&)
                  ELSE
                    search_found!=FALSE
                  ENDIF
                  IF NOT search_found!
                    ALERT 3,"Das Werkzeug "+STR$(tool_number|)+" wurde|nicht definiert!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    error_blocks&(0)=current_block&
                    error_messages$(0)="DAS WERKZEUG WURDE NICHT DEFINIERT!"
                  ELSE
                    work_text$=tool_memory_lines$(PRED(tool_search_index&))
                  ENDIF
                ELSE
                  work_text$=program_lines$(defined_tools&(tool_number|))
                ENDIF
                ' line mode: draw a one-pixel path, keep the real radius
                IF wireframe_view!
                  real_tool_radius=VAL(MID$(work_text$,32,8))
                  real_tool_radius_pixels&=MAX(1,ROUND(real_tool_radius*view_scale))
                  IF MID$(work_text$,31,1)="-"
                    real_tool_radius=-real_tool_radius
                  ENDIF
                  tool_radius_pixels&=1
                  tool_radius=tool_radius_pixels&/view_scale
                ELSE
                  tool_radius=VAL(MID$(work_text$,32,8))
                  tool_radius_pixels&=MAX(1,ROUND(tool_radius*view_scale))
                  IF MID$(work_text$,31,1)="-"
                    tool_radius=-tool_radius
                  ENDIF
                ENDIF
                ' build the tool disc used to draw the path
                IF NOT run_aborted!
                  IF wireframe_view!
                    tool_diameter_pixels|=FALSE
                    stripe_mode|=FALSE
                    ERASE tool_disc_rows&()
                    DIM tool_disc_rows&(1)
                    ARRAYFILL tool_disc_rows&(),0
                  ELSE
                    ' radius up to 20 pixels: no row table
                    IF tool_radius_pixels&<=20
                      tool_diameter_pixels|=tool_radius_pixels&*2
                      stripe_mode|=FALSE
                      ERASE tool_disc_rows&()
                      DIM tool_disc_rows&(1)
                      ARRAYFILL tool_disc_rows&(),0
                    ELSE
                      ' bigger tools: half widths for each row of the disc
                      tool_search_index&=tool_radius_pixels&*2
                      axis_entry_count|=SUCC(tool_search_index& DIV 40)
                      stripe_mode|=axis_entry_count|
                      tool_diameter_pixels|=CINT(tool_search_index&/axis_entry_count|)
                      IF ODD(tool_diameter_pixels|)
                        INC tool_diameter_pixels|
                      ENDIF
                      ERASE tool_disc_rows&()
                      settings_entry|=SHR|(axis_entry_count|,1)
                      DIM tool_disc_rows&(SUCC(settings_entry|))
                      ARRAYFILL tool_disc_rows&(),0
                      DEC settings_entry|
                      FOR loop_index|=FALSE TO settings_entry|
                        tool_disc_rows&(SUCC(loop_index|))=tool_radius_pixels&-(loop_index|*2+1)*tool_diameter_pixels|/2
                      NEXT loop_index|
                    ENDIF
                  ENDIF
                  section_line_width|=SUCC(tool_diameter_pixels|)
                  INC tool_diameter_pixels|
                  ' the view limits including the tool
                  area_min_h=view_min_h-tool_radius
                  area_max_h=view_max_h+tool_radius
                  area_max_v=view_max_v+tool_radius
                  area_min_v=view_min_v-tool_radius
                ENDIF
              ELSE
                ' a line followed by RND: the rounding is worked out with the lines
                IF (LEFT$(third_block_text$,3)="RND") AND (following_block_text$="L ") AND (MID$(following_block_text$,7,1)<>"A") AND ((block_correction_letter$="0") OR ((block_correction_letter$=" ") AND (radius_correction$="0"))) AND (LEFT$(next_block_text$,2)="L ") AND (MID$(next_block_text$,7,1)<>"A") AND ((next_correction_letter$="L") OR (next_correction_letter$="R")) AND (NOT stop_requested!)
                  IF end_point_stored!
                    swap_pending_block(-1,0,0)
                  ELSE
                    read_line_target(program_line$)
                    read_radius_correction(program_line$)
                  ENDIF
                  queue_simulated_move(current_block&,"-",-1)
                  IF NOT run_aborted!
                    current_block&=next_block&
                    next_block&=block_after_next&
                    block_after_next&=third_block_ahead&
                    skip_to_next_block(third_block_ahead&)
                    approach_contour_tangentially(next_block_text$)
                    current_block&=next_block&
                    next_block&=block_after_next&
                    block_after_next&=third_block_ahead&
                    skip_to_next_block(third_block_ahead&)
                  ENDIF
                ELSE
                  ' a block before a RND with radius correction
                  IF (LEFT$(next_block_text$,3)="RND") AND ((block_correction_letter$="L") OR (block_correction_letter$="R") OR ((block_correction_letter$=" ") AND (radius_correction$<>"0"))) AND (LEFT$(third_block_text$,2)="L ") AND (MID$(third_block_text$,7,1)<>"A") AND (MID$(third_block_text$,44,1)="0") AND (NOT stop_requested!)
                    depart_contour_tangentially(program_line$)
                    current_block&=next_block&
                    next_block&=block_after_next&
                    block_after_next&=third_block_ahead&
                    skip_to_next_block(third_block_ahead&)
                  ELSE
                    ' RND after this block
                    IF (LEFT$(next_block_text$,3)="RND") AND (NOT stop_requested!)
                      edit_work_text$=program_lines$(block_after_next&)
                      field_name$=program_lines$(third_block_ahead&)
                      IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND line_not_type_a! AND ((LEFT$(field_name$,2)="LP") OR ((LEFT$(edit_work_text$,2)="L ") AND LEN(edit_work_text$)>20 AND (MID$(edit_work_text$,7,1)<>"A")))
                        round_line_to_line(program_line$)
                      ELSE
                        IF (rnd_block_text$="C") AND (LEFT$(edit_work_text$,1)="C")
                          round_arc_to_arc(program_line$)
                        ELSE
                          IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND line_not_type_a! AND (LEFT$(edit_work_text$,1)="C")
                            round_line_to_arc(program_line$)
                          ELSE
                            IF (rnd_block_text$="C") AND (LEFT$(edit_work_text$,1)="L") AND LEN(edit_work_text$)>20 AND (MID$(edit_work_text$,7,1)<>"A")
                              round_arc_to_line(program_line$)
                            ELSE
                              ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
                              run_aborted!=TRUE
                              error_blocks&(0)=next_block&
                              error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                      current_block&=next_block&
                      next_block&=block_after_next&
                      block_after_next&=third_block_ahead&
                      skip_to_next_block(third_block_ahead&)
                    ELSE
                      ' straight line
                      IF (following_block_text$="L ") AND LEN(program_line$)>20
                        IF line_not_type_a!
                          IF (LEFT$(next_block_text$,2)="L ") AND LEN(next_block_text$)<20
                            chamfer_line_corner(program_line$,0)
                            current_block&=next_block&
                            next_block&=block_after_next&
                            block_after_next&=third_block_ahead&
                            skip_to_next_block(third_block_ahead&)
                          ELSE
                            IF end_point_stored!
                              swap_pending_block(-1,0,0)
                            ELSE
                              read_line_target(program_line$)
                              read_radius_correction(program_line$)
                            ENDIF
                            queue_simulated_move(current_block&,"-",-1)
                          ENDIF
                        ENDIF
                      ELSE
                        ' polar line LP
                        IF following_block_text$="LP"
                          IF (LEFT$(next_block_text$,2)="L ") AND LEN(next_block_text$)<20
                            chamfer_line_corner(program_line$,0)
                            current_block&=next_block&
                            next_block&=block_after_next&
                            block_after_next&=third_block_ahead&
                            skip_to_next_block(third_block_ahead&)
                          ELSE
                            IF end_point_stored!
                              swap_pending_block(-1,0,0)
                            ELSE
                              interpret_polar_line(program_line$)
                            ENDIF
                            IF NOT run_aborted!
                              queue_simulated_move(current_block&,"-",-1)
                            ENDIF
                          ENDIF
                        ELSE
                          ' circle centre CC
                          IF following_block_text$="CC"
                            IF centre_pending!
                              swap_pending_block(0,-1,0)
                            ELSE
                              set_plane_from_centre(program_line$)
                              read_circle_centre(program_line$)
                            ENDIF
                          ELSE
                            ' circle C: find the CC that belongs to it
                            IF following_block_text$="C "
                              IF end_point_stored!
                                swap_pending_block(-1,0,0)
                              ELSE
                                rect_width&=current_block&
                                skip_to_previous_block(rect_width&)
                                IF LEFT$(program_lines$(rect_width&),2)<>"CC"
                                  REPEAT
                                    DEC rect_width&
                                  UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
                                  IF rect_width&>0
                                    set_plane_from_centre(program_lines$(rect_width&))
                                  ENDIF
                                ENDIF
                                read_arc_target(program_line$,9,21)
                                read_radius_correction(program_line$)
                                arc_direction$=@read_arc_direction$(program_line$,33)
                              ENDIF
                              queue_simulated_move(current_block&,arc_direction$,0)
                            ELSE
                              ' polar arc CP without a helix
                              IF (following_block_text$="CP") AND (MID$(program_line$,18,2)="  ")
                                IF end_point_stored!
                                  swap_pending_block(-1,0,0)
                                ELSE
                                  interpret_polar_arc(program_line$)
                                ENDIF
                                IF NOT run_aborted!
                                  queue_simulated_move(current_block&,arc_direction$,0)
                                ENDIF
                              ELSE
                                ' polar arc CP with a helix
                                IF (following_block_text$="CP") AND (MID$(program_line$,18,2)<>"  ") AND (MID$(program_line$,18,2)<>" A")
                                  IF end_point_stored!
                                    swap_pending_block(-1,0,0)
                                  ELSE
                                    interpret_polar_helix(program_line$)
                                  ENDIF
                                  IF NOT run_aborted!
                                    queue_simulated_move(current_block&,arc_direction$,0)
                                  ENDIF
                                ELSE
                                  ' tangential arc CT
                                  IF lookahead_third_block_text$="CT "
                                    IF end_point_stored!
                                      swap_pending_block(-1,0,0)
                                    ELSE
                                      interpret_tangential_arc(program_line$)
                                    ENDIF
                                    IF NOT run_aborted!
                                      queue_simulated_move(current_block&,arc_direction$,0)
                                    ENDIF
                                  ELSE
                                    ' arc with radius CR
                                    IF following_block_text$="CR"
                                      IF end_point_stored!
                                        swap_pending_block(-1,-1,0)
                                      ELSE
                                        interpret_radius_arc(program_line$)
                                      ENDIF
                                      IF NOT run_aborted!
                                        queue_simulated_move(current_block&,arc_direction$,0)
                                      ENDIF
                                    ELSE
                                      ' tangential polar arc CTP
                                      IF lookahead_third_block_text$="CTP"
                                        IF end_point_stored!
                                          swap_pending_block(-1,0,0)
                                        ELSE
                                          interpret_polar_tangential_arc(program_line$)
                                        ENDIF
                                        IF NOT run_aborted!
                                          queue_simulated_move(current_block&,arc_direction$,0)
                                        ENDIF
                                      ELSE
                                        ' CALL LBL with a repeat count
                                        IF line_head_eight$="CALL LBL"
                                          IF VAL(MID$(program_lines$(current_block&),22,4))>0 OR (MID$(program_lines$(current_block&),22,4)="    ")
                                            call_label_block(program_line$)
                                            find_lookahead_blocks
                                          ENDIF
                                        ELSE
                                          ' STOP: wait for Return
                                          IF line_head_five$="STOP "
                                            ~WIND_UPDATE(1)
                                            IF after_line_element!
                                              queue_simulated_move(line_index&,"-",-1)
                                            ELSE
                                              IF arc_pending!
                                                queue_simulated_move(line_index&,"-",-1)
                                              ENDIF
                                            ENDIF
                                            after_line_element!=FALSE
                                            arc_pending!=FALSE
                                            PRINT CHR$(7);
                                            PAUSE 2
                                            PRINT CHR$(7);
                                            ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
                                            DEFFILL ,0,0
                                            PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
                                            DEFFILL ,1,1
                                            PRINT AT(text_column&+16,prompt_row|);"Weiter mit den Tasten >RETURN< oder >ENTER<!";
                                            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                                            redraw_x&=work_x&
                                            redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
                                            redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
                                            redraw_height&=char_cell_height|
                                            window_handle|=W_HAND(#1)
                                            blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                                            graphic_view_stage|=3
                                            ON MENU KEY GOSUB continue_on_return_key
                                            stop_flag_saved!=stop_requested!
                                            ~WIND_UPDATE(0)
                                            REPEAT
                                              ON MENU
                                            UNTIL stop_requested!=TRUE
                                            ~WIND_UPDATE(1)
                                            stop_requested!=stop_flag_saved!
                                            graphic_view_stage|=2
                                            ON MENU KEY GOSUB stop_on_space_key
                                            IF run_continuous!
                                              ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
                                              DEFFILL ,0,0
                                              PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
                                              DEFFILL ,1,1
                                              PRINT AT(text_column&+4,prompt_row|);"Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!";
                                              ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                                              redraw_x&=work_x&
                                              redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
                                              redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
                                              redraw_height&=char_cell_height|
                                              blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                                            ENDIF
                                            ~WIND_UPDATE(0)
                                          ELSE
                                            ' cycle 7: datum shift
                                            IF LEFT$(program_line$,10)="CYCL DEF 7"
                                              cycle_datum_shift
                                            ELSE
                                              ' cycle 8: mirror image
                                              IF LEFT$(program_line$,10)="CYCL DEF 8"
                                                cycle_mirror_image
                                              ELSE
                                                ' cycle 10: rotation
                                                IF LEFT$(program_line$,11)="CYCL DEF 10"
                                                  cycle_rotation
                                                ELSE
                                                  ' cycle 11: scaling
                                                  IF LEFT$(program_line$,11)="CYCL DEF 11"
                                                    apply_scaling_cycle
                                                  ELSE
                                                    ' cycle 14: contour
                                                    IF LEFT$(program_line$,11)="CYCL DEF 14"
                                                      check_contour_cycle
                                                    ELSE
                                                      ' other cycles: remember the start of the definition
                                                      IF line_head_eight$="CYCL DEF"
                                                        IF (MID$(program_line$,12,1)="0") OR (MID$(program_line$,13,1)="0")
                                                          cycle_start_line&=current_block&
                                                        ENDIF
                                                      ELSE
                                                        ' CYCL CALL: run the cycle last defined
                                                        IF line_head_eight$="CYCL CAL"
                                                          IF function_code|=2 OR function_code|=30
                                                            saved_function_code|=function_code|
                                                            function_code|=FALSE
                                                            stop_requested!=FALSE
                                                            simulate_cycle_call
                                                            stop_requested!=TRUE
                                                            function_code|=saved_function_code|
                                                          ELSE
                                                            simulate_cycle_call
                                                          ENDIF
                                                        ELSE
                                                          ' FN 0: assign
                                                          IF line_head_five$="FN 0 "
                                                            rect_width&=VAL(MID$(program_line$,10,3))
                                                            q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)
                                                            q_parameter_defined!(rect_width&)=TRUE
                                                          ELSE
                                                            ' FN 1: add
                                                            IF line_head_five$="FN 1 "
                                                              rect_width&=VAL(MID$(program_line$,10,3))
                                                              q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)+@read_number_or_parameter(program_line$,31)
                                                              q_parameter_defined!(rect_width&)=TRUE
                                                            ELSE
                                                              ' FN 2: subtract
                                                              IF line_head_five$="FN 2 "
                                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                                q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)-@read_number_or_parameter(program_line$,31)
                                                                q_parameter_defined!(rect_width&)=TRUE
                                                              ELSE
                                                                ' FN 3: multiply
                                                                IF line_head_five$="FN 3 "
                                                                  rect_width&=VAL(MID$(program_line$,10,3))
                                                                  q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)*@read_number_or_parameter(program_line$,31)
                                                                  q_parameter_defined!(rect_width&)=TRUE
                                                                ELSE
                                                                  ' FN 4: divide
                                                                  IF line_head_five$="FN 4 "
                                                                    basic_variables=@read_number_or_parameter(program_line$,31)
                                                                    rect_width&=VAL(MID$(program_line$,10,3))
                                                                    IF basic_variables=0
                                                                      ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                      IF alert_button|=1
                                                                        run_aborted!=TRUE
                                                                        error_blocks&(0)=current_block&
                                                                        error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                                      ENDIF
                                                                      q_parameters(rect_width&)=0
                                                                    ELSE
                                                                      q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)/basic_variables
                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                    ENDIF
                                                                  ELSE
                                                                    ' FN 5: square root
                                                                    IF line_head_five$="FN 5 "
                                                                      basic_variables=@read_number_or_parameter(program_line$,22)
                                                                      IF basic_variables<0
                                                                        ALERT 3,"Wurzel aus einer|negativen Zahl|nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                        IF alert_button|=1
                                                                          run_aborted!=TRUE
                                                                          error_blocks&(0)=current_block&
                                                                          error_messages$(0)="WURZEL AUS EINER NEGATIVEN ZAHL NICHT ERLAUBT!"
                                                                        ENDIF
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        q_parameters(rect_width&)=0
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ELSE
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        q_parameters(rect_width&)=SQR(basic_variables)
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ENDIF
                                                                    ELSE
                                                                      ' FN 6: sine
                                                                      IF line_head_five$="FN 6 "
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        q_parameters(rect_width&)=SIN(RAD(@read_number_or_parameter(program_line$,22)))
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ELSE
                                                                        ' FN 7: cosine
                                                                        IF line_head_five$="FN 7 "
                                                                          rect_width&=VAL(MID$(program_line$,10,3))
                                                                          q_parameters(rect_width&)=COS(RAD(@read_number_or_parameter(program_line$,22)))
                                                                          q_parameter_defined!(rect_width&)=TRUE
                                                                        ELSE
                                                                          ' FN 8: root of the sum of squares
                                                                          IF line_head_five$="FN 8 "
                                                                            segment_length=@read_number_or_parameter(program_line$,17)
                                                                            second_operand=@read_number_or_parameter(program_line$,31)
                                                                            rect_width&=VAL(MID$(program_line$,10,3))
                                                                            q_parameters(rect_width&)=SQR(segment_length*segment_length+second_operand*second_operand)
                                                                            q_parameter_defined!(rect_width&)=TRUE
                                                                          ELSE
                                                                            ' FN 9-12: jump to a label if equal, not equal, greater, less
                                                                            IF (line_head_five$="FN 9 ") OR (line_head_five$="FN 10") OR (line_head_five$="FN 11") OR (line_head_five$="FN 12")
                                                                              segment_length=@read_number_or_parameter(program_line$,13)
                                                                              second_operand=@read_number_or_parameter(program_line$,27)
                                                                              IF segment_length=second_operand AND (line_head_five$="FN 9 ") OR (segment_length<>second_operand AND (line_head_five$="FN 10")) OR (segment_length>second_operand AND (line_head_five$="FN 11")) OR (segment_length<second_operand AND (line_head_five$="FN 12"))
                                                                                current_block&=label_blocks&(VAL(MID$(program_line$,45,3)))
                                                                                find_lookahead_blocks
                                                                              ENDIF
                                                                            ELSE
                                                                              ' FN 13: angle from two values
                                                                              IF line_head_five$="FN 13"
                                                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                                                segment_length=@read_number_or_parameter(program_line$,17)
                                                                                second_operand=@read_number_or_parameter(program_line$,31)
                                                                                IF segment_length=0 AND second_operand=0
                                                                                  ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                                  IF alert_button|=1
                                                                                    run_aborted!=TRUE
                                                                                    error_blocks&(0)=current_block&
                                                                                    error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                                                  ENDIF
                                                                                  q_parameters(rect_width&)=0
                                                                                ELSE
                                                                                  IF segment_length=0
                                                                                    q_parameters(rect_width&)=0
                                                                                    q_parameter_defined!(rect_width&)=TRUE
                                                                                  ELSE
                                                                                    IF second_operand=0
                                                                                      q_parameters(rect_width&)=DEG(ASIN(segment_length))
                                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                                    ELSE
                                                                                      q_parameters(rect_width&)=ATN(segment_length/second_operand)
                                                                                      q_parameters(rect_width&)=DEG(q_parameters(rect_width&))
                                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                                    ENDIF
                                                                                  ENDIF
                                                                                ENDIF
                                                                              ELSE
                                                                                IF line_head_five$="FN 14"
                                                                                ELSE
                                                                                  ' FN 15: print
                                                                                  IF line_head_five$="FN 15"
                                                                                    show_fn15_values(program_line$)
                                                                                  ENDIF
                                                                                ENDIF
                                                                              ENDIF
                                                                            ENDIF
                                                                          ENDIF
                                                                        ENDIF
                                                                      ENDIF
                                                                    ENDIF
                                                                  ENDIF
                                                                ENDIF
                                                              ENDIF
                                                            ENDIF
                                                          ENDIF
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ENDIF
                                                ENDIF
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                        ENDIF
                                      ENDIF
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' M00 or M06 (not on STOP): wait for Return
        IF function_code|=0 OR function_code|=6 AND (line_head_five$<>"STOP ")
          ~WIND_UPDATE(1)
          IF after_line_element!
            queue_simulated_move(line_index&,"-",-1)
          ELSE
            IF arc_pending!
              queue_simulated_move(line_index&,"-",-1)
            ENDIF
          ENDIF
          after_line_element!=FALSE
          arc_pending!=FALSE
          PRINT CHR$(7);
          PAUSE 2
          PRINT CHR$(7);
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          DEFFILL ,0,0
          PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
          DEFFILL ,1,1
          PRINT AT(text_column&+16,prompt_row|);"Weiter mit den Tasten >RETURN< oder >ENTER<!";
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          redraw_x&=work_x&
          redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
          redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
          redraw_height&=char_cell_height|
          window_handle|=W_HAND(#1)
          blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
          graphic_view_stage|=3
          ON MENU KEY GOSUB continue_on_return_key
          ~WIND_UPDATE(0)
          REPEAT
            ON MENU
          UNTIL stop_requested!=TRUE
          ~WIND_UPDATE(1)
          graphic_view_stage|=2
          ON MENU KEY GOSUB stop_on_space_key
          stop_requested!=FALSE
          IF run_continuous!
            ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
            DEFFILL ,0,0
            PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
            DEFFILL ,1,1
            PRINT AT(text_column&+4,prompt_row|);"Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!";
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
            redraw_x&=work_x&
            redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
            redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
            redraw_height&=char_cell_height|
            blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
          ENDIF
          ~WIND_UPDATE(0)
        ENDIF
        ON MENU
        ' on to the next block
        line_index&=current_block&
        current_block&=next_block&
        next_block&=block_after_next&
        block_after_next&=third_block_ahead&
        skip_to_next_block(third_block_ahead&)
        ON MENU
        ' until the program end, Space or an error
      UNTIL current_block&=last_line& OR stop_requested! OR run_aborted!
      ' remove the last tool drawing
      IF after_line_element! OR arc_pending! AND (NOT run_aborted!) AND (program_end_reached! OR current_block&=last_line&)
        queue_simulated_move(last_line&,"-",-1)
      ENDIF
    ENDIF
    ' the editor shows the line where the run ended
    top_line&=cursor_line&-half_visible_lines&
    IF top_line&<0
      top_line&=0
    ENDIF
    IF drawn_cursor_line&=-2
      DEC drawn_cursor_line&
    ELSE
      drawn_cursor_line&=-2
    ENDIF
    ~FRE(0)
    ' take the tool sprite off
    ~WIND_GET(window_handle|,10,screen_x&,screen_y&,line_index&,rect_width&)
    IF sprite_shown! AND screen_x&=window_handle|
      SPRITE tool_sprite$
    ENDIF
    GRAPHMODE 1
    ~WIND_UPDATE(1)
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    DEFFILL ,0,0
    PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|+5
    DEFFILL ,1,1
    PRINT AT(text_column&+17,prompt_row|);"Die Simulation ist fertig! Weiter mit Taste !";
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    redraw_x&=work_x&
    redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
    redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
    redraw_height&=char_cell_height|+5
    window_handle|=W_HAND(#1)
    blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
    ~WIND_UPDATE(0)
  ENDIF
  REPEAT
  UNTIL NOT (INKEY$<>"")
  DEFFILL 0,1,1
RETURN
' ON MENU KEY GOSUB handler during the simulation: Space (scan code 57) stops it.
PROCEDURE stop_on_space_key
  ' scan code of the key
  key_scan_code&=SHR(MENU(14),8)
  IF key_scan_code&=57
    stop_requested!=TRUE
  ENDIF
RETURN
' ON MENU KEY GOSUB handler while the simulation is paused: Return or Enter (scan codes 28/114) continues.
PROCEDURE continue_on_return_key
  ' scan code of the key
  key_scan_code&=SHR(MENU(14),8)
  IF key_scan_code&=28 OR key_scan_code&=114
    stop_requested!=TRUE
  ENDIF
RETURN
' Reads the target point of a straight line block program_line$ into end_point(): for each axis the value at
' column axis_value_columns|() (a number, or Qn for a parameter), signed, scaled when cycle 11 is active and
' made absolute when marked I (incremental). Without mirroring or rotation the datum shift datum_shift() is
' added; otherwise the point is mirrored, rotated by rotation_angle and mapped through the rotated frame
' rotated_position()/rotated_first_axis()/rotated_second_axis() for the active tool axis. programmed_position()
' keeps the programmed position.
PROCEDURE read_line_target(program_line$)
  LOCAL parse_axis|,parse_column|,parsed_value,x_axis_flag!,y_axis_flag!,z_axis_flag!,x_incremental!,y_incremental!,z_incremental!,angle_offset,rotate_length,point_distance,work_point_y,parameter_number&,third_block_text$,alert_button|
  ON MENU
  ' no mirroring or rotation active
  IF (NOT rotation_active!) AND (NOT datum_shift_on!)
    x_axis_flag!=FALSE
    y_axis_flag!=FALSE
    FOR parse_axis|=1 TO 3
      ' column of the axis value
      parse_column|=axis_value_columns|(parse_axis|)
      ' axis not given: keep the programmed position
      IF MID$(program_line$,parse_column|-2,1)=" "
        end_point(parse_axis|)=programmed_position(parse_axis|)
        IF parse_axis|=tool_first_axis|
          x_axis_flag!=TRUE
        ENDIF
        IF parse_axis|=tool_second_axis|
          y_axis_flag!=TRUE
        ENDIF
      ELSE
        ' a Q parameter
        IF MID$(program_line$,parse_column|,1)="Q"
          parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
          IF q_parameter_defined!(parameter_number&)
            parsed_value=q_parameters(parameter_number&)
          ELSE
            parsed_value=1
            third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
            ALERT 3,third_block_text$,1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=current_block&
            error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
          ENDIF
        ELSE
          parsed_value=VAL(MID$(program_line$,parse_column|,11))
        ENDIF
        DEC parse_column|
        IF MID$(program_line$,parse_column|,1)="-"
          parsed_value=-parsed_value
        ENDIF
        ' cycle 11 scaling
        IF scaling_active!
          MUL parsed_value,scaling_factor
        ENDIF
        SUB parse_column|,2
        ' incremental
        IF MID$(program_line$,parse_column|,1)="I"
          parsed_value=parsed_value+programmed_position(parse_axis|)
        ENDIF
        end_point(parse_axis|)=parsed_value
      ENDIF
    NEXT parse_axis|
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    rotated_position(tool_first_axis|)=end_point(tool_first_axis|)
    rotated_position(tool_second_axis|)=end_point(tool_second_axis|)
    ' datum shift
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    ' neither plane axis given: take off the one-block offset
    IF x_axis_flag! AND y_axis_flag!
      SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
      SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
    ENDIF
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
  ELSE
    ' with mirroring or rotation
    x_incremental!=FALSE
    y_incremental!=FALSE
    z_incremental!=FALSE
    x_axis_flag!=FALSE
    y_axis_flag!=FALSE
    z_axis_flag!=FALSE
    FOR parse_axis|=1 TO 3
      parse_column|=axis_value_columns|(parse_axis|)
      IF MID$(program_line$,parse_column|-2,1)=" "
        IF parse_axis|=1
          x_axis_flag!=TRUE
        ELSE
          IF parse_axis|=2
            y_axis_flag!=TRUE
          ELSE
            z_axis_flag!=TRUE
          ENDIF
        ENDIF
        end_point(parse_axis|)=0
      ELSE
        IF MID$(program_line$,parse_column|,1)="Q"
          parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
          IF q_parameter_defined!(parameter_number&)
            parsed_value=q_parameters(parameter_number&)
          ELSE
            parsed_value=1
            third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
            ALERT 3,third_block_text$,1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=current_block&
            error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
          ENDIF
        ELSE
          parsed_value=VAL(MID$(program_line$,parse_column|,11))
        ENDIF
        DEC parse_column|
        IF MID$(program_line$,parse_column|,1)="-"
          parsed_value=-parsed_value
        ENDIF
        IF scaling_active!
          MUL parsed_value,scaling_factor
        ENDIF
        SUB parse_column|,2
        IF MID$(program_line$,parse_column|,1)="I"
          IF parse_axis|=1
            x_incremental!=TRUE
          ELSE
            IF parse_axis|=2
              y_incremental!=TRUE
            ELSE
              z_incremental!=TRUE
            ENDIF
          ENDIF
        ENDIF
        end_point(parse_axis|)=parsed_value
      ENDIF
    NEXT parse_axis|
    block_input_values(1)=end_point(1)
    block_input_values(2)=end_point(2)
    block_input_values(3)=end_point(3)
    ' mirror axes that are mirrored before the rotation
    IF mirror_x! AND (NOT mirror_x_after_rotation!)
      end_point(1)=-end_point(1)
    ENDIF
    IF mirror_y! AND (NOT mirror_y_after_rotation!)
      end_point(2)=-end_point(2)
    ENDIF
    IF mirror_z! AND (NOT mirror_z_after_rotation!)
      end_point(3)=-end_point(3)
    ENDIF
    ' rotation by rotation_angle around the origin
    IF rotation_active!
      point_distance=end_point(tool_first_axis|)
      work_point_y=end_point(tool_second_axis|)
      IF point_distance<>0 OR work_point_y<>0
        rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
        angle_offset=point_distance/rotate_length
        angle_offset=@clamped_arc_cosine(angle_offset)
        IF work_point_y<0
          angle_offset=two_pi-angle_offset
        ENDIF
        angle_offset=angle_offset+rotation_angle
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
        end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
      ENDIF
    ENDIF
    ' mirror axes that are mirrored after the rotation
    IF mirror_x! AND mirror_x_after_rotation!
      end_point(1)=-end_point(1)
    ENDIF
    IF mirror_y! AND mirror_y_after_rotation!
      end_point(2)=-end_point(2)
    ENDIF
    IF mirror_z! AND mirror_z_after_rotation!
      end_point(3)=-end_point(3)
    ENDIF
    SELECT tool_axis|
    CASE 3
      IF x_incremental! OR x_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    CASE 2
      IF z_incremental! OR z_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    DEFAULT
      IF y_incremental! OR y_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    ENDSELECT
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    IF x_axis_flag! AND y_axis_flag! AND tool_axis|=3 OR (x_axis_flag! AND z_axis_flag! AND tool_axis|=2) OR (y_axis_flag! AND z_axis_flag! AND tool_axis|=1)
      SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
      SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
    ENDIF
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
  ENDIF
  datum_shift_change(1)=0
  datum_shift_change(2)=0
  datum_shift_change(3)=0
  ON MENU
RETURN
' Adds a generated straight line block "L X.. Y.. Z.." to the list offset_contour_elements$(current_contour|,..)
' for the point (point_distance,work_point_y) in the plane axes first_plane_axis|/second_plane_axis|: each value
' is written right-aligned with 5 decimals; values above 9999.99999 give "Koordinaten sind fehlerhaft"
' (coordinates wrong). The feed and M function of line line_index& are kept.
PROCEDURE store_generated_line(line_index&,point_distance,work_point_y)
  LOCAL generated_line_block$,file_byte|,loop_index|,item_count&,inner_index|,parsed_value,edit_work_text$,input_text$,work_text$,is_finished!,angle_offset,field_text_length|,alert_button|
  corner_point(first_plane_axis|)=point_distance
  corner_point(second_plane_axis|)=work_point_y
  ' keep the feed and M function of the block
  IF LEN(program_lines$(line_index&))>50
    generated_line_block$="L     X+   0.00000Y+   0.00000Z+   0.00000"+RIGHT$(program_lines$(line_index&),14)
  ELSE
    generated_line_block$="L     X+   0.00000Y+   0.00000Z+   0.00000R   F      M  "
  ENDIF
  loop_index|=FALSE
  inner_index|=first_plane_axis|
  REPEAT
    INC loop_index|
    parsed_value=ROUND(corner_point(inner_index|)*100000)/100000
    ' too big for the block format
    IF parsed_value>9999.99999
      ALERT 3,"Koordinaten|sind fehlerhaft!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=current_draw_block&
      error_messages$(0)="KOORDINATEN SIND FEHLERHAFT!"
    ELSE
      IF parsed_value>=0
        edit_work_text$=CHR$(43)
      ELSE
        edit_work_text$=CHR$(45)
      ENDIF
      file_byte|=FALSE
      input_text$=STR$(parsed_value)
      field_text_length|=LEN(input_text$)
      REPEAT
        INC file_byte|
      UNTIL (MID$(input_text$,file_byte|,1)=".") OR file_byte|=field_text_length|
      IF file_byte|=field_text_length|
        work_text$=".00000"
      ELSE
        work_text$=STRING$(file_byte|+(5-field_text_length|),48)
      ENDIF
      ' right-align the value in 11 characters
      is_finished!=FALSE
      angle_offset=ABS(parsed_value)
      IF parsed_value=0
        edit_work_text$=edit_work_text$+"   0.00000"
      ELSE
        IF angle_offset>1
          item_count&=3
          REPEAT
            IF angle_offset>=10^item_count&
              edit_work_text$=edit_work_text$+SPACE$(3-item_count&)+STR$(angle_offset)+work_text$
              is_finished!=TRUE
            ENDIF
            DEC item_count&
          UNTIL item_count&=-1 OR is_finished!
        ELSE
          edit_work_text$=edit_work_text$+"   "+STR$(angle_offset)+work_text$
        ENDIF
      ENDIF
      MID$(generated_line_block$,PRED(axis_value_columns|(inner_index|)),11)=(edit_work_text$)
    ENDIF
    inner_index|=second_plane_axis|
  UNTIL loop_index|=2 OR run_aborted!
  MID$(generated_line_block$,axis_value_columns|(infeed_axis|)-2,12)=("            ")
  MID$(generated_line_block$,44,1)=(" ")
  offset_contour_elements$(current_contour|,path_line_index&)=generated_line_block$
  INC path_line_index&
RETURN
' Reads the two plane coordinates of an arc end point from columns axis_column| and other_axis_column| of block
' program_line$ into end_point(), the same way as read_line_target (parameters, sign, scaling, incremental,
' mirror, rotation, datum shift).
PROCEDURE read_arc_target(program_line$,axis_column|,other_axis_column|)
  LOCAL parse_axis|,parse_column|,parsed_value,x_axis_flag!,y_axis_flag!,z_axis_flag!,x_incremental!,y_incremental!,z_incremental!,angle_offset,rotate_length,point_distance,work_point_y,loop_index|,parameter_number&,third_block_text$,alert_button|
  ON MENU
  parse_column|=axis_column|
  ' no mirroring or rotation active
  IF (NOT rotation_active!) AND (NOT datum_shift_on!)
    end_point(infeed_axis|)=programmed_position(infeed_axis|)
    FOR loop_index|=1 TO 2
      axis_from_letter(program_line$,parse_column|-2,parse_axis|)
      IF MID$(program_line$,parse_column|,1)="Q"
        parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
        IF q_parameter_defined!(parameter_number&)
          parsed_value=q_parameters(parameter_number&)
        ELSE
          parsed_value=1
          third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
          ALERT 3,third_block_text$,1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=current_block&
          error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
        ENDIF
      ELSE
        parsed_value=VAL(MID$(program_line$,parse_column|,11))
      ENDIF
      DEC parse_column|
      IF MID$(program_line$,parse_column|,1)="-"
        parsed_value=-parsed_value
      ENDIF
      IF scaling_active!
        MUL parsed_value,scaling_factor
      ENDIF
      SUB parse_column|,2
      IF MID$(program_line$,parse_column|,1)="I"
        parsed_value=parsed_value+programmed_position(parse_axis|)
      ENDIF
      end_point(parse_axis|)=parsed_value
      parse_column|=other_axis_column|
    NEXT loop_index|
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    rotated_position(tool_first_axis|)=end_point(tool_first_axis|)
    rotated_position(tool_second_axis|)=end_point(tool_second_axis|)
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
  ELSE
    x_incremental!=FALSE
    y_incremental!=FALSE
    z_incremental!=FALSE
    x_axis_flag!=TRUE
    y_axis_flag!=TRUE
    z_axis_flag!=TRUE
    end_point(tool_first_axis|)=0
    end_point(tool_second_axis|)=0
    end_point(depth_axis|)=0
    FOR loop_index|=1 TO 2
      axis_from_letter(program_line$,parse_column|-2,parse_axis|)
      IF parse_axis|=1
        x_axis_flag!=FALSE
      ELSE
        IF parse_axis|=2
          y_axis_flag!=FALSE
        ELSE
          IF parse_axis|=3
            z_axis_flag!=FALSE
          ENDIF
        ENDIF
      ENDIF
      IF MID$(program_line$,parse_column|,1)="Q"
        parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
        IF q_parameter_defined!(parameter_number&)
          parsed_value=q_parameters(parameter_number&)
        ELSE
          parsed_value=1
          third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
          ALERT 3,third_block_text$,1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=current_block&
          error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
        ENDIF
      ELSE
        parsed_value=VAL(MID$(program_line$,parse_column|,11))
      ENDIF
      DEC parse_column|
      IF MID$(program_line$,parse_column|,1)="-"
        parsed_value=-parsed_value
      ENDIF
      IF scaling_active!
        MUL parsed_value,scaling_factor
      ENDIF
      SUB parse_column|,2
      IF MID$(program_line$,parse_column|,1)="I"
        IF parse_axis|=1
          x_incremental!=TRUE
        ELSE
          IF parse_axis|=2
            y_incremental!=TRUE
          ELSE
            IF parse_axis|=3
              z_incremental!=TRUE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      end_point(parse_axis|)=parsed_value
      parse_column|=other_axis_column|
    NEXT loop_index|
    block_input_values(1)=end_point(1)
    block_input_values(2)=end_point(2)
    block_input_values(3)=end_point(3)
    IF mirror_x! AND (NOT mirror_x_after_rotation!)
      end_point(1)=-end_point(1)
    ENDIF
    IF mirror_y! AND (NOT mirror_y_after_rotation!)
      end_point(2)=-end_point(2)
    ENDIF
    IF mirror_z! AND (NOT mirror_z_after_rotation!)
      end_point(3)=-end_point(3)
    ENDIF
    IF rotation_active!
      point_distance=end_point(tool_first_axis|)
      work_point_y=end_point(tool_second_axis|)
      IF point_distance<>0 OR work_point_y<>0
        rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
        angle_offset=point_distance/rotate_length
        angle_offset=@clamped_arc_cosine(angle_offset)
        IF work_point_y<0
          angle_offset=two_pi-angle_offset
        ENDIF
        angle_offset=angle_offset+rotation_angle
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
        end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
      ENDIF
    ENDIF
    IF mirror_x! AND mirror_x_after_rotation!
      end_point(1)=-end_point(1)
    ENDIF
    IF mirror_y! AND mirror_y_after_rotation!
      end_point(2)=-end_point(2)
    ENDIF
    IF mirror_z! AND mirror_z_after_rotation!
      end_point(3)=-end_point(3)
    ENDIF
    SELECT tool_axis|
    CASE 3
      IF x_incremental! OR x_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    CASE 2
      IF z_incremental! OR z_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    DEFAULT
      IF y_incremental! OR y_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD rotated_position(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        rotated_position(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD end_point(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD end_point(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD rotated_position(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        rotated_position(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD end_point(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    ENDSELECT
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
  ENDIF
  datum_shift_change(1)=0
  datum_shift_change(2)=0
  datum_shift_change(3)=0
  ON MENU
RETURN
' Reads the circle centre of a CC block program_line$ (columns 9 and 21) into circle_centre(), the same way as
' read_line_target.
PROCEDURE read_circle_centre(program_line$)
  LOCAL parse_axis|,parse_column|,parsed_value,x_axis_flag!,y_axis_flag!,z_axis_flag!,x_incremental!,y_incremental!,z_incremental!,angle_offset,rotate_length,loop_index|,parameter_number&,third_block_text$,alert_button|
  ON MENU
  parse_column|=9
  ' no mirroring or rotation active
  IF (NOT rotation_active!) AND (NOT datum_shift_on!)
    FOR loop_index|=1 TO 2
      axis_from_letter(program_line$,parse_column|-2,parse_axis|)
      IF MID$(program_line$,parse_column|,1)="Q"
        parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
        IF q_parameter_defined!(parameter_number&)
          parsed_value=q_parameters(parameter_number&)
        ELSE
          parsed_value=1
          third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
          ALERT 3,third_block_text$,1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=current_block&
          error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
        ENDIF
      ELSE
        parsed_value=VAL(MID$(program_line$,parse_column|,11))
      ENDIF
      DEC parse_column|
      IF MID$(program_line$,parse_column|,1)="-"
        parsed_value=-parsed_value
      ENDIF
      IF scaling_active!
        MUL parsed_value,scaling_factor
      ENDIF
      SUB parse_column|,2
      IF MID$(program_line$,parse_column|,1)="I"
        parsed_value=parsed_value+programmed_position(parse_axis|)
      ENDIF
      circle_centre(parse_axis|)=parsed_value
      parse_column|=21
    NEXT loop_index|
    ADD circle_centre(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD circle_centre(tool_second_axis|),datum_shift(tool_second_axis|)
    ADD circle_centre(depth_axis|),datum_shift(depth_axis|)
  ELSE
    x_incremental!=FALSE
    y_incremental!=FALSE
    z_incremental!=FALSE
    x_axis_flag!=TRUE
    y_axis_flag!=TRUE
    z_axis_flag!=TRUE
    circle_centre(tool_first_axis|)=0
    circle_centre(tool_second_axis|)=0
    circle_centre(depth_axis|)=0
    FOR loop_index|=1 TO 2
      axis_from_letter(program_line$,parse_column|-2,parse_axis|)
      IF parse_axis|=tool_first_axis|
        x_axis_flag!=FALSE
      ELSE
        IF parse_axis|=tool_second_axis|
          y_axis_flag!=FALSE
        ELSE
          IF parse_axis|=depth_axis|
            z_axis_flag!=FALSE
          ENDIF
        ENDIF
      ENDIF
      IF MID$(program_line$,parse_column|,1)="Q"
        parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
        IF q_parameter_defined!(parameter_number&)
          parsed_value=q_parameters(parameter_number&)
        ELSE
          parsed_value=1
          third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
          ALERT 3,third_block_text$,1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=current_block&
          error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
        ENDIF
      ELSE
        parsed_value=VAL(MID$(program_line$,parse_column|,11))
      ENDIF
      DEC parse_column|
      IF MID$(program_line$,parse_column|,1)="-"
        parsed_value=-parsed_value
      ENDIF
      IF scaling_active!
        MUL parsed_value,scaling_factor
      ENDIF
      SUB parse_column|,2
      IF MID$(program_line$,parse_column|,1)="I"
        IF parse_axis|=tool_first_axis|
          x_incremental!=TRUE
        ELSE
          IF parse_axis|=tool_second_axis|
            y_incremental!=TRUE
          ELSE
            IF parse_axis|=depth_axis|
              z_incremental!=TRUE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      circle_centre(parse_axis|)=parsed_value
      parse_column|=21
    NEXT loop_index|
    IF mirror_x! AND (NOT mirror_x_after_rotation!)
      circle_centre(1)=-circle_centre(1)
    ENDIF
    IF mirror_y! AND (NOT mirror_y_after_rotation!)
      circle_centre(2)=-circle_centre(2)
    ENDIF
    IF mirror_z! AND (NOT mirror_z_after_rotation!)
      circle_centre(3)=-circle_centre(3)
    ENDIF
    IF rotation_active!
      point_distance=circle_centre(tool_first_axis|)
      work_point_y=circle_centre(tool_second_axis|)
      IF point_distance<>0 OR work_point_y<>0
        rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
        angle_offset=point_distance/rotate_length
        angle_offset=@clamped_arc_cosine(angle_offset)
        IF work_point_y<0
          angle_offset=two_pi-angle_offset
        ENDIF
        angle_offset=angle_offset+rotation_angle
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        circle_centre(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
        circle_centre(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
      ENDIF
    ENDIF
    IF mirror_x! AND mirror_x_after_rotation!
      circle_centre(1)=-circle_centre(1)
    ENDIF
    IF mirror_y! AND mirror_y_after_rotation!
      circle_centre(2)=-circle_centre(2)
    ENDIF
    IF mirror_z! AND mirror_z_after_rotation!
      circle_centre(3)=-circle_centre(3)
    ENDIF
    SELECT tool_axis|
    CASE 3
      IF x_incremental! OR x_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD circle_centre(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    CASE 2
      IF z_incremental! OR z_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD circle_centre(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    DEFAULT
      IF y_incremental! OR y_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD circle_centre(tool_first_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD circle_centre(tool_second_axis|),rotated_position(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD circle_centre(depth_axis|),programmed_position(depth_axis|)
      ENDIF
    ENDSELECT
    ADD circle_centre(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD circle_centre(tool_second_axis|),datum_shift(tool_second_axis|)
    ADD circle_centre(depth_axis|),datum_shift(depth_axis|)
  ENDIF
  ON MENU
RETURN
' Adds a generated arc to the list offset_contour_elements$(current_contour|,..): a CC block for the centre
' (point_u,point_v) and a C block for the end point (point_distance,work_point_y) with direction
' rnd_arc_direction$, in the plane axes first_plane_axis|/second_plane_axis|.
PROCEDURE store_generated_arc(line_index&,point_distance,work_point_y,point_u,point_v,rnd_arc_direction$)
  LOCAL generated_line_block$,generated_arc_block$,loop_index|,inner_index|,parsed_value,edit_work_text$,item_count&,input_text$,work_text$,is_finished!,angle_offset,parse_column|,file_byte|,field_text_length|,alert_button|
  corner_point(first_plane_axis|)=point_distance
  corner_point(second_plane_axis|)=work_point_y
  element_start_point(first_plane_axis|)=point_u
  element_start_point(second_plane_axis|)=point_v
  ' the plane letters of the CC and C blocks
  IF first_plane_axis|=1
    generated_line_block$="CC    X+   0.00000Y+   0.00000"
    generated_arc_block$="C     X+   0.00000Y+   0.00000DR"+rnd_arc_direction$+"         R   F      M  "
  ELSE
    IF first_plane_axis|=2
      generated_line_block$="CC    Y+   0.00000Z+   0.00000"
      generated_arc_block$="C     Y+   0.00000Z+   0.00000DR"+rnd_arc_direction$+"         R   F      M  "
    ELSE
      generated_line_block$="CC    Z+   0.00000X+   0.00000"
      generated_arc_block$="C     Z+   0.00000X+   0.00000DR"+rnd_arc_direction$+"         R   F      M  "
    ENDIF
  ENDIF
  loop_index|=first_plane_axis|
  inner_index|=FALSE
  parse_column|=9
  REPEAT
    INC inner_index|
    parsed_value=ROUND(element_start_point(loop_index|)*100000)/100000
    IF parsed_value>9999.99999
      ALERT 3,"Koordinaten|sind fehlerhaft!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=line_index&
      error_messages$(0)="KOORDINATEN SIND FEHLERHAFT!"
    ELSE
      IF parsed_value>=0
        edit_work_text$=CHR$(43)
      ELSE
        edit_work_text$=CHR$(45)
      ENDIF
      file_byte|=FALSE
      input_text$=STR$(parsed_value)
      field_text_length|=LEN(input_text$)
      REPEAT
        INC file_byte|
      UNTIL (MID$(input_text$,file_byte|,1)=".") OR file_byte|=field_text_length|
      IF file_byte|=field_text_length|
        work_text$=".00000"
      ELSE
        work_text$=STRING$(file_byte|+(5-field_text_length|),48)
      ENDIF
      is_finished!=FALSE
      angle_offset=ABS(parsed_value)
      IF parsed_value=0
        edit_work_text$=edit_work_text$+"   0.00000"
      ELSE
        IF angle_offset>1
          item_count&=3
          REPEAT
            IF angle_offset>=10^item_count&
              edit_work_text$=edit_work_text$+SPACE$(3-item_count&)+STR$(angle_offset)+work_text$
              is_finished!=TRUE
            ENDIF
            DEC item_count&
          UNTIL item_count&=-1 OR is_finished!
        ELSE
          edit_work_text$=edit_work_text$+"   "+STR$(angle_offset)+work_text$
        ENDIF
      ENDIF
      MID$(generated_line_block$,PRED(parse_column|),11)=(edit_work_text$)
    ENDIF
    parse_column|=21
    loop_index|=second_plane_axis|
  UNTIL inner_index|=2 OR run_aborted!
  offset_contour_elements$(current_contour|,path_line_index&)=generated_line_block$
  INC path_line_index&
  loop_index|=first_plane_axis|
  inner_index|=FALSE
  parse_column|=9
  REPEAT
    INC inner_index|
    parsed_value=ROUND(corner_point(loop_index|)*100000)/100000
    IF parsed_value>9999.99999
      ALERT 3,"Koordinaten|sind fehlerhaft!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=line_index&
      error_messages$(0)="KOORDINATEN SIND FEHLERHAFT!"
    ELSE
      IF parsed_value>=0
        edit_work_text$=CHR$(43)
      ELSE
        edit_work_text$=CHR$(45)
      ENDIF
      file_byte|=FALSE
      input_text$=STR$(parsed_value)
      field_text_length|=LEN(input_text$)
      REPEAT
        INC file_byte|
      UNTIL (MID$(input_text$,file_byte|,1)=".") OR file_byte|=field_text_length|
      IF file_byte|=field_text_length|
        work_text$=".00000"
      ELSE
        work_text$=STRING$(file_byte|+(5-field_text_length|),48)
      ENDIF
      is_finished!=FALSE
      angle_offset=ABS(parsed_value)
      IF parsed_value=0
        edit_work_text$=edit_work_text$+"   0.00000"
      ELSE
        IF angle_offset>1
          item_count&=3
          REPEAT
            IF angle_offset>=10^item_count&
              edit_work_text$=edit_work_text$+SPACE$(3-item_count&)+STR$(angle_offset)+work_text$
              is_finished!=TRUE
            ENDIF
            DEC item_count&
          UNTIL item_count&=-1 OR is_finished!
        ELSE
          edit_work_text$=edit_work_text$+"   "+STR$(angle_offset)+work_text$
        ENDIF
      ENDIF
      MID$(generated_arc_block$,PRED(parse_column|),11)=(edit_work_text$)
    ENDIF
    parse_column|=21
    loop_index|=second_plane_axis|
  UNTIL inner_index|=2 OR run_aborted!
  MID$(generated_arc_block$,44,1)=(" ")
  offset_contour_elements$(current_contour|,path_line_index&)=generated_arc_block$
  INC path_line_index&
RETURN
' Returns in parse_axis| the axis number (1 X, 2 Y, 3 Z) of the letter at column parse_column| of program_line$.
PROCEDURE axis_from_letter(program_line$,parse_column|,VAR parse_axis|)
  LOCAL work_text$
  work_text$=MID$(program_line$,parse_column|,1)
  IF work_text$="X"
    parse_axis|=1
  ELSE
    IF work_text$="Y"
      parse_axis|=2
    ELSE
      IF work_text$="Z"
        parse_axis|=3
      ENDIF
    ENDIF
  ENDIF
RETURN
' Sets the circle plane first_plane_axis|/second_plane_axis| and the third axis infeed_axis| from the spindle
' axis letter at column parse_column|.
PROCEDURE set_plane_for_tool_axis(program_line$,parse_column|)
  LOCAL work_text$
  ON MENU
  work_text$=MID$(program_line$,parse_column|,1)
  IF work_text$="X"
    first_plane_axis|=2
    second_plane_axis|=3
    infeed_axis|=1
  ELSE
    IF work_text$="Y"
      first_plane_axis|=3
      second_plane_axis|=1
      infeed_axis|=2
    ELSE
      first_plane_axis|=1
      second_plane_axis|=2
      infeed_axis|=3
    ENDIF
  ENDIF
RETURN
' Sets the circle plane first_plane_axis|/second_plane_axis| and the third axis infeed_axis| from the two axis
' letters of a CC block.
PROCEDURE set_plane_from_centre(program_line$)
  LOCAL work_text$,edit_work_text$
  ON MENU
  work_text$=MID$(program_line$,7,1)
  edit_work_text$=MID$(program_line$,19,1)
  IF (work_text$="X") AND (edit_work_text$="Y") OR ((work_text$="Y") AND (edit_work_text$="X"))
    first_plane_axis|=1
    second_plane_axis|=2
    infeed_axis|=3
  ELSE
    IF (work_text$="Y") AND (edit_work_text$="Z") OR ((work_text$="Z") AND (edit_work_text$="Y"))
      first_plane_axis|=2
      second_plane_axis|=3
      infeed_axis|=1
    ELSE
      first_plane_axis|=3
      second_plane_axis|=1
      infeed_axis|=2
    ENDIF
  ENDIF
RETURN
$F<
' Returns the number at column parse_column| of block program_line$, or the Q parameter there (an undefined one
' gives an error and 1); the sign is taken from the column before and the scaling factor of cycle 11 applied.
FUNCTION read_number_or_parameter(program_line$,parse_column|)
  LOCAL arc_radius,parameter_number&,third_block_text$,alert_button|
  ON MENU
  ' Qn: a parameter
  IF MID$(program_line$,parse_column|,1)="Q"
    parameter_number&=VAL(MID$(program_line$,SUCC(parse_column|),3))
    ' defined?
    IF q_parameter_defined!(parameter_number&)
      arc_radius=q_parameters(parameter_number&)
    ELSE
      arc_radius=1
      third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
      ALERT 3,third_block_text$,1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=current_block&
      error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
    ENDIF
    DEC parse_column|
  ELSE
    IF MID$(program_line$,SUCC(parse_column|),1)="Q"
      parameter_number&=VAL(MID$(program_line$,parse_column|+2,3))
      IF q_parameter_defined!(parameter_number&)
        arc_radius=q_parameters(parameter_number&)
      ELSE
        arc_radius=1
        third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
        ALERT 3,third_block_text$,1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=current_block&
        error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
      ENDIF
    ELSE
      arc_radius=VAL(MID$(program_line$,parse_column|,8))
      DEC parse_column|
    ENDIF
  ENDIF
  IF MID$(program_line$,parse_column|,1)="-"
    arc_radius=-arc_radius
  ENDIF
  IF scaling_active!
    MUL arc_radius,scaling_factor
  ENDIF
  RETURN arc_radius
ENDFUNC
' Returns the number or Q parameter at column parse_column|+1 of block program_line$ with the sign at
' parse_column|, unscaled.
FUNCTION read_unscaled_number(program_line$,parse_column|)
  LOCAL angle_offset,parameter_number&,third_block_text$,alert_button|
  IF MID$(program_line$,SUCC(parse_column|),1)="Q"
    parameter_number&=VAL(MID$(program_line$,parse_column|+2,3))
    IF q_parameter_defined!(parameter_number&)
      angle_offset=q_parameters(parameter_number&)
    ELSE
      angle_offset=1
      third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
      ALERT 3,third_block_text$,1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=current_block&
      error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
    ENDIF
  ELSE
    angle_offset=VAL(MID$(program_line$,parse_column|,8))
    DEC parse_column|
  ENDIF
  IF MID$(program_line$,parse_column|,1)="-"
    angle_offset=-angle_offset
  ENDIF
  RETURN angle_offset
ENDFUNC
' Returns the arc direction ("+" or "-") at column parse_column| of block program_line$, swapped when mirroring
' (mirror_reverses_direction!).
FUNCTION read_arc_direction$(program_line$,parse_column|)
  LOCAL rnd_arc_direction$
  ON MENU
  rnd_arc_direction$=MID$(program_line$,parse_column|,1)
  IF mirror_reverses_direction!
    IF rnd_arc_direction$="-"
      rnd_arc_direction$=CHR$(43)
    ELSE
      rnd_arc_direction$=CHR$(45)
    ENDIF
  ENDIF
  RETURN rnd_arc_direction$
ENDFUNC
' ACOS that is safe at the ends: a value within rounding error of a whole number is snapped to it, 1 and above
' gives 0, -1 and below gives PI.
FUNCTION clamped_arc_cosine(angle_offset)
  LOCAL cosine_snapped
  cosine_snapped=ROUND(angle_offset)
  IF 1E-08>ABS(angle_offset-cosine_snapped)
    angle_offset=cosine_snapped
  ENDIF
  IF angle_offset>=1
    RETURN 0
  ELSE
    IF angle_offset<=-1
      RETURN PI
    ELSE
      RETURN ACOS(angle_offset)
    ENDIF
  ENDIF
ENDFUNC
' Sets the target end_point() to the point at radius arc_radius and angle angle_offset (degrees) around the
' centre circle_centre() in the circle plane; the third axis keeps the current position.
PROCEDURE set_polar_target(arc_radius,angle_offset)
  ' degrees to radians
  MUL angle_offset,PI/180
  end_point(first_plane_axis|)=circle_centre(first_plane_axis|)+COS(angle_offset)*arc_radius
  end_point(second_plane_axis|)=circle_centre(second_plane_axis|)+SIN(angle_offset)*arc_radius
  end_point(infeed_axis|)=start_point(infeed_axis|)
RETURN
' Works out a vector start_tangent() of length 32 tangent to the path at its start: for a line
' (last_element_was_line!) at right angles to the line from previous_block_start() to move_end(), for a circle
' along the radius from previous_centre() through move_end(), outwards or inwards by the direction
' move_arc_direction$. A zero radius gives "Kreisradius muss groesser als Null sein".
PROCEDURE compute_tangent_vector(last_element_was_line!)
  LOCAL alert_button|,start_u,start_v,segment_length,second_vector_x,second_vector_y,element_arc_radius,arc_radius,normal_direction_x,normal_direction_y,direction_x,direction_y
  IF last_element_was_line!
    direction_x=move_end(first_plane_axis|)-previous_block_start(first_plane_axis|)
    direction_y=move_end(second_plane_axis|)-previous_block_start(second_plane_axis|)
    ' a vertical line
    IF direction_x=0
      IF direction_y<0
        start_u=previous_block_start(first_plane_axis|)-32
      ELSE
        start_u=previous_block_start(first_plane_axis|)+32
      ENDIF
      start_v=previous_block_start(second_plane_axis|)
    ELSE
      ' a horizontal line
      IF direction_y=0
        IF direction_x>0
          start_v=previous_block_start(second_plane_axis|)-32
        ELSE
          start_v=previous_block_start(second_plane_axis|)+32
        ENDIF
        start_u=previous_block_start(first_plane_axis|)
      ELSE
        ' any other: at right angles to the line
        segment_length=SQR(direction_x*direction_x+direction_y*direction_y)
        start_u=previous_block_start(first_plane_axis|)+direction_y*32/segment_length
        start_v=previous_block_start(second_plane_axis|)-direction_x*32/segment_length
      ENDIF
    ENDIF
    start_tangent(1)=start_u-previous_block_start(first_plane_axis|)
    start_tangent(2)=start_v-previous_block_start(second_plane_axis|)
  ELSE
    second_vector_x=move_end(first_plane_axis|)-previous_centre(first_plane_axis|)
    second_vector_y=move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
    element_arc_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
    IF element_arc_radius<>0
      arc_radius=element_arc_radius
      ' direction +: the point lies outside the circle
      IF move_arc_direction$="+"
        arc_radius=arc_radius+32
      ELSE
        SUB arc_radius,32
      ENDIF
      DIV arc_radius,element_arc_radius
      normal_direction_x=arc_radius*second_vector_x+previous_centre(first_plane_axis|)
      normal_direction_y=arc_radius*second_vector_y+previous_centre(second_plane_axis|)
      start_tangent(1)=normal_direction_x-move_end(first_plane_axis|)
      start_tangent(2)=normal_direction_y-move_end(second_plane_axis|)
    ELSE
      ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=current_draw_block&
      error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
    ENDIF
  ENDIF
RETURN
' Reads the radius correction letter (column 44: L, R or 0) of block program_line$ into radius_correction$ when
' it is given, swapping L and R when mirroring.
PROCEDURE read_radius_correction(program_line$)
  LOCAL work_text$
  ON MENU
  IF LEN(program_line$)>43
    work_text$=MID$(program_line$,44,1)
    IF work_text$<>" "
      radius_correction$=work_text$
      IF mirror_reverses_direction!
        IF radius_correction$="R"
          radius_correction$=CHR$(76)
        ELSE
          IF radius_correction$="L"
            radius_correction$=CHR$(82)
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Keeps or brings back a block waiting for the radius compensation of the block after it: with pending_store!
' the line target end_point() (pending_line_swap!) or circle centre circle_centre() (pending_centre_swap!) is
' stored with its correction and direction and the pending flag end_point_stored!/centre_pending! toggled;
' without pending_store! the stored values are put back.
PROCEDURE swap_pending_block(pending_line_swap!,pending_centre_swap!,pending_store!)
  ' store
  IF pending_store!
    IF pending_line_swap!
      pending_line_target(1)=end_point(1)
      pending_line_target(2)=end_point(2)
      pending_line_target(3)=end_point(3)
      saved_correction_letter$=radius_correction$
      ' a line is waiting now (or no longer)
      end_point_stored!=NOT end_point_stored!
    ENDIF
    IF pending_centre_swap!
      pending_centre(1)=circle_centre(1)
      pending_centre(2)=circle_centre(2)
      pending_centre(3)=circle_centre(3)
      saved_correction_letter$=radius_correction$
      saved_arc_direction$=arc_direction$
      centre_pending!=NOT centre_pending!
    ENDIF
  ELSE
    IF pending_line_swap!
      end_point(1)=pending_line_target(1)
      end_point(2)=pending_line_target(2)
      end_point(3)=pending_line_target(3)
      radius_correction$=saved_correction_letter$
      end_point_stored!=NOT end_point_stored!
    ENDIF
    IF pending_centre_swap!
      circle_centre(1)=pending_centre(1)
      circle_centre(2)=pending_centre(2)
      circle_centre(3)=pending_centre(3)
      radius_correction$=saved_correction_letter$
      arc_direction$=saved_arc_direction$
      centre_pending!=NOT centre_pending!
    ENDIF
  ENDIF
RETURN
' Moves line_index& on to the next block, skipping continuation lines (ending in "}").
PROCEDURE skip_to_next_block(VAR line_index&)
  REPEAT
    INC line_index&
  UNTIL (RIGHT$(program_lines$(line_index&),1)<>"}") OR line_index&>=last_line&
RETURN
' Finds the three blocks after the current one current_block& into next_block&, block_after_next& and
' third_block_ahead&.
PROCEDURE find_lookahead_blocks
  next_block&=current_block&
  REPEAT
    INC next_block&
  UNTIL (RIGHT$(program_lines$(next_block&),1)<>"}") OR line_index&>=last_line&
  block_after_next&=next_block&
  REPEAT
    INC block_after_next&
  UNTIL (RIGHT$(program_lines$(block_after_next&),1)<>"}") OR line_index&>=last_line&
  third_block_ahead&=block_after_next&
  REPEAT
    INC third_block_ahead&
  UNTIL (RIGHT$(program_lines$(third_block_ahead&),1)<>"}") OR line_index&>=last_line&
RETURN
' Moves line_index& back to the previous block, skipping continuation lines; stops at line 0.
PROCEDURE skip_to_previous_block(VAR line_index&)
  IF line_index&>0
    REPEAT
      DEC line_index&
    UNTIL (RIGHT$(program_lines$(line_index&),1)<>"}") OR line_index&=0
  ENDIF
RETURN
' Tool radius compensation for block line_index&: works out the start point compensated_start() and end point
' compensated_end() of the path offset by the tool radius tool_radius to the left or right (compensation_side$
' before, radius_correction$ now), then the corner with the block before: the intersection of the two offset
' paths (line-line, arc-line, line-arc, arc-arc), stored in move_compensated_end(), or a corner arc
' (corner_arc_needed!, direction corner_arc_direction$) when the corner is on the outside. Where an offset arc
' and an offset line already meet (ends less than 0.001 apart), that point is taken as the corner.
' offset_circle_radius is the offset radius of a previous circle, arc_direction$ the arc direction,
' previous_is_line! TRUE when the block before is a line, move_is_line! returns whether compensation is on.
' Impossible geometry gives an alert and run_aborted!. In the rough-out cycle (rough_out_cycle_active!) an arc
' whose offset radius comes out negative (the tool does not fit inside it) sets run_aborted! with
' error_blocks&(0)=-10 and no alert, so that offset_element_at_corner can pass over that arc.
PROCEDURE compensate_tool_radius(line_index&,offset_circle_radius,arc_direction$,previous_is_line!,move_is_line!)
  LOCAL search_done!,prev_direction_h,prev_direction_v,direction_x,direction_y,element_arc_radius,centre_distance_h,centre_distance_v,prev_arc_clockwise!,this_arc_clockwise!,tool_right_of_contour!,prev_arc_larger!,alert_button|,offset_scale,normal_direction_x,normal_direction_y,point_distance,work_point_y,basic_variables,segment_length,second_operand,discriminant,quadratic_factor,end_side_factor,line_parameter,foot_position_y,foot_position_x,first_crossing_x,first_crossing_y,second_crossing_x,second_crossing_y,vector_y,cosine_snapped,end_point_angle,two_intersections!,vector_x,second_vector_x,second_vector_y,line_slope,line_intercept,first_vector_length,second_vector_length,programmed_radius,chord_x,chord_y,chord_length,chord_angle,centre_angle_offset,first_crossing_angle,second_crossing_angle,radius_dot_product,normal_spare,normal_h,normal_v,normal_x,normal_y,compensation_starts!,centre_line_vertical!,arcs_need_corner!,prev_side_undefined!,this_side_undefined!
  ' direction of the block before
  prev_direction_h=move_compensated_end(first_plane_axis|)-move_compensated_start(first_plane_axis|)
  prev_direction_v=move_compensated_end(second_plane_axis|)-move_compensated_start(second_plane_axis|)
  IF .0001>ABS(prev_direction_h)
    prev_direction_h=0
  ENDIF
  IF .0001>ABS(prev_direction_v)
    prev_direction_v=0
  ENDIF
  search_done!=FALSE
  corner_point_moved!=FALSE
  ' direction of this block
  direction_x=end_point(first_plane_axis|)-start_point(first_plane_axis|)
  direction_y=end_point(second_plane_axis|)-start_point(second_plane_axis|)
  IF 1E-06>ABS(direction_x) AND 1E-06>ABS(direction_y) AND next_block&<last_line&
    save_restore_simulation_state(-1)
    find_next_contour_move(move_is_line!)
    compensation_starts!=TRUE
    end_point_stored!=FALSE
    centre_pending!=FALSE
    direction_x=end_point(first_plane_axis|)-start_point(first_plane_axis|)
    direction_y=end_point(second_plane_axis|)-start_point(second_plane_axis|)
  ELSE
    compensation_starts!=FALSE
  ENDIF
  IF (NOT run_aborted!) AND (NOT stop_requested!)
    ' compensation on
    IF move_is_line!
      IF .0001>ABS(direction_x)
        direction_x=0
      ENDIF
      IF .0001>ABS(direction_y)
        direction_y=0
      ENDIF
      IF direction_x<>0 OR direction_y<>0
        segment_length=SQR(direction_x*direction_x+direction_y*direction_y)
        ' tool radius over the block length
        offset_scale=tool_radius/segment_length
        ' start point offset to the left or right of the line
        IF compensation_side$="L"
          IF direction_x=0
            IF direction_y>0
              compensated_start(first_plane_axis|)=start_point(first_plane_axis|)-tool_radius
            ELSE
              compensated_start(first_plane_axis|)=tool_radius+start_point(first_plane_axis|)
            ENDIF
            compensated_start(second_plane_axis|)=start_point(second_plane_axis|)
          ELSE
            IF direction_y=0
              IF direction_x<0
                compensated_start(second_plane_axis|)=start_point(second_plane_axis|)-tool_radius
              ELSE
                compensated_start(second_plane_axis|)=tool_radius+start_point(second_plane_axis|)
              ENDIF
              compensated_start(first_plane_axis|)=start_point(first_plane_axis|)
            ELSE
              compensated_start(first_plane_axis|)=start_point(first_plane_axis|)-direction_y*offset_scale
              compensated_start(second_plane_axis|)=start_point(second_plane_axis|)+direction_x*offset_scale
            ENDIF
          ENDIF
        ELSE
          IF compensation_side$="R"
            IF direction_x=0
              IF direction_y<0
                compensated_start(first_plane_axis|)=start_point(first_plane_axis|)-tool_radius
              ELSE
                compensated_start(first_plane_axis|)=tool_radius+start_point(first_plane_axis|)
              ENDIF
              compensated_start(second_plane_axis|)=start_point(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x>0
                  compensated_start(second_plane_axis|)=start_point(second_plane_axis|)-tool_radius
                ELSE
                  compensated_start(second_plane_axis|)=tool_radius+start_point(second_plane_axis|)
                ENDIF
                compensated_start(first_plane_axis|)=start_point(first_plane_axis|)
              ELSE
                compensated_start(first_plane_axis|)=start_point(first_plane_axis|)+direction_y*offset_scale
                compensated_start(second_plane_axis|)=start_point(second_plane_axis|)-direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            compensated_start(first_plane_axis|)=start_point(first_plane_axis|)
            compensated_start(second_plane_axis|)=start_point(second_plane_axis|)
          ENDIF
        ENDIF
        ' end point offset the same way
        IF radius_correction$="L"
          IF direction_x=0
            IF direction_y>0
              compensated_end(first_plane_axis|)=end_point(first_plane_axis|)-tool_radius
            ELSE
              compensated_end(first_plane_axis|)=tool_radius+end_point(first_plane_axis|)
            ENDIF
            compensated_end(second_plane_axis|)=end_point(second_plane_axis|)
          ELSE
            IF direction_y=0
              IF direction_x<0
                compensated_end(second_plane_axis|)=end_point(second_plane_axis|)-tool_radius
              ELSE
                compensated_end(second_plane_axis|)=tool_radius+end_point(second_plane_axis|)
              ENDIF
              compensated_end(first_plane_axis|)=end_point(first_plane_axis|)
            ELSE
              compensated_end(first_plane_axis|)=end_point(first_plane_axis|)-direction_y*offset_scale
              compensated_end(second_plane_axis|)=end_point(second_plane_axis|)+direction_x*offset_scale
            ENDIF
          ENDIF
        ELSE
          IF radius_correction$="R"
            IF direction_x=0
              IF direction_y<0
                compensated_end(first_plane_axis|)=end_point(first_plane_axis|)-tool_radius
              ELSE
                compensated_end(first_plane_axis|)=tool_radius+end_point(first_plane_axis|)
              ENDIF
              compensated_end(second_plane_axis|)=end_point(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x>0
                  compensated_end(second_plane_axis|)=end_point(second_plane_axis|)-tool_radius
                ELSE
                  compensated_end(second_plane_axis|)=tool_radius+end_point(second_plane_axis|)
                ENDIF
                compensated_end(first_plane_axis|)=end_point(first_plane_axis|)
              ELSE
                compensated_end(first_plane_axis|)=end_point(first_plane_axis|)+direction_y*offset_scale
                compensated_end(second_plane_axis|)=end_point(second_plane_axis|)-direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            compensated_end(first_plane_axis|)=end_point(first_plane_axis|)
            compensated_end(second_plane_axis|)=end_point(second_plane_axis|)
          ENDIF
        ENDIF
        direction_x=compensated_end(first_plane_axis|)-compensated_start(first_plane_axis|)
        direction_y=compensated_end(second_plane_axis|)-compensated_start(second_plane_axis|)
        IF .0001>ABS(direction_x)
          direction_x=0
        ENDIF
        IF .0001>ABS(direction_y)
          direction_y=0
        ENDIF
        ' the block moves and the block before did too: work out the corner
        IF direction_x<>0 OR direction_y<>0 AND (prev_direction_v<>0 OR prev_direction_h<>0)
          ' line after line
          IF previous_is_line!
            IF prev_direction_h=0
              IF compensated_end(first_plane_axis|)>move_compensated_start(first_plane_axis|) AND prev_direction_v<0 OR (compensated_end(first_plane_axis|)<move_compensated_start(first_plane_axis|) AND prev_direction_v>=0)
                line_parameter=-1
              ELSE
                line_parameter=1
              ENDIF
            ELSE
              normal_direction_x=-prev_direction_v
              normal_direction_y=prev_direction_h
              line_parameter=move_compensated_start(second_plane_axis|)-compensated_end(second_plane_axis|)+prev_direction_v/prev_direction_h*(compensated_end(first_plane_axis|)-move_compensated_start(first_plane_axis|))
              DIV line_parameter,normal_direction_y-normal_direction_x*prev_direction_v/prev_direction_h
            ENDIF
            IF .0001<ABS(line_parameter)
              ' the corner is on the outside: a corner arc is needed
              IF line_parameter<0 AND (compensation_side$="R") OR (line_parameter>0 AND (compensation_side$="L"))
                corner_arc_needed!=TRUE
                IF compensation_side$="R"
                  corner_arc_direction$=CHR$(43)
                ELSE
                  IF compensation_side$="L"
                    corner_arc_direction$=CHR$(45)
                  ENDIF
                ENDIF
              ELSE
                ' the line before is vertical
                IF prev_direction_h=0 AND direction_x<>0
                  line_parameter=compensated_start(second_plane_axis|)-move_compensated_start(second_plane_axis|)
                  line_parameter=line_parameter+direction_y/direction_x*(move_compensated_start(first_plane_axis|)-compensated_start(first_plane_axis|))
                  DIV line_parameter,prev_direction_v-direction_y*prev_direction_h/direction_x
                  ' intersection of the two offset lines
                  move_compensated_end(first_plane_axis|)=move_compensated_start(first_plane_axis|)+line_parameter*prev_direction_h
                  move_compensated_end(second_plane_axis|)=move_compensated_start(second_plane_axis|)+line_parameter*prev_direction_v
                  IF line_parameter<0 AND .001<ABS(line_parameter)
                    ALERT 3,"FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                    ELSE
                      error_blocks&(0)=current_draw_block&
                    ENDIF
                    error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
                  ENDIF
                ELSE
                  IF prev_direction_h<>0
                    line_parameter=move_compensated_start(second_plane_axis|)-compensated_start(second_plane_axis|)
                    line_parameter=line_parameter+prev_direction_v/prev_direction_h*(compensated_start(first_plane_axis|)-move_compensated_start(first_plane_axis|))
                    DIV line_parameter,direction_y-prev_direction_v*direction_x/prev_direction_h
                    move_compensated_end(first_plane_axis|)=compensated_start(first_plane_axis|)+line_parameter*direction_x
                    move_compensated_end(second_plane_axis|)=compensated_start(second_plane_axis|)+line_parameter*direction_y
                    IF line_parameter<0 AND .001<ABS(line_parameter)
                      ALERT 3,"FrÑserradius ist|zu groû!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                        error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                      ELSE
                        error_blocks&(0)=current_draw_block&
                      ENDIF
                      error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
                    ENDIF
                  ENDIF
                ENDIF
                compensated_start(first_plane_axis|)=move_compensated_end(first_plane_axis|)
                compensated_start(second_plane_axis|)=move_compensated_end(second_plane_axis|)
                corner_point_moved!=TRUE
              ENDIF
            ENDIF
          ELSE
            ' line after an arc
            point_distance=move_compensated_end(first_plane_axis|)-previous_centre(first_plane_axis|)
            work_point_y=move_compensated_end(second_plane_axis|)-previous_centre(second_plane_axis|)
            IF move_arc_direction$="-"
              normal_h=work_point_y
              normal_v=-point_distance
            ELSE
              normal_h=-work_point_y
              normal_v=point_distance
            ENDIF
            IF normal_h=0
              IF 1E-07>ABS(move_compensated_end(first_plane_axis|)-compensated_end(first_plane_axis|))
                line_parameter=0
              ELSE
                IF compensated_end(first_plane_axis|)<move_compensated_end(first_plane_axis|) AND normal_v>=0 OR (compensated_end(first_plane_axis|)>move_compensated_end(first_plane_axis|) AND normal_v<0)
                  line_parameter=-1
                ELSE
                  line_parameter=1
                ENDIF
              ENDIF
            ELSE
              normal_x=-normal_v
              normal_y=normal_h
              line_parameter=normal_v/normal_h*(compensated_end(first_plane_axis|)-move_compensated_end(first_plane_axis|))
              SUB line_parameter,compensated_end(second_plane_axis|)-move_compensated_end(second_plane_axis|)
              DIV line_parameter,normal_y-normal_x*normal_v/normal_h
            ENDIF
            IF .0001>ABS(line_parameter)
              line_parameter=0
            ENDIF
            normal_h=move_compensated_end(first_plane_axis|)-move_compensated_start(first_plane_axis|)
            normal_v=move_compensated_end(second_plane_axis|)-move_compensated_start(second_plane_axis|)
            IF normal_h=0
              IF compensated_end(first_plane_axis|)<=move_compensated_end(first_plane_axis|) AND normal_v>=0 OR (compensated_end(first_plane_axis|)>move_compensated_end(first_plane_axis|) AND normal_v<0)
                end_side_factor=-1
              ELSE
                end_side_factor=1
              ENDIF
            ELSE
              normal_x=-normal_v
              normal_y=normal_h
              end_side_factor=normal_v/normal_h*(compensated_end(first_plane_axis|)-move_compensated_end(first_plane_axis|))
              SUB end_side_factor,compensated_end(second_plane_axis|)-move_compensated_end(second_plane_axis|)
              DIV end_side_factor,normal_y-normal_x*normal_v/normal_h
            ENDIF
            IF .0001>ABS(end_side_factor)
              end_side_factor=0
            ENDIF
            IF (move_arc_direction$="+") AND (line_parameter>0 AND (compensation_side$="L") OR (end_side_factor<=0 AND line_parameter<0 AND (compensation_side$="R")))
              corner_arc_needed!=TRUE
              IF compensation_side$="R"
                corner_arc_direction$=CHR$(43)
              ELSE
                IF compensation_side$="L"
                  corner_arc_direction$=CHR$(45)
                ENDIF
              ENDIF
            ELSE
              IF (move_arc_direction$="-") AND (line_parameter<0 AND (compensation_side$="R") OR (end_side_factor>=0 AND line_parameter>0 AND (compensation_side$="L")))
                corner_arc_needed!=TRUE
                IF compensation_side$="R"
                  corner_arc_direction$=CHR$(43)
                ELSE
                  IF compensation_side$="L"
                    corner_arc_direction$=CHR$(45)
                  ENDIF
                ENDIF
              ELSE
                IF 9.99999999999997E-06>ABS(direction_x)
                  point_distance=compensated_start(first_plane_axis|)-previous_centre(first_plane_axis|)
                  ' the offset circle and a vertical line
                  discriminant=offset_circle_radius*offset_circle_radius-point_distance*point_distance
                  IF (NOT in_subprogram_call!) AND .1>ABS(discriminant) OR (in_subprogram_call! AND .2>ABS(discriminant))
                    discriminant=0
                  ENDIF
                  ' the line does not meet the circle
                  IF discriminant<0
                    ALERT 3,"Linie-Koordinaten falsch!|Kreis schneidet sich|nicht mit Linie!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                    ELSE
                      error_blocks&(0)=current_block&
                    ENDIF
                    error_messages$(0)="LINIE-KOORDINATEN SIND FALSCH!"
                  ELSE
                    first_crossing_x=compensated_start(first_plane_axis|)
                    second_crossing_x=first_crossing_x
                    first_crossing_y=previous_centre(second_plane_axis|)-SQR(discriminant)
                    second_crossing_y=previous_centre(second_plane_axis|)+SQR(discriminant)
                    vector_x=0
                    vector_y=first_crossing_y-compensated_start(second_plane_axis|)
                    second_vector_x=0
                    second_vector_y=second_crossing_y-compensated_start(second_plane_axis|)
                    two_intersections!=TRUE
                  ENDIF
                ELSE
                  ' the offset line already starts where the offset arc before it ends: that point is the corner, without
                  ' solving the quadratic, which can miss it through rounding
                  IF .001>ABS(compensated_start(first_plane_axis|)-move_compensated_end(first_plane_axis|)) AND .001>ABS(compensated_start(second_plane_axis|)-move_compensated_end(second_plane_axis|))
                    first_crossing_x=compensated_start(first_plane_axis|)
                    first_crossing_y=compensated_start(second_plane_axis|)
                    two_intersections!=FALSE
                  ELSE
                    ' the offset circle and the line: solve the quadratic
                    line_slope=direction_y/direction_x
                    line_intercept=compensated_start(second_plane_axis|)-line_slope*compensated_start(first_plane_axis|)
                    basic_variables=line_intercept-previous_centre(second_plane_axis|)
                    segment_length=previous_centre(first_plane_axis|)-line_slope*basic_variables
                    second_operand=basic_variables*basic_variables+previous_centre(first_plane_axis|)*previous_centre(first_plane_axis|)-offset_circle_radius*offset_circle_radius
                    quadratic_factor=line_slope*line_slope
                    INC quadratic_factor
                    discriminant=segment_length*segment_length-quadratic_factor*second_operand
                    IF (NOT in_subprogram_call!) AND .1>ABS(discriminant) OR (in_subprogram_call! AND .2>ABS(discriminant))
                      discriminant=0
                    ENDIF
                    IF discriminant<0
                      ALERT 3,"Linie-Koordinaten falsch!|Kreis schneidet sich|nicht mit Linie!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                        error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                      ELSE
                        error_blocks&(0)=current_block&
                      ENDIF
                      error_messages$(0)="LINIE-KOORDINATEN SIND FALSCH!"
                    ELSE
                      IF segment_length>=0
                        first_crossing_x=(SQR(discriminant)+segment_length)/quadratic_factor
                      ELSE
                        first_crossing_x=(segment_length-SQR(discriminant))/quadratic_factor
                      ENDIF
                      first_crossing_y=line_slope*first_crossing_x+line_intercept
                      vector_x=first_crossing_x-compensated_start(first_plane_axis|)
                      vector_y=first_crossing_y-compensated_start(second_plane_axis|)
                      IF quadratic_factor<>0 AND first_crossing_x<>0
                        two_intersections!=TRUE
                        second_crossing_x=second_operand/first_crossing_x/quadratic_factor
                        second_crossing_y=line_slope*second_crossing_x+line_intercept
                        second_vector_x=second_crossing_x-compensated_start(first_plane_axis|)
                        second_vector_y=second_crossing_y-compensated_start(second_plane_axis|)
                      ELSE
                        two_intersections!=FALSE
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                IF NOT run_aborted!
                  IF two_intersections!
                    ' two points: take the nearer one
                    first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
                    second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
                    IF first_vector_length<=second_vector_length
                      move_compensated_end(first_plane_axis|)=first_crossing_x
                      move_compensated_end(second_plane_axis|)=first_crossing_y
                    ELSE
                      move_compensated_end(first_plane_axis|)=second_crossing_x
                      move_compensated_end(second_plane_axis|)=second_crossing_y
                    ENDIF
                  ELSE
                    move_compensated_end(first_plane_axis|)=first_crossing_x
                    move_compensated_end(second_plane_axis|)=first_crossing_y
                  ENDIF
                  compensated_start(first_plane_axis|)=move_compensated_end(first_plane_axis|)
                  compensated_start(second_plane_axis|)=move_compensated_end(second_plane_axis|)
                  corner_point_moved!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ELSE
      ' this block is an arc
      vector_x=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
      vector_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
      element_arc_radius=SQR(vector_x*vector_x+vector_y*vector_y)
      IF element_arc_radius=0
        ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
          error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
        ELSE
          error_blocks&(0)=current_block&
        ENDIF
        error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
      ELSE
        programmed_radius=element_arc_radius
        ' offset radius: bigger or smaller by the side and direction
        IF radius_correction$="R"
          IF arc_direction$="+"
            element_arc_radius=element_arc_radius+tool_radius
          ELSE
            SUB element_arc_radius,tool_radius
          ENDIF
        ELSE
          IF radius_correction$="L"
            IF arc_direction$="-"
              element_arc_radius=element_arc_radius+tool_radius
            ELSE
              SUB element_arc_radius,tool_radius
            ENDIF
          ENDIF
        ENDIF
        ' rough-out: the tool does not fit inside this arc; -10 marks the error for offset_element_at_corner, which
        ' clears it and takes the element after this arc instead
        IF rough_out_cycle_active! AND element_arc_radius<0
          run_aborted!=TRUE
          error_blocks&(0)=-10
        ENDIF
        ' start and end point on the offset circle
        compensated_start(first_plane_axis|)=element_arc_radius/programmed_radius*vector_x+circle_centre(first_plane_axis|)
        compensated_start(second_plane_axis|)=element_arc_radius/programmed_radius*vector_y+circle_centre(second_plane_axis|)
        point_distance=end_point(first_plane_axis|)-circle_centre(first_plane_axis|)
        work_point_y=end_point(second_plane_axis|)-circle_centre(second_plane_axis|)
        compensated_end(first_plane_axis|)=element_arc_radius/programmed_radius*point_distance+circle_centre(first_plane_axis|)
        compensated_end(second_plane_axis|)=element_arc_radius/programmed_radius*work_point_y+circle_centre(second_plane_axis|)
        ' arc after a line
        IF previous_is_line!
          point_distance=compensated_start(first_plane_axis|)-circle_centre(first_plane_axis|)
          work_point_y=compensated_start(second_plane_axis|)-circle_centre(second_plane_axis|)
          IF arc_direction$="-"
            normal_h=-work_point_y
            normal_v=point_distance
          ELSE
            normal_h=work_point_y
            normal_v=-point_distance
          ENDIF
          IF normal_h=0
            IF 1E-07>ABS(move_compensated_start(first_plane_axis|)-compensated_start(first_plane_axis|))
              line_parameter=0
            ELSE
              IF move_compensated_start(first_plane_axis|)<compensated_start(first_plane_axis|) AND normal_v>=0 OR (move_compensated_start(first_plane_axis|)>compensated_start(first_plane_axis|) AND normal_v<0)
                line_parameter=-1
              ELSE
                line_parameter=1
              ENDIF
            ENDIF
          ELSE
            normal_x=-normal_v
            normal_y=normal_h
            line_parameter=normal_v/normal_h*(move_compensated_start(first_plane_axis|)-compensated_start(first_plane_axis|))
            SUB line_parameter,move_compensated_start(second_plane_axis|)-compensated_start(second_plane_axis|)
            DIV line_parameter,normal_y-normal_x*normal_v/normal_h
          ENDIF
          IF .0001>ABS(line_parameter)
            line_parameter=0
          ENDIF
          normal_h=compensated_start(first_plane_axis|)-compensated_end(first_plane_axis|)
          normal_v=compensated_start(second_plane_axis|)-compensated_end(second_plane_axis|)
          IF normal_h=0
            IF move_compensated_start(first_plane_axis|)<=compensated_start(first_plane_axis|) AND normal_v>=0 OR (move_compensated_start(first_plane_axis|)>compensated_start(first_plane_axis|) AND normal_v<0)
              end_side_factor=-1
            ELSE
              end_side_factor=1
            ENDIF
          ELSE
            normal_x=-normal_v
            normal_y=normal_h
            end_side_factor=normal_v/normal_h*(move_compensated_start(first_plane_axis|)-compensated_start(first_plane_axis|))
            SUB end_side_factor,move_compensated_start(second_plane_axis|)-compensated_start(second_plane_axis|)
            DIV end_side_factor,normal_y-normal_x*normal_v/normal_h
          ENDIF
          IF .0001>ABS(end_side_factor)
            end_side_factor=0
          ENDIF
          IF (arc_direction$="+") AND (line_parameter<0 AND (radius_correction$="L") OR (end_side_factor>=0 AND line_parameter>0 AND (radius_correction$="R")))
            corner_arc_needed!=TRUE
            IF radius_correction$="R"
              corner_arc_direction$=CHR$(43)
            ELSE
              IF radius_correction$="L"
                corner_arc_direction$=CHR$(45)
              ENDIF
            ENDIF
          ELSE
            IF (arc_direction$="-") AND (line_parameter>0 AND (radius_correction$="R") OR (end_side_factor<=0 AND line_parameter<0 AND (radius_correction$="L")))
              corner_arc_needed!=TRUE
              IF radius_correction$="R"
                corner_arc_direction$=CHR$(43)
              ELSE
                IF radius_correction$="L"
                  corner_arc_direction$=CHR$(45)
                ENDIF
              ENDIF
            ELSE
              IF 9.99999999999997E-06>ABS(prev_direction_h)
                point_distance=move_compensated_end(first_plane_axis|)-circle_centre(first_plane_axis|)
                ' the vertical line meets the offset circle?
                discriminant=element_arc_radius*element_arc_radius-point_distance*point_distance
                IF (NOT in_subprogram_call!) AND .1>ABS(discriminant) OR (in_subprogram_call! AND .2>ABS(discriminant))
                  discriminant=0
                ENDIF
                IF discriminant<0
                  ALERT 3,"Kreis-Koordinaten falsch!|Linie schneidet sich|nicht mit Kreis!",1,"Abbruch",alert_button|
                  run_aborted!=TRUE
                  IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                    error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                  ELSE
                    error_blocks&(0)=current_block&
                  ENDIF
                  error_messages$(0)="KREIS-KOORDINATEN SIND FALSCH!"
                ELSE
                  first_crossing_x=move_compensated_end(first_plane_axis|)
                  second_crossing_x=first_crossing_x
                  first_crossing_y=circle_centre(second_plane_axis|)-SQR(discriminant)
                  second_crossing_y=circle_centre(second_plane_axis|)+SQR(discriminant)
                  vector_x=0
                  vector_y=first_crossing_y-compensated_start(second_plane_axis|)
                  second_vector_x=0
                  second_vector_y=second_crossing_y-compensated_start(second_plane_axis|)
                  two_intersections!=TRUE
                ENDIF
              ELSE
                ' the offset arc already starts where the offset line before it ends: that point is the corner, without
                ' solving the quadratic
                IF .001>ABS(compensated_start(first_plane_axis|)-move_compensated_end(first_plane_axis|)) AND .001>ABS(compensated_start(second_plane_axis|)-move_compensated_end(second_plane_axis|))
                  first_crossing_x=compensated_start(first_plane_axis|)
                  first_crossing_y=compensated_start(second_plane_axis|)
                  two_intersections!=FALSE
                ELSE
                  ' the offset line and the circle: solve the quadratic
                  line_slope=prev_direction_v/prev_direction_h
                  line_intercept=move_compensated_start(second_plane_axis|)-line_slope*move_compensated_start(first_plane_axis|)
                  basic_variables=line_intercept-circle_centre(second_plane_axis|)
                  segment_length=circle_centre(first_plane_axis|)-line_slope*basic_variables
                  second_operand=basic_variables*basic_variables+circle_centre(first_plane_axis|)*circle_centre(first_plane_axis|)-element_arc_radius*element_arc_radius
                  quadratic_factor=line_slope*line_slope
                  INC quadratic_factor
                  discriminant=segment_length*segment_length-quadratic_factor*second_operand
                  IF (NOT in_subprogram_call!) AND .1>ABS(discriminant) OR (in_subprogram_call! AND .2>ABS(discriminant))
                    discriminant=0
                  ENDIF
                  IF discriminant<0
                    ALERT 3,"Kreis-Koordinaten falsch!|Linie schneidet sich|nicht mit Kreis!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                    ELSE
                      error_blocks&(0)=current_block&
                    ENDIF
                    error_messages$(0)="KREIS-KOORDINATEN SIND FALSCH!"
                  ELSE
                    IF segment_length>=0
                      first_crossing_x=(SQR(discriminant)+segment_length)/quadratic_factor
                    ELSE
                      first_crossing_x=(segment_length-SQR(discriminant))/quadratic_factor
                    ENDIF
                    first_crossing_y=line_slope*first_crossing_x+line_intercept
                    vector_x=first_crossing_x-compensated_start(first_plane_axis|)
                    vector_y=first_crossing_y-compensated_start(second_plane_axis|)
                    IF quadratic_factor<>0 AND first_crossing_x<>0
                      two_intersections!=TRUE
                      second_crossing_x=second_operand/first_crossing_x/quadratic_factor
                      second_crossing_y=line_slope*second_crossing_x+line_intercept
                      second_vector_x=second_crossing_x-compensated_start(first_plane_axis|)
                      second_vector_y=second_crossing_y-compensated_start(second_plane_axis|)
                    ELSE
                      two_intersections!=FALSE
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
              IF NOT run_aborted!
                IF two_intersections!
                  first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
                  second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
                  IF first_vector_length<=second_vector_length
                    move_compensated_end(first_plane_axis|)=first_crossing_x
                    move_compensated_end(second_plane_axis|)=first_crossing_y
                  ELSE
                    move_compensated_end(first_plane_axis|)=second_crossing_x
                    move_compensated_end(second_plane_axis|)=second_crossing_y
                  ENDIF
                ELSE
                  move_compensated_end(first_plane_axis|)=first_crossing_x
                  move_compensated_end(second_plane_axis|)=first_crossing_y
                ENDIF
                compensated_start(first_plane_axis|)=move_compensated_end(first_plane_axis|)
                compensated_start(second_plane_axis|)=move_compensated_end(second_plane_axis|)
                corner_point_moved!=TRUE
              ENDIF
            ENDIF
          ENDIF
        ELSE
          ' arc after an arc
          prev_arc_clockwise!=(move_arc_direction$="-")
          this_arc_clockwise!=(arc_direction$="-")
          tool_right_of_contour!=(compensation_side$="L")
          arcs_need_corner!=FALSE
          centre_line_vertical!=FALSE
          search_done!=FALSE
          centre_distance_h=circle_centre(first_plane_axis|)-previous_centre(first_plane_axis|)
          centre_distance_v=circle_centre(second_plane_axis|)-previous_centre(second_plane_axis|)
          IF centre_distance_h=0 AND centre_distance_v<>0
            IF 1E-08>ABS(move_end(first_plane_axis|)-previous_centre(first_plane_axis|))
              centre_line_vertical!=TRUE
            ENDIF
          ELSE
            ' is the line through the centres vertical?
            IF centre_distance_h<>0
              work_point_y=centre_distance_v/centre_distance_h*(move_end(first_plane_axis|)-previous_centre(first_plane_axis|))
              work_point_y=work_point_y+previous_centre(second_plane_axis|)
              IF 1E-08>ABS(move_end(second_plane_axis|)-work_point_y)
                centre_line_vertical!=TRUE
              ENDIF
            ENDIF
          ENDIF
          IF radius_correction$="R"
            corner_arc_direction$=CHR$(43)
          ELSE
            IF radius_correction$="L"
              corner_arc_direction$=CHR$(45)
            ENDIF
          ENDIF
          IF centre_line_vertical!
            IF prev_arc_clockwise!=this_arc_clockwise!
              corner_arc_needed!=TRUE
            ENDIF
            search_done!=TRUE
          ELSE
            point_distance=move_end(first_plane_axis|)-previous_centre(first_plane_axis|)
            work_point_y=move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
            IF move_arc_direction$="-"
              vector_x=work_point_y
              vector_y=-point_distance
            ELSE
              vector_x=-work_point_y
              vector_y=point_distance
            ENDIF
            point_distance=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
            work_point_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
            IF arc_direction$="-"
              second_vector_x=-work_point_y
              second_vector_y=point_distance
            ELSE
              second_vector_x=work_point_y
              second_vector_y=-point_distance
            ENDIF
            ' the arcs meet tangentially: no corner
            IF vector_x=-second_vector_x AND vector_y=-second_vector_y
              search_done!=TRUE
              corner_arc_needed!=FALSE
            ELSE
              IF centre_distance_h=0
                IF move_end(first_plane_axis|)<=previous_centre(first_plane_axis|) AND centre_distance_v>=0 OR (move_end(first_plane_axis|)>previous_centre(first_plane_axis|) AND centre_distance_v<0)
                  foot_position_y=-1
                ELSE
                  foot_position_y=1
                ENDIF
                IF start_point(first_plane_axis|)<=previous_centre(first_plane_axis|) AND centre_distance_v>=0 OR (start_point(first_plane_axis|)>previous_centre(first_plane_axis|) AND centre_distance_v<0)
                  foot_position_x=-1
                ELSE
                  foot_position_x=1
                ENDIF
              ELSE
                line_slope=centre_distance_v/centre_distance_h
                end_side_factor=centre_distance_v/centre_distance_h*(move_end(first_plane_axis|)-previous_centre(first_plane_axis|))
                SUB end_side_factor,move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
                foot_position_y=end_side_factor
                DIV foot_position_y,vector_y-line_slope*vector_x
                foot_position_x=end_side_factor
                DIV foot_position_x,second_vector_y-line_slope*second_vector_x
              ENDIF
              IF 1000000<ABS(foot_position_y)
                prev_side_undefined!=TRUE
              ELSE
                prev_side_undefined!=FALSE
              ENDIF
              IF 1000000<ABS(foot_position_x)
                this_side_undefined!=TRUE
              ELSE
                this_side_undefined!=FALSE
              ENDIF
              IF offset_circle_radius>=element_arc_radius
                prev_arc_larger!=TRUE
              ELSE
                prev_arc_larger!=FALSE
              ENDIF
              IF prev_side_undefined! AND foot_position_x<0 AND (prev_arc_clockwise! AND tool_right_of_contour! OR ((NOT prev_arc_clockwise!) AND (NOT tool_right_of_contour!)))
                arcs_need_corner!=TRUE
              ELSE
                IF prev_side_undefined! AND foot_position_x>0 AND (prev_arc_clockwise! AND (NOT tool_right_of_contour!) OR ((NOT prev_arc_clockwise!) AND tool_right_of_contour!))
                  arcs_need_corner!=TRUE
                ELSE
                  IF foot_position_y>0 AND (this_side_undefined! OR foot_position_x<0) AND (this_arc_clockwise! AND (NOT tool_right_of_contour!) OR ((NOT this_arc_clockwise!) AND tool_right_of_contour!))
                    arcs_need_corner!=TRUE
                  ELSE
                    IF foot_position_y<0 AND (this_side_undefined! OR foot_position_x>0) AND ((NOT this_arc_clockwise!) AND tool_right_of_contour! OR (this_arc_clockwise! AND (NOT tool_right_of_contour!)))
                      arcs_need_corner!=TRUE
                    ELSE
                      IF foot_position_y>0 AND foot_position_x>0
                        IF prev_arc_clockwise! AND this_arc_clockwise! AND (NOT tool_right_of_contour!) OR ((NOT prev_arc_clockwise!) AND (NOT this_arc_clockwise!) AND tool_right_of_contour!)
                          arcs_need_corner!=TRUE
                        ELSE
                          IF prev_arc_clockwise! AND (NOT this_arc_clockwise!) AND (prev_arc_larger! AND tool_right_of_contour! OR ((NOT prev_arc_larger!) AND (NOT tool_right_of_contour!)))
                            arcs_need_corner!=TRUE
                          ELSE
                            IF (NOT prev_arc_clockwise!) AND this_arc_clockwise! AND (prev_arc_larger! AND (NOT tool_right_of_contour!) OR ((NOT prev_arc_larger!) AND tool_right_of_contour!))
                              arcs_need_corner!=TRUE
                            ENDIF
                          ENDIF
                        ENDIF
                      ELSE
                        IF foot_position_y<0 AND foot_position_x<0
                          IF prev_arc_clockwise! AND this_arc_clockwise! AND tool_right_of_contour! OR ((NOT prev_arc_clockwise!) AND (NOT this_arc_clockwise!) AND (NOT tool_right_of_contour!))
                            arcs_need_corner!=TRUE
                          ELSE
                            IF prev_arc_clockwise! AND (NOT this_arc_clockwise!) AND (prev_arc_larger! AND (NOT tool_right_of_contour!) OR ((NOT prev_arc_larger!) AND tool_right_of_contour!))
                              arcs_need_corner!=TRUE
                            ELSE
                              IF (NOT prev_arc_clockwise!) AND this_arc_clockwise! AND (prev_arc_larger! AND tool_right_of_contour! OR ((NOT prev_arc_larger!) AND (NOT tool_right_of_contour!)))
                                arcs_need_corner!=TRUE
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF NOT search_done!
            IF arcs_need_corner!
              corner_arc_needed!=TRUE
            ELSE
              corner_arc_needed!=FALSE
              ' distance between the centres
              chord_length=SQR(centre_distance_h*centre_distance_h+centre_distance_v*centre_distance_v)
              IF chord_length=0
                ALERT 3,"Mittelpunkte der beiden Kreise|mÅssen verschieden sein !|Sonst schneiden diese|sich nicht!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                  error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                ELSE
                  error_blocks&(0)=current_block&
                ENDIF
                error_messages$(0)="KREISMITTELPUNKTE MöSSEN VERSCHIEDEN SEIN!"
              ELSE
                ' angle of the centre line and the angles to the two intersections (law of cosines)
                chord_angle=centre_distance_h/chord_length
                chord_angle=@clamped_arc_cosine(chord_angle)
                IF centre_distance_v<0
                  chord_angle=two_pi-chord_angle
                ENDIF
                centre_angle_offset=offset_circle_radius*offset_circle_radius+chord_length*chord_length-element_arc_radius*element_arc_radius
                DIV centre_angle_offset,offset_circle_radius*2*chord_length
                centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
                first_crossing_angle=chord_angle+centre_angle_offset
                second_crossing_angle=chord_angle-centre_angle_offset
                first_crossing_x=COS(first_crossing_angle)*offset_circle_radius+previous_centre(first_plane_axis|)
                first_crossing_y=SIN(first_crossing_angle)*offset_circle_radius+previous_centre(second_plane_axis|)
                second_crossing_x=COS(second_crossing_angle)*offset_circle_radius+previous_centre(first_plane_axis|)
                second_crossing_y=SIN(second_crossing_angle)*offset_circle_radius+previous_centre(second_plane_axis|)
                vector_x=move_end(first_plane_axis|)-previous_centre(first_plane_axis|)
                vector_y=move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
                point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                end_point_angle=vector_x/point_distance
                end_point_angle=@clamped_arc_cosine(end_point_angle)
                IF vector_y<0
                  end_point_angle=-end_point_angle
                ENDIF
                vector_x=first_crossing_x-previous_centre(first_plane_axis|)
                vector_y=first_crossing_y-previous_centre(second_plane_axis|)
                point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                cosine_snapped=vector_x/point_distance
                cosine_snapped=@clamped_arc_cosine(cosine_snapped)
                IF vector_y<0
                  cosine_snapped=-cosine_snapped
                ENDIF
                ' pick the intersection on the side of the arc direction
                IF prev_arc_clockwise!
                  IF cosine_snapped>=end_point_angle
                    move_compensated_end(first_plane_axis|)=first_crossing_x
                    move_compensated_end(second_plane_axis|)=first_crossing_y
                  ELSE
                    move_compensated_end(first_plane_axis|)=second_crossing_x
                    move_compensated_end(second_plane_axis|)=second_crossing_y
                  ENDIF
                ELSE
                  IF cosine_snapped>=end_point_angle
                    move_compensated_end(first_plane_axis|)=second_crossing_x
                    move_compensated_end(second_plane_axis|)=second_crossing_y
                  ELSE
                    move_compensated_end(first_plane_axis|)=first_crossing_x
                    move_compensated_end(second_plane_axis|)=first_crossing_y
                  ENDIF
                ENDIF
                compensated_start(first_plane_axis|)=move_compensated_end(first_plane_axis|)
                compensated_start(second_plane_axis|)=move_compensated_end(second_plane_axis|)
                corner_point_moved!=TRUE
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' compensation started with this block
  IF compensation_starts!
    save_restore_simulation_state(0)
    move_is_line!=TRUE
  ENDIF
RETURN
' Looks ahead through the program text program_lines$() to the next block that moves the tool, so that the
' pending move can be drawn with the correct radius-compensated end point and corner. Each block met on the way
' is evaluated the way the real run does it: L/LP/C/CP/CT/CR/CTP set the new target end_point(), CC registers a
' circle centre, CALL LBL jumps to the label line label_blocks&(), CYCL DEF 7/8/10/11 (datum shift, mirror,
' rotation, scaling) are applied, and FN 0 to FN 15 calculate Q parameters q_parameters() (setting
' q_parameter_defined!() for each one set). Division by zero and the square root of a negative number give an
' alert and store the error in error_messages$(0). Returns move_is_line!: TRUE when the next move is a straight
' line, FALSE when it is an arc. The scan stops at the first block that moves the tool (is_finished!), at the
' last line last_line&, at LBL 0 or on an error (run_aborted!). The caller saves the simulation state with
' save_restore_simulation_state(-1) first and restores it afterwards.
PROCEDURE find_next_contour_move(VAR move_is_line!)
  LOCAL is_finished!,program_line$,following_block_text$,lookahead_third_block_text$,line_head_five$,line_head_eight$,next_block_text$,line_is_continuation!,line_not_type_a!,basic_variables,segment_length,second_operand,rect_width&,direction_x,direction_y,block_moves_tool!,alert_button|
  ' no moving block found yet
  is_finished!=FALSE
  ' start the scan at the next line
  current_block&=next_block&
  find_lookahead_blocks
  ' one block per pass
  REPEAT
    ' the position becomes the last target, so a block that leaves end_point() unchanged moves nothing
    start_point(1)=end_point(1)
    start_point(2)=end_point(2)
    start_point(3)=end_point(3)
    ' assume the block moves the tool
    block_moves_tool!=TRUE
    ' the block text
    program_line$=program_lines$(current_block&)
    following_block_text$=LEFT$(program_line$,2)
    lookahead_third_block_text$=LEFT$(program_line$,3)
    line_head_five$=LEFT$(program_line$,5)
    line_head_eight$=LEFT$(program_line$,8)
    next_block_text$=program_lines$(next_block&)
    ' a block ending in "}" continues on the next line
    IF RIGHT$(program_line$,1)="}"
      line_is_continuation!=TRUE
    ELSE
      line_is_continuation!=FALSE
    ENDIF
    ' "A" in column 7 marks absolute coordinates
    IF MID$(program_line$,7,1)="A"
      line_not_type_a!=FALSE
    ELSE
      line_not_type_a!=TRUE
    ENDIF
    IF line_is_continuation!
    ELSE
      ' a straight line L with coordinates
      IF (following_block_text$="L ") AND LEN(program_line$)>20
        IF line_not_type_a!
          ' incremental line continued by a short L block: join the two lines
          IF (LEFT$(next_block_text$,2)="L ") AND LEN(next_block_text$)<20
            chamfer_line_corner(program_line$,-1)
            current_block&=next_block&
            next_block&=block_after_next&
            block_after_next&=third_block_ahead&
            skip_to_next_block(third_block_ahead&)
          ELSE
            IF end_point_stored!
              swap_pending_block(-1,0,0)
            ELSE
              read_line_target(program_line$)
              read_radius_correction(program_line$)
            ENDIF
          ENDIF
          move_is_line!=TRUE
        ENDIF
      ELSE
        ' a polar straight line
        IF following_block_text$="LP"
          move_is_line!=TRUE
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            interpret_polar_line(program_line$)
          ENDIF
        ELSE
          ' circle centre; does not move the tool
          IF following_block_text$="CC"
            block_moves_tool!=FALSE
            IF centre_pending!
              swap_pending_block(0,-1,0)
            ELSE
              set_plane_from_centre(program_line$)
              read_circle_centre(program_line$)
            ENDIF
          ELSE
            ' circle round the last centre
            IF following_block_text$="C "
              move_is_line!=FALSE
              IF end_point_stored!
                swap_pending_block(-1,0,0)
              ELSE
                rect_width&=current_block&
                skip_to_previous_block(rect_width&)
                ' the centre is not on this line: search back for the last CC block
                IF LEFT$(program_lines$(rect_width&),2)<>"CC"
                  REPEAT
                    DEC rect_width&
                  UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
                  IF rect_width&>0
                    set_plane_from_centre(program_lines$(rect_width&))
                  ENDIF
                ENDIF
                read_arc_target(program_line$,9,21)
                read_radius_correction(program_line$)
                ' the direction DR+/DR- from column 33
                arc_direction$=@read_arc_direction$(program_line$,33)
              ENDIF
            ELSE
              ' a polar circle
              IF (following_block_text$="CP") AND (MID$(program_line$,18,2)="  ")
                move_is_line!=FALSE
                IF end_point_stored!
                  swap_pending_block(-1,0,0)
                ELSE
                  interpret_polar_arc(program_line$)
                ENDIF
              ELSE
                ' a tangential circle
                IF lookahead_third_block_text$="CT "
                  move_is_line!=FALSE
                  IF end_point_stored!
                    swap_pending_block(-1,0,0)
                  ELSE
                    interpret_tangential_arc(program_line$)
                  ENDIF
                ELSE
                  ' a circle by radius
                  IF following_block_text$="CR"
                    move_is_line!=FALSE
                    IF end_point_stored!
                      swap_pending_block(-1,-1,0)
                    ELSE
                      interpret_radius_arc(program_line$)
                    ENDIF
                  ELSE
                    ' a tangential polar circle
                    IF lookahead_third_block_text$="CTP"
                      move_is_line!=FALSE
                      IF end_point_stored!
                        swap_pending_block(-1,0,0)
                      ELSE
                        interpret_polar_tangential_arc(program_line$)
                      ENDIF
                    ELSE
                      ' jump to the label line in label_blocks&() and go on there
                      IF line_head_eight$="CALL LBL"
                        block_moves_tool!=FALSE
                        current_block&=label_blocks&(VAL(MID$(program_line$,11,3)))
                        find_lookahead_blocks
                      ELSE
                        ' datum shift
                        IF LEFT$(program_line$,10)="CYCL DEF 7"
                          block_moves_tool!=FALSE
                          cycle_datum_shift
                        ELSE
                          ' mirror image
                          IF LEFT$(program_line$,10)="CYCL DEF 8"
                            block_moves_tool!=FALSE
                            cycle_mirror_image
                          ELSE
                            ' rotation
                            IF LEFT$(program_line$,11)="CYCL DEF 10"
                              block_moves_tool!=FALSE
                              cycle_rotation
                            ELSE
                              ' scaling
                              IF LEFT$(program_line$,11)="CYCL DEF 11"
                                block_moves_tool!=FALSE
                                apply_scaling_cycle
                              ELSE
                                ' any other cycle definition: no move
                                IF LEFT$(program_line$,9)="CYCL DEF"
                                  block_moves_tool!=FALSE
                                ELSE
                                  ' Q parameter assignment, Q number in columns 10-12
                                  IF line_head_five$="FN 0 "
                                    block_moves_tool!=FALSE
                                    rect_width&=VAL(MID$(program_line$,10,3))
                                    q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)
                                    q_parameter_defined!(rect_width&)=TRUE
                                  ELSE
                                    ' addition
                                    IF line_head_five$="FN 1 "
                                      block_moves_tool!=FALSE
                                      rect_width&=VAL(MID$(program_line$,10,3))
                                      q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)+@read_number_or_parameter(program_line$,31)
                                      q_parameter_defined!(rect_width&)=TRUE
                                    ELSE
                                      ' subtraction
                                      IF line_head_five$="FN 2 "
                                        block_moves_tool!=FALSE
                                        rect_width&=VAL(MID$(program_line$,10,3))
                                        q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)-@read_number_or_parameter(program_line$,31)
                                        q_parameter_defined!(rect_width&)=TRUE
                                      ELSE
                                        ' multiplication
                                        IF line_head_five$="FN 3 "
                                          block_moves_tool!=FALSE
                                          rect_width&=VAL(MID$(program_line$,10,3))
                                          q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)*@read_number_or_parameter(program_line$,31)
                                          q_parameter_defined!(rect_width&)=TRUE
                                        ELSE
                                          ' division
                                          IF line_head_five$="FN 4 "
                                            block_moves_tool!=FALSE
                                            basic_variables=@read_number_or_parameter(program_line$,31)
                                            rect_width&=VAL(MID$(program_line$,10,3))
                                            IF basic_variables=0
                                              ' "division by zero is not allowed", Abort or Continue
                                              ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                              ' Abort: stop with an error on this line
                                              IF alert_button|=1
                                                run_aborted!=TRUE
                                                error_blocks&(0)=current_block&
                                                error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                              ENDIF
                                              q_parameters(rect_width&)=0
                                            ELSE
                                              q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)/basic_variables
                                              q_parameter_defined!(rect_width&)=TRUE
                                            ENDIF
                                          ELSE
                                            ' square root
                                            IF line_head_five$="FN 5 "
                                              block_moves_tool!=FALSE
                                              basic_variables=@read_number_or_parameter(program_line$,22)
                                              IF basic_variables<0
                                                ALERT 3,"Wurzel aus einer|negativen Zahl|nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                IF alert_button|=1
                                                  run_aborted!=TRUE
                                                  error_blocks&(0)=current_block&
                                                  error_messages$(0)="WURZEL AUS EINER NEGATIVEN ZAHL NICHT ERLAUBT!"
                                                ENDIF
                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                q_parameters(rect_width&)=0
                                                q_parameter_defined!(rect_width&)=TRUE
                                              ELSE
                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                q_parameters(rect_width&)=SQR(basic_variables)
                                                q_parameter_defined!(rect_width&)=TRUE
                                              ENDIF
                                            ELSE
                                              ' sine (degrees)
                                              IF line_head_five$="FN 6 "
                                                block_moves_tool!=FALSE
                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                q_parameters(rect_width&)=SIN(RAD(@read_number_or_parameter(program_line$,22)))
                                                q_parameter_defined!(rect_width&)=TRUE
                                              ELSE
                                                ' cosine (degrees)
                                                IF line_head_five$="FN 7 "
                                                  block_moves_tool!=FALSE
                                                  rect_width&=VAL(MID$(program_line$,10,3))
                                                  q_parameters(rect_width&)=COS(RAD(@read_number_or_parameter(program_line$,22)))
                                                  q_parameter_defined!(rect_width&)=TRUE
                                                ELSE
                                                  ' root of a sum of squares
                                                  IF line_head_five$="FN 8 "
                                                    block_moves_tool!=FALSE
                                                    segment_length=@read_number_or_parameter(program_line$,17)
                                                    second_operand=@read_number_or_parameter(program_line$,31)
                                                    rect_width&=VAL(MID$(program_line$,10,3))
                                                    q_parameters(rect_width&)=SQR(segment_length*segment_length+second_operand*second_operand)
                                                    q_parameter_defined!(rect_width&)=TRUE
                                                  ELSE
                                                    ' conditional jumps (equal, not equal, greater, less)
                                                    IF (line_head_five$="FN 9 ") OR (line_head_five$="FN 10") OR (line_head_five$="FN 11") OR (line_head_five$="FN 12")
                                                      block_moves_tool!=FALSE
                                                      segment_length=@read_number_or_parameter(program_line$,13)
                                                      second_operand=@read_number_or_parameter(program_line$,27)
                                                      ' the condition holds: jump to the label from column 45
                                                      IF segment_length=second_operand AND (line_head_five$="FN 9 ") OR (segment_length<>second_operand AND (line_head_five$="FN 10")) OR (segment_length>second_operand AND (line_head_five$="FN 11")) OR (segment_length<second_operand AND (line_head_five$="FN 12"))
                                                        current_block&=label_blocks&(VAL(MID$(program_line$,45,3)))
                                                        find_lookahead_blocks
                                                      ENDIF
                                                    ELSE
                                                      ' angle from two values (arc tangent)
                                                      IF line_head_five$="FN 13"
                                                        block_moves_tool!=FALSE
                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                        segment_length=@read_number_or_parameter(program_line$,17)
                                                        second_operand=@read_number_or_parameter(program_line$,31)
                                                        IF segment_length=0 AND second_operand=0
                                                          ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                          IF alert_button|=1
                                                            run_aborted!=TRUE
                                                            error_blocks&(0)=current_block&
                                                            error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                          ENDIF
                                                          q_parameters(rect_width&)=0
                                                        ELSE
                                                          IF segment_length=0
                                                            q_parameters(rect_width&)=0
                                                            q_parameter_defined!(rect_width&)=TRUE
                                                          ELSE
                                                            IF second_operand=0
                                                              q_parameters(rect_width&)=DEG(ASIN(segment_length))
                                                              q_parameter_defined!(rect_width&)=TRUE
                                                            ELSE
                                                              q_parameters(rect_width&)=ATN(segment_length/second_operand)
                                                              q_parameters(rect_width&)=DEG(q_parameters(rect_width&))
                                                              q_parameter_defined!(rect_width&)=TRUE
                                                            ENDIF
                                                          ENDIF
                                                        ENDIF
                                                      ELSE
                                                        ' error number: no move
                                                        IF line_head_five$="FN 14"
                                                          block_moves_tool!=FALSE
                                                        ELSE
                                                          ' print: no move
                                                          IF line_head_five$="FN 15"
                                                            block_moves_tool!=FALSE
                                                          ELSE
                                                            is_finished!=TRUE
                                                          ENDIF
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ENDIF
                                                ENDIF
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                        ENDIF
                                      ENDIF
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' the block may have moved the tool
    IF block_moves_tool!
      direction_x=end_point(first_plane_axis|)-start_point(first_plane_axis|)
      direction_y=end_point(second_plane_axis|)-start_point(second_plane_axis|)
      ' it moved in the working plane: found the next move
      IF direction_x<>0 OR direction_y<>0
        is_finished!=TRUE
      ENDIF
    ENDIF
    ' move the line window on by one line
    current_block&=next_block&
    next_block&=block_after_next&
    block_after_next&=third_block_ahead&
    skip_to_next_block(third_block_ahead&)
    ' end of program, move found, error or end of subprogram
  UNTIL current_block&=last_line& OR is_finished! OR run_aborted! OR (LEFT$(program_lines$(current_block&),11)="LBL       0")
RETURN
' pending_store!=TRUE saves the simulation state, FALSE restores it: the line pointers
' current_draw_block&/current_block&/next_block&/block_after_next&/third_block_ahead&, the axes of the pending
' move, the position and move point arrays (start_point, previous_block_start, end_point, move_end,
' programmed_position, rotated_position, circle_centre, previous_centre, start_tangent, datum_shift,
' datum_shift_in_plane), the transformation axes (rotated_first_axis to previous_datum_second_axis), the
' compensation strings and the CYCL DEF 7/8/10/11 transformation flags and values. Used around
' find_next_contour_move, which runs the program ahead.
PROCEDURE save_restore_simulation_state(pending_store!)
  ' save
  IF pending_store!
    MAT CPY spare_float_table()=q_parameters()
    saved_current_block&=current_draw_block&
    saved_scan_line&=current_block&
    saved_next_line&=next_block&
    saved_second_line&=block_after_next&
    saved_third_line&=third_block_ahead&
    saved_pending_first_axis|=pending_first_axis|
    saved_pending_second_axis|=pending_second_axis|
    saved_pending_tool_axis|=pending_tool_axis|
    saved_position_x=start_point(1)
    saved_position_y=start_point(2)
    saved_position_z=start_point(3)
    saved_move_start_x=previous_block_start(1)
    saved_move_start_y=previous_block_start(2)
    saved_move_start_z=previous_block_start(3)
    saved_target_x=end_point(1)
    saved_target_y=end_point(2)
    saved_target_z=end_point(3)
    saved_move_end_x=move_end(1)
    saved_move_end_y=move_end(2)
    saved_move_end_z=move_end(3)
    saved_last_target_x=programmed_position(1)
    saved_last_target_y=programmed_position(2)
    saved_last_target_z=programmed_position(3)
    saved_plain_position_x=rotated_position(1)
    saved_plain_position_y=rotated_position(2)
    saved_plain_position_z=rotated_position(3)
    saved_circle_centre_x=circle_centre(1)
    saved_circle_centre_y=circle_centre(2)
    saved_arc_centre_x=previous_centre(1)
    saved_arc_centre_y=previous_centre(2)
    saved_datum_x=start_tangent(1)
    saved_datum_y=start_tangent(2)
    saved_datum_z=start_tangent(3)
    saved_shift_x=datum_shift(1)
    saved_shift_y=datum_shift(2)
    saved_shift_z=datum_shift(3)
    saved_plain_target_x=datum_shift_in_plane(1)
    saved_plain_target_y=datum_shift_in_plane(2)
    saved_plain_target_z=datum_shift_in_plane(3)
    saved_axis_u_x=rotated_first_axis(1)
    saved_axis_u_y=rotated_first_axis(2)
    saved_axis_u_z=rotated_first_axis(3)
    saved_last_axis_u_x=previous_rotated_first_axis(1)
    saved_last_axis_u_y=previous_rotated_first_axis(2)
    saved_last_axis_u_z=previous_rotated_first_axis(3)
    saved_axis_v_x=rotated_second_axis(1)
    saved_axis_v_y=rotated_second_axis(2)
    saved_axis_v_z=rotated_second_axis(3)
    saved_last_axis_v_x=previous_rotated_second_axis(1)
    saved_last_axis_v_y=previous_rotated_second_axis(2)
    saved_last_axis_v_z=previous_rotated_second_axis(3)
    saved_cycle_axis_u_x=datum_first_axis(1)
    saved_cycle_axis_u_y=datum_first_axis(2)
    saved_cycle_axis_u_z=datum_first_axis(3)
    saved_last_cycle_axis_u_x=previous_datum_first_axis(1)
    saved_last_cycle_axis_u_y=previous_datum_first_axis(2)
    saved_last_cycle_axis_u_z=previous_datum_first_axis(3)
    saved_cycle_axis_v_x=datum_second_axis(1)
    saved_cycle_axis_v_y=datum_second_axis(2)
    saved_cycle_axis_v_z=datum_second_axis(3)
    saved_last_cycle_axis_v_x=previous_datum_second_axis(1)
    saved_last_cycle_axis_v_y=previous_datum_second_axis(2)
    saved_last_cycle_axis_v_z=previous_datum_second_axis(3)
    saved_programmed_compensation$=radius_correction$
    saved_active_compensation$=compensation_side$
    saved_previous_compensation$=previous_compensation$
    saved_direction_param$=arc_direction$
    saved_datum_shift_on!=datum_shift_on!
    saved_mirror_x_on!=mirror_x!
    saved_mirror_y_on!=mirror_y!
    saved_mirror_z_on!=mirror_z!
    saved_mirror_reverses_arcs!=mirror_reverses_direction!
    saved_mirror_x_mode!=mirror_x_after_rotation!
    saved_mirror_y_mode!=mirror_y_after_rotation!
    saved_mirror_z_mode!=mirror_z_after_rotation!
    saved_rotation_on!=rotation_active!
    saved_rotation_angle=rotation_angle
    saved_rotation_extra=rotation_spare_value
    saved_scaling_on!=scaling_active!
    saved_scale_factor=scaling_factor
    saved_line_pending!=after_line_element!
    saved_arc_pending!=arc_pending!
    saved_extra_flag!=state_extra_flag!
  ELSE
    MAT CPY q_parameters()=spare_float_table()
    ' restore everything saved above
    current_draw_block&=saved_current_block&
    current_block&=saved_scan_line&
    next_block&=saved_next_line&
    block_after_next&=saved_second_line&
    third_block_ahead&=saved_third_line&
    pending_first_axis|=saved_pending_first_axis|
    pending_second_axis|=saved_pending_second_axis|
    pending_tool_axis|=saved_pending_tool_axis|
    start_point(1)=saved_position_x
    start_point(2)=saved_position_y
    start_point(3)=saved_position_z
    previous_block_start(1)=saved_move_start_x
    previous_block_start(2)=saved_move_start_y
    previous_block_start(3)=saved_move_start_z
    end_point(1)=saved_target_x
    end_point(2)=saved_target_y
    end_point(3)=saved_target_z
    move_end(1)=saved_move_end_x
    move_end(2)=saved_move_end_y
    move_end(3)=saved_move_end_z
    programmed_position(1)=saved_last_target_x
    programmed_position(2)=saved_last_target_y
    programmed_position(3)=saved_last_target_z
    rotated_position(1)=saved_plain_position_x
    rotated_position(2)=saved_plain_position_y
    rotated_position(3)=saved_plain_position_z
    circle_centre(1)=saved_circle_centre_x
    circle_centre(2)=saved_circle_centre_y
    previous_centre(1)=saved_arc_centre_x
    previous_centre(2)=saved_arc_centre_y
    start_tangent(1)=saved_datum_x
    start_tangent(2)=saved_datum_y
    start_tangent(3)=saved_datum_z
    datum_shift(1)=saved_shift_x
    datum_shift(2)=saved_shift_y
    datum_shift(3)=saved_shift_z
    datum_shift_in_plane(1)=saved_plain_target_x
    datum_shift_in_plane(2)=saved_plain_target_y
    datum_shift_in_plane(3)=saved_plain_target_z
    rotated_first_axis(1)=saved_axis_u_x
    rotated_first_axis(2)=saved_axis_u_y
    rotated_first_axis(3)=saved_axis_u_z
    previous_rotated_first_axis(1)=saved_last_axis_u_x
    previous_rotated_first_axis(2)=saved_last_axis_u_y
    previous_rotated_first_axis(3)=saved_last_axis_u_z
    rotated_second_axis(1)=saved_axis_v_x
    rotated_second_axis(2)=saved_axis_v_y
    rotated_second_axis(3)=saved_axis_v_z
    previous_rotated_second_axis(1)=saved_last_axis_v_x
    previous_rotated_second_axis(2)=saved_last_axis_v_y
    previous_rotated_second_axis(3)=saved_last_axis_v_z
    datum_first_axis(1)=saved_cycle_axis_u_x
    datum_first_axis(2)=saved_cycle_axis_u_y
    datum_first_axis(3)=saved_cycle_axis_u_z
    previous_datum_first_axis(1)=saved_last_cycle_axis_u_x
    previous_datum_first_axis(2)=saved_last_cycle_axis_u_y
    previous_datum_first_axis(3)=saved_last_cycle_axis_u_z
    datum_second_axis(1)=saved_cycle_axis_v_x
    datum_second_axis(2)=saved_cycle_axis_v_y
    datum_second_axis(3)=saved_cycle_axis_v_z
    previous_datum_second_axis(1)=saved_last_cycle_axis_v_x
    previous_datum_second_axis(2)=saved_last_cycle_axis_v_y
    previous_datum_second_axis(3)=saved_last_cycle_axis_v_z
    radius_correction$=saved_programmed_compensation$
    compensation_side$=saved_active_compensation$
    previous_compensation$=saved_previous_compensation$
    arc_direction$=saved_direction_param$
    datum_shift_on!=saved_datum_shift_on!
    mirror_x!=saved_mirror_x_on!
    mirror_y!=saved_mirror_y_on!
    mirror_z!=saved_mirror_z_on!
    mirror_reverses_direction!=saved_mirror_reverses_arcs!
    mirror_x_after_rotation!=saved_mirror_x_mode!
    mirror_y_after_rotation!=saved_mirror_y_mode!
    mirror_z_after_rotation!=saved_mirror_z_mode!
    rotation_active!=saved_rotation_on!
    rotation_angle=saved_rotation_angle
    rotation_spare_value=saved_rotation_extra
    scaling_active!=saved_scaling_on!
    scaling_factor=saved_scale_factor
    after_line_element!=saved_line_pending!
    arc_pending!=saved_arc_pending!
    state_extra_flag!=saved_extra_flag!
  ENDIF
RETURN
' The simulation draws every move one step late, so that the radius-compensated end of a move and the corner to
' the next one are known when it is drawn. This takes the new move (move_is_line!=TRUE a line, FALSE an arc,
' arc_direction$ the arc direction "+"/"-", line_index& its block number), draws the move still pending with
' simulate_line_move (line, after_line_element!) or simulate_arc_move (arc, arc_pending!) in the axes it was
' programmed in (pending_first_axis|/pending_second_axis|/pending_tool_axis|), then makes the new move the
' pending one: its start previous_block_start() is the old end, its end move_end() the new target end_point(),
' and for an arc the centre previous_centre() is taken from circle_centre(). Restores the plane axes
' first_plane_axis|/second_plane_axis|/infeed_axis| to the main plane afterwards and sets current_draw_block& to
' line_index&.
PROCEDURE queue_simulated_move(line_index&,arc_direction$,move_is_line!)
  LOCAL saved_first_axis|,saved_second_axis|,saved_tool_axis|
  ON MENU
  ' keep the axes of the new move
  saved_first_axis|=first_plane_axis|
  saved_second_axis|=second_plane_axis|
  saved_tool_axis|=infeed_axis|
  ' the new move is a line
  IF move_is_line!
    ' a line is pending: draw it in its own axes
    IF after_line_element!
      first_plane_axis|=pending_first_axis|
      second_plane_axis|=pending_second_axis|
      infeed_axis|=pending_tool_axis|
      simulate_line_move(line_index&,arc_direction$,move_is_line!)
      previous_block_start(1)=move_end(1)
      previous_block_start(2)=move_end(2)
      previous_block_start(3)=move_end(3)
    ELSE
      ' an arc is pending: draw it
      IF arc_pending!
        first_plane_axis|=pending_first_axis|
        second_plane_axis|=pending_second_axis|
        infeed_axis|=pending_tool_axis|
        simulate_arc_move(line_index&,arc_direction$,move_is_line!)
        ' nothing pending: the line just becomes pending, starting at the current position
        after_line_element!=TRUE
        arc_pending!=FALSE
        previous_block_start(1)=move_end(1)
        previous_block_start(2)=move_end(2)
        previous_block_start(3)=move_end(3)
      ELSE
        after_line_element!=TRUE
        previous_block_start(1)=start_point(1)
        previous_block_start(2)=start_point(2)
        previous_block_start(3)=start_point(3)
      ENDIF
    ENDIF
    ' the target becomes the position and the end of the pending move
    start_point(1)=end_point(1)
    start_point(2)=end_point(2)
    start_point(3)=end_point(3)
    move_end(1)=end_point(1)
    move_end(2)=end_point(2)
    move_end(3)=end_point(3)
  ELSE
    ' the new move is an arc; a line is pending: draw it
    IF after_line_element!
      first_plane_axis|=pending_first_axis|
      second_plane_axis|=pending_second_axis|
      infeed_axis|=pending_tool_axis|
      compensation_side$=radius_correction$
      simulate_line_move(line_index&,arc_direction$,move_is_line!)
      after_line_element!=FALSE
      arc_pending!=TRUE
      previous_block_start(1)=move_end(1)
      previous_block_start(2)=move_end(2)
      previous_block_start(3)=move_end(3)
    ELSE
      IF arc_pending!
        first_plane_axis|=pending_first_axis|
        second_plane_axis|=pending_second_axis|
        infeed_axis|=pending_tool_axis|
        simulate_arc_move(line_index&,arc_direction$,move_is_line!)
        previous_block_start(1)=move_end(1)
        previous_block_start(2)=move_end(2)
        previous_block_start(3)=move_end(3)
      ELSE
        arc_pending!=TRUE
        previous_block_start(1)=start_point(1)
        previous_block_start(2)=start_point(2)
        previous_block_start(3)=start_point(3)
      ENDIF
    ENDIF
    start_point(1)=end_point(1)
    start_point(2)=end_point(2)
    start_point(3)=end_point(3)
    move_end(1)=end_point(1)
    move_end(2)=end_point(2)
    move_end(3)=end_point(3)
    ' the arc centre of the pending arc
    previous_centre(1)=circle_centre(1)
    previous_centre(2)=circle_centre(2)
    previous_centre(3)=circle_centre(3)
    move_arc_direction$=arc_direction$
  ENDIF
  ' the new move's axes are now the pending axes
  pending_first_axis|=saved_first_axis|
  pending_second_axis|=saved_second_axis|
  pending_tool_axis|=saved_tool_axis|
  ' back to the main plane
  first_plane_axis|=tool_first_axis|
  second_plane_axis|=tool_second_axis|
  infeed_axis|=depth_axis|
  compensation_side$=radius_correction$
  skip_arc_layers!=rnd_ends_at_corner!
  current_draw_block&=line_index&
  ON MENU
RETURN
' Draws the pending straight move from previous_block_start() to move_end() in the simulation window. Shows
' "aktueller Satz" (current block) in the status line, works out the radius-compensated start
' move_compensated_start() and end move_compensated_end() from the compensation
' previous_compensation$/compensation_side$ ("0", "L" or "R") and the tool radius tool_radius, and asks
' compensate_tool_radius for the corner to the next move. In contour mode (in_subprogram_call!) the move only
' goes into the contour list (store_generated_line). Otherwise the move is drawn into the off-screen work
' bitmap: a plunge as a filled circle, in the wireframe view (wireframe_view!) as a line, else as a cut through
' each depth layer depth_level_table() the move crosses, each layer painted into its own layer bitmap
' layer_bitmaps%() and the layers merged with their fill patterns into the view. The changed rectangle is then
' copied to the window (through the AES rectangle list) and the tool sprite moved. In single step it waits for
' Return/Enter or Space (Space sets stop_requested!: stop). Draws the outside corner arc with
' draw_corner_transition_arc when corner_arc_needed! is set, and handles the end of a rounding
' (rounding_active!) and of a compensation (cancel_compensation!).
PROCEDURE simulate_line_move(line_index&,arc_direction$,move_is_line!)
  LOCAL segment_length,start_u,start_v,start_depth,end_u,end_v,end_depth,direction_x,direction_y,depth_delta,box_margin&,double_margin&,from_layer|,to_layer|,loop_index|,scan_column|,screen_x&,screen_y&,box_width&,box_height&,spare_left&,spare_top&,spare_right&,spare_bottom&,window_left&,window_top&,window_right&,window_bottom&,draw_centre_line!,discriminant,line_angle,stripe_dx&,stripe_dy&,stripe_left_dx&,stripe_left_dy&,stripe_right_dx&,stripe_right_dy&,line_fraction,end_x&,end_y&,layers_descending!,segment_visible!,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,spare_x&,spare_y&,outer_left&,outer_top&,outer_right&,outer_bottom&,draw_segment!,alert_button|,is_finished!,offset_scale,work_text$,next_line_dx,next_line_dy,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  corner_arc_needed!=FALSE
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' plain simulation, not inside an SL cycle: show the block in the status line
  IF (NOT rough_out_cycle_active!) AND (NOT in_subprogram_call!) AND (NOT contour_cycle_active!) AND current_draw_block&>0
    ' draw into the off-screen screen
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    DEFFILL ,0,0
    PBOX 0,char_cell_height|,work_w&,MUL(char_cell_height|,2)
    DEFFILL ,1,1
    IF wireframe_view!
      ' ";current_draw_block&; / ELSE
      PRINT AT(text_column&+1,2);"aktueller Satz : ";current_draw_block&;
    ELSE
      ' ";STR$(current_draw_block&);'program_lines$(current_draw_block&); / ENDIF
      PRINT AT(text_column&+1,2);"aktueller Satz : ";STR$(current_draw_block&);'program_lines$(current_draw_block&);
    ENDIF
    ' back to the real screen; copy the status line to the window
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    redraw_x&=work_x&
    redraw_y&=work_y&+char_cell_height|
    redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
    redraw_height&=char_cell_height|
    IF redraw_x&<screen_width& AND redraw_y&<screen_height&
      ' first rectangle of the window's rectangle list
      ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
      ' the part of it inside the changed area
      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
        IF screen_x&+rect_width&>screen_width&
          rect_width&=screen_width&-screen_x&
        ENDIF
        IF screen_y&+rect_height&>screen_height&
          rect_height&=screen_height&-screen_y&
        ENDIF
        DEC rect_width&
        DEC rect_height&
        blit_params%(0)=screen_x&
        blit_params%(1)=screen_y&
        blit_params%(2)=screen_x&+rect_width&
        blit_params%(3)=screen_y&+rect_height&
        blit_params%(4)=screen_x&
        blit_params%(5)=screen_y&
        blit_params%(6)=screen_x&+rect_width&
        blit_params%(7)=screen_y&+rect_height&
        blit_params%(8)=3
        ' copy that part from the off-screen screen to the screen
        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
      ENDIF
      ' the next rectangles, until an empty one
      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WHILE rect_height&<>0 OR rect_width&<>0
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WEND
    ENDIF
  ENDIF
  ' the move in the plane (direction_x, direction_y) and along the tool axis (depth_delta)
  direction_x=move_end(first_plane_axis|)-previous_block_start(first_plane_axis|)
  direction_y=move_end(second_plane_axis|)-previous_block_start(second_plane_axis|)
  depth_delta=move_end(infeed_axis|)-previous_block_start(infeed_axis|)
  IF .0001>ABS(direction_x)
    direction_x=0
  ENDIF
  IF .0001>ABS(direction_y)
    direction_y=0
  ENDIF
  ' start or end below the workpiece top: the tool cuts
  IF blank_top>move_end(infeed_axis|) OR blank_top>previous_block_start(infeed_axis|)
    ' a plunge: compensation does not shift it
    IF direction_x=0 AND direction_y=0
      move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
      move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
      move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
      move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
    ELSE
      ' the length of the move in the plane
      segment_length=SQR(direction_x*direction_x+direction_y*direction_y)
      ' tool radius per unit length, for the offset at right angles to the move
      offset_scale=tool_radius/segment_length
      ' the start is not compensated
      IF previous_compensation$="0"
        move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
        move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
      ELSE
        ' the corner routine already gave the compensated start in compensated_start()
        IF corner_point_moved!
          move_compensated_start(1)=compensated_start(1)
          move_compensated_start(2)=compensated_start(2)
          move_compensated_start(3)=compensated_start(3)
        ELSE
          ' RL: offset the start to the left of the direction of travel
          IF previous_compensation$="L"
            IF direction_x=0
              IF direction_y>0
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-tool_radius
              ELSE
                move_compensated_start(first_plane_axis|)=tool_radius+previous_block_start(first_plane_axis|)
              ENDIF
              move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x<0
                  move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-tool_radius
                ELSE
                  move_compensated_start(second_plane_axis|)=tool_radius+previous_block_start(second_plane_axis|)
                ENDIF
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
              ELSE
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-direction_y*offset_scale
                move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)+direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            ' RR: offset the start to the right
            IF previous_compensation$="R"
              IF direction_x=0
                IF direction_y<0
                  move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-tool_radius
                ELSE
                  move_compensated_start(first_plane_axis|)=tool_radius+previous_block_start(first_plane_axis|)
                ENDIF
                move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
              ELSE
                IF direction_y=0
                  IF direction_x>0
                    move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-tool_radius
                  ELSE
                    move_compensated_start(second_plane_axis|)=tool_radius+previous_block_start(second_plane_axis|)
                  ENDIF
                  move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
                ELSE
                  move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)+direction_y*offset_scale
                  move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-direction_x*offset_scale
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      ' the end is not compensated
      IF compensation_side$="0"
        move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
        move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
      ELSE
        ' the corner end is known from compensated_end()
        IF corner_point_moved! AND ((NOT move_is_line!) OR direction_x<>0 OR direction_y<>0)
          move_compensated_end(1)=compensated_end(1)
          move_compensated_end(2)=compensated_end(2)
          move_compensated_end(3)=compensated_end(3)
        ELSE
          ' RL: offset the end to the left
          IF compensation_side$="L"
            IF direction_x=0
              IF direction_y>0
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-tool_radius
              ELSE
                move_compensated_end(first_plane_axis|)=tool_radius+move_end(first_plane_axis|)
              ENDIF
              move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x<0
                  move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-tool_radius
                ELSE
                  move_compensated_end(second_plane_axis|)=tool_radius+move_end(second_plane_axis|)
                ENDIF
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
              ELSE
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-direction_y*offset_scale
                move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)+direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            ' RR: offset the end to the right
            IF compensation_side$="R"
              IF direction_x=0
                IF direction_y<0
                  move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-tool_radius
                ELSE
                  move_compensated_end(first_plane_axis|)=tool_radius+move_end(first_plane_axis|)
                ENDIF
                move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
              ELSE
                IF direction_y=0
                  IF direction_x>0
                    move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-tool_radius
                  ELSE
                    move_compensated_end(second_plane_axis|)=tool_radius+move_end(second_plane_axis|)
                  ENDIF
                  move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
                ELSE
                  move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)+direction_y*offset_scale
                  move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-direction_x*offset_scale
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' draw this move
    draw_segment!=TRUE
    ' compensation goes on into the next move
    IF (compensation_side$<>"0") AND (NOT cancel_compensation!)
      IF direction_x=0 AND direction_y=0
        work_text$=LEFT$(program_lines$(current_block&))
        ' a plunge followed by a move that continues the contour: drawn with it
        IF (work_text$="L") AND (MID$(program_lines$(current_block&),7,1)<>"A") AND LEN(program_lines$(current_block&))>20 OR (work_text$="C")
          draw_segment!=FALSE
        ENDIF
      ELSE
        ' work out the corner to the next move (sets compensated_start(), compensated_end(), corner_point_moved!,
        ' corner_arc_needed!)
        compensate_tool_radius(line_index&,0,arc_direction$,-1,move_is_line!)
      ENDIF
    ELSE
      corner_point_moved!=FALSE
    ENDIF
    ' contour mode: only record the move in the contour list
    IF in_subprogram_call!
      store_generated_line(current_draw_block&,move_compensated_end(first_plane_axis|),move_compensated_end(second_plane_axis|))
    ELSE
      ' draw it
      IF draw_segment!
        ' the compensated start (start_u,start_v,start_depth) and end (end_u,end_v,end_depth)
        start_u=move_compensated_start(first_plane_axis|)
        start_v=move_compensated_start(second_plane_axis|)
        start_depth=previous_block_start(infeed_axis|)
        end_u=move_compensated_end(first_plane_axis|)
        end_v=move_compensated_end(second_plane_axis|)
        end_depth=move_end(infeed_axis|)
        direction_x=end_u-start_u
        direction_y=end_v-start_v
        ' margin round the tool circle
        box_margin&=tool_radius_pixels&+4
        double_margin&=box_margin&*2
        ' depth layer of the start: from_layer|
        IF start_depth<=blank_bottom
          from_layer|=1
        ELSE
          IF start_depth>=blank_top
            from_layer|=top_level|
          ELSE
            loop_index|=FALSE
            REPEAT
              INC loop_index|
            UNTIL loop_index|=layer_depth_count| OR (start_depth>depth_level_table(loop_index|) AND start_depth<=depth_level_table(SUCC(loop_index|)))
            from_layer|=SUCC(loop_index|)
          ENDIF
        ENDIF
        ' depth layer of the end: to_layer|
        IF end_depth<=blank_bottom
          to_layer|=1
        ELSE
          IF end_depth>=blank_top
            to_layer|=top_level|
          ELSE
            loop_index|=FALSE
            REPEAT
              INC loop_index|
            UNTIL loop_index|=layer_depth_count| OR (end_depth>depth_level_table(loop_index|) AND end_depth<=depth_level_table(SUCC(loop_index|)))
            to_layer|=SUCC(loop_index|)
          ENDIF
        ENDIF
        IF ABS(start_u-end_u)>ABS(start_v-end_v)
          DEFLINE ,section_line_width|
        ELSE
          DEFLINE ,tool_diameter_pixels|
        ENDIF
        ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
        CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
        ' the tool only moves up: nothing to draw
        IF direction_x=0 AND direction_y=0 AND depth_delta>0
          segment_visible!=FALSE
        ELSE
          ' the move lies outside the view
          IF start_u<area_min_h AND end_u<area_min_h OR (start_u>area_max_h AND end_u>area_max_h) OR (start_v<area_min_v AND end_v<area_min_v) OR (start_v>area_max_v AND end_v>area_max_v)
            segment_visible!=FALSE
          ELSE
            IF 9.99999999999997E-06>ABS(direction_x) AND 9.99999999999997E-06>ABS(direction_y) AND depth_delta<=0 AND to_layer|<top_level|
              ' a plunge: draw the tool circle at the start
              segment_visible!=TRUE
              screen_x&=ROUND(start_u*view_scale)-origin_x_pixels&
              screen_y&=-ROUND(start_v*view_scale)-origin_y_pixels&
              box_left&=screen_x&-box_margin&
              IF box_left&<work_min_x&
                box_left&=work_min_x&
              ENDIF
              IF box_left&>work_max_x&
                box_left&=work_max_x&
              ENDIF
              box_top&=screen_y&-box_margin&
              IF box_top&<work_min_y&
                box_top&=work_min_y&
              ENDIF
              IF box_top&>work_max_y&
                box_top&=work_max_y&
              ENDIF
              box_right&=screen_x&+box_margin&
              IF box_right&<work_min_x&
                box_right&=work_min_x&
              ENDIF
              IF box_right&>work_max_x&
                box_right&=work_max_x&
              ENDIF
              box_bottom&=screen_y&+box_margin&
              IF box_bottom&<work_min_y&
                box_bottom&=work_min_y&
              ENDIF
              IF box_bottom&>work_max_y&
                box_bottom&=work_max_y&
              ENDIF
              DEFFILL ,0,0
              PBOX box_left&,box_top&,box_right&,box_bottom&
              BOUNDARY 1
              DEFFILL ,1,1
              IF wireframe_view!
                PCIRCLE screen_x&,screen_y&,1
                layer_mfdb%(0)=layer_bitmaps%(1)
              ELSE
                layer_used!(to_layer|)=TRUE
                PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
                layer_mfdb%(0)=layer_bitmaps%(to_layer|)
              ENDIF
              bitmap_left&=box_left&+layer_offset_x&
              bitmap_top&=box_top&+layer_offset_y&
              bitmap_right&=box_right&+layer_offset_x&
              bitmap_bottom&=box_bottom&+layer_offset_y&
              window_left&=box_left&+work_offset_x&
              window_top&=box_top&+work_offset_y&
              window_right&=box_right&+work_offset_x&
              window_bottom&=box_bottom&+work_offset_y&
              blit_params%(0)=window_left&
              blit_params%(1)=window_top&
              blit_params%(2)=window_right&
              blit_params%(3)=window_bottom&
              blit_params%(4)=bitmap_left&
              blit_params%(5)=bitmap_top&
              blit_params%(6)=bitmap_right&
              blit_params%(7)=bitmap_bottom&
              blit_params%(8)=7
              BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            ELSE
              ' the start is above the workpiece: move it along the line to the top
              IF from_layer|=top_level| AND depth_delta<>0
                DEC from_layer|
                line_fraction=(blank_top-start_depth)/depth_delta
                start_u=start_u+line_fraction*direction_x
                start_v=start_v+line_fraction*direction_y
                start_depth=blank_top
              ENDIF
              ' clip the start to the view (left, right, bottom, top)
              IF start_u<area_min_h
                line_fraction=(area_min_h-start_u)/direction_x
                start_u=area_min_h
                start_v=start_v+line_fraction*direction_y
                start_depth=start_depth+line_fraction*depth_delta
              ELSE
                IF start_u>area_max_h
                  line_fraction=(area_max_h-start_u)/direction_x
                  start_u=area_max_h
                  start_v=start_v+line_fraction*direction_y
                  start_depth=start_depth+line_fraction*depth_delta
                ENDIF
              ENDIF
              IF start_v<area_min_v
                line_fraction=(area_min_v-start_v)/direction_y
                start_u=start_u+line_fraction*direction_x
                start_v=area_min_v
                start_depth=start_depth+line_fraction*depth_delta
              ELSE
                IF start_v>area_max_v
                  line_fraction=(area_max_v-start_v)/direction_y
                  start_u=start_u+line_fraction*direction_x
                  start_v=area_max_v
                  start_depth=start_depth+line_fraction*depth_delta
                ENDIF
              ENDIF
              ' the end is above the workpiece: move it back to the top
              IF to_layer|=top_level| AND depth_delta<>0
                DEC to_layer|
                line_fraction=(blank_top-end_depth)/depth_delta
                end_u=end_u+line_fraction*direction_x
                end_v=end_v+line_fraction*direction_y
                end_depth=blank_top
              ENDIF
              ' clip the end to the view
              IF end_u<area_min_h
                line_fraction=(area_min_h-end_u)/direction_x
                end_u=area_min_h
                end_v=end_v+line_fraction*direction_y
                end_depth=end_depth+line_fraction*depth_delta
              ELSE
                IF end_u>area_max_h
                  line_fraction=(area_max_h-end_u)/direction_x
                  end_u=area_max_h
                  end_v=end_v+line_fraction*direction_y
                  end_depth=end_depth+line_fraction*depth_delta
                ENDIF
              ENDIF
              IF end_v<area_min_v
                line_fraction=(area_min_v-end_v)/direction_y
                end_u=end_u+line_fraction*direction_x
                end_v=area_min_v
                end_depth=end_depth+line_fraction*depth_delta
              ELSE
                IF end_v>area_max_v
                  line_fraction=(area_max_v-end_v)/direction_y
                  end_u=end_u+line_fraction*direction_x
                  end_v=area_max_v
                  end_depth=end_depth+line_fraction*depth_delta
                ENDIF
              ENDIF
              ' something to draw
              segment_visible!=TRUE
              ' wireframe view: draw the move as a single line
              IF wireframe_view!
                screen_x&=ROUND(start_u*view_scale)-origin_x_pixels&
                screen_y&=-ROUND(start_v*view_scale)-origin_y_pixels&
                end_x&=ROUND(end_u*view_scale)-origin_x_pixels&
                end_y&=-ROUND(end_v*view_scale)-origin_y_pixels&
                box_width&=double_margin&+ABS(screen_x&-end_x&)
                box_height&=double_margin&+ABS(screen_y&-end_y&)
                IF screen_x&<end_x&
                  box_left&=screen_x&
                ELSE
                  box_left&=end_x&
                ENDIF
                SUB box_left&,box_margin&
                IF box_left&<work_min_x&
                  box_left&=work_min_x&
                ELSE
                  IF box_left&>work_max_x&
                    box_left&=work_max_x&
                  ENDIF
                ENDIF
                IF screen_y&<end_y&
                  box_top&=screen_y&
                ELSE
                  box_top&=end_y&
                ENDIF
                SUB box_top&,box_margin&
                IF box_top&<work_min_y&
                  box_top&=work_min_y&
                ELSE
                  IF box_top&>work_max_y&
                    box_top&=work_max_y&
                  ENDIF
                ENDIF
                box_right&=box_left&+box_width&
                IF box_right&>work_max_x&
                  box_right&=work_max_x&
                ENDIF
                box_bottom&=box_top&+box_height&
                IF box_bottom&>work_max_y&
                  box_bottom&=work_max_y&
                ENDIF
                DEFFILL ,0,0
                BOUNDARY 0
                PBOX box_left&,box_top&,box_right&,box_bottom&
                BOUNDARY 1
                DEFFILL ,1,1
                DRAW screen_x&,screen_y&,end_x&,end_y&
                bitmap_left&=box_left&+layer_offset_x&
                bitmap_top&=box_top&+layer_offset_y&
                bitmap_right&=box_right&+layer_offset_x&
                bitmap_bottom&=box_bottom&+layer_offset_y&
                window_left&=box_left&+work_offset_x&
                window_top&=box_top&+work_offset_y&
                window_right&=box_right&+work_offset_x&
                window_bottom&=box_bottom&+work_offset_y&
                layer_mfdb%(0)=layer_bitmaps%(1)
                blit_params%(0)=window_left&
                blit_params%(1)=window_top&
                blit_params%(2)=window_right&
                blit_params%(3)=window_bottom&
                blit_params%(4)=bitmap_left&
                blit_params%(5)=bitmap_top&
                blit_params%(6)=bitmap_right&
                blit_params%(7)=bitmap_bottom&
                blit_params%(8)=7
                BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                IF rough_out_cycle_active!
                  layer_mfdb%(0)=graphic_buffer%
                  BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                ENDIF
              ELSE
                ' draw the centre line of the cut
                IF ODD(stripe_mode|) OR stripe_mode|=0
                  draw_centre_line!=TRUE
                ELSE
                  draw_centre_line!=FALSE
                ENDIF
                ' stripes for a wide tool: the angle of the move
                IF stripe_mode|
                  discriminant=SQR(direction_x*direction_x+direction_y*direction_y)
                  line_angle=direction_x/discriminant
                  line_angle=@clamped_arc_cosine(line_angle)
                  IF direction_y<0
                    line_angle=two_pi-line_angle
                  ENDIF
                ENDIF
                ' going down through the layers (or level), else up
                IF from_layer|>=to_layer|
                  layers_descending!=TRUE
                  loop_index|=SUCC(from_layer|)
                ELSE
                  layers_descending!=FALSE
                  loop_index|=PRED(from_layer|)
                ENDIF
                segment_u=start_u
                segment_v=start_v
                end_x&=ROUND(segment_u*view_scale)-origin_x_pixels&
                end_y&=-ROUND(segment_v*view_scale)-origin_y_pixels&
                mouse_x&=end_x&
                mouse_y&=end_y&
                ' one piece of the move per depth layer
                REPEAT
                  IF layers_descending!
                    DEC loop_index|
                  ELSE
                    INC loop_index|
                  ENDIF
                  screen_x&=end_x&
                  screen_y&=end_y&
                  ' last layer: the piece ends at the end of the move
                  IF loop_index|=to_layer|
                    segment_u=end_u
                    segment_v=end_v
                  ELSE
                    ' the piece ends where the move crosses the layer boundary
                    IF from_layer|<>to_layer|
                      IF layers_descending!
                        line_fraction=(depth_level_table(PRED(loop_index|))-start_depth)/depth_delta
                      ELSE
                        line_fraction=(depth_level_table(loop_index|)-start_depth)/depth_delta
                      ENDIF
                      segment_u=line_fraction*direction_x+start_u
                      segment_v=line_fraction*direction_y+start_v
                    ENDIF
                  ENDIF
                  end_x&=ROUND(segment_u*view_scale)-origin_x_pixels&
                  end_y&=-ROUND(segment_v*view_scale)-origin_y_pixels&
                  layer_used!(loop_index|)=TRUE
                  scan_column|=FALSE
                  ' one stripe per pass (tool_disc_rows&() offsets, ended by 0)
                  REPEAT
                    IF scan_column|=0
                      box_width&=double_margin&+ABS(screen_x&-end_x&)
                      box_height&=double_margin&+ABS(screen_y&-end_y&)
                      IF screen_x&<end_x&
                        box_left&=screen_x&
                      ELSE
                        box_left&=end_x&
                      ENDIF
                      SUB box_left&,box_margin&
                      IF box_left&<work_min_x&
                        box_left&=work_min_x&
                      ELSE
                        IF box_left&>work_max_x&
                          box_left&=work_max_x&
                        ENDIF
                      ENDIF
                      IF screen_y&<end_y&
                        box_top&=screen_y&
                      ELSE
                        box_top&=end_y&
                      ENDIF
                      SUB box_top&,box_margin&
                      IF box_top&<work_min_y&
                        box_top&=work_min_y&
                      ELSE
                        IF box_top&>work_max_y&
                          box_top&=work_max_y&
                        ENDIF
                      ENDIF
                      box_right&=box_left&+box_width&
                      IF box_right&>work_max_x&
                        box_right&=work_max_x&
                      ENDIF
                      box_bottom&=box_top&+box_height&
                      IF box_bottom&>work_max_y&
                        box_bottom&=work_max_y&
                      ENDIF
                      DEFFILL ,0,0
                      BOUNDARY 0
                      PBOX box_left&,box_top&,box_right&,box_bottom&
                      BOUNDARY 1
                      DEFFILL ,1,1
                      PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
                      PCIRCLE end_x&,end_y&,tool_radius_pixels&
                      IF draw_centre_line!
                        DRAW screen_x&,screen_y&,end_x&,end_y&
                      ENDIF
                    ELSE
                      ' offset of the stripe at right angles to the move
                      stripe_dx&=ROUND(tool_disc_rows&(scan_column|)*COS(line_angle))
                      stripe_dy&=-ROUND(tool_disc_rows&(scan_column|)*SIN(line_angle))
                      stripe_left_dx&=stripe_dy&
                      stripe_left_dy&=-stripe_dx&
                      stripe_right_dx&=-stripe_dy&
                      stripe_right_dy&=stripe_dx&
                      DRAW screen_x&+stripe_left_dx&,screen_y&+stripe_left_dy&,end_x&+stripe_left_dx&,end_y&+stripe_left_dy&
                      DRAW screen_x&+stripe_right_dx&,screen_y&+stripe_right_dy&,end_x&+stripe_right_dx&,end_y&+stripe_right_dy&
                    ENDIF
                    INC scan_column|
                  UNTIL tool_disc_rows&(scan_column|)=0
                  bitmap_left&=box_left&+layer_offset_x&
                  bitmap_top&=box_top&+layer_offset_y&
                  bitmap_right&=box_right&+layer_offset_x&
                  bitmap_bottom&=box_bottom&+layer_offset_y&
                  window_left&=box_left&+work_offset_x&
                  window_top&=box_top&+work_offset_y&
                  window_right&=box_right&+work_offset_x&
                  window_bottom&=box_bottom&+work_offset_y&
                  ' copy the piece into the bitmap of its layer
                  layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                  blit_params%(0)=window_left&
                  blit_params%(1)=window_top&
                  blit_params%(2)=window_right&
                  blit_params%(3)=window_bottom&
                  blit_params%(4)=bitmap_left&
                  blit_params%(5)=bitmap_top&
                  blit_params%(6)=bitmap_right&
                  blit_params%(7)=bitmap_bottom&
                  blit_params%(8)=7
                  BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                  IF rough_out_cycle_active!
                    layer_mfdb%(0)=graphic_buffer%
                    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                  ENDIF
                UNTIL loop_index|=to_layer|
                box_width&=double_margin&+ABS(mouse_x&-end_x&)
                box_height&=double_margin&+ABS(mouse_y&-end_y&)
                IF mouse_x&<end_x&
                  box_left&=mouse_x&
                ELSE
                  box_left&=end_x&
                ENDIF
                SUB box_left&,box_margin&
                IF mouse_y&<end_y&
                  box_top&=mouse_y&
                ELSE
                  box_top&=end_y&
                ENDIF
                SUB box_top&,box_margin&
                box_right&=box_left&+box_width&
                box_bottom&=box_top&+box_height&
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' show the changed rectangle in the view
        BOUNDARY 0
        ' something was drawn
        IF segment_visible! AND (box_left&<>box_right& OR box_top&<>box_bottom&)
          ' the contour was drawn
          contour_area_drawn!(current_contour|)=TRUE
          CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
          IF box_left&<view_min_x&
            box_left&=view_min_x&
          ELSE
            IF box_left&>view_max_x&
              box_left&=view_max_x&
            ENDIF
          ENDIF
          IF box_top&<view_min_y&
            box_top&=view_min_y&
          ELSE
            IF box_top&>view_max_y&
              box_top&=view_max_y&
            ENDIF
          ENDIF
          IF box_right&>view_max_x&
            box_right&=view_max_x&
          ENDIF
          IF box_bottom&>view_max_y&
            box_bottom&=view_max_y&
          ENDIF
          bitmap_left&=box_left&+layer_offset_x&
          bitmap_top&=box_top&+layer_offset_y&
          bitmap_right&=box_right&+layer_offset_x&
          bitmap_bottom&=box_bottom&+layer_offset_y&
          window_left&=box_left&+view_origin_x&
          window_top&=box_top&+view_offset_y&
          window_right&=box_right&+view_origin_x&
          window_bottom&=box_bottom&+view_offset_y&
          DEFFILL ,0,0
          PBOX box_left&,box_top&,box_right&,box_bottom&
          IF wireframe_view!
            layer_mfdb%(0)=layer_bitmaps%(1)
          ELSE
            ' merge the layer bitmaps into the view, deepest pattern last
            FOR loop_index|=depth_levels_used| DOWNTO 1
              IF layer_used!(loop_index|)
                IF loop_index|=1
                  DEFFILL ,1,1
                ELSE
                  DEFFILL ,2,depth_level_colours|(loop_index|)
                ENDIF
                PBOX box_left&,box_top&,box_right&,box_bottom&
                layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                blit_params%(0)=bitmap_left&
                blit_params%(1)=bitmap_top&
                blit_params%(2)=bitmap_right&
                blit_params%(3)=bitmap_bottom&
                blit_params%(4)=window_left&
                blit_params%(5)=window_top&
                blit_params%(6)=window_right&
                blit_params%(7)=window_bottom&
                blit_params%(8)=1
                BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                layer_mfdb%(0)=layer_bitmaps%(0)
                blit_params%(0)=window_left&
                blit_params%(1)=window_top&
                blit_params%(2)=window_right&
                blit_params%(3)=window_bottom&
                blit_params%(4)=bitmap_left&
                blit_params%(5)=bitmap_top&
                blit_params%(6)=bitmap_right&
                blit_params%(7)=bitmap_bottom&
                blit_params%(8)=7
                BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
              ENDIF
            NEXT loop_index|
            layer_mfdb%(0)=layer_bitmaps%(0)
          ENDIF
          ' copy the window area of the screen to the off-screen screen
          screen_x&=MIN(work_right&,screen_max_x&)
          screen_y&=MIN(work_bottom&,screen_max_y&)
          blit_params%(0)=work_x&
          blit_params%(1)=work_y&
          blit_params%(2)=screen_x&
          blit_params%(3)=screen_y&
          blit_params%(4)=work_x&
          blit_params%(5)=work_y&
          blit_params%(6)=screen_x&
          blit_params%(7)=screen_y&
          blit_params%(8)=3
          BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
          blit_params%(0)=bitmap_left&
          blit_params%(1)=bitmap_top&
          blit_params%(2)=bitmap_right&
          blit_params%(3)=bitmap_bottom&
          blit_params%(4)=window_left&
          blit_params%(5)=window_top&
          blit_params%(6)=window_right&
          blit_params%(7)=window_bottom&
          BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
          CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          ' remove the tool sprite while the window is updated
          ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
          IF sprite_shown! AND redraw_x&=window_handle|
            SPRITE tool_sprite$
          ENDIF
          ' copy the changed rectangle to the window, through its rectangle list
          redraw_x&=window_left&
          redraw_y&=window_top&
          redraw_width&=window_right&-window_left&
          redraw_height&=window_bottom&-window_top&
          IF redraw_x&<screen_width& AND redraw_y&<screen_height&
            ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
            IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
              IF screen_x&+rect_width&>screen_width&
                rect_width&=screen_width&-screen_x&
              ENDIF
              IF screen_y&+rect_height&>screen_height&
                rect_height&=screen_height&-screen_y&
              ENDIF
              DEC rect_width&
              DEC rect_height&
              blit_params%(0)=screen_x&
              blit_params%(1)=screen_y&
              blit_params%(2)=screen_x&+rect_width&
              blit_params%(3)=screen_y&+rect_height&
              blit_params%(4)=screen_x&
              blit_params%(5)=screen_y&
              blit_params%(6)=screen_x&+rect_width&
              blit_params%(7)=screen_y&+rect_height&
              blit_params%(8)=3
              BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
            ENDIF
            ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
            WHILE rect_height&<>0 OR rect_width&<>0
              IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                IF screen_x&+rect_width&>screen_width&
                  rect_width&=screen_width&-screen_x&
                ENDIF
                IF screen_y&+rect_height&>screen_height&
                  rect_height&=screen_height&-screen_y&
                ENDIF
                DEC rect_width&
                DEC rect_height&
                blit_params%(0)=screen_x&
                blit_params%(1)=screen_y&
                blit_params%(2)=screen_x&+rect_width&
                blit_params%(3)=screen_y&+rect_height&
                blit_params%(4)=screen_x&
                blit_params%(5)=screen_y&
                blit_params%(6)=screen_x&+rect_width&
                blit_params%(7)=screen_y&+rect_height&
                BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
              ENDIF
              ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
            WEND
          ENDIF
          ' put the tool sprite at the end of the move
          ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
          IF sprite_shown! AND redraw_x&=window_handle|
            IF area_min_v<=move_compensated_end(second_plane_axis|) AND area_max_v>=move_compensated_end(second_plane_axis|) AND area_min_h<=move_compensated_end(first_plane_axis|) AND area_max_h>=move_compensated_end(first_plane_axis|)
              screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*move_compensated_end(first_plane_axis|))-origin_x_pixels&))
              screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*move_compensated_end(second_plane_axis|))-origin_y_pixels&))
              SPRITE tool_sprite$,screen_x&,screen_y&
            ENDIF
          ENDIF
        ELSE
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
        ENDIF
        CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
      ENDIF
    ENDIF
  ENDIF
  ' single step: wait for a key
  IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
    PRINT AT(text_column&+4,prompt_row|);SPC(70);
    ' "continue with Return or Enter (Space to stop)", then wait for one of the keys
    PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
    REPEAT
      work_text$=INKEY$
    UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
    ' Space: stop the simulation
    IF ASC(work_text$)=32
      stop_requested!=TRUE
    ENDIF
    PRINT AT(text_column&+6,prompt_row|);SPC(65);
  ENDIF
  ' an outside corner follows: draw its transition arc
  IF corner_arc_needed!=TRUE
    draw_corner_transition_arc
  ENDIF
  ' the next move starts with this compensation
  previous_compensation$=compensation_side$
  ' rounding: the move ended at the start of the rounding arc
  IF rounding_active!
    saved_move_end(1)=rounding_target(1)
    saved_move_end(2)=rounding_target(2)
    saved_move_end(3)=rounding_target(3)
    SWAP end_point(),rounding_target()
  ENDIF
  ' R0 after this move: compensation off
  IF cancel_compensation!
    cancel_compensation!=FALSE
    radius_correction$=CHR$(48)
    compensation_side$=CHR$(48)
    previous_compensation$=CHR$(48)
  ENDIF
  DEFFILL ,1,1
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Draws the pending arc from previous_block_start() to move_end() around the centre previous_centre() in
' direction move_arc_direction$ ("+"/"-"). Checks the arc first: a zero radius ("Kreisradius muss groesser als
' Null sein", the circle radius must be greater than zero), start and end at different distances from the
' centre, a compensated radius smaller than the tool radius (in contour mode, in_subprogram_call!, tool_radius
' already includes the finishing allowance, so the alert there says "Fraeserradius + Aufmass" [tool radius +
' allowance]), and compensation or rotation in a side plane; errors set run_aborted! and error_messages$(0).
' An arc in a side plane (first_plane_axis|<>tool_first_axis|) goes to simulate_side_plane_arc, one that
' changes depth (helix) to simulate_helix_arc. Otherwise the compensated arc is drawn, its screen coordinates
' held in 32-bit integers so that a very large radius does not overflow: in the wireframe view as a circle
' arc, else filled into the layer bitmap of its depth, and the view and window updated as in
' simulate_line_move. An arc whose radius is more than four times simulation_view_size and whose sweep is
' under 2 degrees is filled as a straight line from its start to its end instead, with the tool disc at both
' ends. Handles the rounding (rounding_active!) and the outside corner (corner_arc_needed!).
PROCEDURE simulate_arc_move(line_index&,arc_direction$,move_is_line!)
  LOCAL vector_x,vector_y,second_vector_x,second_vector_y,element_arc_radius,uncompensated_radius,screen_x&,screen_y&,arc_radius,cut_layer|,angle_offset,parsed_value,centre_angle_offset,draw_end_angle,arc_end_x_pixels%,arc_end_y_pixels%,stripe_left_dx&,arc_start_angle,arc_end_angle,point_angle,arc_centre_x_pixels%,arc_centre_y_pixels%,arc_outer_radius_pixels%,arc_inner_radius_pixels%,module_call_result%,box_height&,box_width&,spare_left&,spare_top&,spare_right&,spare_bottom&,window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,rnd_first_axis|,rnd_second_axis|,rnd_infeed_axis|,start_tenths&,end_tenths&,alert_button|,loop_index|,line_index&,work_text$,full_circle!,chamfer_saved_correction$,saved_compensation$,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  IF (NOT rough_out_cycle_active!) AND (NOT in_subprogram_call!) AND (NOT contour_cycle_active!)
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    DEFFILL 1,0,0
    PBOX 0,char_cell_height|,work_w&,MUL(char_cell_height|,2)
    DEFFILL ,1,1
    IF wireframe_view!
      ' ";current_draw_block&; / ELSE
      PRINT AT(text_column&+1,2);"aktueller Satz : ";current_draw_block&;
    ELSE
      ' ";STR$(current_draw_block&);'program_lines$(current_draw_block&); / ENDIF
      PRINT AT(text_column&+1,2);"aktueller Satz : ";STR$(current_draw_block&);'program_lines$(current_draw_block&);
    ENDIF
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    redraw_x&=work_x&
    redraw_y&=work_y&+char_cell_height|
    redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
    redraw_height&=char_cell_height|
    IF redraw_x&<screen_width& AND redraw_y&<screen_height&
      ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
        IF screen_x&+rect_width&>screen_width&
          rect_width&=screen_width&-screen_x&
        ENDIF
        IF screen_y&+rect_height&>screen_height&
          rect_height&=screen_height&-screen_y&
        ENDIF
        DEC rect_width&
        DEC rect_height&
        blit_params%(0)=screen_x&
        blit_params%(1)=screen_y&
        blit_params%(2)=screen_x&+rect_width&
        blit_params%(3)=screen_y&+rect_height&
        blit_params%(4)=screen_x&
        blit_params%(5)=screen_y&
        blit_params%(6)=screen_x&+rect_width&
        blit_params%(7)=screen_y&+rect_height&
        blit_params%(8)=3
        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
      ENDIF
      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WHILE rect_height&<>0 OR rect_width&<>0
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WEND
    ENDIF
  ENDIF
  corner_arc_needed!=FALSE
  ' a rounding (RND): the arc ends at the rounding target rounding_target(), uncompensated
  IF rounding_active!
    saved_compensation$=compensation_side$
    chamfer_saved_correction$=radius_correction$
    compensation_side$=CHR$(48)
    move_end(1)=rounding_target(1)
    move_end(2)=rounding_target(2)
    move_end(3)=rounding_target(3)
  ENDIF
  ' start (vector_x,vector_y) and end (second_vector_x,second_vector_y) relative to the centre
  vector_x=previous_block_start(first_plane_axis|)-previous_centre(first_plane_axis|)
  vector_y=previous_block_start(second_plane_axis|)-previous_centre(second_plane_axis|)
  second_vector_x=move_end(first_plane_axis|)-previous_centre(first_plane_axis|)
  second_vector_y=move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
  IF 1E-07>ABS(vector_x-second_vector_x) AND 1E-07>ABS(vector_y-second_vector_y)
    full_circle!=TRUE
  ELSE
    full_circle!=FALSE
  ENDIF
  ' start radius element_arc_radius and end radius uncompensated_radius
  element_arc_radius=SQR(vector_x*vector_x+vector_y*vector_y)
  uncompensated_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
  ' zero radius
  IF element_arc_radius=0 OR uncompensated_radius=0
    ' "circle radius must be greater than zero"
    ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' in an SL cycle the error belongs to the cycle call line
    IF rough_out_cycle_active! OR contour_cycle_active!
      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
    ELSE
      error_blocks&(0)=current_draw_block&
    ENDIF
    error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
  ELSE
    IF .01<ABS(element_arc_radius-uncompensated_radius) AND (NOT rough_out_cycle_active!) AND (NOT contour_cycle_active!) OR (.1<ABS(element_arc_radius-uncompensated_radius) AND (rough_out_cycle_active! OR contour_cycle_active!))
      ' "start and end point of the circle are at different distances from the centre"
      ALERT 3,"Anfangs- und Endpunkt des|Kreises sind verschieden|weit vom Kreismittelpunkt|entfernt!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      IF rough_out_cycle_active! OR contour_cycle_active!
        error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
      ELSE
        error_blocks&(0)=current_draw_block&
      ENDIF
      error_messages$(0)="ANFANGS- UND ENDRADIUS SIND VERSCHIEDEN!"
    ELSE
      IF element_arc_radius<tool_radius AND .0001<ABS(element_arc_radius-tool_radius) AND (compensation_side$<>"0") AND (NOT rough_out_cycle_active!) AND (NOT contour_cycle_active!)
        ' the tool runs inside the arc: the radius must be larger than the tool radius
        IF (move_arc_direction$="+") AND (compensation_side$="L") OR ((move_arc_direction$="-") AND (compensation_side$="R")) OR (compensation_side$="0")
          IF in_subprogram_call!
            ' "the circle/rounding radius must be larger than tool radius + allowance"
            ALERT 3,"  Der Kreis/RND-Radius|      muû grîûer als|FrÑserradius + Aufmaû sein!",1,"Abbruch",alert_button|
            error_messages$(0)="KREIS/RND-RADIUS IST KLEINER ALS FRéSERRADIUS+AUFMASS!"
          ELSE
            ' "the circle/rounding radius must be larger than the tool radius"
            ALERT 3,"Der Kreis/RND-Radius|muû grîûer als der|FrÑserradius sein!",1,"Abbruch",alert_button|
            error_messages$(0)="KREIS/RND-RADIUS IST KLEINER ALS FRéSERRADIUS!"
          ENDIF
          run_aborted!=TRUE
          error_blocks&(0)=current_draw_block&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF NOT run_aborted!
    ' the arc lies in a side plane
    IF first_plane_axis|<>tool_first_axis|
      IF compensation_side$<>"0"
        ' "no radius compensation possible"
        ALERT 3,"Keine Radiuskorrektur|       mîglich!",1,"Abbruch",alert_button|
        IF alert_button|=1
          run_aborted!=TRUE
          error_blocks&(0)=current_draw_block&
          error_messages$(0)="KEINE RADIUSKORREKTUR MôGLICH!"
        ENDIF
      ELSE
        IF rotation_active!
          ' "rotating the circle is not possible in this working plane"
          ALERT 3,"Rotation des Kreises in|dieser Arbeitsebene|nicht mîglich!",1,"Abbruch",alert_button|
          IF alert_button|=1
            run_aborted!=TRUE
            error_blocks&(0)=current_draw_block&
            error_messages$(0)="ROTATION IN DIESER ARBEITSEBENE NICHT MôGLICH!"
          ENDIF
        ELSE
          ' draw the side plane arc
          simulate_side_plane_arc(element_arc_radius)
        ENDIF
      ENDIF
    ELSE
      ' the programmed radius; element_arc_radius becomes the radius of the tool centre path
      uncompensated_radius=element_arc_radius
      IF compensation_side$="R"
        IF move_arc_direction$="+"
          element_arc_radius=element_arc_radius+tool_radius
        ELSE
          SUB element_arc_radius,tool_radius
        ENDIF
      ELSE
        IF compensation_side$="L"
          IF move_arc_direction$="-"
            element_arc_radius=element_arc_radius+tool_radius
          ELSE
            SUB element_arc_radius,tool_radius
          ENDIF
        ENDIF
      ENDIF
      ' no compensation at the start: the ends stay where they are
      IF previous_compensation$="0"
        ' compensated start on the tool centre radius
        move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
        move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
        ' compensated end
        move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
        move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
      ELSE
        IF corner_point_moved!
          move_compensated_start(1)=compensated_start(1)
          move_compensated_start(2)=compensated_start(2)
          move_compensated_start(3)=compensated_start(3)
        ELSE
          move_compensated_start(first_plane_axis|)=element_arc_radius/uncompensated_radius*vector_x+previous_centre(first_plane_axis|)
          move_compensated_start(second_plane_axis|)=element_arc_radius/uncompensated_radius*vector_y+previous_centre(second_plane_axis|)
        ENDIF
        move_compensated_end(first_plane_axis|)=element_arc_radius/uncompensated_radius*second_vector_x+previous_centre(first_plane_axis|)
        move_compensated_end(second_plane_axis|)=element_arc_radius/uncompensated_radius*second_vector_y+previous_centre(second_plane_axis|)
      ENDIF
      ' compensation goes on: the corner to the next move
      IF (compensation_side$<>"0") AND (NOT cancel_compensation!)
        compensate_tool_radius(line_index&,element_arc_radius,arc_direction$,0,move_is_line!)
      ELSE
        corner_point_moved!=FALSE
      ENDIF
      IF .0001<ABS(move_end(infeed_axis|)-previous_block_start(infeed_axis|))
        simulate_helix_arc(element_arc_radius)
      ELSE
        ' compensated start and end relative to the centre
        vector_x=move_compensated_start(first_plane_axis|)-previous_centre(first_plane_axis|)
        vector_y=move_compensated_start(second_plane_axis|)-previous_centre(second_plane_axis|)
        ' the arc cuts the workpiece
        IF blank_top>previous_block_start(infeed_axis|) AND element_arc_radius>0 AND (NOT skip_arc_layers!)
          IF vector_x<>0 OR vector_y<>0
            second_vector_x=move_compensated_end(first_plane_axis|)-previous_centre(first_plane_axis|)
            second_vector_y=move_compensated_end(second_plane_axis|)-previous_centre(second_plane_axis|)
            IF second_vector_x<>0 OR second_vector_y<>0
              ' contour mode: record the arc in the contour list
              IF in_subprogram_call!
                store_generated_arc(line_index&,move_compensated_end(first_plane_axis|),move_compensated_end(second_plane_axis|),previous_centre(first_plane_axis|),previous_centre(second_plane_axis|),move_arc_direction$)
              ELSE
                ' start angle arc_start_angle, end angle arc_end_angle (0 to two pi), sweep point_angle
                arc_start_angle=vector_x/element_arc_radius
                arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                IF vector_y<0
                  arc_start_angle=two_pi-arc_start_angle
                ENDIF
                arc_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
                arc_end_angle=second_vector_x/arc_radius
                arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                IF second_vector_y<0
                  arc_end_angle=two_pi-arc_end_angle
                ENDIF
                point_angle=arc_end_angle-arc_start_angle
                ' the depth layer of the arc: cut_layer|
                IF blank_bottom>=previous_block_start(infeed_axis|)
                  cut_layer|=1
                ELSE
                  loop_index|=FALSE
                  REPEAT
                    INC loop_index|
                  UNTIL loop_index|=layer_depth_count| OR (previous_block_start(infeed_axis|)>depth_level_table(loop_index|) AND previous_block_start(infeed_axis|)<=depth_level_table(SUCC(loop_index|)))
                  cut_layer|=SUCC(loop_index|)
                ENDIF
                IF .002<ABS(point_angle)
                  ' clockwise: draw from the end angle to the start angle
                  IF move_arc_direction$="-"
                    centre_angle_offset=arc_end_angle
                    draw_end_angle=arc_start_angle
                  ELSE
                    centre_angle_offset=arc_start_angle
                    draw_end_angle=arc_end_angle
                  ENDIF
                ENDIF
                ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
                CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
                ' the arc in screen pixels: start file_search_result%/arc_start_y_pixels%, end arc_end_x_pixels%/
                ' arc_end_y_pixels%, centre arc_centre_x_pixels%/arc_centre_y_pixels%, the outer and inner edge of the cut
                ' arc_outer_radius_pixels%/arc_inner_radius_pixels%, and module_call_result% = half the size of the update box
                ' (tool centre radius + tool radius + 4)
                file_search_result%=ROUND(view_scale*move_compensated_start(first_plane_axis|))-origin_x_pixels&
                arc_start_y_pixels%=-ROUND(view_scale*move_compensated_start(second_plane_axis|))-origin_y_pixels&
                arc_end_x_pixels%=ROUND(view_scale*move_compensated_end(first_plane_axis|))-origin_x_pixels&
                arc_end_y_pixels%=-ROUND(view_scale*move_compensated_end(second_plane_axis|))-origin_y_pixels&
                arc_centre_x_pixels%=ROUND(view_scale*previous_centre(first_plane_axis|))-origin_x_pixels&
                arc_centre_y_pixels%=-ROUND(view_scale*previous_centre(second_plane_axis|))-origin_y_pixels&
                arc_outer_radius_pixels%=ROUND(element_arc_radius*view_scale)
                module_call_result%=arc_outer_radius_pixels%+4+tool_radius_pixels&
                arc_inner_radius_pixels%=PRED(arc_outer_radius_pixels%-tool_radius_pixels&)
                arc_outer_radius_pixels%=arc_outer_radius_pixels%+tool_radius_pixels&
                ' start and end angle in tenths of a degree for CIRCLE/PCIRCLE
                start_tenths&=ROUND(centre_angle_offset*tenths_per_radian)
                end_tenths&=ROUND(draw_end_angle*tenths_per_radian)
                ' the update box round the centre, each side clamped to the work bitmap before it goes into the word variables
                ' box_left&, box_top&, box_right&, box_bottom&
                IF arc_centre_x_pixels%-module_call_result%<work_min_x&
                  box_left&=work_min_x&
                ELSE
                  IF arc_centre_x_pixels%-module_call_result%>work_max_x&
                    box_left&=work_max_x&
                  ELSE
                    box_left&=arc_centre_x_pixels%-module_call_result%
                  ENDIF
                ENDIF
                IF arc_centre_y_pixels%-module_call_result%<work_min_y&
                  box_top&=work_min_y&
                ELSE
                  IF arc_centre_y_pixels%-module_call_result%>work_max_y&
                    box_top&=work_max_y&
                  ELSE
                    box_top&=arc_centre_y_pixels%-module_call_result%
                  ENDIF
                ENDIF
                IF arc_centre_x_pixels%+module_call_result%<work_min_x&
                  box_right&=work_min_x&
                ELSE
                  IF arc_centre_x_pixels%+module_call_result%>work_max_x&
                    box_right&=work_max_x&
                  ELSE
                    box_right&=arc_centre_x_pixels%+module_call_result%
                  ENDIF
                ENDIF
                IF arc_centre_y_pixels%+module_call_result%<work_min_y&
                  box_bottom&=work_min_y&
                ELSE
                  IF arc_centre_y_pixels%+module_call_result%>work_max_y&
                    box_bottom&=work_max_y&
                  ELSE
                    box_bottom&=arc_centre_y_pixels%+module_call_result%
                  ENDIF
                ENDIF
                IF box_left&<>box_right& OR box_top&<>box_bottom&
                  bitmap_left&=box_left&+layer_offset_x&
                  bitmap_top&=box_top&+layer_offset_y&
                  bitmap_right&=box_right&+layer_offset_x&
                  bitmap_bottom&=box_bottom&+layer_offset_y&
                  window_left&=box_left&+work_offset_x&
                  window_top&=box_top&+work_offset_y&
                  window_right&=box_right&+work_offset_x&
                  window_bottom&=box_bottom&+work_offset_y&
                  DEFFILL ,0,0
                  PBOX box_left&,box_top&,box_right&,box_bottom&
                  DEFFILL ,1,1
                  BOUNDARY 1
                  ' wireframe: draw the arc as a thin circle arc
                  IF wireframe_view!
                    DEC arc_outer_radius_pixels%
                    IF .002<ABS(point_angle) AND (NOT full_circle!)
                      CIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_outer_radius_pixels%,start_tenths&,end_tenths&
                    ELSE
                      CIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_outer_radius_pixels%,0,3600
                    ENDIF
                    BOUNDARY 0
                  ELSE
                    ' solid: fill the ring segment the tool sweeps and the tool circles at both ends
                    layer_used!(cut_layer|)=TRUE
                    IF .002<ABS(point_angle) AND (NOT full_circle!)
                      ' a very large arc with a sweep under 2 degrees (20 tenths) is nearly straight and its pixel radius is too
                      ' large for PCIRCLE: draw it as a line from start to end with the tool disc at both ends
                      IF element_arc_radius>simulation_view_size*4 AND ABS(start_tenths&-end_tenths&)<20
                        DRAW file_search_result%,arc_start_y_pixels%,arc_end_x_pixels%,arc_end_y_pixels%
                        PCIRCLE file_search_result%,arc_start_y_pixels%,tool_radius_pixels&
                        PCIRCLE arc_end_x_pixels%,arc_end_y_pixels%,tool_radius_pixels&
                        BOUNDARY 0
                        DEFFILL ,0,0
                      ELSE
                        PCIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_outer_radius_pixels%,start_tenths&,end_tenths&
                        PCIRCLE file_search_result%,arc_start_y_pixels%,tool_radius_pixels&
                        PCIRCLE arc_end_x_pixels%,arc_end_y_pixels%,tool_radius_pixels&
                        BOUNDARY 0
                        DEFFILL ,0,0
                        PCIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_inner_radius_pixels%
                      ENDIF
                    ELSE
                      PCIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_outer_radius_pixels%,0,3600
                      BOUNDARY 0
                      DEFFILL ,0,0
                      PCIRCLE arc_centre_x_pixels%,arc_centre_y_pixels%,arc_inner_radius_pixels%,0,3600
                    ENDIF
                  ENDIF
                  IF wireframe_view!
                    layer_mfdb%(0)=layer_bitmaps%(1)
                  ELSE
                    layer_mfdb%(0)=layer_bitmaps%(cut_layer|)
                  ENDIF
                  blit_params%(0)=window_left&
                  blit_params%(1)=window_top&
                  blit_params%(2)=window_right&
                  blit_params%(3)=window_bottom&
                  blit_params%(4)=bitmap_left&
                  blit_params%(5)=bitmap_top&
                  blit_params%(6)=bitmap_right&
                  blit_params%(7)=bitmap_bottom&
                  blit_params%(8)=7
                  BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                  IF rough_out_cycle_active!
                    layer_mfdb%(0)=graphic_buffer%
                    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                  ENDIF
                  ' show the changed rectangle in the view
                  CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
                  IF box_left&<view_min_x&
                    box_left&=view_min_x&
                  ELSE
                    IF box_left&>view_max_x&
                      box_left&=view_max_x&
                    ENDIF
                  ENDIF
                  IF box_top&<view_min_y&
                    box_top&=view_min_y&
                  ELSE
                    IF box_top&>view_max_y&
                      box_top&=view_max_y&
                    ENDIF
                  ENDIF
                  IF box_right&>view_max_x&
                    box_right&=view_max_x&
                  ENDIF
                  IF box_bottom&>view_max_y&
                    box_bottom&=view_max_y&
                  ENDIF
                  bitmap_left&=box_left&+layer_offset_x&
                  bitmap_top&=box_top&+layer_offset_y&
                  bitmap_right&=box_right&+layer_offset_x&
                  bitmap_bottom&=box_bottom&+layer_offset_y&
                  window_left&=box_left&+view_origin_x&
                  window_top&=box_top&+view_offset_y&
                  window_right&=box_right&+view_origin_x&
                  window_bottom&=box_bottom&+view_offset_y&
                  DEFFILL ,0,0
                  PBOX box_left&,box_top&,box_right&,box_bottom&
                  IF wireframe_view!
                    layer_mfdb%(0)=layer_bitmaps%(1)
                  ELSE
                    FOR loop_index|=depth_levels_used| DOWNTO 1
                      IF layer_used!(loop_index|)
                        IF loop_index|=1
                          DEFFILL ,1,1
                        ELSE
                          DEFFILL ,2,depth_level_colours|(loop_index|)
                        ENDIF
                        PBOX box_left&,box_top&,box_right&,box_bottom&
                        layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                        blit_params%(0)=bitmap_left&
                        blit_params%(1)=bitmap_top&
                        blit_params%(2)=bitmap_right&
                        blit_params%(3)=bitmap_bottom&
                        blit_params%(4)=window_left&
                        blit_params%(5)=window_top&
                        blit_params%(6)=window_right&
                        blit_params%(7)=window_bottom&
                        blit_params%(8)=1
                        BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                        layer_mfdb%(0)=layer_bitmaps%(0)
                        blit_params%(0)=window_left&
                        blit_params%(1)=window_top&
                        blit_params%(2)=window_right&
                        blit_params%(3)=window_bottom&
                        blit_params%(4)=bitmap_left&
                        blit_params%(5)=bitmap_top&
                        blit_params%(6)=bitmap_right&
                        blit_params%(7)=bitmap_bottom&
                        blit_params%(8)=7
                        BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                      ENDIF
                    NEXT loop_index|
                    layer_mfdb%(0)=layer_bitmaps%(0)
                  ENDIF
                  screen_x&=MIN(work_right&,screen_max_x&)
                  screen_y&=MIN(work_bottom&,screen_max_y&)
                  blit_params%(0)=work_x&
                  blit_params%(1)=work_y&
                  blit_params%(2)=screen_x&
                  blit_params%(3)=screen_y&
                  blit_params%(4)=work_x&
                  blit_params%(5)=work_y&
                  blit_params%(6)=screen_x&
                  blit_params%(7)=screen_y&
                  blit_params%(8)=3
                  BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
                  blit_params%(0)=bitmap_left&
                  blit_params%(1)=bitmap_top&
                  blit_params%(2)=bitmap_right&
                  blit_params%(3)=bitmap_bottom&
                  blit_params%(4)=window_left&
                  blit_params%(5)=window_top&
                  blit_params%(6)=window_right&
                  blit_params%(7)=window_bottom&
                  BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                  CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
                  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                  ' remove the tool sprite while the window is updated
                  ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                  IF sprite_shown! AND redraw_x&=window_handle|
                    SPRITE tool_sprite$
                  ENDIF
                  redraw_x&=window_left&
                  redraw_y&=window_top&
                  redraw_width&=window_right&-window_left&
                  redraw_height&=window_bottom&-window_top&
                  IF redraw_x&<screen_width& AND redraw_y&<screen_height&
                    ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
                    IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                      IF screen_x&+rect_width&>screen_width&
                        rect_width&=screen_width&-screen_x&
                      ENDIF
                      IF screen_y&+rect_height&>screen_height&
                        rect_height&=screen_height&-screen_y&
                      ENDIF
                      DEC rect_width&
                      DEC rect_height&
                      blit_params%(0)=screen_x&
                      blit_params%(1)=screen_y&
                      blit_params%(2)=screen_x&+rect_width&
                      blit_params%(3)=screen_y&+rect_height&
                      blit_params%(4)=screen_x&
                      blit_params%(5)=screen_y&
                      blit_params%(6)=screen_x&+rect_width&
                      blit_params%(7)=screen_y&+rect_height&
                      blit_params%(8)=3
                      BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                    ENDIF
                    ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
                    WHILE rect_height&<>0 OR rect_width&<>0
                      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                        IF screen_x&+rect_width&>screen_width&
                          rect_width&=screen_width&-screen_x&
                        ENDIF
                        IF screen_y&+rect_height&>screen_height&
                          rect_height&=screen_height&-screen_y&
                        ENDIF
                        DEC rect_width&
                        DEC rect_height&
                        blit_params%(0)=screen_x&
                        blit_params%(1)=screen_y&
                        blit_params%(2)=screen_x&+rect_width&
                        blit_params%(3)=screen_y&+rect_height&
                        blit_params%(4)=screen_x&
                        blit_params%(5)=screen_y&
                        blit_params%(6)=screen_x&+rect_width&
                        blit_params%(7)=screen_y&+rect_height&
                        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                      ENDIF
                      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
                    WEND
                  ENDIF
                  ' put the tool sprite at the end of the arc
                  ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                  IF sprite_shown! AND redraw_x&=window_handle|
                    IF area_min_v<=move_compensated_end(second_plane_axis|) AND area_max_v>=move_compensated_end(second_plane_axis|) AND area_min_h<=move_compensated_end(first_plane_axis|) AND area_max_h>=move_compensated_end(first_plane_axis|)
                      screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*move_compensated_end(first_plane_axis|))-origin_x_pixels&))
                      screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*move_compensated_end(second_plane_axis|))-origin_y_pixels&))
                      SPRITE tool_sprite$,screen_x&,screen_y&
                    ENDIF
                  ENDIF
                ELSE
                  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                ENDIF
                CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      ' single step: wait for a key
      IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
        PRINT AT(text_column&+4,prompt_row|);SPC(70);
        PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
        REPEAT
          work_text$=INKEY$
        UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
        IF ASC(work_text$)=32
          stop_requested!=TRUE
        ENDIF
        LOCATE text_column&+6,prompt_row|
        PRINT SPACE$(65);
      ENDIF
      ' an outside corner follows: draw its transition arc
      IF corner_arc_needed!=TRUE
        draw_corner_transition_arc
      ENDIF
      previous_compensation$=compensation_side$
    ENDIF
  ENDIF
  ' end of the rounding: back to the saved compensation and the end of the rounding
  IF rounding_active!
    rounding_active!=FALSE
    previous_compensation$=saved_compensation$
    compensation_side$=saved_compensation$
    radius_correction$=chamfer_saved_correction$
    move_end(1)=saved_move_end(1)
    move_end(2)=saved_move_end(2)
    move_end(3)=saved_move_end(3)
  ELSE
    IF cancel_compensation!
      cancel_compensation!=FALSE
      radius_correction$=CHR$(48)
      compensation_side$=CHR$(48)
      previous_compensation$=CHR$(48)
    ENDIF
  ENDIF
  DEFFILL ,1,1
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Draws a compensated arc of radius element_arc_radius whose depth changes from start to end (a helix, or a
' polar arc CP with an incremental angle IPA, read from the block text at column 9). The wireframe view gets the
' whole arc at once. The solid view walks the arc through the depth layers depth_level_table(): it works out the
' angle where the depth crosses each layer boundary, draws that piece of the arc into the layer's bitmap, and
' updates view and window after each piece, waiting for a key in single step.
PROCEDURE simulate_helix_arc(element_arc_radius)
  LOCAL start_u,start_v,start_depth,end_u,end_v,end_depth,centre_u,centre_v,vector_x,vector_y,second_vector_x,second_vector_y,arc_start_angle,arc_end_angle,point_angle,program_line$,polar_angle,absolute_polar_angle!,screen_x&,screen_y&,end_x&,end_y&,centre_x&,centre_y&,radius_pixels&,inner_radius_pixels&,box_margin&,box_left&,box_top&,box_right&,box_bottom&,window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,centre_angle_offset,draw_end_angle,segment_start_tenths%,segment_end_tenths%,from_layer|,to_layer|,cut_depth,arc_positive!,running_angle,reduced_angle,basic_variables,depth_delta,angle_offset,previous_angle,next_angle,layers_descending!,previous_u,previous_v,segment_u,segment_v,segment_angle,loop_index|,scan_column|,work_text$,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&,outer_left&,outer_top&,outer_right&,outer_bottom&,outer_window_left&,outer_window_top&,outer_window_right&,outer_window_bottom&,outer_bitmap_left&,outer_bitmap_top&,outer_bitmap_right&,outer_bitmap_bottom&
  start_depth=previous_block_start(infeed_axis|)
  end_depth=move_end(infeed_axis|)
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' part of the helix is below the workpiece top
  IF start_depth<blank_top OR end_depth<blank_top AND element_arc_radius>0 AND (NOT skip_arc_layers!)
    start_u=move_compensated_start(first_plane_axis|)
    start_v=move_compensated_start(second_plane_axis|)
    end_u=move_compensated_end(first_plane_axis|)
    end_v=move_compensated_end(second_plane_axis|)
    centre_u=previous_centre(first_plane_axis|)
    centre_v=previous_centre(second_plane_axis|)
    vector_x=start_u-centre_u
    vector_y=start_v-centre_v
    IF vector_x<>0 OR vector_y<>0
      second_vector_x=end_u-centre_u
      second_vector_y=end_v-centre_v
      IF second_vector_x<>0 OR second_vector_y<>0
        ' the start angle
        arc_start_angle=vector_x/element_arc_radius
        arc_start_angle=@clamped_arc_cosine(arc_start_angle)
        IF vector_y<0
          arc_start_angle=two_pi-arc_start_angle
        ENDIF
        ' the block: read the angle from column 9 (degrees, converted to radians)
        program_line$=program_lines$(current_draw_block&)
        polar_angle=@read_unscaled_number(program_line$,9)
        MUL polar_angle,PI/180
        arc_end_angle=polar_angle
        ' IPA, an incremental angle: the end angle is start + angle
        IF MID$(program_line$,5,1)="I"
          absolute_polar_angle!=TRUE
          arc_end_angle=arc_end_angle+arc_start_angle
        ELSE
          absolute_polar_angle!=FALSE
        ENDIF
        point_angle=arc_end_angle-arc_start_angle
        ' start, end and centre in pixels
        screen_x&=ROUND(start_u*view_scale)-origin_x_pixels&
        screen_y&=-ROUND(start_v*view_scale)-origin_y_pixels&
        end_x&=ROUND(end_u*view_scale)-origin_x_pixels&
        end_y&=-ROUND(end_v*view_scale)-origin_y_pixels&
        centre_x&=ROUND(centre_u*view_scale)-origin_x_pixels&
        centre_y&=-ROUND(centre_v*view_scale)-origin_y_pixels&
        radius_pixels&=ROUND(element_arc_radius*view_scale)
        box_margin&=radius_pixels&+4+tool_radius_pixels&
        inner_radius_pixels&=radius_pixels&-tool_radius_pixels&-1
        radius_pixels&=radius_pixels&+tool_radius_pixels&
        box_left&=centre_x&-box_margin&
        IF box_left&<work_min_x&
          box_left&=work_min_x&
        ELSE
          IF box_left&>work_max_x&
            box_left&=work_max_x&
          ENDIF
        ENDIF
        box_top&=centre_y&-box_margin&
        IF box_top&<work_min_y&
          box_top&=work_min_y&
        ELSE
          IF box_top&>work_max_y&
            box_top&=work_max_y&
          ENDIF
        ENDIF
        box_right&=centre_x&+box_margin&
        IF box_right&<work_min_x&
          box_right&=work_min_x&
        ELSE
          IF box_right&>work_max_x&
            box_right&=work_max_x&
          ENDIF
        ENDIF
        box_bottom&=centre_y&+box_margin&
        IF box_bottom&<work_min_y&
          box_bottom&=work_min_y&
        ELSE
          IF box_bottom&>work_max_y&
            box_bottom&=work_max_y&
          ENDIF
        ENDIF
        IF box_left&<>box_right& OR box_top&<>box_bottom&
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
          bitmap_left&=box_left&+layer_offset_x&
          bitmap_top&=box_top&+layer_offset_y&
          bitmap_right&=box_right&+layer_offset_x&
          bitmap_bottom&=box_bottom&+layer_offset_y&
          window_left&=box_left&+work_offset_x&
          window_top&=box_top&+work_offset_y&
          window_right&=box_right&+work_offset_x&
          window_bottom&=box_bottom&+work_offset_y&
          DEFFILL ,0,0
          PBOX box_left&,box_top&,box_right&,box_bottom&
          DEFFILL ,1,1
          BOUNDARY 1
          ' wireframe view: the whole arc at once
          IF wireframe_view!
            IF .002<ABS(point_angle)
              IF move_arc_direction$="-"
                centre_angle_offset=arc_end_angle
                draw_end_angle=arc_start_angle
              ELSE
                centre_angle_offset=arc_start_angle
                draw_end_angle=arc_end_angle
              ENDIF
            ENDIF
            segment_start_tenths%=ROUND(centre_angle_offset*tenths_per_radian)
            segment_end_tenths%=ROUND(draw_end_angle*tenths_per_radian)
            DEC radius_pixels&
            IF .002<ABS(point_angle) AND two_pi>ABS(point_angle)
              CIRCLE centre_x&,centre_y&,radius_pixels&,segment_start_tenths%,segment_end_tenths%
            ELSE
              CIRCLE centre_x&,centre_y&,radius_pixels&,0,3600
            ENDIF
            layer_mfdb%(0)=layer_bitmaps%(1)
            blit_params%(0)=window_left&
            blit_params%(1)=window_top&
            blit_params%(2)=window_right&
            blit_params%(3)=window_bottom&
            blit_params%(4)=bitmap_left&
            blit_params%(5)=bitmap_top&
            blit_params%(6)=bitmap_right&
            blit_params%(7)=bitmap_bottom&
            blit_params%(8)=7
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            BOUNDARY 0
            CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
            IF box_left&<view_min_x&
              box_left&=view_min_x&
            ELSE
              IF box_left&>view_max_x&
                box_left&=view_max_x&
              ENDIF
            ENDIF
            IF box_top&<view_min_y&
              box_top&=view_min_y&
            ELSE
              IF box_top&>view_max_y&
                box_top&=view_max_y&
              ENDIF
            ENDIF
            IF box_right&>view_max_x&
              box_right&=view_max_x&
            ENDIF
            IF box_bottom&>view_max_y&
              box_bottom&=view_max_y&
            ENDIF
            bitmap_left&=box_left&+layer_offset_x&
            bitmap_top&=box_top&+layer_offset_y&
            bitmap_right&=box_right&+layer_offset_x&
            bitmap_bottom&=box_bottom&+layer_offset_y&
            window_left&=box_left&+view_origin_x&
            window_top&=box_top&+view_offset_y&
            window_right&=box_right&+view_origin_x&
            window_bottom&=box_bottom&+view_offset_y&
            DEFFILL ,0,0
            PBOX box_left&,box_top&,box_right&,box_bottom&
            IF wireframe_view!
              layer_mfdb%(0)=layer_bitmaps%(1)
            ELSE
              FOR loop_index|=depth_levels_used| DOWNTO 1
                IF layer_used!(loop_index|)
                  IF loop_index|=1
                    DEFFILL ,1,1
                  ELSE
                    DEFFILL ,2,depth_level_colours|(loop_index|)
                  ENDIF
                  PBOX box_left&,box_top&,box_right&,box_bottom&
                  layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                  blit_params%(0)=bitmap_left&
                  blit_params%(1)=bitmap_top&
                  blit_params%(2)=bitmap_right&
                  blit_params%(3)=bitmap_bottom&
                  blit_params%(4)=window_left&
                  blit_params%(5)=window_top&
                  blit_params%(6)=window_right&
                  blit_params%(7)=window_bottom&
                  blit_params%(8)=1
                  BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                  layer_mfdb%(0)=layer_bitmaps%(0)
                  blit_params%(0)=window_left&
                  blit_params%(1)=window_top&
                  blit_params%(2)=window_right&
                  blit_params%(3)=window_bottom&
                  blit_params%(4)=bitmap_left&
                  blit_params%(5)=bitmap_top&
                  blit_params%(6)=bitmap_right&
                  blit_params%(7)=bitmap_bottom&
                  blit_params%(8)=7
                  BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                ENDIF
              NEXT loop_index|
              layer_mfdb%(0)=layer_bitmaps%(0)
            ENDIF
            screen_x&=MIN(work_right&,screen_max_x&)
            screen_y&=MIN(work_bottom&,screen_max_y&)
            blit_params%(0)=work_x&
            blit_params%(1)=work_y&
            blit_params%(2)=screen_x&
            blit_params%(3)=screen_y&
            blit_params%(4)=work_x&
            blit_params%(5)=work_y&
            blit_params%(6)=screen_x&
            blit_params%(7)=screen_y&
            blit_params%(8)=3
            BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
            blit_params%(0)=bitmap_left&
            blit_params%(1)=bitmap_top&
            blit_params%(2)=bitmap_right&
            blit_params%(3)=bitmap_bottom&
            blit_params%(4)=window_left&
            blit_params%(5)=window_top&
            blit_params%(6)=window_right&
            blit_params%(7)=window_bottom&
            BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
            CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
            ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
            IF sprite_shown! AND redraw_x&=window_handle|
              SPRITE tool_sprite$
            ENDIF
            redraw_x&=window_left&
            redraw_y&=window_top&
            redraw_width&=window_right&-window_left&
            redraw_height&=window_bottom&-window_top&
            IF redraw_x&<screen_width& AND redraw_y&<screen_height&
              ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
              IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                IF screen_x&+rect_width&>screen_width&
                  rect_width&=screen_width&-screen_x&
                ENDIF
                IF screen_y&+rect_height&>screen_height&
                  rect_height&=screen_height&-screen_y&
                ENDIF
                DEC rect_width&
                DEC rect_height&
                blit_params%(0)=screen_x&
                blit_params%(1)=screen_y&
                blit_params%(2)=screen_x&+rect_width&
                blit_params%(3)=screen_y&+rect_height&
                blit_params%(4)=screen_x&
                blit_params%(5)=screen_y&
                blit_params%(6)=screen_x&+rect_width&
                blit_params%(7)=screen_y&+rect_height&
                blit_params%(8)=3
                BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
              ENDIF
              ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
              WHILE rect_height&<>0 OR rect_width&<>0
                IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                  IF screen_x&+rect_width&>screen_width&
                    rect_width&=screen_width&-screen_x&
                  ENDIF
                  IF screen_y&+rect_height&>screen_height&
                    rect_height&=screen_height&-screen_y&
                  ENDIF
                  DEC rect_width&
                  DEC rect_height&
                  blit_params%(0)=screen_x&
                  blit_params%(1)=screen_y&
                  blit_params%(2)=screen_x&+rect_width&
                  blit_params%(3)=screen_y&+rect_height&
                  blit_params%(4)=screen_x&
                  blit_params%(5)=screen_y&
                  blit_params%(6)=screen_x&+rect_width&
                  blit_params%(7)=screen_y&+rect_height&
                  BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                ENDIF
                ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
              WEND
            ENDIF
            ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
            IF sprite_shown! AND redraw_x&=window_handle|
              IF end_v>=area_min_v AND end_v<=area_max_v AND end_u>=area_min_h AND end_u<=area_max_h
                screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(end_u*view_scale)-origin_x_pixels&))
                screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(end_v*view_scale)-origin_y_pixels&))
                SPRITE tool_sprite$,screen_x&,screen_y&
              ENDIF
            ENDIF
          ELSE
            ' solid view: the depth layers of start (from_layer|) and end (to_layer|)
            IF start_depth<=blank_bottom
              from_layer|=1
            ELSE
              IF start_depth>=blank_top
                from_layer|=top_level|
              ELSE
                scan_column|=FALSE
                REPEAT
                  INC scan_column|
                UNTIL scan_column|=layer_depth_count| OR (start_depth>depth_level_table(scan_column|) AND start_depth<=depth_level_table(SUCC(scan_column|)))
                from_layer|=SUCC(scan_column|)
              ENDIF
            ENDIF
            IF end_depth<=blank_bottom
              to_layer|=1
            ELSE
              IF end_depth>=blank_top
                to_layer|=top_level|
              ELSE
                scan_column|=FALSE
                REPEAT
                  INC scan_column|
                UNTIL scan_column|=layer_depth_count| OR (end_depth>depth_level_table(scan_column|) AND end_depth<=depth_level_table(SUCC(scan_column|)))
                to_layer|=SUCC(scan_column|)
              ENDIF
            ENDIF
            ' the depth change
            cut_depth=end_depth-start_depth
            ' counter-clockwise: work out the sweep point_angle of the helix
            IF move_arc_direction$="+"
              arc_positive!=TRUE
              running_angle=arc_start_angle
              IF absolute_polar_angle!
                IF polar_angle>=0
                  point_angle=polar_angle
                ELSE
                  IF 1E-07>ABS(INT(ROUND(polar_angle/two_pi*10000000)/10000000)-polar_angle/two_pi)
                    point_angle=-polar_angle
                  ELSE
                    polar_angle=-polar_angle
                    basic_variables=INT(ROUND(polar_angle/two_pi*10000000)/10000000)*two_pi
                    point_angle=two_pi-(polar_angle-basic_variables)+basic_variables
                  ENDIF
                ENDIF
              ELSE
                IF polar_angle>=0
                  reduced_angle=polar_angle-INT(ROUND(polar_angle/two_pi*10000000)/10000000)*two_pi
                  IF reduced_angle>=running_angle
                    point_angle=reduced_angle-running_angle
                  ELSE
                    point_angle=two_pi-(running_angle-reduced_angle)
                  ENDIF
                ELSE
                  point_angle=two_pi+polar_angle+INT(ROUND(-polar_angle/two_pi*10000000)/10000000)*two_pi-arc_start_angle
                ENDIF
              ENDIF
            ELSE
              ' clockwise
              arc_positive!=FALSE
              running_angle=arc_start_angle
              IF absolute_polar_angle!
                IF polar_angle<=0
                  point_angle=polar_angle
                ELSE
                  IF 1E-07>ABS(INT(ROUND(polar_angle/two_pi*10000000)/10000000)-polar_angle/two_pi)
                    point_angle=polar_angle
                  ELSE
                    polar_angle=polar_angle
                    basic_variables=INT(ROUND(polar_angle/two_pi*10000000)/10000000)*two_pi
                    point_angle=two_pi-(polar_angle-basic_variables)+basic_variables
                  ENDIF
                ENDIF
              ELSE
                IF polar_angle>=0
                  reduced_angle=polar_angle-INT(ROUND(polar_angle/two_pi*10000000)/10000000)*two_pi
                  IF reduced_angle<=running_angle
                    point_angle=reduced_angle-running_angle
                  ELSE
                    point_angle=two_pi-(reduced_angle-running_angle)
                  ENDIF
                ELSE
                  point_angle=-polar_angle-INT(ROUND(-polar_angle/two_pi*10000000)/10000000)*two_pi+arc_start_angle
                ENDIF
              ENDIF
            ENDIF
            depth_delta=SGN(cut_depth)*ABS(cut_depth/point_angle)
            ' the start is above the workpiece: start the drawing at the top surface
            IF from_layer|=top_level|
              DEC from_layer|
              angle_offset=(blank_top-start_depth)/depth_delta
              IF angle_offset<>0
                IF arc_positive!
                  running_angle=running_angle+angle_offset
                ELSE
                  SUB running_angle,angle_offset
                ENDIF
                SUB point_angle,angle_offset
                start_u=COS(running_angle)*element_arc_radius+centre_u
                start_v=SIN(running_angle)*element_arc_radius+centre_v
              ENDIF
              start_depth=blank_top
            ENDIF
            ' the end is above the workpiece: stop the drawing at the top surface
            IF to_layer|=top_level|
              DEC to_layer|
              angle_offset=(blank_top-end_depth)/depth_delta
              IF angle_offset<>0
                IF arc_positive!
                  next_angle=arc_end_angle+angle_offset
                ELSE
                  next_angle=arc_end_angle-angle_offset
                ENDIF
                end_u=COS(next_angle)*element_arc_radius+centre_u
                end_v=SIN(next_angle)*element_arc_radius+centre_v
              ENDIF
              end_depth=blank_top
            ENDIF
            ' going down through the layers or up
            IF from_layer|>=to_layer|
              layers_descending!=TRUE
              scan_column|=SUCC(from_layer|)
            ELSE
              layers_descending!=FALSE
              scan_column|=PRED(from_layer|)
            ENDIF
            segment_u=start_u
            segment_v=start_v
            end_x&=ROUND(start_u*view_scale)-origin_x_pixels&
            end_y&=-ROUND(start_v*view_scale)-origin_y_pixels&
            next_angle=running_angle
            ' the outer box, clipped to the view, for the window update after each piece
            IF box_left&<view_min_x&
              outer_left&=view_min_x&
            ELSE
              IF box_left&>view_max_x&
                outer_left&=view_max_x&
              ELSE
                outer_left&=box_left&
              ENDIF
            ENDIF
            IF box_top&<view_min_y&
              outer_top&=view_min_y&
            ELSE
              IF box_top&>view_max_y&
                outer_top&=view_max_y&
              ELSE
                outer_top&=box_top&
              ENDIF
            ENDIF
            IF box_right&>view_max_x&
              outer_right&=view_max_x&
            ELSE
              outer_right&=box_right&
            ENDIF
            IF box_bottom&>view_max_y&
              outer_bottom&=view_max_y&
            ELSE
              outer_bottom&=box_bottom&
            ENDIF
            outer_bitmap_left&=outer_left&+layer_offset_x&
            outer_bitmap_top&=outer_top&+layer_offset_y&
            outer_bitmap_right&=outer_right&+layer_offset_x&
            outer_bitmap_bottom&=outer_bottom&+layer_offset_y&
            outer_window_left&=outer_left&+view_origin_x&
            outer_window_top&=outer_top&+view_offset_y&
            outer_window_right&=outer_right&+view_origin_x&
            outer_window_bottom&=outer_bottom&+view_offset_y&
            ' one piece of the arc per depth layer
            REPEAT
              ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
              CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
              IF layers_descending!
                DEC scan_column|
              ELSE
                INC scan_column|
              ENDIF
              previous_u=segment_u
              previous_v=segment_v
              screen_x&=end_x&
              screen_y&=end_y&
              previous_angle=next_angle
              ' last layer: the piece ends at the end of the arc
              IF scan_column|=to_layer|
                segment_u=end_u
                segment_v=end_v
                IF layers_descending!
                  angle_offset=(end_depth-start_depth)/depth_delta
                ELSE
                  angle_offset=(end_depth-start_depth)/depth_delta
                ENDIF
                IF arc_positive!
                  next_angle=running_angle+angle_offset
                ELSE
                  next_angle=running_angle-angle_offset
                ENDIF
              ELSE
                ' the piece ends where the depth crosses the layer boundary
                IF from_layer|<>to_layer|
                  IF layers_descending!
                    angle_offset=(depth_level_table(PRED(scan_column|))-start_depth)/depth_delta
                  ELSE
                    angle_offset=(depth_level_table(scan_column|)-start_depth)/depth_delta
                  ENDIF
                  IF arc_positive!
                    next_angle=running_angle+angle_offset
                  ELSE
                    next_angle=running_angle-angle_offset
                  ENDIF
                  segment_u=COS(next_angle)*element_arc_radius+centre_u
                  segment_v=SIN(next_angle)*element_arc_radius+centre_v
                ENDIF
              ENDIF
              centre_angle_offset=previous_angle
              draw_end_angle=next_angle
              segment_angle=next_angle-previous_angle
              ' the piece's angles in tenths of a degree
              segment_start_tenths%=ROUND(centre_angle_offset*tenths_per_radian)
              segment_end_tenths%=ROUND(draw_end_angle*tenths_per_radian)
              IF NOT arc_positive!
                SWAP segment_start_tenths%,segment_end_tenths%
              ENDIF
              WHILE segment_start_tenths%<0 AND segment_start_tenths%<segment_end_tenths%
                segment_start_tenths%=segment_start_tenths%+3600
                segment_end_tenths%=segment_end_tenths%+3600
              WEND
              DEFFILL ,0,0
              BOUNDARY 0
              PBOX box_left&,box_top&,box_right&,box_bottom&
              BOUNDARY 1
              DEFFILL ,1,1
              DEFFILL ,1,1
              IF .002>ABS(segment_angle) AND FALSE
                end_x&=ROUND(segment_u*view_scale)-origin_x_pixels&
                end_y&=-ROUND(segment_v*view_scale)-origin_y_pixels&
                IF scan_column|=from_layer|
                  PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
                ELSE
                  IF scan_column|=to_layer|
                    PCIRCLE end_x&,end_y&,tool_radius_pixels&
                  ENDIF
                ENDIF
                BOUNDARY 0
              ELSE
                IF two_pi>ABS(segment_angle)
                  end_x&=ROUND(segment_u*view_scale)-origin_x_pixels&
                  end_y&=-ROUND(segment_v*view_scale)-origin_y_pixels&
                  PCIRCLE centre_x&,centre_y&,radius_pixels&,segment_start_tenths%,segment_end_tenths%
                  PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
                  PCIRCLE end_x&,end_y&,tool_radius_pixels&
                  BOUNDARY 0
                  DEFFILL ,0,0
                  PCIRCLE centre_x&,centre_y&,inner_radius_pixels&
                ELSE
                  PCIRCLE centre_x&,centre_y&,radius_pixels&,0,3600
                  BOUNDARY 0
                  DEFFILL ,0,0
                  PCIRCLE centre_x&,centre_y&,inner_radius_pixels&,0,3600
                ENDIF
              ENDIF
              layer_used!(scan_column|)=TRUE
              layer_mfdb%(0)=layer_bitmaps%(scan_column|)
              blit_params%(0)=window_left&
              blit_params%(1)=window_top&
              blit_params%(2)=window_right&
              blit_params%(3)=window_bottom&
              blit_params%(4)=bitmap_left&
              blit_params%(5)=bitmap_top&
              blit_params%(6)=bitmap_right&
              blit_params%(7)=bitmap_bottom&
              blit_params%(8)=7
              BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
              CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
              DEFFILL ,0,0
              PBOX outer_left&,outer_top&,outer_right&,outer_bottom&
              IF wireframe_view!
                layer_mfdb%(0)=layer_bitmaps%(1)
              ELSE
                FOR loop_index|=depth_levels_used| DOWNTO 1
                  IF layer_used!(loop_index|)
                    IF loop_index|=1
                      DEFFILL ,1,1
                    ELSE
                      DEFFILL ,2,depth_level_colours|(loop_index|)
                    ENDIF
                    PBOX outer_left&,outer_top&,outer_right&,outer_bottom&
                    layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                    blit_params%(0)=outer_bitmap_left&
                    blit_params%(1)=outer_bitmap_top&
                    blit_params%(2)=outer_bitmap_right&
                    blit_params%(3)=outer_bitmap_bottom&
                    blit_params%(4)=outer_window_left&
                    blit_params%(5)=outer_window_top&
                    blit_params%(6)=outer_window_right&
                    blit_params%(7)=outer_window_bottom&
                    blit_params%(8)=1
                    BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                    layer_mfdb%(0)=layer_bitmaps%(0)
                    blit_params%(0)=outer_window_left&
                    blit_params%(1)=outer_window_top&
                    blit_params%(2)=outer_window_right&
                    blit_params%(3)=outer_window_bottom&
                    blit_params%(4)=outer_bitmap_left&
                    blit_params%(5)=outer_bitmap_top&
                    blit_params%(6)=outer_bitmap_right&
                    blit_params%(7)=outer_bitmap_bottom&
                    blit_params%(8)=7
                    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
                  ENDIF
                NEXT loop_index|
                layer_mfdb%(0)=layer_bitmaps%(0)
              ENDIF
              screen_x&=MIN(work_right&,screen_max_x&)
              screen_y&=MIN(work_bottom&,screen_max_y&)
              blit_params%(0)=work_x&
              blit_params%(1)=work_y&
              blit_params%(2)=screen_x&
              blit_params%(3)=screen_y&
              blit_params%(4)=work_x&
              blit_params%(5)=work_y&
              blit_params%(6)=screen_x&
              blit_params%(7)=screen_y&
              blit_params%(8)=3
              BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
              blit_params%(0)=outer_bitmap_left&
              blit_params%(1)=outer_bitmap_top&
              blit_params%(2)=outer_bitmap_right&
              blit_params%(3)=outer_bitmap_bottom&
              blit_params%(4)=outer_window_left&
              blit_params%(5)=outer_window_top&
              blit_params%(6)=outer_window_right&
              blit_params%(7)=outer_window_bottom&
              BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
              CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
              ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
              ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
              IF sprite_shown! AND redraw_x&=window_handle|
                SPRITE tool_sprite$
              ENDIF
              redraw_x&=outer_window_left&
              redraw_y&=outer_window_top&
              redraw_width&=outer_window_right&-outer_window_left&
              redraw_height&=outer_window_bottom&-outer_window_top&
              IF redraw_x&<screen_width& AND redraw_y&<screen_height&
                ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
                IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                  IF screen_x&+rect_width&>screen_width&
                    rect_width&=screen_width&-screen_x&
                  ENDIF
                  IF screen_y&+rect_height&>screen_height&
                    rect_height&=screen_height&-screen_y&
                  ENDIF
                  DEC rect_width&
                  DEC rect_height&
                  blit_params%(0)=screen_x&
                  blit_params%(1)=screen_y&
                  blit_params%(2)=screen_x&+rect_width&
                  blit_params%(3)=screen_y&+rect_height&
                  blit_params%(4)=screen_x&
                  blit_params%(5)=screen_y&
                  blit_params%(6)=screen_x&+rect_width&
                  blit_params%(7)=screen_y&+rect_height&
                  blit_params%(8)=3
                  BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                ENDIF
                ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
                WHILE rect_height&<>0 OR rect_width&<>0
                  IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                    IF screen_x&+rect_width&>screen_width&
                      rect_width&=screen_width&-screen_x&
                    ENDIF
                    IF screen_y&+rect_height&>screen_height&
                      rect_height&=screen_height&-screen_y&
                    ENDIF
                    DEC rect_width&
                    DEC rect_height&
                    blit_params%(0)=screen_x&
                    blit_params%(1)=screen_y&
                    blit_params%(2)=screen_x&+rect_width&
                    blit_params%(3)=screen_y&+rect_height&
                    blit_params%(4)=screen_x&
                    blit_params%(5)=screen_y&
                    blit_params%(6)=screen_x&+rect_width&
                    blit_params%(7)=screen_y&+rect_height&
                    BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                  ENDIF
                  ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
                WEND
              ENDIF
              ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
              IF sprite_shown! AND redraw_x&=window_handle|
                IF end_v>=area_min_v AND end_v<=area_max_v AND end_u>=area_min_h AND end_u<=area_max_h
                  screen_x&=MIN(end_x&+view_origin_x&,screen_max_x&)
                  screen_y&=MIN(end_y&+view_offset_y&,screen_max_y&)
                  SPRITE tool_sprite$,screen_x&,screen_y&
                ENDIF
              ENDIF
              ' single step: wait for a key after each piece
              IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
                PRINT AT(text_column&+4,prompt_row|);SPC(70);
                PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
                REPEAT
                  work_text$=INKEY$
                UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
                IF ASC(work_text$)=32
                  stop_requested!=TRUE
                ENDIF
                PRINT AT(text_column&+6,prompt_row|);SPC(65);
              ENDIF
            UNTIL scan_column|=to_layer|
          ENDIF
          CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Draws an arc of radius element_arc_radius programmed in a side plane (the tool axis tool_axis| is one of the
' arc's axes, so the arc goes up and down). The view looks along the tool axis, so the arc shows as a straight
' strip whose depth changes along it. The routine finds the depth layers of the start, end, centre and the top
' and bottom of the circle, then walks the arc layer by layer: for each layer boundary it intersects the circle
' (the chord at that height), picks the intersection point that lies ahead in the arc's direction, and fills the
' strip between the previous point and that point into the layer bitmap. The first half handles arcs whose first
' plane axis is the reference axis, the second half the other plane; both end in the same view and window
' update.
PROCEDURE simulate_side_plane_arc(element_arc_radius)
  LOCAL previous_u,previous_v,start_height,segment_u,segment_v,end_height,point_u,point_v,centre_height,arc_start_layer&,arc_end_layer&,scan_index&,previous_layer&,item_count&,centre_layer&,circle_top_layer&,work_text$,circle_bottom_layer&,circle_top,circle_bottom,draw_centre_line!,saved_radius,box_margin&,double_margin&,circle_low_side,circle_high_side,screen_x&,screen_y&,end_x&,box_width&,outer_left&,outer_top&,outer_right&,outer_bottom&,box_left&,box_top&,box_right&,box_bottom&,layer_direction_up!,basic_variables,segment_length,second_operand,discriminant,next_u,point_distance,work_point_y,cut_depth,layer_point_angle,angle_wraps!,angle_offset,is_finished!,draw_segment!,turn_point_reached!,chord_low,chord_high,distance_low,distance_high,abs_distance_low,abs_distance_high,arc_start_angle,arc_end_angle,previous_layer_angle,previous_plane_angle,line_index&,rect_width&,inner_index|,stripe_left_dx&,stripe_right_dx&,stripe_left_dy&,stripe_right_dy&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,window_left&,window_top&,window_right&,window_bottom&,restore_flag!,arc_positive!,start_offset_u,start_offset_v,start_offset_height,end_offset_u,end_offset_v,end_offset_height,chord_low_angle,chord_high_angle,chord_low_turn,chord_high_turn,window_handle|,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' the radius to three decimals
  element_arc_radius=ROUND(1000*element_arc_radius)/1000
  ' the circle reaches below the workpiece top
  IF blank_top>previous_centre(tool_axis|)-element_arc_radius
    ' start, end and centre height along the reference axis
    start_height=previous_block_start(tool_axis|)
    end_height=move_end(tool_axis|)
    centre_height=previous_centre(tool_axis|)
    ' layer of the start: arc_start_layer&
    IF start_height<=blank_bottom
      arc_start_layer&=1
    ELSE
      IF start_height>=blank_top
        arc_start_layer&=top_level|
      ELSE
        scan_index&=0
        REPEAT
          INC scan_index&
        UNTIL scan_index&=layer_depth_count| OR (start_height>depth_level_table(scan_index&) AND start_height<=depth_level_table(SUCC(scan_index&)))
        arc_start_layer&=scan_index&+1
      ENDIF
    ENDIF
    ' layer of the end: arc_end_layer&
    IF end_height<=blank_bottom
      arc_end_layer&=1
    ELSE
      IF end_height>=blank_top
        arc_end_layer&=top_level|
      ELSE
        scan_index&=0
        REPEAT
          INC scan_index&
        UNTIL scan_index&=layer_depth_count| OR (end_height>depth_level_table(scan_index&) AND end_height<=depth_level_table(SUCC(scan_index&)))
        arc_end_layer&=scan_index&+1
      ENDIF
    ENDIF
    ' layer of the centre: centre_layer&
    IF centre_height<=blank_bottom
      centre_layer&=1
    ELSE
      IF centre_height>=blank_top
        centre_layer&=top_level|
      ELSE
        scan_index&=0
        REPEAT
          INC scan_index&
        UNTIL scan_index&=layer_depth_count| OR (centre_height>depth_level_table(scan_index&) AND centre_height<=depth_level_table(SUCC(scan_index&)))
        centre_layer&=scan_index&+1
      ENDIF
    ENDIF
    ' layer of the top of the circle: circle_top_layer&
    circle_top=centre_height+element_arc_radius
    IF circle_top<=blank_bottom
      circle_top_layer&=1
    ELSE
      IF circle_top>=blank_top
        circle_top_layer&=top_level|
      ELSE
        scan_index&=0
        REPEAT
          INC scan_index&
        UNTIL scan_index&=layer_depth_count| OR (circle_top>depth_level_table(scan_index&) AND circle_top<=depth_level_table(SUCC(scan_index&)))
        circle_top_layer&=scan_index&+1
      ENDIF
    ENDIF
    ' layer of the bottom of the circle: circle_bottom_layer&
    circle_bottom=centre_height-element_arc_radius
    IF circle_bottom<=blank_bottom
      circle_bottom_layer&=1
    ELSE
      IF circle_bottom>=blank_top
        circle_bottom_layer&=top_level|
      ELSE
        scan_index&=0
        REPEAT
          INC scan_index&
        UNTIL scan_index&=layer_depth_count| OR (circle_bottom>depth_level_table(scan_index&) AND circle_bottom<=depth_level_table(SUCC(scan_index&)))
        circle_bottom_layer&=scan_index&+1
      ENDIF
    ENDIF
    ' the whole circle is in one layer
    IF circle_top_layer&=circle_bottom_layer&
      restore_flag!=TRUE
    ELSE
      restore_flag!=FALSE
    ENDIF
    IF ODD(stripe_mode|) OR stripe_mode|=0
      draw_centre_line!=TRUE
    ELSE
      draw_centre_line!=FALSE
    ENDIF
    saved_radius=element_arc_radius*element_arc_radius
    box_margin&=tool_radius_pixels&+4
    double_margin&=box_margin&*2
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
    ' the first plane axis is the reference axis: the arc shows along the second axis
    IF first_plane_axis|=tool_axis|
      DEFLINE ,section_line_width|
      previous_u=previous_block_start(second_plane_axis|)
      previous_v=previous_block_start(infeed_axis|)
      segment_u=move_end(second_plane_axis|)
      point_u=previous_centre(second_plane_axis|)
      circle_low_side=point_u-element_arc_radius
      circle_high_side=point_u+element_arc_radius
      start_offset_u=previous_u-point_u
      start_offset_height=start_height-centre_height
      arc_start_angle=start_offset_height/element_arc_radius
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF start_offset_u<0
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
      end_offset_u=segment_u-point_u
      end_offset_height=end_height-centre_height
      arc_end_angle=end_offset_height/element_arc_radius
      arc_end_angle=@clamped_arc_cosine(arc_end_angle)
      IF end_offset_u<0
        arc_end_angle=two_pi-arc_end_angle
      ENDIF
      ' the direction
      arc_positive!=(move_arc_direction$="-")
      IF 1E-06>ABS(arc_start_angle-arc_end_angle)
        arc_positive!=TRUE
        arc_start_angle=PI*1.5
        arc_end_angle=PI*1.5
        previous_u=circle_low_side
        start_height=centre_height
        segment_u=circle_low_side
        end_height=centre_height
        IF start_height<=blank_bottom
          arc_start_layer&=1
        ELSE
          IF start_height>=blank_top
            arc_start_layer&=top_level|
          ELSE
            scan_index&=0
            REPEAT
              INC scan_index&
            UNTIL scan_index&=layer_depth_count| OR (start_height>depth_level_table(scan_index&) AND start_height<=depth_level_table(SUCC(scan_index&)))
            arc_start_layer&=scan_index&+1
          ENDIF
        ENDIF
        IF end_height<=blank_bottom
          arc_end_layer&=1
        ELSE
          IF end_height>=blank_top
            arc_end_layer&=top_level|
          ELSE
            scan_index&=0
            REPEAT
              INC scan_index&
            UNTIL scan_index&=layer_depth_count| OR (end_height>depth_level_table(scan_index&) AND end_height<=depth_level_table(SUCC(scan_index&)))
            arc_end_layer&=scan_index&+1
          ENDIF
        ENDIF
      ENDIF
      screen_x&=ROUND(previous_u*view_scale)-origin_x_pixels&
      end_x&=ROUND(segment_u*view_scale)-origin_x_pixels&
      screen_y&=-ROUND(previous_v*view_scale)-origin_y_pixels&
      box_width&=double_margin&+ABS(screen_x&-end_x&)
      IF screen_x&<end_x&
        outer_left&=screen_x&
      ELSE
        outer_left&=end_x&
      ENDIF
      SUB outer_left&,box_margin&
      IF outer_left&<work_min_x&
        outer_left&=work_min_x&
      ELSE
        IF outer_left&>work_max_x&
          outer_left&=work_max_x&
        ENDIF
      ENDIF
      outer_top&=screen_y&-box_margin&
      IF outer_top&<work_min_y&
        outer_top&=work_min_y&
      ELSE
        IF outer_top&>work_max_y&
          outer_top&=work_max_y&
        ENDIF
      ENDIF
      outer_right&=outer_left&+box_width&
      IF outer_right&>work_max_x&
        outer_right&=work_max_x&
      ENDIF
      outer_bottom&=screen_y&+box_margin&
      IF outer_bottom&<work_min_y&
        outer_bottom&=work_min_y&
      ELSE
        IF outer_bottom&>work_max_y&
          outer_bottom&=work_max_y&
        ENDIF
      ENDIF
      IF arc_positive! AND (arc_start_angle<arc_end_angle OR 1E-06>ABS(arc_start_angle-arc_end_angle))
        SUB arc_end_angle,two_pi
      ELSE
        IF (NOT arc_positive!) AND (arc_start_angle>arc_end_angle OR 1E-06>ABS(arc_start_angle-arc_end_angle))
          arc_end_angle=arc_end_angle+two_pi
        ENDIF
      ENDIF
      IF arc_positive!
        IF 1E-06>ABS(previous_u-point_u)
          IF 1E-06>ABS(start_height-circle_top)
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ELSE
          IF previous_u>point_u
            layer_direction_up!=TRUE
          ELSE
            layer_direction_up!=FALSE
          ENDIF
        ENDIF
      ELSE
        IF 1E-06>ABS(previous_u-point_u)
          IF 1E-06>ABS(start_height-circle_top)
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ELSE
          IF previous_u>point_u
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ENDIF
      ENDIF
      ' start at the start layer; item_count& is the layer step (+1 up, -1 down)
      scan_index&=arc_start_layer&
      IF layer_direction_up!
        DEC scan_index&
        item_count&=1
      ELSE
        item_count&=-1
      ENDIF
      point_distance=previous_u
      cut_depth=start_height
      previous_layer_angle=arc_start_angle
      layer_point_angle=arc_start_angle
      is_finished!=FALSE
      ' one layer boundary per pass
      REPEAT
        draw_segment!=TRUE
        turn_point_reached!=FALSE
        previous_layer&=scan_index&
        scan_index&=scan_index&+item_count&
        IF scan_index&>top_level|
          scan_index&=top_level|
        ENDIF
        IF (NOT layer_direction_up!) AND (previous_layer&=arc_start_layer& OR (scan_index&=arc_end_layer& AND 1E-06>ABS(end_height-depth_level_table(scan_index&)))) OR (layer_direction_up! AND (scan_index&=arc_start_layer& OR 1E-06>ABS(end_height-depth_level_table(scan_index&)))) AND layer_point_angle<>arc_start_angle
          angle_wraps!=TRUE
        ELSE
          angle_wraps!=FALSE
        ENDIF
        ' all in one layer: one strip to the end
        IF restore_flag!
          IF previous_u=segment_u AND start_height=end_height
            point_distance=circle_low_side
            next_u=circle_high_side
          ELSE
            next_u=segment_u
          ENDIF
          angle_offset=end_height
          turn_point_reached!=TRUE
          is_finished!=TRUE
        ELSE
          ' the top layer: intersect the circle with the workpiece top
          IF scan_index&=top_level|
            draw_segment!=FALSE
            second_operand=depth_level_table(PRED(scan_index&))-centre_height
            second_operand=(saved_radius-second_operand*second_operand)*4
            IF 1E-07>ABS(second_operand) OR second_operand<0
              second_operand=0
            ENDIF
            discriminant=SQR(second_operand)/2
            chord_low=point_u-discriminant
            chord_high=point_u+discriminant
            angle_offset=blank_top
            start_offset_u=chord_low-point_u
            start_offset_height=angle_offset-centre_height
            chord_low_angle=start_offset_height/element_arc_radius
            chord_low_angle=@clamped_arc_cosine(chord_low_angle)
            IF start_offset_u<0
              chord_low_angle=two_pi-chord_low_angle
            ENDIF
            end_offset_u=chord_high-point_u
            chord_high_angle=start_offset_height/element_arc_radius
            chord_high_angle=@clamped_arc_cosine(chord_high_angle)
            IF end_offset_u<0
              chord_high_angle=two_pi-chord_high_angle
            ENDIF
            IF arc_positive!
              IF arc_start_angle<chord_low_angle OR angle_wraps!
                SUB chord_low_angle,two_pi
              ENDIF
              IF arc_start_angle<chord_high_angle OR angle_wraps!
                SUB chord_high_angle,two_pi
              ENDIF
            ELSE
              IF arc_start_angle>chord_low_angle OR angle_wraps!
                chord_low_angle=chord_low_angle+two_pi
              ENDIF
              IF arc_start_angle>chord_high_angle OR angle_wraps!
                chord_high_angle=chord_high_angle+two_pi
              ENDIF
            ENDIF
            IF 1E-06>ABS(point_distance-chord_low)
              next_u=chord_high
              layer_point_angle=chord_high_angle
            ELSE
              IF 1E-06>ABS(point_distance-chord_high)
                next_u=chord_low
                layer_point_angle=chord_low_angle
              ELSE
                distance_low=ABS(chord_low-point_distance)
                distance_high=ABS(chord_high-point_distance)
                IF distance_low<distance_high
                  next_u=chord_low
                  layer_point_angle=chord_low_angle
                ELSE
                  next_u=chord_high
                  layer_point_angle=chord_high_angle
                ENDIF
              ENDIF
            ENDIF
            angle_offset=blank_top
            IF scan_index&=centre_layer& AND centre_layer&=arc_end_layer&
              is_finished!=TRUE
            ENDIF
          ELSE
            ' intersect the circle with the layer boundary: half chord from (r^2-d^2)*4
            second_operand=depth_level_table(scan_index&)-centre_height
            second_operand=(saved_radius-second_operand*second_operand)*4
            IF .001>ABS(second_operand)
              second_operand=0
            ENDIF
            ' the boundary misses the circle: the arc turns back at the top or bottom
            IF second_operand<0
              turn_point_reached!=TRUE
              second_operand=depth_level_table(scan_index&-item_count&)-centre_height
              second_operand=(saved_radius-second_operand*second_operand)*4
              IF 1E-07>ABS(second_operand) OR second_operand<0
                second_operand=0
              ENDIF
              ' the two intersections chord_low, chord_high and their angles chord_low_angle, chord_high_angle
              discriminant=SQR(second_operand)/2
              chord_low=point_u-discriminant
              chord_high=point_u+discriminant
              angle_offset=depth_level_table(scan_index&-item_count&)
              start_offset_u=chord_low-point_u
              start_offset_height=angle_offset-centre_height
              chord_low_angle=start_offset_height/element_arc_radius
              chord_low_angle=@clamped_arc_cosine(chord_low_angle)
              IF start_offset_u<0
                chord_low_angle=two_pi-chord_low_angle
              ENDIF
              end_offset_u=chord_high-point_u
              chord_high_angle=start_offset_height/element_arc_radius
              chord_high_angle=@clamped_arc_cosine(chord_high_angle)
              IF end_offset_u<0
                chord_high_angle=two_pi-chord_high_angle
              ENDIF
              IF arc_positive!
                IF arc_start_angle<chord_low_angle OR angle_wraps!
                  SUB chord_low_angle,two_pi
                ENDIF
                IF arc_start_angle<chord_high_angle OR angle_wraps!
                  SUB chord_high_angle,two_pi
                ENDIF
              ELSE
                IF arc_start_angle>chord_low_angle OR angle_wraps!
                  chord_low_angle=chord_low_angle+two_pi
                ENDIF
                IF arc_start_angle>chord_high_angle OR angle_wraps!
                  chord_high_angle=chord_high_angle+two_pi
                ENDIF
              ENDIF
              IF 1E-06>ABS(point_distance-chord_low)
                next_u=chord_high
                layer_point_angle=chord_high_angle
              ELSE
                IF 1E-06>ABS(point_distance-chord_high)
                  next_u=chord_low
                  layer_point_angle=chord_low_angle
                ELSE
                  chord_low_turn=chord_low_angle-previous_layer_angle
                  chord_high_turn=chord_high_angle-previous_layer_angle
                  IF SGN(chord_low_turn)=SGN(chord_high_turn)
                    IF ABS(chord_low_turn)<ABS(chord_high_turn)
                      next_u=chord_low
                      layer_point_angle=chord_low_angle
                    ELSE
                      next_u=chord_high
                      layer_point_angle=chord_high_angle
                    ENDIF
                  ELSE
                    IF arc_positive!
                      IF chord_low_angle<chord_high_angle
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        next_u=chord_high
                        layer_point_angle=chord_high_angle
                      ENDIF
                    ELSE
                      IF chord_low_angle>chord_high_angle
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        next_u=chord_high
                        layer_point_angle=chord_high_angle
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
              IF (NOT layer_direction_up!) AND previous_layer&=arc_end_layer& AND previous_layer&=circle_bottom_layer& OR (layer_direction_up! AND scan_index&=circle_top_layer& AND scan_index&=arc_end_layer&)
                is_finished!=TRUE
              ENDIF
            ELSE
              discriminant=SQR(second_operand)/2
              chord_low=point_u-discriminant
              chord_high=point_u+discriminant
              angle_offset=depth_level_table(scan_index&)
              start_offset_u=chord_low-point_u
              start_offset_height=angle_offset-centre_height
              chord_low_angle=start_offset_height/element_arc_radius
              chord_low_angle=@clamped_arc_cosine(chord_low_angle)
              IF start_offset_u<0
                chord_low_angle=two_pi-chord_low_angle
              ENDIF
              end_offset_u=chord_high-point_u
              chord_high_angle=start_offset_height/element_arc_radius
              chord_high_angle=@clamped_arc_cosine(chord_high_angle)
              IF end_offset_u<0
                chord_high_angle=two_pi-chord_high_angle
              ENDIF
              IF arc_positive!
                IF arc_start_angle<chord_low_angle OR angle_wraps!
                  SUB chord_low_angle,two_pi
                ENDIF
                IF arc_start_angle<chord_high_angle OR angle_wraps!
                  SUB chord_high_angle,two_pi
                ENDIF
              ELSE
                IF arc_start_angle>chord_low_angle OR angle_wraps!
                  chord_low_angle=chord_low_angle+two_pi
                ENDIF
                IF arc_start_angle>chord_high_angle OR angle_wraps!
                  chord_high_angle=chord_high_angle+two_pi
                ENDIF
              ENDIF
              IF 1E-06>ABS(chord_low-chord_high)
                next_u=chord_low
                layer_point_angle=chord_low_angle
              ELSE
                IF 1E-06>ABS(point_distance-chord_low) AND (scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&))
                  next_u=chord_high
                  layer_point_angle=chord_high_angle
                ELSE
                  IF 1E-06>ABS(point_distance-chord_high) AND (scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&))
                    next_u=chord_low
                    layer_point_angle=chord_low_angle
                  ELSE
                    distance_low=chord_low-point_distance
                    distance_high=chord_high-point_distance
                    abs_distance_low=ABS(distance_low)
                    abs_distance_high=ABS(distance_high)
                    IF 1E-06>ABS(abs_distance_low-abs_distance_high)
                      chord_low_turn=chord_low_angle-previous_layer_angle
                      chord_high_turn=chord_high_angle-previous_layer_angle
                      IF SGN(chord_low_turn)=SGN(chord_high_turn)
                        IF ABS(chord_low_turn)<ABS(chord_high_turn)
                          next_u=chord_low
                          layer_point_angle=chord_low_angle
                        ELSE
                          next_u=chord_high
                          layer_point_angle=chord_high_angle
                        ENDIF
                      ELSE
                        IF arc_positive!
                          IF chord_low_angle<chord_high_angle
                            next_u=chord_low
                            layer_point_angle=chord_low_angle
                          ELSE
                            next_u=chord_high
                            layer_point_angle=chord_high_angle
                          ENDIF
                        ELSE
                          IF chord_low_angle>chord_high_angle
                            next_u=chord_low
                            layer_point_angle=chord_low_angle
                          ELSE
                            next_u=chord_high
                            layer_point_angle=chord_high_angle
                          ENDIF
                        ENDIF
                      ENDIF
                    ELSE
                      IF abs_distance_low<abs_distance_high
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        IF abs_distance_low>abs_distance_high
                          next_u=chord_high
                          layer_point_angle=chord_high_angle
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        IF layer_direction_up! AND scan_index&=arc_end_layer& OR ((NOT layer_direction_up!) AND previous_layer&=arc_end_layer&)
          IF arc_positive! AND (layer_point_angle<arc_end_angle OR 1E-06>ABS(layer_point_angle-arc_end_angle))
            is_finished!=TRUE
          ELSE
            IF (NOT arc_positive!) AND (layer_point_angle>arc_end_angle OR 1E-06>ABS(layer_point_angle-arc_end_angle))
              is_finished!=TRUE
            ENDIF
          ENDIF
          ' last strip: it ends at the end of the arc
          IF is_finished!
            next_u=segment_u
            angle_offset=end_height
            layer_point_angle=arc_end_angle
          ENDIF
        ENDIF
        IF NOT layer_direction_up!
          SUB scan_index&,item_count&
        ENDIF
        basic_variables=point_distance
        segment_length=next_u
        ' in the centre layer the strip may pass the circle's side
        IF scan_index&=centre_layer&
          IF cut_depth>centre_height AND angle_offset<centre_height
            distance_low=ABS(point_distance-point_u)
            distance_high=ABS(next_u-point_u)
            IF distance_low<distance_high
              basic_variables=point_distance
            ELSE
              basic_variables=next_u
            ENDIF
            IF arc_positive!
              segment_length=circle_low_side
            ELSE
              segment_length=circle_high_side
            ENDIF
          ELSE
            IF cut_depth<centre_height AND angle_offset>centre_height
              distance_low=ABS(point_distance-point_u)
              distance_high=ABS(next_u-point_u)
              IF distance_low<distance_high
                basic_variables=point_distance
              ELSE
                basic_variables=next_u
              ENDIF
              IF arc_positive!
                segment_length=circle_high_side
              ELSE
                segment_length=circle_low_side
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' draw the strip from basic_variables to segment_length into the layer bitmap
        IF draw_segment! AND previous_layer&<top_level|
          line_index&=ROUND(basic_variables*view_scale)-origin_x_pixels&
          rect_width&=ROUND(segment_length*view_scale)-origin_x_pixels&
          IF wireframe_view!
            box_width&=double_margin&+ABS(line_index&-rect_width&)
            IF line_index&<rect_width&
              box_left&=line_index&
            ELSE
              box_left&=rect_width&
            ENDIF
            SUB box_left&,box_margin&
            IF box_left&<work_min_x&
              box_left&=work_min_x&
            ELSE
              IF box_left&>work_max_x&
                box_left&=work_max_x&
              ENDIF
            ENDIF
            box_right&=box_left&+box_width&
            IF box_right&>work_max_x&
              box_right&=work_max_x&
            ENDIF
            DEFFILL ,0,0
            BOUNDARY 0
            PBOX box_left&,outer_top&,box_right&,outer_bottom&
            BOUNDARY 1
            DEFFILL ,1,1
            DRAW line_index&,screen_y&,rect_width&,screen_y&
            layer_mfdb%(0)=layer_bitmaps%(1)
          ELSE
            layer_used!(scan_index&)=TRUE
            inner_index|=FALSE
            REPEAT
              IF inner_index|=0
                box_width&=double_margin&+ABS(line_index&-rect_width&)
                IF line_index&<rect_width&
                  box_left&=line_index&
                ELSE
                  box_left&=rect_width&
                ENDIF
                SUB box_left&,box_margin&
                IF box_left&<work_min_x&
                  box_left&=work_min_x&
                ELSE
                  IF box_left&>work_max_x&
                    box_left&=work_max_x&
                  ENDIF
                ENDIF
                box_right&=box_left&+box_width&
                IF box_right&>work_max_x&
                  box_right&=work_max_x&
                ENDIF
                DEFFILL ,0,0
                BOUNDARY 0
                PBOX box_left&,outer_top&,box_right&,outer_bottom&
                BOUNDARY 1
                DEFFILL ,1,1
                PCIRCLE line_index&,screen_y&,tool_radius_pixels&
                PCIRCLE rect_width&,screen_y&,tool_radius_pixels&
                IF draw_centre_line!
                  DRAW line_index&,screen_y&,rect_width&,screen_y&
                ENDIF
              ELSE
                stripe_left_dy&=-tool_disc_rows&(inner_index|)
                stripe_right_dy&=-stripe_left_dy&
                DRAW line_index&,screen_y&+stripe_left_dy&,rect_width&,screen_y&+stripe_left_dy&
                DRAW line_index&,screen_y&+stripe_right_dy&,rect_width&,screen_y&+stripe_right_dy&
              ENDIF
              INC inner_index|
            UNTIL tool_disc_rows&(inner_index|)=0
            layer_mfdb%(0)=layer_bitmaps%(scan_index&)
          ENDIF
          BOUNDARY 0
          bitmap_left&=box_left&+layer_offset_x&
          bitmap_top&=outer_top&+layer_offset_y&
          bitmap_right&=box_right&+layer_offset_x&
          bitmap_bottom&=outer_bottom&+layer_offset_y&
          window_left&=box_left&+work_offset_x&
          window_top&=outer_top&+work_offset_y&
          window_right&=box_right&+work_offset_x&
          window_bottom&=outer_bottom&+work_offset_y&
          blit_params%(0)=window_left&
          blit_params%(1)=window_top&
          blit_params%(2)=window_right&
          blit_params%(3)=window_bottom&
          blit_params%(4)=bitmap_left&
          blit_params%(5)=bitmap_top&
          blit_params%(6)=bitmap_right&
          blit_params%(7)=bitmap_bottom&
          blit_params%(8)=7
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          IF outer_left&>box_left&
            outer_left&=box_left&
          ENDIF
          ' grow the outer box by the strip's box
          IF outer_right&<box_right&
            outer_right&=box_right&
          ENDIF
        ENDIF
        IF NOT layer_direction_up!
          scan_index&=scan_index&+item_count&
        ENDIF
        ' next layer; at the top or bottom of the circle the direction reverses
        IF NOT is_finished!
          IF scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&)
            layer_direction_up!=NOT layer_direction_up!
            item_count&=-item_count&
            IF layer_direction_up! AND turn_point_reached!
              INC scan_index&
            ENDIF
          ENDIF
          point_distance=next_u
          cut_depth=angle_offset
          previous_layer_angle=layer_point_angle
        ENDIF
      UNTIL is_finished!
    ELSE
      DEFLINE ,tool_diameter_pixels|
      previous_u=previous_block_start(infeed_axis|)
      previous_v=previous_block_start(first_plane_axis|)
      segment_v=move_end(first_plane_axis|)
      point_v=previous_centre(first_plane_axis|)
      circle_low_side=point_v-element_arc_radius
      circle_high_side=point_v+element_arc_radius
      start_offset_v=previous_v-point_v
      start_offset_height=start_height-centre_height
      arc_start_angle=start_offset_v/element_arc_radius
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF start_offset_height<0
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
      end_offset_v=segment_v-point_v
      end_offset_height=end_height-centre_height
      arc_end_angle=end_offset_v/element_arc_radius
      arc_end_angle=@clamped_arc_cosine(arc_end_angle)
      IF end_offset_height<0
        arc_end_angle=two_pi-arc_end_angle
      ENDIF
      arc_positive!=(move_arc_direction$="-")
      IF 1E-06>ABS(arc_start_angle-arc_end_angle)
        arc_positive!=TRUE
        arc_start_angle=PI
        arc_end_angle=PI
        previous_v=circle_low_side
        start_height=centre_height
        segment_v=circle_low_side
        end_height=centre_height
        IF start_height<=blank_bottom
          arc_start_layer&=1
        ELSE
          IF start_height>=blank_top
            arc_start_layer&=top_level|
          ELSE
            scan_index&=0
            ' one layer boundary per pass
            REPEAT
              INC scan_index&
            UNTIL scan_index&=layer_depth_count| OR (start_height>depth_level_table(scan_index&) AND start_height<=depth_level_table(SUCC(scan_index&)))
            arc_start_layer&=scan_index&+1
          ENDIF
        ENDIF
        IF end_height<=blank_bottom
          arc_end_layer&=1
        ELSE
          IF end_height>=blank_top
            arc_end_layer&=top_level|
          ELSE
            scan_index&=0
            REPEAT
              INC scan_index&
            UNTIL scan_index&=layer_depth_count| OR (end_height>depth_level_table(scan_index&) AND end_height<=depth_level_table(SUCC(scan_index&)))
            arc_end_layer&=scan_index&+1
          ENDIF
        ENDIF
      ENDIF
      screen_x&=ROUND(previous_u*view_scale)-origin_x_pixels&
      screen_y&=-ROUND(previous_v*view_scale)-origin_y_pixels&
      end_x&=-ROUND(segment_v*view_scale)-origin_y_pixels&
      box_width&=double_margin&+ABS(screen_y&-end_x&)
      IF screen_y&<end_x&
        outer_top&=screen_y&
      ELSE
        outer_top&=end_x&
      ENDIF
      SUB outer_top&,box_margin&
      IF outer_top&<work_min_y&
        outer_top&=work_min_y&
      ELSE
        IF outer_top&>work_max_y&
          outer_top&=work_max_y&
        ENDIF
      ENDIF
      outer_left&=screen_x&-box_margin&
      IF outer_left&<work_min_x&
        outer_left&=work_min_x&
      ELSE
        IF outer_left&>work_max_x&
          outer_left&=work_max_x&
        ENDIF
      ENDIF
      outer_bottom&=outer_top&+box_width&
      IF outer_bottom&>work_max_y&
        outer_bottom&=work_max_y&
      ENDIF
      outer_right&=screen_x&+box_margin&
      IF outer_right&<work_min_x&
        outer_right&=work_min_x&
      ELSE
        IF outer_right&>work_max_x&
          outer_right&=work_max_x&
        ENDIF
      ENDIF
      IF arc_positive! AND (arc_start_angle<arc_end_angle OR 1E-06>ABS(arc_start_angle-arc_end_angle))
        SUB arc_end_angle,two_pi
      ELSE
        IF (NOT arc_positive!) AND (arc_start_angle>arc_end_angle OR 1E-06>ABS(arc_start_angle-arc_end_angle))
          arc_end_angle=arc_end_angle+two_pi
        ENDIF
      ENDIF
      IF NOT arc_positive!
        IF 1E-06>ABS(previous_v-point_v)
          IF 1E-06>ABS(start_height-circle_top)
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ELSE
          IF previous_v>point_v
            layer_direction_up!=TRUE
          ELSE
            layer_direction_up!=FALSE
          ENDIF
        ENDIF
      ELSE
        IF 1E-06>ABS(previous_v-point_v)
          IF 1E-06>ABS(start_height-circle_top)
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ELSE
          IF previous_v>point_v
            layer_direction_up!=FALSE
          ELSE
            layer_direction_up!=TRUE
          ENDIF
        ENDIF
      ENDIF
      scan_index&=arc_start_layer&
      IF layer_direction_up!
        DEC scan_index&
        item_count&=1
      ELSE
        item_count&=-1
      ENDIF
      work_point_y=previous_v
      cut_depth=start_height
      previous_plane_angle=arc_start_angle
      layer_point_angle=arc_start_angle
      is_finished!=FALSE
      REPEAT
        draw_segment!=TRUE
        turn_point_reached!=FALSE
        previous_layer&=scan_index&
        scan_index&=scan_index&+item_count&
        IF scan_index&>top_level|
          scan_index&=top_level|
        ENDIF
        IF (NOT layer_direction_up!) AND (previous_layer&=arc_start_layer& OR (scan_index&=arc_end_layer& AND 1E-06>ABS(end_height-depth_level_table(scan_index&)))) OR (layer_direction_up! AND (scan_index&=arc_start_layer& OR 1E-06>ABS(end_height-depth_level_table(scan_index&)))) AND layer_point_angle<>arc_start_angle
          angle_wraps!=TRUE
        ELSE
          angle_wraps!=FALSE
        ENDIF
        IF restore_flag!
          IF previous_v=segment_v AND start_height=end_height
            work_point_y=circle_low_side
            next_u=circle_high_side
          ELSE
            next_u=segment_v
          ENDIF
          angle_offset=end_height
          turn_point_reached!=TRUE
          is_finished!=TRUE
        ELSE
          IF scan_index&=top_level|
            draw_segment!=FALSE
            second_operand=depth_level_table(PRED(scan_index&))-centre_height
            second_operand=(saved_radius-second_operand*second_operand)*4
            IF 1E-07>ABS(second_operand) OR second_operand<0
              second_operand=0
            ENDIF
            discriminant=SQR(second_operand)/2
            chord_low=point_v-discriminant
            chord_high=point_v+discriminant
            angle_offset=blank_top
            start_offset_v=chord_low-point_v
            start_offset_height=angle_offset-centre_height
            chord_low_angle=start_offset_v/element_arc_radius
            chord_low_angle=@clamped_arc_cosine(chord_low_angle)
            IF start_offset_height<0
              chord_low_angle=two_pi-chord_low_angle
            ENDIF
            end_offset_v=chord_high-point_v
            chord_high_angle=end_offset_v/element_arc_radius
            chord_high_angle=@clamped_arc_cosine(chord_high_angle)
            IF start_offset_height<0
              chord_high_angle=two_pi-chord_high_angle
            ENDIF
            IF arc_positive!
              IF arc_start_angle<chord_low_angle OR angle_wraps!
                SUB chord_low_angle,two_pi
              ENDIF
              IF arc_start_angle<chord_high_angle OR angle_wraps!
                SUB chord_high_angle,two_pi
              ENDIF
            ELSE
              IF arc_start_angle>chord_low_angle OR angle_wraps!
                chord_low_angle=chord_low_angle+two_pi
              ENDIF
              IF arc_start_angle>chord_high_angle OR angle_wraps!
                chord_high_angle=chord_high_angle+two_pi
              ENDIF
            ENDIF
            IF 1E-06>ABS(work_point_y-chord_low)
              next_u=chord_high
              layer_point_angle=chord_high_angle
            ELSE
              IF 1E-06>ABS(work_point_y-chord_high)
                next_u=chord_low
                layer_point_angle=chord_low_angle
              ELSE
                distance_low=ABS(chord_low-work_point_y)
                distance_high=ABS(chord_high-work_point_y)
                IF distance_low<distance_high
                  next_u=chord_low
                  layer_point_angle=chord_low_angle
                ELSE
                  next_u=chord_high
                  layer_point_angle=chord_high_angle
                ENDIF
              ENDIF
            ENDIF
            IF scan_index&=centre_layer& AND centre_layer&=arc_end_layer&
              is_finished!=TRUE
            ENDIF
          ELSE
            second_operand=depth_level_table(scan_index&)-centre_height
            second_operand=(saved_radius-second_operand*second_operand)*4
            IF .001>ABS(second_operand)
              second_operand=0
            ENDIF
            IF second_operand<0
              turn_point_reached!=TRUE
              second_operand=depth_level_table(scan_index&-item_count&)-centre_height
              second_operand=(saved_radius-second_operand*second_operand)*4
              IF 1E-07>ABS(second_operand) OR second_operand<0
                second_operand=0
              ENDIF
              discriminant=SQR(second_operand)/2
              chord_low=point_v-discriminant
              chord_high=point_v+discriminant
              angle_offset=depth_level_table(scan_index&-item_count&)
              start_offset_v=chord_low-point_v
              start_offset_height=angle_offset-centre_height
              chord_low_angle=start_offset_v/element_arc_radius
              chord_low_angle=@clamped_arc_cosine(chord_low_angle)
              IF start_offset_height<0
                chord_low_angle=two_pi-chord_low_angle
              ENDIF
              end_offset_v=chord_high-point_v
              chord_high_angle=end_offset_v/element_arc_radius
              chord_high_angle=@clamped_arc_cosine(chord_high_angle)
              IF start_offset_height<0
                chord_high_angle=two_pi-chord_high_angle
              ENDIF
              IF arc_positive!
                IF arc_start_angle<chord_low_angle OR angle_wraps!
                  SUB chord_low_angle,two_pi
                ENDIF
                IF arc_start_angle<chord_high_angle OR angle_wraps!
                  SUB chord_high_angle,two_pi
                ENDIF
              ELSE
                IF arc_start_angle>chord_low_angle OR angle_wraps!
                  chord_low_angle=chord_low_angle+two_pi
                ENDIF
                IF arc_start_angle>chord_high_angle OR angle_wraps!
                  chord_high_angle=chord_high_angle+two_pi
                ENDIF
              ENDIF
              IF 1E-06>ABS(work_point_y-chord_low)
                next_u=chord_high
                layer_point_angle=chord_high_angle
              ELSE
                IF 1E-06>ABS(work_point_y-chord_high)
                  next_u=chord_low
                  layer_point_angle=chord_low_angle
                ELSE
                  chord_low_turn=chord_low_angle-previous_plane_angle
                  chord_high_turn=chord_high_angle-previous_plane_angle
                  IF SGN(chord_low_turn)=SGN(chord_high_turn)
                    IF ABS(chord_low_turn)<ABS(chord_high_turn)
                      next_u=chord_low
                      layer_point_angle=chord_low_angle
                    ELSE
                      next_u=chord_high
                      layer_point_angle=chord_high_angle
                    ENDIF
                  ELSE
                    IF arc_positive!
                      IF chord_low_angle<chord_high_angle
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        next_u=chord_high
                        layer_point_angle=chord_high_angle
                      ENDIF
                    ELSE
                      IF chord_low_angle>chord_high_angle
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        next_u=chord_high
                        layer_point_angle=chord_high_angle
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
              IF (NOT layer_direction_up!) AND previous_layer&=arc_end_layer& AND previous_layer&=circle_bottom_layer& OR (layer_direction_up! AND scan_index&=circle_top_layer& AND scan_index&=arc_end_layer&)
                is_finished!=TRUE
              ENDIF
            ELSE
              discriminant=SQR(second_operand)/2
              chord_low=point_v-discriminant
              chord_high=point_v+discriminant
              angle_offset=depth_level_table(scan_index&)
              start_offset_v=chord_low-point_v
              start_offset_height=angle_offset-centre_height
              chord_low_angle=start_offset_v/element_arc_radius
              chord_low_angle=@clamped_arc_cosine(chord_low_angle)
              IF start_offset_height<0
                chord_low_angle=two_pi-chord_low_angle
              ENDIF
              end_offset_v=chord_high-point_v
              chord_high_angle=end_offset_v/element_arc_radius
              chord_high_angle=@clamped_arc_cosine(chord_high_angle)
              IF start_offset_height<0
                chord_high_angle=two_pi-chord_high_angle
              ENDIF
              IF arc_positive!
                IF arc_start_angle<chord_low_angle OR angle_wraps!
                  SUB chord_low_angle,two_pi
                ENDIF
                IF arc_start_angle<chord_high_angle OR angle_wraps!
                  SUB chord_high_angle,two_pi
                ENDIF
              ELSE
                IF arc_start_angle>chord_low_angle OR angle_wraps!
                  chord_low_angle=chord_low_angle+two_pi
                ENDIF
                IF arc_start_angle>chord_high_angle OR angle_wraps!
                  chord_high_angle=chord_high_angle+two_pi
                ENDIF
              ENDIF
              IF 1E-06>ABS(chord_low-chord_high)
                next_u=chord_low
                layer_point_angle=chord_low_angle
              ELSE
                IF 1E-06>ABS(work_point_y-chord_low) AND (scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&))
                  next_u=chord_high
                  layer_point_angle=chord_high_angle
                ELSE
                  IF 1E-06>ABS(work_point_y-chord_high) AND (scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&))
                    next_u=chord_low
                    layer_point_angle=chord_low_angle
                  ELSE
                    distance_low=chord_low-work_point_y
                    distance_high=chord_high-work_point_y
                    abs_distance_low=ABS(distance_low)
                    abs_distance_high=ABS(distance_high)
                    IF 1E-06>ABS(abs_distance_low-abs_distance_high)
                      chord_low_turn=chord_low_angle-previous_plane_angle
                      chord_high_turn=chord_high_angle-previous_plane_angle
                      IF SGN(chord_low_turn)=SGN(chord_high_turn)
                        IF ABS(chord_low_turn)<ABS(chord_high_turn)
                          next_u=chord_low
                          layer_point_angle=chord_low_angle
                        ELSE
                          next_u=chord_high
                          layer_point_angle=chord_high_angle
                        ENDIF
                      ELSE
                        IF arc_positive!
                          IF chord_low_angle<chord_high_angle
                            next_u=chord_low
                            layer_point_angle=chord_low_angle
                          ELSE
                            next_u=chord_high
                            layer_point_angle=chord_high_angle
                          ENDIF
                        ELSE
                          IF chord_low_angle>chord_high_angle
                            next_u=chord_low
                            layer_point_angle=chord_low_angle
                          ELSE
                            next_u=chord_high
                            layer_point_angle=chord_high_angle
                          ENDIF
                        ENDIF
                      ENDIF
                    ELSE
                      IF abs_distance_low<abs_distance_high
                        next_u=chord_low
                        layer_point_angle=chord_low_angle
                      ELSE
                        IF abs_distance_low>abs_distance_high
                          next_u=chord_high
                          layer_point_angle=chord_high_angle
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        IF layer_direction_up! AND scan_index&=arc_end_layer& OR ((NOT layer_direction_up!) AND previous_layer&=arc_end_layer&)
          IF arc_positive! AND (layer_point_angle<arc_end_angle OR 1E-06>ABS(layer_point_angle-arc_end_angle))
            is_finished!=TRUE
          ELSE
            IF (NOT arc_positive!) AND (layer_point_angle>arc_end_angle OR 1E-06>ABS(layer_point_angle-arc_end_angle))
              is_finished!=TRUE
            ENDIF
          ENDIF
          IF is_finished!
            next_u=segment_v
            angle_offset=end_height
            layer_point_angle=arc_end_angle
          ENDIF
        ENDIF
        IF NOT layer_direction_up!
          SUB scan_index&,item_count&
        ENDIF
        basic_variables=work_point_y
        segment_length=next_u
        IF scan_index&=centre_layer&
          IF cut_depth>centre_height AND angle_offset<centre_height
            distance_low=ABS(work_point_y-point_v)
            distance_high=ABS(next_u-point_v)
            IF distance_low<distance_high
              basic_variables=work_point_y
            ELSE
              basic_variables=next_u
            ENDIF
            IF NOT arc_positive!
              segment_length=circle_low_side
            ELSE
              segment_length=circle_high_side
            ENDIF
          ELSE
            IF cut_depth<centre_height AND angle_offset>centre_height
              distance_low=ABS(work_point_y-point_v)
              distance_high=ABS(next_u-point_v)
              IF distance_low<distance_high
                basic_variables=work_point_y
              ELSE
                basic_variables=next_u
              ENDIF
              IF NOT arc_positive!
                segment_length=circle_high_side
              ELSE
                segment_length=circle_low_side
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        IF draw_segment! AND previous_layer&<top_level|
          line_index&=-ROUND(basic_variables*view_scale)-origin_y_pixels&
          rect_width&=-ROUND(segment_length*view_scale)-origin_y_pixels&
          IF wireframe_view!
            box_width&=double_margin&+ABS(line_index&-rect_width&)
            IF line_index&<rect_width&
              box_top&=line_index&
            ELSE
              box_top&=rect_width&
            ENDIF
            SUB box_top&,box_margin&
            IF box_top&<work_min_y&
              box_top&=work_min_y&
            ELSE
              IF box_top&>work_max_y&
                box_top&=work_max_y&
              ENDIF
            ENDIF
            box_bottom&=box_top&+box_width&
            IF box_bottom&>work_max_y&
              box_bottom&=work_max_y&
            ENDIF
            DEFFILL ,0,0
            ' show the outer box in the view
            BOUNDARY 0
            PBOX outer_left&,box_top&,outer_right&,box_bottom&
            BOUNDARY 1
            DEFFILL ,1,1
            DRAW screen_x&,line_index&,screen_x&,rect_width&
            layer_mfdb%(0)=layer_bitmaps%(1)
          ELSE
            layer_used!(scan_index&)=TRUE
            inner_index|=FALSE
            REPEAT
              IF inner_index|=0
                box_width&=double_margin&+ABS(line_index&-rect_width&)
                IF line_index&<rect_width&
                  box_top&=line_index&
                ELSE
                  box_top&=rect_width&
                ENDIF
                SUB box_top&,box_margin&
                IF box_top&<work_min_y&
                  box_top&=work_min_y&
                ELSE
                  IF box_top&>work_max_y&
                    box_top&=work_max_y&
                  ENDIF
                ENDIF
                box_bottom&=box_top&+box_width&
                IF box_bottom&>work_max_y&
                  box_bottom&=work_max_y&
                ENDIF
                DEFFILL ,0,0
                BOUNDARY 0
                PBOX outer_left&,box_top&,outer_right&,box_bottom&
                BOUNDARY 1
                DEFFILL ,1,1
                PCIRCLE screen_x&,line_index&,tool_radius_pixels&
                PCIRCLE screen_x&,rect_width&,tool_radius_pixels&
                IF draw_centre_line!
                  DRAW screen_x&,line_index&,screen_x&,rect_width&
                ENDIF
              ELSE
                stripe_left_dx&=-tool_disc_rows&(inner_index|)
                stripe_right_dx&=-stripe_left_dx&
                DRAW screen_x&+stripe_left_dx&,line_index&,screen_x&+stripe_left_dx&,rect_width&
                DRAW screen_x&+stripe_right_dx&,line_index&,screen_x&+stripe_right_dx&,rect_width&
              ENDIF
              INC inner_index|
            UNTIL tool_disc_rows&(inner_index|)=0
            layer_mfdb%(0)=layer_bitmaps%(scan_index&)
          ENDIF
          BOUNDARY 0
          bitmap_left&=outer_left&+layer_offset_x&
          bitmap_top&=box_top&+layer_offset_y&
          bitmap_right&=outer_right&+layer_offset_x&
          bitmap_bottom&=box_bottom&+layer_offset_y&
          window_left&=outer_left&+work_offset_x&
          window_top&=box_top&+work_offset_y&
          window_right&=outer_right&+work_offset_x&
          window_bottom&=box_bottom&+work_offset_y&
          blit_params%(0)=window_left&
          blit_params%(1)=window_top&
          blit_params%(2)=window_right&
          blit_params%(3)=window_bottom&
          blit_params%(4)=bitmap_left&
          blit_params%(5)=bitmap_top&
          blit_params%(6)=bitmap_right&
          blit_params%(7)=bitmap_bottom&
          blit_params%(8)=7
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          IF outer_top&>box_top&
            outer_top&=box_top&
          ENDIF
          IF outer_bottom&<box_bottom&
            outer_bottom&=box_bottom&
          ENDIF
        ENDIF
        IF NOT layer_direction_up!
          scan_index&=scan_index&+item_count&
        ENDIF
        IF NOT is_finished!
          IF scan_index&=circle_top_layer& OR scan_index&=PRED(circle_bottom_layer&)
            layer_direction_up!=NOT layer_direction_up!
            item_count&=-item_count&
            IF layer_direction_up! AND turn_point_reached!
              INC scan_index&
            ENDIF
          ENDIF
          work_point_y=next_u
          cut_depth=angle_offset
          previous_plane_angle=layer_point_angle
        ENDIF
      UNTIL is_finished!
    ENDIF
    BOUNDARY 0
    IF outer_left&<>outer_right& OR outer_top&<>outer_bottom&
      CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
      IF outer_left&<view_min_x&
        outer_left&=view_min_x&
      ELSE
        IF outer_left&>view_max_x&
          outer_left&=view_max_x&
        ENDIF
      ENDIF
      IF outer_top&<view_min_y&
        outer_top&=view_min_y&
      ELSE
        IF outer_top&>view_max_y&
          outer_top&=view_max_y&
        ENDIF
      ENDIF
      IF outer_right&>view_max_x&
        outer_right&=view_max_x&
      ENDIF
      IF outer_bottom&>view_max_y&
        outer_bottom&=view_max_y&
      ENDIF
      bitmap_left&=outer_left&+layer_offset_x&
      bitmap_top&=outer_top&+layer_offset_y&
      bitmap_right&=outer_right&+layer_offset_x&
      bitmap_bottom&=outer_bottom&+layer_offset_y&
      window_left&=outer_left&+view_origin_x&
      window_top&=outer_top&+view_offset_y&
      window_right&=outer_right&+view_origin_x&
      window_bottom&=outer_bottom&+view_offset_y&
      DEFFILL ,0,0
      PBOX outer_left&,outer_top&,outer_right&,outer_bottom&
      DEFFILL ,1,1
      IF wireframe_view!
        layer_mfdb%(0)=layer_bitmaps%(1)
      ELSE
        FOR scan_index&=depth_levels_used| DOWNTO 1
          IF layer_used!(scan_index&)
            IF scan_index&=1
              DEFFILL ,1,1
            ELSE
              DEFFILL ,2,depth_level_colours|(scan_index&)
            ENDIF
            PBOX outer_left&,outer_top&,outer_right&,outer_bottom&
            layer_mfdb%(0)=layer_bitmaps%(scan_index&)
            blit_params%(0)=bitmap_left&
            blit_params%(1)=bitmap_top&
            blit_params%(2)=bitmap_right&
            blit_params%(3)=bitmap_bottom&
            blit_params%(4)=window_left&
            blit_params%(5)=window_top&
            blit_params%(6)=window_right&
            blit_params%(7)=window_bottom&
            blit_params%(8)=1
            BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
            layer_mfdb%(0)=layer_bitmaps%(0)
          ENDIF
          blit_params%(0)=window_left&
          blit_params%(1)=window_top&
          blit_params%(2)=window_right&
          blit_params%(3)=window_bottom&
          blit_params%(4)=bitmap_left&
          blit_params%(5)=bitmap_top&
          blit_params%(6)=bitmap_right&
          blit_params%(7)=bitmap_bottom&
          blit_params%(8)=7
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
        NEXT scan_index&
        layer_mfdb%(0)=layer_bitmaps%(0)
      ENDIF
      screen_x&=MIN(work_right&,screen_max_x&)
      screen_y&=MIN(work_bottom&,screen_max_y&)
      blit_params%(0)=work_x&
      blit_params%(1)=work_y&
      blit_params%(2)=screen_x&
      blit_params%(3)=screen_y&
      blit_params%(4)=work_x&
      blit_params%(5)=work_y&
      blit_params%(6)=screen_x&
      blit_params%(7)=screen_y&
      blit_params%(8)=3
      BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
      blit_params%(0)=bitmap_left&
      blit_params%(1)=bitmap_top&
      blit_params%(2)=bitmap_right&
      blit_params%(3)=bitmap_bottom&
      blit_params%(4)=window_left&
      blit_params%(5)=window_top&
      blit_params%(6)=window_right&
      blit_params%(7)=window_bottom&
      BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
      CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
      ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        SPRITE tool_sprite$
      ENDIF
      redraw_x&=window_left&
      redraw_y&=window_top&
      redraw_width&=window_right&-window_left&
      redraw_height&=window_bottom&-window_top&
      IF redraw_x&<screen_width& AND redraw_y&<screen_height&
        ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          blit_params%(8)=3
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
        WHILE rect_height&<>0 OR rect_width&<>0
          IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
            IF screen_x&+rect_width&>screen_width&
              rect_width&=screen_width&-screen_x&
            ENDIF
            IF screen_y&+rect_height&>screen_height&
              rect_height&=screen_height&-screen_y&
            ENDIF
            DEC rect_width&
            DEC rect_height&
            blit_params%(0)=screen_x&
            blit_params%(1)=screen_y&
            blit_params%(2)=screen_x&+rect_width&
            blit_params%(3)=screen_y&+rect_height&
            blit_params%(4)=screen_x&
            blit_params%(5)=screen_y&
            blit_params%(6)=screen_x&+rect_width&
            blit_params%(7)=screen_y&+rect_height&
            BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
          ENDIF
          ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
        WEND
      ENDIF
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        ' put the tool sprite at the end of the arc
        IF first_plane_axis|=tool_axis|
          IF area_min_v<=move_end(infeed_axis|) AND area_max_v>=move_end(infeed_axis|) AND segment_u>=area_min_h AND segment_u<=area_max_h
            screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(segment_u*view_scale)-origin_x_pixels&))
            screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*move_end(infeed_axis|))-origin_y_pixels&))
            SPRITE tool_sprite$,screen_x&,screen_y&
          ENDIF
        ELSE
          IF segment_v>=area_min_v AND segment_v<=area_max_v AND area_min_h<=move_end(infeed_axis|) AND area_max_h>=move_end(infeed_axis|)
            screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*move_end(infeed_axis|))-origin_x_pixels&))
            screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(segment_v*view_scale)-origin_y_pixels&))
            SPRITE tool_sprite$,screen_x&,screen_y&
          ENDIF
        ENDIF
      ENDIF
    ELSE
      ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    ENDIF
    CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
    ' single step: wait for a key
    IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
      PRINT AT(text_column&+4,prompt_row|);SPC(70);
      PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
      REPEAT
        work_text$=INKEY$
      UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
      IF ASC(work_text$)=32
        stop_requested!=TRUE
      ENDIF
      LOCATE text_column&+6,prompt_row|
      PRINT SPACE$(65);
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Draws the transition arc the tool centre makes round an outside corner of a radius-compensated contour: an arc
' of the tool radius tool_radius round the programmed corner point move_end(), from the compensated end
' move_compensated_end() of the move to the compensated start compensated_start() of the next one, in direction
' corner_arc_direction$. In contour mode it only adds the arc to the contour list (store_generated_arc). Not
' drawn in the wireframe view or above the workpiece top.
PROCEDURE draw_corner_transition_arc
  LOCAL cycle_tool_pixels&,box_margin&,vector_x,vector_y,second_vector_x,second_vector_y,screen_x&,screen_y&,cut_layer|,centre_angle_offset,draw_end_angle,end_x&,end_y&,centre_x&,centre_y&,box_width&,spare_angle,arc_start_angle,arc_end_angle,point_angle,spare_left&,spare_top&,spare_right&,spare_bottom&,corner_sweep,window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,loop_index|,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' the corner is below the workpiece top
  IF blank_top>move_end(infeed_axis|) AND (NOT wireframe_view!)
    ' from the corner to the compensated end of this move and to the compensated start of the next
    vector_x=move_compensated_end(first_plane_axis|)-move_end(first_plane_axis|)
    vector_y=move_compensated_end(second_plane_axis|)-move_end(second_plane_axis|)
    second_vector_x=compensated_start(first_plane_axis|)-move_end(first_plane_axis|)
    second_vector_y=compensated_start(second_plane_axis|)-move_end(second_plane_axis|)
    IF vector_x<>0 OR vector_y<>0 AND (second_vector_x<>0 OR second_vector_y<>0)
      right_angle=PI/2
      arc_start_angle=vector_x/tool_radius
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF vector_y<0
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
      arc_end_angle=second_vector_x/tool_radius
      arc_end_angle=@clamped_arc_cosine(arc_end_angle)
      IF second_vector_y<0
        arc_end_angle=two_pi-arc_end_angle
      ENDIF
      point_angle=arc_end_angle-arc_start_angle
      ' the size of the corner sweep
      corner_sweep=ABS(point_angle)
      IF corner_sweep>.015 AND .015<ABS(corner_sweep-two_pi)
        ' contour mode: record the arc in the contour list
        IF in_subprogram_call!
          store_generated_arc(line_index&,compensated_start(first_plane_axis|),compensated_start(second_plane_axis|),move_end(first_plane_axis|),move_end(second_plane_axis|),corner_arc_direction$)
        ELSE
          ' the depth layer of the corner
          IF blank_bottom>=move_end(infeed_axis|)
            cut_layer|=1
          ELSE
            loop_index|=FALSE
            REPEAT
              INC loop_index|
            UNTIL loop_index|=layer_depth_count| OR (move_end(infeed_axis|)>depth_level_table(loop_index|) AND move_end(infeed_axis|)<=depth_level_table(SUCC(loop_index|)))
            cut_layer|=SUCC(loop_index|)
          ENDIF
          layer_used!(cut_layer|)=TRUE
          IF corner_arc_direction$="-"
            centre_angle_offset=arc_end_angle
            draw_end_angle=arc_start_angle
          ELSE
            centre_angle_offset=arc_start_angle
            draw_end_angle=arc_end_angle
          ENDIF
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
          ' the arc ends and the corner in pixels
          screen_x&=ROUND(view_scale*move_compensated_end(first_plane_axis|))-origin_x_pixels&
          screen_y&=-ROUND(view_scale*move_compensated_end(second_plane_axis|))-origin_y_pixels&
          end_x&=ROUND(view_scale*compensated_start(first_plane_axis|))-origin_x_pixels&
          end_y&=-ROUND(view_scale*compensated_start(second_plane_axis|))-origin_y_pixels&
          centre_x&=ROUND(view_scale*move_end(first_plane_axis|))-origin_x_pixels&
          centre_y&=-ROUND(view_scale*move_end(second_plane_axis|))-origin_y_pixels&
          cycle_tool_pixels&=tool_radius_pixels&*2
          box_margin&=cycle_tool_pixels&+4
          centre_angle_offset=ROUND(centre_angle_offset*tenths_per_radian)
          draw_end_angle=ROUND(draw_end_angle*tenths_per_radian)
          box_left&=centre_x&-box_margin&
          IF box_left&<work_min_x&
            box_left&=work_min_x&
          ELSE
            IF box_left&>work_max_x&
              box_left&=work_max_x&
            ENDIF
          ENDIF
          box_top&=centre_y&-box_margin&
          IF box_top&<work_min_y&
            box_top&=work_min_y&
          ELSE
            IF box_top&>work_max_y&
              box_top&=work_max_y&
            ENDIF
          ENDIF
          box_right&=centre_x&+box_margin&
          IF box_right&<work_min_x&
            box_right&=work_min_x&
          ELSE
            IF box_right&>work_max_x&
              box_right&=work_max_x&
            ENDIF
          ENDIF
          box_bottom&=centre_y&+box_margin&
          IF box_bottom&<work_min_y&
            box_bottom&=work_min_y&
          ELSE
            IF box_bottom&>work_max_y&
              box_bottom&=work_max_y&
            ENDIF
          ENDIF
          DEFFILL ,0,0
          PBOX box_left&,box_top&,box_right&,box_bottom&
          DEFFILL ,1,1
          BOUNDARY 1
          IF rough_out_cycle_active!
            IF .04<ABS(point_angle)
              CIRCLE centre_x&,centre_y&,cycle_tool_pixels&,centre_angle_offset,draw_end_angle
            ENDIF
          ELSE
            IF .04<ABS(point_angle)
              PCIRCLE centre_x&,centre_y&,cycle_tool_pixels&,centre_angle_offset,draw_end_angle
            ENDIF
            ' the tool circles at both ends
            PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
            PCIRCLE end_x&,end_y&,tool_radius_pixels&
          ENDIF
          BOUNDARY 0
          ' copy into the layer bitmap and the view
          IF box_left&<>box_right& OR box_top&<>box_bottom&
            bitmap_left&=box_left&+layer_offset_x&
            bitmap_top&=box_top&+layer_offset_y&
            bitmap_right&=box_right&+layer_offset_x&
            bitmap_bottom&=box_bottom&+layer_offset_y&
            window_left&=box_left&+work_offset_x&
            window_top&=box_top&+work_offset_y&
            window_right&=box_right&+work_offset_x&
            window_bottom&=box_bottom&+work_offset_y&
            layer_mfdb%(0)=layer_bitmaps%(cut_layer|)
            blit_params%(0)=window_left&
            blit_params%(1)=window_top&
            blit_params%(2)=window_right&
            blit_params%(3)=window_bottom&
            blit_params%(4)=bitmap_left&
            blit_params%(5)=bitmap_top&
            blit_params%(6)=bitmap_right&
            blit_params%(7)=bitmap_bottom&
            blit_params%(8)=7
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
            CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
            IF box_left&<view_min_x&
              box_left&=view_min_x&
            ELSE
              IF box_left&>view_max_x&
                box_left&=view_max_x&
              ENDIF
            ENDIF
            IF box_top&<view_min_y&
              box_top&=view_min_y&
            ELSE
              IF box_top&>view_max_y&
                box_top&=view_max_y&
              ENDIF
            ENDIF
            IF box_right&>view_max_x&
              box_right&=view_max_x&
            ENDIF
            IF box_bottom&>view_max_y&
              box_bottom&=view_max_y&
            ENDIF
            bitmap_left&=box_left&+layer_offset_x&
            bitmap_top&=box_top&+layer_offset_y&
            bitmap_right&=box_right&+layer_offset_x&
            bitmap_bottom&=box_bottom&+layer_offset_y&
            window_left&=box_left&+view_origin_x&
            window_top&=box_top&+view_offset_y&
            window_right&=box_right&+view_origin_x&
            window_bottom&=box_bottom&+view_offset_y&
            DEFFILL ,0,0
            PBOX box_left&,box_top&,box_right&,box_bottom&
            FOR loop_index|=depth_levels_used| DOWNTO 1
              IF layer_used!(loop_index|)
                IF loop_index|=1
                  DEFFILL ,1,1
                ELSE
                  DEFFILL ,2,depth_level_colours|(loop_index|)
                ENDIF
                PBOX box_left&,box_top&,box_right&,box_bottom&
                layer_mfdb%(0)=layer_bitmaps%(loop_index|)
                blit_params%(0)=bitmap_left&
                blit_params%(1)=bitmap_top&
                blit_params%(2)=bitmap_right&
                blit_params%(3)=bitmap_bottom&
                blit_params%(4)=window_left&
                blit_params%(5)=window_top&
                blit_params%(6)=window_right&
                blit_params%(7)=window_bottom&
                blit_params%(8)=1
                BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
                layer_mfdb%(0)=layer_bitmaps%(0)
                blit_params%(0)=window_left&
                blit_params%(1)=window_top&
                blit_params%(2)=window_right&
                blit_params%(3)=window_bottom&
                blit_params%(4)=bitmap_left&
                blit_params%(5)=bitmap_top&
                blit_params%(6)=bitmap_right&
                blit_params%(7)=bitmap_bottom&
                blit_params%(8)=7
                BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
              ENDIF
            NEXT loop_index|
            layer_mfdb%(0)=layer_bitmaps%(0)
            screen_x&=MIN(work_right&,screen_max_x&)
            screen_y&=MIN(work_bottom&,screen_max_y&)
            blit_params%(0)=work_x&
            blit_params%(1)=work_y&
            blit_params%(2)=screen_x&
            blit_params%(3)=screen_y&
            blit_params%(4)=work_x&
            blit_params%(5)=work_y&
            blit_params%(6)=screen_x&
            blit_params%(7)=screen_y&
            blit_params%(8)=3
            BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
            blit_params%(0)=bitmap_left&
            blit_params%(1)=bitmap_top&
            blit_params%(2)=bitmap_right&
            blit_params%(3)=bitmap_bottom&
            blit_params%(4)=window_left&
            blit_params%(5)=window_top&
            blit_params%(6)=window_right&
            blit_params%(7)=window_bottom&
            BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
            CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
            ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
            IF sprite_shown! AND redraw_x&=window_handle|
              SPRITE tool_sprite$
            ENDIF
            redraw_x&=window_left&
            redraw_y&=window_top&
            redraw_width&=window_right&-window_left&
            redraw_height&=window_bottom&-window_top&
            IF redraw_x&<screen_width& AND redraw_y&<screen_height&
              ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
              IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                IF screen_x&+rect_width&>screen_width&
                  rect_width&=screen_width&-screen_x&
                ENDIF
                IF screen_y&+rect_height&>screen_height&
                  rect_height&=screen_height&-screen_y&
                ENDIF
                DEC rect_width&
                DEC rect_height&
                blit_params%(0)=screen_x&
                blit_params%(1)=screen_y&
                blit_params%(2)=screen_x&+rect_width&
                blit_params%(3)=screen_y&+rect_height&
                blit_params%(4)=screen_x&
                blit_params%(5)=screen_y&
                blit_params%(6)=screen_x&+rect_width&
                blit_params%(7)=screen_y&+rect_height&
                blit_params%(8)=3
                BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
              ENDIF
              ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
              WHILE rect_height&<>0 OR rect_width&<>0
                IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
                  IF screen_x&+rect_width&>screen_width&
                    rect_width&=screen_width&-screen_x&
                  ENDIF
                  IF screen_y&+rect_height&>screen_height&
                    rect_height&=screen_height&-screen_y&
                  ENDIF
                  DEC rect_width&
                  DEC rect_height&
                  blit_params%(0)=screen_x&
                  blit_params%(1)=screen_y&
                  blit_params%(2)=screen_x&+rect_width&
                  blit_params%(3)=screen_y&+rect_height&
                  blit_params%(4)=screen_x&
                  blit_params%(5)=screen_y&
                  blit_params%(6)=screen_x&+rect_width&
                  blit_params%(7)=screen_y&+rect_height&
                  BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
                ENDIF
                ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
              WEND
            ENDIF
            ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
            IF sprite_shown! AND redraw_x&=window_handle|
              IF area_min_v<=move_compensated_end(second_plane_axis|) AND area_max_v>=move_compensated_end(second_plane_axis|) AND area_min_h<=move_compensated_end(first_plane_axis|) AND area_max_h>=move_compensated_end(first_plane_axis|)
                screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*compensated_start(first_plane_axis|))-origin_x_pixels&))
                screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*compensated_start(second_plane_axis|))-origin_y_pixels&))
                SPRITE tool_sprite$,screen_x&,screen_y&
              ENDIF
            ENDIF
          ELSE
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          ENDIF
          CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Simulates a CYCL CALL: draws the pending move, then reads the parameters of the cycle defined at line
' cycle_start_line& (the cycle number other_contour| from the CYCL DEF block, set-up clearance setup_clearance,
' depth cycle_depth and infeed depth infeed_depth from the following blocks) and checks them (equal signs, tool
' at the set-up clearance for cycles 6/15/16, tool not larger than the hole or slot). Then each pass is drawn by
' depth: cycles 1 and 5 (pecking, circular pocket) and 2 (tapping) with draw_cycle_pass as holes, cycles 3 and 4
' (slot milling, pocket milling) with draw_cycle_pass using the lengths corner_point(), cycles 6 (rough-out), 15
' (pilot drilling) and 16 (contour milling) through the SL contour routines simulate_contour_cycle_pass and
' draw_pilot_drill_hole (not possible in the wireframe view). Afterwards the tool is back at the set-up
' clearance and the scan line goes on after the cycle.
PROCEDURE simulate_cycle_call
  LOCAL line_index&,rect_width&,other_contour|,box_margin&,arc_radius,cycle_pass%,start_height,cut_depth,alert_button|,contour_reverse!,setup_clearance,cycle_depth,depth_upward!,infeed_depth,saved_tool_radius,allowance_changed!,rnd_first_axis|,rnd_second_axis|,contour_tool_radius,first_contour_pass!,cycle_line&,work_text$,window_handle|,screen_x&,screen_y&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ' the CYCL CALL line
  line_index&=current_block&
  cycle_line&=current_block&
  ' draw the pending move first
  IF after_line_element!
    queue_simulated_move(line_index&,"-",-1)
  ELSE
    IF arc_pending!
      queue_simulated_move(line_index&,"-",-1)
    ELSE
      current_draw_block&=current_block&
    ENDIF
  ENDIF
  after_line_element!=FALSE
  arc_pending!=FALSE
  ' the CYCL DEF line of the cycle
  current_block&=cycle_start_line&
  find_lookahead_blocks
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  DEFFILL 1,0,0
  PBOX 0,char_cell_height|,work_w&,MUL(char_cell_height|,2)
  DEFFILL ,1,1
  IF wireframe_view!
    ' ";current_draw_block&; / ELSE
    PRINT AT(text_column&+1,2);"aktueller Satz : ";current_draw_block&;
  ELSE
    ' ";STR$(current_draw_block&);'program_lines$(current_draw_block&); / ENDIF
    PRINT AT(text_column&+1,2);"aktueller Satz : ";STR$(current_draw_block&);'program_lines$(current_draw_block&);
  ENDIF
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
  redraw_x&=work_x&
  redraw_y&=work_y&+char_cell_height|
  redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
  redraw_height&=char_cell_height|
  IF redraw_x&<screen_width& AND redraw_y&<screen_height&
    ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
    IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
      IF screen_x&+rect_width&>screen_width&
        rect_width&=screen_width&-screen_x&
      ENDIF
      IF screen_y&+rect_height&>screen_height&
        rect_height&=screen_height&-screen_y&
      ENDIF
      DEC rect_width&
      DEC rect_height&
      blit_params%(0)=screen_x&
      blit_params%(1)=screen_y&
      blit_params%(2)=screen_x&+rect_width&
      blit_params%(3)=screen_y&+rect_height&
      blit_params%(4)=screen_x&
      blit_params%(5)=screen_y&
      blit_params%(6)=screen_x&+rect_width&
      blit_params%(7)=screen_y&+rect_height&
      blit_params%(8)=3
      BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
    ENDIF
    ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
    WHILE rect_height&<>0 OR rect_width&<>0
      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
        IF screen_x&+rect_width&>screen_width&
          rect_width&=screen_width&-screen_x&
        ENDIF
        IF screen_y&+rect_height&>screen_height&
          rect_height&=screen_height&-screen_y&
        ENDIF
        DEC rect_width&
        DEC rect_height&
        blit_params%(0)=screen_x&
        blit_params%(1)=screen_y&
        blit_params%(2)=screen_x&+rect_width&
        blit_params%(3)=screen_y&+rect_height&
        blit_params%(4)=screen_x&
        blit_params%(5)=screen_y&
        blit_params%(6)=screen_x&+rect_width&
        blit_params%(7)=screen_y&+rect_height&
        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
      ENDIF
      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
    WEND
  ENDIF
  ~WIND_UPDATE(0)
  ' the cycle number
  other_contour|=VAL(MID$(program_lines$(current_block&),10,2))
  ' cycles 1 to 5: clearance, depth and infeed from the next lines
  IF other_contour|<>0 AND other_contour|<=5
    rect_width&=next_block&
    setup_clearance=@read_number_or_parameter(program_lines$(next_block&),22)
    cycle_depth=@read_number_or_parameter(program_lines$(block_after_next&),22)
    ' tapping: no infeed, depth and clearance must have the same sign
    IF other_contour|=2
      depth_upward!=cycle_depth>=0
      IF SGN(setup_clearance)<>SGN(cycle_depth)
        ' "clearance and depth must have the same sign"
        ALERT 3,"Abstand und Tiefe mÅssen|gleiches Vorzeichen besitzen!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=next_block&
        error_messages$(0)="ABSTAND, TIEFE MöSSEN GLEICHES VORZEICHEN HABEN!"
      ENDIF
    ELSE
      infeed_depth=@read_number_or_parameter(program_lines$(third_block_ahead&),22)
      depth_upward!=infeed_depth>=0
      ' the signs differ
      IF NOT setup_clearance>=0 AND cycle_depth>=0 AND infeed_depth>=0 OR (setup_clearance<0 AND cycle_depth<0 AND infeed_depth<0)
        ' "clearance, depth and infeed must have the same sign"
        ALERT 3,"Abstand, Tiefe und Zustellung|mÅssen gleiches Vorzeichen|besitzen!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=next_block&
        error_messages$(0)="ABST, TIEFE, ZUSTLG MöSSEN GLEICHES VORZEICHEN HABEN!"
      ENDIF
    ENDIF
    current_block&=third_block_ahead&
    find_lookahead_blocks
  ELSE
    ' SL cycles: clearance, depth, infeed and allowance
    IF other_contour|=15 OR other_contour|=6 OR other_contour|=16
      rect_width&=next_block&
      setup_clearance=@read_number_or_parameter(program_lines$(next_block&),22)
      cycle_depth=@read_number_or_parameter(program_lines$(next_block&),39)
      infeed_depth=@read_number_or_parameter(program_lines$(block_after_next&),22)
      IF other_contour|<>16
        finishing_allowance=@read_number_or_parameter(program_lines$(block_after_next&),45)
      ENDIF
      depth_upward!=infeed_depth>=0
      IF NOT setup_clearance>=0 AND cycle_depth>=0 AND infeed_depth>=0 OR (setup_clearance<0 AND cycle_depth<0 AND infeed_depth<0)
        ALERT 3,"Abstand, Tiefe und Zustellung|mÅssen gleiches Vorzeichen|besitzen!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=next_block&
        error_messages$(0)="ABST, TIEFE, ZUSTLG MöSSEN GLEICHES VORZEICHEN HABEN!"
      ENDIF
      IF other_contour|=16
        ' contour milling direction
        contour_reverse!=(MID$(program_lines$(block_after_next&),41,1)="-")
      ENDIF
      IF other_contour|=6
        current_block&=third_block_ahead&
      ELSE
        current_block&=block_after_next&
      ENDIF
      find_lookahead_blocks
    ENDIF
  ENDIF
  ' start_height: the start height (the workpiece top or the tool, if lower)
  IF blank_top>start_point(infeed_axis|)
    start_height=start_point(infeed_axis|)
  ELSE
    start_height=blank_top
  ENDIF
  ' the tool is not at the set-up clearance
  IF start_point(infeed_axis|)<>blank_top-setup_clearance AND (other_contour|=6 OR other_contour|=15 OR other_contour|=16)
    ' "the tool must be at the set-up clearance"
    ALERT 3,"Das Werkzeug muû|sich auf dem|Sicherheitsabstand|befinden!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    error_blocks&(0)=rect_width&
    error_messages$(0)="WERKZEUG MUSS SICH AUF SICHERHEITSABSTAND BEFINDEN!"
  ELSE
    IF NOT run_aborted!
      SELECT other_contour|
      CASE 1,5
        IF other_contour|=1
          box_margin&=tool_radius_pixels&
        ELSE
          arc_radius=@read_number_or_parameter(program_lines$(next_block&),22)
          box_margin&=ROUND(arc_radius*view_scale)
        ENDIF
        ' the pocket is smaller than the tool
        IF box_margin&<tool_radius_pixels& AND (NOT wireframe_view!) OR (box_margin&<real_tool_radius_pixels& AND wireframe_view!)
          ' "tool radius too large"
          ALERT 3,"FrÑserradius ist|zu groû!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=next_block&
          error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
        ELSE
          cut_depth=start_height
          IF ABS(infeed_depth)<ABS(cycle_depth-cut_depth) AND (NOT wireframe_view!)
            cut_depth=cut_depth+infeed_depth
            ' one pass per infeed
            REPEAT
              draw_cycle_pass(other_contour|,cut_depth,box_margin&,1,2,0,0)
              IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
                PRINT AT(text_column&+4,prompt_row|);SPC(70);
                PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
                REPEAT
                  work_text$=INKEY$
                UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
                IF ASC(work_text$)=32
                  stop_requested!=TRUE
                ENDIF
                PRINT AT(text_column&+6,prompt_row|);SPC(65);
              ELSE
                IF box_margin&<30
                  ON MENU
                  PAUSE 10
                  ON MENU
                  PAUSE 10
                ENDIF
              ENDIF
              cut_depth=cut_depth+infeed_depth
              ' until the depth is passed, an error or stop
            UNTIL cut_depth<cycle_depth AND (NOT depth_upward!) OR (cut_depth>cycle_depth AND depth_upward!) OR stop_requested!
            ' a last pass at the full depth
            IF cycle_depth<>cut_depth-infeed_depth
              draw_cycle_pass(other_contour|,cycle_depth,box_margin&,1,2,0,0)
            ENDIF
          ELSE
            draw_cycle_pass(other_contour|,cycle_depth,box_margin&,1,2,0,0)
          ENDIF
        ENDIF
      CASE 2
        ' CASE 2: tapping: one pass at the full depth
        box_margin&=tool_radius_pixels&
        draw_cycle_pass(other_contour|,cycle_depth,box_margin&,1,2,0,0)
      CASE 3,4
        ' CASE 3,4: slot and pocket: the length axis and width axis
        axis_from_letter(program_lines$(next_block&),15,rnd_first_axis|)
        IF rnd_first_axis|=tool_axis|
          ' "the axis must not be the reference axis"
          ALERT 3,"Achse darf nicht die|Bezugsachse sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=next_block&
          error_messages$(0)="ACHSE DARF NICHT DIE BEZUGSACHSE SEIN!"
        ELSE
          axis_from_letter(program_lines$(block_after_next&),15,rnd_second_axis|)
          IF rnd_second_axis|=tool_axis|
            ALERT 3,"Achse darf nicht die|Bezugsachse sein!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=block_after_next&
            error_messages$(0)="ACHSE DARF NICHT DIE BEZUGSACHSE SEIN!"
          ELSE
            ' length and width
            corner_point(rnd_first_axis|)=@read_number_or_parameter(program_lines$(next_block&),22)
            corner_point(rnd_second_axis|)=@read_number_or_parameter(program_lines$(block_after_next&),22)
            ' wireframe: check with the small display radius
            IF wireframe_view!
              saved_tool_radius=tool_radius
              tool_radius=real_tool_radius
            ENDIF
            ' the length is less than the tool diameter
            IF ABS(corner_point(rnd_first_axis|))<tool_radius*2
              ALERT 3,"FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              error_blocks&(0)=next_block&
              error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
            ELSE
              IF corner_point(rnd_second_axis|)<tool_radius*2
                ALERT 3,"FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=block_after_next&
                error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
              ELSE
                IF corner_point(rnd_second_axis|)>tool_radius*4 AND other_contour|=3
                  ' "slot width too large"
                  ALERT 3,"Nutbreite|ist zu groû!",1,"Abbruch",alert_button|
                  run_aborted!=TRUE
                  error_blocks&(0)=block_after_next&
                  error_messages$(0)="NUTBREITE IST ZU GROSS!"
                ELSE
                  IF corner_point(rnd_first_axis|)<0 AND other_contour|=4
                    ' "the length must be positive"
                    ALERT 3,"LÑngenangabe muû|positiv sein!",1,"Abbruch",alert_button|
                    run_aborted!=TRUE
                    error_blocks&(0)=next_block&
                    error_messages$(0)="LéNGENANGABE MUSS POSITIV SEIN!"
                  ELSE
                    IF wireframe_view!
                      tool_radius=saved_tool_radius
                    ENDIF
                    cut_depth=start_height
                    cycle_pass%=0
                    IF ABS(infeed_depth)<ABS(cycle_depth-cut_depth) AND (NOT wireframe_view!)
                      cut_depth=cut_depth+infeed_depth
                      ' one pass per infeed, counted in cycle_pass%
                      REPEAT
                        INC cycle_pass%
                        draw_cycle_pass(other_contour|,cut_depth,tool_radius_pixels&,rnd_first_axis|,rnd_second_axis|,cycle_pass%,0)
                        IF (NOT run_continuous!) AND (NOT in_subprogram_call!)
                          PRINT AT(text_column&+4,prompt_row|);SPC(70);
                          PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
                          REPEAT
                            work_text$=INKEY$
                          UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
                          IF ASC(work_text$)=32
                            stop_requested!=TRUE
                          ENDIF
                          PRINT AT(text_column&+6,prompt_row|);SPC(65);
                        ELSE
                          IF NOT rotation_active!
                            ON MENU
                            PAUSE 10
                            ON MENU
                            PAUSE 10
                          ENDIF
                        ENDIF
                        cut_depth=cut_depth+infeed_depth
                      UNTIL cut_depth<cycle_depth AND (NOT depth_upward!) OR (cut_depth>cycle_depth AND depth_upward!) OR stop_requested!
                      IF cycle_depth<>cut_depth-infeed_depth
                        INC cycle_pass%
                        draw_cycle_pass(other_contour|,cycle_depth,tool_radius_pixels&,rnd_first_axis|,rnd_second_axis|,cycle_pass%,-1)
                      ENDIF
                    ELSE
                      INC cycle_pass%
                      draw_cycle_pass(other_contour|,cycle_depth,tool_radius_pixels&,rnd_first_axis|,rnd_second_axis|,cycle_pass%,-1)
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
            ' CASE 6: rough-out (SL)
            IF wireframe_view!
              tool_radius=saved_tool_radius
            ENDIF
          ENDIF
        ENDIF
      CASE 6
        IF wireframe_view!
          ' "the contour can only be viewed in the normal display mode"
          ALERT 3,"Die Kontur kann nur im|normalen Darstellungsmodus|betrachtet werden!",1,"Abbruch",alert_button|
          stop_requested!=TRUE
        ELSE
          ' draw with the tool radius plus the finishing allowance
          contour_tool_radius=tool_radius
          tool_radius=tool_radius+finishing_allowance
          IF finishing_allowance<>previous_allowance
            build_contour_pocket_paths
            allowance_changed!=TRUE
          ELSE
            allowance_changed!=FALSE
          ENDIF
          previous_allowance=finishing_allowance
          ' the paths are built with the allowance in tool_radius; it is cleared so that it is not added again during
          ' the passes, and previous_allowance keeps it so that the paths are only rebuilt when it changes
          finishing_allowance=0
          IF (NOT stop_requested!) AND (NOT run_aborted!)
            ' rough-out running; reset all transformations for the contour
            rough_out_cycle_active!=TRUE
            datum_shift_on!=FALSE
            mirror_x!=FALSE
            mirror_y!=FALSE
            mirror_z!=FALSE
            mirror_reverses_direction!=FALSE
            mirror_x_after_rotation!=TRUE
            mirror_y_after_rotation!=TRUE
            mirror_z_after_rotation!=TRUE
            rotation_active!=FALSE
            rotation_angle=0
            rotation_spare_value=0
            scaling_active!=FALSE
            scaling_factor=1
            cut_depth=start_height
            IF ABS(infeed_depth)<ABS(cycle_depth-cut_depth)
              cut_depth=cut_depth+infeed_depth
              ' one rough-out pass per infeed
              REPEAT
                simulate_contour_cycle_pass(6,contour_tool_radius,cut_depth,-1,-1)
                cut_depth=cut_depth+infeed_depth
                ON MENU
              UNTIL cut_depth<cycle_depth AND (NOT depth_upward!) OR (cut_depth>cycle_depth AND depth_upward!) OR stop_requested! OR run_aborted!
              IF cycle_depth<>cut_depth-infeed_depth AND (NOT run_aborted!) AND (NOT stop_requested!)
                simulate_contour_cycle_pass(6,contour_tool_radius,cycle_depth,-1,-1)
              ENDIF
            ELSE
              simulate_contour_cycle_pass(6,contour_tool_radius,cycle_depth,-1,-1)
            ENDIF
            rough_out_cycle_active!=FALSE
          ENDIF
          ' back to the real tool radius
          tool_radius=contour_tool_radius
        ENDIF
      CASE 15
        ' CASE 15: pilot drilling (SL)
        IF wireframe_view!
          ALERT 3,"Die Kontur kann nur im|normalen Darstellungsmodus|betrachtet werden!",1,"Abbruch",alert_button|
          stop_requested!=TRUE
        ELSE
          ' pilot drilling: the paths are built with the tool radius plus the finishing allowance, as for cycle 6
          contour_tool_radius=tool_radius
          tool_radius=tool_radius+finishing_allowance
          IF finishing_allowance<>previous_allowance
            build_contour_pocket_paths
            allowance_changed!=TRUE
          ELSE
            allowance_changed!=FALSE
          ENDIF
          previous_allowance=finishing_allowance
          ' cleared for the passes, as for cycle 6
          finishing_allowance=0
          IF (NOT stop_requested!) AND (NOT run_aborted!)
            datum_shift_on!=FALSE
            mirror_x!=FALSE
            mirror_y!=FALSE
            mirror_z!=FALSE
            mirror_reverses_direction!=FALSE
            mirror_x_after_rotation!=TRUE
            mirror_y_after_rotation!=TRUE
            mirror_z_after_rotation!=TRUE
            rotation_active!=FALSE
            rotation_angle=0
            rotation_spare_value=0
            scaling_active!=FALSE
            scaling_factor=1
            current_contour|=FALSE
            ' every contour current_contour| of the SL cycle
            REPEAT
              read_line_target(tool_path_elements$(current_contour|,0))
              cut_depth=start_height
              IF ABS(infeed_depth)<ABS(cycle_depth-cut_depth)
                cut_depth=cut_depth+infeed_depth
                ' one pass per infeed
                REPEAT
                  draw_pilot_drill_hole(cut_depth)
                  cut_depth=cut_depth+infeed_depth
                  IF NOT run_continuous!
                    PRINT AT(text_column&+4,prompt_row|);SPC(70);
                    PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
                    REPEAT
                      work_text$=INKEY$
                    UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
                    IF ASC(work_text$)=32
                      stop_requested!=TRUE
                    ENDIF
                    PRINT AT(text_column&+6,prompt_row|);SPC(65);
                  ELSE
                    IF tool_radius<30
                      ON MENU
                      PAUSE 10
                      ON MENU
                      PAUSE 10
                    ENDIF
                  ENDIF
                UNTIL cut_depth<cycle_depth AND (NOT depth_upward!) OR (cut_depth>cycle_depth AND depth_upward!) OR stop_requested!
                IF cycle_depth<>cut_depth-infeed_depth
                  draw_pilot_drill_hole(cycle_depth)
                ENDIF
              ELSE
                draw_pilot_drill_hole(cycle_depth)
              ENDIF
              INC current_contour|
            UNTIL current_contour|>=contour_count|
          ENDIF
          tool_radius=contour_tool_radius
        ENDIF
      CASE 16
        ' CASE 16: contour milling (SL)
        IF wireframe_view!
          ALERT 3,"Die Kontur kann nur im|normalen Darstellungsmodus|betrachtet werden!",1,"Abbruch",alert_button|
          stop_requested!=TRUE
        ELSE
          finishing_allowance=0
          IF finishing_allowance<>previous_allowance
            build_contour_pocket_paths
            allowance_changed!=TRUE
          ELSE
            allowance_changed!=FALSE
          ENDIF
          IF (NOT stop_requested!) AND (NOT run_aborted!)
            ' contour milling running
            contour_cycle_active!=TRUE
            datum_shift_on!=FALSE
            mirror_x!=FALSE
            mirror_y!=FALSE
            mirror_z!=FALSE
            mirror_reverses_direction!=FALSE
            mirror_x_after_rotation!=TRUE
            mirror_y_after_rotation!=TRUE
            mirror_z_after_rotation!=TRUE
            rotation_active!=FALSE
            rotation_angle=0
            rotation_spare_value=0
            scaling_active!=FALSE
            scaling_factor=1
            cut_depth=start_height
            end_point(depth_axis|)=start_height
            IF ABS(infeed_depth)<ABS(cycle_depth-cut_depth)
              cut_depth=cut_depth+infeed_depth
              first_contour_pass!=TRUE
              ' one contour pass per infeed
              REPEAT
                simulate_contour_cycle_pass(16,0,cut_depth,contour_reverse!,first_contour_pass!)
                first_contour_pass!=FALSE
                cut_depth=cut_depth+infeed_depth
                ON MENU
              UNTIL cut_depth<cycle_depth AND (NOT depth_upward!) OR (cut_depth>cycle_depth AND depth_upward!) OR run_aborted! OR stop_requested!
              IF cycle_depth<>cut_depth-infeed_depth AND (NOT run_aborted!) AND (NOT stop_requested!)
                simulate_contour_cycle_pass(16,0,cycle_depth,contour_reverse!,first_contour_pass!)
              ENDIF
            ELSE
              simulate_contour_cycle_pass(16,0,cycle_depth,contour_reverse!,-1)
            ENDIF
            contour_cycle_active!=FALSE
          ENDIF
        ENDIF
        previous_allowance=finishing_allowance
      ENDSELECT
      ' the tool ends at the set-up clearance
      SUB start_height,setup_clearance
      start_point(infeed_axis|)=start_height
      end_point(infeed_axis|)=start_height
    ENDIF
  ENDIF
  ' SL cycle: clear the allowance, go on after the cycle definition
  IF other_contour|=6 OR other_contour|=15 OR other_contour|=16
    finishing_allowance=0
    save_restore_program_state(0)
    IF allowance_changed!
      current_block&=next_block&
    ELSE
      current_block&=cycle_line&
    ENDIF
    find_lookahead_blocks
  ELSE
    current_block&=line_index&
    find_lookahead_blocks
  ENDIF
  ' single step: wait for a key
  IF NOT run_continuous!
    PRINT AT(text_column&+4,prompt_row|);SPC(70);
    PRINT AT(text_column&+6,prompt_row|);"Weiter mit den Tasten >RETURN< , >ENTER< (Abbruch mit >SPACE<)!";
    REPEAT
      work_text$=INKEY$
    UNTIL ASC(work_text$)=13 OR ASC(work_text$)=32
    IF ASC(work_text$)=32
      stop_requested!=TRUE
    ENDIF
    PRINT AT(text_column&+6,prompt_row|);SPC(65);
  ENDIF
  ON MENU
RETURN
' Draws one depth pass cut_depth of cycle other_contour| at the current position start_point(): cycles 1, 2 and
' 5 as a filled hole of cycle_tool_pixels& pixels radius, cycle 3 as a slot (length along axis rnd_first_axis|,
' width along rnd_second_axis|), cycle 4 as a rectangular pocket. With rotation active (rotation_active!) the
' slot and pocket are drawn by draw_rotated_slot_pocket. The shape goes into the layer bitmap of the depth, then
' the view and window are updated and the tool sprite placed: for a slot it alternates between the ends with
' each pass cycle_pass% (is_finished!=TRUE for the final pass).
PROCEDURE draw_cycle_pass(other_contour|,cut_depth,cycle_tool_pixels&,rnd_first_axis|,rnd_second_axis|,cycle_pass%,is_finished!)
  LOCAL cut_layer|,loop_index|,screen_x&,screen_y&,box_margin&,box_left&,box_top&,box_right&,box_bottom&,window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,point_distance,work_point_y,basic_variables,segment_length,discriminant,first_crossing_x,first_crossing_y,second_crossing_x,second_crossing_y,draw_left_x&,box_top_y&,rect_right&,box_bottom_y&,next_u,slot_end_v,end_x&,end_y&,slot_length_u,slot_length_v,sprite_x&,sprite_y&,slot_far_x&,slot_far_y&,slot_top_visible!,slot_bottom_visible!,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' the pass is below the workpiece top
  IF cut_depth<blank_top
    ' the depth layer of the pass: cut_layer|
    IF cut_depth<=blank_bottom
      cut_layer|=1
    ELSE
      loop_index|=FALSE
      REPEAT
        INC loop_index|
      UNTIL loop_index|=layer_depth_count| OR (cut_depth>depth_level_table(loop_index|) AND cut_depth<=depth_level_table(SUCC(loop_index|)))
      cut_layer|=SUCC(loop_index|)
    ENDIF
    box_margin&=cycle_tool_pixels&+4
    IF NOT wireframe_view!
      layer_used!(cut_layer|)=TRUE
    ENDIF
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
    SELECT other_contour|
    CASE 1,2,5
      screen_x&=ROUND(view_scale*start_point(first_plane_axis|))-origin_x_pixels&
      screen_y&=-ROUND(view_scale*start_point(second_plane_axis|))-origin_y_pixels&
      sprite_x&=screen_x&
      sprite_y&=screen_y&
      box_left&=screen_x&-box_margin&
      IF box_left&<work_min_x&
        box_left&=work_min_x&
      ELSE
        IF box_left&>work_max_x&
          box_left&=work_max_x&
        ENDIF
      ENDIF
      box_top&=screen_y&-box_margin&
      IF box_top&<work_min_y&
        box_top&=work_min_y&
      ELSE
        IF box_top&>work_max_y&
          box_top&=work_max_y&
        ENDIF
      ENDIF
      box_right&=screen_x&+box_margin&
      IF box_right&<work_min_x&
        box_right&=work_min_x&
      ELSE
        IF box_right&>work_max_x&
          box_right&=work_max_x&
        ENDIF
      ENDIF
      box_bottom&=screen_y&+box_margin&
      IF box_bottom&<work_min_y&
        box_bottom&=work_min_y&
      ELSE
        IF box_bottom&>work_max_y&
          box_bottom&=work_max_y&
        ENDIF
      ENDIF
      DEFFILL ,0,0
      PBOX box_left&,box_top&,box_right&,box_bottom&
      DEFFILL ,1,1
      BOUNDARY 1
      IF wireframe_view! AND other_contour|<>5
        PCIRCLE screen_x&,screen_y&,1
      ELSE
        PCIRCLE screen_x&,screen_y&,cycle_tool_pixels&
      ENDIF
    CASE 3
      ' CASE 3: a slot; rotated: drawn by draw_rotated_slot_pocket
      IF rotation_active!
        draw_rotated_slot_pocket(other_contour|,cycle_pass%,rnd_first_axis|,rnd_second_axis|,box_left&,box_top&,box_right&,box_bottom&,sprite_x&,sprite_y&)
      ELSE
        ' the slot runs along the first plane axis
        slot_along_first_axis!=rnd_first_axis|=first_plane_axis|
        point_distance=corner_point(first_plane_axis|)
        work_point_y=corner_point(second_plane_axis|)
        IF mirror_x! AND slot_along_first_axis!
          point_distance=-point_distance
        ENDIF
        IF mirror_y! AND (NOT slot_along_first_axis!)
          work_point_y=-work_point_y
        ENDIF
        screen_x&=ROUND(view_scale*start_point(first_plane_axis|))-origin_x_pixels&
        screen_y&=-ROUND(view_scale*start_point(second_plane_axis|))-origin_y_pixels&
        sprite_x&=screen_x&
        sprite_y&=screen_y&
        ' the tool diameter; the slot ends are a tool diameter in from the length
        discriminant=tool_radius*2
        IF slot_along_first_axis!
          next_u=point_distance+start_point(first_plane_axis|)
          slot_length_u=point_distance
          IF point_distance>0
            SUB next_u,discriminant
            SUB slot_length_u,discriminant
          ELSE
            next_u=next_u+discriminant
            slot_length_u=slot_length_u+discriminant
          ENDIF
          end_x&=ROUND(next_u*view_scale)-origin_x_pixels&
          end_y&=screen_y&
          slot_far_x&=ROUND((slot_length_u+start_point(first_plane_axis|))*view_scale)
          SUB slot_far_x&,origin_x_pixels&
          slot_far_y&=screen_y&
        ELSE
          end_x&=screen_x&
          slot_end_v=work_point_y+start_point(second_plane_axis|)
          slot_length_v=work_point_y
          IF work_point_y>0
            SUB slot_end_v,discriminant
            SUB slot_length_v,discriminant
          ELSE
            slot_end_v=slot_end_v+discriminant
            slot_length_v=slot_length_v+discriminant
          ENDIF
          end_y&=-ROUND(slot_end_v*view_scale)-origin_y_pixels&
          slot_far_x&=screen_x&
          slot_far_y&=-ROUND((slot_length_v+start_point(second_plane_axis|))*view_scale)
          SUB slot_far_y&,origin_y_pixels&
        ENDIF
        ' the slot is exactly as wide as the tool: one tool path with round ends
        IF discriminant=corner_point(rnd_second_axis|)
          box_width&=ABS(screen_x&-end_x&)+box_margin&*2
          box_height&=ABS(screen_y&-end_y&)+box_margin&*2
          IF screen_x&<end_x&
            box_left&=screen_x&
          ELSE
            box_left&=end_x&
          ENDIF
          SUB box_left&,box_margin&
          IF box_left&<work_min_x&
            box_left&=work_min_x&
          ELSE
            IF box_left&>work_max_x&
              box_left&=work_max_x&
            ENDIF
          ENDIF
          IF screen_y&<end_y&
            box_top&=screen_y&
          ELSE
            box_top&=end_y&
          ENDIF
          SUB box_top&,box_margin&
          IF box_top&<work_min_y&
            box_top&=work_min_y&
          ELSE
            IF box_top&>work_max_y&
              box_top&=work_max_y&
            ENDIF
          ENDIF
          box_right&=box_left&+box_width&
          IF box_right&>work_max_x&
            box_right&=work_max_x&
          ENDIF
          box_bottom&=box_top&+box_height&
          IF box_bottom&>work_max_y&
            box_bottom&=work_max_y&
          ENDIF
          DEFFILL ,0,0
          PBOX box_left&,box_top&,box_right&,box_bottom&
          DEFFILL ,1,1
          BOUNDARY 1
          ' a wider slot: a box with the tool at both ends
          IF slot_along_first_axis!
            draw_left_x&=box_left&+box_margin&
            box_top_y&=box_top&+4
            rect_right&=box_right&-box_margin&
            box_bottom_y&=box_bottom&-4
          ELSE
            draw_left_x&=box_left&+4
            box_top_y&=box_top&+box_margin&
            rect_right&=box_right&-4
            box_bottom_y&=box_bottom&-box_margin&
          ENDIF
          PBOX draw_left_x&,box_top_y&,rect_right&,box_bottom_y&
          IF NOT wireframe_view!
            PCIRCLE screen_x&,screen_y&,cycle_tool_pixels&
            PCIRCLE end_x&,end_y&,cycle_tool_pixels&
          ENDIF
        ELSE
          IF slot_along_first_axis!
            IF point_distance>0
              first_crossing_x=start_point(first_plane_axis|)-tool_radius
            ELSE
              first_crossing_x=tool_radius+start_point(first_plane_axis|)+point_distance
            ENDIF
            basic_variables=work_point_y-discriminant
            first_crossing_y=start_point(second_plane_axis|)+basic_variables/2
            second_crossing_x=ABS(point_distance)+first_crossing_x
            second_crossing_y=first_crossing_y-basic_variables
          ELSE
            IF work_point_y>0
              second_crossing_y=start_point(second_plane_axis|)-tool_radius
            ELSE
              second_crossing_y=work_point_y+start_point(second_plane_axis|)+tool_radius
            ENDIF
            basic_variables=point_distance-discriminant
            first_crossing_x=start_point(first_plane_axis|)-basic_variables/2
            first_crossing_y=ABS(work_point_y)+second_crossing_y
            second_crossing_x=first_crossing_x+basic_variables
          ENDIF
          draw_left_x&=ROUND(first_crossing_x*view_scale)-origin_x_pixels&
          box_top_y&=-ROUND(first_crossing_y*view_scale)-origin_y_pixels&
          rect_right&=ROUND(second_crossing_x*view_scale)-origin_x_pixels&
          box_bottom_y&=-ROUND(second_crossing_y*view_scale)-origin_y_pixels&
          IF slot_along_first_axis!
            box_left&=draw_left_x&-4
            box_top&=box_top_y&-box_margin&
            box_right&=rect_right&+4
            box_bottom&=box_bottom_y&+box_margin&
          ELSE
            box_left&=draw_left_x&-box_margin&
            box_top&=box_top_y&-4
            box_right&=rect_right&+box_margin&
            box_bottom&=box_bottom_y&+4
          ENDIF
          slot_top_visible!=TRUE
          slot_bottom_visible!=TRUE
          IF box_left&<work_min_x&
            box_left&=work_min_x&
          ELSE
            IF box_left&>work_max_x&
              box_left&=work_max_x&
            ENDIF
          ENDIF
          IF box_top&<work_min_y&
            box_top&=work_min_y&
            slot_top_visible!=FALSE
          ELSE
            IF box_top&>work_max_y&
              box_top&=work_max_y&
            ENDIF
          ENDIF
          IF box_right&<work_min_x&
            box_right&=work_min_x&
          ELSE
            IF box_right&>work_max_x&
              box_right&=work_max_x&
            ENDIF
          ENDIF
          IF box_bottom&<work_min_y&
            box_bottom&=work_min_y&
          ELSE
            IF box_bottom&>work_max_y&
              box_bottom&=work_max_y&
              slot_bottom_visible!=FALSE
            ENDIF
          ENDIF
          DEFFILL ,0,0
          PBOX box_left&,box_top&,box_right&,box_bottom&
          DEFFILL ,1,1
          BOUNDARY 1
          PBOX draw_left_x&,box_top_y&,rect_right&,box_bottom_y&
          IF slot_top_visible!
            ADD box_top&,4
          ENDIF
          IF slot_bottom_visible!
            SUB box_bottom&,4
          ENDIF
          IF NOT wireframe_view!
            IF slot_along_first_axis!
              draw_left_x&=draw_left_x&+cycle_tool_pixels&
              SUB rect_right&,cycle_tool_pixels&
              PBOX draw_left_x&,box_top&,rect_right&,box_top_y&
              PBOX draw_left_x&,box_bottom_y&,rect_right&,box_bottom&
            ELSE
              box_top_y&=box_top_y&+cycle_tool_pixels&
              SUB box_bottom_y&,cycle_tool_pixels&
              PBOX box_left&,box_top_y&,draw_left_x&,box_bottom_y&
              PBOX rect_right&,box_top_y&,box_right&,box_bottom_y&
            ENDIF
            PCIRCLE draw_left_x&,box_top_y&,cycle_tool_pixels&,850,1850
            PCIRCLE draw_left_x&,box_bottom_y&,cycle_tool_pixels&,1750,2750
            PCIRCLE rect_right&,box_top_y&,cycle_tool_pixels&,3550,950
            PCIRCLE rect_right&,box_bottom_y&,cycle_tool_pixels&,2650,3650
          ENDIF
        ENDIF
      ENDIF
    CASE 4
      ' CASE 4: a pocket; rotated: drawn by draw_rotated_slot_pocket
      IF rotation_active!
        draw_rotated_slot_pocket(other_contour|,cycle_pass%,rnd_first_axis|,rnd_second_axis|,box_left&,box_top&,box_right&,box_bottom&,sprite_x&,sprite_y&)
      ELSE
        ' the pocket: a box of length point_distance and width work_point_y round the position
        point_distance=corner_point(first_plane_axis|)
        work_point_y=corner_point(second_plane_axis|)
        discriminant=tool_radius*2
        screen_x&=ROUND(view_scale*start_point(first_plane_axis|))-origin_x_pixels&
        screen_y&=-ROUND(view_scale*start_point(second_plane_axis|))-origin_y_pixels&
        sprite_x&=screen_x&
        sprite_y&=screen_y&
        basic_variables=point_distance/2
        segment_length=(work_point_y-discriminant)/2
        first_crossing_x=start_point(first_plane_axis|)-basic_variables
        first_crossing_y=segment_length+start_point(second_plane_axis|)
        second_crossing_x=basic_variables+start_point(first_plane_axis|)
        second_crossing_y=start_point(second_plane_axis|)-segment_length
        draw_left_x&=ROUND(first_crossing_x*view_scale)-origin_x_pixels&
        box_top_y&=-ROUND(first_crossing_y*view_scale)-origin_y_pixels&
        rect_right&=ROUND(second_crossing_x*view_scale)-origin_x_pixels&
        box_bottom_y&=-ROUND(second_crossing_y*view_scale)-origin_y_pixels&
        box_left&=draw_left_x&-4
        box_top&=box_top_y&-box_margin&
        box_right&=rect_right&+4
        box_bottom&=box_bottom_y&+box_margin&
        slot_top_visible!=TRUE
        slot_bottom_visible!=TRUE
        IF box_left&<work_min_x&
          box_left&=work_min_x&
        ELSE
          IF box_left&>work_max_x&
            box_left&=work_max_x&
          ENDIF
        ENDIF
        IF box_top&<work_min_y&
          box_top&=work_min_y&
          slot_top_visible!=FALSE
        ELSE
          IF box_top&>work_max_y&
            box_top&=work_max_y&
          ENDIF
        ENDIF
        IF box_right&<work_min_x&
          box_right&=work_min_x&
        ELSE
          IF box_right&>work_max_x&
            box_right&=work_max_x&
          ENDIF
        ENDIF
        IF box_bottom&<work_min_y&
          box_bottom&=work_min_y&
        ELSE
          IF box_bottom&>work_max_y&
            box_bottom&=work_max_y&
            slot_bottom_visible!=FALSE
          ENDIF
        ENDIF
        DEFFILL ,0,0
        PBOX box_left&,box_top&,box_right&,box_bottom&
        DEFFILL ,1,1
        BOUNDARY 1
        PBOX draw_left_x&,box_top_y&,rect_right&,box_bottom_y&
        draw_left_x&=draw_left_x&+cycle_tool_pixels&
        SUB rect_right&,cycle_tool_pixels&
        IF slot_top_visible!
          ADD box_top&,4
        ENDIF
        IF slot_bottom_visible!
          SUB box_bottom&,4
        ENDIF
        PBOX draw_left_x&,box_top&,rect_right&,box_top_y&
        PBOX draw_left_x&,box_bottom_y&,rect_right&,box_bottom&
        IF NOT wireframe_view!
          PCIRCLE draw_left_x&,box_top_y&,cycle_tool_pixels&,850,1850
          PCIRCLE draw_left_x&,box_bottom_y&,cycle_tool_pixels&,1750,2750
          PCIRCLE rect_right&,box_top_y&,cycle_tool_pixels&,3550,950
          PCIRCLE rect_right&,box_bottom_y&,cycle_tool_pixels&,2650,3650
        ENDIF
      ENDIF
    ENDSELECT
    ' copy the shape into the layer bitmap and the view
    BOUNDARY 0
    IF box_left&<>box_right& OR box_top&<>box_bottom&
      bitmap_left&=box_left&+layer_offset_x&
      bitmap_top&=box_top&+layer_offset_y&
      bitmap_right&=box_right&+layer_offset_x&
      bitmap_bottom&=box_bottom&+layer_offset_y&
      window_left&=box_left&+work_offset_x&
      window_top&=box_top&+work_offset_y&
      window_right&=box_right&+work_offset_x&
      window_bottom&=box_bottom&+work_offset_y&
      IF wireframe_view!
        layer_mfdb%(0)=layer_bitmaps%(1)
      ELSE
        layer_mfdb%(0)=layer_bitmaps%(cut_layer|)
      ENDIF
      blit_params%(0)=window_left&
      blit_params%(1)=window_top&
      blit_params%(2)=window_right&
      blit_params%(3)=window_bottom&
      blit_params%(4)=bitmap_left&
      blit_params%(5)=bitmap_top&
      blit_params%(6)=bitmap_right&
      blit_params%(7)=bitmap_bottom&
      blit_params%(8)=7
      BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
      CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
      IF box_left&<view_min_x&
        box_left&=view_min_x&
      ELSE
        IF box_left&>view_max_x&
          box_left&=view_max_x&
        ENDIF
      ENDIF
      IF box_top&<view_min_y&
        box_top&=view_min_y&
      ELSE
        IF box_top&>view_max_y&
          box_top&=view_max_y&
        ENDIF
      ENDIF
      IF box_right&>view_max_x&
        box_right&=view_max_x&
      ENDIF
      IF box_bottom&>view_max_y&
        box_bottom&=view_max_y&
      ENDIF
      bitmap_left&=box_left&+layer_offset_x&
      bitmap_top&=box_top&+layer_offset_y&
      bitmap_right&=box_right&+layer_offset_x&
      bitmap_bottom&=box_bottom&+layer_offset_y&
      window_left&=box_left&+view_origin_x&
      window_top&=box_top&+view_offset_y&
      window_right&=box_right&+view_origin_x&
      window_bottom&=box_bottom&+view_offset_y&
      DEFFILL ,0,0
      PBOX box_left&,box_top&,box_right&,box_bottom&
      IF wireframe_view!
        layer_mfdb%(0)=layer_bitmaps%(1)
      ELSE
        FOR loop_index|=depth_levels_used| DOWNTO 1
          IF layer_used!(loop_index|)
            IF loop_index|=1
              DEFFILL ,1,1
            ELSE
              DEFFILL ,2,depth_level_colours|(loop_index|)
            ENDIF
            PBOX box_left&,box_top&,box_right&,box_bottom&
            layer_mfdb%(0)=layer_bitmaps%(loop_index|)
            blit_params%(0)=bitmap_left&
            blit_params%(1)=bitmap_top&
            blit_params%(2)=bitmap_right&
            blit_params%(3)=bitmap_bottom&
            blit_params%(4)=window_left&
            blit_params%(5)=window_top&
            blit_params%(6)=window_right&
            blit_params%(7)=window_bottom&
            blit_params%(8)=1
            BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
            layer_mfdb%(0)=layer_bitmaps%(0)
            blit_params%(0)=window_left&
            blit_params%(1)=window_top&
            blit_params%(2)=window_right&
            blit_params%(3)=window_bottom&
            blit_params%(4)=bitmap_left&
            blit_params%(5)=bitmap_top&
            blit_params%(6)=bitmap_right&
            blit_params%(7)=bitmap_bottom&
            blit_params%(8)=7
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          ENDIF
        NEXT loop_index|
        layer_mfdb%(0)=layer_bitmaps%(0)
      ENDIF
      screen_x&=MIN(work_right&,screen_max_x&)
      screen_y&=MIN(work_bottom&,screen_max_y&)
      blit_params%(0)=work_x&
      blit_params%(1)=work_y&
      blit_params%(2)=screen_x&
      blit_params%(3)=screen_y&
      blit_params%(4)=work_x&
      blit_params%(5)=work_y&
      blit_params%(6)=screen_x&
      blit_params%(7)=screen_y&
      blit_params%(8)=3
      BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
      blit_params%(0)=bitmap_left&
      blit_params%(1)=bitmap_top&
      blit_params%(2)=bitmap_right&
      blit_params%(3)=bitmap_bottom&
      blit_params%(4)=window_left&
      blit_params%(5)=window_top&
      blit_params%(6)=window_right&
      blit_params%(7)=window_bottom&
      BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
      CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
      ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
      ' remove the tool sprite while the window is updated
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        SPRITE tool_sprite$
      ENDIF
      redraw_x&=window_left&
      redraw_y&=window_top&
      redraw_width&=window_right&-window_left&
      redraw_height&=window_bottom&-window_top&
      IF redraw_x&<screen_width& AND redraw_y&<screen_height&
        ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          blit_params%(8)=3
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
        WHILE rect_height&<>0 OR rect_width&<>0
          IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
            IF screen_x&+rect_width&>screen_width&
              rect_width&=screen_width&-screen_x&
            ENDIF
            IF screen_y&+rect_height&>screen_height&
              rect_height&=screen_height&-screen_y&
            ENDIF
            DEC rect_width&
            DEC rect_height&
            blit_params%(0)=screen_x&
            blit_params%(1)=screen_y&
            blit_params%(2)=screen_x&+rect_width&
            blit_params%(3)=screen_y&+rect_height&
            blit_params%(4)=screen_x&
            blit_params%(5)=screen_y&
            blit_params%(6)=screen_x&+rect_width&
            blit_params%(7)=screen_y&+rect_height&
            BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
          ENDIF
          ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
        WEND
      ENDIF
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        ' a slot: the sprite alternates between the slot ends
        IF other_contour|=3
          IF (NOT rotation_active!) AND ODD(cycle_pass%) AND (NOT is_finished!)
            sprite_x&=slot_far_x&
            sprite_y&=slot_far_y&
          ENDIF
        ENDIF
        sprite_x&=sprite_x&+view_origin_x&
        sprite_y&=sprite_y&+view_offset_y&
        IF sprite_x&<screen_max_x& AND sprite_y&<screen_max_y&
          SPRITE tool_sprite$,sprite_x&,sprite_y&
        ENDIF
      ENDIF
    ELSE
      ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    ENDIF
    CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
  ENDIF
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Draws a slot (cycle 3) or pocket (cycle 4) turned by the rotation angle rotation_angle with thick lines. A
' line can only be about 40 pixels wide, so a wider cut is split into parallel stripes whose offsets from the
' centre line go into stripe_offsets&() (ended by 0). The end points of the centre line are rotated and mirrored
' (mirror_x!/mirror_y!), the stripes drawn as lines, and for a pocket or a wide slot the outline drawn round
' them. Returns the changed rectangle in box_left&-box_bottom& and the sprite position in sprite_x&/sprite_y&.
PROCEDURE draw_rotated_slot_pocket(other_contour|,cycle_pass%,rnd_first_axis|,rnd_second_axis|,VAR box_left&,box_top&,box_right&,box_bottom&,sprite_x&,sprite_y&)
  LOCAL direction_x,direction_y,point_distance,work_point_y,step_width&,slot_width_pixels&,half_slot_pixels&,line_index&,rect_width&,half_excess_pixels&,box_margin&,double_margin&,stripe_width|,outer_stripe_width|,forward_direction!,restore_flag!,line_index&,stripe_count|,axis_entry_count|,inner_stripe_count|,outer_stripe_count|,loop_index|,settings_entry|,inner_stripe_last|,outer_stripe_last|,point_u,mouse_x&,point_v,mouse_y&,corner_u,slot_end_x&,corner_v,slot_end_y&,screen_x&,screen_y&,end_x&,end_y&,angle_offset,rotate_length,box_width&,box_height&,stripe_dx&,stripe_dy&,stripe_left_dx&,stripe_left_dy&,stripe_right_dx&,stripe_right_dy&,scan_column|,stroke_radius,draw_centre_line!,outline_left_start_x&,outline_left_start_y&,outline_left_end_x&,outline_left_end_y&,outline_right_start_x&,outline_right_start_y&,outline_right_end_x&,outline_right_end_y&,half_width_u,half_offset_u,half_width_v,half_offset_v,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' length and width of the slot or pocket
  direction_x=corner_point(rnd_first_axis|)
  direction_y=corner_point(rnd_second_axis|)
  point_distance=corner_point(first_plane_axis|)
  work_point_y=corner_point(second_plane_axis|)
  step_width&=ROUND(direction_x*view_scale)
  slot_width_pixels&=ROUND(direction_y*view_scale)
  half_slot_pixels&=CINT(slot_width_pixels&/2)
  ' the tool diameter in pixels
  line_index&=tool_radius_pixels&*2
  ' how much wider than the tool the cut is
  rect_width&=ABS(slot_width_pixels&-line_index&)
  half_excess_pixels&=CINT(rect_width&/2)
  box_margin&=slot_width_pixels&+4
  double_margin&=box_margin&*2
  ' the cut is exactly the tool width
  IF rect_width&=0
    ' narrow enough for one line
    IF slot_width_pixels&<=40
      stripe_width|=slot_width_pixels&
      stripe_count|=FALSE
      DIM stripe_offsets&(1)
      ARRAYFILL stripe_offsets&(),0
      inner_stripe_last|=FALSE
    ELSE
      ' the number of stripes of at most 40 pixels
      axis_entry_count|=SUCC(slot_width_pixels& DIV 40)
      stripe_count|=axis_entry_count|
      stripe_width|=CINT(slot_width_pixels&/axis_entry_count|)
      IF ODD(stripe_width|)
        INC stripe_width|
      ENDIF
      inner_stripe_last|=SHR|(axis_entry_count|,1)
      DIM stripe_offsets&(SUCC(inner_stripe_last|))
      ARRAYFILL stripe_offsets&(),0
      DEC inner_stripe_last|
      FOR loop_index|=FALSE TO inner_stripe_last|
        stripe_offsets&(SUCC(loop_index|))=half_slot_pixels&-(loop_index|*2+1)*stripe_width|/2
        IF ODD(stripe_count|)
          INC stripe_offsets&(SUCC(loop_index|))
        ENDIF
      NEXT loop_index|
      INC inner_stripe_last|
    ENDIF
  ELSE
    ' narrow excess and narrow tool
    IF rect_width&<=40 AND tool_radius_pixels&<=40
      stripe_width|=rect_width&
      outer_stripe_width|=tool_radius_pixels& DIV 2
      stripe_count|=1
      DIM stripe_offsets&(2)
      ARRAYFILL stripe_offsets&(),0
      stripe_offsets&(1)=half_slot_pixels&-(outer_stripe_width| DIV 2)
      inner_stripe_last|=FALSE
    ELSE
      ' narrow excess, wide tool
      IF rect_width&<=40 AND tool_radius_pixels&>40
        stripe_width|=SUCC(rect_width&)
        inner_stripe_last|=FALSE
        axis_entry_count|=SUCC(line_index& DIV 40)
        stripe_count|=axis_entry_count|
        outer_stripe_width|=CINT(line_index&/axis_entry_count|)
        IF ODD(outer_stripe_width|)
          INC outer_stripe_width|
        ENDIF
        settings_entry|=SHR|(axis_entry_count|,1)
        DIM stripe_offsets&(SUCC(settings_entry|))
        ARRAYFILL stripe_offsets&(),0
        DEC settings_entry|
        FOR loop_index|=FALSE TO settings_entry|
          stripe_offsets&(SUCC(loop_index|))=half_slot_pixels&-20-(loop_index|*2+1)*outer_stripe_width|/2
          IF ODD(stripe_count|)
            INC stripe_offsets&(SUCC(loop_index|))
          ENDIF
        NEXT loop_index|
        IF EVEN(stripe_count|)
          INC stripe_count|
        ENDIF
      ELSE
        ' wide excess, narrow tool
        IF rect_width&>40 AND tool_radius_pixels&<=40
          axis_entry_count|=SUCC(rect_width& DIV 40)
          stripe_count|=axis_entry_count|+2
          outer_stripe_width|=CINT(rect_width&/axis_entry_count|)
          IF ODD(outer_stripe_width|)
            INC outer_stripe_width|
          ENDIF
          inner_stripe_last|=1
          outer_stripe_last|=SHR|(axis_entry_count|,1)+1
          DIM stripe_offsets&(outer_stripe_last|+2)
          ARRAYFILL stripe_offsets&(),0
          stripe_width|=tool_radius_pixels&
          stripe_offsets&(1)=PRED(half_slot_pixels&-(stripe_width| DIV 2))
          DEC outer_stripe_last|
          FOR loop_index|=FALSE TO outer_stripe_last|
            stripe_offsets&(loop_index|+2)=half_excess_pixels&-(loop_index|*2+1)*outer_stripe_width|/2
            IF ODD(stripe_count|)
              INC stripe_offsets&(loop_index|+2)
            ENDIF
          NEXT loop_index|
          INC outer_stripe_width|
        ELSE
          ' wide excess and wide tool: inner and outer stripes
          inner_stripe_count|=SUCC(tool_radius_pixels& DIV 40)
          stripe_width|=CINT(tool_radius_pixels&/inner_stripe_count|)
          IF ODD(stripe_width|)
            INC stripe_width|
          ENDIF
          outer_stripe_count|=SUCC(rect_width& DIV 40)
          outer_stripe_width|=CINT(rect_width&/outer_stripe_count|)
          IF ODD(outer_stripe_width|)
            INC outer_stripe_width|
          ENDIF
          stripe_count|=outer_stripe_count|+MUL(inner_stripe_count|,2)
          settings_entry|=inner_stripe_count|+SHR|(outer_stripe_count|,1)
          INC settings_entry|
          DIM stripe_offsets&(SUCC(settings_entry|))
          ARRAYFILL stripe_offsets&(),0
          inner_stripe_last|=inner_stripe_count|
          outer_stripe_last|=SHR(outer_stripe_count|,1)
          DEC inner_stripe_last|
          DEC outer_stripe_last|
          FOR loop_index|=FALSE TO inner_stripe_last|
            stripe_offsets&(SUCC(loop_index|))=half_slot_pixels&-(loop_index|*2+1)*stripe_width|/2
            IF ODD(outer_stripe_count|)
              INC stripe_offsets&(SUCC(loop_index|))
            ENDIF
          NEXT loop_index|
          INC inner_stripe_last|
          FOR loop_index|=FALSE TO outer_stripe_last|
            stripe_offsets&(SUCC(loop_index|+inner_stripe_last|))=half_excess_pixels&-(loop_index|*2+1)*outer_stripe_width|/2
            IF ODD(inner_stripe_count|)
              INC stripe_offsets&(SUCC(loop_index|+inner_stripe_last|))
            ENDIF
          NEXT loop_index|
          INC outer_stripe_width|
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' thin tool: the stroke radius is the tool radius, else 20 pixels
  IF tool_radius_pixels&<=20
    stroke_radius=tool_radius
    forward_direction!=FALSE
  ELSE
    stroke_radius=20/view_scale
    forward_direction!=TRUE
  ENDIF
  ' a slot
  IF other_contour|=3
    ' along the first axis
    IF rnd_first_axis|=first_plane_axis|
      IF (NOT mirror_x_after_rotation!) AND mirror_x!
        point_distance=-point_distance
      ENDIF
      IF point_distance>=0
        SUB point_distance,tool_radius
      ELSE
        point_distance=point_distance+tool_radius
      ENDIF
      IF point_distance=stroke_radius
        restore_flag!=TRUE
      ELSE
        restore_flag!=FALSE
        point_u=point_distance
        IF point_distance>=0
          SUB point_distance,stroke_radius
          SUB point_u,tool_radius
        ELSE
          point_distance=point_distance+stroke_radius
          point_u=point_u+tool_radius
        ENDIF
        IF point_distance>=0
          angle_offset=0
        ELSE
          angle_offset=PI
        ENDIF
        angle_offset=angle_offset+rotation_angle
        rotate_length=ABS(point_distance)
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        point_distance=ROUND(1000000*point_distance)/1000000
        work_point_y=ROUND(1000000*work_point_y)/1000000
        rotate_length=ABS(point_u)
        point_u=COS(angle_offset)*rotate_length
        point_v=SIN(angle_offset)*rotate_length
        point_u=ROUND(1000000*point_u)/1000000
        point_v=ROUND(1000000*point_v)/1000000
        angle_offset=angle_offset+PI
        rotate_length=tool_radius
        IF forward_direction!
          SUB rotate_length,stroke_radius
        ENDIF
        next_u=COS(angle_offset)*rotate_length
        slot_end_v=SIN(angle_offset)*rotate_length
        next_u=ROUND(1000000*next_u)/1000000
        slot_end_v=ROUND(1000000*slot_end_v)/1000000
        corner_u=0
        corner_v=0
      ENDIF
    ELSE
      IF (NOT mirror_y_after_rotation!) AND mirror_y!
        work_point_y=-work_point_y
      ENDIF
      IF work_point_y>=0
        SUB work_point_y,tool_radius
      ELSE
        work_point_y=work_point_y+tool_radius
      ENDIF
      IF work_point_y=stroke_radius
        restore_flag!=TRUE
      ELSE
        restore_flag!=FALSE
        point_v=work_point_y
        IF work_point_y>=0
          SUB work_point_y,stroke_radius
          SUB point_v,tool_radius
        ELSE
          work_point_y=work_point_y+stroke_radius
          point_v=point_v+tool_radius
        ENDIF
        IF work_point_y>=0
          angle_offset=PI/2
        ELSE
          angle_offset=PI*1.5
        ENDIF
        angle_offset=angle_offset+rotation_angle
        rotate_length=ABS(work_point_y)
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        point_distance=ROUND(1000000*point_distance)/1000000
        work_point_y=ROUND(1000000*work_point_y)/1000000
        rotate_length=ABS(point_v)
        point_u=COS(angle_offset)*rotate_length
        point_v=SIN(angle_offset)*rotate_length
        point_u=ROUND(1000000*point_u)/1000000
        point_v=ROUND(1000000*point_v)/1000000
        angle_offset=angle_offset+PI
        rotate_length=tool_radius
        IF forward_direction!
          SUB rotate_length,stroke_radius
        ENDIF
        next_u=COS(angle_offset)*rotate_length
        slot_end_v=SIN(angle_offset)*rotate_length
        next_u=ROUND(1000000*next_u)/1000000
        slot_end_v=ROUND(1000000*slot_end_v)/1000000
        corner_u=0
        corner_v=0
      ENDIF
    ENDIF
  ELSE
    ' a pocket: half length and half width
    DIV point_distance,2
    DIV work_point_y,2
    IF rnd_first_axis|=first_plane_axis|
      IF point_distance=stroke_radius
        restore_flag!=TRUE
      ELSE
        restore_flag!=FALSE
        point_u=point_distance
        IF point_distance>=0
          SUB point_distance,stroke_radius
          SUB point_u,tool_radius
        ELSE
          point_distance=point_distance+stroke_radius
          point_u=point_u+tool_radius
        ENDIF
        IF point_distance>=0
          angle_offset=0
        ELSE
          angle_offset=PI
        ENDIF
        angle_offset=angle_offset+rotation_angle
        half_width_u=point_distance
        half_offset_u=point_u
        rotate_length=ABS(point_distance)
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        point_distance=ROUND(1000000*point_distance)/1000000
        work_point_y=ROUND(1000000*work_point_y)/1000000
        rotate_length=ABS(point_u)
        point_u=COS(angle_offset)*rotate_length
        point_v=SIN(angle_offset)*rotate_length
        point_u=ROUND(1000000*point_u)/1000000
        point_v=ROUND(1000000*point_v)/1000000
        angle_offset=angle_offset+PI
        rotate_length=ABS(half_width_u)
        next_u=COS(angle_offset)*rotate_length
        slot_end_v=SIN(angle_offset)*rotate_length
        next_u=ROUND(1000000*next_u)/1000000
        slot_end_v=ROUND(1000000*slot_end_v)/1000000
        rotate_length=ABS(half_offset_u)
        corner_u=COS(angle_offset)*rotate_length
        corner_v=SIN(angle_offset)*rotate_length
        corner_u=ROUND(1000000*corner_u)/1000000
        corner_v=ROUND(1000000*corner_v)/1000000
      ENDIF
    ELSE
      IF work_point_y=stroke_radius
        restore_flag!=TRUE
      ELSE
        restore_flag!=FALSE
        point_v=work_point_y
        IF work_point_y>=0
          SUB work_point_y,stroke_radius
          SUB point_v,tool_radius
        ELSE
          work_point_y=work_point_y+stroke_radius
          point_v=point_v+tool_radius
        ENDIF
        IF work_point_y>=0
          angle_offset=PI/2
        ELSE
          angle_offset=PI*1.5
        ENDIF
        angle_offset=angle_offset+rotation_angle
        half_width_v=work_point_y
        half_offset_v=point_v
        rotate_length=ABS(work_point_y)
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        point_distance=ROUND(1000000*point_distance)/1000000
        work_point_y=ROUND(1000000*work_point_y)/1000000
        rotate_length=ABS(point_v)
        point_u=COS(angle_offset)*rotate_length
        point_v=SIN(angle_offset)*rotate_length
        point_u=ROUND(1000000*point_u)/1000000
        point_v=ROUND(1000000*point_v)/1000000
        angle_offset=angle_offset+PI
        rotate_length=ABS(half_width_v)
        next_u=COS(angle_offset)*rotate_length
        slot_end_v=SIN(angle_offset)*rotate_length
        next_u=ROUND(1000000*next_u)/1000000
        slot_end_v=ROUND(1000000*slot_end_v)/1000000
        rotate_length=ABS(half_offset_v)
        corner_u=COS(angle_offset)*rotate_length
        corner_v=SIN(angle_offset)*rotate_length
        corner_u=ROUND(1000000*corner_u)/1000000
        corner_v=ROUND(1000000*corner_v)/1000000
      ENDIF
    ENDIF
  ENDIF
  SUB angle_offset,PI
  ' no movement inside the cut: all offsets zero
  IF restore_flag!
    point_distance=0
    work_point_y=0
    next_u=0
    slot_end_v=0
    point_u=0
    point_v=0
    corner_u=0
    corner_v=0
  ENDIF
  ' mirror the first axis
  IF mirror_x_after_rotation! AND mirror_x!
    angle_offset=PI-angle_offset
    point_distance=-point_distance
    next_u=-next_u
    point_u=-point_u
    corner_u=-corner_u
  ENDIF
  ' mirror the second axis
  IF mirror_y_after_rotation! AND mirror_y!
    angle_offset=-angle_offset
    work_point_y=-work_point_y
    slot_end_v=-slot_end_v
    point_v=-point_v
    corner_v=-corner_v
  ENDIF
  ' the rotated end points in pixels
  screen_x&=ROUND((next_u+start_point(first_plane_axis|))*view_scale)-origin_x_pixels&
  screen_y&=-ROUND((slot_end_v+start_point(second_plane_axis|))*view_scale)-origin_y_pixels&
  end_x&=ROUND((point_distance+start_point(first_plane_axis|))*view_scale)-origin_x_pixels&
  end_y&=-ROUND((work_point_y+start_point(second_plane_axis|))*view_scale)-origin_y_pixels&
  mouse_x&=ROUND((corner_u+start_point(first_plane_axis|))*view_scale)-origin_x_pixels&
  mouse_y&=-ROUND((corner_v+start_point(second_plane_axis|))*view_scale)-origin_y_pixels&
  slot_end_x&=ROUND((point_u+start_point(first_plane_axis|))*view_scale)-origin_x_pixels&
  slot_end_y&=-ROUND((point_v+start_point(second_plane_axis|))*view_scale)-origin_y_pixels&
  ' odd slot pass: the sprite at the far end
  IF other_contour|=3 AND ODD(cycle_pass%)
    sprite_x&=slot_end_x&
    sprite_y&=slot_end_y&
  ELSE
    sprite_x&=ROUND(view_scale*start_point(first_plane_axis|))-origin_x_pixels&
    sprite_y&=-ROUND(view_scale*start_point(second_plane_axis|))-origin_y_pixels&
  ENDIF
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
  IF ODD(stripe_count|) OR stripe_count|=0
    draw_centre_line!=TRUE
  ELSE
    draw_centre_line!=FALSE
  ENDIF
  DEFLINE ,stripe_width|
  scan_column|=FALSE
  ' one stripe per pass
  REPEAT
    IF rect_width&>0 AND scan_column|>inner_stripe_last|
      DEFLINE ,outer_stripe_width|
    ENDIF
    IF scan_column|=0
      box_width&=double_margin&+ABS(screen_x&-end_x&)
      box_height&=double_margin&+ABS(screen_y&-end_y&)
      IF screen_x&<end_x&
        box_left&=screen_x&
      ELSE
        box_left&=end_x&
      ENDIF
      SUB box_left&,box_margin&
      IF box_left&<work_min_x&
        box_left&=work_min_x&
      ELSE
        IF box_left&>work_max_x&
          box_left&=work_max_x&
        ENDIF
      ENDIF
      IF screen_y&<end_y&
        box_top&=screen_y&
      ELSE
        box_top&=end_y&
      ENDIF
      SUB box_top&,box_margin&
      IF box_top&<work_min_y&
        box_top&=work_min_y&
      ELSE
        IF box_top&>work_max_y&
          box_top&=work_max_y&
        ENDIF
      ENDIF
      box_right&=box_left&+box_width&
      IF box_right&>work_max_x&
        box_right&=work_max_x&
      ENDIF
      box_bottom&=box_top&+box_height&
      IF box_bottom&>work_max_y&
        box_bottom&=work_max_y&
      ENDIF
      DEFFILL ,0,0
      BOUNDARY 0
      PBOX box_left&,box_top&,box_right&,box_bottom&
      BOUNDARY 1
      DEFFILL ,1,1
      IF other_contour|=3 AND (NOT wireframe_view!)
        DEC tool_radius_pixels&
        PCIRCLE mouse_x&,mouse_y&,tool_radius_pixels&
        PCIRCLE slot_end_x&,slot_end_y&,tool_radius_pixels&
        INC tool_radius_pixels&
      ENDIF
      IF draw_centre_line!
        IF rect_width&=0 AND other_contour|=3
          DRAW mouse_x&,mouse_y&,slot_end_x&,slot_end_y&
        ELSE
          DRAW screen_x&,screen_y&,end_x&,end_y&
        ENDIF
      ENDIF
    ELSE
      stripe_dx&=ROUND(stripe_offsets&(scan_column|)*COS(angle_offset))
      stripe_dy&=-ROUND(stripe_offsets&(scan_column|)*SIN(angle_offset))
      stripe_left_dx&=stripe_dy&
      stripe_left_dy&=-stripe_dx&
      stripe_right_dx&=-stripe_dy&
      stripe_right_dy&=stripe_dx&
      IF tool_radius_pixels&>20 AND scan_column|<=inner_stripe_last|
        DRAW mouse_x&+stripe_left_dx&,mouse_y&+stripe_left_dy&,slot_end_x&+stripe_left_dx&,slot_end_y&+stripe_left_dy&
        DRAW mouse_x&+stripe_right_dx&,mouse_y&+stripe_right_dy&,slot_end_x&+stripe_right_dx&,slot_end_y&+stripe_right_dy&
      ELSE
        IF other_contour|=3
          DRAW mouse_x&+stripe_left_dx&,mouse_y&+stripe_left_dy&,end_x&+stripe_left_dx&,end_y&+stripe_left_dy&
          DRAW mouse_x&+stripe_right_dx&,mouse_y&+stripe_right_dy&,end_x&+stripe_right_dx&,end_y&+stripe_right_dy&
        ELSE
          DRAW screen_x&+stripe_left_dx&,screen_y&+stripe_left_dy&,end_x&+stripe_left_dx&,end_y&+stripe_left_dy&
          DRAW screen_x&+stripe_right_dx&,screen_y&+stripe_right_dy&,end_x&+stripe_right_dx&,end_y&+stripe_right_dy&
        ENDIF
      ENDIF
    ENDIF
    INC scan_column|
  UNTIL stripe_offsets&(scan_column|)=0
  ' draw the outline round the stripes
  IF other_contour|=3 AND rect_width&>0 AND scan_column|>inner_stripe_last| OR other_contour|=4
    SUB half_slot_pixels&,tool_radius_pixels&
    stripe_dx&=ROUND(half_slot_pixels&*COS(angle_offset))
    stripe_dy&=-ROUND(half_slot_pixels&*SIN(angle_offset))
    stripe_left_dx&=stripe_dy&
    stripe_left_dy&=-stripe_dx&
    stripe_right_dx&=-stripe_dy&
    stripe_right_dy&=stripe_dx&
    outline_left_start_x&=mouse_x&+stripe_left_dx&
    outline_left_start_y&=mouse_y&+stripe_left_dy&
    outline_right_start_x&=mouse_x&+stripe_right_dx&
    outline_right_start_y&=mouse_y&+stripe_right_dy&
    outline_left_end_x&=slot_end_x&+stripe_left_dx&
    outline_left_end_y&=slot_end_y&+stripe_left_dy&
    outline_right_end_x&=slot_end_x&+stripe_right_dx&
    outline_right_end_y&=slot_end_y&+stripe_right_dy&
    DEC tool_radius_pixels&
    PCIRCLE outline_left_start_x&,outline_left_start_y&,tool_radius_pixels&
    PCIRCLE outline_right_start_x&,outline_right_start_y&,tool_radius_pixels&
    PCIRCLE outline_left_end_x&,outline_left_end_y&,tool_radius_pixels&
    PCIRCLE outline_right_end_x&,outline_right_end_y&,tool_radius_pixels&
    INC tool_radius_pixels&
    outline_line_width&=tool_radius_pixels&*2
    restore_flag!=FALSE
    IF outline_line_width&>40
      restore_flag!=TRUE
      half_slot_pixels&=half_slot_pixels&+(-20+tool_radius_pixels&)
      outline_line_width&=38
    ENDIF
    stripe_dx&=ROUND(half_slot_pixels&*COS(angle_offset))
    stripe_dy&=-ROUND(half_slot_pixels&*SIN(angle_offset))
    stripe_left_dx&=stripe_dy&
    stripe_left_dy&=-stripe_dx&
    stripe_right_dx&=-stripe_dy&
    stripe_right_dy&=stripe_dx&
    outline_left_start_x&=mouse_x&+stripe_left_dx&
    outline_right_start_x&=mouse_x&+stripe_right_dx&
    outline_right_end_x&=slot_end_x&+stripe_right_dx&
    outline_left_end_x&=slot_end_x&+stripe_left_dx&
    outline_left_start_y&=mouse_y&+stripe_left_dy&
    outline_right_start_y&=mouse_y&+stripe_right_dy&
    outline_left_end_y&=slot_end_y&+stripe_left_dy&
    outline_right_end_y&=slot_end_y&+stripe_right_dy&
    DEFLINE ,outline_line_width&
    DRAW outline_right_start_x&,outline_right_start_y&,outline_left_start_x&,outline_left_start_y&
    DRAW outline_left_start_x&,outline_left_start_y&,outline_left_end_x&,outline_left_end_y&
    DRAW outline_left_end_x&,outline_left_end_y&,outline_right_end_x&,outline_right_end_y&
    DRAW outline_right_end_x&,outline_right_end_y&,outline_right_start_x&,outline_right_start_y&
    IF restore_flag!
      stripe_dx&=ROUND(half_excess_pixels&*COS(angle_offset))
      stripe_dy&=-ROUND(half_excess_pixels&*SIN(angle_offset))
      stripe_left_dx&=stripe_dy&
      stripe_left_dy&=-stripe_dx&
      stripe_right_dx&=-stripe_dy&
      stripe_right_dy&=stripe_dx&
      outline_left_start_x&=screen_x&+stripe_left_dx&
      outline_right_start_x&=screen_x&+stripe_right_dx&
      outline_right_end_x&=end_x&+stripe_right_dx&
      outline_left_end_x&=end_x&+stripe_left_dx&
      outline_left_start_y&=screen_y&+stripe_left_dy&
      outline_right_start_y&=screen_y&+stripe_right_dy&
      outline_left_end_y&=end_y&+stripe_left_dy&
      outline_right_end_y&=end_y&+stripe_right_dy&
      DRAW outline_right_start_x&,outline_right_start_y&,outline_left_start_x&,outline_left_start_y&
      DRAW outline_left_start_x&,outline_left_start_y&,outline_left_end_x&,outline_left_end_y&
      DRAW outline_left_end_x&,outline_left_end_y&,outline_right_end_x&,outline_right_end_y&
      DRAW outline_right_end_x&,outline_right_end_y&,outline_right_start_x&,outline_right_start_y&
    ENDIF
  ENDIF
  ERASE stripe_offsets&()
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' Cycle 15 (Vorbohren, pilot drilling): stamps one drilled hole at the current tool position into the
' depth-level bitmaps and shows it. cut_depth is the hole depth. The depth level cut_layer| is found from the
' level limits depth_level_table() (level 1 when cut_depth<=blank_bottom). The hole (a filled circle of the tool
' radius tool_radius_pixels& pixels, a single point in the line display mode wireframe_view!) is drawn on the
' off-screen buffer offscreen_buffer% into the level bitmap layer_bitmaps%(cut_layer|), marked in layer_used!(),
' and the changed box box_left&..box_bottom& is then rebuilt from all marked levels (deepest first, each with
' its own fill pattern depth_level_colours|()) and copied to the screen and the window, rectangle by rectangle
' from the AES rectangle list, with the cursor sprite tool_sprite$ hidden meanwhile.
PROCEDURE draw_pilot_drill_hole(cut_depth)
  LOCAL loop_index|,cut_layer|,screen_x&,screen_y&,cycle_tool_pixels&,box_margin&,box_left&,box_top&,box_right&,box_bottom&,window_left&,window_top&,window_right&,window_bottom&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' shallow hole: first depth level
  IF cut_depth<=blank_bottom
    cut_layer|=1
  ELSE
    loop_index|=FALSE
    ' search the depth level whose limits enclose cut_depth
    REPEAT
      INC loop_index|
    UNTIL loop_index|=layer_depth_count| OR (cut_depth>depth_level_table(loop_index|) AND cut_depth<=depth_level_table(SUCC(loop_index|)))
    cut_layer|=SUCC(loop_index|)
  ENDIF
  ' draw into the off-screen buffer
  ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
  ' clip to the drawing area of the off-screen buffer
  CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
  ' hole centre in pixels
  screen_x&=ROUND(view_scale*end_point(first_plane_axis|))-origin_x_pixels&
  screen_y&=-ROUND(view_scale*end_point(second_plane_axis|))-origin_y_pixels&
  ' hole box half size: tool diameter in pixels plus a margin
  cycle_tool_pixels&=tool_radius_pixels&*2
  box_margin&=cycle_tool_pixels&+4
  box_left&=screen_x&-box_margin&
  ' keep the hole box inside the drawing area
  IF box_left&<work_min_x&
    box_left&=work_min_x&
  ELSE
    IF box_left&>work_max_x&
      box_left&=work_max_x&
    ENDIF
  ENDIF
  box_top&=screen_y&-box_margin&
  IF box_top&<work_min_y&
    box_top&=work_min_y&
  ELSE
    IF box_top&>work_max_y&
      box_top&=work_max_y&
    ENDIF
  ENDIF
  box_right&=screen_x&+box_margin&
  IF box_right&<work_min_x&
    box_right&=work_min_x&
  ELSE
    IF box_right&>work_max_x&
      box_right&=work_max_x&
    ENDIF
  ENDIF
  box_bottom&=screen_y&+box_margin&
  IF box_bottom&<work_min_y&
    box_bottom&=work_min_y&
  ELSE
    IF box_bottom&>work_max_y&
      box_bottom&=work_max_y&
    ENDIF
  ENDIF
  DEFFILL ,0,0
  PBOX box_left&,box_top&,box_right&,box_bottom&
  DEFFILL ,1,1
  BOUNDARY 1
  ' line display mode: only a point
  IF wireframe_view!
    PCIRCLE screen_x&,screen_y&,1
    layer_mfdb%(0)=layer_bitmaps%(1)
  ELSE
    ' mark the depth level as used
    layer_used!(cut_layer|)=TRUE
    ' the hole, tool radius in pixels
    PCIRCLE screen_x&,screen_y&,tool_radius_pixels&
    ' the level bitmap of this depth
    layer_mfdb%(0)=layer_bitmaps%(cut_layer|)
  ENDIF
  BOUNDARY 0
  ' the box is not empty
  IF box_left&<>box_right& OR box_top&<>box_bottom&
    ' box in level bitmap coordinates
    bitmap_left&=box_left&+layer_offset_x&
    bitmap_top&=box_top&+layer_offset_y&
    bitmap_right&=box_right&+layer_offset_x&
    bitmap_bottom&=box_bottom&+layer_offset_y&
    ' box in screen coordinates
    window_left&=box_left&+work_offset_x&
    window_top&=box_top&+work_offset_y&
    window_right&=box_right&+work_offset_x&
    window_bottom&=box_bottom&+work_offset_y&
    blit_params%(0)=window_left&
    blit_params%(1)=window_top&
    blit_params%(2)=window_right&
    blit_params%(3)=window_bottom&
    blit_params%(4)=bitmap_left&
    blit_params%(5)=bitmap_top&
    blit_params%(6)=bitmap_right&
    blit_params%(7)=bitmap_bottom&
    ' mode 7: OR
    blit_params%(8)=7
    ' add the hole to the level bitmap
    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
    ' clip to the view of the window
    CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
    IF box_left&<view_min_x&
      box_left&=view_min_x&
    ELSE
      IF box_left&>view_max_x&
        box_left&=view_max_x&
      ENDIF
    ENDIF
    IF box_top&<view_min_y&
      box_top&=view_min_y&
    ELSE
      IF box_top&>view_max_y&
        box_top&=view_max_y&
      ENDIF
    ENDIF
    IF box_right&>view_max_x&
      box_right&=view_max_x&
    ENDIF
    IF box_bottom&>view_max_y&
      box_bottom&=view_max_y&
    ENDIF
    bitmap_left&=box_left&+layer_offset_x&
    bitmap_top&=box_top&+layer_offset_y&
    bitmap_right&=box_right&+layer_offset_x&
    bitmap_bottom&=box_bottom&+layer_offset_y&
    window_left&=box_left&+view_origin_x&
    window_top&=box_top&+view_offset_y&
    window_right&=box_right&+view_origin_x&
    window_bottom&=box_bottom&+view_offset_y&
    DEFFILL ,0,0
    PBOX box_left&,box_top&,box_right&,box_bottom&
    IF wireframe_view!
      layer_mfdb%(0)=layer_bitmaps%(1)
    ELSE
      ' all depth levels, deepest first
      FOR loop_index|=depth_levels_used| DOWNTO 1
        ' level used?
        IF layer_used!(loop_index|)
          ' the deepest level is solid black
          IF loop_index|=1
            DEFFILL ,1,1
          ELSE
            ' the fill pattern of this depth level
            DEFFILL ,2,depth_level_colours|(loop_index|)
          ENDIF
          ' fill the box with the level pattern
          PBOX box_left&,box_top&,box_right&,box_bottom&
          layer_mfdb%(0)=layer_bitmaps%(loop_index|)
          blit_params%(0)=bitmap_left&
          blit_params%(1)=bitmap_top&
          blit_params%(2)=bitmap_right&
          blit_params%(3)=bitmap_bottom&
          blit_params%(4)=window_left&
          blit_params%(5)=window_top&
          blit_params%(6)=window_right&
          blit_params%(7)=window_bottom&
          ' mode 1: AND
          blit_params%(8)=1
          ' mask the pattern with the level bitmap
          BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
          layer_mfdb%(0)=layer_bitmaps%(0)
          blit_params%(0)=window_left&
          blit_params%(1)=window_top&
          blit_params%(2)=window_right&
          blit_params%(3)=window_bottom&
          blit_params%(4)=bitmap_left&
          blit_params%(5)=bitmap_top&
          blit_params%(6)=bitmap_right&
          blit_params%(7)=bitmap_bottom&
          ' mode 7: OR
          blit_params%(8)=7
          ' OR the masked level into the screen
          BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
        ENDIF
      NEXT loop_index|
      layer_mfdb%(0)=layer_bitmaps%(0)
    ENDIF
    ' size of the visible window area
    screen_x&=MIN(work_right&,screen_max_x&)
    screen_y&=MIN(work_bottom&,screen_max_y&)
    blit_params%(0)=work_x&
    blit_params%(1)=work_y&
    blit_params%(2)=screen_x&
    blit_params%(3)=screen_y&
    blit_params%(4)=work_x&
    blit_params%(5)=work_y&
    blit_params%(6)=screen_x&
    blit_params%(7)=screen_y&
    ' mode 3: replace
    blit_params%(8)=3
    ' restore the window contents into the screen
    BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
    blit_params%(0)=bitmap_left&
    blit_params%(1)=bitmap_top&
    blit_params%(2)=bitmap_right&
    blit_params%(3)=bitmap_bottom&
    blit_params%(4)=window_left&
    blit_params%(5)=window_top&
    blit_params%(6)=window_right&
    blit_params%(7)=window_bottom&
    ' copy the rebuilt box into the screen
    BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
    CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
    ' back to the visible screen
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    ' top window: is it ours and is the cursor sprite on?
    ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
    IF sprite_shown! AND redraw_x&=window_handle|
      SPRITE tool_sprite$
    ENDIF
    ' changed box as x,y,w,h
    redraw_x&=window_left&
    redraw_y&=window_top&
    redraw_width&=window_right&-window_left&
    redraw_height&=window_bottom&-window_top&
    ' the box lies inside the screen
    IF redraw_x&<screen_width& AND redraw_y&<screen_height&
      ' first rectangle of the window
      ~WIND_GET(window_handle|,11,screen_x&,screen_y&,rect_width&,rect_height&)
      ' copy the overlapping part to the window
      IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
        ' limit the rectangle to the screen
        IF screen_x&+rect_width&>screen_width&
          rect_width&=screen_width&-screen_x&
        ENDIF
        IF screen_y&+rect_height&>screen_height&
          rect_height&=screen_height&-screen_y&
        ENDIF
        DEC rect_width&
        DEC rect_height&
        blit_params%(0)=screen_x&
        blit_params%(1)=screen_y&
        blit_params%(2)=screen_x&+rect_width&
        blit_params%(3)=screen_y&+rect_height&
        blit_params%(4)=screen_x&
        blit_params%(5)=screen_y&
        blit_params%(6)=screen_x&+rect_width&
        blit_params%(7)=screen_y&+rect_height&
        ' mode 3: replace
        blit_params%(8)=3
        ' copy the visible part into the window
        BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
      ENDIF
      ' next rectangle, until the list is empty
      ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WHILE rect_height&<>0 OR rect_width&<>0
        ' this window rectangle overlaps the changed box
        IF RC_INTERSECT(redraw_x&,redraw_y&,redraw_width&,redraw_height&,screen_x&,screen_y&,rect_width&,rect_height&)
          IF screen_x&+rect_width&>screen_width&
            rect_width&=screen_width&-screen_x&
          ENDIF
          IF screen_y&+rect_height&>screen_height&
            rect_height&=screen_height&-screen_y&
          ENDIF
          DEC rect_width&
          DEC rect_height&
          blit_params%(0)=screen_x&
          blit_params%(1)=screen_y&
          blit_params%(2)=screen_x&+rect_width&
          blit_params%(3)=screen_y&+rect_height&
          blit_params%(4)=screen_x&
          blit_params%(5)=screen_y&
          blit_params%(6)=screen_x&+rect_width&
          blit_params%(7)=screen_y&+rect_height&
          ' copy the visible part into the window
          BITBLT work_mfdb%(),screen_mfdb%(),blit_params%()
        ENDIF
        ' next rectangle
        ~WIND_GET(window_handle|,12,screen_x&,screen_y&,rect_width&,rect_height&)
      WEND
    ENDIF
    ' top window: is it ours and is the cursor sprite on?
    ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
    IF sprite_shown! AND redraw_x&=window_handle|
      ' the tool position lies inside the drawing window
      IF area_min_v<=move_compensated_end(second_plane_axis|) AND area_max_v>=move_compensated_end(second_plane_axis|) AND area_min_h<=move_compensated_end(first_plane_axis|) AND area_max_h>=move_compensated_end(first_plane_axis|)
        screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*end_point(first_plane_axis|))-origin_x_pixels&))
        screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*end_point(second_plane_axis|))-origin_y_pixels&))
        ' show the cursor sprite again
        SPRITE tool_sprite$,screen_x&,screen_y&
      ENDIF
    ENDIF
  ELSE
    ' back to the visible screen
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
  ENDIF
  CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
  ~WIND_UPDATE(0)
  ON MENU
RETURN
' One depth pass of the contour cycles: cycle 6 (Ausraeumen, rough-out, rough_out_cycle_active!) or cycle 16
' (Konturfraesen, contour milling, contour_cycle_active!), called with other_contour| = the cycle number,
' contour_tool_radius = the real tool radius, cut_depth = the pass depth, contour_reverse! = the wanted milling
' direction and first_contour_pass! = TRUE on the first pass. For rough-out the drawing area is cleared first.
' Every sub-contour current_contour| = 0..contour_count|-1 (its blocks in
' tool_path_elements$(current_contour|,..)) is then run through run_program_blocks at the pass depth; on the
' first pass of cycle 16 a contour whose direction contour_direction!() does not suit the wanted direction
' (pockets and islands want opposite ones) is reversed first by reverse_tool_path. For rough-out every contour
' is then flood-filled in the off-screen buffer (a full circle: at two points between the circle and the window
' centre; otherwise from the first free pixel, or from the start points of the blocks) and the result is merged
' into the depth-level bitmaps and copied to the window like draw_pilot_drill_hole does it. Side effects:
' first_plane_axis|/second_plane_axis|/infeed_axis|, start_point()/end_point(), corner_point_moved!,
' radius_correction$/compensation_side$/previous_compensation$ (corrections reset to R0), tool_radius.
PROCEDURE simulate_contour_cycle_pass(other_contour|,contour_tool_radius,cut_depth,contour_reverse!,first_contour_pass!)
  LOCAL loop_index|,cut_layer|,screen_x&,screen_y&,arc_end_layer&,bitmap_left&,bitmap_top&,bitmap_right&,bitmap_bottom&,window_left&,window_top&,window_right&,window_bottom&,element_start_x,element_start_y,program_line$,arc_end_layer&,cut_layer|,contour_spare_flag!,contour_has_no_lines!,search_done!,window_handle|,rect_width&,rect_height&,redraw_x&,redraw_y&,redraw_width&,redraw_height&,element_start_x,element_start_y,arc_centre_x,arc_centre_y,window_centre_x,window_centre_y,element_arc_radius,discriminant,direction_x,direction_y,point_distance,work_point_y
  ON MENU
  ~WIND_UPDATE(1)
  window_handle|=W_HAND(#1)
  ' rough-out: clear the drawing buffer and the area of the drawing
  IF rough_out_cycle_active!
    ' draw into the off-screen buffer
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    CLIP 0,0,graphic_width&,graphic_height& OFFSET 0,0
    DEFFILL ,0,0
    PBOX 0,0,graphic_width&,graphic_height&
    ' back to the visible screen
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
    DEFFILL ,1,1
    blit_params%(0)=0
    blit_params%(1)=0
    blit_params%(2)=graphic_width&
    blit_params%(3)=graphic_height&
    blit_params%(4)=0
    blit_params%(5)=0
    blit_params%(6)=graphic_width&
    blit_params%(7)=graphic_height&
    ' mode 3: replace
    blit_params%(8)=3
    layer_mfdb%(0)=graphic_buffer%
    ' copy screen into the level bitmap
    BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
  ENDIF
  ~WIND_UPDATE(0)
  ARRAYFILL contour_area_drawn!(),0
  current_contour|=FALSE
  REPEAT
    ON MENU
    ' first pass of contour milling and the contour does not run the wanted way (pockets and islands opposite)
    IF first_contour_pass! AND other_contour|=16 AND (merged_is_pocket!(current_contour|) AND contour_reverse!<>(contour_direction!(current_contour|)) OR ((NOT merged_is_pocket!(current_contour|)) AND contour_reverse!=(contour_direction!(current_contour|))))
      reverse_tool_path
    ENDIF
    ' back to the plane of the tool axis
    first_plane_axis|=tool_first_axis|
    second_plane_axis|=tool_second_axis|
    infeed_axis|=depth_axis|
    ' start point of the contour
    read_line_target(tool_path_elements$(current_contour|,0))
    ' the pass starts at the contour start at depth cut_depth
    start_point(first_plane_axis|)=end_point(first_plane_axis|)
    start_point(second_plane_axis|)=end_point(second_plane_axis|)
    start_point(infeed_axis|)=cut_depth+datum_shift(infeed_axis|)
    end_point(infeed_axis|)=cut_depth+datum_shift(infeed_axis|)
    programmed_position(infeed_axis|)=end_point(infeed_axis|)
    ' no tool radius compensation for the contour
    corner_point_moved!=FALSE
    radius_correction$=CHR$(48)
    compensation_side$=CHR$(48)
    previous_compensation$=CHR$(48)
    after_line_element!=FALSE
    arc_pending!=FALSE
    ' run the contour blocks from the first one
    run_program_blocks(0,-1)
    ' step back to the previous program block
    skip_to_previous_block(current_block&)
    ' close an open line or end marker
    IF after_line_element!
      ' simulate the move from start_point() to end_point()
      queue_simulated_move(current_block&,"-",-1)
    ELSE
      IF arc_pending!
        ' simulate the move from start_point() to end_point()
        queue_simulated_move(current_block&,"-",-1)
      ENDIF
    ENDIF
    INC current_contour|
    ' all contours run or the run stopped
  UNTIL current_contour|>=contour_count| OR run_aborted! OR stop_requested!
  ~WIND_UPDATE(1)
  IF (NOT run_aborted!) AND (NOT stop_requested!) AND rough_out_cycle_active!
    CLIP view_left&,view_top& TO view_right&,view_bottom& OFFSET work_offset_x&,work_offset_y&
    ' draw into the off-screen buffer
    ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
    DEFFILL ,0,0
    PBOX work_min_x&,work_min_y&,work_max_x&,work_max_y&
    ' back to the visible screen
    ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
    DEFFILL ,1,1
    bitmap_left&=work_min_x&+layer_offset_x&
    bitmap_top&=work_min_y&+layer_offset_y&
    bitmap_right&=work_max_x&+layer_offset_x&
    bitmap_bottom&=work_max_y&+layer_offset_y&
    window_left&=work_min_x&+work_offset_x&
    window_top&=work_min_y&+work_offset_y&
    window_right&=work_max_x&+work_offset_x&
    window_bottom&=work_max_y&+work_offset_y&
    layer_mfdb%(0)=graphic_buffer%
    blit_params%(0)=bitmap_left&
    blit_params%(1)=bitmap_top&
    blit_params%(2)=bitmap_right&
    blit_params%(3)=bitmap_bottom&
    blit_params%(4)=window_left&
    blit_params%(5)=window_top&
    blit_params%(6)=window_right&
    blit_params%(7)=window_bottom&
    ' mode 3: replace
    blit_params%(8)=3
    ' copy the level bitmap into the screen
    BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
    ' radius for keeping away from the drawn contour
    tool_radius=2/view_scale+contour_tool_radius
    current_contour|=FALSE
    REPEAT
      ON MENU
      ' this contour is to be filled in this way
      IF merged_is_pocket!(current_contour|)
        path_line_index&=0
        arc_end_layer&=tool_path_line_count&(current_contour|)-1
        contour_has_no_lines!=TRUE
        REPEAT
          INC path_line_index&
          IF LEFT$(tool_path_elements$(current_contour|,path_line_index&))="L"
            contour_has_no_lines!=FALSE
          ENDIF
        UNTIL path_line_index&=arc_end_layer& OR contour_has_no_lines!=FALSE
        path_line_index&=0
        ' full circle: fill on both sides between the circle and the window centre
        IF contour_has_no_lines! AND arc_end_layer&=2
          ' back to the plane of the tool axis
          first_plane_axis|=tool_first_axis|
          second_plane_axis|=tool_second_axis|
          infeed_axis|=depth_axis|
          ' evaluate the CC block
          offset_element_at_corner(-1)
          element_start_x=compensated_start(first_plane_axis|)
          element_start_y=compensated_start(second_plane_axis|)
          ' read the centre of the circle
          read_circle_centre(tool_path_elements$(current_contour|,1))
          arc_centre_x=circle_centre(first_plane_axis|)
          arc_centre_y=circle_centre(second_plane_axis|)
          ' centre of the drawing window
          window_centre_x=(area_max_h-area_min_h)/2+area_min_h
          window_centre_y=(area_max_v-area_min_v)/2+area_min_v
          direction_x=window_centre_x-arc_centre_x
          direction_y=window_centre_y-arc_centre_y
          ' distance from the circle centre to the window centre
          discriminant=SQR(direction_x*direction_x+direction_y*direction_y)
          ' radius of the fill point: circle radius less the keep-away radius
          element_arc_radius=SQR((element_start_x-arc_centre_x)*(element_start_x-arc_centre_x)+(element_start_y-arc_centre_y)*(element_start_y-arc_centre_y))-tool_radius-2/view_scale
          IF discriminant=0
            point_distance=element_start_x
            work_point_y=element_start_y
          ELSE
            point_distance=element_arc_radius/discriminant*direction_x+arc_centre_x
            work_point_y=element_arc_radius/discriminant*direction_y+arc_centre_y
          ENDIF
          ' the centre lies in the window: keep the fill point inside the window
          IF arc_centre_x>=view_min_h AND arc_centre_x<=view_max_h AND arc_centre_y>=view_min_v AND arc_centre_y<=view_max_v
            IF point_distance<=view_min_h
              point_distance=2/view_scale+view_min_h
            ELSE
              IF point_distance>=view_max_h
                point_distance=view_max_h-2/view_scale
              ENDIF
            ENDIF
            IF work_point_y<=view_min_v
              work_point_y=2/view_scale+view_min_v
            ELSE
              IF work_point_y>=view_max_v
                work_point_y=view_max_v-2/view_scale
              ENDIF
            ENDIF
          ENDIF
          ' fill point in pixels
          screen_x&=ROUND(point_distance*view_scale)-origin_x_pixels&
          screen_y&=-ROUND(work_point_y*view_scale)-origin_y_pixels&
          ' flood-fill from there
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          FILL screen_x&,screen_y&
          ' the point on the opposite side
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          IF discriminant=0
            point_distance=-element_start_x
            work_point_y=-element_start_y
          ELSE
            point_distance=-element_arc_radius/discriminant*direction_x+arc_centre_x
            work_point_y=-element_arc_radius/discriminant*direction_y+arc_centre_y
          ENDIF
          IF arc_centre_x>=view_min_h AND arc_centre_x<=view_max_h AND arc_centre_y>=view_min_v AND arc_centre_y<=view_max_v
            IF point_distance<=view_min_h
              point_distance=2/view_scale+view_min_h
            ELSE
              IF point_distance>=view_max_h
                point_distance=view_max_h-2/view_scale
              ENDIF
            ENDIF
            IF work_point_y<=view_min_v
              work_point_y=2/view_scale+view_min_v
            ELSE
              IF work_point_y>=view_max_v
                work_point_y=view_max_v-2/view_scale
              ENDIF
            ENDIF
          ENDIF
          screen_x&=ROUND(point_distance*view_scale)-origin_x_pixels&
          screen_y&=-ROUND(work_point_y*view_scale)-origin_y_pixels&
          ' draw into the off-screen buffer
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          FILL screen_x&,screen_y&
          ' back to the visible screen
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
        ELSE
          ' contour not yet drawn and not a pure circle
          IF (NOT contour_area_drawn!(current_contour|)) AND (NOT contour_has_no_lines!)
            screen_x&=work_min_x&
            screen_y&=work_min_y&
            search_done!=FALSE
            ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
            ' scan the window from the top left for the first free pixel
            REPEAT
              INC screen_y&
              REPEAT
                INC screen_x&
                ' free pixel
                ' the off-screen buffer stays the logical screen for the whole scan, so POINT tests the same picture that FILL
                ' paints
                IF POINT(screen_x&,screen_y&)=0
                  FILL screen_x&,screen_y&
                  search_done!=TRUE
                ENDIF
              UNTIL search_done!
            UNTIL search_done!
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          ELSE
            in_subprogram_call!=TRUE
            ' draw into the off-screen buffer
            ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
            REPEAT
              IF LEFT$(tool_path_elements$(current_contour|,path_line_index&),2)<>"CC"
                first_plane_axis|=tool_first_axis|
                second_plane_axis|=tool_second_axis|
                infeed_axis|=depth_axis|
                offset_element_at_corner(-1)
                screen_x&=ROUND(view_scale*compensated_start(first_plane_axis|))-origin_x_pixels&
                screen_y&=-ROUND(view_scale*compensated_start(second_plane_axis|))-origin_y_pixels&
                IF POINT(screen_x&,screen_y&)=0
                  check_fill_point_in_path(point_inside!)
                  IF point_inside!
                    FILL screen_x&,screen_y&
                  ENDIF
                ENDIF
              ENDIF
              INC path_line_index&
            UNTIL path_line_index&=arc_end_layer& OR run_aborted! OR stop_requested!
            ' back to the visible screen
            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
            in_subprogram_call!=FALSE
          ENDIF
        ENDIF
      ENDIF
      INC current_contour|
    UNTIL current_contour|>=contour_count| OR run_aborted! OR stop_requested!
    IF (NOT run_aborted!) AND (NOT stop_requested!)
      IF wireframe_view!
        layer_mfdb%(0)=layer_bitmaps%(1)
      ELSE
        IF cut_depth<=blank_bottom
          cut_layer|=1
        ELSE
          loop_index|=FALSE
          REPEAT
            INC loop_index|
          UNTIL loop_index|=layer_depth_count| OR (cut_depth>depth_level_table(loop_index|) AND cut_depth<=depth_level_table(SUCC(loop_index|)))
          cut_layer|=SUCC(loop_index|)
        ENDIF
        layer_mfdb%(0)=layer_bitmaps%(cut_layer|)
      ENDIF
      blit_params%(0)=window_left&
      blit_params%(1)=window_top&
      blit_params%(2)=window_right&
      blit_params%(3)=window_bottom&
      blit_params%(4)=bitmap_left&
      blit_params%(5)=bitmap_top&
      blit_params%(6)=bitmap_right&
      blit_params%(7)=bitmap_bottom&
      blit_params%(8)=7
      BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
      ' draw into the off-screen buffer
      ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
      CLIP view_clip_left&,view_clip_top& TO view_clip_right&,view_clip_bottom& OFFSET view_origin_x&,view_offset_y&
      IF box_left&<view_min_x&
        box_left&=view_min_x&
      ELSE
        IF box_left&>view_max_x&
          box_left&=view_max_x&
        ENDIF
      ENDIF
      IF box_top&<work_min_y&
        box_top&=work_min_y&
      ELSE
        IF box_top&>view_max_y&
          box_top&=view_max_y&
        ENDIF
      ENDIF
      IF box_right&>view_max_x&
        box_right&=view_max_x&
      ENDIF
      IF box_bottom&>view_max_y&
        box_bottom&=view_max_y&
      ENDIF
      bitmap_left&=SUCC(work_min_x&)+layer_offset_x&
      bitmap_top&=work_min_y&+layer_offset_y&
      bitmap_right&=PRED(work_max_x&)+layer_offset_x&
      bitmap_bottom&=PRED(work_max_y&+layer_offset_y&)
      window_left&=SUCC(work_min_x&)+view_origin_x&
      window_top&=work_min_y&+view_offset_y&
      window_right&=PRED(work_max_x&)+view_origin_x&
      window_bottom&=PRED(work_max_y&+view_offset_y&)
      DEFFILL ,0,0
      PBOX work_min_x&,work_min_y&,work_max_x&,work_max_y&
      IF wireframe_view!
        layer_mfdb%(0)=layer_bitmaps%(1)
      ELSE
        FOR loop_index|=depth_levels_used| DOWNTO 1
          IF layer_used!(loop_index|)
            IF loop_index|=1
              DEFFILL ,1,1
            ELSE
              DEFFILL ,2,depth_level_colours|(loop_index|)
            ENDIF
            PBOX work_min_x&,work_min_y&,work_max_x&,work_max_y&
            layer_mfdb%(0)=layer_bitmaps%(loop_index|)
            blit_params%(0)=bitmap_left&
            blit_params%(1)=bitmap_top&
            blit_params%(2)=bitmap_right&
            blit_params%(3)=bitmap_bottom&
            blit_params%(4)=window_left&
            blit_params%(5)=window_top&
            blit_params%(6)=window_right&
            blit_params%(7)=window_bottom&
            blit_params%(8)=1
            BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
            layer_mfdb%(0)=layer_bitmaps%(0)
            blit_params%(0)=window_left&
            blit_params%(1)=window_top&
            blit_params%(2)=window_right&
            blit_params%(3)=window_bottom&
            blit_params%(4)=bitmap_left&
            blit_params%(5)=bitmap_top&
            blit_params%(6)=bitmap_right&
            blit_params%(7)=bitmap_bottom&
            blit_params%(8)=7
            BITBLT work_mfdb%(),layer_mfdb%(),blit_params%()
          ENDIF
        NEXT loop_index|
        layer_mfdb%(0)=layer_bitmaps%(0)
      ENDIF
      screen_x&=MIN(work_right&,screen_max_x&)
      screen_y&=MIN(work_bottom&,screen_max_y&)
      blit_params%(0)=work_x&
      blit_params%(1)=work_y&
      blit_params%(2)=screen_x&
      blit_params%(3)=screen_y&
      blit_params%(4)=work_x&
      blit_params%(5)=work_y&
      blit_params%(6)=screen_x&
      blit_params%(7)=screen_y&
      blit_params%(8)=3
      BITBLT screen_mfdb%(),work_mfdb%(),blit_params%()
      blit_params%(0)=bitmap_left&
      blit_params%(1)=bitmap_top&
      blit_params%(2)=bitmap_right&
      blit_params%(3)=bitmap_bottom&
      blit_params%(4)=window_left&
      blit_params%(5)=window_top&
      blit_params%(6)=window_right&
      blit_params%(7)=window_bottom&
      BITBLT layer_mfdb%(),work_mfdb%(),blit_params%()
      CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
      INC window_top&
      INC window_bottom&
      ' back to the visible screen
      ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
      ' hide the cursor sprite while the window is redrawn
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        SPRITE tool_sprite$
      ENDIF
      redraw_x&=window_left&
      redraw_y&=window_top&
      redraw_width&=window_right&-window_left&
      redraw_height&=window_bottom&-window_top&
      ' redraw the changed area of the window
      blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      ' show the cursor sprite again
      ~WIND_GET(window_handle|,10,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
      IF sprite_shown! AND redraw_x&=window_handle|
        IF area_min_v<=move_compensated_end(second_plane_axis|) AND area_max_v>=move_compensated_end(second_plane_axis|) AND area_min_h<=move_compensated_end(first_plane_axis|) AND area_max_h>=move_compensated_end(first_plane_axis|)
          screen_x&=MIN(screen_max_x&,ADD(view_origin_x&,ROUND(view_scale*end_point(first_plane_axis|))-origin_x_pixels&))
          screen_y&=MIN(screen_max_y&,ADD(view_offset_y&,-ROUND(view_scale*end_point(second_plane_axis|))-origin_y_pixels&))
          ' show the cursor sprite again
          SPRITE tool_sprite$,screen_x&,screen_y&
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
  ' release the screen
  ~WIND_UPDATE(0)
RETURN
' Evaluates an LP block (Linie polar, polar line) in program_line$: the end point from polar radius PR (column
' 9) and polar angle PA (column 22) about the pole, the last CC block before the current block current_block&.
' With an incremental angle (IPA, "I" in column 18) the angle of the start point about the pole is added. The
' result in end_point() is then mirrored (mirror_x!..mirror_z!), rotated (rotation_active!, rotation_angle) and
' datum-shifted (datum_shift(), datum_shift_change()) as the active cycles 7, 8 and 10 ask for, and the end
' point in the rotated axes is kept in rotated_position(). Errors set run_aborted! and the error entry
' error_blocks&(0)/error_messages$(0).
PROCEDURE interpret_polar_line(program_line$)
  LOCAL polar_angle,pole_start_angle,polar_radius,element_arc_radius,point_distance,work_point_y,direction_x,direction_y,rect_width&,angle_offset,rotate_length,axis_determinant,absolute_polar_angle!,alert_button|
  ' start at the current block
  rect_width&=current_block&
  ' step back to the previous program block
  skip_to_previous_block(rect_width&)
  ' the current block is not the CC block itself: look back for the last CC block that is not a comment
  IF LEFT$(program_lines$(rect_width&),2)<>"CC"
    REPEAT
      DEC rect_width&
    UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
    ' found one
    IF rect_width&>0
      ' it gives the pole
      set_plane_from_centre(program_lines$(rect_width&))
    ENDIF
  ENDIF
  ' polar radius PR
  polar_radius=@read_number_or_parameter(program_line$,9)
  ' polar angle PA
  polar_angle=@read_unscaled_number(program_line$,22)
  ' into radians
  MUL polar_angle,PI/180
  ' read radius correction, feed and M function of the block
  read_radius_correction(program_line$)
  ' incremental angle IPA
  IF MID$(program_line$,18,1)="I"
    absolute_polar_angle!=FALSE
    ' start point relative to the pole
    direction_x=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
    direction_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
    ' distance of the start point from the pole
    element_arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
    IF element_arc_radius=0
      ' the start point of the line and the pole must differ
      ALERT 3,"Linienanfangspunkt und Pol|mÅssen verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="LINIENANFANGSPUNKT UND POL MöSSEN VERSCHIEDEN SEIN!"
      pole_start_angle=0
    ELSE
      pole_start_angle=direction_x/element_arc_radius
      ' arc cosine: the angle of the vector
      pole_start_angle=@clamped_arc_cosine(pole_start_angle)
      ' below the pole: 2*PI minus the angle
      IF direction_y<0
        ' below the axis: 2*PI minus the angle
        pole_start_angle=two_pi-pole_start_angle
      ENDIF
    ENDIF
    ' add the angle of the start point
    polar_angle=polar_angle+pole_start_angle
  ELSE
    absolute_polar_angle!=TRUE
  ENDIF
  ' end point relative to the pole, rounded to 6 decimals
  end_point(tool_first_axis|)=ROUND(COS(polar_angle)*polar_radius*1000000)/1000000
  end_point(tool_second_axis|)=ROUND(SIN(polar_angle)*polar_radius*1000000)/1000000
  ' the infeed axis keeps its coordinate
  end_point(depth_axis|)=start_point(depth_axis|)
  ' keep the programmed end point before mirroring
  block_input_values(1)=end_point(1)
  block_input_values(2)=end_point(2)
  block_input_values(3)=end_point(3)
  ' X is mirrored before the rotation
  IF mirror_x! AND (NOT mirror_x_after_rotation!)
    ' mirror X
    end_point(1)=-end_point(1)
  ENDIF
  ' Y is mirrored before the rotation
  IF mirror_y! AND (NOT mirror_y_after_rotation!)
    ' mirror Y
    end_point(2)=-end_point(2)
  ENDIF
  ' Z is mirrored before the rotation
  IF mirror_z! AND (NOT mirror_z_after_rotation!)
    ' mirror Z
    end_point(3)=-end_point(3)
  ENDIF
  ' a rotation is active and the angle was absolute: rotate the point as well
  IF rotation_active! AND absolute_polar_angle!
    point_distance=end_point(tool_first_axis|)
    work_point_y=end_point(tool_second_axis|)
    IF point_distance<>0 OR work_point_y<>0
      ' distance of the point from the origin
      rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
      ' cosine of its angle
      angle_offset=point_distance/rotate_length
      ' arc cosine: the angle of the vector
      angle_offset=@clamped_arc_cosine(angle_offset)
      IF work_point_y<0
        ' below the axis: 2*PI minus the angle
        angle_offset=two_pi-angle_offset
      ENDIF
      ' add the rotation angle
      angle_offset=angle_offset+rotation_angle
      ' rotated point
      point_distance=COS(angle_offset)*rotate_length
      work_point_y=SIN(angle_offset)*rotate_length
      end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
      end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
    ENDIF
  ENDIF
  ' X is mirrored after the rotation
  IF mirror_x! AND mirror_x_after_rotation!
    ' mirror X
    end_point(1)=-end_point(1)
  ENDIF
  ' Y is mirrored after the rotation
  IF mirror_y! AND mirror_y_after_rotation!
    ' mirror Y
    end_point(2)=-end_point(2)
  ENDIF
  ' Z is mirrored after the rotation
  IF mirror_z! AND mirror_z_after_rotation!
    ' mirror Z
    end_point(3)=-end_point(3)
  ENDIF
  ' end point on the pole, without the datum shift
  ADD end_point(tool_first_axis|),circle_centre(tool_first_axis|)-datum_shift(tool_first_axis|)
  ' the same for the second axis
  ADD end_point(tool_second_axis|),circle_centre(tool_second_axis|)-datum_shift(tool_second_axis|)
  ' determinant of the two rotated axis directions
  axis_determinant=rotated_first_axis(tool_first_axis|)*rotated_second_axis(tool_second_axis|)-rotated_first_axis(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
  ' the axes are parallel: no inverse
  IF axis_determinant=0
    ' an error occurred while mirroring the line
    ALERT 3,"Es ist ein Fehler|beim Spiegeln der Linie|aufgetreten!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="LINIE KANN NICHT GESPIEGELT WERDEN!"
  ELSE
    ' end point in the rotated axes, first coordinate
    rotated_position(tool_first_axis|)=(rotated_second_axis(tool_second_axis|)*end_point(tool_first_axis|)-rotated_second_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
    ' second coordinate
    rotated_position(tool_second_axis|)=(-rotated_first_axis(tool_second_axis|)*end_point(tool_first_axis|)+rotated_first_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
    ' keep the transformed end point (base for incremental input)
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    ' apply the datum shift
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    ' less the shift change still to be moved
    SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
    SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
    datum_shift_change(1)=0
    datum_shift_change(2)=0
    datum_shift_change(3)=0
  ENDIF
RETURN
' Evaluates a CP block (Kreis polar, polar arc) in program_line$: the end point from the polar angle (column 9)
' about the pole (the last CC block), the radius being the distance from the pole to the start point;
' arc_direction$ gets the direction DR (column 33). With IPA ("I" in column 5) the angle is added to the angle
' of the start point. The end point is then mirrored, rotated and datum-shifted like in interpret_polar_line.
PROCEDURE interpret_polar_arc(program_line$)
  LOCAL polar_radius,polar_angle,point_distance,work_point_y,arc_start_angle,arc_end_angle,rect_width&,angle_offset,rotate_length,axis_determinant,absolute_polar_angle!,alert_button|
  ' start at the current block
  rect_width&=current_block&
  ' step back to the previous program block
  skip_to_previous_block(rect_width&)
  ' the current block is not the CC block itself: look back for the last CC block that is not a comment
  IF LEFT$(program_lines$(rect_width&),2)<>"CC"
    REPEAT
      DEC rect_width&
    UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
    IF rect_width&>0
      ' it gives the pole
      set_plane_from_centre(program_lines$(rect_width&))
    ENDIF
  ENDIF
  ' polar angle PA
  polar_angle=@read_unscaled_number(program_line$,9)
  ' read radius correction, feed and M function of the block
  read_radius_correction(program_line$)
  ' direction DR
  arc_direction$=@read_arc_direction$(program_line$,33)
  ' start point relative to the pole
  point_distance=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
  work_point_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
  ' the arc radius is the distance of the start point from the pole
  polar_radius=SQR(point_distance*point_distance+work_point_y*work_point_y)
  ' angle in radians
  arc_end_angle=PI*polar_angle/180
  ' incremental angle IPA
  IF MID$(program_line$,5,1)="I"
    absolute_polar_angle!=FALSE
    IF polar_radius=0
      ' the start point of the arc and the pole must differ
      ALERT 3,"Kreisanfangspunkt und Pol|mÅssen verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="KREISANFANGSPUNKT UND POL MöSSEN VERSCHIEDEN SEIN!"
      arc_start_angle=0
    ELSE
      arc_start_angle=point_distance/polar_radius
      ' arc cosine: the angle of the vector
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF work_point_y<0
        ' below the axis: 2*PI minus the angle
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
    ENDIF
    ' add the angle of the start point
    arc_end_angle=arc_end_angle+arc_start_angle
  ELSE
    absolute_polar_angle!=TRUE
  ENDIF
  ' end point relative to the pole, rounded to 6 decimals
  end_point(tool_first_axis|)=ROUND(COS(arc_end_angle)*polar_radius*1000000)/1000000
  end_point(tool_second_axis|)=ROUND(SIN(arc_end_angle)*polar_radius*1000000)/1000000
  ' the infeed axis keeps its coordinate
  end_point(depth_axis|)=start_point(depth_axis|)
  ' keep the programmed end point before mirroring
  block_input_values(1)=end_point(1)
  block_input_values(2)=end_point(2)
  block_input_values(3)=end_point(3)
  ' X is mirrored before the rotation
  IF mirror_x! AND (NOT mirror_x_after_rotation!)
    ' mirror X
    end_point(1)=-end_point(1)
  ENDIF
  ' Y is mirrored before the rotation
  IF mirror_y! AND (NOT mirror_y_after_rotation!)
    ' mirror Y
    end_point(2)=-end_point(2)
  ENDIF
  ' Z is mirrored before the rotation
  IF mirror_z! AND (NOT mirror_z_after_rotation!)
    ' mirror Z
    end_point(3)=-end_point(3)
  ENDIF
  ' a rotation is active and the angle was absolute: rotate the point as well
  IF rotation_active! AND absolute_polar_angle!
    point_distance=end_point(tool_first_axis|)
    work_point_y=end_point(tool_second_axis|)
    IF point_distance<>0 OR work_point_y<>0
      ' distance of the point from the origin
      rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
      ' cosine of its angle
      angle_offset=point_distance/rotate_length
      ' arc cosine: the angle of the vector
      angle_offset=@clamped_arc_cosine(angle_offset)
      IF work_point_y<0
        ' below the axis: 2*PI minus the angle
        angle_offset=two_pi-angle_offset
      ENDIF
      ' add the rotation angle
      angle_offset=angle_offset+rotation_angle
      ' rotated point
      point_distance=COS(angle_offset)*rotate_length
      work_point_y=SIN(angle_offset)*rotate_length
      end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
      end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
    ENDIF
  ENDIF
  ' X is mirrored after the rotation
  IF mirror_x! AND mirror_x_after_rotation!
    ' mirror X
    end_point(1)=-end_point(1)
  ENDIF
  ' Y is mirrored after the rotation
  IF mirror_y! AND mirror_y_after_rotation!
    ' mirror Y
    end_point(2)=-end_point(2)
  ENDIF
  ' Z is mirrored after the rotation
  IF mirror_z! AND mirror_z_after_rotation!
    ' mirror Z
    end_point(3)=-end_point(3)
  ENDIF
  ' relative to the pole, the datum shift removed
  ADD end_point(tool_first_axis|),circle_centre(tool_first_axis|)-datum_shift(tool_first_axis|)
  ' the same for the second axis
  ADD end_point(tool_second_axis|),circle_centre(tool_second_axis|)-datum_shift(tool_second_axis|)
  ' determinant of the two rotated axis directions
  axis_determinant=rotated_first_axis(tool_first_axis|)*rotated_second_axis(tool_second_axis|)-rotated_first_axis(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
  ' the axes are parallel: no inverse
  IF axis_determinant=0
    ' an error occurred while mirroring the line
    ALERT 3,"Es ist ein Fehler|beim Spiegeln der Linie|aufgetreten!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="LINIE KANN NICHT GESPIEGELT WERDEN!"
  ELSE
    ' end point in the rotated axes, first coordinate
    rotated_position(tool_first_axis|)=(rotated_second_axis(tool_second_axis|)*end_point(tool_first_axis|)-rotated_second_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
    ' second coordinate
    rotated_position(tool_second_axis|)=(-rotated_first_axis(tool_second_axis|)*end_point(tool_first_axis|)+rotated_first_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
    ' keep the transformed end point (base for incremental input)
    programmed_position(1)=end_point(1)
    programmed_position(2)=end_point(2)
    programmed_position(3)=end_point(3)
    ' apply the datum shift
    ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
    ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
    ' less the shift change still to be moved
    SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
    SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
    ADD end_point(depth_axis|),datum_shift(depth_axis|)
    datum_shift_change(1)=0
    datum_shift_change(2)=0
    datum_shift_change(3)=0
  ENDIF
RETURN
' Evaluates a CP block with a linear axis (Schraubenlinie, helix) in program_line$: the end point in the plane
' as in interpret_polar_arc, plus the infeed of the tool axis (column 19 must name the reference axis
' tool_axis|, the value at column 21, or a Q parameter Qn there, sign in column 20, incremental with "I" in
' column 18, scaled by scaling_factor when scaling_active! is set). The end point is then mirrored, rotated and
' datum-shifted; a helix whose infeed change is smaller than 0.001 is refused.
PROCEDURE interpret_polar_helix(program_line$)
  LOCAL polar_radius,polar_angle,point_distance,work_point_y,arc_start_angle,arc_end_angle,rect_width&,angle_offset,rotate_length,axis_determinant,absolute_polar_angle!,alert_button|
  ' start at the current block
  rect_width&=current_block&
  ' step back to the previous program block
  skip_to_previous_block(rect_width&)
  ' the current block is not the CC block itself: look back for the last CC block that is not a comment
  IF LEFT$(program_lines$(rect_width&),2)<>"CC"
    REPEAT
      DEC rect_width&
    UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
    IF rect_width&>0
      ' it gives the pole
      set_plane_from_centre(program_lines$(rect_width&))
    ENDIF
  ENDIF
  ' polar angle PA
  polar_angle=@read_unscaled_number(program_line$,9)
  ' read radius correction, feed and M function of the block
  read_radius_correction(program_line$)
  ' direction DR
  arc_direction$=@read_arc_direction$(program_line$,33)
  ' start point relative to the pole
  point_distance=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
  work_point_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
  ' the arc radius is the distance of the start point from the pole
  polar_radius=SQR(point_distance*point_distance+work_point_y*work_point_y)
  ' angle in radians
  arc_end_angle=PI*polar_angle/180
  ' incremental angle IPA
  IF MID$(program_line$,5,1)="I"
    absolute_polar_angle!=FALSE
    IF polar_radius=0
      ' the start point of the arc and the pole must differ
      ALERT 3,"Kreisanfangspunkt und Pol|mÅssen verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="KREISANFANGSPUNKT UND POL MöSSEN VERSCHIEDEN SEIN!"
      arc_start_angle=0
    ELSE
      arc_start_angle=point_distance/polar_radius
      ' arc cosine: the angle of the vector
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF work_point_y<0
        ' below the axis: 2*PI minus the angle
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
    ENDIF
    arc_end_angle=arc_end_angle+arc_start_angle
  ELSE
    absolute_polar_angle!=TRUE
  ENDIF
  ' end point relative to the pole, rounded to 6 decimals
  end_point(tool_first_axis|)=ROUND(COS(arc_end_angle)*polar_radius*1000000)/1000000
  end_point(tool_second_axis|)=ROUND(SIN(arc_end_angle)*polar_radius*1000000)/1000000
  ' the linear axis of the helix
  corner_text_h$=MID$(program_line$,19,1)
  ' it must be the tool axis
  IF (corner_text_h$<>"X") AND tool_axis|=1 OR ((corner_text_h$<>"Y") AND tool_axis|=2) OR ((corner_text_h$<>"Z") AND tool_axis|=3)
    ' tool axis X
    IF tool_axis|=1
      ' a helix needs the reference axis to be entered
      ALERT 3,"Bei der Schraubenlinie|muû die Bezugsachse >X<|eingegeben werden!",1,"Abbruch",alert_button|
    ELSE
      ' tool axis Y
      IF tool_axis|=2
        ' a helix needs the reference axis to be entered
        ALERT 3,"Bei der Schraubenlinie|muû die Bezugsachse >Y<|eingegeben werden!",1,"Abbruch",alert_button|
      ELSE
        ' a helix needs the reference axis to be entered
        ALERT 3,"Bei der Schraubenlinie|muû die Bezugsachse >Z<|eingegeben werden!",1,"Abbruch",alert_button|
      ENDIF
    ENDIF
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="BEI SCHRAUBENLINIE MUSS BEZUGSACHSE EINGEGEBEN WERDEN!"
  ELSE
    ' the infeed is a Q parameter
    IF MID$(program_line$,21,1)="Q"
      ' number of the Q parameter
      parameter_number&=VAL(MID$(program_line$,22,3))
      ' defined?
      IF q_parameter_defined!(parameter_number&)
        ' its value
        parsed_value=q_parameters(parameter_number&)
      ELSE
        parsed_value=1
        third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
        ' the Q parameter has not been defined yet
        ALERT 3,third_block_text$,1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
      ENDIF
    ELSE
      ' the infeed value
      parsed_value=VAL(MID$(program_line$,21,11))
    ENDIF
    ' negative sign
    IF MID$(program_line$,20,1)="-"
      parsed_value=-parsed_value
    ENDIF
    ' scaling active (cycle 11)
    IF scaling_active!
      MUL parsed_value,scaling_factor
    ENDIF
    ' incremental infeed
    IF MID$(program_line$,18,1)="I"
      parsed_value=parsed_value+programmed_position(depth_axis|)
    ENDIF
    ' the new coordinate of the tool axis
    end_point(depth_axis|)=parsed_value
    ' keep the programmed end point before mirroring
    block_input_values(1)=end_point(1)
    block_input_values(2)=end_point(2)
    block_input_values(3)=end_point(3)
    ' X is mirrored before the rotation
    IF mirror_x! AND (NOT mirror_x_after_rotation!)
      ' mirror X
      end_point(1)=-end_point(1)
    ENDIF
    ' Y is mirrored before the rotation
    IF mirror_y! AND (NOT mirror_y_after_rotation!)
      ' mirror Y
      end_point(2)=-end_point(2)
    ENDIF
    ' Z is mirrored before the rotation
    IF mirror_z! AND (NOT mirror_z_after_rotation!)
      ' mirror Z
      end_point(3)=-end_point(3)
    ENDIF
    ' a rotation is active and the angle was absolute: rotate the point as well
    IF rotation_active! AND absolute_polar_angle!
      point_distance=end_point(tool_first_axis|)
      work_point_y=end_point(tool_second_axis|)
      IF point_distance<>0 OR work_point_y<>0
        ' distance of the point from the origin
        rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
        ' cosine of its angle
        angle_offset=point_distance/rotate_length
        ' arc cosine: the angle of the vector
        angle_offset=@clamped_arc_cosine(angle_offset)
        IF work_point_y<0
          ' below the axis: 2*PI minus the angle
          angle_offset=two_pi-angle_offset
        ENDIF
        ' add the rotation angle
        angle_offset=angle_offset+rotation_angle
        ' rotated point
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
        end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
      ENDIF
    ENDIF
    ' X is mirrored after the rotation
    IF mirror_x! AND mirror_x_after_rotation!
      ' mirror X
      end_point(1)=-end_point(1)
    ENDIF
    ' Y is mirrored after the rotation
    IF mirror_y! AND mirror_y_after_rotation!
      ' mirror Y
      end_point(2)=-end_point(2)
    ENDIF
    ' Z is mirrored after the rotation
    IF mirror_z! AND mirror_z_after_rotation!
      ' mirror Z
      end_point(3)=-end_point(3)
    ENDIF
    ' relative to the pole, the datum shift removed
    ADD end_point(tool_first_axis|),circle_centre(tool_first_axis|)-datum_shift(tool_first_axis|)
    ' the same for the second axis
    ADD end_point(tool_second_axis|),circle_centre(tool_second_axis|)-datum_shift(tool_second_axis|)
    ' determinant of the two rotated axis directions
    axis_determinant=rotated_first_axis(tool_first_axis|)*rotated_second_axis(tool_second_axis|)-rotated_first_axis(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
    ' the axes are parallel: no inverse
    IF axis_determinant=0
      ' an error occurred while mirroring the line
      ALERT 3,"Es ist ein Fehler|beim Spiegeln der Linie|aufgetreten!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="LINIE KANN NICHT GESPIEGELT WERDEN!"
    ELSE
      ' end point in the rotated axes, first coordinate
      rotated_position(tool_first_axis|)=(rotated_second_axis(tool_second_axis|)*end_point(tool_first_axis|)-rotated_second_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
      ' second coordinate
      rotated_position(tool_second_axis|)=(-rotated_first_axis(tool_second_axis|)*end_point(tool_first_axis|)+rotated_first_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
      ' keep the transformed end point (base for incremental input)
      programmed_position(1)=end_point(1)
      programmed_position(2)=end_point(2)
      programmed_position(3)=end_point(3)
      ' apply the datum shift
      ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
      ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
      ' less the shift change still to be moved
      SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
      SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
      ADD end_point(depth_axis|),datum_shift(depth_axis|)
      datum_shift_change(1)=0
      datum_shift_change(2)=0
      datum_shift_change(3)=0
    ENDIF
  ENDIF
  IF .001>ABS(end_point(depth_axis|)-start_point(depth_axis|))
    ' the change of the reference axis coordinate must not be zero
    ALERT 3,"Die énderung der Bezugs-|achsenkoordinate muû|ungleich Null sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="éNDERUNG DER BEZUGSKOORDINATE IST GLEICH NULL!"
  ENDIF
RETURN
' Evaluates a CT block (tangentialer Kreis, tangential arc) in program_line$: looks back for the previous
' contour block (CC, C, L with coordinates, CT or CR), which must contain the same plane axes as this block,
' reads the end point and the start tangent start_tangent() of the previous element (compute_tangent_vector) and
' computes the arc centre circle_centre() so that the arc continues the contour tangentially; arc_direction$
' gets the resulting direction DR+ or DR-.
PROCEDURE interpret_tangential_arc(program_line$)
  LOCAL element_arc_radius,radius_dot_product,normal_direction_x,normal_direction_y,line_slope,line_intercept,alert_button|,search_block&,x_axis_flag!,y_axis_flag!,z_axis_flag!,scan_index&,field_text_length|
  ' search back from the current block
  search_block&=current_block&
  ' for the previous contour block
  REPEAT
    ' step back to the previous program block
    skip_to_previous_block(search_block&)
    edit_work_text$=LEFT$(program_lines$(search_block&),2)
    ' CC, C, L with coordinates, CT or CR
  UNTIL (edit_work_text$="CC") OR (edit_work_text$="C ") OR ((edit_work_text$="L ") AND (MID$(program_lines$(search_block&),7,1)<>"A") AND LEN(program_lines$(search_block&))>20) OR (edit_work_text$="CT") OR (edit_work_text$="CR")
  ' which axes does it contain?
  x_axis_flag!=FALSE
  y_axis_flag!=FALSE
  z_axis_flag!=FALSE
  scan_index&=4
  ' length of its text
  field_text_length|=LEN(program_lines$(search_block&))
  REPEAT
    INC scan_index&
    ' X given
    IF MID$(program_lines$(search_block&),scan_index&,1)="X"
      x_axis_flag!=TRUE
    ELSE
      IF MID$(program_lines$(search_block&),scan_index&,1)="Y"
        y_axis_flag!=TRUE
      ELSE
        IF MID$(program_lines$(search_block&),scan_index&,1)="Z"
          z_axis_flag!=TRUE
        ENDIF
      ENDIF
    ENDIF
  UNTIL scan_index&=33 OR scan_index&=field_text_length|
  ' all three axes and no radius correction: no plane can be found
  IF x_axis_flag! AND y_axis_flag! AND z_axis_flag! AND (radius_correction$="0")
    ' the working plane cannot be found
    ALERT 3,"Die Bearbeitungsebene|kann nicht festgestellt|werden!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
  ELSE
    ' CTP: the polar end point is checked against the block before
    IF LEFT$(program_line$,3)="CTP"
      search_block&=current_block&
      skip_to_previous_block(search_block&)
    ELSE
      search_block&=current_block&
    ENDIF
    ' clear the flags for the axes of this block
    scan_index&=4
    field_text_length|=LEN(program_lines$(search_block&))
    REPEAT
      INC scan_index&
      IF MID$(program_lines$(search_block&),scan_index&,1)="X"
        x_axis_flag!=FALSE
      ELSE
        IF MID$(program_lines$(search_block&),scan_index&,1)="Y"
          y_axis_flag!=FALSE
        ELSE
          IF MID$(program_lines$(search_block&),scan_index&,1)="Z"
            z_axis_flag!=FALSE
          ENDIF
        ENDIF
      ENDIF
    UNTIL scan_index&=33 OR scan_index&=field_text_length|
    ' an axis of the previous block is missing here
    IF x_axis_flag! OR y_axis_flag! OR z_axis_flag!
      ' a C or L block with the same axes must come before the CT/CTP block
      ALERT 3,"Vor einem CT-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
    ELSE
      ' read the circle centre of the CC block
      set_plane_from_centre(program_line$)
      ' not taken from a stored contour
      IF NOT block_reverse_running!
        ' read the end point of the C block
        read_arc_target(program_line$,9,21)
        read_radius_correction(program_line$)
      ENDIF
      ' start and end point coincide
      IF 1E-06>ABS(end_point(first_plane_axis|)-start_point(first_plane_axis|)) AND 1E-06>ABS(end_point(second_plane_axis|)-start_point(second_plane_axis|))
        ' start and end point of the arc must differ
        ALERT 3,"Kreisanfangs- und|endpunkt mÅssen verschieden|voneinander sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="KREISANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        ' start tangent of the arc, from the previous element
        IF after_line_element!
          compute_tangent_vector(-1)
        ELSE
          compute_tangent_vector(0)
        ENDIF
        ' no error so far
        IF NOT run_aborted!
          ' a second point on the tangent
          normal_direction_x=start_point(first_plane_axis|)+start_tangent(1)*10
          normal_direction_y=start_point(second_plane_axis|)+start_tangent(2)*10
          ' vertical tangent
          IF start_tangent(1)=0
            ' the centre lies on the horizontal through the start point
            circle_centre(first_plane_axis|)=start_point(first_plane_axis|)
            ' and at equal distance from start and end point
            circle_centre(second_plane_axis|)=circle_centre(first_plane_axis|)*2*(end_point(first_plane_axis|)-start_point(first_plane_axis|))+start_point(first_plane_axis|)*start_point(first_plane_axis|)+start_point(second_plane_axis|)*start_point(second_plane_axis|)-end_point(first_plane_axis|)*end_point(first_plane_axis|)-end_point(second_plane_axis|)*end_point(second_plane_axis|)
            DIV circle_centre(second_plane_axis|),(start_point(second_plane_axis|)-end_point(second_plane_axis|))*2
            ' centre left or right of the tangent gives the direction
            IF (circle_centre(second_plane_axis|)-start_point(second_plane_axis|))/start_tangent(2)>=0
              arc_direction$=CHR$(45)
            ELSE
              arc_direction$=CHR$(43)
            ENDIF
          ELSE
            ' slope of the normal to the tangent through the start point
            line_slope=(normal_direction_y-start_point(second_plane_axis|))/(normal_direction_x-start_point(first_plane_axis|))
            ' its intercept
            line_intercept=start_point(second_plane_axis|)-line_slope*start_point(first_plane_axis|)
            ' centre on the normal at equal distance from start and end point
            circle_centre(first_plane_axis|)=line_intercept*2*(start_point(second_plane_axis|)-end_point(second_plane_axis|))-start_point(first_plane_axis|)*start_point(first_plane_axis|)-start_point(second_plane_axis|)*start_point(second_plane_axis|)+end_point(first_plane_axis|)*end_point(first_plane_axis|)+end_point(second_plane_axis|)*end_point(second_plane_axis|)
            DIV circle_centre(first_plane_axis|),(end_point(first_plane_axis|)-start_point(first_plane_axis|)+(end_point(second_plane_axis|)-start_point(second_plane_axis|))*line_slope)*2
            ' second coordinate from the normal
            circle_centre(second_plane_axis|)=line_slope*circle_centre(first_plane_axis|)+line_intercept
            ' centre side gives the direction
            IF (circle_centre(first_plane_axis|)-start_point(first_plane_axis|))/start_tangent(1)>=0
              arc_direction$=CHR$(45)
            ELSE
              arc_direction$=CHR$(43)
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Evaluates a CTP block (tangentialer Kreis polar, polar tangential arc) in program_line$: like
' interpret_tangential_arc, but the end point is given by polar radius (column 9) and polar angle (column 22)
' about the pole, the angle incremental with "I" in column 18; the end point is mirrored, rotated and
' datum-shifted before the tangential centre circle_centre() is computed.
PROCEDURE interpret_polar_tangential_arc(program_line$)
  LOCAL polar_angle,polar_radius,pole_start_angle,line_slope,line_intercept,element_arc_radius,radius_dot_product,entry_layout_backup$,point_distance,work_point_y,direction_x,direction_y,alert_button|,search_block&,x_axis_flag!,y_axis_flag!,z_axis_flag!,scan_index&,field_text_length|,rect_width&,angle_offset,rotate_length,axis_determinant,absolute_polar_angle!
  ' search back from the current block
  search_block&=current_block&
  ' for the previous contour block
  REPEAT
    ' step back to the previous program block
    skip_to_previous_block(search_block&)
    edit_work_text$=LEFT$(program_lines$(search_block&),2)
    ' CC, C, L with coordinates, CT or CR
  UNTIL (edit_work_text$="CC") OR (edit_work_text$="C ") OR ((edit_work_text$="L ") AND (MID$(program_lines$(search_block&),7,1)<>"A") AND LEN(program_lines$(search_block&))>20) OR (edit_work_text$="CT") OR (edit_work_text$="CR")
  ' which axes does it contain?
  x_axis_flag!=FALSE
  y_axis_flag!=FALSE
  z_axis_flag!=FALSE
  scan_index&=4
  field_text_length|=LEN(program_lines$(search_block&))
  REPEAT
    INC scan_index&
    IF MID$(program_lines$(search_block&),scan_index&,1)="X"
      x_axis_flag!=TRUE
    ELSE
      IF MID$(program_lines$(search_block&),scan_index&,1)="Y"
        y_axis_flag!=TRUE
      ELSE
        IF MID$(program_lines$(search_block&),scan_index&,1)="Z"
          z_axis_flag!=TRUE
        ENDIF
      ENDIF
    ENDIF
  UNTIL scan_index&=33 OR scan_index&=field_text_length|
  ' all three axes and no radius correction: no plane can be found
  IF x_axis_flag! AND y_axis_flag! AND z_axis_flag! AND (radius_correction$="0")
    ' the working plane cannot be found
    ALERT 3,"Die Bearbeitungsebene|kann nicht festgestellt|werden!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
  ELSE
    ' CTP: compare with the block before
    IF LEFT$(program_line$,3)="CTP"
      search_block&=current_block&
      skip_to_previous_block(search_block&)
    ELSE
      search_block&=current_block&
    ENDIF
    scan_index&=4
    field_text_length|=LEN(program_lines$(search_block&))
    REPEAT
      INC scan_index&
      IF MID$(program_lines$(search_block&),scan_index&,1)="X"
        x_axis_flag!=FALSE
      ELSE
        IF MID$(program_lines$(search_block&),scan_index&,1)="Y"
          y_axis_flag!=FALSE
        ELSE
          IF MID$(program_lines$(search_block&),scan_index&,1)="Z"
            z_axis_flag!=FALSE
          ENDIF
        ENDIF
      ENDIF
    UNTIL scan_index&=33 OR scan_index&=field_text_length|
  ENDIF
  ' an axis of the previous block is missing here
  IF x_axis_flag! OR y_axis_flag! OR z_axis_flag!
    ' a C or L block with the same axes must come before the CT/CTP block
    ALERT 3,"Vor einem CTP-Satz muû ein|C-oder L-Satz mit gleichen|Achsen eingegeben werden!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="VORHER C ODER L MIT GLEICHEN ACHSEN EINGEBEN!"
  ELSE
    ' polar radius PR
    polar_radius=@read_number_or_parameter(program_line$,9)
    IF polar_radius=0
      ' the arc radius must be greater than zero
      ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
    ELSE
      ' polar angle PA
      polar_angle=@read_unscaled_number(program_line$,22)
      ' into radians
      MUL polar_angle,PI/180
      ' read radius correction, feed and M function of the block
      read_radius_correction(program_line$)
      ' incremental angle IPA
      IF MID$(program_line$,18,1)="I"
        absolute_polar_angle!=FALSE
        ' start point relative to the pole
        direction_x=start_point(first_plane_axis|)-circle_centre(first_plane_axis|)
        direction_y=start_point(second_plane_axis|)-circle_centre(second_plane_axis|)
        ' distance of the start point from the pole
        element_arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
        IF element_arc_radius>0
          pole_start_angle=direction_x/element_arc_radius
          ' arc cosine: the angle of the vector
          pole_start_angle=@clamped_arc_cosine(pole_start_angle)
          IF direction_y<0
            ' below the axis: 2*PI minus the angle
            pole_start_angle=two_pi-pole_start_angle
          ENDIF
        ELSE
          ' the start point of the arc and the pole must differ
          ALERT 3,"Kreisanfangspunkt und Pol|mÅssen verschieden sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the current block
          error_blocks&(0)=current_block&
          error_messages$(0)="KREISANFANGSPUNKT UND POL MöSSEN VERSCHIEDEN SEIN!"
          pole_start_angle=0
        ENDIF
        ' add the angle of the start point
        polar_angle=polar_angle+pole_start_angle
      ELSE
        absolute_polar_angle!=TRUE
      ENDIF
      ' end point relative to the pole, rounded to 6 decimals
      end_point(tool_first_axis|)=ROUND(COS(polar_angle)*polar_radius*1000000)/1000000
      end_point(tool_second_axis|)=ROUND(SIN(polar_angle)*polar_radius*1000000)/1000000
      ' the infeed axis keeps its coordinate
      end_point(depth_axis|)=start_point(depth_axis|)
      ' keep the programmed end point before mirroring
      block_input_values(1)=end_point(1)
      block_input_values(2)=end_point(2)
      block_input_values(3)=end_point(3)
      ' X is mirrored before the rotation
      IF mirror_x! AND (NOT mirror_x_after_rotation!)
        ' mirror X
        end_point(1)=-end_point(1)
      ENDIF
      ' Y is mirrored before the rotation
      IF mirror_y! AND (NOT mirror_y_after_rotation!)
        ' mirror Y
        end_point(2)=-end_point(2)
      ENDIF
      ' Z is mirrored before the rotation
      IF mirror_z! AND (NOT mirror_z_after_rotation!)
        ' mirror Z
        end_point(3)=-end_point(3)
      ENDIF
      ' a rotation is active and the angle was absolute: rotate the point as well
      IF rotation_active! AND absolute_polar_angle!
        point_distance=end_point(tool_first_axis|)
        work_point_y=end_point(tool_second_axis|)
        IF point_distance<>0 OR work_point_y<>0
          ' distance of the point from the origin
          rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
          ' cosine of its angle
          angle_offset=point_distance/rotate_length
          ' arc cosine: the angle of the vector
          angle_offset=@clamped_arc_cosine(angle_offset)
          IF work_point_y<0
            ' below the axis: 2*PI minus the angle
            angle_offset=two_pi-angle_offset
          ENDIF
          ' add the rotation angle
          angle_offset=angle_offset+rotation_angle
          ' rotated point
          point_distance=COS(angle_offset)*rotate_length
          work_point_y=SIN(angle_offset)*rotate_length
          end_point(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
          end_point(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
        ENDIF
      ENDIF
      ' X is mirrored after the rotation
      IF mirror_x! AND mirror_x_after_rotation!
        ' mirror X
        end_point(1)=-end_point(1)
      ENDIF
      ' Y is mirrored after the rotation
      IF mirror_y! AND mirror_y_after_rotation!
        ' mirror Y
        end_point(2)=-end_point(2)
      ENDIF
      ' Z is mirrored after the rotation
      IF mirror_z! AND mirror_z_after_rotation!
        ' mirror Z
        end_point(3)=-end_point(3)
      ENDIF
      ' relative to the pole, the datum shift removed
      ADD end_point(tool_first_axis|),circle_centre(tool_first_axis|)-datum_shift(tool_first_axis|)
      ' the same for the second axis
      ADD end_point(tool_second_axis|),circle_centre(tool_second_axis|)-datum_shift(tool_second_axis|)
      ' determinant of the two rotated axis directions
      axis_determinant=rotated_first_axis(tool_first_axis|)*rotated_second_axis(tool_second_axis|)-rotated_first_axis(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
      ' the axes are parallel: no inverse
      IF axis_determinant=0
        ' an error occurred while mirroring the line
        ALERT 3,"Es ist ein Fehler|beim Spiegeln der Linie|aufgetreten!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="LINIE KANN NICHT GESPIEGELT WERDEN!"
      ELSE
        ' end point in the rotated axes, first coordinate
        rotated_position(tool_first_axis|)=(rotated_second_axis(tool_second_axis|)*end_point(tool_first_axis|)-rotated_second_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
        ' second coordinate
        rotated_position(tool_second_axis|)=(-rotated_first_axis(tool_second_axis|)*end_point(tool_first_axis|)+rotated_first_axis(tool_first_axis|)*end_point(tool_second_axis|))/axis_determinant
        ' keep the transformed end point (base for incremental input)
        programmed_position(1)=end_point(1)
        programmed_position(2)=end_point(2)
        programmed_position(3)=end_point(3)
        ' apply the datum shift
        ADD end_point(tool_first_axis|),datum_shift(tool_first_axis|)
        ADD end_point(tool_second_axis|),datum_shift(tool_second_axis|)
        ' less the shift change still to be moved
        SUB end_point(tool_first_axis|),datum_shift_change(tool_first_axis|)
        SUB end_point(tool_second_axis|),datum_shift_change(tool_second_axis|)
        ADD end_point(depth_axis|),datum_shift(depth_axis|)
        datum_shift_change(1)=0
        datum_shift_change(2)=0
        datum_shift_change(3)=0
      ENDIF
      ' start point relative to the pole
      direction_x=circle_centre(first_plane_axis|)-start_point(first_plane_axis|)
      direction_y=circle_centre(second_plane_axis|)-start_point(second_plane_axis|)
      ' its distance from the pole
      element_arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
      IF element_arc_radius=0
        ' the arc radius must be above zero: the centre must differ from the start point
        ALERT 3,"Kreisradius muû grîûer|als Null sein!|Kreismittelpunkt muû vom An-|fangspunkt verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
      ELSE
        IF 1E-06<ABS(end_point(first_plane_axis|)-start_point(first_plane_axis|)) OR 1E-06<ABS(end_point(second_plane_axis|)-start_point(second_plane_axis|))
          ' start and end point coincide
          IF 1E-06>ABS(end_point(first_plane_axis|)-start_point(first_plane_axis|)) AND 1E-06>ABS(end_point(second_plane_axis|)-start_point(second_plane_axis|))
            ' start and end point of the arc must differ
            ALERT 3,"Kreisanfangs- und|endpunkt mÅssen verschieden|voneinander sein!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the current block
            error_blocks&(0)=current_block&
            error_messages$(0)="KREISANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
          ELSE
            ' start tangent of the arc, from the previous element
            IF after_line_element!
              compute_tangent_vector(-1)
            ELSE
              compute_tangent_vector(0)
            ENDIF
            IF NOT run_aborted!
              ' a second point on the tangent
              normal_direction_x=start_point(first_plane_axis|)+start_tangent(1)*10
              normal_direction_y=start_point(second_plane_axis|)+start_tangent(2)*10
              ' vertical tangent
              IF start_tangent(1)=0
                circle_centre(first_plane_axis|)=start_point(first_plane_axis|)
                circle_centre(second_plane_axis|)=circle_centre(first_plane_axis|)*2*(end_point(first_plane_axis|)-start_point(first_plane_axis|))+start_point(first_plane_axis|)*start_point(first_plane_axis|)+start_point(second_plane_axis|)*start_point(second_plane_axis|)-end_point(first_plane_axis|)*end_point(first_plane_axis|)-end_point(second_plane_axis|)*end_point(second_plane_axis|)
                DIV circle_centre(second_plane_axis|),(start_point(second_plane_axis|)-end_point(second_plane_axis|))*2
                IF (circle_centre(second_plane_axis|)-start_point(second_plane_axis|))/start_tangent(2)>=0
                  arc_direction$=CHR$(45)
                ELSE
                  arc_direction$=CHR$(43)
                ENDIF
              ELSE
                ' slope of the normal to the tangent
                line_slope=(normal_direction_y-start_point(second_plane_axis|))/(normal_direction_x-start_point(first_plane_axis|))
                line_intercept=start_point(second_plane_axis|)-line_slope*start_point(first_plane_axis|)
                circle_centre(first_plane_axis|)=line_intercept*2*(start_point(second_plane_axis|)-end_point(second_plane_axis|))-start_point(first_plane_axis|)*start_point(first_plane_axis|)-start_point(second_plane_axis|)*start_point(second_plane_axis|)+end_point(first_plane_axis|)*end_point(first_plane_axis|)+end_point(second_plane_axis|)*end_point(second_plane_axis|)
                DIV circle_centre(first_plane_axis|),(end_point(first_plane_axis|)-start_point(first_plane_axis|)+(end_point(second_plane_axis|)-start_point(second_plane_axis|))*line_slope)*2
                circle_centre(second_plane_axis|)=line_slope*circle_centre(first_plane_axis|)+line_intercept
                IF (circle_centre(first_plane_axis|)-start_point(first_plane_axis|))/start_tangent(1)>=0
                  arc_direction$=CHR$(45)
                ELSE
                  arc_direction$=CHR$(43)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Evaluates a CR block (Kreis mit Radius, arc by radius) in program_line$: sets the plane axes
' first_plane_axis|/second_plane_axis|/infeed_axis| from the two axes in columns 5 and 17, reads the end point,
' the radius R (column 30, negative for the arc over 180 degrees, depth_upward!) and the direction DR (column
' 41), and computes the arc centre circle_centre() from the chord between start_point() and end_point().
PROCEDURE interpret_radius_arc(program_line$)
  LOCAL arc_radius,depth_upward!,chord_x,chord_y,chord_length,chord_angle,centre_angle_offset,work_text$,edit_work_text$,alert_button|
  ' first axis letter
  work_text$=MID$(program_line$,5,1)
  ' second axis letter
  edit_work_text$=MID$(program_line$,17,1)
  ' plane XY
  IF (work_text$="X") AND (edit_work_text$="Y") OR ((work_text$="Y") AND (edit_work_text$="X"))
    first_plane_axis|=1
    second_plane_axis|=2
    infeed_axis|=3
  ELSE
    ' plane YZ
    IF (work_text$="Y") AND (edit_work_text$="Z") OR ((work_text$="Z") AND (edit_work_text$="Y"))
      first_plane_axis|=2
      second_plane_axis|=3
      infeed_axis|=1
    ELSE
      ' plane ZX
      first_plane_axis|=3
      second_plane_axis|=1
      infeed_axis|=2
    ENDIF
  ENDIF
  ' read the end point
  read_arc_target(program_line$,7,19)
  ' radius R
  arc_radius=@read_number_or_parameter(program_line$,30)
  ' direction DR
  arc_direction$=@read_arc_direction$(program_line$,41)
  ' a positive radius gives the arc up to 180 degrees
  depth_upward!=arc_radius>=0
  ' radius without its sign
  arc_radius=ABS(arc_radius)
  ' read radius correction, feed and M function
  read_radius_correction(program_line$)
  ' chord from the start to the end point
  chord_x=end_point(first_plane_axis|)-start_point(first_plane_axis|)
  chord_y=end_point(second_plane_axis|)-start_point(second_plane_axis|)
  ' chord length
  chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
  IF chord_length=0
    ' start and end point of the arc must differ
    ALERT 3,"Anfangs- und Endpunkt|des Kreises mÅssen|verschieden sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the current block
    error_blocks&(0)=current_block&
    error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
  ELSE
    IF arc_radius=0
      ' the arc radius must not be zero
      ALERT 3,"Der Kreisradius muû|ungleich Null sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="KREISRADIUS MUSS UNGLEICH NULL SEIN!"
    ELSE
      ' angle of the chord
      chord_angle=chord_x/chord_length
      ' arc cosine: the angle of the vector
      chord_angle=@clamped_arc_cosine(chord_angle)
      IF chord_y<0
        ' below the axis: 2*PI minus the angle
        chord_angle=two_pi-chord_angle
      ENDIF
      ' angle between the chord and the line to the centre
      centre_angle_offset=chord_length/2/arc_radius
      centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
      ' counterclockwise
      IF arc_direction$="+"
        IF depth_upward!
          chord_angle=chord_angle+centre_angle_offset
        ELSE
          SUB chord_angle,centre_angle_offset
        ENDIF
      ELSE
        IF depth_upward!
          SUB chord_angle,centre_angle_offset
        ELSE
          chord_angle=chord_angle+centre_angle_offset
        ENDIF
      ENDIF
      ' centre from the start point
      circle_centre(first_plane_axis|)=ROUND(COS(chord_angle)*arc_radius*1000000)/1000000+start_point(first_plane_axis|)
      circle_centre(second_plane_axis|)=ROUND(SIN(chord_angle)*arc_radius*1000000)/1000000+start_point(second_plane_axis|)
      ' check the distance from the centre to the end point
      chord_x=end_point(first_plane_axis|)-circle_centre(first_plane_axis|)
      chord_y=end_point(second_plane_axis|)-circle_centre(second_plane_axis|)
      chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
      IF chord_length>arc_radius AND .001<ABS(chord_length-arc_radius)
        ' the radius entered is too small for the arc
        ALERT 3,"Der eingegebene Radius ist|fÅr den Kreis zu klein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="DER RADIUS IST ZU KLEIN!"
      ENDIF
    ENDIF
  ENDIF
RETURN
' RND between two lines (L or LP before and after an RND block): program_line$ is the line before the RND block
' next_block&, the line after it is block_after_next& (L) or the CC and LP blocks
' block_after_next&/third_block_ahead&. Computes the rounding arc of the RND radius in the plane of the two
' lines, moves the end of the first line to the start of the arc, simulates the shortened line and then the arc
' (circle_centre() = arc centre, direction arc_direction$), so that the second line starts at the end of the
' arc.
PROCEDURE round_line_to_line(program_line$)
  LOCAL element_arc_radius,vector_x,vector_y,second_vector_x,second_vector_y,first_vector_length,second_vector_length,arc_start_angle,arc_end_angle,point_angle,pole_start_angle,line_slope,line_intercept,bisector_x,bisector_y,line_parameter,rnd_line_parameter,rnd_spare_value,second_normal_scale,first_normal_scale,rnd_start_x,rnd_start_y,rnd_end_x,rnd_end_y,normal_x,rnd_block_text$,following_block_text$,lookahead_third_block_text$,saved_radius_correction$,rnd_first_axis|,rnd_second_axis|,rnd_infeed_axis|,normal_h,normal_v,normal_y,work_text$,edit_work_text$,result_text$,alert_button|,direction_x,direction_y,second_direction_x,second_direction_y,first_normal_x,first_normal_y,second_normal_y,second_normal_y
  ' first line already stored by the look-ahead
  IF end_point_stored!
    swap_pending_block(-1,0,0)
  ELSE
    ' read the first line
    IF LEFT$(program_line$,2)="L "
      ' read the end point of the L block
      read_line_target(program_line$)
      read_radius_correction(program_line$)
    ELSE
      IF LEFT$(program_line$,2)="LP"
        interpret_polar_line(program_line$)
      ENDIF
    ENDIF
  ENDIF
  ' no error
  IF NOT run_aborted!
    ' keep the end point of the first element (the corner)
    corner_point(1)=end_point(1)
    corner_point(2)=end_point(2)
    corner_point(3)=end_point(3)
    ' save the radius correction
    saved_radius_correction$=radius_correction$
    ' the RND or chamfer block
    rnd_block_text$=program_lines$(next_block&)
    ' the block after it
    following_block_text$=program_lines$(block_after_next&)
    ' and the one after that
    lookahead_third_block_text$=program_lines$(third_block_ahead&)
    ' second line is an L block
    IF LEFT$(following_block_text$,2)="L "
      ' read the end point of the L block
      read_line_target(following_block_text$)
      ' read radius correction, feed and M function of the block
      read_radius_correction(following_block_text$)
      ' store the end point for the look-ahead
      swap_pending_block(-1,0,-1)
      ' no radius correction: find the plane from the axes given in the first line
      IF radius_correction$="0"
        work_text$=MID$(program_line$,7,1)
        edit_work_text$=MID$(program_line$,19,1)
        result_text$=MID$(program_line$,31,1)
        ' fewer or more than two axes, or a repeated axis
        IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=edit_work_text$))
          ' the working plane cannot be found
          ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the current block
          error_blocks&(0)=current_block&
          error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
        ELSE
          ' no first axis: plane YZ
          IF work_text$=" "
            rnd_first_axis|=2
            rnd_second_axis|=3
            rnd_infeed_axis|=1
          ELSE
            ' no second axis: plane ZX
            IF edit_work_text$=" "
              rnd_first_axis|=3
              rnd_second_axis|=1
              rnd_infeed_axis|=2
            ELSE
              rnd_first_axis|=1
              rnd_second_axis|=2
              rnd_infeed_axis|=3
            ENDIF
          ENDIF
        ENDIF
      ELSE
        ' with correction: the current plane
        rnd_first_axis|=first_plane_axis|
        rnd_second_axis|=second_plane_axis|
        rnd_infeed_axis|=infeed_axis|
      ENDIF
    ELSE
      ' second line is CC and LP
      set_plane_from_centre(following_block_text$)
      ' evaluate the CC block
      read_circle_centre(following_block_text$)
      ' evaluate the LP block
      interpret_polar_line(lookahead_third_block_text$)
      ' store the end point and centre for the look-ahead
      swap_pending_block(-1,-1,-1)
      ' the plane of the parsed line
      rnd_first_axis|=first_plane_axis|
      rnd_second_axis|=second_plane_axis|
      rnd_infeed_axis|=infeed_axis|
    ENDIF
    ' restore the radius correction
    radius_correction$=saved_radius_correction$
    ' the rounding radius R
    element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
    ' first line backwards from the corner
    vector_x=start_point(rnd_first_axis|)-corner_point(rnd_first_axis|)
    vector_y=start_point(rnd_second_axis|)-corner_point(rnd_second_axis|)
    ' its length
    first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
    IF first_vector_length=0
      ' start and end point of the line must differ
      ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
    ELSE
      ' angle of the first line
      arc_start_angle=vector_x/first_vector_length
      ' arc cosine: the angle of the vector
      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
      IF vector_y<0
        ' below the axis: 2*PI minus the angle
        arc_start_angle=two_pi-arc_start_angle
      ENDIF
      vector_x=-vector_x
      vector_y=-vector_y
      ' second line from the corner
      second_vector_x=end_point(rnd_first_axis|)-corner_point(rnd_first_axis|)
      second_vector_y=end_point(rnd_second_axis|)-corner_point(rnd_second_axis|)
      normal_h=vector_x
      normal_v=vector_y
      ' which side of the first line does the second line turn to?
      IF normal_h=0
        IF end_point(rnd_first_axis|)<start_point(rnd_first_axis|) AND normal_v>=0 OR (end_point(rnd_first_axis|)>start_point(rnd_first_axis|) AND normal_v<0)
          line_parameter=-1
        ELSE
          line_parameter=1
        ENDIF
      ELSE
        normal_x=-normal_v
        normal_y=normal_h
        ' intersection parameter of the second line with the normal
        line_parameter=start_point(rnd_second_axis|)-end_point(rnd_second_axis|)+normal_v/normal_h*(end_point(rnd_first_axis|)-start_point(rnd_first_axis|))
        DIV line_parameter,normal_y-normal_x*normal_v/normal_h
      ENDIF
      ' lines parallel or the second line of no length
      IF line_parameter=0 OR (second_vector_x=0 AND second_vector_y=0)
        ' start and end point of the line must differ
        ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        ' length of the second line
        second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
        ' angle of the second line
        arc_end_angle=second_vector_x/second_vector_length
        ' arc cosine: the angle of the vector
        arc_end_angle=@clamped_arc_cosine(arc_end_angle)
        IF second_vector_y<0
          ' below the axis: 2*PI minus the angle
          arc_end_angle=two_pi-arc_end_angle
        ENDIF
        ' half angle between the lines: the bisector
        point_angle=arc_end_angle-arc_start_angle
        pole_start_angle=point_angle/2+arc_start_angle
        ' bisector direction
        bisector_x=COS(pole_start_angle)*10
        bisector_y=SIN(pole_start_angle)*10
        direction_x=vector_x
        direction_y=vector_y
        second_direction_x=second_vector_x
        second_direction_y=second_vector_y
        ' turn to the left
        IF line_parameter>0
          first_normal_x=direction_y
          first_normal_y=-direction_x
          second_normal_x=-second_direction_y
          second_normal_y=second_direction_x
          arc_direction$=CHR$(45)
        ELSE
          first_normal_x=-direction_y
          first_normal_y=direction_x
          second_normal_x=second_direction_y
          second_normal_y=-second_direction_x
          arc_direction$=CHR$(43)
        ENDIF
        ' normal of the first line, scaled to the rounding radius
        first_normal_scale=element_arc_radius/SQR(first_normal_x*first_normal_x+first_normal_y*first_normal_y)
        ' normal of the second line, scaled to the rounding radius
        second_normal_scale=element_arc_radius/SQR(second_normal_x*second_normal_x+second_normal_y*second_normal_y)
        ' the bisector is not vertical
        IF bisector_x<>0
          ' the bisector as y = line_slope*x+line_intercept through the corner
          line_slope=bisector_y/bisector_x
          line_intercept=corner_point(rnd_second_axis|)-line_slope*corner_point(rnd_first_axis|)
          ' where the offset first line meets the bisector
          rnd_line_parameter=(start_point(rnd_first_axis|)+first_normal_scale*first_normal_x)*line_slope+line_intercept-start_point(rnd_second_axis|)-first_normal_scale*first_normal_y
          DIV rnd_line_parameter,direction_y-line_slope*direction_x
          ' behind the start of the first line: the radius is too large
          IF rnd_line_parameter<0
            ' the rounding radius is too large
            ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the next block (the RND or chamfer block)
            error_blocks&(0)=next_block&
            error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
          ELSE
            ' start of the rounding arc on the first line
            rnd_start_x=start_point(rnd_first_axis|)+rnd_line_parameter*direction_x
            rnd_start_y=start_point(rnd_second_axis|)+rnd_line_parameter*direction_y
            ' centre of the rounding arc
            circle_centre(rnd_first_axis|)=first_normal_scale*first_normal_x+rnd_start_x
            circle_centre(rnd_second_axis|)=first_normal_scale*first_normal_y+rnd_start_y
            ' end of the rounding arc on the second line
            rnd_end_x=circle_centre(rnd_first_axis|)+second_normal_scale*second_normal_x
            rnd_end_y=circle_centre(rnd_second_axis|)+second_normal_scale*second_normal_y
          ENDIF
        ELSE
          ' vertical bisector: the centre lies on the vertical through the corner
          circle_centre(rnd_first_axis|)=corner_point(rnd_first_axis|)
          IF direction_x<>0
            rnd_line_parameter=(circle_centre(rnd_first_axis|)-start_point(rnd_first_axis|)-first_normal_scale*first_normal_x)/direction_x
          ENDIF
          IF rnd_line_parameter<0
            ' the rounding radius is too large
            ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the next block (the RND or chamfer block)
            error_blocks&(0)=next_block&
            error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
          ELSE
            rnd_start_x=start_point(rnd_first_axis|)+rnd_line_parameter*direction_x
            rnd_start_y=start_point(rnd_second_axis|)+rnd_line_parameter*direction_y
            circle_centre(rnd_second_axis|)=first_normal_scale*first_normal_y+rnd_start_y
            rnd_end_x=circle_centre(rnd_first_axis|)+second_normal_scale*second_normal_x
            rnd_end_y=circle_centre(rnd_second_axis|)+second_normal_scale*second_normal_y
          ENDIF
        ENDIF
        ' no error
        IF NOT run_aborted!
          ' the first line ends at the start of the rounding
          end_point(rnd_first_axis|)=rnd_start_x
          end_point(rnd_second_axis|)=rnd_start_y
          end_point(rnd_infeed_axis|)=corner_point(rnd_infeed_axis|)
          ' simulate the shortened first line
          queue_simulated_move(current_block&,arc_direction$,-1)
          ' rounding radius above zero
          IF element_arc_radius>0
            first_plane_axis|=rnd_first_axis|
            second_plane_axis|=rnd_second_axis|
            infeed_axis|=rnd_infeed_axis|
            ' the rounding ends on the second line
            end_point(rnd_first_axis|)=rnd_end_x
            end_point(rnd_second_axis|)=rnd_end_y
            ' simulate the rounding arc
            queue_simulated_move(next_block&,arc_direction$,0)
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' RND between a line (program_line$, L or LP) and a following arc (C, CP or CR after the RND block; CT is
' refused): computes the rounding arc that touches the line and the arc, simulates the shortened line and the
' rounding arc, and leaves the following arc to start at the end of the rounding arc. The line start point is
' kept in element_start_point(), the line end in corner_point().
PROCEDURE round_line_to_arc(program_line$)
  LOCAL rnd_block_text$,following_block_text$,rnd_arc_direction$,saved_radius_correction$,element_arc_radius,arc_radius,element_start_x,element_start_y,start_infeed_coordinate,vector_x,vector_y,cycle_saved_first_axis|,cycle_saved_second_axis|,saved_infeed_axis|,second_vector_x,second_vector_y,line_normal_x,line_normal_y,radius_normal_x,radius_normal_y,point_angle,line_length,corner_offset_circle_radius,basic_variables,segment_length,second_operand,discriminant,quadratic_factor,offset_point_y,end_side_factor,line_parameter,rnd_start_x,restore_flag!,rnd_start_y,rnd_end_x,rnd_end_y,point_u,point_v,lookahead_third_block_text$,third_block_type$,alert_button|,work_text$,edit_work_text$,result_text$,foot_offset_x,foot_offset_y,foot_distance,setup_clearance,crossing_point_x,crossing_point_y
  ' keep the start point of the line
  element_start_point(1)=start_point(1)
  element_start_point(2)=start_point(2)
  element_start_point(3)=start_point(3)
  ' line already stored by the look-ahead
  IF end_point_stored!
    swap_pending_block(-1,0,0)
  ELSE
    ' read the line
    IF LEFT$(program_line$,2)="L "
      ' read the end point of the L block
      read_line_target(program_line$)
      read_radius_correction(program_line$)
    ELSE
      interpret_polar_line(program_line$)
    ENDIF
  ENDIF
  ' keep the end of the line (the corner)
  corner_point(1)=end_point(1)
  corner_point(2)=end_point(2)
  corner_point(3)=end_point(3)
  ' save the radius correction
  saved_radius_correction$=radius_correction$
  ' no radius correction: find the plane from the axes given in the line
  IF radius_correction$="0"
    work_text$=MID$(program_line$,7,1)
    edit_work_text$=MID$(program_line$,19,1)
    result_text$=MID$(program_line$,31,1)
    ' fewer or more than two axes, or a repeated axis
    IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=edit_work_text$))
      ' the working plane cannot be found
      ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
    ELSE
      ' no first axis: plane YZ
      IF work_text$=" "
        cycle_saved_first_axis|=2
        cycle_saved_second_axis|=3
        saved_infeed_axis|=1
      ELSE
        ' no second axis: plane ZX
        IF edit_work_text$=" "
          cycle_saved_first_axis|=3
          cycle_saved_second_axis|=1
          saved_infeed_axis|=2
        ELSE
          cycle_saved_first_axis|=1
          cycle_saved_second_axis|=2
          saved_infeed_axis|=3
        ENDIF
      ENDIF
    ENDIF
  ELSE
    ' with correction: the current plane
    cycle_saved_first_axis|=first_plane_axis|
    cycle_saved_second_axis|=second_plane_axis|
    saved_infeed_axis|=infeed_axis|
  ENDIF
  ' the RND or chamfer block
  rnd_block_text$=program_lines$(next_block&)
  ' the block after it
  following_block_text$=program_lines$(block_after_next&)
  ' and the one after that
  lookahead_third_block_text$=program_lines$(third_block_ahead&)
  ' the rounding radius R
  element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
  ' type of the block after the CC block
  third_block_type$=LEFT$(lookahead_third_block_text$,2)
  ' the arc starts at the corner
  start_point(1)=end_point(1)
  start_point(2)=end_point(2)
  start_point(3)=end_point(3)
  ' C: read the centre and the end point
  IF third_block_type$="C "
    ' read the circle centre of the CC block
    set_plane_from_centre(following_block_text$)
    ' evaluate the CC block
    read_circle_centre(following_block_text$)
    ' read the end point of the C block
    read_arc_target(lookahead_third_block_text$,9,21)
    ' read radius correction, feed and M function of the block
    read_radius_correction(lookahead_third_block_text$)
    ' direction DR+ or DR-
    arc_direction$=@read_arc_direction$(lookahead_third_block_text$,33)
  ELSE
    IF third_block_type$="CP"
      ' read the circle centre of the CC block
      set_plane_from_centre(following_block_text$)
      ' evaluate the CC block
      read_circle_centre(following_block_text$)
      ' evaluate the CP block
      interpret_polar_arc(lookahead_third_block_text$)
    ELSE
      ' CT cannot be rounded into
      IF third_block_type$="CT"
        ' an RND block is not possible here
        ALERT 3,"Der RND-Satz ist|hier nicht mîglich!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the third block ahead
        error_blocks&(0)=third_block_ahead&
        error_messages$(0)="RND IST HIER NICHT MôGLICH!"
      ELSE
        ' CR right after the RND block
        IF LEFT$(following_block_text$,2)="CR"
          ' evaluate the CR block
          interpret_radius_arc(following_block_text$)
        ELSE
          ' this kind of block is not allowed here
          ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the block after next
          error_blocks&(0)=block_after_next&
          error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' no error so far
  IF NOT run_aborted!
    ' the arc must lie in the plane of the line
    IF cycle_saved_first_axis|<>first_plane_axis| OR cycle_saved_second_axis|<>second_plane_axis|
      ' the working plane cannot be found
      ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the block after next
      error_blocks&(0)=block_after_next&
      error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
    ELSE
      ' back to the start point of the line
      start_point(1)=element_start_point(1)
      start_point(2)=element_start_point(2)
      start_point(3)=element_start_point(3)
      ' line start point
      element_start_x=element_start_point(first_plane_axis|)
      element_start_y=element_start_point(second_plane_axis|)
      start_infeed_coordinate=element_start_point(infeed_axis|)
      ' arc centre
      point_u=circle_centre(first_plane_axis|)
      point_v=circle_centre(second_plane_axis|)
      ' store the end point and centre for the look-ahead
      swap_pending_block(-1,-1,-1)
      ' restore the radius correction
      radius_correction$=saved_radius_correction$
      ' line from its start to the corner
      vector_x=corner_point(first_plane_axis|)-element_start_x
      vector_y=corner_point(second_plane_axis|)-element_start_y
      ' centre to the corner
      second_vector_x=corner_point(first_plane_axis|)-point_u
      second_vector_y=corner_point(second_plane_axis|)-point_v
      ' line length
      line_length=SQR(vector_x*vector_x+vector_y*vector_y)
      ' arc radius
      corner_offset_circle_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
      IF line_length=0
        ' start and end point of the line must differ
        ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' running inside a contour cycle
        IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
          ' in a contour cycle the error is reported at the cycle block
          error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
        ELSE
          error_blocks&(0)=current_block&
        ENDIF
        error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        IF corner_offset_circle_radius=0
          ' the arc radius must be greater than zero
          ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' running inside a contour cycle
          IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
            ' in a contour cycle the error is reported at the cycle block
            error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
          ELSE
            error_blocks&(0)=next_block&
          ENDIF
          error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
        ELSE
          ' clockwise arc
          IF arc_direction$="-"
            ' normal of the line to the arc side, and radius normal
            line_normal_x=-vector_y
            line_normal_y=vector_x
            radius_normal_x=second_vector_y
            radius_normal_y=-second_vector_x
            rnd_arc_direction$=CHR$(43)
          ELSE
            line_normal_x=vector_y
            line_normal_y=-vector_x
            radius_normal_x=-second_vector_y
            radius_normal_y=second_vector_x
            rnd_arc_direction$=CHR$(45)
          ENDIF
          ' dot product of the two normals
          point_angle=line_normal_x*radius_normal_x+line_normal_y*radius_normal_y
          restore_flag!=FALSE
          ' the normals do not point the same way at the corner
          IF 1E-06>ABS(point_angle) OR point_angle<0
            ' intersection of the line with the radius line through the centre
            IF vector_x=0 AND line_normal_x<>0
              line_parameter=point_v-element_start_y
              line_parameter=line_parameter+line_normal_y/line_normal_x*(element_start_x-point_u)
              DIV line_parameter,vector_y-line_normal_y*vector_x/line_normal_x
              crossing_point_x=line_parameter*vector_x+element_start_x
              crossing_point_y=line_parameter*vector_y+element_start_y
            ELSE
              IF vector_x<>0
                line_parameter=element_start_y-point_v
                line_parameter=line_parameter+vector_y/vector_x*(point_u-element_start_x)
                DIV line_parameter,line_normal_y-vector_y*line_normal_x/vector_x
                crossing_point_x=circle_centre(first_plane_axis|)+line_parameter*line_normal_x
                crossing_point_y=circle_centre(second_plane_axis|)+line_parameter*line_normal_y
              ENDIF
            ENDIF
            ' distance from the line start to the intersection
            foot_offset_x=element_start_x-crossing_point_x
            foot_offset_y=element_start_y-crossing_point_y
            foot_distance=SQR(foot_offset_x*foot_offset_x+foot_offset_y*foot_offset_y)
            setup_clearance=SQR(vector_x*vector_x+vector_y*vector_y)
            ' on which side of the line does the centre lie?
            IF second_vector_x=0
              IF element_start_x<point_u OR 9.99999999999997E-06>ABS(element_start_x-point_u) AND (second_vector_y>0 OR 9.99999999999997E-06>ABS(second_vector_y)) OR (element_start_x>point_u AND second_vector_y<0)
                line_parameter=-1
              ELSE
                line_parameter=1
              ENDIF
            ELSE
              ' side from the intersection of the radius line with the normal
              normal_x=-second_vector_y
              normal_y=second_vector_x
              line_parameter=point_v-element_start_y+second_vector_y/second_vector_x*(element_start_x-point_u)
              DIV line_parameter,normal_y-normal_x*second_vector_y/second_vector_x
            ENDIF
            IF .0001>ABS(line_parameter)
              line_parameter=0
            ENDIF
            ' the side of the centre does not match the arc direction, or the foot point lies beyond the line
            IF line_parameter<=0 AND (arc_direction$="-") OR (line_parameter>=0 AND (arc_direction$="+")) OR foot_distance<setup_clearance
              ' the arc already touches the line
              IF 1E-06>ABS(point_angle)
                ' the arc already joins the line tangentially, so no RND is possible here
                ALERT 3,"Der Kreis schlieût sich|tangential an die Linie an.|Daher ist hier der|RND-Satz nicht mîglich!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                ' the error is reported at the next block (the RND or chamfer block)
                error_blocks&(0)=next_block&
                error_messages$(0)="DER RND-SATZ IST NICHT MôGLICH!"
              ELSE
                ' rounding inside the arc: reverse the normal, the offset circle shrinks
                restore_flag!=TRUE
                line_normal_x=-line_normal_x
                line_normal_y=-line_normal_y
                SUB corner_offset_circle_radius,element_arc_radius
                rnd_arc_direction$=arc_direction$
              ENDIF
            ELSE
              ' rounding outside the arc: the offset circle grows
              corner_offset_circle_radius=corner_offset_circle_radius+element_arc_radius
            ENDIF
          ELSE
            corner_offset_circle_radius=corner_offset_circle_radius+element_arc_radius
          ENDIF
          ' no error
          IF NOT run_aborted!
            ' the line offset by the rounding radius
            end_side_factor=element_arc_radius/line_length
            quadratic_factor=end_side_factor*line_normal_x+element_start_x-point_u
            offset_point_y=end_side_factor*line_normal_y+element_start_y-point_v
            ' intersect it with the offset circle: quadratic in line_parameter
            basic_variables=vector_x*vector_x+vector_y*vector_y
            segment_length=(quadratic_factor*vector_x+offset_point_y*vector_y)*2
            second_operand=quadratic_factor*quadratic_factor+offset_point_y*offset_point_y-corner_offset_circle_radius*corner_offset_circle_radius
            ' discriminant
            discriminant=segment_length*segment_length-basic_variables*4*second_operand
            ' no intersection: the rounding radius is too large
            IF discriminant<0
              ' the rounding radius is too large
              ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the next block (the RND or chamfer block)
              error_blocks&(0)=next_block&
              error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
            ELSE
              ' pick the root that lies on the line
              discriminant=SQR(discriminant)
              IF restore_flag!
                line_parameter=(-segment_length+discriminant)/2/basic_variables
                IF line_parameter>=1
                  line_parameter=(-segment_length-discriminant)/2/basic_variables
                ENDIF
              ELSE
                line_parameter=(-segment_length-discriminant)/2/basic_variables
                IF line_parameter>=1
                  line_parameter=(-segment_length+discriminant)/2/basic_variables
                ENDIF
              ENDIF
              ' behind the line start: the radius is too large
              IF line_parameter<0
                ' the rounding radius is too large
                ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                ' the error is reported at the next block (the RND or chamfer block)
                error_blocks&(0)=next_block&
                error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
              ELSE
                ' start of the rounding arc on the line
                rnd_start_x=line_parameter*vector_x+element_start_x
                rnd_start_y=line_parameter*vector_y+element_start_y
                ' centre of the rounding arc
                circle_centre(first_plane_axis|)=end_side_factor*line_normal_x+rnd_start_x
                circle_centre(second_plane_axis|)=end_side_factor*line_normal_y+rnd_start_y
                second_vector_x=point_u-circle_centre(first_plane_axis|)
                second_vector_y=point_v-circle_centre(second_plane_axis|)
                ' end of the rounding arc on the arc
                arc_radius=element_arc_radius/corner_offset_circle_radius
                IF restore_flag!
                  arc_radius=-arc_radius
                ENDIF
                rnd_end_x=circle_centre(first_plane_axis|)+arc_radius*second_vector_x
                rnd_end_y=circle_centre(second_plane_axis|)+arc_radius*second_vector_y
                ' the line ends at the start of the rounding
                end_point(first_plane_axis|)=rnd_start_x
                end_point(second_plane_axis|)=rnd_start_y
                ' save the plane of the element
                cycle_saved_first_axis|=first_plane_axis|
                cycle_saved_second_axis|=second_plane_axis|
                saved_infeed_axis|=infeed_axis|
                ' back to the plane of the tool axis
                first_plane_axis|=tool_first_axis|
                second_plane_axis|=tool_second_axis|
                infeed_axis|=depth_axis|
                ' simulate the shortened line in the tool plane
                queue_simulated_move(current_block&,rnd_arc_direction$,-1)
                ' rounding radius above zero
                IF element_arc_radius>0
                  ' restore the plane of the element
                  first_plane_axis|=cycle_saved_first_axis|
                  second_plane_axis|=cycle_saved_second_axis|
                  infeed_axis|=saved_infeed_axis|
                  end_point(first_plane_axis|)=rnd_end_x
                  end_point(second_plane_axis|)=rnd_end_y
                  ' simulate the rounding arc
                  queue_simulated_move(next_block&,rnd_arc_direction$,0)
                  ' the rounding ends at the corner
                  IF 1E-06>ABS(corner_point(first_plane_axis|)-rnd_end_x) AND 1E-06>ABS(corner_point(second_plane_axis|)-rnd_end_y)
                    rnd_ends_at_corner!=TRUE
                  ELSE
                    ' restore the plane of the element
                    first_plane_axis|=cycle_saved_first_axis|
                    second_plane_axis|=cycle_saved_second_axis|
                    infeed_axis|=saved_infeed_axis|
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' RND between an arc (program_line$: C, CP, CT, CTP or CR) and a following line (L, or CC and LP): computes the
' rounding arc touching both, simulates the shortened arc and the rounding arc and leaves the line to start at
' the end of the rounding.
PROCEDURE round_arc_to_line(program_line$)
  LOCAL rnd_block_text$,following_block_text$,lookahead_third_block_text$,rnd_arc_direction$,saved_radius_correction$,element_arc_radius,arc_radius,element_start_x,element_start_y,start_infeed_coordinate,vector_x,vector_y,cycle_saved_first_axis|,cycle_saved_second_axis|,saved_infeed_axis|,second_vector_x,second_vector_y,line_normal_x,line_normal_y,radius_normal_x,radius_normal_y,point_angle,line_length,corner_offset_circle_radius,basic_variables,segment_length,second_operand,discriminant,quadratic_factor,offset_point_y,end_side_factor,line_parameter,rnd_start_x,rnd_start_y,rnd_end_x,rnd_end_y,point_u,point_v,restore_flag!,foot_offset_x,foot_offset_y,foot_distance,setup_clearance,alert_button|,crossing_point_x,crossing_point_y
  ' type of the arc block
  following_block_text$=LEFT$(program_line$,2)
  IF following_block_text$="C "
    ' has the look-ahead already stored this end point?
    IF end_point_stored!
      swap_pending_block(-1,0,0)
    ELSE
      ' read the arc end point
      read_arc_target(program_line$,9,21)
      ' read radius correction, feed and M function of the block
      read_radius_correction(program_line$)
      ' direction DR+ or DR-
      arc_direction$=@read_arc_direction$(program_line$,33)
    ENDIF
  ELSE
    IF following_block_text$="CP"
      ' has the look-ahead already stored this end point?
      IF end_point_stored!
        swap_pending_block(-1,0,0)
      ELSE
        interpret_polar_arc(program_line$)
      ENDIF
    ELSE
      ' CT or CTP
      IF following_block_text$="CT"
        IF MID$(program_line$,3,1)="P"
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            ' evaluate the CTP block
            interpret_polar_tangential_arc(program_line$)
          ENDIF
        ELSE
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            ' evaluate the CT block
            interpret_tangential_arc(program_line$)
          ENDIF
        ENDIF
      ELSE
        IF end_point_stored!
          swap_pending_block(-1,-1,0)
        ELSE
          interpret_radius_arc(program_line$)
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' keep the end of the arc (the corner)
  corner_point(1)=end_point(1)
  corner_point(2)=end_point(2)
  corner_point(3)=end_point(3)
  ' save the radius correction
  saved_radius_correction$=radius_correction$
  ' the RND or chamfer block
  rnd_block_text$=program_lines$(next_block&)
  ' the block after it
  following_block_text$=program_lines$(block_after_next&)
  ' and the one after that
  lookahead_third_block_text$=program_lines$(third_block_ahead&)
  ' the rounding radius R
  element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
  ' the line after the RND block is an L block
  IF LEFT$(following_block_text$,2)="L "
    ' read the end point of the L block
    read_line_target(following_block_text$)
    ' read radius correction, feed and M function of the block
    read_radius_correction(following_block_text$)
    swap_pending_block(-1,0,-1)
  ELSE
    ' the line after the RND block is CC and LP
    set_plane_from_centre(following_block_text$)
    ' evaluate the CC block
    read_circle_centre(following_block_text$)
    ' evaluate the LP block
    interpret_polar_line(lookahead_third_block_text$)
    swap_pending_block(-1,-1,-1)
  ENDIF
  ' the corner seen from the line end
  element_start_x=end_point(first_plane_axis|)
  element_start_y=end_point(second_plane_axis|)
  start_infeed_coordinate=end_point(infeed_axis|)
  ' restore the radius correction
  radius_correction$=saved_radius_correction$
  ' line from its end to the corner
  vector_x=corner_point(first_plane_axis|)-element_start_x
  vector_y=corner_point(second_plane_axis|)-element_start_y
  ' centre to the corner
  second_vector_x=corner_point(first_plane_axis|)-circle_centre(first_plane_axis|)
  second_vector_y=corner_point(second_plane_axis|)-circle_centre(second_plane_axis|)
  ' line length
  line_length=SQR(vector_x*vector_x+vector_y*vector_y)
  ' arc radius
  corner_offset_circle_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
  ' no error so far
  IF NOT run_aborted!
    IF line_length=0
      ' start and end point of the line must differ
      ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' running inside a contour cycle
      IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
        ' in a contour cycle the error is reported at the cycle block
        error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
      ELSE
        error_blocks&(0)=current_block&
      ENDIF
      error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
    ELSE
      IF corner_offset_circle_radius=0
        ' the arc radius must be greater than zero
        ALERT 3,"Kreisradius muû grîûer|als Null sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' running inside a contour cycle
        IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
          ' in a contour cycle the error is reported at the cycle block
          error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
        ELSE
          error_blocks&(0)=next_block&
        ENDIF
        error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
      ELSE
        ' counterclockwise arc
        IF arc_direction$="+"
          line_normal_x=-vector_y
          line_normal_y=vector_x
          radius_normal_x=second_vector_y
          radius_normal_y=-second_vector_x
          rnd_arc_direction$=CHR$(45)
        ELSE
          line_normal_x=vector_y
          line_normal_y=-vector_x
          radius_normal_x=-second_vector_y
          radius_normal_y=second_vector_x
          rnd_arc_direction$=CHR$(43)
        ENDIF
        ' dot product of the two normals
        point_angle=line_normal_x*radius_normal_x+line_normal_y*radius_normal_y
        restore_flag!=FALSE
        ' the normals do not point the same way at the corner
        IF 1E-06>ABS(point_angle) OR point_angle<0
          IF vector_x=0 AND line_normal_x<>0
            line_parameter=circle_centre(second_plane_axis|)-element_start_y
            line_parameter=line_parameter+line_normal_y/line_normal_x*(element_start_x-circle_centre(first_plane_axis|))
            DIV line_parameter,vector_y-line_normal_y*vector_x/line_normal_x
            crossing_point_x=line_parameter*vector_x+element_start_x
            crossing_point_y=line_parameter*vector_y+element_start_y
          ELSE
            IF vector_x<>0
              line_parameter=element_start_y-circle_centre(second_plane_axis|)
              line_parameter=line_parameter+vector_y/vector_x*(circle_centre(first_plane_axis|)-element_start_x)
              DIV line_parameter,line_normal_y-vector_y*line_normal_x/vector_x
              crossing_point_x=circle_centre(first_plane_axis|)+line_parameter*line_normal_x
              crossing_point_y=circle_centre(second_plane_axis|)+line_parameter*line_normal_y
            ENDIF
          ENDIF
          foot_offset_x=element_start_x-crossing_point_x
          foot_offset_y=element_start_y-crossing_point_y
          foot_distance=SQR(foot_offset_x*foot_offset_x+foot_offset_y*foot_offset_y)
          setup_clearance=SQR(vector_x*vector_x+vector_y*vector_y)
          IF second_vector_x=0
            IF element_start_x<circle_centre(first_plane_axis|) OR 9.99999999999997E-06>ABS(element_start_x-circle_centre(first_plane_axis|)) AND (second_vector_y>0 OR 9.99999999999997E-06>ABS(second_vector_y)) OR (element_start_x>circle_centre(first_plane_axis|) AND second_vector_y<0)
              line_parameter=-1
            ELSE
              line_parameter=1
            ENDIF
          ELSE
            normal_x=-second_vector_y
            normal_y=second_vector_x
            line_parameter=circle_centre(second_plane_axis|)-element_start_y+second_vector_y/second_vector_x*(element_start_x-circle_centre(first_plane_axis|))
            DIV line_parameter,normal_y-normal_x*second_vector_y/second_vector_x
          ENDIF
          IF .0001>ABS(line_parameter)
            line_parameter=0
          ENDIF
          ' the side of the centre does not match the arc direction, or the foot point lies beyond the line
          IF line_parameter<=0 AND (arc_direction$="+") OR (line_parameter>=0 AND (arc_direction$="-")) OR foot_distance<setup_clearance
            ' the arc already touches the line
            IF 1E-06>ABS(point_angle)
              ' the arc already joins the line tangentially, so no RND is possible here
              ALERT 3,"Der Kreis schlieût sich|tangential an die Linie an.|Daher ist hier der|RND-Satz nicht mîglich!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the next block (the RND or chamfer block)
              error_blocks&(0)=next_block&
              error_messages$(0)="DER RND-SATZ IST NICHT MôGLICH!"
            ELSE
              ' rounding inside the arc: reverse the normal, the offset circle shrinks
              restore_flag!=TRUE
              line_normal_x=-line_normal_x
              line_normal_y=-line_normal_y
              SUB corner_offset_circle_radius,element_arc_radius
              rnd_arc_direction$=arc_direction$
            ENDIF
          ELSE
            ' rounding outside the arc: the offset circle grows
            corner_offset_circle_radius=corner_offset_circle_radius+element_arc_radius
          ENDIF
        ELSE
          corner_offset_circle_radius=corner_offset_circle_radius+element_arc_radius
        ENDIF
        IF NOT run_aborted!
          ' the line offset by the rounding radius
          end_side_factor=element_arc_radius/line_length
          quadratic_factor=end_side_factor*line_normal_x+element_start_x-circle_centre(first_plane_axis|)
          offset_point_y=end_side_factor*line_normal_y+element_start_y-circle_centre(second_plane_axis|)
          ' intersect it with the offset circle: quadratic in line_parameter
          basic_variables=vector_x*vector_x+vector_y*vector_y
          segment_length=(quadratic_factor*vector_x+offset_point_y*vector_y)*2
          second_operand=quadratic_factor*quadratic_factor+offset_point_y*offset_point_y-corner_offset_circle_radius*corner_offset_circle_radius
          ' discriminant
          discriminant=segment_length*segment_length-basic_variables*4*second_operand
          ' no intersection: the rounding radius is too large
          IF discriminant<0
            ' the rounding radius is too large
            ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the next block (the RND or chamfer block)
            error_blocks&(0)=next_block&
            error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
          ELSE
            discriminant=SQR(discriminant)
            IF restore_flag!
              line_parameter=(-segment_length+discriminant)/2/basic_variables
              IF line_parameter>=1
                line_parameter=(-segment_length-discriminant)/2/basic_variables
              ENDIF
            ELSE
              line_parameter=(-segment_length-discriminant)/2/basic_variables
              IF line_parameter>=1
                line_parameter=(-segment_length+discriminant)/2/basic_variables
              ENDIF
            ENDIF
            ' behind the line end: the radius is too large
            IF line_parameter<0
              ' the rounding radius is too large
              ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the next block (the RND or chamfer block)
              error_blocks&(0)=next_block&
              error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
            ELSE
              ' end of the rounding arc on the line
              rnd_end_x=line_parameter*vector_x+element_start_x
              rnd_end_y=line_parameter*vector_y+element_start_y
              ' centre of the rounding arc
              point_u=end_side_factor*line_normal_x+rnd_end_x
              point_v=end_side_factor*line_normal_y+rnd_end_y
              second_vector_x=circle_centre(first_plane_axis|)-point_u
              second_vector_y=circle_centre(second_plane_axis|)-point_v
              arc_radius=element_arc_radius/corner_offset_circle_radius
              IF restore_flag!
                arc_radius=-arc_radius
              ENDIF
              ' start of the rounding arc on the arc
              rnd_start_x=arc_radius*second_vector_x+point_u
              rnd_start_y=arc_radius*second_vector_y+point_v
              ' save the plane of the element
              cycle_saved_first_axis|=first_plane_axis|
              cycle_saved_second_axis|=second_plane_axis|
              saved_infeed_axis|=infeed_axis|
              ' the arc ends at the start of the rounding
              end_point(first_plane_axis|)=rnd_start_x
              end_point(second_plane_axis|)=rnd_start_y
              ' simulate the shortened arc
              queue_simulated_move(current_block&,arc_direction$,0)
              ' rounding radius above zero
              IF element_arc_radius>0
                ' restore the plane of the element
                first_plane_axis|=cycle_saved_first_axis|
                second_plane_axis|=cycle_saved_second_axis|
                infeed_axis|=saved_infeed_axis|
                end_point(first_plane_axis|)=rnd_end_x
                end_point(second_plane_axis|)=rnd_end_y
                circle_centre(first_plane_axis|)=point_u
                circle_centre(second_plane_axis|)=point_v
                ' simulate the rounding arc
                queue_simulated_move(next_block&,rnd_arc_direction$,0)
                ' the rounding ends at the corner
                IF 1E-06>ABS(corner_point(first_plane_axis|)-rnd_end_x) AND 1E-06>ABS(corner_point(second_plane_axis|)-rnd_end_y)
                  rnd_ends_at_corner!=TRUE
                ELSE
                  ' restore the plane of the element
                  first_plane_axis|=cycle_saved_first_axis|
                  second_plane_axis|=cycle_saved_second_axis|
                  infeed_axis|=saved_infeed_axis|
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' RND between two arcs (program_line$: C, CP, CT, CTP or CR, then C, CP or CR after the RND block): both arcs
' must lie in the same plane and have different centres. The centre of the rounding arc is found from the
' triangle of the two centres and the radii widened or narrowed by the RND radius (depending on both arc
' directions); the first arc is simulated up to the first tangent point, then the rounding arc, and the second
' arc is left to start at the second tangent point.
PROCEDURE round_arc_to_arc(program_line$)
  LOCAL vector_x,vector_y,second_vector_x,second_vector_y,first_centre_x,first_centre_y,second_centre_x,second_centre_y,rnd_centre_x,rnd_centre_y,element_arc_radius,uncompensated_radius,first_vector_length,second_vector_length,rnd_spare_angle,saved_radius,second_offset_radius_squared,element_start_x,element_start_y,start_infeed_coordinate,first_arc_direction$,normal_x,normal_y,centres_y_negated!,alert_button|,rnd_block_text$,following_block_text$,lookahead_third_block_text$,first_arc_end_x,first_arc_end_y,chord_x,chord_y,chord_length,centre_distance_squared,centre_angle_offset,draw_end_angle,line_parameter,rnd_arc_direction$,cycle_saved_first_axis|,cycle_saved_second_axis|,rnd_start_x,rnd_start_y,rnd_end_x,rnd_end_y,saved_radius_correction$,saved_infeed_axis|
  ' start point of the first arc
  element_start_x=start_point(first_plane_axis|)
  element_start_y=start_point(second_plane_axis|)
  start_infeed_coordinate=start_point(infeed_axis|)
  ' type of the first arc
  following_block_text$=LEFT$(program_line$,2)
  IF following_block_text$="C "
    ' has the look-ahead already stored this end point?
    IF end_point_stored!
      swap_pending_block(-1,0,0)
    ELSE
      ' read the end point of the C block
      read_arc_target(program_line$,9,21)
      ' read radius correction, feed and M function of the block
      read_radius_correction(program_line$)
      ' direction DR+ or DR-
      arc_direction$=@read_arc_direction$(program_line$,33)
    ENDIF
  ELSE
    IF following_block_text$="CP"
      ' has the look-ahead already stored this end point?
      IF end_point_stored!
        swap_pending_block(-1,0,0)
      ELSE
        interpret_polar_arc(program_line$)
      ENDIF
    ELSE
      IF following_block_text$="CT"
        IF MID$(program_line$,3,1)="P"
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            ' evaluate the CTP block
            interpret_polar_tangential_arc(program_line$)
          ENDIF
        ELSE
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            ' evaluate the CT block
            interpret_tangential_arc(program_line$)
          ENDIF
        ENDIF
      ELSE
        IF following_block_text$="CR"
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,-1,0)
          ELSE
            interpret_radius_arc(program_line$)
          ENDIF
        ELSE
          ' this kind of block is not allowed here
          ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the current block
          error_blocks&(0)=current_block&
          error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' keep the direction, end point and centre of the first arc
  first_arc_direction$=arc_direction$
  first_arc_end_x=end_point(first_plane_axis|)
  first_arc_end_y=end_point(second_plane_axis|)
  first_centre_x=circle_centre(first_plane_axis|)
  first_centre_y=circle_centre(second_plane_axis|)
  ' save the plane of the element
  cycle_saved_first_axis|=first_plane_axis|
  cycle_saved_second_axis|=second_plane_axis|
  saved_infeed_axis|=infeed_axis|
  ' the RND or chamfer block
  rnd_block_text$=program_lines$(next_block&)
  ' the block after it
  following_block_text$=program_lines$(block_after_next&)
  ' and the one after that
  lookahead_third_block_text$=program_lines$(third_block_ahead&)
  ' type of the block after the CC block
  third_block_type$=LEFT$(lookahead_third_block_text$,2)
  ' the rounding radius R
  element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
  ' the second arc starts at the corner
  start_point(1)=end_point(1)
  start_point(2)=end_point(2)
  start_point(3)=end_point(3)
  ' save the radius correction
  saved_radius_correction$=radius_correction$
  ' C: read the centre and end point
  IF third_block_type$="C "
    ' read the circle centre of the CC block
    set_plane_from_centre(following_block_text$)
    ' evaluate the CC block
    read_circle_centre(following_block_text$)
    ' read the end point of the C block
    read_arc_target(lookahead_third_block_text$,9,21)
    ' read radius correction, feed and M function of the block
    read_radius_correction(lookahead_third_block_text$)
    ' direction DR+ or DR-
    arc_direction$=@read_arc_direction$(lookahead_third_block_text$,33)
  ELSE
    IF third_block_type$="CP"
      ' read the circle centre of the CC block
      set_plane_from_centre(following_block_text$)
      ' evaluate the CC block
      read_circle_centre(following_block_text$)
      ' evaluate the CP block
      interpret_polar_arc(lookahead_third_block_text$)
    ELSE
      ' CT cannot be rounded into
      IF third_block_type$="CT"
        ' an RND block is not possible here
        ALERT 3,"Der RND-Satz ist|hier nicht mîglich!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the third block ahead
        error_blocks&(0)=third_block_ahead&
        error_messages$(0)="RND IST HIER NICHT MôGLICH!"
      ELSE
        ' CR right after the RND block
        IF LEFT$(following_block_text$,2)="CR"
          ' evaluate the CR block
          interpret_radius_arc(following_block_text$)
        ELSE
          ' this kind of block is not allowed here
          ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the block after next
          error_blocks&(0)=block_after_next&
          error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF NOT run_aborted!
    ' both arcs must lie in the same plane
    IF cycle_saved_first_axis|<>first_plane_axis| OR cycle_saved_second_axis|<>second_plane_axis|
      ' both arcs must lie in the same plane
      ALERT 3,"Die Kreisebenen mÅssen|identisch sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the block after next
      error_blocks&(0)=block_after_next&
      error_messages$(0)="DIE KREISEBENEN MöSSEN IDENTISCH SEIN!"
    ELSE
      ' back to the start point of the first arc
      start_point(first_plane_axis|)=element_start_x
      start_point(second_plane_axis|)=element_start_y
      start_point(infeed_axis|)=start_infeed_coordinate
      ' store the end point and centre for the look-ahead
      swap_pending_block(-1,-1,-1)
      ' restore the radius correction
      radius_correction$=saved_radius_correction$
      ' centre of the second arc
      second_centre_x=circle_centre(first_plane_axis|)
      second_centre_y=circle_centre(second_plane_axis|)
      ' first centre to the corner
      vector_x=first_arc_end_x-first_centre_x
      vector_y=first_arc_end_y-first_centre_y
      ' second centre to the end of the second arc
      second_vector_x=end_point(first_plane_axis|)-second_centre_x
      second_vector_y=end_point(second_plane_axis|)-second_centre_y
      ' first radius
      first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
      ' second radius
      second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
      ' an arc is smaller than the rounding radius
      IF first_vector_length<element_arc_radius OR second_vector_length<element_arc_radius
        ' the rounding radius is too large
        ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the next block (the RND or chamfer block)
        error_blocks&(0)=next_block&
        error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
      ELSE
        ' work with a positive second centre y
        IF second_centre_y<0
          centres_y_negated!=TRUE
          first_centre_y=-first_centre_y
          second_centre_y=-second_centre_y
          first_arc_end_y=-first_arc_end_y
        ELSE
          centres_y_negated!=FALSE
        ENDIF
        ' from the first to the second centre
        chord_x=second_centre_x-first_centre_x
        chord_y=second_centre_y-first_centre_y
        ' distance of the centres
        chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
        IF chord_length=0
          ' the arc centres must differ
          ALERT 3,"Kreismittelpunkte mÅssen|verschieden sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          IF third_block_type$="CR"
            error_blocks&(0)=block_after_next&
          ELSE
            error_blocks&(0)=third_block_ahead&
          ENDIF
          error_messages$(0)="KREISMITTELPUNKTE MöSSEN VERSCHIEDEN SEIN!"
        ELSE
          ' angle of the line between the centres
          chord_angle=chord_x/chord_length
          ' arc cosine: the angle of the vector
          chord_angle=@clamped_arc_cosine(chord_angle)
          IF chord_y<0
            ' below the axis: 2*PI minus the angle
            chord_angle=two_pi-chord_angle
          ENDIF
          ' on which side of that line does the corner lie?
          IF chord_x=0
            IF first_arc_end_x>=first_centre_x
              line_parameter=1
            ELSE
              line_parameter=-1
            ENDIF
          ELSE
            normal_x=-chord_y
            normal_y=chord_x
            line_parameter=first_centre_y-first_arc_end_y+chord_y/chord_x*(first_arc_end_x-first_centre_x)
            DIV line_parameter,normal_y-normal_x*chord_y/chord_x
          ENDIF
          ' first centre to the corner
          vector_x=first_arc_end_x-first_centre_x
          vector_y=first_arc_end_y-first_centre_y
          first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
          ' second centre to the corner
          second_vector_x=first_arc_end_x-second_centre_x
          second_vector_y=first_arc_end_y-second_centre_y
          second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
          ' both arcs run the same way
          IF first_arc_direction$=arc_direction$
            IF first_arc_direction$="-"
              IF (NOT centres_y_negated!) AND line_parameter<=0 OR (centres_y_negated! AND line_parameter>0)
                ' both offset radii grow
                uncompensated_radius=first_vector_length+element_arc_radius
                saved_radius=second_vector_length+element_arc_radius
                rnd_arc_direction$=CHR$(43)
              ELSE
                ' both offset radii shrink
                uncompensated_radius=first_vector_length-element_arc_radius
                saved_radius=second_vector_length-element_arc_radius
                rnd_arc_direction$=CHR$(45)
              ENDIF
            ELSE
              IF (NOT centres_y_negated!) AND line_parameter<=0 OR (centres_y_negated! AND line_parameter>0)
                uncompensated_radius=first_vector_length-element_arc_radius
                saved_radius=second_vector_length-element_arc_radius
                rnd_arc_direction$=CHR$(43)
              ELSE
                uncompensated_radius=first_vector_length+element_arc_radius
                saved_radius=second_vector_length+element_arc_radius
                rnd_arc_direction$=CHR$(45)
              ENDIF
            ENDIF
          ELSE
            IF first_arc_direction$="-"
              IF (NOT centres_y_negated!) AND line_parameter<=0 OR (centres_y_negated! AND line_parameter>0)
                uncompensated_radius=first_vector_length-element_arc_radius
                saved_radius=second_vector_length+element_arc_radius
                rnd_arc_direction$=CHR$(45)
              ELSE
                uncompensated_radius=first_vector_length+element_arc_radius
                saved_radius=second_vector_length-element_arc_radius
                rnd_arc_direction$=CHR$(43)
              ENDIF
            ELSE
              IF (NOT centres_y_negated!) AND line_parameter<=0 OR (centres_y_negated! AND line_parameter>0)
                uncompensated_radius=first_vector_length+element_arc_radius
                saved_radius=second_vector_length-element_arc_radius
                rnd_arc_direction$=CHR$(45)
              ELSE
                uncompensated_radius=first_vector_length-element_arc_radius
                saved_radius=second_vector_length+element_arc_radius
                rnd_arc_direction$=CHR$(43)
              ENDIF
            ENDIF
          ENDIF
          ' triangle of the centres and the offset radii
          centre_distance_squared=chord_length*chord_length
          first_offset_radius_squared=uncompensated_radius*uncompensated_radius
          second_offset_radius_squared=saved_radius*saved_radius
          ' cosine law: angle at the first centre
          centre_angle_offset=first_offset_radius_squared+centre_distance_squared-second_offset_radius_squared
          DIV centre_angle_offset,uncompensated_radius*2*chord_length
          centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
          centre_angle_offset=centre_angle_offset+chord_angle
          ' corner on the other side: mirror the angle
          IF line_parameter>0
            SUB centre_angle_offset,(centre_angle_offset-chord_angle)*2
          ENDIF
          ' centre of the rounding arc
          rnd_centre_x=COS(centre_angle_offset)*uncompensated_radius+first_centre_x
          rnd_centre_y=SIN(centre_angle_offset)*uncompensated_radius+first_centre_y
          ' end of the first arc
          rnd_start_x=COS(centre_angle_offset)*first_vector_length+first_centre_x
          rnd_start_y=SIN(centre_angle_offset)*first_vector_length+first_centre_y
          ' undo the negated y
          IF centres_y_negated!
            rnd_centre_y=-rnd_centre_y
            rnd_start_y=-rnd_start_y
            first_centre_y=-first_centre_y
            second_centre_y=-second_centre_y
          ENDIF
          ' from the second centre to the rounding centre
          chord_x=rnd_centre_x-second_centre_x
          chord_y=rnd_centre_y-second_centre_y
          chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
          draw_end_angle=chord_x/chord_length
          ' arc cosine: the angle of the vector
          draw_end_angle=@clamped_arc_cosine(draw_end_angle)
          IF chord_y<0
            ' below the axis: 2*PI minus the angle
            draw_end_angle=two_pi-draw_end_angle
          ENDIF
          ' start of the second arc
          rnd_end_x=COS(draw_end_angle)*second_vector_length+second_centre_x
          rnd_end_y=SIN(draw_end_angle)*second_vector_length+second_centre_y
          ' check both tangent points against the rounding centre
          vector_x=rnd_start_x-rnd_centre_x
          vector_y=rnd_start_y-rnd_centre_y
          first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
          second_vector_x=rnd_end_x-rnd_centre_x
          second_vector_y=rnd_end_y-rnd_centre_y
          second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
          IF .001<ABS(first_vector_length-second_vector_length)
            ' the rounding radius is too large
            ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the next block (the RND or chamfer block)
            error_blocks&(0)=next_block&
            error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
          ELSE
            ' save the plane
            cycle_saved_first_axis|=first_plane_axis|
            cycle_saved_second_axis|=second_plane_axis|
            saved_infeed_axis|=infeed_axis|
            ' the first arc keeps its centre
            circle_centre(first_plane_axis|)=first_centre_x
            circle_centre(second_plane_axis|)=first_centre_y
            ' and ends at the first tangent point
            end_point(first_plane_axis|)=rnd_start_x
            end_point(second_plane_axis|)=rnd_start_y
            end_point(infeed_axis|)=start_point(infeed_axis|)
            ' simulate the shortened first arc
            queue_simulated_move(current_block&,first_arc_direction$,0)
            ' rounding radius above zero
            IF element_arc_radius>0
              ' restore the plane of the element
              first_plane_axis|=cycle_saved_first_axis|
              second_plane_axis|=cycle_saved_second_axis|
              infeed_axis|=saved_infeed_axis|
              ' the rounding arc
              circle_centre(first_plane_axis|)=rnd_centre_x
              circle_centre(second_plane_axis|)=rnd_centre_y
              end_point(first_plane_axis|)=rnd_end_x
              end_point(second_plane_axis|)=rnd_end_y
              ' simulate the rounding arc
              queue_simulated_move(next_block&,rnd_arc_direction$,0)
              IF 1E-06>ABS(first_arc_end_x-rnd_end_x) AND 1E-06>ABS(first_arc_end_y-rnd_end_y)
                rnd_ends_at_corner!=TRUE
              ELSE
                ' restore the plane of the element
                first_plane_axis|=cycle_saved_first_axis|
                second_plane_axis|=cycle_saved_second_axis|
                infeed_axis|=saved_infeed_axis|
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Chamfer (Fase: an L block without coordinates between two lines) after the line program_line$:
' chamfer_without_moves! TRUE only computes, FALSE also simulates the moves. The chamfer length (column 9 of
' block next_block&) must be positive and shorter than the line; in contour mode (in_subprogram_call!) it is
' used as programmed, the finishing allowance being already in tool_radius. With radius compensation the
' corner points of both lines are first moved by the tool radius tool_radius to the correction side
' (compensation_side$ before, radius_correction$ after) and intersected, and a chamfer that the tool cannot
' reach is refused. The first line is simulated up to the chamfer start, then the chamfer to its end on the
' second line.
PROCEDURE chamfer_line_corner(program_line$,chamfer_without_moves!)
  LOCAL chamfer_length,arc_radius,remaining_line_length,first_line_factor,second_line_factor,search_block&,chamfer_saved_correction$,alert_button|,line_parameter,crossing_point_x,crossing_point_y,element_start_x,element_start_y,element_end_x,element_end_y,other_start_x,other_start_y,other_end_x,other_end_y,first_vector_length,corner_intersection_found!,direction_x,direction_y,next_line_dx,next_line_dy,segment_length,offset_scale,chamfer_start_x,chamfer_start_y,chamfer_end_x,chamfer_end_y,corner_on_positive_side!,line_vector_x,line_vector_y,line_vector_z,rnd_block_text$,following_block_text$,work_text$,edit_work_text$,result_text$,cycle_saved_first_axis|,cycle_saved_second_axis|,saved_infeed_axis|
  ' chamfer length
  chamfer_length=@read_number_or_parameter(program_lines$(next_block&),9)
  IF chamfer_length>0
    search_block&=next_block&
    skip_to_previous_block(search_block&)
    work_text$=program_lines$(search_block&)
    search_block&=next_block&
    skip_to_next_block(search_block&)
    edit_work_text$=program_lines$(search_block&)
    skip_to_next_block(search_block&)
    result_text$=program_lines$(search_block&)
    IF (LEFT$(work_text$,2)<>"L ") AND (LEFT$(work_text$,2)<>"LP") OR LEN(work_text$)<20 OR ((LEFT$(edit_work_text$,2)<>"L ") AND (LEFT$(result_text$,2)<>"LP")) OR LEN(edit_work_text$)<20
      ALERT 3,"Vor und nach einer Fase|dÅrfen nur LiniensÑtze|(L,LP) eingegeben werden!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(error_count|)=next_block&
      error_messages$(0)="VOR UND NACH FASE LINIE EINGEBEN!"
    ENDIF
    IF end_point_stored!
      swap_pending_block(-1,0,0)
    ELSE
      IF LEFT$(program_line$,2)="L "
        read_line_target(program_line$)
        read_radius_correction(program_line$)
      ELSE
        interpret_polar_line(program_line$)
      ENDIF
    ENDIF
    corner_point(1)=end_point(1)
    corner_point(2)=end_point(2)
    corner_point(3)=end_point(3)
    chamfer_saved_correction$=radius_correction$
    rnd_block_text$=program_lines$(block_after_next&)
    following_block_text$=program_lines$(third_block_ahead&)
    IF LEFT$(rnd_block_text$,2)="L "
      read_line_target(rnd_block_text$)
      read_radius_correction(rnd_block_text$)
      swap_pending_block(-1,0,-1)
      IF chamfer_saved_correction$="0"
        work_text$=MID$(program_line$,7,1)
        edit_work_text$=MID$(program_line$,19,1)
        result_text$=MID$(program_line$,31,1)
        IF (work_text$=" ") AND (edit_work_text$=" ") OR ((work_text$=" ") AND (result_text$=" ")) OR ((edit_work_text$=" ") AND (result_text$=" ")) OR ((work_text$<>" ") AND (edit_work_text$<>" ") AND (result_text$<>" ")) OR ((work_text$=edit_work_text$) AND (work_text$=edit_work_text$))
          ALERT 3,"Bearbeitungsebene kann|nicht festgestellt werden!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=current_block&
          error_messages$(0)="BEARBEITUNGSEBENE KANN NICHT FESTGESTELLT WERDEN!"
        ELSE
          IF work_text$=" "
            rnd_first_axis|=2
            rnd_second_axis|=3
            rnd_infeed_axis|=1
          ELSE
            IF edit_work_text$=" "
              rnd_first_axis|=3
              rnd_second_axis|=1
              rnd_infeed_axis|=2
            ELSE
              rnd_first_axis|=1
              rnd_second_axis|=2
              rnd_infeed_axis|=3
            ENDIF
          ENDIF
        ENDIF
      ELSE
        rnd_first_axis|=first_plane_axis|
        rnd_second_axis|=second_plane_axis|
        rnd_infeed_axis|=infeed_axis|
      ENDIF
    ELSE
      set_plane_from_centre(rnd_block_text$)
      read_circle_centre(rnd_block_text$)
      interpret_polar_line(following_block_text$)
      swap_pending_block(-1,-1,-1)
      rnd_first_axis|=first_plane_axis|
      rnd_second_axis|=second_plane_axis|
      rnd_infeed_axis|=infeed_axis|
    ENDIF
    element_start_point(1)=end_point(1)
    element_start_point(2)=end_point(2)
    element_start_point(3)=end_point(3)
    IF NOT run_aborted!
      line_vector_x=corner_point(first_plane_axis|)-start_point(first_plane_axis|)
      line_vector_y=corner_point(second_plane_axis|)-start_point(second_plane_axis|)
      line_vector_z=corner_point(infeed_axis|)-start_point(infeed_axis|)
      arc_radius=SQR(line_vector_x*line_vector_x+line_vector_y*line_vector_y+line_vector_z*line_vector_z)
      remaining_line_length=arc_radius-chamfer_length
      IF remaining_line_length>=0
        corner_intersection_found!=FALSE
        direction_x=corner_point(first_plane_axis|)-start_point(first_plane_axis|)
        direction_y=corner_point(second_plane_axis|)-start_point(second_plane_axis|)
        next_line_dx=end_point(first_plane_axis|)-corner_point(first_plane_axis|)
        next_line_dy=end_point(second_plane_axis|)-corner_point(second_plane_axis|)
        IF .0001>ABS(direction_x)
          direction_x=0
        ENDIF
        IF .0001>ABS(direction_y)
          direction_y=0
        ENDIF
        IF .0001>ABS(next_line_dx)
          next_line_dx=0
        ENDIF
        IF .0001>ABS(next_line_dy)
          next_line_dy=0
        ENDIF
        IF (chamfer_saved_correction$<>"0") AND (direction_x<>0 OR direction_y<>0) AND (next_line_dx<>0 OR next_line_dy<>0) AND chamfer_length<tool_radius
          segment_length=SQR(direction_x*direction_x+direction_y*direction_y)
          offset_scale=tool_radius/segment_length
          IF compensation_side$="L"
            IF direction_x=0
              IF direction_y>0
                element_start_x=start_point(first_plane_axis|)-tool_radius
              ELSE
                element_start_x=tool_radius+start_point(first_plane_axis|)
              ENDIF
              element_start_y=start_point(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x<0
                  element_start_y=start_point(second_plane_axis|)-tool_radius
                ELSE
                  element_start_y=tool_radius+start_point(second_plane_axis|)
                ENDIF
                element_start_x=start_point(first_plane_axis|)
              ELSE
                element_start_x=start_point(first_plane_axis|)-direction_y*offset_scale
                element_start_y=start_point(second_plane_axis|)+direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            IF compensation_side$="R"
              IF direction_x=0
                IF direction_y<0
                  element_start_x=start_point(first_plane_axis|)-tool_radius
                ELSE
                  element_start_x=tool_radius+start_point(first_plane_axis|)
                ENDIF
                element_start_y=start_point(second_plane_axis|)
              ELSE
                IF direction_y=0
                  IF direction_x>0
                    element_start_y=start_point(second_plane_axis|)-tool_radius
                  ELSE
                    element_start_y=tool_radius+start_point(second_plane_axis|)
                  ENDIF
                  element_start_x=start_point(first_plane_axis|)
                ELSE
                  element_start_x=start_point(first_plane_axis|)+direction_y*offset_scale
                  element_start_y=start_point(second_plane_axis|)-direction_x*offset_scale
                ENDIF
              ENDIF
            ELSE
              element_start_x=start_point(first_plane_axis|)
              element_start_y=start_point(second_plane_axis|)
            ENDIF
          ENDIF
          IF chamfer_saved_correction$="L"
            IF direction_x=0
              IF direction_y>0
                element_end_x=corner_point(first_plane_axis|)-tool_radius
              ELSE
                element_end_x=tool_radius+corner_point(first_plane_axis|)
              ENDIF
              element_end_y=corner_point(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x<0
                  element_end_y=corner_point(second_plane_axis|)-tool_radius
                ELSE
                  element_end_y=tool_radius+corner_point(second_plane_axis|)
                ENDIF
                element_end_x=corner_point(first_plane_axis|)
              ELSE
                element_start_x=corner_point(first_plane_axis|)-direction_y*offset_scale
                element_start_y=corner_point(second_plane_axis|)+direction_x*offset_scale
              ENDIF
            ENDIF
          ELSE
            IF chamfer_saved_correction$="R"
              IF direction_x=0
                IF direction_y<0
                  element_end_x=corner_point(first_plane_axis|)-tool_radius
                ELSE
                  element_end_x=tool_radius+corner_point(first_plane_axis|)
                ENDIF
                element_end_y=corner_point(second_plane_axis|)
              ELSE
                IF direction_y=0
                  IF direction_x>0
                    element_end_y=corner_point(second_plane_axis|)-tool_radius
                  ELSE
                    element_end_y=tool_radius+corner_point(second_plane_axis|)
                  ENDIF
                  element_end_x=corner_point(first_plane_axis|)
                ELSE
                  element_start_x=corner_point(first_plane_axis|)+direction_y*offset_scale
                  element_start_y=corner_point(second_plane_axis|)-direction_x*offset_scale
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF chamfer_saved_correction$="L"
            IF next_line_dx=0
              IF next_line_dy>0
                other_start_x=corner_point(first_plane_axis|)-tool_radius
              ELSE
                other_start_x=tool_radius+corner_point(first_plane_axis|)
              ENDIF
              other_start_y=corner_point(second_plane_axis|)
            ELSE
              IF next_line_dy=0
                IF next_line_dx<0
                  other_start_y=corner_point(second_plane_axis|)-tool_radius
                ELSE
                  other_start_y=tool_radius+corner_point(second_plane_axis|)
                ENDIF
                other_start_x=corner_point(first_plane_axis|)
              ELSE
                segment_length=SQR(next_line_dy*next_line_dy/(next_line_dx*next_line_dx)+1)
                IF next_line_dx>0 AND next_line_dy<>0
                  other_start_x=corner_point(first_plane_axis|)+tool_radius*next_line_dy/next_line_dx/segment_length
                  other_start_y=corner_point(second_plane_axis|)+tool_radius/segment_length
                ELSE
                  other_start_x=corner_point(first_plane_axis|)-tool_radius*next_line_dy/next_line_dx/segment_length
                  other_start_y=corner_point(second_plane_axis|)-tool_radius/segment_length
                ENDIF
              ENDIF
            ENDIF
          ELSE
            IF chamfer_saved_correction$="R"
              IF next_line_dx=0
                IF next_line_dy<0
                  other_start_x=corner_point(first_plane_axis|)-tool_radius
                ELSE
                  other_start_x=tool_radius+corner_point(first_plane_axis|)
                ENDIF
                other_start_y=corner_point(second_plane_axis|)
              ELSE
                IF next_line_dy=0
                  IF next_line_dx>0
                    other_start_y=corner_point(second_plane_axis|)-tool_radius
                  ELSE
                    other_start_y=tool_radius+corner_point(second_plane_axis|)
                  ENDIF
                  other_start_x=corner_point(first_plane_axis|)
                ELSE
                  segment_length=SQR(next_line_dy*next_line_dy/(next_line_dx*next_line_dx)+1)
                  IF next_line_dx>0 AND next_line_dy<>0
                    other_start_x=corner_point(first_plane_axis|)-tool_radius*next_line_dy/next_line_dx/segment_length
                    other_start_y=corner_point(second_plane_axis|)-tool_radius/segment_length
                  ELSE
                    other_start_x=corner_point(first_plane_axis|)+tool_radius*next_line_dy/next_line_dx/segment_length
                    other_start_y=corner_point(second_plane_axis|)+tool_radius/segment_length
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF radius_correction$="L"
            IF next_line_dx=0
              IF next_line_dy>0
                other_end_x=end_point(first_plane_axis|)-tool_radius
              ELSE
                other_end_x=tool_radius+end_point(first_plane_axis|)
              ENDIF
              other_end_y=end_point(second_plane_axis|)
            ELSE
              IF next_line_dy=0
                IF next_line_dx<0
                  other_end_y=end_point(second_plane_axis|)-tool_radius
                ELSE
                  other_end_y=tool_radius+end_point(second_plane_axis|)
                ENDIF
                other_end_x=end_point(first_plane_axis|)
              ELSE
                segment_length=SQR(next_line_dy*next_line_dy/(next_line_dx*next_line_dx)+1)
                IF next_line_dx>0 AND next_line_dy<>0
                  other_end_x=end_point(first_plane_axis|)+tool_radius*next_line_dy/next_line_dx/segment_length
                  other_end_y=end_point(second_plane_axis|)+tool_radius/segment_length
                ELSE
                  other_end_x=end_point(first_plane_axis|)-tool_radius*next_line_dy/next_line_dx/segment_length
                  other_end_y=end_point(second_plane_axis|)-tool_radius/segment_length
                ENDIF
              ENDIF
            ENDIF
          ELSE
            IF radius_correction$="R"
              IF next_line_dx=0
                IF next_line_dy<0
                  other_end_x=end_point(first_plane_axis|)-tool_radius
                ELSE
                  other_end_x=tool_radius+end_point(first_plane_axis|)
                ENDIF
                other_end_y=end_point(second_plane_axis|)
              ELSE
                IF next_line_dy=0
                  IF next_line_dx>0
                    other_end_y=end_point(second_plane_axis|)-tool_radius
                  ELSE
                    other_end_y=tool_radius+end_point(second_plane_axis|)
                  ENDIF
                  other_end_x=end_point(first_plane_axis|)
                ELSE
                  segment_length=SQR(next_line_dy*next_line_dy/(next_line_dx*next_line_dx)+1)
                  IF next_line_dx>0 AND next_line_dy<>0
                    other_end_x=end_point(first_plane_axis|)-tool_radius*next_line_dy/next_line_dx/segment_length
                    other_end_y=end_point(second_plane_axis|)-tool_radius/segment_length
                  ELSE
                    other_end_x=end_point(first_plane_axis|)+tool_radius*next_line_dy/next_line_dx/segment_length
                    other_end_y=end_point(second_plane_axis|)+tool_radius/segment_length
                  ENDIF
                ENDIF
              ENDIF
            ELSE
              other_start_x=end_point(first_plane_axis|)
              other_start_y=end_point(second_plane_axis|)
            ENDIF
          ENDIF
          IF direction_x=0
            IF other_end_x>element_start_x AND direction_y<0 OR (other_end_x<element_start_x AND direction_y>=0)
              line_parameter=-1
            ELSE
              line_parameter=1
            ENDIF
          ELSE
            normal_direction_x=-direction_y
            normal_direction_y=direction_x
            line_parameter=element_start_y-other_end_y+direction_y/direction_x*(other_end_x-element_start_x)
            DIV line_parameter,normal_direction_y-normal_direction_x*direction_y/direction_x
          ENDIF
          IF line_parameter<0
            corner_on_positive_side!=FALSE
          ELSE
            corner_on_positive_side!=TRUE
          ENDIF
          IF .0001>ABS(line_parameter) OR (line_parameter<0 AND (chamfer_saved_correction$="R")) OR (line_parameter>0 AND (chamfer_saved_correction$="L"))
          ELSE
            corner_intersection_found!=TRUE
            IF direction_x=0 AND next_line_dx<>0
              line_parameter=other_start_y-element_start_y+next_line_dy/next_line_dx*(element_start_x-other_start_x)
              DIV line_parameter,direction_y-next_line_dy*direction_x/next_line_dx
              crossing_point_x=line_parameter*direction_x+element_start_x
              crossing_point_y=line_parameter*direction_y+element_start_y
              IF line_parameter<0
                ALERT 3,"FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                ' fill pass of a contour cycle
                IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                  error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                ELSE
                  error_blocks&(0)=current_draw_block&
                ENDIF
                error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
              ENDIF
            ELSE
              IF direction_x<>0
                line_parameter=element_start_y-other_start_y+direction_y/direction_x*(other_start_x-element_start_x)
                DIV line_parameter,next_line_dy-direction_y*next_line_dx/direction_x
                crossing_point_x=line_parameter*next_line_dx+other_start_x
                crossing_point_y=line_parameter*next_line_dy+other_start_y
                IF line_parameter<0
                  ALERT 3,"FrÑserradius ist|zu groû!",1,"Abbruch",alert_button|
                  run_aborted!=TRUE
                  IF in_subprogram_call! OR rough_out_cycle_active! OR contour_cycle_active!
                    error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
                  ELSE
                    error_blocks&(0)=current_draw_block&
                  ENDIF
                  error_messages$(0)="FRéSERRADIUS IST ZU GROSS!"
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' no error so far
        IF NOT run_aborted!
          first_line_factor=remaining_line_length/arc_radius
          MUL line_vector_x,first_line_factor
          MUL line_vector_y,first_line_factor
          MUL line_vector_z,first_line_factor
          chamfer_start_x=line_vector_x+start_point(first_plane_axis|)
          chamfer_start_y=line_vector_y+start_point(second_plane_axis|)
          chamfer_start_z=line_vector_z+start_point(infeed_axis|)
          line_vector_x=element_start_point(first_plane_axis|)-corner_point(first_plane_axis|)
          line_vector_y=element_start_point(second_plane_axis|)-corner_point(second_plane_axis|)
          line_vector_z=element_start_point(infeed_axis|)-corner_point(infeed_axis|)
          ' length of the first line
          arc_radius=SQR(line_vector_x*line_vector_x+line_vector_y*line_vector_y+line_vector_z*line_vector_z)
          IF arc_radius>0
            second_line_factor=chamfer_length/arc_radius
            MUL line_vector_x,second_line_factor
            MUL line_vector_y,second_line_factor
            MUL line_vector_z,second_line_factor
            chamfer_end_x=line_vector_x+corner_point(first_plane_axis|)
            chamfer_end_y=line_vector_y+corner_point(second_plane_axis|)
            chamfer_end_z=line_vector_z+corner_point(infeed_axis|)
            IF corner_intersection_found!
              direction_x=chamfer_end_x-chamfer_start_x
              direction_y=chamfer_end_y-chamfer_start_y
              arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
              DIV direction_x,arc_radius
              DIV direction_y,arc_radius
              IF corner_on_positive_side!
                normal_h=direction_y
                normal_v=-direction_x
              ELSE
                normal_h=-direction_y
                normal_v=direction_x
              ENDIF
              first_vector_length=(crossing_point_x-chamfer_start_x)*normal_h+(crossing_point_y-chamfer_start_y)*normal_v
              IF tool_radius<ABS(first_vector_length) AND .0001<ABS(first_vector_length-tool_radius) AND first_vector_length>=0
                ALERT 3,"FasenlÑnge|ist zu klein!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=next_block&
                error_messages$(0)="FASENLéNGE IST ZU KLEIN!"
              ENDIF
            ENDIF
            ' no error
            IF NOT run_aborted!
              end_point(first_plane_axis|)=chamfer_start_x
              end_point(second_plane_axis|)=chamfer_start_y
              end_point(infeed_axis|)=chamfer_start_z
              IF NOT chamfer_without_moves!
                cycle_saved_first_axis|=first_plane_axis|
                cycle_saved_second_axis|=second_plane_axis|
                saved_infeed_axis|=infeed_axis|
                first_plane_axis|=tool_first_axis|
                second_plane_axis|=tool_second_axis|
                infeed_axis|=depth_axis|
                queue_simulated_move(current_block&,"-",-1)
                IF NOT run_aborted!
                  first_plane_axis|=cycle_saved_first_axis|
                  second_plane_axis|=cycle_saved_second_axis|
                  infeed_axis|=saved_infeed_axis|
                  end_point(first_plane_axis|)=chamfer_end_x
                  end_point(second_plane_axis|)=chamfer_end_y
                  end_point(infeed_axis|)=chamfer_end_z
                  first_plane_axis|=tool_first_axis|
                  second_plane_axis|=tool_second_axis|
                  infeed_axis|=depth_axis|
                  queue_simulated_move(next_block&,"-",-1)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ELSE
          ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=block_after_next&
          error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
        ENDIF
      ELSE
        ALERT 3,"FasenlÑnge muû kleiner|als LÑnge der Linie sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the next block (the RND or chamfer block)
        error_blocks&(0)=next_block&
        error_messages$(0)="FASENLéNGE MUSS KLEINER ALS LINIENLéNGE SEIN!"
      ENDIF
    ENDIF
    radius_correction$=chamfer_saved_correction$
  ELSE
    ALERT 3,"FasenlÑnge muû grîûer|als Null sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' the error is reported at the next block (the RND or chamfer block)
    error_blocks&(0)=next_block&
    error_messages$(0)="FASENLéNGE MUSS GRôSSER ALS NULL SEIN!"
  ENDIF
RETURN
' Tangential approach: the line program_line$ without radius compensation, then an RND block next_block&, then
' the first contour block block_after_next& (L, CC+LP, CR or CC+C/CP) with correction RL or RR. Computes the
' compensated start point of the contour and a rounding arc of the RND radius that ends there tangentially,
' simulates the line up to the tangent point and the arc, and switches the correction
' radius_correction$/compensation_side$ on.
PROCEDURE approach_contour_tangentially(program_line$)
  LOCAL work_text$,element_arc_radius,saved_radius,line_normal_x,line_normal_y,normal_x,normal_y,chord_length,centre_distance_squared,centre_angle_offset,basic_variables,chord_x,chord_y,line_parameter,chord_angle,rnd_block_text$,following_block_text$,lookahead_third_block_text$,element_start_x,element_start_y,start_infeed_coordinate,corner_x,corner_y,corner_z,vector_x,vector_y,arc_radius,second_vector_x,second_vector_y,edit_work_text$,normal_h,normal_v,compensated_radius,start_radius,radius_dot_product,point_u,point_v,rnd_arc_direction$,arc_tangent_x,arc_tangent_y,saved_radius_correction$,radius_direction_sign,alert_button|,corner_distance,last_element_was_line!
  ' approach line already stored by the look-ahead
  IF end_point_stored!
    swap_pending_block(-1,0,0)
  ELSE
    ' read the end point of the L block
    read_line_target(program_line$)
    read_radius_correction(program_line$)
  ENDIF
  ' keep the end of the approach line (the corner)
  corner_x=end_point(first_plane_axis|)
  corner_y=end_point(second_plane_axis|)
  corner_z=end_point(infeed_axis|)
  ' keep it for the look-ahead too
  rounding_target(1)=end_point(1)
  rounding_target(2)=end_point(2)
  rounding_target(3)=end_point(3)
  ' the RND or chamfer block
  rnd_block_text$=program_lines$(next_block&)
  ' the block after it
  following_block_text$=program_lines$(block_after_next&)
  ' and the one after that
  lookahead_third_block_text$=program_lines$(third_block_ahead&)
  ' the rounding radius R
  element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
  IF element_arc_radius=0
    ' the arc radius must be greater than zero
    ALERT 3,"Der Kreisradius muû|grîûer als Null sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' running inside a contour cycle
    IF rough_out_cycle_active! OR contour_cycle_active!
      ' in a contour cycle the error is reported at the cycle block
      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
    ELSE
      error_blocks&(0)=next_block&
    ENDIF
    error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
  ELSE
    ' start of the approach line
    element_start_x=start_point(first_plane_axis|)
    element_start_y=start_point(second_plane_axis|)
    start_infeed_coordinate=start_point(infeed_axis|)
    ' from the corner back to the start
    vector_x=element_start_x-corner_x
    vector_y=element_start_y-corner_y
    ' length of the approach line
    corner_distance=SQR(vector_x*vector_x+vector_y*vector_y)
    ' room needed: rounding diameter plus tool radius
    basic_variables=element_arc_radius*2+tool_radius
    IF corner_distance=0
      ' start and end point of the line must differ
      ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      ' the error is reported at the current block
      error_blocks&(0)=current_block&
      error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
    ELSE
      ' the approach line is too short
      IF basic_variables>corner_distance
        ' the rounding radius or the tool radius is too large
        ALERT 3,"Der RND-Radius oder|der FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the next block (the RND or chamfer block)
        error_blocks&(0)=next_block&
        error_messages$(0)="RND- ODER FRéSERRADIUS IST ZU GROSS!"
      ELSE
        ' type of the first contour block
        work_text$=LEFT$(following_block_text$,2)
        edit_work_text$=LEFT$(lookahead_third_block_text$,2)
        ' save the radius correction
        saved_radius_correction$=radius_correction$
        ' L, or CC and LP
        IF (work_text$="L ") OR ((work_text$="CC") AND (edit_work_text$="LP"))
          last_element_was_line!=FALSE
          IF work_text$="L "
            ' read the end point of the L block
            read_line_target(following_block_text$)
            ' read radius correction, feed and M function of the block
            read_radius_correction(following_block_text$)
            swap_pending_block(-1,0,-1)
          ELSE
            ' read the circle centre of the CC block
            set_plane_from_centre(following_block_text$)
            ' evaluate the CC block
            read_circle_centre(following_block_text$)
            ' evaluate the LP block
            interpret_polar_line(lookahead_third_block_text$)
            swap_pending_block(-1,-1,-1)
          ENDIF
          ' direction of the first contour line
          second_vector_x=end_point(first_plane_axis|)-corner_x
          second_vector_y=end_point(second_plane_axis|)-corner_y
          IF 1E-10>ABS(vector_x*second_vector_y-vector_y*second_vector_x)
            ' the lines before and after RND must not be parallel
            ALERT 3,"Linien vor und nach|RND dÅrfen nicht|parallel sein!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the current block
            error_blocks&(0)=current_block&
            error_messages$(0)="LINIEN VOR UND NACH >RND< DöRFEN NICHT PARALLEL SEIN!"
          ELSE
            IF second_vector_x*second_vector_x+second_vector_y*second_vector_y=0
              ' start and end point of the line must differ
              ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the block after next
              error_blocks&(0)=block_after_next&
              error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
            ELSE
              ' on which side of the contour line does the approach start?
              normal_h=corner_x-element_start_x
              normal_v=corner_y-element_start_y
              IF normal_h=0
                IF element_start_x>end_point(first_plane_axis|) OR 9.99999999999997E-06>ABS(end_point(first_plane_axis|)-element_start_x) AND (normal_v>0 OR 9.99999999999997E-06>ABS(normal_v)) OR (element_start_x<end_point(first_plane_axis|) AND normal_v<0)
                  line_parameter=-1
                ELSE
                  line_parameter=1
                ENDIF
              ELSE
                normal_x=-normal_v
                normal_y=normal_h
                line_parameter=element_start_y-end_point(second_plane_axis|)+normal_v/normal_h*(end_point(first_plane_axis|)-element_start_x)
                DIV line_parameter,normal_y-normal_x*normal_v/normal_h
              ENDIF
              IF .0001>ABS(line_parameter)
                line_parameter=0
              ENDIF
              ' normal of the contour line towards the approach side
              IF line_parameter<=0
                line_normal_x=-second_vector_y
                line_normal_y=second_vector_x
              ELSE
                line_normal_x=second_vector_y
                line_normal_y=-second_vector_x
              ENDIF
              segment_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
              ' tool radius per unit of length
              offset_scale=tool_radius/segment_length
              ' RL: compensated contour start to the left of the contour line
              IF saved_radius_correction$="L"
                IF second_vector_x=0
                  IF second_vector_y>0
                    corner_point(first_plane_axis|)=corner_x-tool_radius
                  ELSE
                    corner_point(first_plane_axis|)=corner_x+tool_radius
                  ENDIF
                  corner_point(second_plane_axis|)=corner_y
                ELSE
                  IF second_vector_y=0
                    IF second_vector_x<0
                      corner_point(second_plane_axis|)=corner_y-tool_radius
                    ELSE
                      corner_point(second_plane_axis|)=corner_y+tool_radius
                    ENDIF
                    corner_point(first_plane_axis|)=corner_x
                  ELSE
                    corner_point(first_plane_axis|)=corner_x-second_vector_y*offset_scale
                    corner_point(second_plane_axis|)=second_vector_x*offset_scale+corner_y
                  ENDIF
                ENDIF
              ELSE
                ' RR: to the right
                IF saved_radius_correction$="R"
                  IF second_vector_x=0
                    IF second_vector_y<0
                      corner_point(first_plane_axis|)=corner_x-tool_radius
                    ELSE
                      corner_point(first_plane_axis|)=corner_x+tool_radius
                    ENDIF
                    corner_point(second_plane_axis|)=corner_y
                  ELSE
                    IF second_vector_y=0
                      IF second_vector_x>0
                        corner_point(second_plane_axis|)=corner_y-tool_radius
                      ELSE
                        corner_point(second_plane_axis|)=corner_y+tool_radius
                      ENDIF
                      corner_point(first_plane_axis|)=corner_x
                    ELSE
                      corner_point(first_plane_axis|)=second_vector_y*offset_scale+corner_x
                      corner_point(second_plane_axis|)=corner_y-second_vector_x*offset_scale
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ELSE
          ' CR, or CC and C/CP
          IF (work_text$="CR") OR ((work_text$="CC") AND ((edit_work_text$="C ") OR (edit_work_text$="CP")))
            last_element_was_line!=TRUE
            IF work_text$="CR"
              ' the end point becomes the start of the next element
              start_point(1)=end_point(1)
              start_point(2)=end_point(2)
              start_point(3)=end_point(3)
              ' evaluate it from the corner
              interpret_radius_arc(following_block_text$)
              ' restore the start point
              start_point(first_plane_axis|)=element_start_x
              start_point(second_plane_axis|)=element_start_y
              start_point(infeed_axis|)=start_infeed_coordinate
            ELSE
              IF edit_work_text$="C "
                ' read the circle centre of the CC block
                set_plane_from_centre(following_block_text$)
                ' evaluate the CC block
                read_circle_centre(following_block_text$)
                ' read the end point of the C block
                read_arc_target(lookahead_third_block_text$,9,21)
                ' direction DR+ or DR-
                arc_direction$=@read_arc_direction$(lookahead_third_block_text$,33)
                ' read radius correction, feed and M function of the block
                read_radius_correction(lookahead_third_block_text$)
              ELSE
                ' the end point becomes the start of the next element
                start_point(1)=end_point(1)
                start_point(2)=end_point(2)
                start_point(3)=end_point(3)
                ' read the circle centre of the CC block
                set_plane_from_centre(following_block_text$)
                ' evaluate the CC block
                read_circle_centre(following_block_text$)
                ' evaluate the CP block
                interpret_polar_arc(lookahead_third_block_text$)
                start_point(first_plane_axis|)=element_start_x
                start_point(second_plane_axis|)=element_start_y
                start_point(infeed_axis|)=start_infeed_coordinate
              ENDIF
            ENDIF
            ' store the end point and centre for the look-ahead
            swap_pending_block(-1,-1,-1)
            ' corner seen from the arc centre
            vector_x=circle_centre(first_plane_axis|)-corner_x
            vector_y=circle_centre(second_plane_axis|)-corner_y
            ' arc radius
            compensated_radius=SQR(vector_x*vector_x+vector_y*vector_y)
            ' corner to the approach start
            second_vector_x=element_start_x-corner_x
            second_vector_y=element_start_y-corner_y
            start_radius=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
            ' the arc radius is zero
            IF 1E-06>ABS(compensated_radius)
              ' the arc radius must be greater than zero
              ALERT 3,"Kreisradius muû grîûer|als Null sein !",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              IF work_text$="CR"
                error_blocks&(0)=block_after_next&
              ELSE
                error_blocks&(0)=third_block_ahead&
              ENDIF
              error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
            ELSE
              ' angle between the radius and the approach line
              radius_dot_product=vector_x*second_vector_x+vector_y*second_vector_y
              radius_direction_sign=radius_dot_product
              DIV radius_dot_product,compensated_radius*start_radius
              IF radius_dot_product>=1
                radius_dot_product=0
              ELSE
                IF radius_dot_product<=-1
                  radius_dot_product=PI
                ENDIF
              ENDIF
              IF arc_direction$="-"
                line_parameter=-1
              ELSE
                line_parameter=1
              ENDIF
              ' approach from outside the arc
              IF radius_direction_sign>0
                line_normal_x=vector_x
                line_normal_y=vector_y
                line_parameter=-line_parameter
              ELSE
                line_normal_x=-vector_x
                line_normal_y=-vector_y
              ENDIF
              ' compensated radius: tool on the outside or the inside of the arc
              saved_radius=compensated_radius
              IF saved_radius_correction$="R"
                IF arc_direction$="+"
                  compensated_radius=compensated_radius+tool_radius
                ELSE
                  SUB compensated_radius,tool_radius
                ENDIF
              ELSE
                IF saved_radius_correction$="L"
                  IF arc_direction$="-"
                    compensated_radius=compensated_radius+tool_radius
                  ELSE
                    SUB compensated_radius,tool_radius
                  ENDIF
                ENDIF
              ENDIF
              ' compensated contour start on the radius
              vector_x=-vector_x
              vector_y=-vector_y
              corner_point(first_plane_axis|)=compensated_radius/saved_radius*vector_x+circle_centre(first_plane_axis|)
              corner_point(second_plane_axis|)=compensated_radius/saved_radius*vector_y+circle_centre(second_plane_axis|)
            ENDIF
          ELSE
            ' this kind of block is not allowed here
            ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the block after next
            error_blocks&(0)=block_after_next&
            error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
          ENDIF
        ENDIF
        ' no error
        IF NOT run_aborted!
          ' centre of the rounding arc: one rounding radius from the compensated start
          arc_radius=SQR(line_normal_x*line_normal_x+line_normal_y*line_normal_y)
          arc_radius=element_arc_radius/arc_radius
          point_u=arc_radius*line_normal_x+corner_point(first_plane_axis|)
          point_v=arc_radius*line_normal_y+corner_point(second_plane_axis|)
          IF 1E-06>ABS(basic_variables-corner_distance)
            rounding_active!=TRUE
            IF line_parameter>0 OR .0001>ABS(line_parameter)
              rnd_arc_direction$=CHR$(45)
            ELSE
              rnd_arc_direction$=CHR$(43)
            ENDIF
            ' simulate the rounding arc straight from the approach start
            radius_correction$=CHR$(48)
            end_point(first_plane_axis|)=corner_point(first_plane_axis|)
            end_point(second_plane_axis|)=corner_point(second_plane_axis|)
            end_point(infeed_axis|)=corner_z
            circle_centre(first_plane_axis|)=point_u
            circle_centre(second_plane_axis|)=point_v
            ' simulate the rounding arc
            queue_simulated_move(next_block&,rnd_arc_direction$,0)
            ' switch the correction on
            compensation_side$=saved_radius_correction$
            ' restore the radius correction
            radius_correction$=saved_radius_correction$
          ELSE
            ' start of the approach seen from the rounding centre
            chord_x=element_start_x-point_u
            chord_y=element_start_y-point_v
            chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
            chord_angle=chord_x/chord_length
            ' arc cosine: the angle of the vector
            chord_angle=@clamped_arc_cosine(chord_angle)
            IF chord_y<0
              ' below the axis: 2*PI minus the angle
              chord_angle=two_pi-chord_angle
            ENDIF
            ' tangent from the approach start to the rounding circle
            centre_distance_squared=chord_length*chord_length
            saved_radius=element_arc_radius*element_arc_radius
            basic_variables=centre_distance_squared-saved_radius
            ' the start lies inside the rounding circle
            IF basic_variables<0
              ' the rounding radius is too large
              ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the next block (the RND or chamfer block)
              error_blocks&(0)=next_block&
              error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
            ELSE
              basic_variables=SQR(basic_variables)
              ' angle at the rounding centre
              centre_angle_offset=saved_radius+centre_distance_squared-basic_variables*basic_variables
              DIV centre_angle_offset,element_arc_radius*2*chord_length
              centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
              IF line_parameter>0 OR .0001>ABS(line_parameter)
                centre_angle_offset=-centre_angle_offset
                rnd_arc_direction$=CHR$(45)
              ELSE
                rnd_arc_direction$=CHR$(43)
              ENDIF
              ' tangent point on the rounding circle
              centre_angle_offset=centre_angle_offset+chord_angle
              arc_tangent_x=COS(centre_angle_offset)*element_arc_radius+point_u
              arc_tangent_y=SIN(centre_angle_offset)*element_arc_radius+point_v
              ' the approach line itself without correction
              radius_correction$=CHR$(48)
              end_point(first_plane_axis|)=arc_tangent_x
              end_point(second_plane_axis|)=arc_tangent_y
              end_point(infeed_axis|)=corner_z
              ' simulate the approach line up to the tangent point
              queue_simulated_move(current_block&,arc_direction$,-1)
              rounding_active!=TRUE
              ' then the rounding arc to the compensated contour start
              end_point(first_plane_axis|)=corner_point(first_plane_axis|)
              end_point(second_plane_axis|)=corner_point(second_plane_axis|)
              circle_centre(first_plane_axis|)=point_u
              circle_centre(second_plane_axis|)=point_v
              ' simulate the rounding arc
              queue_simulated_move(next_block&,rnd_arc_direction$,0)
              ' switch the correction on
              compensation_side$=saved_radius_correction$
              ' restore the radius correction
              radius_correction$=saved_radius_correction$
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Tangential departure: the last contour block program_line$ (L, LP, C, CP, CR, CT or CTP) with RL/RR, then an
' RND block next_block&, then the line block_after_next& with correction R0. Computes the compensated end point
' of the contour, a rounding arc of the RND radius leaving it tangentially, and the point where it meets the
' departure line, and simulates the contour block and the rounding arc; previous_block_start() keeps the
' compensated corner.
PROCEDURE depart_contour_tangentially(program_line$)
  LOCAL work_text$,element_arc_radius,saved_radius,line_normal_x,line_normal_y,normal_x,normal_y,chord_length,centre_distance_squared,centre_angle_offset,corner_distance,basic_variables,chord_x,chord_y,line_parameter,chord_angle,rnd_block_text$,following_block_text$,element_start_x,element_start_y,start_infeed_coordinate,polar_angle,polar_radius,point_distance,work_point_y,radius_dot_product,last_element_was_line!,corner_x,corner_y,corner_z,element_end_x,element_end_y,end_height,vector_x,vector_y,second_vector_x,second_vector_y,normal_h,normal_v,arc_radius,arc_tangent_x,arc_tangent_y,alert_button|,point_u,point_v,saved_radius_correction$
  ' start point of the last contour block
  element_start_x=start_point(first_plane_axis|)
  element_start_y=start_point(second_plane_axis|)
  start_infeed_coordinate=start_point(infeed_axis|)
  ' the RND or chamfer block
  rnd_block_text$=program_lines$(next_block&)
  ' the block after it
  following_block_text$=program_lines$(block_after_next&)
  ' the rounding radius R
  element_arc_radius=@read_number_or_parameter(rnd_block_text$,8)
  IF element_arc_radius=0
    ' the arc radius must be greater than zero
    ALERT 3,"Der Kreisradius muû|grîûer als Null sein!",1,"Abbruch",alert_button|
    run_aborted!=TRUE
    ' running inside a contour cycle
    IF rough_out_cycle_active! OR contour_cycle_active!
      ' in a contour cycle the error is reported at the cycle block
      error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
    ELSE
      error_blocks&(0)=next_block&
    ENDIF
    error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
  ELSE
    ' type of the last contour block
    work_text$=LEFT$(program_line$,2)
    ' a line
    IF (work_text$="L ") OR (work_text$="LP")
      last_element_was_line!=TRUE
      IF work_text$="L "
        ' has the look-ahead already stored this end point?
        IF end_point_stored!
          swap_pending_block(-1,0,0)
        ELSE
          ' read the end point of the L block
          read_line_target(program_line$)
          read_radius_correction(program_line$)
        ENDIF
      ELSE
        ' has the look-ahead already stored this end point?
        IF end_point_stored!
          swap_pending_block(-1,0,0)
        ELSE
          interpret_polar_line(program_line$)
        ENDIF
      ENDIF
      ' end of the contour line (the corner)
      corner_x=end_point(first_plane_axis|)
      corner_y=end_point(second_plane_axis|)
      corner_z=end_point(infeed_axis|)
      ' read the departure line
      read_line_target(following_block_text$)
      element_end_x=end_point(first_plane_axis|)
      element_end_y=end_point(second_plane_axis|)
      end_height=end_point(infeed_axis|)
      ' contour line from the corner
      vector_x=element_end_x-corner_x
      vector_y=element_end_y-corner_y
      ' back to the start of the contour line
      second_vector_x=element_start_x-corner_x
      second_vector_y=element_start_y-corner_y
      segment_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
      IF segment_length=0
        ' start and end point of the line must differ
        ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        IF 1E-10>ABS(vector_x*second_vector_y-vector_y*second_vector_x)
          ' the lines before and after RND must not be parallel
          ALERT 3,"Linien vor und nach|RND dÅrfen nicht|parallel sein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the current block
          error_blocks&(0)=current_block&
          error_messages$(0)="LINIEN VOR UND NACH >RND< DöRFEN NICHT PARALLEL SEIN!"
        ELSE
          ' on which side of the contour line does the departure lie?
          normal_h=-vector_x
          normal_v=-vector_y
          IF normal_h=0
            IF element_start_x<element_end_x OR 9.99999999999997E-06>ABS(element_start_x-element_end_x) AND (normal_v>0 OR 9.99999999999997E-06>ABS(normal_v)) OR (element_start_x>element_end_x AND normal_v<0)
              line_parameter=-1
            ELSE
              line_parameter=1
            ENDIF
          ELSE
            normal_x=-normal_v
            normal_y=normal_h
            line_parameter=element_end_y-element_start_y+normal_v/normal_h*(element_start_x-element_end_x)
            DIV line_parameter,normal_y-normal_x*normal_v/normal_h
          ENDIF
          IF .0001>ABS(line_parameter)
            line_parameter=0
          ENDIF
          ' normal of the contour line towards the departure side
          IF line_parameter<=0
            line_normal_x=-second_vector_y
            line_normal_y=second_vector_x
          ELSE
            line_normal_x=second_vector_y
            line_normal_y=-second_vector_x
          ENDIF
        ENDIF
      ENDIF
      ' contour line direction from the corner
      second_vector_x=-second_vector_x
      second_vector_y=-second_vector_y
      segment_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
      IF segment_length=0
        ' start and end point of the line must differ
        ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        ' tool radius per unit of length
        offset_scale=tool_radius/segment_length
        ' RL: compensated contour end to the left of the contour line
        IF radius_correction$="L"
          IF second_vector_x=0
            IF second_vector_y>0
              corner_point(first_plane_axis|)=corner_x-tool_radius
            ELSE
              corner_point(first_plane_axis|)=corner_x+tool_radius
            ENDIF
            corner_point(second_plane_axis|)=corner_y
          ELSE
            IF second_vector_y=0
              IF second_vector_x<0
                corner_point(second_plane_axis|)=corner_y-tool_radius
              ELSE
                corner_point(second_plane_axis|)=corner_y+tool_radius
              ENDIF
              corner_point(first_plane_axis|)=corner_x
            ELSE
              corner_point(first_plane_axis|)=corner_x-second_vector_y*offset_scale
              corner_point(second_plane_axis|)=second_vector_x*offset_scale+corner_y
            ENDIF
          ENDIF
        ELSE
          ' RR: to the right
          IF radius_correction$="R"
            IF second_vector_x=0
              IF second_vector_y<0
                corner_point(first_plane_axis|)=corner_x-tool_radius
              ELSE
                corner_point(first_plane_axis|)=corner_x+tool_radius
              ENDIF
              corner_point(second_plane_axis|)=corner_y
            ELSE
              IF second_vector_y=0
                IF second_vector_x>0
                  corner_point(second_plane_axis|)=corner_y-tool_radius
                ELSE
                  corner_point(second_plane_axis|)=corner_y+tool_radius
                ENDIF
                corner_point(first_plane_axis|)=corner_x
              ELSE
                corner_point(first_plane_axis|)=second_vector_y*offset_scale+corner_x
                corner_point(second_plane_axis|)=corner_y-second_vector_x*offset_scale
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ELSE
      ' an arc
      IF (work_text$="C ") OR (work_text$="CR") OR (work_text$="CP") OR (work_text$="CT")
        last_element_was_line!=FALSE
        IF work_text$="C "
          ' has the look-ahead already stored this end point?
          IF end_point_stored!
            swap_pending_block(-1,0,0)
          ELSE
            ' read the end point of the C block
            read_arc_target(program_line$,9,21)
            ' read radius correction, feed and M function of the block
            read_radius_correction(program_line$)
            ' direction DR+ or DR-
            arc_direction$=@read_arc_direction$(program_line$,33)
          ENDIF
        ELSE
          IF work_text$="CP"
            ' has the look-ahead already stored this end point?
            IF end_point_stored!
              swap_pending_block(-1,0,0)
            ELSE
              interpret_polar_arc(program_line$)
            ENDIF
          ELSE
            IF work_text$="CR"
              ' has the look-ahead already stored this end point?
              IF end_point_stored!
                swap_pending_block(-1,-1,0)
              ELSE
                interpret_radius_arc(program_line$)
              ENDIF
            ELSE
              IF work_text$="CT"
                IF MID$(work_text$,3,1)="P"
                  ' has the look-ahead already stored this end point?
                  IF end_point_stored!
                    swap_pending_block(-1,0,0)
                  ELSE
                    ' evaluate the CTP block
                    interpret_polar_tangential_arc(program_line$)
                  ENDIF
                ELSE
                  ' has the look-ahead already stored this end point?
                  IF end_point_stored!
                    swap_pending_block(-1,0,0)
                  ELSE
                    ' evaluate the CT block
                    interpret_tangential_arc(program_line$)
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' end of the arc (the corner)
        corner_x=end_point(first_plane_axis|)
        corner_y=end_point(second_plane_axis|)
        corner_z=end_point(infeed_axis|)
        vector_x=circle_centre(first_plane_axis|)-corner_x
        vector_y=circle_centre(second_plane_axis|)-corner_y
        ' arc radius
        compensated_radius=SQR(vector_x*vector_x+vector_y*vector_y)
        ' the arc radius is zero
        IF 1E-06>ABS(compensated_radius)
          ' the arc radius must be greater than zero
          ALERT 3,"Kreisradius muû grîûer|als Null sein !",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the current block
          error_blocks&(0)=current_block&
          error_messages$(0)="KREISRADIUS MUSS GRôSSER ALS NULL SEIN!"
        ELSE
          ' read the departure line
          read_line_target(following_block_text$)
          element_end_x=end_point(first_plane_axis|)
          element_end_y=end_point(second_plane_axis|)
          end_height=end_point(infeed_axis|)
          second_vector_x=element_end_x-corner_x
          second_vector_y=element_end_y-corner_y
          ' is the departure on the outside of the arc?
          radius_dot_product=vector_x*second_vector_x+vector_y*second_vector_y
          IF arc_direction$="-"
            line_parameter=1
          ELSE
            line_parameter=-1
          ENDIF
          IF radius_dot_product>0
            line_normal_x=vector_x
            line_normal_y=vector_y
            line_parameter=-line_parameter
          ELSE
            line_normal_x=-vector_x
            line_normal_y=-vector_y
          ENDIF
          ' compensated radius: tool on the outside or the inside of the arc
          saved_radius=compensated_radius
          IF radius_correction$="R"
            IF arc_direction$="+"
              compensated_radius=compensated_radius+tool_radius
            ELSE
              SUB compensated_radius,tool_radius
            ENDIF
          ELSE
            IF radius_correction$="L"
              IF arc_direction$="-"
                compensated_radius=compensated_radius+tool_radius
              ELSE
                SUB compensated_radius,tool_radius
              ENDIF
            ENDIF
          ENDIF
          vector_x=-vector_x
          vector_y=-vector_y
          ' compensated contour end on the radius
          corner_point(first_plane_axis|)=compensated_radius/saved_radius*vector_x+circle_centre(first_plane_axis|)
          corner_point(second_plane_axis|)=compensated_radius/saved_radius*vector_y+circle_centre(second_plane_axis|)
        ENDIF
      ELSE
        ' this kind of block is not allowed here
        ALERT 3,"Dieser CNC-Satz ist|hier nicht erlaubt!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the block after next
        error_blocks&(0)=block_after_next&
        error_messages$(0)="DIESER CNC-SATZ IST HIER NICHT ERLAUBT!"
      ENDIF
    ENDIF
    ' the corner keeps its infeed coordinate
    corner_point(infeed_axis|)=corner_z
    ' save the radius correction
    saved_radius_correction$=radius_correction$
    ' store the departure end without correction
    radius_correction$=CHR$(48)
    ' store the end point for the look-ahead
    swap_pending_block(-1,0,-1)
    ' restore the radius correction
    radius_correction$=saved_radius_correction$
    ' no error
    IF NOT run_aborted!
      ' departure line from the corner
      vector_x=element_end_x-corner_x
      vector_y=element_end_y-corner_y
      corner_distance=SQR(vector_x*vector_x+vector_y*vector_y)
      ' room needed: rounding diameter plus tool radius
      basic_variables=element_arc_radius*2+tool_radius
      IF corner_distance=0
        ' start and end point of the line must differ
        ALERT 3,"Anfangs- und Endpunkt|der Linie mÅssen|verschieden sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the block after next
        error_blocks&(0)=block_after_next&
        error_messages$(0)="ANFANGS- UND ENDPUNKT MöSSEN VERSCHIEDEN SEIN!"
      ELSE
        ' the departure line is too short
        IF basic_variables>corner_distance
          ' the rounding radius or the tool radius is too large
          ALERT 3,"Der RND-Radius oder|der FrÑserradius|ist zu groû!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          ' the error is reported at the next block (the RND or chamfer block)
          error_blocks&(0)=next_block&
          error_messages$(0)="RND- ODER FRéSERRADIUS IST ZU GROSS!"
        ELSE
          ' centre of the rounding arc: one rounding radius from the compensated end
          arc_radius=SQR(line_normal_x*line_normal_x+line_normal_y*line_normal_y)
          arc_radius=element_arc_radius/arc_radius
          point_u=arc_radius*line_normal_x+corner_point(first_plane_axis|)
          point_v=arc_radius*line_normal_y+corner_point(second_plane_axis|)
          ' end of the departure seen from the rounding centre
          chord_x=element_end_x-point_u
          chord_y=element_end_y-point_v
          ' tangent from the departure end to the rounding circle
          chord_length=SQR(chord_x*chord_x+chord_y*chord_y)
          chord_angle=chord_x/chord_length
          ' arc cosine: the angle of the vector
          chord_angle=@clamped_arc_cosine(chord_angle)
          IF chord_y<0
            ' below the axis: 2*PI minus the angle
            chord_angle=two_pi-chord_angle
          ENDIF
          centre_distance_squared=chord_length*chord_length
          saved_radius=element_arc_radius*element_arc_radius
          basic_variables=centre_distance_squared-saved_radius
          ' the departure end lies inside the rounding circle
          IF basic_variables<0
            ' the rounding radius is too large
            ALERT 3,"Der RND-Radius|ist zu groû!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the next block (the RND or chamfer block)
            error_blocks&(0)=next_block&
            error_messages$(0)="DER RND-RADIUS IST ZU GROSS!"
          ELSE
            basic_variables=SQR(basic_variables)
            ' angle at the rounding centre
            centre_angle_offset=saved_radius+centre_distance_squared-basic_variables*basic_variables
            DIV centre_angle_offset,element_arc_radius*2*chord_length
            centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
            IF line_parameter>0 OR .0001>ABS(line_parameter)
              centre_angle_offset=-centre_angle_offset
              rnd_arc_direction$=CHR$(43)
            ELSE
              rnd_arc_direction$=CHR$(45)
            ENDIF
            ' tangent point on the rounding circle
            centre_angle_offset=centre_angle_offset+chord_angle
            arc_tangent_x=COS(centre_angle_offset)*element_arc_radius+point_u
            arc_tangent_y=SIN(centre_angle_offset)*element_arc_radius+point_v
          ENDIF
          ' the contour block ends at the compensated corner
          end_point(first_plane_axis|)=corner_x
          end_point(second_plane_axis|)=corner_y
          end_point(infeed_axis|)=corner_z
          ' a line
          IF last_element_was_line!
            ' simulate the move from start_point() to end_point()
            queue_simulated_move(current_block&,arc_direction$,-1)
          ELSE
            ' simulate the move from start_point() to end_point()
            queue_simulated_move(current_block&,arc_direction$,0)
          ENDIF
          ' the departure has been rounded
          cancel_compensation!=TRUE
          ' the rounding arc to the tangent point
          end_point(first_plane_axis|)=arc_tangent_x
          end_point(second_plane_axis|)=arc_tangent_y
          circle_centre(first_plane_axis|)=point_u
          circle_centre(second_plane_axis|)=point_v
          ' simulate the rounding arc
          queue_simulated_move(next_block&,rnd_arc_direction$,0)
          ' keep the compensated corner
          previous_block_start(1)=corner_point(1)
          previous_block_start(2)=corner_point(2)
          previous_block_start(3)=corner_point(3)
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' CALL LBL block program_line$: the label number at column 11 gives the start block label_blocks&(); without a
' repetition count (column 22 blank) the label is run as a subroutine (run_program_blocks with subroutine_call!
' TRUE, up to LBL 0), otherwise as a repeated program section.
PROCEDURE call_label_block(program_line$)
  LOCAL called_label&,arc_start_layer&,alert_button|
  ' label number
  called_label&=VAL(MID$(program_line$,11,3))
  ' its block
  arc_start_layer&=label_blocks&(called_label&)
  ' no repetition: a subroutine call
  IF MID$(program_line$,22,1)=" "
    IF label_start_line&(called_label&)<>label_blocks&(called_label&) AND FALSE
      ' no subroutine belongs to this label
      ALERT 3,"Zu dem Label "+STR$(called_label&)+"|gehîrt kein Unterprogramm!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=label_blocks&(called_label&)
      error_messages$(0)="ZU DEM LABEL "+STR$(called_label&)+" GEHôRT KEIN UNTERPROGRAMM!"
    ELSE
      ' run the subroutine
      run_program_blocks(arc_start_layer&,-1)
    ENDIF
  ELSE
    run_program_blocks(arc_start_layer&,0)
  ENDIF
RETURN
' Runs program blocks from block run_start_block& until the program end last_line&, a stop stop_requested!, an
' error run_aborted! or, for a subroutine (subroutine_call! TRUE), the block LBL 0. For a repeated section
' (subroutine_call! FALSE) the repetition count in the calling block calling_block& is counted down in its text
' and restored at the end. In the contour cycles (rough_out_cycle_active!/contour_cycle_active!) the blocks come
' from tool_path_elements$(). Each block is dispatched on its type: LBL, TOOL DEF/TOOL CALL (tool radius and
' drawing brush), the RND look-ahead cases (approach, departure, line/arc roundings, chamfer), L, LP, CC, C, CP,
' helix, CT, CR, CTP, LBL 0/CALL LBL, STOP, the cycles CYCL DEF 7/8/10/11/14 and other CYCL DEF/CYCL CALL, the
' parameter functions FN 0..FN 15, and the M function at the end of the block (M02/M30 end the program, M00/M06
' wait for a key). current_block&/next_block&/block_after_next&/third_block_ahead& form the look-ahead window.
PROCEDURE run_program_blocks(run_start_block&,subroutine_call!)
  LOCAL program_line$,work_text$,edit_work_text$,field_name$,next_block_text$,third_block_text$,entry_layout_backup$,point_distance,work_point_y,polar_radius,polar_angle,pole_start_angle,repeats_left&,scan_index&,end_of_run!,line_index&,rect_width&,tool_search_index&,element_arc_radius,line_is_continuation!,rnd_block_text$,following_block_text$,lookahead_third_block_text$,line_head_five$,line_head_eight$,line_head_twelve$,line_head_thirteen$,block_correction_letter$,next_correction_letter$,tool_number|,search_found!,calling_block&,line_not_type_a!,saved_function_code|,previous_m_function|,repeat_total&,alert_button|,stop_flag_saved!,window_handle|,screen_x&,screen_y&,rect_width&,redraw_x&,redraw_y&,redraw_width&,redraw_height&
  ' handle of the simulation window
  window_handle|=W_HAND(#1)
  ' not finished
  end_of_run!=FALSE
  ' the block that called
  calling_block&=current_block&
  ' a repeated section
  IF NOT subroutine_call!
    ' repetitions left, from the text of the calling block
    repeats_left&=VAL(MID$(program_lines$(calling_block&),22,4))
    repeat_total&=repeats_left&
  ENDIF
  ' start block
  current_block&=run_start_block&
  ' skip comment blocks
  skip_to_next_block(current_block&)
  find_lookahead_blocks
  ' no M function yet
  previous_m_function|=TRUE
  REPEAT
    function_code|=255
    ' in a contour cycle the blocks come from the contour lists
    IF rough_out_cycle_active! OR contour_cycle_active!
      program_line$=tool_path_elements$(current_contour|,current_block&)
      next_block_text$=tool_path_elements$(current_contour|,next_block&)
      third_block_text$=tool_path_elements$(current_contour|,block_after_next&)
    ELSE
      ' the blocks of the program
      program_line$=program_lines$(current_block&)
      next_block_text$=program_lines$(next_block&)
      third_block_text$=program_lines$(block_after_next&)
    ENDIF
    ' prefixes of the block text for the dispatch
    rnd_block_text$=LEFT$(program_line$,1)
    following_block_text$=LEFT$(program_line$,2)
    lookahead_third_block_text$=LEFT$(program_line$,3)
    line_head_five$=LEFT$(program_line$,5)
    line_head_eight$=LEFT$(program_line$,8)
    line_head_twelve$=LEFT$(program_line$,12)
    line_head_thirteen$=LEFT$(program_line$,13)
    ' block continued by the next one
    IF RIGHT$(program_line$,1)="}"
      line_is_continuation!=TRUE
    ELSE
      line_is_continuation!=FALSE
    ENDIF
    ' a line without axes (a chamfer)
    IF MID$(program_line$,7,1)="A"
      line_not_type_a!=FALSE
    ELSE
      line_not_type_a!=TRUE
    ENDIF
    ' radius correction of this block and of the next one
    block_correction_letter$=MID$(program_line$,44,1)
    next_correction_letter$=MID$(next_block_text$,44,1)
    ' the previous block had M02 or M30
    IF previous_m_function|=30 OR previous_m_function|=2
      ' end of the program
      stop_requested!=TRUE
      end_of_run!=TRUE
      ' a repeated section
      IF NOT subroutine_call!
        ' restore the repetition count in the calling block
        program_lines$(calling_block&)=LEFT$(program_lines$(calling_block&),26)+STR$(repeat_total&)
      ENDIF
    ENDIF
    ' remember the M function
    previous_m_function|=function_code|
    ' the block has an M function at its end
    IF LEN(program_line$)>54 AND (NOT line_is_continuation!)
      IF RIGHT$(program_line$,2)<>"  "
        ' M function number
        function_code|=VAL(RIGHT$(program_line$,2))
        ' M95 to M98
        IF function_code|>=95 AND function_code|<=98
          ' M95 to M98 are not supported yet, they are planned
          ALERT 3,"Die Zusatzfunktionen M95-M98|werden noch nicht unterstÅtzt.|Die Implementierung ist|geplant!",1," Weiter ",alert_button|
        ENDIF
      ENDIF
    ENDIF
    ON MENU
    IF line_is_continuation!
    ELSE
      ' a label other than LBL 0
      IF (lookahead_third_block_text$="LBL") AND (LEFT$(program_line$,11)<>"LBL       0")
        ' running inside a contour cycle
        IF rough_out_cycle_active! OR contour_cycle_active!
          parameter_number&=VAL(MID$(tool_path_elements$(current_contour|,current_block&),11,3))
        ELSE
          parameter_number&=VAL(MID$(program_lines$(current_block&),11,3))
        ENDIF
        IF label_start_line&(parameter_number&)=current_block&
        ENDIF
      ELSE
        ' tool definition
        IF line_head_eight$="TOOL DEF"
          tool_number|=VAL(MID$(program_line$,11,2))
          ' tool number not 0
          IF tool_number|
            ' remember the block of the definition
            defined_tools&(tool_number|)=current_block&
          ENDIF
        ELSE
          ' tool call
          IF line_head_eight$="TOOL CAL"
            ' close an open line first
            IF after_line_element!
              ' simulate the move from start_point() to end_point()
              queue_simulated_move(line_index&,"-",-1)
            ELSE
              IF arc_pending!
                ' simulate the move from start_point() to end_point()
                queue_simulated_move(line_index&,"-",-1)
              ENDIF
            ENDIF
            ' tool number
            tool_number|=VAL(MID$(program_line$,11,2))
            ' read the tool axis
            set_plane_for_tool_axis(program_line$,15)
            ' not defined in the program
            IF defined_tools&(tool_number|)=0
              ' the tool table has entries
              IF tool_last_line&>-1
                search_found!=FALSE
                tool_search_index&=0
                REPEAT
                  ' search the tool table
                  IF tool_number|=VAL(MID$(tool_memory_lines$(tool_search_index&),11,2))
                    search_found!=TRUE
                  ENDIF
                  INC tool_search_index&
                UNTIL search_found! OR tool_search_index&=SUCC(tool_last_line&)
              ELSE
                search_found!=FALSE
              ENDIF
              ' tool unknown
              IF NOT search_found!
                ' this tool has not been defined
                ALERT 3,"Das Werkzeug "+STR$(tool_number|)+" wurde|nicht definiert!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                ' the error is reported at the current block
                error_blocks&(0)=current_block&
                error_messages$(0)="DAS WERKZEUG WURDE NICHT DEFINIERT!"
              ELSE
                ' tool from the tool table
                work_text$=tool_memory_lines$(PRED(tool_search_index&))
              ENDIF
            ELSE
              ' tool from the program
              work_text$=program_lines$(defined_tools&(tool_number|))
            ENDIF
            ' line display mode
            IF wireframe_view!
              ' tool radius from the tool definition
              real_tool_radius=VAL(MID$(work_text$,32,8))
              ' in pixels, at least 1
              real_tool_radius_pixels&=MAX(1,ROUND(real_tool_radius*view_scale))
              IF MID$(work_text$,31,1)="-"
                real_tool_radius=-real_tool_radius
              ENDIF
              ' drawn as one pixel
              tool_radius_pixels&=1
              tool_radius=tool_radius_pixels&/view_scale
            ELSE
              ' normal display: tool radius
              tool_radius=VAL(MID$(work_text$,32,8))
              tool_radius_pixels&=MAX(1,ROUND(tool_radius*view_scale))
              IF MID$(work_text$,31,1)="-"
                tool_radius=-tool_radius
              ENDIF
            ENDIF
            ' no error
            IF NOT run_aborted!
              ' line display mode: no rings
              IF wireframe_view!
                tool_diameter_pixels|=FALSE
                stripe_mode|=FALSE
                ERASE tool_disc_rows&()
                DIM tool_disc_rows&(1)
                ARRAYFILL tool_disc_rows&(),0
              ELSE
                ' small tool: one ring
                IF tool_radius_pixels&<=20
                  tool_diameter_pixels|=tool_radius_pixels&*2
                  stripe_mode|=FALSE
                  ERASE tool_disc_rows&()
                  DIM tool_disc_rows&(1)
                  ARRAYFILL tool_disc_rows&(),0
                ELSE
                  ' large tool: several rings for the brush
                  tool_search_index&=tool_radius_pixels&*2
                  axis_entry_count|=SUCC(tool_search_index& DIV 40)
                  stripe_mode|=axis_entry_count|
                  tool_diameter_pixels|=CINT(tool_search_index&/axis_entry_count|)
                  IF ODD(tool_diameter_pixels|)
                    INC tool_diameter_pixels|
                  ENDIF
                  ' table of the ring radii
                  ERASE tool_disc_rows&()
                  settings_entry|=SHR(axis_entry_count|,1)
                  DIM tool_disc_rows&(SUCC(settings_entry|))
                  ARRAYFILL tool_disc_rows&(),0
                  DEC settings_entry|
                  FOR loop_index|=FALSE TO settings_entry|
                    tool_disc_rows&(SUCC(loop_index|))=tool_radius_pixels&-(loop_index|*2+1)*tool_diameter_pixels|/2
                  NEXT loop_index|
                ENDIF
              ENDIF
              section_line_width|=SUCC(tool_diameter_pixels|)
              INC tool_diameter_pixels|
              ' drawing limits widened by the tool radius
              area_min_h=view_min_h-tool_radius
              area_max_h=view_max_h+tool_radius
              area_max_v=view_max_v+tool_radius
              area_min_v=view_min_v-tool_radius
            ENDIF
          ELSE
            ' tangential approach: line without correction, RND, line with RL/RR
            IF (LEFT$(third_block_text$,3)="RND") AND (following_block_text$="L ") AND (MID$(following_block_text$,7,1)<>"A") AND ((block_correction_letter$="0") OR ((block_correction_letter$=" ") AND (radius_correction$="0"))) AND (LEFT$(next_block_text$,2)="L ") AND (MID$(next_block_text$,7,1)<>"A") AND ((next_correction_letter$="L") OR (next_correction_letter$="R")) AND (NOT stop_requested!)
              ' approach line already stored by the look-ahead
              IF end_point_stored!
                swap_pending_block(-1,0,0)
              ELSE
                ' read the end point of the L block
                read_line_target(program_line$)
                read_radius_correction(program_line$)
              ENDIF
              ' simulate the approach line
              queue_simulated_move(current_block&,"-",-1)
              IF NOT run_aborted!
                ' move on to the RND block
                current_block&=next_block&
                next_block&=block_after_next&
                block_after_next&=third_block_ahead&
                ' step on to the next program block
                skip_to_next_block(third_block_ahead&)
                ' compute and simulate the approach
                approach_contour_tangentially(next_block_text$)
                ' move on past the RND block
                current_block&=next_block&
                next_block&=block_after_next&
                block_after_next&=third_block_ahead&
                skip_to_next_block(third_block_ahead&)
              ENDIF
            ELSE
              ' tangential departure: contour block with correction, RND, line with R0
              IF (LEFT$(next_block_text$,3)="RND") AND ((block_correction_letter$="L") OR (block_correction_letter$="R") OR ((block_correction_letter$=" ") AND (radius_correction$<>"0"))) AND (LEFT$(third_block_text$,2)="L ") AND (MID$(third_block_text$,7,1)<>"A") AND (MID$(third_block_text$,44,1)="0") AND (NOT stop_requested!)
                ' compute and simulate the departure
                depart_contour_tangentially(program_line$)
                ' move the look-ahead window on by one block
                current_block&=next_block&
                next_block&=block_after_next&
                block_after_next&=third_block_ahead&
                skip_to_next_block(third_block_ahead&)
              ELSE
                ' an RND block follows
                IF (LEFT$(next_block_text$,3)="RND") AND (NOT stop_requested!)
                  ' the two blocks after it
                  edit_work_text$=program_lines$(block_after_next&)
                  field_name$=program_lines$(third_block_ahead&)
                  ' line and line
                  IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND line_not_type_a! AND ((LEFT$(field_name$,2)="LP") OR ((LEFT$(edit_work_text$,2)="L ") AND LEN(edit_work_text$)>20 AND (MID$(edit_work_text$,7,1)<>"A")))
                    round_line_to_line(program_line$)
                  ELSE
                    ' arc and arc
                    IF (rnd_block_text$="C") AND (LEFT$(edit_work_text$,1)="C")
                      round_arc_to_arc(program_line$)
                    ELSE
                      ' line and arc
                      IF (rnd_block_text$="L") AND LEN(program_line$)>20 AND line_not_type_a! AND (LEFT$(edit_work_text$,1)="C")
                        round_line_to_arc(program_line$)
                      ELSE
                        ' arc and line
                        IF (rnd_block_text$="C") AND (LEFT$(edit_work_text$,1)="L") AND LEN(edit_work_text$)>20 AND (MID$(edit_work_text$,7,1)<>"A")
                          round_arc_to_line(program_line$)
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' move on past the RND block
                  current_block&=next_block&
                  next_block&=block_after_next&
                  block_after_next&=third_block_ahead&
                  skip_to_next_block(third_block_ahead&)
                ELSE
                  ' an L block with coordinates
                  IF (following_block_text$="L ") AND LEN(program_line$)>20
                    ' not a chamfer line
                    IF line_not_type_a!
                      ' a chamfer follows
                      IF (LEFT$(next_block_text$,2)="L ") AND LEN(next_block_text$)<20
                        ' chamfer between the two lines
                        chamfer_line_corner(program_line$,0)
                        ' move the look-ahead window on by one block
                        current_block&=next_block&
                        next_block&=block_after_next&
                        block_after_next&=third_block_ahead&
                        skip_to_next_block(third_block_ahead&)
                      ELSE
                        ' a plain line
                        IF end_point_stored!
                          swap_pending_block(-1,0,0)
                        ELSE
                          ' read the end point of the L block
                          read_line_target(program_line$)
                          read_radius_correction(program_line$)
                        ENDIF
                        ' simulate the line
                        queue_simulated_move(current_block&,"-",-1)
                      ENDIF
                    ENDIF
                  ELSE
                    ' an LP block
                    IF following_block_text$="LP"
                      ' a chamfer follows
                      IF (LEFT$(next_block_text$,2)="L ") AND LEN(next_block_text$)<20
                        ' chamfer between the two lines
                        chamfer_line_corner(program_line$,0)
                        ' move the look-ahead window on by one block
                        current_block&=next_block&
                        next_block&=block_after_next&
                        block_after_next&=third_block_ahead&
                        skip_to_next_block(third_block_ahead&)
                      ELSE
                        ' has the look-ahead already stored this end point?
                        IF end_point_stored!
                          swap_pending_block(-1,0,0)
                        ELSE
                          interpret_polar_line(program_line$)
                        ENDIF
                        IF NOT run_aborted!
                          ' simulate the line
                          queue_simulated_move(current_block&,"-",-1)
                        ENDIF
                      ENDIF
                    ELSE
                      ' a CC block
                      IF following_block_text$="CC"
                        ' centre already stored by the look-ahead
                        IF centre_pending!
                          swap_pending_block(0,-1,0)
                        ELSE
                          ' read the circle centre of the CC block
                          set_plane_from_centre(program_line$)
                          read_circle_centre(program_line$)
                        ENDIF
                      ELSE
                        ' a C block
                        IF following_block_text$="C "
                          ' has the look-ahead already stored this end point?
                          IF end_point_stored!
                            swap_pending_block(-1,0,0)
                          ELSE
                            ' find the CC block before it
                            rect_width&=current_block&
                            ' step back to the previous program block
                            skip_to_previous_block(rect_width&)
                            IF LEFT$(program_lines$(rect_width&),2)<>"CC"
                              REPEAT
                                DEC rect_width&
                              UNTIL rect_width&=0 OR ((LEFT$(program_lines$(rect_width&),2)="CC") AND (RIGHT$(program_lines$(rect_width&))<>"}"))
                              IF rect_width&>0
                                ' read the circle centre of the CC block
                                set_plane_from_centre(program_lines$(rect_width&))
                              ENDIF
                            ENDIF
                            ' read the arc end point
                            read_arc_target(program_line$,9,21)
                            ' read radius correction, feed and M function of the block
                            read_radius_correction(program_line$)
                            ' direction DR+ or DR-
                            arc_direction$=@read_arc_direction$(program_line$,33)
                          ENDIF
                          ' simulate the arc
                          queue_simulated_move(current_block&,arc_direction$,0)
                        ELSE
                          ' a CP block without a linear axis
                          IF (following_block_text$="CP") AND (MID$(program_line$,18,2)<>"  ") AND (MID$(program_line$,18,2)<>" A")
                            ' has the look-ahead already stored this end point?
                            IF end_point_stored!
                              swap_pending_block(-1,0,0)
                            ELSE
                              interpret_polar_arc(program_line$)
                            ENDIF
                            IF NOT run_aborted!
                              ' simulate the arc
                              queue_simulated_move(current_block&,arc_direction$,0)
                            ENDIF
                          ELSE
                            ' a CP block with a linear axis: helix
                            IF (following_block_text$="CP") AND (MID$(program_line$,18,2)<>"  ")
                              ' has the look-ahead already stored this end point?
                              IF end_point_stored!
                                swap_pending_block(-1,0,0)
                              ELSE
                                interpret_polar_helix(program_line$)
                              ENDIF
                              IF NOT run_aborted!
                                ' simulate the helix
                                queue_simulated_move(current_block&,arc_direction$,0)
                              ENDIF
                            ELSE
                              ' a CT block
                              IF lookahead_third_block_text$="CT "
                                ' has the look-ahead already stored this end point?
                                IF end_point_stored!
                                  swap_pending_block(-1,0,0)
                                ELSE
                                  ' evaluate the CT block
                                  interpret_tangential_arc(program_line$)
                                ENDIF
                                IF NOT run_aborted!
                                  ' simulate the arc
                                  queue_simulated_move(current_block&,arc_direction$,0)
                                ENDIF
                              ELSE
                                ' a CR block
                                IF following_block_text$="CR"
                                  ' has the look-ahead already stored this end point?
                                  IF end_point_stored!
                                    swap_pending_block(-1,-1,0)
                                  ELSE
                                    interpret_radius_arc(program_line$)
                                  ENDIF
                                  IF NOT run_aborted!
                                    ' simulate the arc
                                    queue_simulated_move(current_block&,arc_direction$,0)
                                  ENDIF
                                ELSE
                                  ' a CTP block
                                  IF lookahead_third_block_text$="CTP"
                                    ' has the look-ahead already stored this end point?
                                    IF end_point_stored!
                                      swap_pending_block(-1,0,0)
                                    ELSE
                                      ' evaluate the CTP block
                                      interpret_polar_tangential_arc(program_line$)
                                    ENDIF
                                    IF NOT run_aborted!
                                      ' simulate the arc
                                      queue_simulated_move(current_block&,arc_direction$,0)
                                    ENDIF
                                  ELSE
                                    ' LBL 0 ends a subroutine
                                    IF (LEFT$(program_line$,11)="LBL       0") AND subroutine_call!
                                      end_of_run!=TRUE
                                    ELSE
                                      ' a label
                                      IF lookahead_third_block_text$="LBL"
                                        ' running inside a contour cycle
                                        IF rough_out_cycle_active! OR contour_cycle_active!
                                          parameter_number&=VAL(MID$(tool_path_elements$(current_contour|,current_block&),11,3))
                                        ELSE
                                          parameter_number&=VAL(MID$(program_lines$(current_block&),11,3))
                                        ENDIF
                                        ' the end of a repeated section
                                        IF current_block&=label_start_line&(parameter_number&)
                                          ' jump back to its start
                                          current_block&=label_end_line&(parameter_number&)
                                          find_lookahead_blocks
                                        ENDIF
                                      ELSE
                                        ' a label call
                                        IF line_head_eight$="CALL LBL"
                                          ' not the calling block itself
                                          IF current_block&<>calling_block&
                                            call_label_block(program_line$)
                                          ELSE
                                            ' back at the calling block: one repetition done
                                            IF NOT subroutine_call!
                                              DEC repeats_left&
                                              ' all done
                                              IF repeats_left&=0
                                                end_of_run!=TRUE
                                                ' restore the repetition count in its text
                                                program_lines$(calling_block&)=LEFT$(program_lines$(calling_block&),26)+STR$(repeat_total&)
                                              ELSE
                                                ' write the repetitions left into its text
                                                program_lines$(calling_block&)=LEFT$(program_lines$(calling_block&),26)+STR$(repeats_left&)
                                                current_block&=run_start_block&
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                          find_lookahead_blocks
                                        ELSE
                                          ' program stop
                                          IF line_head_five$="STOP "
                                            ~WIND_UPDATE(1)
                                            IF after_line_element!
                                              ' close an open line first
                                              queue_simulated_move(line_index&,"-",-1)
                                            ELSE
                                              IF arc_pending!
                                                ' simulate the move from start_point() to end_point()
                                                queue_simulated_move(line_index&,"-",-1)
                                              ENDIF
                                            ENDIF
                                            after_line_element!=FALSE
                                            arc_pending!=FALSE
                                            PRINT CHR$(7);
                                            PAUSE 2
                                            PRINT CHR$(7);
                                            ' draw into the off-screen buffer
                                            ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
                                            DEFFILL 1,0,0
                                            PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
                                            DEFFILL ,1,1
                                            PRINT AT(text_column&+16,prompt_row|);"Weiter mit den Tasten >RETURN< oder >ENTER<!";
                                            ' "Weiter mit den Tasten >RETURN< oder >ENTER<!" (go on with Return or Enter)
                                            ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                                            redraw_x&=work_x&
                                            redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
                                            redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
                                            redraw_height&=char_cell_height|
                                            window_handle|=W_HAND(#1)
                                            ' redraw the status line in the window
                                            blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                                            ' keys now continue the run
                                            graphic_view_stage|=3
                                            ON MENU KEY GOSUB continue_on_return_key
                                            ' save the stop flag
                                            stop_flag_saved!=stop_requested!
                                            ~WIND_UPDATE(0)
                                            REPEAT
                                              ON MENU
                                            UNTIL stop_requested!=TRUE
                                            ~WIND_UPDATE(1)
                                            ON MENU KEY GOSUB stop_on_space_key
                                            graphic_view_stage|=2
                                            stop_requested!=stop_flag_saved!
                                            ' show the abort hint
                                            IF run_continuous!
                                              ' draw into the off-screen buffer
                                              ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
                                              DEFFILL 1,0,0
                                              PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
                                              ' "Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!" (Space stops after the current
                                              ' block)
                                              PRINT AT(text_column&+4,prompt_row|);"Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!";
                                              DEFFILL ,1,1
                                              ' back to the visible screen
                                              ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
                                              redraw_x&=work_x&
                                              redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
                                              redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
                                              redraw_height&=char_cell_height|
                                              blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
                                            ENDIF
                                            ~WIND_UPDATE(0)
                                          ELSE
                                            ' datum shift
                                            IF LEFT$(program_line$,10)="CYCL DEF 7"
                                              cycle_datum_shift
                                            ELSE
                                              ' mirror image
                                              IF LEFT$(program_line$,10)="CYCL DEF 8"
                                                cycle_mirror_image
                                              ELSE
                                                ' rotation
                                                IF LEFT$(program_line$,11)="CYCL DEF 10"
                                                  cycle_rotation
                                                ELSE
                                                  ' scaling
                                                  IF LEFT$(program_line$,11)="CYCL DEF 11"
                                                    apply_scaling_cycle
                                                  ELSE
                                                    ' contour geometry
                                                    IF LEFT$(program_line$,11)="CYCL DEF 14"
                                                      check_contour_cycle
                                                    ELSE
                                                      ' another cycle definition
                                                      IF line_head_eight$="CYCL DEF"
                                                        ' its first definition block
                                                        IF (MID$(program_line$,12,1)="0") OR (MID$(program_line$,13,1)="0")
                                                          cycle_start_line&=current_block&
                                                        ENDIF
                                                      ELSE
                                                        ' cycle call
                                                        IF line_head_eight$="CYCL CAL"
                                                          ' after M02/M30 the call is only noted
                                                          IF function_code|=2 OR function_code|=30
                                                            saved_function_code|=function_code|
                                                            function_code|=FALSE
                                                            stop_requested!=FALSE
                                                            simulate_cycle_call
                                                            stop_requested!=TRUE
                                                            function_code|=saved_function_code|
                                                          ELSE
                                                            simulate_cycle_call
                                                          ENDIF
                                                        ELSE
                                                          ' FN 0: assign
                                                          IF line_head_five$="FN 0 "
                                                            ' number of the Q parameter
                                                            rect_width&=VAL(MID$(program_line$,10,3))
                                                            ' the value
                                                            q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)
                                                            q_parameter_defined!(rect_width&)=TRUE
                                                          ELSE
                                                            ' FN 1: add
                                                            IF line_head_five$="FN 1 "
                                                              ' number of the Q parameter
                                                              rect_width&=VAL(MID$(program_line$,10,3))
                                                              q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)+@read_number_or_parameter(program_line$,31)
                                                              q_parameter_defined!(rect_width&)=TRUE
                                                            ELSE
                                                              ' FN 2: subtract
                                                              IF line_head_five$="FN 2 "
                                                                ' number of the Q parameter
                                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                                q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)-@read_number_or_parameter(program_line$,31)
                                                                q_parameter_defined!(rect_width&)=TRUE
                                                              ELSE
                                                                ' FN 3: multiply
                                                                IF line_head_five$="FN 3 "
                                                                  ' number of the Q parameter
                                                                  rect_width&=VAL(MID$(program_line$,10,3))
                                                                  q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)*@read_number_or_parameter(program_line$,31)
                                                                  q_parameter_defined!(rect_width&)=TRUE
                                                                ELSE
                                                                  ' FN 4: divide
                                                                  IF line_head_five$="FN 4 "
                                                                    basic_variables=@read_number_or_parameter(program_line$,31)
                                                                    ' number of the Q parameter
                                                                    rect_width&=VAL(MID$(program_line$,10,3))
                                                                    ' divisor zero
                                                                    IF basic_variables=0
                                                                      ' division by zero is not allowed (Abbruch = stop, Weiter = go on with 0)
                                                                      ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                      IF alert_button|=1
                                                                        run_aborted!=TRUE
                                                                        ' the error is reported at the current block
                                                                        error_blocks&(0)=current_block&
                                                                        error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                                      ENDIF
                                                                      ' result 0
                                                                      q_parameters(rect_width&)=0
                                                                    ELSE
                                                                      q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)/basic_variables
                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                    ENDIF
                                                                  ELSE
                                                                    ' FN 5: square root
                                                                    IF line_head_five$="FN 5 "
                                                                      basic_variables=@read_number_or_parameter(program_line$,22)
                                                                      IF basic_variables<0
                                                                        ' the root of a negative number is not allowed (Abbruch = stop, Weiter = go on with 0)
                                                                        ALERT 3,"Wurzel aus einer|negativen Zahl|nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                        IF alert_button|=1
                                                                          run_aborted!=TRUE
                                                                          ' the error is reported at the current block
                                                                          error_blocks&(0)=current_block&
                                                                          error_messages$(0)="WURZEL AUS EINER NEGATIVEN ZAHL NICHT ERLAUBT!"
                                                                        ENDIF
                                                                        ' number of the Q parameter
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        ' result 0
                                                                        q_parameters(rect_width&)=0
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ELSE
                                                                        ' number of the Q parameter
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        q_parameters(rect_width&)=SQR(basic_variables)
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ENDIF
                                                                    ELSE
                                                                      ' FN 6: sine
                                                                      IF line_head_five$="FN 6 "
                                                                        ' number of the Q parameter
                                                                        rect_width&=VAL(MID$(program_line$,10,3))
                                                                        q_parameters(rect_width&)=SIN(RAD(@read_number_or_parameter(program_line$,22)))
                                                                        q_parameter_defined!(rect_width&)=TRUE
                                                                      ELSE
                                                                        ' FN 7: cosine
                                                                        IF line_head_five$="FN 7 "
                                                                          ' number of the Q parameter
                                                                          rect_width&=VAL(MID$(program_line$,10,3))
                                                                          q_parameters(rect_width&)=COS(RAD(@read_number_or_parameter(program_line$,22)))
                                                                          q_parameter_defined!(rect_width&)=TRUE
                                                                        ELSE
                                                                          ' FN 8: root of the sum of squares
                                                                          IF line_head_five$="FN 8 "
                                                                            segment_length=@read_number_or_parameter(program_line$,17)
                                                                            second_operand=@read_number_or_parameter(program_line$,31)
                                                                            ' number of the Q parameter
                                                                            rect_width&=VAL(MID$(program_line$,10,3))
                                                                            q_parameters(rect_width&)=SQR(segment_length*segment_length+second_operand*second_operand)
                                                                            q_parameter_defined!(rect_width&)=TRUE
                                                                          ELSE
                                                                            ' FN 9 to FN 12: conditional jumps (equal, not equal, greater, less)
                                                                            IF (line_head_five$="FN 9 ") OR (line_head_five$="FN 10") OR (line_head_five$="FN 11") OR (line_head_five$="FN 12")
                                                                              segment_length=@read_number_or_parameter(program_line$,13)
                                                                              second_operand=@read_number_or_parameter(program_line$,27)
                                                                              ' the condition holds
                                                                              IF segment_length=second_operand AND (line_head_five$="FN 9 ") OR (segment_length<>second_operand AND (line_head_five$="FN 10")) OR (segment_length>second_operand AND (line_head_five$="FN 11")) OR (segment_length<second_operand AND (line_head_five$="FN 12"))
                                                                                ' jump to the label given at column 45
                                                                                current_block&=label_blocks&(VAL(MID$(program_line$,45,3)))
                                                                                find_lookahead_blocks
                                                                              ENDIF
                                                                            ELSE
                                                                              ' FN 13: angle
                                                                              IF line_head_five$="FN 13"
                                                                                ' number of the Q parameter
                                                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                                                segment_length=@read_number_or_parameter(program_line$,17)
                                                                                second_operand=@read_number_or_parameter(program_line$,31)
                                                                                IF segment_length=0 AND second_operand=0
                                                                                  ' division by zero is not allowed (Abbruch = stop, Weiter = go on with 0)
                                                                                  ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                                                  IF alert_button|=1
                                                                                    run_aborted!=TRUE
                                                                                    ' the error is reported at the current block
                                                                                    error_blocks&(0)=current_block&
                                                                                    error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                                                  ENDIF
                                                                                  ' result 0
                                                                                  q_parameters(rect_width&)=0
                                                                                ELSE
                                                                                  IF segment_length=0
                                                                                    ' result 0
                                                                                    q_parameters(rect_width&)=0
                                                                                    q_parameter_defined!(rect_width&)=TRUE
                                                                                  ELSE
                                                                                    IF second_operand=0
                                                                                      q_parameters(rect_width&)=DEG(ASIN(segment_length))
                                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                                    ELSE
                                                                                      q_parameters(rect_width&)=ATN(segment_length/second_operand)
                                                                                      q_parameters(rect_width&)=DEG(q_parameters(rect_width&))
                                                                                      q_parameter_defined!(rect_width&)=TRUE
                                                                                    ENDIF
                                                                                  ENDIF
                                                                                ENDIF
                                                                              ELSE
                                                                                IF line_head_five$="FN 14"
                                                                                ELSE
                                                                                  ' FN 15: print
                                                                                  IF line_head_five$="FN 15"
                                                                                    show_fn15_values(program_line$)
                                                                                  ENDIF
                                                                                ENDIF
                                                                              ENDIF
                                                                            ENDIF
                                                                          ENDIF
                                                                        ENDIF
                                                                      ENDIF
                                                                    ENDIF
                                                                  ENDIF
                                                                ENDIF
                                                              ENDIF
                                                            ENDIF
                                                          ENDIF
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ENDIF
                                                ENDIF
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                        ENDIF
                                      ENDIF
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' stopped but not yet finished
    IF stop_requested! AND (NOT end_of_run!)
      end_of_run!=TRUE
      IF NOT subroutine_call!
        ' restore the repetition count in the calling block
        program_lines$(calling_block&)=LEFT$(program_lines$(calling_block&),26)+STR$(repeat_total&)
      ENDIF
    ENDIF
    SELECT function_code|
    CASE 30,2
      ' program end: all transformations off
      stop_requested!=TRUE
      mirror_x!=FALSE
      mirror_y!=FALSE
      mirror_z!=FALSE
      mirror_reverses_direction!=FALSE
      rotation_active!=FALSE
      mirror_x_after_rotation!=TRUE
      mirror_y_after_rotation!=TRUE
      mirror_z_after_rotation!=TRUE
      scaling_active!=FALSE
      IF NOT subroutine_call!
        program_lines$(calling_block&)=LEFT$(program_lines$(calling_block&),26)+STR$(repeat_total&)
      ENDIF
    CASE 0,6
      ' M00 and M06 stop the program unless STOP did already
      IF line_head_five$<>"STOP "
        ~WIND_UPDATE(1)
        IF after_line_element!
          ' simulate the move from start_point() to end_point()
          queue_simulated_move(line_index&,"-",-1)
        ELSE
          IF arc_pending!
            ' simulate the move from start_point() to end_point()
            queue_simulated_move(line_index&,"-",-1)
          ENDIF
        ENDIF
        after_line_element!=FALSE
        arc_pending!=FALSE
        PRINT CHR$(7);
        PAUSE 2
        PRINT CHR$(7);
        ' draw into the off-screen buffer
        ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
        DEFFILL 1,0,0
        PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
        DEFFILL ,1,1
        PRINT AT(text_column&+16,prompt_row|);"Weiter mit den Tasten >RETURN< oder >ENTER<!";
        ' back to the visible screen
        ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
        redraw_x&=work_x&
        redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
        redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
        redraw_height&=char_cell_height|
        window_handle|=W_HAND(#1)
        blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
        graphic_view_stage|=3
        ON MENU KEY GOSUB continue_on_return_key
        ~WIND_UPDATE(0)
        REPEAT
          ON MENU
        UNTIL stop_requested!=TRUE
        ~WIND_UPDATE(1)
        ON MENU KEY GOSUB stop_on_space_key
        graphic_view_stage|=2
        stop_requested!=FALSE
        IF run_continuous!
          ' draw into the off-screen buffer
          ~XBIOS(5,L:offscreen_buffer%,L:physical_screen%,-1)
          DEFFILL 1,0,0
          PBOX 0,char_cell_height|*(prompt_row|-2),work_w&,char_cell_height|*prompt_row|
          DEFFILL ,1,1
          PRINT AT(text_column&+4,prompt_row|);"Abbruch mit Taste >SPACE(NOENT)< (nach Beenden des laufenden Satzes)!";
          ' back to the visible screen
          ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
          redraw_x&=work_x&
          redraw_y&=work_y&+char_cell_height|*PRED(prompt_row|)
          redraw_width&=MIN(status_line_width&,screen_max_x&-work_x&)
          redraw_height&=char_cell_height|
          blit_window_area(window_handle|,redraw_x&,redraw_y&,redraw_width&,redraw_height&)
        ENDIF
        ~WIND_UPDATE(0)
      ENDIF
    ENDSELECT
    ' move the look-ahead window on by one block
    line_index&=current_block&
    ' move the look-ahead window on by one block
    current_block&=next_block&
    next_block&=block_after_next&
    block_after_next&=third_block_ahead&
    ' in a contour cycle the next block simply follows
    IF rough_out_cycle_active! OR contour_cycle_active!
      INC third_block_ahead&
    ELSE
      skip_to_next_block(third_block_ahead&)
    ENDIF
    ON MENU
    ' until the program end, the end of the run, a stop or an error
  UNTIL current_block&=last_line& OR end_of_run! OR stop_requested! OR run_aborted!
  ' close an open line when stopped
  IF after_line_element! OR arc_pending! AND (NOT run_aborted!) AND stop_requested!
    ' simulate the move from start_point() to end_point()
    queue_simulated_move(current_block&,"-",-1)
  ENDIF
  ' back to the calling block
  current_block&=calling_block&
RETURN
' CYCL DEF 7 (Nullpunkt-Verschiebung, datum shift) at block next_block&: reads the following CYCL DEF 7.x blocks
' (up to three axes, incremental with "I" in column 15) into datum_shift(). Without rotation and mirroring the
' shift is taken as it is; otherwise it is mirrored, rotated and added to the previous shift along the rotated
' axes rotated_first_axis()/rotated_second_axis(), the tool axis tool_axis| choosing which axes lie in the
' plane. datum_shift_change() gets the change of the shift for the next move, and current_block& is left on the
' last cycle block.
PROCEDURE cycle_datum_shift
  LOCAL point_distance,work_point_y,cut_depth,x_axis_flag!,y_axis_flag!,z_axis_flag!,x_incremental!,y_incremental!,z_incremental!,work_text$,axis_entry_count|,line_index&,angle_offset,rotate_length
  ' shift values of the three axes
  point_distance=0
  work_point_y=0
  cut_depth=0
  axis_entry_count|=FALSE
  ' first cycle block
  line_index&=next_block&
  ' keep the old shift
  previous_datum_shift(1)=datum_shift(1)
  previous_datum_shift(2)=datum_shift(2)
  previous_datum_shift(3)=datum_shift(3)
  ' no rotation and no mirroring: the shift is used as it is
  IF (NOT rotation_active!) AND (NOT datum_shift_on!)
    x_axis_flag!=FALSE
    y_axis_flag!=FALSE
    z_axis_flag!=FALSE
    ' every CYCL DEF 7.x block, at most three
    WHILE (LEFT$(program_lines$(line_index&),10)="CYCL DEF 7") AND axis_entry_count|<3
      ' its axis letter
      work_text$=MID$(program_lines$(line_index&),16,1)
      IF work_text$="X"
        x_axis_flag!=TRUE
        INC axis_entry_count|
        ' its value
        point_distance=@read_number_or_parameter(program_lines$(line_index&),18)
        ' incremental
        IF MID$(program_lines$(line_index&),15,1)="I"
          ADD datum_shift(1),point_distance
        ELSE
          IF point_distance=0
            datum_shift(1)=0
          ELSE
            datum_shift(1)=point_distance
          ENDIF
        ENDIF
      ELSE
        IF work_text$="Y"
          y_axis_flag!=TRUE
          INC axis_entry_count|
          work_point_y=@read_number_or_parameter(program_lines$(line_index&),18)
          IF MID$(program_lines$(line_index&),15,1)="I"
            ADD datum_shift(2),work_point_y
          ELSE
            IF work_point_y=0
              datum_shift(2)=0
            ELSE
              datum_shift(2)=work_point_y
            ENDIF
          ENDIF
        ELSE
          IF work_text$="Z"
            z_axis_flag!=TRUE
            INC axis_entry_count|
            cut_depth=@read_number_or_parameter(program_lines$(line_index&),18)
            IF MID$(program_lines$(line_index&),15,1)="I"
              ADD datum_shift(3),cut_depth
            ELSE
              IF cut_depth=0
                datum_shift(3)=0
              ELSE
                datum_shift(3)=cut_depth
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      skip_to_next_block(line_index&)
    WEND
    ' the shift in the plane of the tool axis
    datum_shift_in_plane(tool_first_axis|)=datum_shift(tool_first_axis|)
    datum_shift_in_plane(tool_second_axis|)=datum_shift(tool_second_axis|)
  ELSE
    ' with rotation or mirroring: collect the axes first
    x_incremental!=FALSE
    y_incremental!=FALSE
    z_incremental!=FALSE
    x_axis_flag!=TRUE
    y_axis_flag!=TRUE
    z_axis_flag!=TRUE
    ' every CYCL DEF 7.x block, at most three
    WHILE (LEFT$(program_lines$(line_index&),10)="CYCL DEF 7") AND axis_entry_count|<3
      work_text$=MID$(program_lines$(line_index&),16,1)
      IF (work_text$="X") AND x_axis_flag!
        x_axis_flag!=FALSE
        INC axis_entry_count|
        point_distance=@read_number_or_parameter(program_lines$(line_index&),18)
        ' incremental
        IF MID$(program_lines$(line_index&),15,1)="I"
          x_incremental!=TRUE
        ENDIF
      ELSE
        IF (work_text$="Y") AND y_axis_flag!
          y_axis_flag!=FALSE
          INC axis_entry_count|
          work_point_y=@read_number_or_parameter(program_lines$(line_index&),18)
          IF MID$(program_lines$(line_index&),15,1)="I"
            y_incremental!=TRUE
          ENDIF
        ELSE
          IF (work_text$="Z") AND z_axis_flag!
            z_axis_flag!=FALSE
            INC axis_entry_count|
            cut_depth=@read_number_or_parameter(program_lines$(line_index&),18)
            IF MID$(program_lines$(line_index&),15,1)="I"
              z_incremental!=TRUE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      skip_to_next_block(line_index&)
    WEND
    ' the new shift values
    datum_shift(1)=point_distance
    datum_shift(2)=work_point_y
    datum_shift(3)=cut_depth
    ' keep them unmirrored
    block_input_values(1)=point_distance
    block_input_values(2)=work_point_y
    block_input_values(3)=cut_depth
    ' X is mirrored before the rotation
    IF mirror_x! AND (NOT mirror_x_after_rotation!)
      ' mirror the X shift
      datum_shift(1)=-datum_shift(1)
    ENDIF
    ' Y is mirrored before the rotation
    IF mirror_y! AND (NOT mirror_y_after_rotation!)
      ' mirror the Y shift
      datum_shift(2)=-datum_shift(2)
    ENDIF
    ' Z is mirrored before the rotation
    IF mirror_z! AND (NOT mirror_z_after_rotation!)
      ' mirror the Z shift
      datum_shift(3)=-datum_shift(3)
    ENDIF
    ' rotation active: rotate the shift
    IF rotation_active!
      point_distance=datum_shift(tool_first_axis|)
      work_point_y=datum_shift(tool_second_axis|)
      IF point_distance<>0 OR work_point_y<>0
        ' distance of the point from the origin
        rotate_length=SQR(point_distance*point_distance+work_point_y*work_point_y)
        ' cosine of its angle
        angle_offset=point_distance/rotate_length
        ' arc cosine: the angle of the vector
        angle_offset=@clamped_arc_cosine(angle_offset)
        IF work_point_y<0
          ' below the axis: 2*PI minus the angle
          angle_offset=two_pi-angle_offset
        ENDIF
        ' add the rotation angle
        angle_offset=angle_offset+rotation_angle
        ' rotated point
        point_distance=COS(angle_offset)*rotate_length
        work_point_y=SIN(angle_offset)*rotate_length
        datum_shift(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
        datum_shift(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
      ENDIF
    ENDIF
    ' X is mirrored after the rotation
    IF mirror_x! AND mirror_x_after_rotation!
      ' mirror the X shift
      datum_shift(1)=-datum_shift(1)
    ENDIF
    ' Y is mirrored after the rotation
    IF mirror_y! AND mirror_y_after_rotation!
      ' mirror the Y shift
      datum_shift(2)=-datum_shift(2)
    ENDIF
    ' Z is mirrored after the rotation
    IF mirror_z! AND mirror_z_after_rotation!
      ' mirror the Z shift
      datum_shift(3)=-datum_shift(3)
    ENDIF
    SELECT tool_axis|
    CASE 3
      ' X given: add it along the first rotated axis
      IF x_incremental! OR x_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        datum_shift_in_plane(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF y_incremental! OR y_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        datum_shift_in_plane(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      ' Z given: add it along the first rotated axis
      IF z_incremental! OR z_axis_flag!
        ADD datum_shift(depth_axis|),datum_shift(depth_axis|)
      ENDIF
    CASE 2
      IF z_incremental! OR z_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        datum_shift_in_plane(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        datum_shift_in_plane(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      ' Y given: add it along the first rotated axis
      IF y_incremental! OR y_axis_flag!
        ADD datum_shift(depth_axis|),datum_shift(depth_axis|)
      ENDIF
    DEFAULT
      IF y_incremental! OR y_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_first_axis|)*rotated_first_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_first_axis|),block_input_values(tool_first_axis|)
      ELSE
        datum_shift_in_plane(tool_first_axis|)=block_input_values(tool_first_axis|)
      ENDIF
      IF z_incremental! OR z_axis_flag!
        ADD datum_shift(tool_first_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_first_axis|)
        ADD datum_shift(tool_second_axis|),datum_shift_in_plane(tool_second_axis|)*rotated_second_axis(tool_second_axis|)
        ADD datum_shift_in_plane(tool_second_axis|),block_input_values(tool_second_axis|)
      ELSE
        datum_shift_in_plane(tool_second_axis|)=block_input_values(tool_second_axis|)
      ENDIF
      IF x_incremental! OR x_axis_flag!
        ADD datum_shift(depth_axis|),datum_shift(depth_axis|)
      ENDIF
    ENDSELECT
  ENDIF
  ' the change of the shift for the next move
  datum_shift_change(1)=datum_shift(1)-previous_datum_shift(1)
  datum_shift_change(2)=datum_shift(2)-previous_datum_shift(2)
  datum_shift_change(3)=datum_shift(3)-previous_datum_shift(3)
  ' step back to the last cycle block
  skip_to_previous_block(line_index&)
  ' and continue from there
  current_block&=line_index&
  find_lookahead_blocks
RETURN
' CYCL DEF 8 (Spiegeln, mirror image) at block next_block&: sets the mirror flags mirror_x!/mirror_y!/mirror_z!
' from the axes listed from column 16 on (the tool axis tool_axis| cannot be mirrored), or clears them for an
' empty list. datum_shift_on! says mirroring is on, mirror_reverses_direction! that an odd number of axes is
' mirrored, mirror_x_after_rotation!..mirror_z_after_rotation! whether each axis is mirrored after the rotation.
' The rotated axis directions rotated_first_axis()/rotated_second_axis() and
' datum_first_axis()/datum_second_axis() are rebuilt from the rotation angle rotation_angle, and the datum shift
' datum_shift_in_plane() and the end point rotated_position() are converted into the new axes.
PROCEDURE cycle_mirror_image
  LOCAL loop_index|,parse_column|,field_text_length|,work_text$,program_line$,x_axis_flag!,y_axis_flag!,z_axis_flag!,point_distance,work_point_y,angle_offset,alert_button|,matrix_first_x,matrix_first_y,matrix_second_x,matrix_second_y
  ' the cycle block
  current_block&=next_block&
  program_line$=program_lines$(current_block&)
  ' count the axes already mirrored
  loop_index|=FALSE
  x_axis_flag!=FALSE
  y_axis_flag!=FALSE
  z_axis_flag!=FALSE
  IF mirror_x!
    x_axis_flag!=TRUE
    INC loop_index|
  ENDIF
  IF mirror_y!
    y_axis_flag!=TRUE
    INC loop_index|
  ENDIF
  IF mirror_z!
    z_axis_flag!=TRUE
    INC loop_index|
  ENDIF
  ' the first cycle block
  IF LEFT$(program_line$,10)="CYCL DEF 8"
    ' keep the old axis directions
    previous_datum_first_axis(tool_first_axis|)=datum_first_axis(tool_first_axis|)
    previous_datum_first_axis(tool_second_axis|)=datum_first_axis(tool_second_axis|)
    previous_datum_second_axis(tool_first_axis|)=datum_second_axis(tool_first_axis|)
    previous_datum_second_axis(tool_second_axis|)=datum_second_axis(tool_second_axis|)
    previous_rotated_first_axis(tool_first_axis|)=rotated_first_axis(tool_first_axis|)
    previous_rotated_first_axis(tool_second_axis|)=rotated_first_axis(tool_second_axis|)
    previous_rotated_second_axis(tool_first_axis|)=rotated_second_axis(tool_first_axis|)
    previous_rotated_second_axis(tool_second_axis|)=rotated_second_axis(tool_second_axis|)
    ' the axis letters start at column 16
    parse_column|=16
    field_text_length|=LEN(program_line$)
    ' axes given
    IF field_text_length|>14
      REPEAT
        ' axis letter
        work_text$=MID$(program_line$,parse_column|,1)
        ' X, not mirrored yet
        IF (work_text$="X") AND (NOT mirror_x!)
          ' X is the tool axis
          IF tool_axis|=1
            ' the tool axis X cannot be mirrored
            ALERT 3,"Bezugsachse X kann nicht|gespiegelt werden!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            ' the error is reported at the current block
            error_blocks&(0)=current_block&
            error_messages$(0)="BEZUGSACHSE X KANN NICHT GESPIEGELT WERDEN!"
          ELSE
            mirror_x!=TRUE
            INC loop_index|
          ENDIF
        ELSE
          ' Y, not mirrored yet
          IF (work_text$="Y") AND (NOT mirror_y!)
            ' tool axis Y
            IF tool_axis|=2
              ' the tool axis Y cannot be mirrored
              ALERT 3,"Bezugsachse Y kann nicht|gespiegelt werden!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              ' the error is reported at the current block
              error_blocks&(0)=current_block&
              error_messages$(0)="BEZUGSACHSE Y KANN NICHT GESPIEGELT WERDEN!"
            ELSE
              mirror_y!=TRUE
              INC loop_index|
            ENDIF
          ELSE
            ' Z, not mirrored yet
            IF (work_text$="Z") AND (NOT mirror_z!)
              ' tool axis Z
              IF tool_axis|=3
                ' the tool axis Z cannot be mirrored
                ALERT 3,"Bezugsachse Z kann nicht|gespiegelt werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                ' the error is reported at the current block
                error_blocks&(0)=current_block&
                error_messages$(0)="BEZUGSACHSE Z KANN NICHT GESPIEGELT WERDEN!"
              ELSE
                mirror_z!=TRUE
                INC loop_index|
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' next axis, 4 columns on
        ADD parse_column|,4
      UNTIL loop_index|=3 OR parse_column|>field_text_length|
    ELSE
      ' no axes: mirroring off
      mirror_x!=FALSE
      mirror_y!=FALSE
      mirror_z!=FALSE
      loop_index|=FALSE
    ENDIF
    ' mirroring on?
    IF loop_index|=0
      datum_shift_on!=FALSE
    ELSE
      datum_shift_on!=TRUE
    ENDIF
    ' an odd number of mirrored axes reverses the arc directions
    IF ODD(loop_index|)
      mirror_reverses_direction!=TRUE
    ELSE
      mirror_reverses_direction!=FALSE
    ENDIF
    ' X mirrored while a rotation is active: mirror X before the rotation
    IF rotation_active! AND mirror_x!
      mirror_x_after_rotation!=FALSE
    ELSE
      mirror_x_after_rotation!=TRUE
    ENDIF
    IF rotation_active! AND mirror_y!
      mirror_y_after_rotation!=FALSE
    ELSE
      mirror_y_after_rotation!=TRUE
    ENDIF
    IF rotation_active! AND mirror_z!
      mirror_z_after_rotation!=FALSE
    ELSE
      mirror_z_after_rotation!=TRUE
    ENDIF
    ' first axis direction: 0 or PI when mirrored
    IF mirror_x!
      angle_offset=PI
    ELSE
      angle_offset=0
    ENDIF
    ' rotated
    angle_offset=angle_offset+rotation_angle
    point_distance=COS(angle_offset)
    work_point_y=SIN(angle_offset)
    rotated_first_axis(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
    rotated_first_axis(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
    datum_first_axis(tool_first_axis|)=rotated_first_axis(tool_first_axis|)
    datum_first_axis(tool_second_axis|)=rotated_first_axis(tool_second_axis|)
    ' second axis direction: PI/2, or 1.5*PI when mirrored
    IF mirror_y!
      angle_offset=PI*1.5
    ELSE
      angle_offset=PI/2
    ENDIF
    ' rotated
    angle_offset=angle_offset+rotation_angle
    point_distance=COS(angle_offset)
    work_point_y=SIN(angle_offset)
    rotated_second_axis(tool_first_axis|)=ROUND(1000000*point_distance)/1000000
    rotated_second_axis(tool_second_axis|)=ROUND(1000000*work_point_y)/1000000
    datum_second_axis(tool_first_axis|)=rotated_second_axis(tool_first_axis|)
    datum_second_axis(tool_second_axis|)=rotated_second_axis(tool_second_axis|)
    ' the datum shift in the old axes
    point_distance=datum_shift_in_plane(tool_first_axis|)*previous_datum_first_axis(tool_first_axis|)
    work_point_y=datum_shift_in_plane(tool_first_axis|)*previous_datum_first_axis(tool_second_axis|)
    point_distance=point_distance+datum_shift_in_plane(tool_second_axis|)*previous_datum_second_axis(tool_first_axis|)
    work_point_y=work_point_y+datum_shift_in_plane(tool_second_axis|)*previous_datum_second_axis(tool_second_axis|)
    matrix_first_x=datum_first_axis(tool_first_axis|)
    matrix_first_y=datum_first_axis(tool_second_axis|)
    matrix_second_x=datum_second_axis(tool_first_axis|)
    matrix_second_y=datum_second_axis(tool_second_axis|)
    ' solve the 2x2 system for the shift in the new axes
    IF matrix_first_x=0
      datum_shift_in_plane(tool_first_axis|)=work_point_y/matrix_first_y
      datum_shift_in_plane(tool_second_axis|)=point_distance/matrix_second_x
    ELSE
      IF matrix_first_y=0
        datum_shift_in_plane(tool_first_axis|)=point_distance/matrix_first_x
        datum_shift_in_plane(tool_second_axis|)=work_point_y/matrix_second_y
      ELSE
        datum_shift_in_plane(tool_second_axis|)=matrix_first_x*work_point_y-matrix_first_y*point_distance
        DIV datum_shift_in_plane(tool_second_axis|),matrix_first_x*matrix_second_y-matrix_first_y*matrix_second_x
        datum_shift_in_plane(tool_first_axis|)=(point_distance-matrix_second_x*datum_shift_in_plane(tool_second_axis|))/matrix_first_x
      ENDIF
    ENDIF
    ' the end point in the old axes
    point_distance=rotated_position(tool_first_axis|)*previous_rotated_first_axis(tool_first_axis|)
    work_point_y=rotated_position(tool_first_axis|)*previous_rotated_first_axis(tool_second_axis|)
    point_distance=point_distance+rotated_position(tool_second_axis|)*previous_rotated_second_axis(tool_first_axis|)
    work_point_y=work_point_y+rotated_position(tool_second_axis|)*previous_rotated_second_axis(tool_second_axis|)
    matrix_first_x=rotated_first_axis(tool_first_axis|)
    matrix_first_y=rotated_first_axis(tool_second_axis|)
    matrix_second_x=rotated_second_axis(tool_first_axis|)
    matrix_second_y=rotated_second_axis(tool_second_axis|)
    ' solve the 2x2 system for the end point in the new axes
    IF matrix_first_x=0
      rotated_position(tool_first_axis|)=work_point_y/matrix_first_y
      rotated_position(tool_second_axis|)=point_distance/matrix_second_x
    ELSE
      IF matrix_first_y=0
        rotated_position(tool_first_axis|)=point_distance/matrix_first_x
        rotated_position(tool_second_axis|)=work_point_y/matrix_second_y
      ELSE
        rotated_position(tool_second_axis|)=matrix_first_x*work_point_y-matrix_first_y*point_distance
        DIV rotated_position(tool_second_axis|),matrix_first_x*matrix_second_y-matrix_first_y*matrix_second_x
        rotated_position(tool_first_axis|)=(point_distance-matrix_second_x*rotated_position(tool_second_axis|))/matrix_first_x
      ENDIF
    ENDIF
    ' move the look-ahead window on
    next_block&=block_after_next&
    block_after_next&=third_block_ahead&
    skip_to_next_block(third_block_ahead&)
  ENDIF
RETURN
' CYCL DEF 10 (Drehung, rotation) at block next_block&: reads the rotation angle ROT (column 22, or a Q
' parameter, sign in column 21, incremental with "I" in column 15) into rotation_angle in radians and sets
' rotation_active!. The rotated axis directions rotated_first_axis()/rotated_second_axis() (and
' datum_first_axis()/datum_second_axis()) are rebuilt including the mirroring, and the datum shift
' datum_shift_in_plane() and the end point rotated_position() are converted into the new axes.
PROCEDURE cycle_rotation
  LOCAL radius_dot_product,program_line$,angle_offset,rotate_length,point_distance,work_point_y,parameter_number&,third_block_text$,matrix_first_x,matrix_first_y,matrix_second_x,matrix_second_y,alert_button|
  ' the cycle block
  current_block&=next_block&
  program_line$=program_lines$(current_block&)
  ' the first cycle block
  IF LEFT$(program_line$,11)="CYCL DEF 10"
    ' keep the old axis directions
    previous_datum_first_axis(tool_first_axis|)=datum_first_axis(tool_first_axis|)
    previous_datum_first_axis(tool_second_axis|)=datum_first_axis(tool_second_axis|)
    previous_datum_second_axis(tool_first_axis|)=datum_second_axis(tool_first_axis|)
    previous_datum_second_axis(tool_second_axis|)=datum_second_axis(tool_second_axis|)
    previous_rotated_first_axis(tool_first_axis|)=rotated_first_axis(tool_first_axis|)
    previous_rotated_first_axis(tool_second_axis|)=rotated_first_axis(tool_second_axis|)
    previous_rotated_second_axis(tool_first_axis|)=rotated_second_axis(tool_first_axis|)
    previous_rotated_second_axis(tool_second_axis|)=rotated_second_axis(tool_second_axis|)
    ' the angle is a Q parameter
    IF MID$(program_line$,22,1)="Q"
      ' number of the Q parameter
      parameter_number&=VAL(MID$(program_line$,23,3))
      ' defined?
      IF q_parameter_defined!(parameter_number&)
        radius_dot_product=q_parameters(parameter_number&)
      ELSE
        radius_dot_product=1
        third_block_text$="Der Parameter Q"+STR$(parameter_number&)+" wurde|noch nicht definiert!"
        ' the Q parameter has not been defined yet
        ALERT 3,third_block_text$,1,"Abbruch",alert_button|
        run_aborted!=TRUE
        ' the error is reported at the current block
        error_blocks&(0)=current_block&
        error_messages$(0)="PARAMETER Q"+STR$(parameter_number&)+" WURDE NOCH NICHT DEFINIERT!"
      ENDIF
    ELSE
      ' the angle value
      radius_dot_product=VAL(MID$(program_line$,22,8))
    ENDIF
    ' negative sign
    IF MID$(program_line$,21,1)="-"
      radius_dot_product=-radius_dot_product
    ENDIF
    ' into radians
    MUL radius_dot_product,PI/180
    ' incremental
    IF MID$(program_line$,15,1)="I"
      rotation_angle=rotation_angle+radius_dot_product
    ELSE
      rotation_angle=radius_dot_product
    ENDIF
    ' rotation on?
    IF rotation_angle=0
      rotation_active!=FALSE
    ELSE
      rotation_active!=TRUE
    ENDIF
    ' mirroring after the rotation
    mirror_x_after_rotation!=TRUE
    mirror_y_after_rotation!=TRUE
    mirror_z_after_rotation!=TRUE
    ' first axis direction
    angle_offset=0
    ' add the rotation angle
    angle_offset=angle_offset+rotation_angle
    point_distance=COS(angle_offset)
    work_point_y=SIN(angle_offset)
    point_distance=ROUND(1000000*point_distance)/1000000
    work_point_y=ROUND(1000000*work_point_y)/1000000
    ' mirrored X
    IF mirror_x!
      point_distance=-point_distance
    ENDIF
    ' mirrored Y
    IF mirror_y!
      work_point_y=-work_point_y
    ENDIF
    rotated_first_axis(tool_first_axis|)=point_distance
    rotated_first_axis(tool_second_axis|)=work_point_y
    datum_first_axis(tool_first_axis|)=point_distance
    datum_first_axis(tool_second_axis|)=work_point_y
    ' second axis direction
    angle_offset=PI/2
    ' add the rotation angle
    angle_offset=angle_offset+rotation_angle
    point_distance=COS(angle_offset)
    work_point_y=SIN(angle_offset)
    point_distance=ROUND(1000000*point_distance)/1000000
    work_point_y=ROUND(1000000*work_point_y)/1000000
    IF mirror_x!
      point_distance=-point_distance
    ENDIF
    IF mirror_y!
      work_point_y=-work_point_y
    ENDIF
    rotated_second_axis(tool_first_axis|)=point_distance
    rotated_second_axis(tool_second_axis|)=work_point_y
    datum_second_axis(tool_first_axis|)=point_distance
    datum_second_axis(tool_second_axis|)=work_point_y
    ' the datum shift in the old axes
    point_distance=datum_shift_in_plane(tool_first_axis|)*previous_datum_first_axis(tool_first_axis|)
    work_point_y=datum_shift_in_plane(tool_first_axis|)*previous_datum_first_axis(tool_second_axis|)
    point_distance=point_distance+datum_shift_in_plane(tool_second_axis|)*previous_datum_second_axis(tool_first_axis|)
    work_point_y=work_point_y+datum_shift_in_plane(tool_second_axis|)*previous_datum_second_axis(tool_second_axis|)
    matrix_first_x=datum_first_axis(tool_first_axis|)
    matrix_first_y=datum_first_axis(tool_second_axis|)
    matrix_second_x=datum_second_axis(tool_first_axis|)
    matrix_second_y=datum_second_axis(tool_second_axis|)
    ' solve the 2x2 system for the shift in the new axes
    IF matrix_first_x=0
      datum_shift_in_plane(tool_first_axis|)=work_point_y/matrix_first_y
      datum_shift_in_plane(tool_second_axis|)=point_distance/matrix_second_x
    ELSE
      IF matrix_first_y=0
        datum_shift_in_plane(tool_first_axis|)=point_distance/matrix_first_x
        datum_shift_in_plane(tool_second_axis|)=work_point_y/matrix_second_y
      ELSE
        datum_shift_in_plane(tool_second_axis|)=matrix_first_x*work_point_y-matrix_first_y*point_distance
        DIV datum_shift_in_plane(tool_second_axis|),matrix_first_x*matrix_second_y-matrix_first_y*matrix_second_x
        datum_shift_in_plane(tool_first_axis|)=(point_distance-matrix_second_x*datum_shift_in_plane(tool_second_axis|))/matrix_first_x
      ENDIF
    ENDIF
    ' the end point in the old axes
    point_distance=rotated_position(tool_first_axis|)*previous_rotated_first_axis(tool_first_axis|)
    work_point_y=rotated_position(tool_first_axis|)*previous_rotated_first_axis(tool_second_axis|)
    point_distance=point_distance+rotated_position(tool_second_axis|)*previous_rotated_second_axis(tool_first_axis|)
    work_point_y=work_point_y+rotated_position(tool_second_axis|)*previous_rotated_second_axis(tool_second_axis|)
    matrix_first_x=rotated_first_axis(tool_first_axis|)
    matrix_first_y=rotated_first_axis(tool_second_axis|)
    matrix_second_x=rotated_second_axis(tool_first_axis|)
    matrix_second_y=rotated_second_axis(tool_second_axis|)
    ' solve the 2x2 system for the end point in the new axes
    IF matrix_first_x=0
      rotated_position(tool_first_axis|)=work_point_y/matrix_first_y
      rotated_position(tool_second_axis|)=point_distance/matrix_second_x
    ELSE
      IF matrix_first_y=0
        rotated_position(tool_first_axis|)=point_distance/matrix_first_x
        rotated_position(tool_second_axis|)=work_point_y/matrix_second_y
      ELSE
        rotated_position(tool_second_axis|)=matrix_first_x*work_point_y-matrix_first_y*point_distance
        DIV rotated_position(tool_second_axis|),matrix_first_x*matrix_second_y-matrix_first_y*matrix_second_x
        rotated_position(tool_first_axis|)=(point_distance-matrix_second_x*rotated_position(tool_second_axis|))/matrix_first_x
      ENDIF
    ENDIF
    ' move the look-ahead window on
    next_block&=block_after_next&
    block_after_next&=third_block_ahead&
    skip_to_next_block(third_block_ahead&)
  ENDIF
RETURN
' CYCL DEF 11 (MASSFAKTOR, scale factor): when the current line current_block& is a scaling cycle, reads the
' factor from column 19 into scaling_factor; scaling_active! says whether scaling is on (any factor but 1).
' Moves the line window on by one (next_block&, block_after_next&, third_block_ahead&) and reads the following
' line with skip_to_next_block.
PROCEDURE apply_scaling_cycle
  LOCAL cycle_scale_factor
  ' the current line
  current_block&=next_block&
  ' a scaling cycle (MASSFAKTOR)
  IF LEFT$(program_lines$(current_block&),11)="CYCL DEF 11"
    ' the scale factor
    cycle_scale_factor=VAL(MID$(program_lines$(current_block&),19,9))
    ' factor 1 switches scaling off
    IF cycle_scale_factor=1
      scaling_active!=FALSE
    ELSE
      scaling_active!=TRUE
    ENDIF
    ' the scale factor in force
    scaling_factor=cycle_scale_factor
    ' move on one line (current = next)
    next_block&=block_after_next&
    ' next = the one after
    block_after_next&=third_block_ahead&
    skip_to_next_block(third_block_ahead&)
  ENDIF
RETURN
' FN 15 (PRINT): shows the values of the Q parameters an FN 15 line program_line$ names. Up to six parameters
' stand at columns 15, 21, 27, 33, 39 and 45; each one that is a Q parameter with a value (q_parameter_defined!)
' is written as "Qnnn" and its value q_parameters(), rounded to three decimals and with a "+" when positive,
' into the six text fields fn15_first_field&..fn15_sixth_field& of dialog fn15_dialog_tree%. The dialog is run
' with dial_run; when it did not restore the screen itself the work area is redrawn with FORM_DIAL(3). The
' fields are cleared again afterwards.
PROCEDURE show_fn15_values(program_line$)
  LOCAL dialog_status&,work_text$,basic_variables,segment_length
  ' first parameter of the FN 15 line
  work_text$=MID$(program_line$,15,4)
  ' a Q parameter
  IF LEFT$(work_text$)="Q"
    ' its number
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    ' the Q parameter has a value
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      ' positive values get a "+"
      IF basic_variables>0
        ' "Qnnn+value" into the first field
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_first_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        ' "Qnnn-value" or "Qnnn0"
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_first_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  ' second parameter
  work_text$=MID$(program_line$,21,4)
  IF LEFT$(work_text$)="Q"
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      IF basic_variables>0
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_second_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_second_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  ' third parameter
  work_text$=MID$(program_line$,27,4)
  IF LEFT$(work_text$)="Q"
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      IF basic_variables>0
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_third_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_third_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  ' fourth parameter
  work_text$=MID$(program_line$,33,4)
  IF LEFT$(work_text$)="Q"
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      IF basic_variables>0
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fourth_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fourth_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  ' fifth parameter
  work_text$=MID$(program_line$,39,4)
  IF LEFT$(work_text$)="Q"
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      IF basic_variables>0
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fifth_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fifth_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  ' sixth parameter
  work_text$=MID$(program_line$,45,4)
  IF LEFT$(work_text$)="Q"
    work_text$=RIGHT$(work_text$,3)
    segment_length=VAL(work_text$)
    IF q_parameter_defined!(segment_length)
      basic_variables=q_parameters(segment_length)
      basic_variables=CINT(1000*basic_variables)/1000
      IF basic_variables>0
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_sixth_field&)}}=work_text$+"+"+STR$(basic_variables)
      ELSE
        CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_sixth_field&)}}=work_text$+STR$(basic_variables)
      ENDIF
    ENDIF
  ENDIF
  DEFMOUSE 0
  ~WIND_UPDATE(1)
  ~@dial_run(fn15_dialog_tree%,0,-1,1,1,10,10,dialog_status&)
  ~WIND_UPDATE(0)
  DEFMOUSE 3
  ' the background was not restored by the dialog
  IF dialog_status&=0
    ' have the work area redrawn
    ~FORM_DIAL(3,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&,desk_area_x&,desk_area_y&,desk_area_w&,desk_area_h&)
  ENDIF
  ON MENU
  ' clear the six value fields again
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_first_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_second_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_third_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fourth_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_fifth_field&)}}=""
  CHAR{LONG{OB_SPEC(fn15_dialog_tree%,fn15_sixth_field&)}}=""
  ~WIND_UPDATE(2)
  ON MENU
  DEFMOUSE 3
RETURN
' CYCL DEF 14 (KONTUR): checks the sub-contours a contour cycle lists and works out for each one whether it is a
' pocket or an island. The CYCL DEF 14 lines from next_block& on name the LBL subprograms that make up the
' contour (from column 27, five columns a number); each must exist (label_start_line&() holds its start line) or
' the run stops with "Das Unterprogramm .. ist nicht vorhanden" (the subprogram does not exist). The numbers go
' into contour_label&(), their count into sub_contour_count|. Each subprogram is then walked line by line with
' the modal state (mirroring, rotation, scaling: datum_shift_on!..scaling_active!, rotation_angle,
' rotation_spare_value, scaling_factor) switched off: the contour elements (L, LP, C, CP, CR, CT, CTP) are run
' through their position routines, FN parameter lines are evaluated into q_parameters()/q_parameter_defined!(),
' and the rules for a contour subprogram are checked (no cycle calls, no TOOL/STOP lines, one radius correction
' RL/RR for the whole sub-contour, the tool moves only in the working plane, the first element is a straight
' line, start and end point are the same). Any breach shows an alert, sets run_aborted! (run aborted) and puts
' the line and an error text into error_blocks&(0)/error_messages$(0). The direction of a sub-contour
' (contour_clockwise!(), TRUE: clockwise) comes from the circle direction for a contour made of one circle,
' otherwise from the side of up to three sample points relative to the mean point contour_mean_point(); with its
' radius correction contour_side$() it gives contour_is_pocket!() (TRUE: pocket, FALSE: island). The first
' sub-contour must be a pocket. The program state (positions previous_block_start()/move_end(), the modal flags,
' current_block&/current_draw_block&, radius_correction$) is restored at the end.
PROCEDURE check_contour_cycle
  LOCAL alert_button|,line_index&,sample_count|,saved_infeed_position,saved_mirroring!,saved_mirror_x!,saved_mirror_y!,saved_mirror_z!,saved_mirror_reversal!,saved_x_unrotated!,saved_y_unrotated!,saved_z_unrotated!,missing_label_alert$,saved_rotation_active!,cycle_saved_rotation_angle,cycle_saved_rotation_value,saved_scaling_active!,cycle_saved_scale_factor,field_text_length|,loop_index|,scan_column|,start_element&,previous_correction$,element_count&,parameter_number&,correction_seen!,is_contour_element!,last_element_was_line!,file_byte|,direction_x,direction_y,normal_direction_x,normal_direction_y,contour_saved_correction$,program_line$,following_block_text$,line_head_five$,rect_width&,element_start_x,element_start_y,start_infeed_coordinate,element_end_x,element_end_y,end_height,saved_after_line_element!,saved_element_line&,saved_program_line&,contour_has_no_lines!,field_name$,circle_count&
  ' no depth step remembered yet
  previous_allowance=-1
  ' a radius correction is active
  IF radius_correction$<>"0"
    IF after_line_element!
      queue_simulated_move(current_block&,"-",-1)
    ELSE
      IF arc_pending!
        queue_simulated_move(current_block&,"-",-1)
      ENDIF
    ENDIF
  ENDIF
  ' save the program position, it is restored at the end
  element_start_x=previous_block_start(1)
  element_start_y=previous_block_start(2)
  start_infeed_coordinate=previous_block_start(3)
  element_end_x=move_end(1)
  element_end_y=move_end(3)
  end_height=move_end(3)
  ' the infeed axis position
  saved_infeed_position=end_point(infeed_axis|)
  ' save the modal mirroring, rotation and scaling state
  saved_mirroring!=datum_shift_on!
  saved_mirror_x!=mirror_x!
  saved_mirror_y!=mirror_y!
  saved_mirror_z!=mirror_z!
  saved_mirror_reversal!=mirror_reverses_direction!
  saved_x_unrotated!=mirror_x_after_rotation!
  saved_y_unrotated!=mirror_y_after_rotation!
  saved_z_unrotated!=mirror_z_after_rotation!
  saved_rotation_active!=rotation_active!
  cycle_saved_rotation_angle=rotation_angle
  cycle_saved_rotation_value=rotation_spare_value
  saved_scaling_active!=scaling_active!
  cycle_saved_scale_factor=scaling_factor
  saved_after_line_element!=after_line_element!
  saved_element_line&=current_draw_block&
  contour_saved_correction$=radius_correction$
  ' no mirroring, rotation or scaling while the sub-contours are checked
  datum_shift_on!=FALSE
  mirror_x!=FALSE
  mirror_y!=FALSE
  mirror_z!=FALSE
  mirror_reverses_direction!=FALSE
  mirror_x_after_rotation!=TRUE
  mirror_y_after_rotation!=TRUE
  mirror_z_after_rotation!=TRUE
  rotation_active!=FALSE
  rotation_angle=0
  rotation_spare_value=0
  scaling_active!=FALSE
  scaling_factor=1
  ' the CYCL DEF 14 line
  current_block&=next_block&
  line_index&=next_block&
  program_line$=program_lines$(line_index&)
  ' sub-contour count
  current_contour|=FALSE
  ' every CYCL DEF 14 line
  WHILE (LEFT$(program_line$,11)="CYCL DEF 14") AND (NOT run_aborted!)
    ' the LBL numbers start in column 27
    scan_column|=27
    field_text_length|=LEN(program_line$)
    WHILE scan_column|<field_text_length| AND (NOT run_aborted!)
      IF MID$(program_line$,scan_column|,3)<>"   "
        ' LBL number of the sub-contour
        contour_label&(current_contour|)=VAL(MID$(program_line$,scan_column|,3))
        ' that subprogram does not exist
        IF label_start_line&(contour_label&(current_contour|))=0
          missing_label_alert$="Das Unterprogramm "+STR$(contour_label&(current_contour|))+" ist|nicht vorhanden!"
          ALERT 3,missing_label_alert$,1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=line_index&
          error_messages$(0)="UNTERPROGRAMM "+STR$(contour_label&(current_contour|))+" IST NICHT VORHANDEN!"
        ENDIF
        INC current_contour|
      ENDIF
      ADD scan_column|,5
    WEND
    start_element&=line_index&
    skip_to_next_block(line_index&)
    program_line$=program_lines$(line_index&)
  WEND
  ' number of sub-contours
  sub_contour_count|=current_contour|
  current_block&=start_element&
  saved_program_line&=current_block&
  find_lookahead_blocks
  IF NOT run_aborted!
    ' check every sub-contour
    current_contour|=FALSE
    REPEAT
      ' no radius correction yet
      radius_correction$=CHR$(48)
      previous_correction$=CHR$(48)
      ' the working plane axes
      first_plane_axis|=tool_first_axis|
      second_plane_axis|=tool_second_axis|
      infeed_axis|=depth_axis|
      end_point(tool_first_axis|)=0
      end_point(tool_second_axis|)=0
      programmed_position(tool_first_axis|)=0
      programmed_position(tool_second_axis|)=0
      ' clear the sum of the element end points
      contour_mean_point(tool_first_axis|)=0
      contour_mean_point(tool_second_axis|)=0
      ' element count
      element_count&=0
      ' circle count
      circle_count&=0
      ' sample point count
      sample_count|=FALSE
      ' TRUE while the sub-contour is a single full circle
      contour_has_no_lines!=TRUE
      ' no Q parameter defined
      ARRAYFILL q_parameter_defined!(),0
      ARRAYFILL work_points(),0
      parameter_number&=contour_label&(current_contour|)
      ' first line after the LBL line
      line_index&=label_start_line&(parameter_number&)+1
      correction_seen!=FALSE
      REPEAT
        ON MENU
        program_line$=program_lines$(line_index&)
        following_block_text$=LEFT$(program_line$,2)
        line_head_five$=LEFT$(program_line$,5)
        IF RIGHT$(program_line$)="}"
        ELSE
          ' a cycle definition or cycle call
          IF (following_block_text$="CY") OR ((following_block_text$="CP") AND (MID$(program_line$,18,2)<>"  "))
            ALERT 3,"Nicht erlaubter|Programmier-Satz!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=line_index&
            error_messages$(0)="NICHT ERLAUBTER PROGRAMMIER-SATZ!"
          ELSE
            ' TOOL or STOP line
            IF (following_block_text$="TO") OR (following_block_text$="ST")
              ALERT 3,"Nicht erlaubter NC-Satz!",1,"Abbruch",alert_button|
              run_aborted!=TRUE
              error_blocks&(0)=line_index&
              error_messages$(0)="NICHT ERLAUBTER NC-SATZ!"
            ELSE
              ' the line carries a radius correction (column 44)
              IF LEN(program_line$)>44
                work_text$=MID$(program_line$,44,1)
                IF work_text$<>" "
                  radius_correction$=work_text$
                ENDIF
                ' the correction changed inside the sub-contour
                IF (radius_correction$<>previous_correction$) AND correction_seen!
                  ALERT 3,"Radiuskorrektur darf sich|innerhalb eines Kontur-|teiles nicht Ñndern!",1,"Abbruch",alert_button|
                  run_aborted!=TRUE
                  error_blocks&(0)=line_index&
                  error_messages$(0)="RADIUSKORREKTUR DARF SICH NICHT éNDERN!"
                ENDIF
                previous_correction$=radius_correction$
                correction_seen!=TRUE
              ENDIF
              ' TRUE when the line is a contour element
              is_contour_element!=FALSE
              work_text$=LEFT$(program_line$,3)
              ' previous position
              start_point(first_plane_axis|)=end_point(first_plane_axis|)
              start_point(second_plane_axis|)=end_point(second_plane_axis|)
              start_point(infeed_axis|)=end_point(infeed_axis|)
              ' straight line
              IF (work_text$="L  ") AND LEN(program_line$)>30
                IF element_count&>0
                  contour_has_no_lines!=FALSE
                ENDIF
                INC element_count&
                read_line_target(program_line$)
                ' add the end point to the sum for the mean point
                ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                start_element&=line_index&
                ' the last element was a straight line
                last_element_was_line!=TRUE
                is_contour_element!=TRUE
              ELSE
                ' straight line in polar coordinates
                IF work_text$="LP "
                  contour_has_no_lines!=FALSE
                  INC element_count&
                  interpret_polar_line(program_line$)
                  ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                  ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                  start_element&=line_index&
                  last_element_was_line!=TRUE
                  is_contour_element!=TRUE
                ELSE
                  ' circle centre
                  IF work_text$="CC "
                    read_circle_centre(program_line$)
                    ' the circle centre changed the working plane
                    IF first_plane_axis|<>tool_first_axis|
                      ALERT 3,"énderung der Arbeitsebene|ist nicht erlaubt!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      error_blocks&(0)=line_index&
                      error_messages$(0)="éNDERUNG DER ARBEITSEBENE IST NICHT ERLAUBT!"
                    ENDIF
                  ELSE
                    ' circular arc
                    IF work_text$="C  "
                      INC circle_count&
                      INC element_count&
                      read_arc_target(program_line$,9,21)
                      ' direction of the previous arc
                      field_name$=arc_direction$
                      ' direction of this arc ("+" or "-")
                      arc_direction$=@read_arc_direction$(program_line$,33)
                      ' arcs in both directions, not a single circle
                      IF (arc_direction$<>field_name$) AND circle_count&>1
                        contour_has_no_lines!=FALSE
                      ENDIF
                      ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                      ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                      start_element&=line_index&
                      last_element_was_line!=FALSE
                      is_contour_element!=TRUE
                    ELSE
                      ' circular arc in polar coordinates
                      IF work_text$="CP "
                        INC element_count&
                        interpret_polar_arc(program_line$)
                        ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                        ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                        start_element&=line_index&
                        last_element_was_line!=FALSE
                        is_contour_element!=TRUE
                      ELSE
                        ' circular arc with radius
                        IF work_text$="CR "
                          INC element_count&
                          interpret_radius_arc(program_line$)
                          ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                          ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                          start_element&=line_index&
                          last_element_was_line!=FALSE
                          is_contour_element!=TRUE
                        ELSE
                          ' tangential arc
                          IF (work_text$="CT ") AND element_count&>=2
                            ' previous_block_start()/move_end() get the previous element for the tangent
                            INC element_count&
                            previous_block_start(1)=start_point(1)
                            previous_block_start(2)=start_point(2)
                            previous_block_start(3)=start_point(3)
                            move_end(1)=end_point(1)
                            move_end(2)=end_point(2)
                            move_end(3)=end_point(3)
                            current_block&=line_index&
                            current_draw_block&=start_element&
                            IF last_element_was_line!
                              after_line_element!=TRUE
                            ELSE
                              after_line_element!=FALSE
                            ENDIF
                            interpret_tangential_arc(program_line$)
                            ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                            ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                            start_element&=line_index&
                            last_element_was_line!=FALSE
                            is_contour_element!=TRUE
                          ELSE
                            ' tangential arc in polar coordinates
                            IF (work_text$="CTP") AND element_count&>=2
                              INC element_count&
                              previous_block_start(1)=start_point(1)
                              previous_block_start(2)=start_point(2)
                              previous_block_start(3)=start_point(3)
                              move_end(1)=end_point(1)
                              move_end(2)=end_point(2)
                              move_end(3)=end_point(3)
                              current_block&=line_index&
                              current_draw_block&=start_element&
                              IF last_element_was_line!
                                after_line_element!=TRUE
                              ELSE
                                after_line_element!=FALSE
                              ENDIF
                              interpret_polar_tangential_arc(program_line$)
                              ADD contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                              ADD contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                              start_element&=line_index&
                              last_element_was_line!=FALSE
                              is_contour_element!=TRUE
                            ELSE
                              ' FN 0 Q=value
                              IF line_head_five$="FN 0 "
                                ' Q parameter number
                                rect_width&=VAL(MID$(program_line$,10,3))
                                q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)
                                q_parameter_defined!(rect_width&)=TRUE
                              ELSE
                                ' FN 1 addition
                                IF line_head_five$="FN 1 "
                                  rect_width&=VAL(MID$(program_line$,10,3))
                                  q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)+@read_number_or_parameter(program_line$,31)
                                  q_parameter_defined!(rect_width&)=TRUE
                                ELSE
                                  ' FN 2 subtraction
                                  IF line_head_five$="FN 2 "
                                    rect_width&=VAL(MID$(program_line$,10,3))
                                    q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)-@read_number_or_parameter(program_line$,31)
                                    q_parameter_defined!(rect_width&)=TRUE
                                  ELSE
                                    ' FN 3 multiplication
                                    IF line_head_five$="FN 3 "
                                      rect_width&=VAL(MID$(program_line$,10,3))
                                      q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)*@read_number_or_parameter(program_line$,31)
                                      q_parameter_defined!(rect_width&)=TRUE
                                    ELSE
                                      ' FN 4 division
                                      IF line_head_five$="FN 4 "
                                        basic_variables=@read_number_or_parameter(program_line$,31)
                                        rect_width&=VAL(MID$(program_line$,10,3))
                                        IF basic_variables=0
                                          ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                          IF alert_button|=1
                                            run_aborted!=TRUE
                                            error_blocks&(0)=current_block&
                                            error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                          ENDIF
                                          q_parameters(rect_width&)=0
                                        ELSE
                                          q_parameters(rect_width&)=@read_number_or_parameter(program_line$,17)/basic_variables
                                          q_parameter_defined!(rect_width&)=TRUE
                                        ENDIF
                                      ELSE
                                        ' FN 5 square root
                                        IF line_head_five$="FN 5 "
                                          basic_variables=@read_number_or_parameter(program_line$,22)
                                          IF basic_variables<0
                                            ALERT 3,"Wurzel aus einer|negativen Zahl|nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                            IF alert_button|=1
                                              run_aborted!=TRUE
                                              error_blocks&(0)=current_block&
                                              error_messages$(0)="WURZEL AUS EINER NEGATIVEN ZAHL NICHT ERLAUBT!"
                                            ENDIF
                                            rect_width&=VAL(MID$(program_line$,10,3))
                                            q_parameters(rect_width&)=0
                                            q_parameter_defined!(rect_width&)=TRUE
                                          ELSE
                                            rect_width&=VAL(MID$(program_line$,10,3))
                                            q_parameters(rect_width&)=SQR(basic_variables)
                                            q_parameter_defined!(rect_width&)=TRUE
                                          ENDIF
                                        ELSE
                                          ' FN 6 sine
                                          IF line_head_five$="FN 6 "
                                            rect_width&=VAL(MID$(program_line$,10,3))
                                            q_parameters(rect_width&)=SIN(RAD(@read_number_or_parameter(program_line$,22)))
                                            q_parameter_defined!(rect_width&)=TRUE
                                          ELSE
                                            ' FN 7 cosine
                                            IF line_head_five$="FN 7 "
                                              rect_width&=VAL(MID$(program_line$,10,3))
                                              q_parameters(rect_width&)=COS(RAD(@read_number_or_parameter(program_line$,22)))
                                              q_parameter_defined!(rect_width&)=TRUE
                                            ELSE
                                              ' FN 8 root of a sum of squares
                                              IF line_head_five$="FN 8 "
                                                segment_length=@read_number_or_parameter(program_line$,17)
                                                second_operand=@read_number_or_parameter(program_line$,31)
                                                rect_width&=VAL(MID$(program_line$,10,3))
                                                q_parameters(rect_width&)=SQR(segment_length*segment_length+second_operand*second_operand)
                                                q_parameter_defined!(rect_width&)=TRUE
                                              ELSE
                                                ' conditional jumps
                                                IF (line_head_five$="FN 9 ") OR (line_head_five$="FN 10") OR (line_head_five$="FN 11") OR (line_head_five$="FN 12")
                                                  segment_length=@read_number_or_parameter(program_line$,13)
                                                  second_operand=@read_number_or_parameter(program_line$,27)
                                                  ' the jump condition holds
                                                  IF segment_length=second_operand AND (line_head_five$="FN 9 ") OR (segment_length<>second_operand AND (line_head_five$="FN 10")) OR (segment_length>second_operand AND (line_head_five$="FN 11")) OR (segment_length<second_operand AND (line_head_five$="FN 12"))
                                                    ' continue at the LBL the jump names
                                                    current_block&=label_blocks&(VAL(MID$(program_line$,45,3)))
                                                    find_lookahead_blocks
                                                  ENDIF
                                                ELSE
                                                  ' FN 13 angle from two values
                                                  IF line_head_five$="FN 13"
                                                    rect_width&=VAL(MID$(program_line$,10,3))
                                                    segment_length=@read_number_or_parameter(program_line$,17)
                                                    second_operand=@read_number_or_parameter(program_line$,31)
                                                    IF segment_length=0 AND second_operand=0
                                                      ALERT 3,"Division durch Null|ist nicht erlaubt!",1,"Abbruch| Weiter ",alert_button|
                                                      IF alert_button|=1
                                                        run_aborted!=TRUE
                                                        error_blocks&(0)=current_block&
                                                        error_messages$(0)="DIVISION DURCH NULL NICHT ERLAUBT!"
                                                      ENDIF
                                                      q_parameters(rect_width&)=0
                                                    ELSE
                                                      IF segment_length=0
                                                        q_parameters(rect_width&)=0
                                                        q_parameter_defined!(rect_width&)=TRUE
                                                      ELSE
                                                        IF second_operand=0
                                                          q_parameters(rect_width&)=DEG(ASIN(segment_length))
                                                          q_parameter_defined!(rect_width&)=TRUE
                                                        ELSE
                                                          q_parameters(rect_width&)=ATN(segment_length/second_operand)
                                                          q_parameters(rect_width&)=DEG(q_parameters(rect_width&))
                                                          q_parameter_defined!(rect_width&)=TRUE
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ELSE
                                                    IF line_head_five$="FN 14"
                                                    ELSE
                                                      IF line_head_five$="FN 15"
                                                      ELSE
                                                        ' rounding right after the start point
                                                        IF (work_text$="RND") AND element_count&=1
                                                          ALERT 3,"RND-Befehl ist hier|nicht mîglich, da vorheriger|Satz nur Startpunkt angibt!",1,"Abbruch",alert_button|
                                                          run_aborted!=TRUE
                                                          error_blocks&(0)=line_index&
                                                          error_messages$(0)="RND-BEFEHL IST HIER NICHT MôGLICH!"
                                                        ELSE
                                                          ' chamfer right after the start point
                                                          IF (work_text$="L  ") AND LEN(program_line$)<30 AND element_count&=1
                                                            ALERT 3,"FASEN-Befehl ist hier|nicht mîglich, da vorheriger|Satz nur Startpunkt angibt!",1,"Abbruch",alert_button|
                                                            run_aborted!=TRUE
                                                            error_blocks&(0)=line_index&
                                                            error_messages$(0)="FASEN-BEFEHL IST HIER NICHT MôGLICH!"
                                                          ENDIF
                                                        ENDIF
                                                      ENDIF
                                                    ENDIF
                                                  ENDIF
                                                ENDIF
                                              ENDIF
                                            ENDIF
                                          ENDIF
                                        ENDIF
                                      ENDIF
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
              IF 1E-06<ABS(start_point(depth_axis|)-end_point(depth_axis|))
                ALERT 3,"Der FrÑser darf nur in der|Ebene senkrecht zur|Bezugsachse bewegt werden!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=line_index&
                ' tool axis Z
                IF tool_axis|=3
                  error_messages$(0)="FRéSER DARF NUR IN DER X-Y-EBENE BEWEGT WERDEN!"
                ELSE
                  IF tool_axis|=2
                    error_messages$(0)="FRéSER DARF NUR IN DER Z-X-EBENE BEWEGT WERDEN!"
                  ELSE
                    error_messages$(0)="FRéSER DARF NUR IN DER Y-Z-EBENE BEWEGT WERDEN!"
                  ENDIF
                ENDIF
              ELSE
                ' the start point is not part of the mean point
                IF element_count&=1
                  SUB contour_mean_point(first_plane_axis|),end_point(first_plane_axis|)
                  SUB contour_mean_point(second_plane_axis|),end_point(second_plane_axis|)
                ENDIF
                ' a contour element
                IF is_contour_element!
                  ' the first element, it gives the start point
                  IF element_count&=1
                    start_point(first_plane_axis|)=end_point(first_plane_axis|)
                    start_point(second_plane_axis|)=end_point(second_plane_axis|)
                    ' the first element is not a straight line
                    IF NOT last_element_was_line!
                      ALERT 3,"1. Konturelement muû eine|Linear-Interpolation (L) sein!",1,"Abbruch",alert_button|
                      run_aborted!=TRUE
                      error_blocks&(0)=line_index&
                      error_messages$(0)="1. KONTURELEMENT MUSS EINE LINEAR-INTERPOLATION SEIN!"
                    ENDIF
                  ENDIF
                  IF element_count&<4 AND (element_count&>0 AND (9.99999999999997E-06<ABS(end_point(first_plane_axis|)-work_points(0,first_plane_axis|)) OR 9.99999999999997E-06<ABS(end_point(second_plane_axis|)-work_points(0,second_plane_axis|))))
                    ' one more sample point
                    INC sample_count|
                    work_points(PRED(element_count&),first_plane_axis|)=end_point(first_plane_axis|)
                    work_points(PRED(element_count&),second_plane_axis|)=end_point(second_plane_axis|)
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' next line of the subprogram
        INC line_index&
        ' up to the end of the subprogram
      UNTIL line_index&=label_end_line&(parameter_number&) OR run_aborted!
      ' no radius correction in the sub-contour
      IF radius_correction$="0"
        ALERT 3,"Radiuskorrektur muû|>RL< oder >RR< sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=label_start_line&(parameter_number&)
        error_messages$(0)="RADIUSKORREKTUR MUSS >RL< ODER >RR< SEIN!"
      ELSE
        IF 9.99999999999997E-06<ABS(end_point(first_plane_axis|)-work_points(0,first_plane_axis|)) OR 9.99999999999997E-06<ABS(end_point(second_plane_axis|)-work_points(0,second_plane_axis|))
          ALERT 3,"Anfangs- und Endpunkt|der Teilkontur|stimmen nicht Åberein!",1,"Abbruch",alert_button|
          run_aborted!=TRUE
          error_blocks&(0)=label_start_line&(parameter_number&)
          error_messages$(0)="ANFANGS-UND ENDPUNKT STIMMEN NICHT öBEREIN!"
        ENDIF
      ENDIF
      IF NOT run_aborted!
        ' radius correction of the sub-contour
        contour_side$(current_contour|)=radius_correction$
        ' a single circle, its direction is the circle direction
        IF contour_has_no_lines!
          ' a single circle started from a straight line is no contour
          IF last_element_was_line!
            ALERT 3,"Unsinnige Teilkontur!",1,"Abbruch",alert_button|
            run_aborted!=TRUE
            error_blocks&(0)=label_start_line&(parameter_number&)
            error_messages$(0)="UNSINNIGE TEILKONTUR!"
          ELSE
            ' clockwise
            IF arc_direction$="-"
              contour_clockwise!(current_contour|)=TRUE
            ELSE
              contour_clockwise!(current_contour|)=FALSE
            ENDIF
          ENDIF
        ELSE
          ' count of samples on the right and on the left
          samples_right|=FALSE
          samples_left|=FALSE
          ' the mean point of the element end points
          DEC element_count&
          DIV contour_mean_point(first_plane_axis|),element_count&
          DIV contour_mean_point(second_plane_axis|),element_count&
          ' sample index
          loop_index|=FALSE
          ' the last sample is not used
          IF sample_count|
            DEC sample_count|
          ENDIF
          REPEAT
            ' sample relative to the mean point
            direction_x=work_points(loop_index|,first_plane_axis|)-contour_mean_point(first_plane_axis|)
            direction_y=work_points(loop_index|,second_plane_axis|)-contour_mean_point(second_plane_axis|)
            scan_column|=SUCC(loop_index|)
            ' the sample is straight above or below the mean point
            IF direction_x=0
              IF work_points(scan_column|,first_plane_axis|)>contour_mean_point(first_plane_axis|) AND direction_y<0 OR (work_points(scan_column|,first_plane_axis|)<contour_mean_point(first_plane_axis|) AND direction_y>=0)
                line_parameter=-1
              ELSE
                line_parameter=1
              ENDIF
            ELSE
              ' the normal of the line from the mean point to the sample
              normal_direction_x=-direction_y
              normal_direction_y=direction_x
              ' which side of that line the next sample lies
              line_parameter=contour_mean_point(second_plane_axis|)-work_points(scan_column|,second_plane_axis|)+direction_y/direction_x*(work_points(scan_column|,first_plane_axis|)-contour_mean_point(first_plane_axis|))
              DIV line_parameter,normal_direction_y-normal_direction_x*direction_y/direction_x
            ENDIF
            ' the next sample lies to the right
            IF line_parameter>0
              INC samples_right|
            ELSE
              IF line_parameter<0
                INC samples_left|
              ENDIF
            ENDIF
            INC loop_index|
          UNTIL loop_index|>=sample_count|
          ' mostly to the right, the sub-contour runs clockwise
          IF samples_right|>samples_left|
            contour_clockwise!(current_contour|)=TRUE
          ELSE
            contour_clockwise!(current_contour|)=FALSE
          ENDIF
        ENDIF
        ' clockwise with correction RR, or counter-clockwise with RL, gives a pocket
        IF contour_clockwise!(current_contour|)
          IF contour_side$(current_contour|)="R"
            contour_is_pocket!(current_contour|)=TRUE
          ELSE
            contour_is_pocket!(current_contour|)=FALSE
          ENDIF
        ELSE
          IF contour_side$(current_contour|)="L"
            contour_is_pocket!(current_contour|)=TRUE
          ELSE
            contour_is_pocket!(current_contour|)=FALSE
          ENDIF
        ENDIF
      ENDIF
      INC current_contour|
    UNTIL current_contour|=sub_contour_count| OR run_aborted!
    IF NOT run_aborted!
      ' the first sub-contour is an island
      IF NOT contour_is_pocket!(0)
        ALERT 3,"1. Teilkontur muû|eine Tasche sein!",1,"Abbruch",alert_button|
        run_aborted!=TRUE
        error_blocks&(0)=label_start_line&(contour_label&(0))
        error_messages$(0)="1. TEILKONTUR MUSS EINE TASCHE SEIN!"
      ENDIF
      ' back to the infeed position
      start_point(infeed_axis|)=saved_infeed_position
      programmed_position(infeed_axis|)=saved_infeed_position
      end_point(infeed_axis|)=saved_infeed_position
    ENDIF
  ENDIF
  ' restore the program state
  previous_block_start(1)=element_start_x
  previous_block_start(2)=element_start_y
  previous_block_start(3)=start_infeed_coordinate
  move_end(1)=element_end_x
  move_end(2)=element_end_y
  move_end(3)=end_height
  datum_shift_on!=saved_mirroring!
  mirror_x!=saved_mirror_x!
  mirror_y!=saved_mirror_y!
  mirror_z!=saved_mirror_z!
  mirror_reverses_direction!=saved_mirror_reversal!
  mirror_x_after_rotation!=saved_x_unrotated!
  mirror_y_after_rotation!=saved_y_unrotated!
  mirror_z_after_rotation!=saved_z_unrotated!
  rotation_active!=saved_rotation_active!
  rotation_angle=cycle_saved_rotation_angle
  rotation_spare_value=cycle_saved_rotation_value
  scaling_active!=saved_scaling_active!
  scaling_factor=cycle_saved_scale_factor
  after_line_element!=saved_after_line_element!
  current_draw_block&=saved_element_line&
  current_block&=saved_program_line&
  radius_correction$=contour_saved_correction$
RETURN
' Builds the tool paths of a contour pocket from the sub-contours checked by check_contour_cycle. tool_radius
' already includes the finishing allowance (simulate_cycle_call adds it before the call). First pass: for each
' sub-contour current_contour| (LBL contour_label&(current_contour|)) the radius correction is swapped when an
' odd number of axes is mirrored (mirror_reverses_direction!), the start point is set up
' (offset_element_at_corner, store_generated_line) and run_program_blocks writes the tool-centre (offset)
' contour into offset_contour_elements$(current_contour|,..), its last line index into
' offset_contour_last_line&(current_contour|). When the closing corner of the sub-contour is an outside corner
' (closing_corner_arc_needed!, from offset_element_at_corner) its corner arc is added at the end of the
' offset contour by
' draw_corner_transition_arc. Second pass: pockets and islands whose offset contours cross are merged.
' classify_contour_nesting gives the relation of two contours (contour_relation|(,)),
' find_nearest_contour_crossing finds the next intersection on a contour (point in
' nearest_crossing_x/nearest_crossing_y); the walk follows one contour and switches to the other at each
' intersection, reversing direction where the relation needs it, and writes the result into
' tool_path_elements$(merged_contour_count|,..) with new LBL 0 ends. When contours were merged the result
' replaces the sub-contour arrays (SWAP) and the merge is run once more. The start point of the first
' sub-contour must not lie on an island, and the merged contours must fit in max_merged_lines& lines. The
' original pocket/island, direction and correction arrays are restored from saved_contour_is_pocket!(),
' saved_contour_clockwise!(), saved_contour_side$() when a merge was done, and the mirrored corrections are
' swapped back. run_aborted! is set on an error, stop_requested! when the user cancels.
PROCEDURE build_contour_pocket_paths
  LOCAL alert_button|,line_index&,search_block&,crossing_element&,element_start_x,element_start_y,element_end_x,element_end_y,program_line$,following_block_text$,unused_pocket_value,closing_corner_arc_direction$,scan_index&,element_prefix$,last_element_was_line!,other_contour|,unused_pocket_offset,contours_touch!,crossing_found!,contour_relation_code|,start_on_island!,max_merged_lines&,pair_table_bytes%,pair_table_stride&,text_length&,original_contour_count|,contours_merged!,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,file_byte|,loop_index|,item_count&,inner_index|,angle_offset,parsed_value,input_text$,work_text$,edit_work_text$,is_finished!,parse_column|,stay_on_contour!,change_contour!,merge_pass|
  ' busy mouse
  DEFMOUSE 2
  ' contour pocket paths are being built
  in_subprogram_call!=TRUE
  corner_point_moved!=FALSE
  ' most lines a merged contour may have
  max_merged_lines&=max_program_lines&*2-3
  ' the number of sub-contours before merging
  original_contour_count|=sub_contour_count|
  save_restore_program_state(-1)
  ' first pass, one offset contour per sub-contour
  current_contour|=FALSE
  REPEAT
    ON MENU
    ' offset contour line count
    path_line_index&=0
    first_plane_axis|=tool_first_axis|
    second_plane_axis|=tool_second_axis|
    infeed_axis|=depth_axis|
    corner_arc_needed!=FALSE
    ' an odd number of mirrored axes swaps RL and RR
    IF mirror_reverses_direction!
      IF contour_side$(current_contour|)="R"
        contour_side$(current_contour|)="L"
      ELSE
        contour_side$(current_contour|)="R"
      ENDIF
    ENDIF
    ' start point of the sub-contour
    offset_element_at_corner(0)
    ' TRUE when the closing corner (last element back to the first) needs an outside corner arc, added after the
    ' run below
    closing_corner_arc_needed!=corner_arc_needed!
    closing_corner_arc_direction$=corner_arc_direction$
    ' save the start positions
    element_start_x=move_compensated_end(first_plane_axis|)
    element_start_y=move_compensated_end(second_plane_axis|)
    element_end_x=compensated_start(first_plane_axis|)
    element_end_y=compensated_start(second_plane_axis|)
    ' the LBL line of the sub-contour
    line_index&=label_start_line&(contour_label&(current_contour|))
    skip_to_next_block(line_index&)
    program_line$=program_lines$(line_index&)
    following_block_text$=LEFT$(program_line$,2)
    ' skip to the first contour element
    WHILE NOT (following_block_text$="L ") AND LEN(program_line$)>20 OR (following_block_text$="LP") OR (following_block_text$="CC") OR (following_block_text$="C ") OR (following_block_text$="CP") OR (following_block_text$="CR")
      skip_to_next_block(line_index&)
      program_line$=program_lines$(line_index&)
      following_block_text$=LEFT$(program_line$,2)
    WEND
    ' position of the first element
    read_line_target(program_lines$(line_index&))
    start_point(first_plane_axis|)=end_point(first_plane_axis|)
    start_point(second_plane_axis|)=end_point(second_plane_axis|)
    ' the infeed axis at the start depth
    start_point(infeed_axis|)=blank_bottom
    end_point(infeed_axis|)=blank_bottom
    programmed_position(infeed_axis|)=blank_bottom
    line_index&=label_start_line&(contour_label&(current_contour|))
    REPEAT
      skip_to_next_block(line_index&)
    UNTIL LEFT$(program_lines$(line_index&),2)="L "
    store_generated_line(line_index&,compensated_start(first_plane_axis|),compensated_start(second_plane_axis|))
    IF NOT run_aborted!
      path_line_index&=1
      corner_point_moved!=FALSE
      radius_correction$=contour_side$(current_contour|)
      compensation_side$=radius_correction$
      previous_compensation$=radius_correction$
      after_line_element!=FALSE
      arc_pending!=FALSE
      run_program_blocks(line_index&,-1)
      IF (NOT stop_requested!) AND (NOT run_aborted!)
        compensated_start(first_plane_axis|)=element_start_x
        compensated_start(second_plane_axis|)=element_start_y
        IF after_line_element!
          line_index&=label_end_line&(contour_label&(current_contour|))
          REPEAT
            skip_to_previous_block(line_index&)
          UNTIL LEFT$(program_lines$(line_index&))="L"
          store_generated_line(line_index&,compensated_start(first_plane_axis|),compensated_start(second_plane_axis|))
        ELSE
          IF arc_pending!
            store_generated_arc(line_index&,compensated_start(first_plane_axis|),compensated_start(second_plane_axis|),circle_centre(first_plane_axis|),circle_centre(second_plane_axis|),arc_direction$)
          ENDIF
        ENDIF
        ' the closing corner arc from the end of the last offset element to the start of the first
        IF closing_corner_arc_needed!
          move_compensated_end(first_plane_axis|)=element_start_x
          move_compensated_end(second_plane_axis|)=element_start_y
          compensated_start(first_plane_axis|)=element_end_x
          compensated_start(second_plane_axis|)=element_end_y
          move_end(first_plane_axis|)=end_point(first_plane_axis|)
          move_end(second_plane_axis|)=end_point(second_plane_axis|)
          corner_arc_direction$=closing_corner_arc_direction$
          draw_corner_transition_arc
        ENDIF
        offset_contour_last_line&(current_contour|)=PRED(path_line_index&)
      ENDIF
    ENDIF
    INC current_contour|
  UNTIL current_contour|=sub_contour_count| OR run_aborted! OR stop_requested!
  GOTO offset_contours_built
  line_index&=0
  REPEAT
    PRINT offset_contour_elements$(1,line_index&)
    INC line_index&
  UNTIL line_index&=offset_contour_last_line&(1)+1
  PRINT
  END
  PRINT
  line_index&=0
  REPEAT
    PRINT offset_contour_elements$(2,line_index&)
    INC line_index&
  UNTIL line_index&=offset_contour_last_line&(2)+1
  END
offset_contours_built:
  IF (NOT run_aborted!) AND (NOT stop_requested!)
    saved_contour_is_pocket!(0)=contour_is_pocket!(0)
    saved_contour_clockwise!(0)=contour_clockwise!(0)
    saved_contour_side$(0)=contour_side$(0)
    contours_touch!=FALSE
    start_on_island!=FALSE
    IF sub_contour_count|>1
      current_contour|=FALSE
      other_contour|=1
      FOR other_contour|=1 TO PRED(sub_contour_count|)
        saved_contour_is_pocket!(other_contour|)=contour_is_pocket!(other_contour|)
        saved_contour_clockwise!(other_contour|)=contour_clockwise!(other_contour|)
        saved_contour_side$(other_contour|)=contour_side$(other_contour|)
        classify_contour_nesting(other_contour|,contours_touch!)
        IF contours_touch! AND (NOT contour_is_pocket!(other_contour|))
          start_on_island!=TRUE
        ENDIF
      NEXT other_contour|
    ENDIF
    IF start_on_island!
      ALERT 3,"Startpunk der 1. Teil-|kontur darf nicht auf|einer Insel liegen!",1,"Abbruch",alert_button|
      run_aborted!=TRUE
      error_blocks&(0)=label_start_line&(contour_label&(other_contour|))
      error_messages$(0)="STARTPUNKT DARF NICHT AUF EINER INSEL LIEGEN!"
    ELSE
      merge_pass|=FALSE
      contours_merged!=FALSE
      REPEAT
        INC merge_pass|
        pair_table_stride&=0
        current_contour|=FALSE
        REPEAT
          IF pair_table_stride&<offset_contour_last_line&(current_contour|)
            pair_table_stride&=offset_contour_last_line&(current_contour|)
          ENDIF
          INC current_contour|
        UNTIL current_contour|=sub_contour_count|
        ADD pair_table_stride&,3
        pair_table_bytes%=pair_table_stride&*(pair_table_stride&*(sub_contour_count|*sub_contour_count|)) DIV 8
        IF pair_table_bytes%>2000
          pair_table_bytes%=pair_table_bytes%*1
          IF pair_table_bytes%<FRE(0)
            pair_table_made!=TRUE
            DIM element_pair_may_cross!(sub_contour_count|*pair_table_stride&,sub_contour_count|*pair_table_stride&)
            ARRAYFILL element_pair_may_cross!(),-1
          ENDIF
        ELSE
          IF FRE(0)>3000
            pair_table_made!=TRUE
            DIM element_pair_may_cross!(sub_contour_count|*pair_table_stride&,sub_contour_count|*pair_table_stride&)
            ARRAYFILL element_pair_may_cross!(),-1
          ENDIF
        ENDIF
        start_contour|=FALSE
        merged_contour_count|=FALSE
        ARRAYFILL contour_visited!(),0
        ARRAYFILL contour_used!(),0
        ARRAYFILL pair_crossing_used!(),0
        ARRAYFILL crossing_count_table|(),0
        ARRAYFILL contour_relation|(),0
        REPEAT
          IF (NOT contour_visited!(start_contour|)) AND (NOT contour_used!(start_contour|))
            ARRAYFILL contour_joined!(),0
            contour_visited!(start_contour|)=TRUE
            tool_path_elements$(merged_contour_count|,0)=offset_contour_elements$(start_contour|,0)
            merged_line_index&=1
            path_side$(merged_contour_count|)=contour_side$(start_contour|)
            merged_is_pocket!(merged_contour_count|)=contour_is_pocket!(start_contour|)
            contour_direction!(merged_contour_count|)=contour_clockwise!(start_contour|)
            current_contour|=start_contour|
            walk_forwards!=TRUE
            path_line_index&=1
            line_index&=0
            start_on_island!=FALSE
            crossing_found!=FALSE
            REPEAT
              ON MENU
              IF stop_requested!
                run_aborted!=TRUE
              ELSE
                IF walk_forwards!
                  INC line_index&
                  IF line_index&>offset_contour_last_line&(current_contour|)
                    line_index&=1
                  ENDIF
                ELSE
                  IF LEFT$(offset_contour_elements$(current_contour|,line_index&),2)="C "
                    SUB line_index&,2
                  ELSE
                    DEC line_index&
                  ENDIF
                  IF line_index&<1
                    line_index&=offset_contour_last_line&(current_contour|)
                  ENDIF
                ENDIF
                path_line_index&=line_index&
                find_nearest_contour_crossing(pair_table_stride&,line_index&,crossing_found!,start_contour|,other_contour|,crossing_element&)
                stay_on_contour!=TRUE
                change_contour!=FALSE
                IF crossing_found!
                  IF crossing_count_table|(current_contour|,other_contour|)<10
                    INC crossing_count_table|(current_contour|,other_contour|)
                    INC crossing_count_table|(other_contour|,current_contour|)
                  ENDIF
                  crossing_table_x(current_contour|,other_contour|,crossing_count_table|(current_contour|,other_contour|))=nearest_crossing_x
                  crossing_table_y(current_contour|,other_contour|,crossing_count_table|(current_contour|,other_contour|))=nearest_crossing_y
                  crossing_table_x(other_contour|,current_contour|,crossing_count_table|(current_contour|,other_contour|))=nearest_crossing_x
                  crossing_table_y(other_contour|,current_contour|,crossing_count_table|(current_contour|,other_contour|))=nearest_crossing_y
                  IF NOT pair_crossing_used!(current_contour|,other_contour|)
                    IF contour_relation|(current_contour|,other_contour|)=0
                      classify_contour_nesting(other_contour|,contours_touch!)
                    ENDIF
                    contour_relation_code|=contour_relation|(current_contour|,other_contour|)
                    IF contour_relation_code|=5 OR contour_relation_code|=6 AND merge_pass|=1
                      contours_merged!=TRUE
                      stay_on_contour!=FALSE
                    ELSE
                      IF contour_used!(other_contour|)
                        IF contour_relation_code|=5 OR contour_relation_code|=6
                          start_on_island!=TRUE
                        ENDIF
                      ELSE
                        pair_crossing_used!(current_contour|,other_contour|)=TRUE
                        pair_crossing_used!(other_contour|,current_contour|)=TRUE
                        change_contour!=TRUE
                        contour_joined!(other_contour|)=TRUE
                        contour_visited!(other_contour|)=TRUE
                        IF contour_relation_code|=5 AND (NOT contour_is_pocket!(unset_contour_index|))
                          merged_is_pocket!(merged_contour_count|)=TRUE
                        ELSE
                          IF contour_relation_code|=6 AND contour_is_pocket!(current_contour|)
                            merged_is_pocket!(merged_contour_count|)=FALSE
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ELSE
                    contour_relation_code|=contour_relation|(current_contour|,other_contour|)
                    IF contour_relation_code|=5 OR contour_relation_code|=6 AND merge_pass|=1
                      contours_merged!=TRUE
                      stay_on_contour!=FALSE
                    ELSE
                      IF contour_used!(other_contour|)
                        IF contour_relation_code|=5 OR contour_relation_code|=6
                          start_on_island!=TRUE
                        ENDIF
                      ELSE
                        change_contour!=TRUE
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                IF (NOT start_on_island!) AND stay_on_contour!
                  IF LEFT$(offset_contour_elements$(current_contour|,path_line_index&))="C"
                    IF walk_forwards!
                      tool_path_elements$(merged_contour_count|,merged_line_index&)=offset_contour_elements$(current_contour|,path_line_index&)
                      INC merged_line_index&
                      INC path_line_index&
                      tool_path_elements$(merged_contour_count|,merged_line_index&)=offset_contour_elements$(current_contour|,path_line_index&)
                    ELSE
                      tool_path_elements$(merged_contour_count|,merged_line_index&)=offset_contour_elements$(current_contour|,PRED(path_line_index&))
                      INC merged_line_index&
                      tool_path_elements$(merged_contour_count|,merged_line_index&)=offset_contour_elements$(current_contour|,path_line_index&)
                    ENDIF
                  ELSE
                    tool_path_elements$(merged_contour_count|,merged_line_index&)=offset_contour_elements$(current_contour|,path_line_index&)
                    IF path_line_index&=0 AND current_contour|<>start_contour|
                      MID$(tool_path_elements$(merged_contour_count|,merged_line_index&),44,1)=(" ")
                    ENDIF
                  ENDIF
                  IF NOT walk_forwards!
                    program_line$=tool_path_elements$(merged_contour_count|,merged_line_index&)
                    scan_index&=4
                    x_axis_flag!=FALSE
                    y_axis_flag!=FALSE
                    z_axis_flag!=FALSE
                    REPEAT
                      INC scan_index&
                      IF MID$(program_line$,scan_index&,1)="X"
                        x_axis_flag!=TRUE
                        input_column&=scan_index&+1
                      ELSE
                        IF MID$(program_line$,scan_index&,1)="Y"
                          y_axis_flag!=TRUE
                          input_row&=scan_index&+1
                        ELSE
                          IF MID$(program_line$,scan_index&,1)="Z"
                            z_axis_flag!=TRUE
                            z_value_column&=scan_index&+1
                          ENDIF
                        ENDIF
                      ENDIF
                    UNTIL scan_index&=33
                    IF tool_axis|=3
                      z_axis_flag!=FALSE
                    ELSE
                      IF tool_axis|=2
                        y_axis_flag!=FALSE
                      ELSE
                        x_axis_flag!=FALSE
                      ENDIF
                    ENDIF
                    IF x_axis_flag! OR y_axis_flag! OR z_axis_flag!
                      take_previous_end_point(-1,-1,path_line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$)
                    ENDIF
                    IF MID$(program_line$,32,2)="R+"
                      MID$(program_line$,32,2)=("R-")
                    ELSE
                      IF MID$(program_line$,32,2)="R-"
                        MID$(program_line$,32,2)=("R+")
                      ENDIF
                    ENDIF
                    tool_path_elements$(merged_contour_count|,merged_line_index&)=program_line$
                  ENDIF
                  INC merged_line_index&
                  IF change_contour!
                    line_index&=crossing_element&
                    SELECT contour_relation|(current_contour|,other_contour|)
                    CASE 1,2,3,4
                      IF contour_clockwise!(current_contour|)<>(contour_clockwise!(other_contour|))
                        walk_forwards!=NOT walk_forwards!
                      ENDIF
                    DEFAULT
                      IF contour_clockwise!(current_contour|)=(contour_clockwise!(other_contour|))
                        walk_forwards!=NOT walk_forwards!
                      ENDIF
                    ENDSELECT
                    DEC merged_line_index&
                    start_point(first_plane_axis|)=nearest_crossing_x
                    start_point(second_plane_axis|)=nearest_crossing_y
                    IF LEFT$(tool_path_elements$(merged_contour_count|,merged_line_index&))="L"
                      ' find the second element
                      loop_index|=FALSE
                      inner_index|=first_plane_axis|
                      REPEAT
                        INC loop_index|
                        parsed_value=ROUND(start_point(inner_index|)*100000)/100000
                        IF parsed_value>9999.99999
                          ALERT 3,"Koordinaten|sind fehlerhaft!",1,"Abbruch",alert_button|
                          run_aborted!=TRUE
                          error_blocks&(0)=current_draw_block&
                          error_messages$(0)="KOORDINATEN SIND FEHLERHAFT!"
                        ELSE
                          IF parsed_value>=0
                            edit_work_text$=CHR$(43)
                          ELSE
                            edit_work_text$=CHR$(45)
                          ENDIF
                          file_byte|=FALSE
                          input_text$=STR$(parsed_value)
                          text_length&=LEN(input_text$)
                          REPEAT
                            INC file_byte|
                          UNTIL (MID$(input_text$,file_byte|,1)=".") OR file_byte|=text_length&
                          IF file_byte|=text_length&
                            work_text$=".00000"
                          ELSE
                            work_text$=STRING$(file_byte|+(5-text_length&),48)
                          ENDIF
                          is_finished!=FALSE
                          angle_offset=ABS(parsed_value)
                          IF parsed_value=0
                            edit_work_text$=edit_work_text$+"   0.00000"
                          ELSE
                            IF angle_offset>1
                              item_count&=3
                              REPEAT
                                IF angle_offset>=10^item_count&
                                  edit_work_text$=edit_work_text$+SPACE$(3-item_count&)+STR$(angle_offset)+work_text$
                                  is_finished!=TRUE
                                ENDIF
                                DEC item_count&
                              UNTIL item_count&=-1 OR is_finished!
                            ELSE
                              edit_work_text$=edit_work_text$+"   "+STR$(angle_offset)+work_text$
                            ENDIF
                          ENDIF
                          MID$(tool_path_elements$(merged_contour_count|,merged_line_index&),PRED(axis_value_columns|(inner_index|)),11)=(edit_work_text$)
                        ENDIF
                        inner_index|=second_plane_axis|
                      UNTIL loop_index|=2 OR run_aborted!
                    ELSE
                      loop_index|=first_plane_axis|
                      inner_index|=FALSE
                      parse_column|=9
                      REPEAT
                        INC inner_index|
                        parsed_value=ROUND(start_point(loop_index|)*100000)/100000
                        IF parsed_value>9999.99999
                          ALERT 3,"Koordinaten|sind fehlerhaft!",1,"Abbruch",alert_button|
                          run_aborted!=TRUE
                          error_blocks&(0)=line_index&
                          error_messages$(0)="KOORDINATEN SIND FEHLERHAFT!"
                        ELSE
                          IF parsed_value>=0
                            edit_work_text$=CHR$(43)
                          ELSE
                            edit_work_text$=CHR$(45)
                          ENDIF
                          file_byte|=FALSE
                          input_text$=STR$(parsed_value)
                          text_length&=LEN(input_text$)
                          REPEAT
                            INC file_byte|
                          UNTIL (MID$(input_text$,file_byte|,1)=".") OR file_byte|=text_length&
                          IF file_byte|=text_length&
                            work_text$=".00000"
                          ELSE
                            work_text$=STRING$(file_byte|+(5-text_length&),48)
                          ENDIF
                          is_finished!=FALSE
                          angle_offset=ABS(parsed_value)
                          IF parsed_value=0
                            edit_work_text$=edit_work_text$+"   0.00000"
                          ELSE
                            IF angle_offset>1
                              item_count&=3
                              REPEAT
                                IF angle_offset>=10^item_count&
                                  edit_work_text$=edit_work_text$+SPACE$(3-item_count&)+STR$(angle_offset)+work_text$
                                  is_finished!=TRUE
                                ENDIF
                                DEC item_count&
                              UNTIL item_count&=-1 OR is_finished!
                            ELSE
                              edit_work_text$=edit_work_text$+"   "+STR$(angle_offset)+work_text$
                            ENDIF
                          ENDIF
                          MID$(tool_path_elements$(merged_contour_count|,merged_line_index&),PRED(parse_column|),11)=(edit_work_text$)
                        ENDIF
                        parse_column|=21
                        loop_index|=second_plane_axis|
                      UNTIL inner_index|=2 OR run_aborted!
                    ENDIF
                    INC merged_line_index&
                    current_contour|=other_contour|
                    IF walk_forwards!
                      IF LEFT$(offset_contour_elements$(current_contour|,line_index&),2)="C "
                        SUB line_index&,2
                      ELSE
                        DEC line_index&
                      ENDIF
                    ELSE
                      INC line_index&
                    ENDIF
                  ENDIF
                ELSE
                  IF walk_forwards!
                    IF LEFT$(offset_contour_elements$(current_contour|,line_index&),2)="C "
                      SUB line_index&,2
                    ELSE
                      DEC line_index&
                    ENDIF
                  ELSE
                    INC line_index&
                  ENDIF
                ENDIF
              ENDIF
              IF merged_line_index&>=max_merged_lines&
                ALERT 3,"Die Anzahl der maximal|eingebbaren ProgrammsÑtze|ist zu klein!",1,"Abbruch",alert_button|
                run_aborted!=TRUE
                error_blocks&(0)=1
                error_messages$(0)="DIE ANZAHL DER MAX. PROGRAMMSAETZE IST ZU GERING!"
              ENDIF
            UNTIL line_index&=offset_contour_last_line&(start_contour|) AND current_contour|=start_contour| OR run_aborted! OR stop_requested! OR start_on_island!
            IF NOT start_on_island!
              contour_used!(start_contour|)=TRUE
              other_contour|=FALSE
              REPEAT
                INC other_contour|
                IF contour_joined!(other_contour|)
                  contour_used!(other_contour|)=TRUE
                ENDIF
              UNTIL other_contour|=sub_contour_count|
              tool_path_elements$(merged_contour_count|,merged_line_index&)="LBL       0  "
              tool_path_line_count&(merged_contour_count|)=merged_line_index&
              INC merged_contour_count|
            ELSE
              contour_visited!(other_contour|)=FALSE
            ENDIF
          ENDIF
          INC start_contour|
        UNTIL start_contour|=sub_contour_count| OR run_aborted! OR stop_requested!
        contour_count|=merged_contour_count|
        ON MENU
        IF contours_merged! AND merge_pass|=1
          SWAP offset_contour_elements$(),tool_path_elements$()
          SWAP contour_is_pocket!(),merged_is_pocket!()
          SWAP contour_clockwise!(),contour_direction!()
          SWAP contour_side$(),path_side$()
          SWAP offset_contour_last_line&(),tool_path_line_count&()
          sub_contour_count|=contour_count|
          IF pair_table_made!
            ~FRE(0)
            ERASE element_pair_may_cross!()
          ENDIF
          current_contour|=FALSE
          REPEAT
            offset_contour_elements$(current_contour|,offset_contour_last_line&(current_contour|))=""
            DEC offset_contour_last_line&(current_contour|)
            INC current_contour|
            ' every sub-contour, until an error or a cancel
          UNTIL current_contour|=sub_contour_count|
        ELSE
          IF pair_table_made!
            ~FRE(0)
            ERASE element_pair_may_cross!()
          ENDIF
        ENDIF
      UNTIL merge_pass|=2 OR (NOT contours_merged!) OR run_aborted!
    ENDIF
    IF contours_merged!
      current_contour|=FALSE
      REPEAT
        contour_is_pocket!(current_contour|)=saved_contour_is_pocket!(current_contour|)
        contour_clockwise!(current_contour|)=saved_contour_clockwise!(current_contour|)
        contour_side$(current_contour|)=saved_contour_side$(current_contour|)
        INC current_contour|
      UNTIL current_contour|=original_contour_count|
    ENDIF
  ENDIF
  GOTO contour_merge_done
  GRAPHMODE 1
  line_index&=0
  REPEAT
    PRINT tool_path_elements$(1,line_index&)
    INC line_index&
  UNTIL line_index&=offset_contour_last_line&(1)+4
  PRINT
  END
contour_merge_done:
  sub_contour_count|=original_contour_count|
  IF mirror_reverses_direction!
    current_contour|=FALSE
    REPEAT
      IF contour_side$(current_contour|)="R"
        contour_side$(current_contour|)="L"
      ELSE
        contour_side$(current_contour|)="R"
      ENDIF
      INC current_contour|
    UNTIL current_contour|=sub_contour_count|
  ENDIF
  pair_table_made!=FALSE
  corner_point_moved!=FALSE
  in_subprogram_call!=FALSE
  ' cancelled by the user
  IF stop_requested! AND error_blocks&(0)=-1
    run_aborted!=FALSE
  ENDIF
  DEFMOUSE 3
RETURN
' Finds where the current element of the contour being walked first crosses another contour (the outer contour
' or an island). Walking contour current_contour| (forwards when walk_forwards!), it reads element line_index&
' of offset_contour_elements$() as a line ("L") or an arc (a "CC" centre line and a "C" end line with its
' direction "+" or "-"), taking the two coordinates of the working plane tool_axis|. Its start point is the end
' of the element before, or the crossing (nearest_crossing_x,nearest_crossing_y) when crossing_found! says the
' previous element ended on one. Every element of every other contour is then tested: line/line (collinear
' overlap, parallel and general cases), arc/line, line/arc and arc/arc, with small tolerances. Pairs that never
' cross are cleared in the pair table element_pair_may_cross!() (when pair_table_made!) so later passes skip
' them. Of all crossings the nearest one along the element is kept. pair_table_stride& = pair table stride:
' elements per contour. line_index& = the element, moved on to the C line of an arc when walking forwards.
' start_contour| = the contour the walk started on. Returns crossing_found! = TRUE when a crossing was found, at
' (nearest_crossing_x,nearest_crossing_y) on element crossing_element& of contour crossing_contour|. Crossings
' that are already recorded in crossing_table_x()/crossing_table_y(), the one the element started from, and the
' start point of the walk itself do not count.
PROCEDURE find_nearest_contour_crossing(pair_table_stride&,VAR line_index&,crossing_found!,start_contour|,crossing_contour|,crossing_element&)
  LOCAL other_element&,forward_direction!,previous_ended_on_crossing!,at_arc_start!,first_is_line!,second_is_line!,element_start_x,element_start_y,element_end_x,element_end_y,program_line$,start_element&,arc_centre_x,arc_centre_y,rnd_arc_direction$,vector_x,vector_y,element_arc_radius,nearest_found!,other_contour_index|,other_start_element&,other_centre_x,other_centre_y,other_start_x,other_start_y,other_end_x,other_end_y,other_arc_direction$,direction_x,direction_y,next_line_dx,next_line_dy,crossing_point_x,crossing_point_y,line_parameter,point_distance,work_point_y,foot_position_x,discriminant,first_crossing_x,first_crossing_y,second_crossing_x,second_crossing_y,second_vector_x,second_vector_y,line_slope,line_intercept,basic_variables,segment_length,second_operand,quadratic_factor,first_vector_length,second_vector_length,arc_start_angle,arc_end_angle,point_angle,saved_radius,centre_distance_h,centre_distance_v,chord_length,chord_angle,centre_angle_offset,first_crossing_angle,second_crossing_angle,foot_offset_x,foot_offset_y,second_crossing_arc_angle,unused_crossing_value,first_crossing_sweep,second_crossing_sweep,crossing_distance_x,crossing_distance_y,test_pair!,current_line_slope,other_line_slope,angle_wraps!,pair_row&,pair_column&,previous_crossing_contour|,previous_crossing_element&
  ' the previous element ended on a crossing
  previous_ended_on_crossing!=crossing_found!
  ' contour of that crossing
  previous_crossing_contour|=crossing_contour|
  ' element of that crossing
  previous_crossing_element&=crossing_element&
  ' row of the current element in the pair table element_pair_may_cross!()
  pair_row&=line_index&+pair_table_stride&*current_contour|
  ' the current element's line
  program_line$=offset_contour_elements$(current_contour|,line_index&)
  ' the contour is walked forwards
  IF walk_forwards!
    ' the current element is a straight line
    IF LEFT$(program_line$)="L"
      ' current element is a line
      first_is_line!=TRUE
      ' working plane XY (columns X and Y)
      IF tool_axis|=3
        element_end_x=VAL(MID$(program_line$,9,10))
        IF MID$(program_line$,8,1)="-"
          element_end_x=-element_end_x
        ENDIF
        element_end_y=VAL(MID$(program_line$,21,10))
        IF MID$(program_line$,20,1)="-"
          element_end_y=-element_end_y
        ENDIF
      ELSE
        ' working plane YZ (columns Y and Z), else ZX
        IF tool_axis|=1
          element_end_x=VAL(MID$(program_line$,21,10))
          IF MID$(program_line$,20,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ELSE
          element_end_x=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,9,10))
          IF MID$(program_line$,8,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ENDIF
      ENDIF
      start_element&=line_index&-1
    ELSE
      ' current element is an arc (a CC centre line, then a C end line)
      first_is_line!=FALSE
      ' arc centre from the CC line
      arc_centre_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        arc_centre_x=-arc_centre_x
      ENDIF
      arc_centre_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        arc_centre_y=-arc_centre_y
      ENDIF
      ' on to the arc's C line
      INC line_index&
      program_line$=offset_contour_elements$(current_contour|,line_index&)
      ' arc end point
      element_end_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_end_x=-element_end_x
      ENDIF
      element_end_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_end_y=-element_end_y
      ENDIF
      ' arc direction, "+" or "-"
      rnd_arc_direction$=MID$(program_line$,33,1)
      start_element&=line_index&-2
    ENDIF
    ' read the start point
    program_line$=offset_contour_elements$(current_contour|,start_element&)
    IF LEFT$(program_line$)="L"
      IF tool_axis|=3
        element_start_x=VAL(MID$(program_line$,9,10))
        IF MID$(program_line$,8,1)="-"
          element_start_x=-element_start_x
        ENDIF
        element_start_y=VAL(MID$(program_line$,21,10))
        IF MID$(program_line$,20,1)="-"
          element_start_y=-element_start_y
        ENDIF
      ELSE
        IF tool_axis|=1
          element_start_x=VAL(MID$(program_line$,21,10))
          IF MID$(program_line$,20,1)="-"
            element_start_x=-element_start_x
          ENDIF
          element_start_y=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_start_y=-element_start_y
          ENDIF
        ELSE
          element_start_x=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_start_x=-element_start_x
          ENDIF
          element_start_y=VAL(MID$(program_line$,9,10))
          IF MID$(program_line$,8,1)="-"
            element_start_y=-element_start_y
          ENDIF
        ENDIF
      ENDIF
    ELSE
      element_start_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_start_x=-element_start_x
      ENDIF
      element_start_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_start_y=-element_start_y
      ENDIF
    ENDIF
  ELSE
    ' walking backwards, this element's point is the start
    program_line$=offset_contour_elements$(current_contour|,line_index&)
    IF LEFT$(program_line$)="L"
      first_is_line!=TRUE
      IF tool_axis|=3
        element_start_x=VAL(MID$(program_line$,9,10))
        IF MID$(program_line$,8,1)="-"
          element_start_x=-element_start_x
        ENDIF
        element_start_y=VAL(MID$(program_line$,21,10))
        IF MID$(program_line$,20,1)="-"
          element_start_y=-element_start_y
        ENDIF
      ELSE
        IF tool_axis|=1
          element_start_x=VAL(MID$(program_line$,21,10))
          IF MID$(program_line$,20,1)="-"
            element_start_x=-element_start_x
          ENDIF
          element_start_y=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_start_y=-element_start_y
          ENDIF
        ELSE
          element_start_x=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_start_x=-element_start_x
          ENDIF
          element_start_y=VAL(MID$(program_line$,9,10))
          IF MID$(program_line$,8,1)="-"
            element_start_y=-element_start_y
          ENDIF
        ENDIF
      ENDIF
      start_element&=line_index&-1
    ELSE
      first_is_line!=FALSE
      element_start_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_start_x=-element_start_x
      ENDIF
      element_start_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_start_y=-element_start_y
      ENDIF
      rnd_arc_direction$=MID$(program_line$,33,1)
      ' walking backwards turns the arc direction round
      IF rnd_arc_direction$="-"
        rnd_arc_direction$=CHR$(43)
      ELSE
        rnd_arc_direction$=CHR$(45)
      ENDIF
      ' the CC line before holds the centre
      program_line$=offset_contour_elements$(current_contour|,PRED(line_index&))
      arc_centre_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        arc_centre_x=-arc_centre_x
      ENDIF
      arc_centre_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        arc_centre_y=-arc_centre_y
      ENDIF
      start_element&=line_index&-2
    ENDIF
    program_line$=offset_contour_elements$(current_contour|,start_element&)
    IF LEFT$(program_line$)="L"
      IF tool_axis|=3
        element_end_x=VAL(MID$(program_line$,9,10))
        IF MID$(program_line$,8,1)="-"
          element_end_x=-element_end_x
        ENDIF
        element_end_y=VAL(MID$(program_line$,21,10))
        IF MID$(program_line$,20,1)="-"
          element_end_y=-element_end_y
        ENDIF
      ELSE
        IF tool_axis|=1
          element_end_x=VAL(MID$(program_line$,21,10))
          IF MID$(program_line$,20,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ELSE
          element_end_x=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,9,10))
          IF MID$(program_line$,8,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ENDIF
      ENDIF
    ELSE
      element_end_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_end_x=-element_end_x
      ENDIF
      element_end_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_end_y=-element_end_y
      ENDIF
    ENDIF
  ENDIF
  ' the previous element ended on a crossing: this one starts at that point
  IF crossing_found!
    element_start_x=nearest_crossing_x
    element_start_y=nearest_crossing_y
  ENDIF
  ' arc: element_arc_radius = radius from the centre to the start point
  IF NOT first_is_line!
    vector_x=element_start_x-arc_centre_x
    vector_y=element_start_y-arc_centre_y
    element_arc_radius=SQR(vector_x*vector_x+vector_y*vector_y)
  ENDIF
  ' no crossing found yet
  nearest_found!=FALSE
  crossing_found!=FALSE
  ' other contour, from contour 0
  other_contour_index|=FALSE
  ' column of the other element in the pair table
  pair_column&=0
  REPEAT
    ' skip the current contour itself
    IF other_contour_index|<>current_contour|
      ' other element index
      other_element&=0
      REPEAT
        ON MENU
        INC other_element&
        INC pair_column&
        ' the pair table element_pair_may_cross!() is in use
        IF pair_table_made!
          ' an arc's centre line; its pair flag is kept under the C line that follows
          forward_direction!=(LEFT$(offset_contour_elements$(other_contour_index|,other_element&),2)="CC")
          IF element_pair_may_cross!(pair_row&,pair_column&) AND (NOT forward_direction!) OR (element_pair_may_cross!(pair_row&,SUCC(pair_column&)) AND forward_direction!)
            test_pair!=TRUE
          ELSE
            test_pair!=FALSE
          ENDIF
        ELSE
          test_pair!=TRUE
        ENDIF
        ' this pair may cross
        IF test_pair!
          program_line$=offset_contour_elements$(other_contour_index|,other_element&)
          ' the other element is a straight line
          IF LEFT$(program_line$)="L"
            ' other element is a line
            second_is_line!=TRUE
            IF tool_axis|=3
              other_end_x=VAL(MID$(program_line$,9,10))
              IF MID$(program_line$,8,1)="-"
                other_end_x=-other_end_x
              ENDIF
              other_end_y=VAL(MID$(program_line$,21,10))
              IF MID$(program_line$,20,1)="-"
                other_end_y=-other_end_y
              ENDIF
            ELSE
              IF tool_axis|=1
                other_end_x=VAL(MID$(program_line$,21,10))
                IF MID$(program_line$,20,1)="-"
                  other_end_x=-other_end_x
                ENDIF
                other_end_y=VAL(MID$(program_line$,33,10))
                IF MID$(program_line$,32,1)="-"
                  other_end_y=-other_end_y
                ENDIF
              ELSE
                other_end_x=VAL(MID$(program_line$,33,10))
                IF MID$(program_line$,32,1)="-"
                  other_end_x=-other_end_x
                ENDIF
                other_end_y=VAL(MID$(program_line$,9,10))
                IF MID$(program_line$,8,1)="-"
                  other_end_y=-other_end_y
                ENDIF
              ENDIF
            ENDIF
            other_start_element&=other_element&-1
          ELSE
            ' other element is an arc
            second_is_line!=FALSE
            ' other arc centre
            other_centre_x=VAL(MID$(program_line$,9,10))
            IF MID$(program_line$,8,1)="-"
              other_centre_x=-other_centre_x
            ENDIF
            other_centre_y=VAL(MID$(program_line$,21,10))
            IF MID$(program_line$,20,1)="-"
              other_centre_y=-other_centre_y
            ENDIF
            INC other_element&
            INC pair_column&
            program_line$=offset_contour_elements$(other_contour_index|,other_element&)
            other_end_x=VAL(MID$(program_line$,9,10))
            IF MID$(program_line$,8,1)="-"
              other_end_x=-other_end_x
            ENDIF
            other_end_y=VAL(MID$(program_line$,21,10))
            IF MID$(program_line$,20,1)="-"
              other_end_y=-other_end_y
            ENDIF
            ' other arc direction
            other_arc_direction$=MID$(program_line$,33,1)
            other_start_element&=other_element&-2
          ENDIF
          program_line$=offset_contour_elements$(other_contour_index|,other_start_element&)
          IF LEFT$(program_line$)="L"
            IF tool_axis|=3
              other_start_x=VAL(MID$(program_line$,9,10))
              IF MID$(program_line$,8,1)="-"
                other_start_x=-other_start_x
              ENDIF
              other_start_y=VAL(MID$(program_line$,21,10))
              IF MID$(program_line$,20,1)="-"
                other_start_y=-other_start_y
              ENDIF
            ELSE
              IF tool_axis|=1
                other_start_x=VAL(MID$(program_line$,21,10))
                IF MID$(program_line$,20,1)="-"
                  other_start_x=-other_start_x
                ENDIF
                other_start_y=VAL(MID$(program_line$,33,10))
                IF MID$(program_line$,32,1)="-"
                  other_start_y=-other_start_y
                ENDIF
              ELSE
                other_start_x=VAL(MID$(program_line$,33,10))
                IF MID$(program_line$,32,1)="-"
                  other_start_x=-other_start_x
                ENDIF
                other_start_y=VAL(MID$(program_line$,9,10))
                IF MID$(program_line$,8,1)="-"
                  other_start_y=-other_start_y
                ENDIF
              ENDIF
            ENDIF
          ELSE
            other_start_x=VAL(MID$(program_line$,9,10))
            IF MID$(program_line$,8,1)="-"
              other_start_x=-other_start_x
            ENDIF
            other_start_y=VAL(MID$(program_line$,21,10))
            IF MID$(program_line$,20,1)="-"
              other_start_y=-other_start_y
            ENDIF
          ENDIF
          ' assume a crossing until a test rules it out
          crossing_found!=TRUE
          ' x step of the current element
          direction_x=element_end_x-element_start_x
          ' y step of the current element
          direction_y=element_end_y-element_start_y
          ' x step of the other element
          next_line_dx=other_end_x-other_start_x
          ' y step of the other element
          next_line_dy=other_end_y-other_start_y
          IF .0001>ABS(direction_x)
            direction_x=0
          ENDIF
          IF .0001>ABS(direction_y)
            direction_y=0
          ENDIF
          IF .0001>ABS(next_line_dx)
            next_line_dx=0
          ENDIF
          IF .0001>ABS(next_line_dy)
            next_line_dy=0
          ENDIF
          ON MENU
          ' the other element is a line
          IF second_is_line!
            ' and has a length
            IF next_line_dy<>0 OR next_line_dx<>0
              ' line against line
              IF first_is_line!
                ' the current line has no length
                IF direction_x=0 AND direction_y=0
                  crossing_found!=FALSE
                  IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                    ' this pair never crosses: skip it next time
                    element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                    element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                  ENDIF
                ELSE
                  ' TRUE when the lines need the general intersection
                  angle_wraps!=FALSE
                  ' both lines vertical or both horizontal
                  IF direction_x=0 AND next_line_dx=0 OR (direction_y=0 AND next_line_dy=0)
                    IF .0001>ABS(element_start_x-other_start_x) AND direction_x=0 OR (.0001>ABS(element_start_y-other_start_y) AND direction_y=0)
                      ' line_parameter, foot_position_x = where the other start and end lie along the current line (0 = start, 1 =
                      ' end)
                      IF direction_x=0
                        line_parameter=(other_start_y-element_start_y)/direction_y
                        foot_position_x=(other_end_y-element_start_y)/direction_y
                      ELSE
                        line_parameter=(other_start_x-element_start_x)/direction_x
                        foot_position_x=(other_end_x-element_start_x)/direction_x
                      ENDIF
                      ' how the two contours lie is not known yet: work it out
                      IF contour_relation|(current_contour|,other_contour_index|)=0
                        classify_contour_nesting(other_contour_index|,contours_touch!)
                      ENDIF
                      ' the lines run the same way
                      IF direction_x=0 AND SGN(direction_y)=SGN(next_line_dy) OR (direction_y=0 AND SGN(direction_x)=SGN(next_line_dx))
                        ' for these contour relations the overlap is met at the current end, else at the other end
                        IF contour_relation|(current_contour|,other_contour_index|)=1 OR contour_relation|(current_contour|,other_contour_index|)=3
                          IF line_parameter<1 OR .0001>ABS(line_parameter-1) AND foot_position_x>1 AND .0001<ABS(foot_position_x-1)
                            crossing_point_x=element_end_x
                            crossing_point_y=element_end_y
                          ELSE
                            crossing_found!=FALSE
                          ENDIF
                        ELSE
                          IF line_parameter<1 OR .0001>ABS(line_parameter-1) AND foot_position_x<1 AND .0001<ABS(foot_position_x-1)
                            crossing_point_x=other_end_x
                            crossing_point_y=other_end_y
                          ELSE
                            crossing_found!=FALSE
                          ENDIF
                        ENDIF
                      ELSE
                        IF contour_relation|(current_contour|,other_contour_index|)=1 OR contour_relation|(current_contour|,other_contour_index|)=3
                          IF foot_position_x<1 OR .0001>ABS(foot_position_x-1) AND line_parameter>1 AND .0001<ABS(line_parameter-1)
                            crossing_point_x=element_end_x
                            crossing_point_y=element_end_y
                          ELSE
                            crossing_found!=FALSE
                          ENDIF
                        ELSE
                          IF foot_position_x<1 OR .0001>ABS(foot_position_x-1) AND line_parameter<1 AND .0001<ABS(line_parameter-1)
                            crossing_point_x=other_end_x
                            crossing_point_y=other_end_y
                          ELSE
                            crossing_found!=FALSE
                          ENDIF
                        ENDIF
                      ENDIF
                    ELSE
                      crossing_found!=FALSE
                    ENDIF
                  ELSE
                    ' neither line vertical
                    IF direction_x<>0 AND next_line_dx<>0
                      ' slope of the current line
                      current_line_slope=direction_y/direction_x
                      ' slope of the other line
                      other_line_slope=next_line_dy/next_line_dx
                      IF .0007>ABS(current_line_slope-other_line_slope) OR .0007>ABS(current_line_slope+other_line_slope)
                        ' where the other start lies along the current line
                        line_parameter=(other_start_x-element_start_x)/direction_x
                        ' y of the current line there
                        work_point_y=line_parameter*direction_y+element_start_y
                        IF .0001>ABS(work_point_y-other_start_y)
                          ' where the other end lies
                          foot_position_x=(other_end_x-element_start_x)/direction_x
                          IF contour_relation|(current_contour|,other_contour_index|)=0
                            classify_contour_nesting(other_contour_index|,contours_touch!)
                          ENDIF
                          IF .0007>ABS(current_line_slope-other_line_slope)
                            IF contour_relation|(current_contour|,other_contour_index|)=1 OR contour_relation|(current_contour|,other_contour_index|)=3
                              IF line_parameter<1 OR .0001>ABS(line_parameter-1) AND foot_position_x>1 AND .0001<ABS(foot_position_x-1)
                                crossing_point_x=element_end_x
                                crossing_point_y=element_end_y
                              ELSE
                                crossing_found!=FALSE
                              ENDIF
                            ELSE
                              IF line_parameter<1 OR .0001>ABS(line_parameter-1) AND foot_position_x<1 AND .0001<ABS(foot_position_x-1)
                                crossing_point_x=other_end_x
                                crossing_point_y=other_end_y
                              ELSE
                                crossing_found!=FALSE
                              ENDIF
                            ENDIF
                          ELSE
                            IF contour_relation|(current_contour|,other_contour_index|)=1 OR contour_relation|(current_contour|,other_contour_index|)=3
                              IF foot_position_x<1 OR .0001>ABS(foot_position_x-1) AND line_parameter>1 AND .0001<ABS(line_parameter-1)
                                crossing_point_x=element_end_x
                                crossing_point_y=element_end_y
                              ELSE
                                crossing_found!=FALSE
                              ENDIF
                            ELSE
                              IF foot_position_x<1 OR .0001>ABS(foot_position_x-1) AND line_parameter<1 AND .0001<ABS(line_parameter-1)
                                crossing_point_x=other_end_x
                                crossing_point_y=other_end_y
                              ELSE
                                crossing_found!=FALSE
                              ENDIF
                            ENDIF
                          ENDIF
                        ELSE
                          crossing_found!=FALSE
                        ENDIF
                      ELSE
                        angle_wraps!=TRUE
                      ENDIF
                    ELSE
                      angle_wraps!=TRUE
                    ENDIF
                  ENDIF
                  ' intersect the two lines
                  IF angle_wraps!
                    ' the current line is vertical
                    IF direction_x=0 AND next_line_dx<>0
                      ' solve for the parameter line_parameter along the current line
                      line_parameter=other_start_y-element_start_y+next_line_dy/next_line_dx*(element_start_x-other_start_x)
                      DIV line_parameter,direction_y-next_line_dy*direction_x/next_line_dx
                      ' the crossing point
                      crossing_point_x=line_parameter*direction_x+element_start_x
                      crossing_point_y=line_parameter*direction_y+element_start_y
                      IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                        crossing_found!=FALSE
                      ENDIF
                      ' where the crossing lies along the other line
                      line_parameter=(crossing_point_x-other_start_x)/next_line_dx
                      IF line_parameter<0 AND .0001<ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                        crossing_found!=FALSE
                      ENDIF
                    ELSE
                      IF direction_x<>0
                        ' solve for the parameter line_parameter along the other line
                        line_parameter=element_start_y-other_start_y+direction_y/direction_x*(other_start_x-element_start_x)
                        DIV line_parameter,next_line_dy-direction_y*next_line_dx/direction_x
                        ' the crossing point
                        crossing_point_x=line_parameter*next_line_dx+other_start_x
                        crossing_point_y=line_parameter*next_line_dy+other_start_y
                        IF line_parameter<0 AND .0001<ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                          crossing_found!=FALSE
                        ENDIF
                        ' where the crossing lies along the current line
                        line_parameter=(crossing_point_x-element_start_x)/direction_x
                        IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                          crossing_found!=FALSE
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' no crossing: mark the pair as never crossing
                  IF (NOT crossing_found!) AND (NOT previous_ended_on_crossing!) AND pair_table_made!
                    element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                    element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                  ENDIF
                ENDIF
              ELSE
                IF .0001>ABS(next_line_dx)
                  ' x distance from the arc centre to the line
                  point_distance=other_start_x-arc_centre_x
                  ' square of half the chord
                  discriminant=element_arc_radius*element_arc_radius-point_distance*point_distance
                  IF .0700000000000003>ABS(discriminant)
                    discriminant=0
                  ENDIF
                  ' the line misses the circle
                  IF discriminant<0
                    IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                      element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                      element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                    ENDIF
                    crossing_found!=FALSE
                  ELSE
                    ' the two candidate points (first_crossing_x,first_crossing_y) and (second_crossing_x,second_crossing_y)
                    first_crossing_x=other_start_x
                    second_crossing_x=first_crossing_x
                    first_crossing_y=arc_centre_y-SQR(discriminant)
                    second_crossing_y=SQR(discriminant)+arc_centre_y
                  ENDIF
                ELSE
                  ' the other line starts where the arc ends: that shared point is taken as both candidates, without solving the
                  ' quadratic, which can miss it through rounding
                  IF .001>ABS(other_start_x-element_end_x) AND .001>ABS(other_start_y-element_end_y)
                    first_crossing_x=element_end_x
                    first_crossing_y=element_end_y
                    second_crossing_x=other_start_x
                    second_crossing_y=other_start_y
                  ELSE
                    ' slope and offset of the other line
                    line_slope=next_line_dy/next_line_dx
                    line_intercept=other_start_y-line_slope*other_start_x
                    ' quadratic for the x where the line meets the circle
                    basic_variables=line_intercept-arc_centre_y
                    segment_length=arc_centre_x-line_slope*basic_variables
                    second_operand=basic_variables*basic_variables+arc_centre_x*arc_centre_x-element_arc_radius*element_arc_radius
                    quadratic_factor=line_slope*line_slope+1
                    ' its discriminant
                    discriminant=segment_length*segment_length-quadratic_factor*second_operand
                    IF .0700000000000003>ABS(discriminant)
                      discriminant=0
                    ENDIF
                    ' the line misses the circle
                    IF discriminant<0
                      IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                        element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                        element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                      ENDIF
                      crossing_found!=FALSE
                    ELSE
                      ' the root of larger size first, the other from the product of the roots
                      IF segment_length>=0
                        first_crossing_x=(SQR(discriminant)+segment_length)/quadratic_factor
                      ELSE
                        first_crossing_x=(segment_length-SQR(discriminant))/quadratic_factor
                      ENDIF
                      first_crossing_y=line_slope*first_crossing_x+line_intercept
                      IF quadratic_factor<>0 AND first_crossing_x<>0
                        second_crossing_x=second_operand/first_crossing_x/quadratic_factor
                        second_crossing_y=line_slope*second_crossing_x+line_intercept
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
                ' check the candidates (first_crossing_x,first_crossing_y) and (second_crossing_x,second_crossing_y)
                IF crossing_found!
                  ' the first candidate is valid until a test fails
                  first_point_valid!=TRUE
                  IF next_line_dx<>0
                    line_parameter=(first_crossing_x-other_start_x)/next_line_dx
                    ' not on the other line
                    IF line_parameter<0 OR line_parameter>1
                      first_point_valid!=FALSE
                    ENDIF
                  ELSE
                    IF next_line_dy<>0
                      line_parameter=(first_crossing_y-other_start_y)/next_line_dy
                      IF line_parameter<0 OR line_parameter>1
                        first_point_valid!=FALSE
                      ENDIF
                    ENDIF
                  ENDIF
                  ' is it on the arc?
                  IF first_point_valid!
                    ' angle of the arc start
                    vector_x=element_start_x-arc_centre_x
                    vector_y=element_start_y-arc_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_start_angle=vector_x/point_distance
                    arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                    IF vector_y<0
                      arc_start_angle=two_pi-arc_start_angle
                    ENDIF
                    ' angle of the arc end
                    vector_x=element_end_x-arc_centre_x
                    vector_y=element_end_y-arc_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_end_angle=vector_x/point_distance
                    arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                    IF vector_y<0
                      arc_end_angle=two_pi-arc_end_angle
                    ENDIF
                    IF .0001<ABS(arc_start_angle-arc_end_angle)
                      ' angle of the candidate
                      vector_x=first_crossing_x-arc_centre_x
                      vector_y=first_crossing_y-arc_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      IF point_distance=0 OR .01<ABS(point_distance-element_arc_radius)
                        first_point_valid!=FALSE
                      ELSE
                        point_angle=vector_x/point_distance
                        point_angle=@clamped_arc_cosine(point_angle)
                        IF vector_y<0
                          point_angle=two_pi-point_angle
                        ENDIF
                        at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                        IF 9.99999999999997E-06>ABS(point_angle-arc_end_angle)
                          point_angle=arc_end_angle
                        ENDIF
                        ' the arc runs towards smaller angles
                        IF rnd_arc_direction$="-"
                          ' the point is not on the arc, or is its start
                          IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle OR at_arc_start!) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND point_angle<arc_end_angle)
                            first_point_valid!=FALSE
                          ENDIF
                        ELSE
                          ' the point is not on the arc, or is its start
                          IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle OR at_arc_start!) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND point_angle>arc_end_angle)
                            first_point_valid!=FALSE
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' the second candidate likewise
                  second_point_valid!=TRUE
                  IF next_line_dx<>0
                    line_parameter=(second_crossing_x-other_start_x)/next_line_dx
                    IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                      second_point_valid!=FALSE
                    ENDIF
                  ELSE
                    IF next_line_dy<>0
                      line_parameter=(second_crossing_y-other_start_y)/next_line_dy
                      IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                        second_point_valid!=FALSE
                      ENDIF
                    ENDIF
                  ENDIF
                  IF second_point_valid!
                    vector_x=element_start_x-arc_centre_x
                    vector_y=element_start_y-arc_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_start_angle=vector_x/point_distance
                    arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                    IF vector_y<0
                      arc_start_angle=two_pi-arc_start_angle
                    ENDIF
                    vector_x=element_end_x-arc_centre_x
                    vector_y=element_end_y-arc_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_end_angle=vector_x/point_distance
                    arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                    IF vector_y<0
                      arc_end_angle=two_pi-arc_end_angle
                    ENDIF
                    IF .0001<ABS(arc_start_angle-arc_end_angle)
                      vector_x=second_crossing_x-arc_centre_x
                      vector_y=second_crossing_y-arc_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      IF point_distance=0 OR .01<ABS(point_distance-element_arc_radius)
                        second_point_valid!=FALSE
                      ELSE
                        point_angle=vector_x/point_distance
                        point_angle=@clamped_arc_cosine(point_angle)
                        IF vector_y<0
                          point_angle=two_pi-point_angle
                        ENDIF
                        at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                        IF 9.99999999999997E-06>ABS(point_angle-arc_end_angle)
                          point_angle=arc_end_angle
                        ENDIF
                        IF rnd_arc_direction$="-"
                          IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle OR at_arc_start!) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND point_angle<arc_end_angle)
                            second_point_valid!=FALSE
                          ENDIF
                        ELSE
                          IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle OR at_arc_start!) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND point_angle>arc_end_angle)
                            second_point_valid!=FALSE
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' both candidates valid: take the one nearer the other element's end
                  IF first_point_valid! AND second_point_valid!
                    vector_x=first_crossing_x-other_end_x
                    vector_y=first_crossing_y-other_end_y
                    second_vector_x=second_crossing_x-other_end_x
                    second_vector_y=second_crossing_y-other_end_y
                    first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
                    second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
                    IF first_vector_length<=second_vector_length
                      crossing_point_x=first_crossing_x
                      crossing_point_y=first_crossing_y
                    ELSE
                      crossing_point_x=second_crossing_x
                      crossing_point_y=second_crossing_y
                    ENDIF
                  ELSE
                    ' only one candidate valid: take it
                    IF first_point_valid!
                      crossing_point_x=first_crossing_x
                      crossing_point_y=first_crossing_y
                    ELSE
                      IF second_point_valid!
                        crossing_point_x=second_crossing_x
                        crossing_point_y=second_crossing_y
                      ELSE
                        ' the other line has no length
                        crossing_found!=FALSE
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ELSE
              crossing_found!=FALSE
              IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                element_pair_may_cross!(pair_column&,pair_row&)=FALSE
              ENDIF
            ENDIF
          ELSE
            ' the other element is an arc: saved_radius = its radius
            vector_x=other_start_x-other_centre_x
            vector_y=other_start_y-other_centre_y
            saved_radius=SQR(vector_x*vector_x+vector_y*vector_y)
            ' no radius: no crossing
            IF saved_radius=0
              crossing_found!=FALSE
            ELSE
              ' current line against the other arc
              IF first_is_line!
                ' the current line has no length
                IF direction_x=0 AND direction_y=0
                  IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                    element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                    element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                  ENDIF
                  crossing_found!=FALSE
                ELSE
                  IF .0001>ABS(direction_x)
                    ' x distance from the other centre to the line
                    point_distance=element_end_x-other_centre_x
                    discriminant=saved_radius*saved_radius-point_distance*point_distance
                    IF .0700000000000003>ABS(discriminant)
                      discriminant=0
                    ENDIF
                    IF discriminant<0
                      IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                        element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                        element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                      ENDIF
                      crossing_found!=FALSE
                    ELSE
                      first_crossing_x=element_end_x
                      second_crossing_x=first_crossing_x
                      first_crossing_y=other_centre_y-SQR(discriminant)
                      second_crossing_y=SQR(discriminant)+other_centre_y
                    ENDIF
                  ELSE
                    ' the current line starts where the other arc ends: that shared point is taken as both candidates
                    IF .001>ABS(element_start_x-other_end_x) AND .001>ABS(element_start_y-other_end_y)
                      first_crossing_x=other_end_x
                      first_crossing_y=other_end_y
                      second_crossing_x=element_start_x
                      second_crossing_y=element_start_y
                    ELSE
                      ' slope and offset of the current line
                      line_slope=direction_y/direction_x
                      line_intercept=element_start_y-line_slope*element_start_x
                      basic_variables=line_intercept-other_centre_y
                      segment_length=other_centre_x-line_slope*basic_variables
                      second_operand=basic_variables*basic_variables+other_centre_x*other_centre_x-saved_radius*saved_radius
                      quadratic_factor=line_slope*line_slope+1
                      discriminant=segment_length*segment_length-quadratic_factor*second_operand
                      IF .0700000000000003>ABS(discriminant)
                        discriminant=0
                      ENDIF
                      IF discriminant<0
                        IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                          element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                          element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                        ENDIF
                        crossing_found!=FALSE
                      ELSE
                        IF segment_length>=0
                          first_crossing_x=(SQR(discriminant)+segment_length)/quadratic_factor
                        ELSE
                          first_crossing_x=(segment_length-SQR(discriminant))/quadratic_factor
                        ENDIF
                        first_crossing_y=line_slope*first_crossing_x+line_intercept
                        IF quadratic_factor<>0 AND first_crossing_x<>0
                          second_crossing_x=second_operand/first_crossing_x/quadratic_factor
                          second_crossing_y=line_slope*second_crossing_x+line_intercept
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' check the candidates (first_crossing_x,first_crossing_y) and (second_crossing_x,second_crossing_y)
                  IF crossing_found!
                    first_point_valid!=TRUE
                    IF direction_x<>0
                      line_parameter=(first_crossing_x-element_start_x)/direction_x
                      IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                        first_point_valid!=FALSE
                      ENDIF
                    ELSE
                      IF direction_y<>0
                        line_parameter=(first_crossing_y-element_start_y)/direction_y
                        IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                          first_point_valid!=FALSE
                        ENDIF
                      ENDIF
                    ENDIF
                    IF first_point_valid!
                      ' angle of the other arc's start
                      vector_x=other_start_x-other_centre_x
                      vector_y=other_start_y-other_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      arc_start_angle=vector_x/point_distance
                      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                      IF vector_y<0
                        arc_start_angle=two_pi-arc_start_angle
                      ENDIF
                      vector_x=other_end_x-other_centre_x
                      vector_y=other_end_y-other_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      arc_end_angle=vector_x/point_distance
                      arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                      IF vector_y<0
                        arc_end_angle=two_pi-arc_end_angle
                      ENDIF
                      IF .0001<ABS(arc_start_angle-arc_end_angle)
                        vector_x=first_crossing_x-other_centre_x
                        vector_y=first_crossing_y-other_centre_y
                        point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                        IF point_distance=0 OR .01<ABS(point_distance-saved_radius)
                          first_point_valid!=FALSE
                        ELSE
                          point_angle=vector_x/point_distance
                          point_angle=@clamped_arc_cosine(point_angle)
                          IF vector_y<0
                            point_angle=two_pi-point_angle
                          ENDIF
                          at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                          at_arc_end!=.02>ABS(point_angle-arc_end_angle)
                          ' the other arc runs towards smaller angles
                          IF other_arc_direction$="-"
                            IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR at_arc_end! OR point_angle>arc_start_angle OR at_arc_start!) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND (point_angle<arc_end_angle OR at_arc_end!))
                              first_point_valid!=FALSE
                            ENDIF
                          ELSE
                            IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR at_arc_end! OR point_angle<arc_start_angle OR at_arc_start!) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND (point_angle>arc_end_angle OR at_arc_end!))
                              first_point_valid!=FALSE
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                    second_point_valid!=TRUE
                    IF direction_x<>0
                      line_parameter=(second_crossing_x-element_start_x)/direction_x
                      IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                        second_point_valid!=FALSE
                      ENDIF
                    ELSE
                      IF direction_y<>0
                        line_parameter=(second_crossing_y-element_start_y)/direction_y
                        IF line_parameter<0 OR .0001>ABS(line_parameter) OR (line_parameter>1 AND .0001<ABS(line_parameter-1))
                          second_point_valid!=FALSE
                        ENDIF
                      ENDIF
                    ENDIF
                    IF second_point_valid!
                      vector_x=other_start_x-other_centre_x
                      vector_y=other_start_y-other_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      arc_start_angle=vector_x/point_distance
                      arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                      IF vector_y<0
                        arc_start_angle=two_pi-arc_start_angle
                      ENDIF
                      vector_x=other_end_x-other_centre_x
                      vector_y=other_end_y-other_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      arc_end_angle=vector_x/point_distance
                      arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                      IF vector_y<0
                        arc_end_angle=two_pi-arc_end_angle
                      ENDIF
                      IF .0001<ABS(arc_start_angle-arc_end_angle)
                        vector_x=second_crossing_x-other_centre_x
                        vector_y=second_crossing_y-other_centre_y
                        point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                        IF point_distance=0 OR .01<ABS(point_distance-saved_radius)
                          second_point_valid!=FALSE
                        ELSE
                          point_angle=vector_x/point_distance
                          point_angle=@clamped_arc_cosine(point_angle)
                          IF vector_y<0
                            point_angle=two_pi-point_angle
                          ENDIF
                          at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                          at_arc_end!=.02>ABS(point_angle-arc_end_angle)
                          IF other_arc_direction$="-"
                            IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR at_arc_end! OR point_angle>arc_start_angle OR at_arc_start!) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND (point_angle<arc_end_angle OR at_arc_end!))
                              second_point_valid!=FALSE
                            ENDIF
                          ELSE
                            IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR at_arc_end! OR point_angle<arc_start_angle OR at_arc_start!) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND (point_angle>arc_end_angle OR at_arc_end!))
                              second_point_valid!=FALSE
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                    ' both candidates valid: take the one nearer the current start
                    IF first_point_valid! AND second_point_valid!
                      vector_x=first_crossing_x-element_start_x
                      vector_y=first_crossing_y-element_start_y
                      second_vector_x=second_crossing_x-element_start_x
                      second_vector_y=second_crossing_y-element_start_y
                      first_vector_length=SQR(vector_x*vector_x+vector_y*vector_y)
                      second_vector_length=SQR(second_vector_x*second_vector_x+second_vector_y*second_vector_y)
                      IF first_vector_length<=second_vector_length
                        crossing_point_x=first_crossing_x
                        crossing_point_y=first_crossing_y
                      ELSE
                        crossing_point_x=second_crossing_x
                        crossing_point_y=second_crossing_y
                      ENDIF
                    ELSE
                      IF first_point_valid!
                        crossing_point_x=first_crossing_x
                        crossing_point_y=first_crossing_y
                      ELSE
                        IF second_point_valid!
                          crossing_point_x=second_crossing_x
                          crossing_point_y=second_crossing_y
                        ELSE
                          crossing_found!=FALSE
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ELSE
                ' arc against arc: from the current centre to the other centre
                centre_distance_h=other_centre_x-arc_centre_x
                centre_distance_v=other_centre_y-arc_centre_y
                chord_length=SQR(centre_distance_h*centre_distance_h+centre_distance_v*centre_distance_v)
                ' same centre or too far apart: the circles do not meet
                IF chord_length=0 OR chord_length>element_arc_radius+saved_radius
                  IF (NOT previous_ended_on_crossing!) AND pair_table_made!
                    element_pair_may_cross!(pair_row&,pair_column&)=FALSE
                    element_pair_may_cross!(pair_column&,pair_row&)=FALSE
                  ENDIF
                  crossing_found!=FALSE
                ELSE
                  ' angle of the line between the centres
                  chord_angle=centre_distance_h/chord_length
                  chord_angle=@clamped_arc_cosine(chord_angle)
                  IF centre_distance_v<0
                    chord_angle=two_pi-chord_angle
                  ENDIF
                  ' law of cosines: half the angle between the two crossings
                  centre_angle_offset=element_arc_radius*element_arc_radius+chord_length*chord_length-saved_radius*saved_radius
                  DIV centre_angle_offset,element_arc_radius*2*chord_length
                  centre_angle_offset=@clamped_arc_cosine(centre_angle_offset)
                  ' angles of the two crossings on the current circle
                  first_crossing_angle=chord_angle+centre_angle_offset
                  second_crossing_angle=chord_angle-centre_angle_offset
                  ' the two crossing points
                  first_crossing_x=COS(first_crossing_angle)*element_arc_radius+arc_centre_x
                  first_crossing_y=SIN(first_crossing_angle)*element_arc_radius+arc_centre_y
                  second_crossing_x=COS(second_crossing_angle)*element_arc_radius+arc_centre_x
                  second_crossing_y=SIN(second_crossing_angle)*element_arc_radius+arc_centre_y
                  ' angles of the current start and of both crossings
                  vector_x=element_start_x-arc_centre_x
                  vector_y=element_start_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_start_angle=vector_x/point_distance
                  arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                  IF vector_y<0
                    arc_start_angle=two_pi-arc_start_angle
                  ENDIF
                  vector_x=first_crossing_x-arc_centre_x
                  vector_y=first_crossing_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_end_angle=vector_x/point_distance
                  arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                  IF vector_y<0
                    arc_end_angle=two_pi-arc_end_angle
                  ENDIF
                  vector_x=second_crossing_x-arc_centre_x
                  vector_y=second_crossing_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  point_angle=vector_x/point_distance
                  point_angle=@clamped_arc_cosine(point_angle)
                  IF vector_y<0
                    point_angle=two_pi-point_angle
                  ENDIF
                  ' take the crossing that lies on the current arc
                  IF rnd_arc_direction$="-"
                    IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                      crossing_point_x=first_crossing_x
                      crossing_point_y=first_crossing_y
                    ELSE
                      crossing_point_x=second_crossing_x
                      crossing_point_y=second_crossing_y
                    ENDIF
                  ELSE
                    IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                      crossing_point_x=first_crossing_x
                      crossing_point_y=first_crossing_y
                    ELSE
                      crossing_point_x=second_crossing_x
                      crossing_point_y=second_crossing_y
                    ENDIF
                  ENDIF
                  ' this crossing was recorded last: take the other one
                  IF pair_crossing_used!(current_contour|,other_contour_index|) AND .0001>ABS(crossing_point_x-crossing_table_x(current_contour|,other_contour_index|,crossing_count_table|(current_contour|,other_contour_index|))) AND .0001>ABS(crossing_point_y-crossing_table_y(current_contour|,other_contour_index|,crossing_count_table|(current_contour|,other_contour_index|)))
                    IF crossing_point_x=first_crossing_x AND crossing_point_y=first_crossing_y
                      crossing_point_x=second_crossing_x
                      crossing_point_y=second_crossing_y
                    ELSE
                      crossing_point_x=first_crossing_x
                      crossing_point_y=first_crossing_y
                    ENDIF
                  ENDIF
                  ' check the point lies on the current arc
                  vector_x=element_start_x-arc_centre_x
                  vector_y=element_start_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_start_angle=vector_x/point_distance
                  arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                  IF vector_y<0
                    arc_start_angle=two_pi-arc_start_angle
                  ENDIF
                  vector_x=element_end_x-arc_centre_x
                  vector_y=element_end_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_end_angle=vector_x/point_distance
                  arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                  IF vector_y<0
                    arc_end_angle=two_pi-arc_end_angle
                  ENDIF
                  IF .0001<ABS(arc_start_angle-arc_end_angle)
                    vector_x=crossing_point_x-arc_centre_x
                    vector_y=crossing_point_y-arc_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    point_angle=vector_x/point_distance
                    IF point_distance=0 OR .01<ABS(point_distance-element_arc_radius)
                      crossing_found!=FALSE
                    ELSE
                      point_angle=@clamped_arc_cosine(point_angle)
                      IF vector_y<0
                        point_angle=two_pi-point_angle
                      ENDIF
                      at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                      IF rnd_arc_direction$="-"
                        IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR (point_angle>arc_start_angle OR at_arc_start!)) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND point_angle<arc_end_angle)
                          crossing_found!=FALSE
                        ENDIF
                      ELSE
                        IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR (point_angle<arc_start_angle OR at_arc_start!)) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND point_angle>arc_end_angle)
                          crossing_found!=FALSE
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ' and on the other arc
                  IF crossing_found!
                    vector_x=other_start_x-other_centre_x
                    vector_y=other_start_y-other_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_start_angle=vector_x/point_distance
                    arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                    IF vector_y<0
                      arc_start_angle=two_pi-arc_start_angle
                    ENDIF
                    vector_x=other_end_x-other_centre_x
                    vector_y=other_end_y-other_centre_y
                    point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                    arc_end_angle=vector_x/point_distance
                    arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                    IF vector_y<0
                      arc_end_angle=two_pi-arc_end_angle
                    ENDIF
                    IF .0001<ABS(arc_start_angle-arc_end_angle)
                      vector_x=crossing_point_x-other_centre_x
                      vector_y=crossing_point_y-other_centre_y
                      point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                      IF point_distance=0 OR .01<ABS(point_distance-saved_radius)
                        crossing_found!=FALSE
                      ELSE
                        point_angle=vector_x/point_distance
                        point_angle=@clamped_arc_cosine(point_angle)
                        IF vector_y<0
                          point_angle=two_pi-point_angle
                        ENDIF
                        at_arc_start!=.02>ABS(point_angle-arc_start_angle)
                        at_arc_end!=.02>ABS(point_angle-arc_end_angle)
                        IF other_arc_direction$="-"
                          IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR at_arc_end! OR point_angle>arc_start_angle OR at_arc_start!) OR (arc_start_angle<arc_end_angle AND (point_angle>arc_start_angle OR at_arc_start!) AND (point_angle<arc_end_angle OR at_arc_end!))
                            crossing_found!=FALSE
                          ENDIF
                        ELSE
                          IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR at_arc_end! OR point_angle<arc_start_angle OR at_arc_start!) OR (arc_start_angle>arc_end_angle AND (point_angle<arc_start_angle OR at_arc_start!) AND (point_angle>arc_end_angle OR at_arc_end!))
                            crossing_found!=FALSE
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          ' the elements cross at (crossing_point_x,crossing_point_y)
          IF crossing_found!
            IF previous_ended_on_crossing! AND other_contour_index|=previous_crossing_contour| AND other_element&=previous_crossing_element& AND .0001>ABS(crossing_table_x(current_contour|,other_contour_index|,crossing_count_table|(current_contour|,other_contour|))-crossing_point_x) AND .0001>ABS(crossing_table_y(current_contour|,other_contour_index|,crossing_count_table|(current_contour|,other_contour|))-crossing_point_y)
              crossing_found!=FALSE
            ELSE
              ' a crossing was found before: keep the nearer one
              IF nearest_found!
                ' line: nearer means closer to the start point
                IF first_is_line!
                  crossing_distance_x=crossing_point_x-element_start_x
                  crossing_distance_y=crossing_point_y-element_start_y
                  second_operand=SQR(crossing_distance_x*crossing_distance_x+crossing_distance_y*crossing_distance_y)
                  crossing_distance_x=nearest_crossing_x-element_start_x
                  crossing_distance_y=nearest_crossing_y-element_start_y
                  discriminant=SQR(crossing_distance_x*crossing_distance_x+crossing_distance_y*crossing_distance_y)
                  ' nearer than the best so far
                  IF second_operand<discriminant
                    ' new nearest crossing, on element other_element& of contour other_contour_index|
                    nearest_crossing_x=crossing_point_x
                    nearest_crossing_y=crossing_point_y
                    crossing_element&=other_element&
                    crossing_contour|=other_contour_index|
                  ENDIF
                ELSE
                  ' arc: nearer means reached first along the arc
                  vector_x=element_start_x-arc_centre_x
                  vector_y=element_start_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_start_angle=vector_x/point_distance
                  arc_start_angle=@clamped_arc_cosine(arc_start_angle)
                  IF vector_y<0
                    arc_start_angle=two_pi-arc_start_angle
                  ENDIF
                  vector_x=nearest_crossing_x-arc_centre_x
                  vector_y=nearest_crossing_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  arc_end_angle=vector_x/point_distance
                  arc_end_angle=@clamped_arc_cosine(arc_end_angle)
                  IF vector_y<0
                    arc_end_angle=two_pi-arc_end_angle
                  ENDIF
                  vector_x=crossing_point_x-arc_centre_x
                  vector_y=crossing_point_y-arc_centre_y
                  point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                  point_angle=vector_x/point_distance
                  point_angle=@clamped_arc_cosine(point_angle)
                  IF vector_y<0
                    point_angle=two_pi-point_angle
                  ENDIF
                  IF rnd_arc_direction$="-"
                    IF NOT arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                      nearest_crossing_x=crossing_point_x
                      nearest_crossing_y=crossing_point_y
                      crossing_element&=other_element&
                      crossing_contour|=other_contour_index|
                    ENDIF
                  ELSE
                    IF NOT arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                      nearest_crossing_x=crossing_point_x
                      nearest_crossing_y=crossing_point_y
                      crossing_element&=other_element&
                      crossing_contour|=other_contour_index|
                    ENDIF
                  ENDIF
                ENDIF
              ELSE
                ' the first crossing found
                nearest_found!=TRUE
                nearest_crossing_x=crossing_point_x
                nearest_crossing_y=crossing_point_y
                crossing_element&=other_element&
                crossing_contour|=other_contour_index|
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' all elements of the other contour, or the user cancelled
      UNTIL other_element&>=offset_contour_last_line&(other_contour_index|) OR stop_requested!
    ENDIF
    ' pair table column of the next contour's first element
    pair_column&=pair_column&+(pair_table_stride&-other_element&)
    ' next contour
    INC other_contour_index|
  UNTIL other_contour_index|=sub_contour_count| OR stop_requested!
  ' result: a crossing was found
  crossing_found!=nearest_found!
  ' crossings with that contour are recorded already: make sure this one is new
  IF crossing_found! AND crossing_count_table|(current_contour|,crossing_contour|)>=2
    loop_index|=FALSE
    REPEAT
      INC loop_index|
      IF .0001>ABS(crossing_point_x-crossing_table_x(current_contour|,crossing_contour|,loop_index|)) AND .0001>ABS(crossing_point_y-crossing_table_y(current_contour|,crossing_contour|,loop_index|))
        crossing_found!=FALSE
      ENDIF
    UNTIL loop_index|=crossing_count_table|(current_contour|,crossing_contour|) OR crossing_found!=FALSE
  ENDIF
  IF crossing_found! AND current_contour|=start_contour| AND line_index&=offset_contour_last_line&(start_contour|) AND .0001>ABS(crossing_point_x-element_end_x) AND .0001>ABS(crossing_point_y-element_end_y)
    crossing_found!=FALSE
  ENDIF
RETURN
' Works out how contour other_contour| and the current contour current_contour| lie to each other and stores it,
' both ways round, in contour_relation|(current_contour|,other_contour|) and
' contour_relation|(other_contour|,current_contour|). The pair is ordered so that current_contour| is the outer
' contour (contour_is_pocket!) if only one of them is. The start point of current_contour| (its element 0) is
' tested against every element of other_contour|: for a line, on which side of it the point lies; for an arc,
' whether the point is inside or outside the circle where the point's angle falls within the arc. The side that
' counts as inside follows from the tool side of other_contour| (contour_side$="R") and whether other_contour|
' is an outer contour. The test stops at the first element the point is on the wrong side of. Coordinates come
' from the element strings: the sign at columns 8/20/32 and the value at columns 9/21/33 (X/Y/Z); tool_axis|
' (the tool axis) picks the two of them that form the working plane. contour_relation| codes: point inside
' other_contour| = 6 (one outer, one inner), 2 (both outer), 4 (both inner); point outside = 5, 1, 3 the same
' way round. contours_touch! (VAR): set TRUE when the point lies on an element of other_contour| (to within
' 1E-04): the contours touch.
PROCEDURE classify_contour_nesting(other_contour|,VAR contours_touch!)
  LOCAL program_line$,tool_right_of_contour!,line_index&,test_point_x,test_point_y,element_start_x,element_start_y,element_end_x,element_end_y,arc_end_layer&,direction_x,direction_y,normal_direction_x,normal_direction_y,discriminant,arc_radius,arc_positive!,line_parameter,contours_swapped!,other_is_pocket!,arc_centre_x,arc_centre_y,vector_x,vector_y,arc_start_angle,arc_end_angle,point_angle,point_distance,search_found!,angle_within_arc!,point_inside!
  ' contour_is_pocket! marks an outer contour: make current_contour| the outer one of the pair
  IF (NOT contour_is_pocket!(current_contour|)) AND contour_is_pocket!(other_contour|)
    SWAP current_contour|,other_contour|
    contours_swapped!=TRUE
  ELSE
    contours_swapped!=FALSE
  ENDIF
  ' the other contour is an outer contour
  other_is_pocket!=contour_is_pocket!(other_contour|)
  ' element 0 of current_contour| gives the test point
  program_line$=offset_contour_elements$(current_contour|,0)
  ' tool axis Z: the XY plane (X at column 9, Y at column 21)
  IF tool_axis|=3
    test_point_x=VAL(MID$(program_line$,9,10))
    IF MID$(program_line$,8,1)="-"
      test_point_x=-test_point_x
    ENDIF
    test_point_y=VAL(MID$(program_line$,21,10))
    IF MID$(program_line$,20,1)="-"
      test_point_y=-test_point_y
    ENDIF
  ELSE
    ' tool axis X: the YZ plane (Y at column 21, Z at column 33)
    IF tool_axis|=1
      test_point_x=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        test_point_x=-test_point_x
      ENDIF
      test_point_y=VAL(MID$(program_line$,33,10))
      IF MID$(program_line$,32,1)="-"
        test_point_y=-test_point_y
      ENDIF
    ELSE
      ' tool axis Y: the ZX plane (Z at column 33, X at column 9)
      test_point_x=VAL(MID$(program_line$,33,10))
      IF MID$(program_line$,32,1)="-"
        test_point_x=-test_point_x
      ENDIF
      test_point_y=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        test_point_y=-test_point_y
      ENDIF
    ENDIF
  ENDIF
  ' element 0 of other_contour| gives its start point
  program_line$=offset_contour_elements$(other_contour|,0)
  IF tool_axis|=3
    element_start_x=VAL(MID$(program_line$,9,10))
    IF MID$(program_line$,8,1)="-"
      element_start_x=-element_start_x
    ENDIF
    element_start_y=VAL(MID$(program_line$,21,10))
    IF MID$(program_line$,20,1)="-"
      element_start_y=-element_start_y
    ENDIF
  ELSE
    IF tool_axis|=1
      element_start_x=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_start_x=-element_start_x
      ENDIF
      element_start_y=VAL(MID$(program_line$,33,10))
      IF MID$(program_line$,32,1)="-"
        element_start_y=-element_start_y
      ENDIF
    ELSE
      element_start_x=VAL(MID$(program_line$,33,10))
      IF MID$(program_line$,32,1)="-"
        element_start_x=-element_start_x
      ENDIF
      element_start_y=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_start_y=-element_start_y
      ENDIF
    ENDIF
  ENDIF
  ' the tool runs to the right of contour other_contour|
  tool_right_of_contour!=(contour_side$(other_contour|)="R")
  ' number of elements of other_contour|
  arc_end_layer&=offset_contour_last_line&(other_contour|)
  line_index&=0
  REPEAT
    ON MENU
    INC line_index&
    program_line$=offset_contour_elements$(other_contour|,line_index&)
    ' a line; any other element is a circle centre followed by its arc
    IF LEFT$(program_line$)="L"
      IF tool_axis|=3
        element_end_x=VAL(MID$(program_line$,9,10))
        IF MID$(program_line$,8,1)="-"
          element_end_x=-element_end_x
        ENDIF
        element_end_y=VAL(MID$(program_line$,21,10))
        IF MID$(program_line$,20,1)="-"
          element_end_y=-element_end_y
        ENDIF
      ELSE
        IF tool_axis|=1
          element_end_x=VAL(MID$(program_line$,21,10))
          IF MID$(program_line$,20,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ELSE
          element_end_x=VAL(MID$(program_line$,33,10))
          IF MID$(program_line$,32,1)="-"
            element_end_x=-element_end_x
          ENDIF
          element_end_y=VAL(MID$(program_line$,9,10))
          IF MID$(program_line$,8,1)="-"
            element_end_y=-element_end_y
          ENDIF
        ENDIF
      ENDIF
      ' direction of the line
      direction_x=element_end_x-element_start_x
      direction_y=element_end_y-element_start_y
      ' a line of no length decides nothing
      IF direction_x=0 AND direction_y=0
        point_inside!=TRUE
      ELSE
        ' a vertical line
        IF direction_x=0
          IF test_point_x>element_start_x AND direction_y<0 OR (test_point_x<element_start_x OR .0001>ABS(test_point_x-element_start_x) AND (direction_y>0 OR .0001>ABS(direction_y)))
            line_parameter=-1
          ELSE
            line_parameter=1
          ENDIF
        ELSE
          normal_direction_x=-direction_y
          normal_direction_y=direction_x
          ' with the DIV below: how far the test point lies across the line, signed
          line_parameter=element_start_y-test_point_y+direction_y/direction_x*(test_point_x-element_start_x)
          DIV line_parameter,normal_direction_y-normal_direction_x*direction_y/direction_x
        ENDIF
        IF .0001>ABS(line_parameter)
          point_inside!=TRUE
          contours_touch!=TRUE
        ELSE
          ' the point is on the inner side of this line
          IF line_parameter>0 AND (tool_right_of_contour! AND other_is_pocket! OR ((NOT tool_right_of_contour!) AND (NOT other_is_pocket!))) OR (line_parameter<0 AND ((NOT tool_right_of_contour!) AND other_is_pocket! OR (tool_right_of_contour! AND (NOT other_is_pocket!))))
            point_inside!=TRUE
          ELSE
            point_inside!=FALSE
          ENDIF
        ENDIF
      ENDIF
    ELSE
      ' circle centre
      arc_centre_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        arc_centre_x=-arc_centre_x
      ENDIF
      arc_centre_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        arc_centre_y=-arc_centre_y
      ENDIF
      direction_x=arc_centre_x-test_point_x
      direction_y=arc_centre_y-test_point_y
      ' distance of the test point from the centre
      discriminant=SQR(direction_x*direction_x+direction_y*direction_y)
      ' the next element is the arc itself: its end point
      INC line_index&
      program_line$=offset_contour_elements$(other_contour|,line_index&)
      element_end_x=VAL(MID$(program_line$,9,10))
      IF MID$(program_line$,8,1)="-"
        element_end_x=-element_end_x
      ENDIF
      element_end_y=VAL(MID$(program_line$,21,10))
      IF MID$(program_line$,20,1)="-"
        element_end_y=-element_end_y
      ENDIF
      ' a minus sign at column 33 marks a clockwise arc
      arc_positive!=(MID$(program_line$,33,1)="-")
      ' the point is the centre itself
      IF discriminant=0
        IF tool_right_of_contour! AND arc_positive! OR ((NOT tool_right_of_contour!) AND (NOT arc_positive!))
          point_inside!=TRUE
        ELSE
          point_inside!=FALSE
        ENDIF
      ELSE
        direction_x=element_end_x-arc_centre_x
        direction_y=element_end_y-arc_centre_y
        ' radius of the arc
        arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
        IF 1E-06>ABS(arc_radius) AND discriminant>0
          point_inside!=FALSE
        ELSE
          IF .0001>ABS(element_start_x-element_end_x) AND .0001>ABS(element_start_y-element_end_y)
            angle_within_arc!=TRUE
          ELSE
            ' angle of the arc's start point round the centre (clamped_arc_cosine gives 0..PI, the lower half adds to
            ' two_pi)
            vector_x=element_start_x-arc_centre_x
            vector_y=element_start_y-arc_centre_y
            point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
            arc_start_angle=vector_x/point_distance
            arc_start_angle=@clamped_arc_cosine(arc_start_angle)
            IF vector_y<0
              arc_start_angle=two_pi-arc_start_angle
            ENDIF
            ' angle of the arc's end point
            vector_x=element_end_x-arc_centre_x
            vector_y=element_end_y-arc_centre_y
            point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
            arc_end_angle=vector_x/point_distance
            arc_end_angle=@clamped_arc_cosine(arc_end_angle)
            IF vector_y<0
              arc_end_angle=two_pi-arc_end_angle
            ENDIF
            ' assume the point's angle is within the arc
            angle_within_arc!=TRUE
            IF .0001<ABS(arc_start_angle-arc_end_angle)
              ' angle of the test point
              vector_x=test_point_x-arc_centre_x
              vector_y=test_point_y-arc_centre_y
              point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
              point_angle=vector_x/point_distance
              point_angle=@clamped_arc_cosine(point_angle)
              IF vector_y<0
                point_angle=two_pi-point_angle
              ENDIF
              IF arc_positive!
                ' clockwise arc: the point's angle lies outside the sweep, the arc decides nothing
                IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                  angle_within_arc!=FALSE
                  point_inside!=TRUE
                ENDIF
              ELSE
                ' anticlockwise arc: the point's angle lies outside the sweep, the arc decides nothing
                IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                  angle_within_arc!=FALSE
                  point_inside!=TRUE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF angle_within_arc!
            IF .0001>ABS(discriminant-arc_radius)
              point_inside!=TRUE
              contours_touch!=TRUE
            ELSE
              IF other_is_pocket!
                IF arc_positive!
                  ' outer contour, clockwise arc: the point is on the inner side
                  IF tool_right_of_contour! AND (discriminant<arc_radius OR .0001>ABS(discriminant-arc_radius)) OR ((NOT tool_right_of_contour!) AND (discriminant>arc_radius OR .0001>ABS(discriminant-arc_radius)))
                    point_inside!=TRUE
                  ELSE
                    point_inside!=FALSE
                  ENDIF
                ELSE
                  ' outer contour, anticlockwise arc: the point is on the inner side
                  IF tool_right_of_contour! AND (discriminant>arc_radius OR .0001>ABS(discriminant-arc_radius)) OR ((NOT tool_right_of_contour!) AND (discriminant<arc_radius OR .0001>ABS(discriminant-arc_radius)))
                    point_inside!=TRUE
                  ELSE
                    point_inside!=FALSE
                  ENDIF
                ENDIF
              ELSE
                IF arc_positive!
                  ' inner contour, clockwise arc: the point is on the inner side
                  IF tool_right_of_contour! AND (discriminant>arc_radius OR .0001>ABS(discriminant-arc_radius)) OR ((NOT tool_right_of_contour!) AND (discriminant<arc_radius OR .0001>ABS(discriminant-arc_radius)))
                    point_inside!=TRUE
                  ELSE
                    point_inside!=FALSE
                  ENDIF
                ELSE
                  ' inner contour, anticlockwise arc: the point is on the inner side
                  IF tool_right_of_contour! AND (discriminant<arc_radius OR .0001>ABS(discriminant-arc_radius)) OR ((NOT tool_right_of_contour!) AND (discriminant>arc_radius OR .0001>ABS(discriminant-arc_radius)))
                    point_inside!=TRUE
                  ELSE
                    point_inside!=FALSE
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' the end of this element starts the next
    element_start_x=element_end_x
    element_start_y=element_end_y
    ' stop at the first element the point is on the wrong side of
  UNTIL (NOT point_inside!) OR line_index&=arc_end_layer&
  ' the test point is inside contour other_contour|
  IF point_inside!
    ' one outer, one inner contour
    IF (NOT contour_is_pocket!(current_contour|)) AND other_is_pocket! OR (contour_is_pocket!(current_contour|) AND (NOT other_is_pocket!))
      contour_relation|(current_contour|,other_contour|)=6
      contour_relation|(other_contour|,current_contour|)=6
    ELSE
      ' both outer contours
      IF contour_is_pocket!(current_contour|) AND other_is_pocket!
        contour_relation|(current_contour|,other_contour|)=2
        contour_relation|(other_contour|,current_contour|)=2
      ELSE
        ' both inner contours
        IF (NOT contour_is_pocket!(current_contour|)) AND (NOT other_is_pocket!)
          contour_relation|(current_contour|,other_contour|)=4
          contour_relation|(other_contour|,current_contour|)=4
        ENDIF
      ENDIF
    ENDIF
  ELSE
    ' the test point is outside contour other_contour|: the same three cases
    IF (NOT contour_is_pocket!(current_contour|)) AND other_is_pocket! OR (contour_is_pocket!(current_contour|) AND (NOT other_is_pocket!))
      contour_relation|(current_contour|,other_contour|)=5
      contour_relation|(other_contour|,current_contour|)=5
    ELSE
      IF contour_is_pocket!(current_contour|) AND other_is_pocket!
        contour_relation|(current_contour|,other_contour|)=1
        contour_relation|(other_contour|,current_contour|)=1
      ELSE
        IF (NOT contour_is_pocket!(current_contour|)) AND (NOT other_is_pocket!)
          contour_relation|(current_contour|,other_contour|)=3
          contour_relation|(other_contour|,current_contour|)=3
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  ' undo the swap
  IF contours_swapped!
    SWAP current_contour|,other_contour|
  ENDIF
RETURN
' Tests whether the point compensated_start() (where the simulation is about to FILL the tool path of contour
' current_contour|) lies inside the tool path tool_path_elements$(current_contour|,...). For every line of the
' path whose perpendicular foot from the point falls on the line, the side of the point is checked against the
' tool side (path_side$="R"); when it is on the wrong side, count_ray_path_crossings casts a ray from the point
' to the line's start and the crossings decide. For every arc the point's angle is checked against the arc and
' its distance against the radius. Returns point_inside! (VAR) TRUE when the point is inside. It is FALSE when
' no element was near the point at all, or when a path of more than three lines was hit at most twice.
PROCEDURE check_fill_point_in_path(VAR point_inside!)
  LOCAL program_line$,tool_right_of_contour!,line_index&,test_point_x,test_point_y,element_start_x,element_start_y,element_end_x,element_end_y,arc_end_layer&,direction_x,direction_y,normal_direction_x,normal_direction_y,discriminant,arc_radius,arc_positive!,line_parameter,contours_swapped!,other_is_pocket!,arc_centre_x,arc_centre_y,vector_x,vector_y,arc_start_angle,arc_end_angle,point_angle,point_distance,angle_wraps!,other_contour|,search_found!,angle_within_arc!,foot_position_y,foot_position_x,first_point_valid!,second_point_valid!,element_near_point!,near_count&,path_line_count&,foot_x,foot_y,perpendicular_x,perpendicular_y
  ' assume the point is inside
  point_inside!=TRUE
  ' no element was near the point yet
  element_near_point!=FALSE
  ' elements near the point
  near_count&=0
  ' lines in the path (counted down below for every arc)
  path_line_count&=0
  ' the fill point in the working plane (first_plane_axis|/second_plane_axis| = its two axes)
  test_point_x=compensated_start(first_plane_axis|)
  test_point_y=compensated_start(second_plane_axis|)
  ' start point of the tool path into end_point()
  read_line_target(tool_path_elements$(current_contour|,0))
  element_start_x=end_point(first_plane_axis|)
  element_start_y=end_point(second_plane_axis|)
  ' the tool runs to the right of the path
  tool_right_of_contour!=(path_side$(current_contour|)="R")
  other_is_pocket!=contour_is_pocket!(current_contour|)
  ' number of path elements
  arc_end_layer&=tool_path_line_count&(current_contour|)-1
  path_line_count&=arc_end_layer&
  line_index&=0
  REPEAT
    ON MENU
    INC line_index&
    program_line$=tool_path_elements$(current_contour|,line_index&)
    ' a line; any other element is a circle centre followed by its arc
    IF LEFT$(program_line$)="L"
      read_line_target(program_line$)
      element_end_x=end_point(tool_first_axis|)
      element_end_y=end_point(tool_second_axis|)
      ' direction of the line
      direction_x=element_end_x-element_start_x
      direction_y=element_end_y-element_start_y
      IF direction_x=0 AND direction_y=0
        point_inside!=TRUE
      ELSE
        ' assume the perpendicular foot from the point lies on the line
        search_found!=TRUE
        ' vertical line
        IF direction_x=0
          line_parameter=(test_point_y-element_start_y)/direction_y
          IF line_parameter<0 OR line_parameter>1
            search_found!=FALSE
          ENDIF
        ELSE
          ' horizontal line
          IF direction_y=0
            line_parameter=(test_point_x-element_start_x)/direction_x
            IF line_parameter<0 OR line_parameter>1
              search_found!=FALSE
            ENDIF
          ELSE
            ' perpendicular direction
            perpendicular_x=-direction_y
            perpendicular_y=direction_x
            IF perpendicular_x=0 AND direction_x<>0
              line_parameter=element_start_y-test_point_y
              line_parameter=line_parameter+direction_y/direction_x*(test_point_x-element_start_x)
              DIV line_parameter,perpendicular_y-direction_y*perpendicular_x/direction_x
              ' foot of the perpendicular from the point
              foot_x=line_parameter*perpendicular_x+test_point_x
              foot_y=line_parameter*perpendicular_y+test_point_y
            ELSE
              IF perpendicular_x<>0
                line_parameter=test_point_y-element_start_y
                line_parameter=line_parameter+perpendicular_y/perpendicular_x*(element_start_x-test_point_x)
                DIV line_parameter,direction_y-perpendicular_y*direction_x/perpendicular_x
                foot_x=line_parameter*direction_x+element_start_x
                foot_y=line_parameter*direction_y+element_start_y
              ENDIF
            ENDIF
            ' where the foot lies along the line, 0..1 on it
            foot_position_y=(foot_y-element_start_y)/direction_y
            foot_position_x=(foot_x-element_start_x)/direction_x
            IF foot_position_y<0 OR foot_position_y>1 OR foot_position_x<0 OR foot_position_x>1
              search_found!=FALSE
            ENDIF
          ENDIF
        ENDIF
        IF search_found!
          ' this line is near the point
          element_near_point!=TRUE
          INC near_count&
          IF direction_x=0
            IF test_point_x>element_start_x AND direction_y<0 OR (test_point_x<element_start_x OR .0001>ABS(test_point_x-element_start_x) AND (direction_y>0 OR .0001>ABS(direction_y)))
              line_parameter=-1
            ELSE
              line_parameter=1
            ENDIF
          ELSE
            normal_direction_x=-direction_y
            normal_direction_y=direction_x
            line_parameter=element_start_y-test_point_y+direction_y/direction_x*(test_point_x-element_start_x)
            DIV line_parameter,normal_direction_y-normal_direction_x*direction_y/direction_x
          ENDIF
          IF .0001>ABS(line_parameter) OR (line_parameter>0 AND tool_right_of_contour!) OR (line_parameter<0 AND (NOT tool_right_of_contour!))
            point_inside!=TRUE
          ELSE
            count_ray_path_crossings(test_point_x,test_point_y,element_start_x,element_start_y,point_inside!)
          ENDIF
        ELSE
          point_inside!=TRUE
        ENDIF
      ENDIF
    ELSE
      ' an arc: one line fewer than elements
      DEC path_line_count&
      read_circle_centre(program_line$)
      arc_centre_x=circle_centre(tool_first_axis|)
      arc_centre_y=circle_centre(tool_second_axis|)
      direction_x=test_point_x-arc_centre_x
      direction_y=test_point_y-arc_centre_y
      ' distance of the fill point from the centre
      discriminant=SQR(direction_x*direction_x+direction_y*direction_y)
      INC line_index&
      program_line$=tool_path_elements$(current_contour|,line_index&)
      read_arc_target(program_line$,9,21)
      element_end_x=end_point(tool_first_axis|)
      element_end_y=end_point(tool_second_axis|)
      arc_positive!=(MID$(program_line$,33,1)="-")
      IF discriminant=0
        IF tool_right_of_contour! AND arc_positive! OR ((NOT tool_right_of_contour!) AND (NOT arc_positive!))
          point_inside!=TRUE
        ELSE
          point_inside!=FALSE
        ENDIF
      ELSE
        direction_x=element_start_x-arc_centre_x
        direction_y=element_start_y-arc_centre_y
        ' radius of the arc
        arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
        IF 1E-06>ABS(arc_radius) AND discriminant>0
          point_inside!=FALSE
        ELSE
          ' angle of the arc's start point round the centre
          vector_x=element_start_x-arc_centre_x
          vector_y=element_start_y-arc_centre_y
          point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
          arc_start_angle=vector_x/point_distance
          arc_start_angle=@clamped_arc_cosine(arc_start_angle)
          IF vector_y<0
            arc_start_angle=two_pi-arc_start_angle
          ENDIF
          ' angle of the arc's end point
          vector_x=element_end_x-arc_centre_x
          vector_y=element_end_y-arc_centre_y
          point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
          arc_end_angle=vector_x/point_distance
          arc_end_angle=@clamped_arc_cosine(arc_end_angle)
          IF vector_y<0
            arc_end_angle=two_pi-arc_end_angle
          ENDIF
          angle_within_arc!=TRUE
          IF 9.99999999999997E-06<ABS(arc_start_angle-arc_end_angle)
            ' angle of the fill point
            vector_x=test_point_x-arc_centre_x
            vector_y=test_point_y-arc_centre_y
            point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
            point_angle=vector_x/point_distance
            point_angle=@clamped_arc_cosine(point_angle)
            IF vector_y<0
              point_angle=two_pi-point_angle
            ENDIF
            IF arc_positive!
              IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                angle_within_arc!=FALSE
              ENDIF
            ELSE
              IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                angle_within_arc!=FALSE
              ENDIF
            ENDIF
          ENDIF
          IF angle_within_arc!
            ' this arc is near the point
            element_near_point!=TRUE
            INC near_count&
            ' the point lies on the circle
            IF discriminant=arc_radius
              point_inside!=TRUE
            ELSE
              IF arc_positive!
                ' clockwise arc: the point must be inside the circle for a right-hand tool, outside for a left-hand one
                IF tool_right_of_contour! AND discriminant<arc_radius OR ((NOT tool_right_of_contour!) AND discriminant>arc_radius)
                  point_inside!=TRUE
                ELSE
                  point_inside!=FALSE
                ENDIF
              ELSE
                ' anticlockwise arc: the other way round
                IF tool_right_of_contour! AND discriminant>arc_radius OR ((NOT tool_right_of_contour!) AND discriminant<arc_radius)
                  point_inside!=TRUE
                ELSE
                  point_inside!=FALSE
                ENDIF
              ENDIF
            ENDIF
          ELSE
            point_inside!=TRUE
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' the end of this element starts the next
    element_start_x=element_end_x
    element_start_y=element_end_y
    ' stop at the first element the point is on the wrong side of
  UNTIL (NOT point_inside!) OR line_index&=arc_end_layer&
  ' nothing near the point, or a path of more than three lines hit at most twice: outside
  IF (NOT element_near_point!) OR (path_line_count&>3 AND near_count&<=2)
    point_inside!=FALSE
  ENDIF
RETURN
' Counts how often the segment from (test_point_x,test_point_y) to (ray_end_x,ray_end_y) crosses the tool path
' tool_path_elements$(current_contour|,...) of contour current_contour|, in the working plane: lines are cut
' with the segment directly, arcs by solving the segment's line against the circle and keeping the cuts that lie
' on the segment and within the arc. An even count element_count& means the start point is outside:
' point_inside! (VAR) is then set FALSE, otherwise it is left as it was. first_point_valid! and
' second_point_valid! (the two circle cuts are on the segment) are LOCALs that are only ever cleared here, so an
' arc never adds a crossing.
PROCEDURE count_ray_path_crossings(test_point_x,test_point_y,ray_end_x,ray_end_y,VAR point_inside!)
  LOCAL program_line$,tool_right_of_contour!,line_index&,element_start_x,element_start_y,element_end_x,element_end_y,arc_end_layer&,direction_x,direction_y,normal_direction_x,normal_direction_y,discriminant,arc_radius,arc_positive!,line_parameter,contours_swapped!,other_is_pocket!,arc_centre_x,arc_centre_y,vector_x,vector_y,arc_start_angle,arc_end_angle,point_angle,point_distance,angle_wraps!,other_contour|,search_found!,angle_within_arc!,foot_position_y,foot_position_x,first_point_valid!,second_point_valid!,element_near_point!,near_count&,element_count&,foot_x,foot_y,perpendicular_x,perpendicular_y,ray_direction_x,ray_direction_y,crossing_point_x,crossing_point_y,point_distance,first_crossing_x,first_crossing_y,second_crossing_x,second_crossing_y,line_slope,line_intercept,basic_variables,segment_length,second_operand,quadratic_factor
  ' crossings found
  element_count&=0
  ' direction of the ray
  ray_direction_x=test_point_x-ray_end_x
  ray_direction_y=test_point_y-ray_end_y
  ' start point of the tool path into end_point()
  read_line_target(tool_path_elements$(current_contour|,0))
  element_start_x=end_point(first_plane_axis|)
  element_start_y=end_point(second_plane_axis|)
  ' the tool runs to the right of the path
  tool_right_of_contour!=(path_side$(current_contour|)="R")
  other_is_pocket!=contour_is_pocket!(current_contour|)
  arc_end_layer&=tool_path_line_count&(current_contour|)-1
  line_index&=0
  REPEAT
    ON MENU
    INC line_index&
    program_line$=tool_path_elements$(current_contour|,line_index&)
    ' a line; any other element is a circle centre followed by its arc
    IF LEFT$(program_line$)="L"
      read_line_target(program_line$)
      element_end_x=end_point(tool_first_axis|)
      element_end_y=end_point(tool_second_axis|)
      ' direction of the line
      direction_x=element_end_x-element_start_x
      direction_y=element_end_y-element_start_y
      ' only a line of some length can be crossed
      IF direction_x<>0 OR direction_y<>0
        search_found!=TRUE
        IF 1E-06>ABS(direction_x-ray_direction_x) OR 1E-06>ABS(direction_y-ray_direction_y)
          search_found!=FALSE
        ELSE
          IF ray_direction_x=0 AND direction_x<>0
            line_parameter=element_start_y-ray_end_y
            line_parameter=line_parameter+direction_y/direction_x*(ray_end_x-element_start_x)
            DIV line_parameter,ray_direction_y-direction_y*ray_direction_x/direction_x
            ' where the ray's line cuts the line
            crossing_point_x=line_parameter*ray_direction_x+ray_end_x
            crossing_point_y=line_parameter*ray_direction_y+ray_end_y
            IF line_parameter<0 AND .001<ABS(line_parameter) OR line_parameter>1
              search_found!=FALSE
            ENDIF
          ELSE
            IF ray_direction_x<>0
              line_parameter=ray_end_y-element_start_y
              line_parameter=line_parameter+ray_direction_y/ray_direction_x*(element_start_x-ray_end_x)
              DIV line_parameter,direction_y-ray_direction_y*direction_x/ray_direction_x
              crossing_point_x=line_parameter*direction_x+element_start_x
              crossing_point_y=line_parameter*direction_y+element_start_y
              IF line_parameter<0 AND .001<ABS(line_parameter) OR line_parameter>1
                search_found!=FALSE
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' check the cut lies on the line: the foot of the perpendicular from it
        IF search_found!
          IF direction_x=0
            line_parameter=(crossing_point_y-element_start_y)/direction_y
            IF line_parameter<0 OR line_parameter>1
              search_found!=FALSE
            ENDIF
          ELSE
            IF direction_y=0
              line_parameter=(crossing_point_x-element_start_x)/direction_x
              IF line_parameter<0 OR line_parameter>1
                search_found!=FALSE
              ENDIF
            ELSE
              perpendicular_x=-direction_y
              perpendicular_y=direction_x
              IF perpendicular_x=0 AND direction_x<>0
                line_parameter=element_start_y-crossing_point_y
                line_parameter=line_parameter+direction_y/direction_x*(crossing_point_x-element_start_x)
                DIV line_parameter,perpendicular_y-direction_y*perpendicular_x/direction_x
                foot_x=line_parameter*perpendicular_x+crossing_point_x
                foot_y=line_parameter*perpendicular_y+crossing_point_y
              ELSE
                IF perpendicular_x<>0
                  line_parameter=crossing_point_y-element_start_y
                  line_parameter=line_parameter+perpendicular_y/perpendicular_x*(element_start_x-crossing_point_x)
                  DIV line_parameter,direction_y-perpendicular_y*direction_x/perpendicular_x
                  foot_x=line_parameter*direction_x+element_start_x
                  foot_y=line_parameter*direction_y+element_start_y
                ENDIF
              ENDIF
              foot_position_y=(foot_y-element_start_y)/direction_y
              foot_position_x=(foot_x-element_start_x)/direction_x
              IF foot_position_y<0 OR foot_position_y>1 OR foot_position_x<0 OR foot_position_x>1
                search_found!=FALSE
              ENDIF
            ENDIF
          ENDIF
          ' the ray crosses this line
          IF search_found!
            INC element_count&
          ENDIF
        ENDIF
      ENDIF
    ELSE
      read_circle_centre(program_line$)
      arc_centre_x=circle_centre(tool_first_axis|)
      arc_centre_y=circle_centre(tool_second_axis|)
      ' the next element is the arc itself: its end point
      INC line_index&
      program_line$=tool_path_elements$(current_contour|,line_index&)
      read_arc_target(program_line$,9,21)
      element_end_x=end_point(tool_first_axis|)
      element_end_y=end_point(tool_second_axis|)
      arc_positive!=(MID$(program_line$,33,1)="-")
      direction_x=test_point_x-arc_centre_x
      direction_y=test_point_y-arc_centre_y
      ' distance of the ray start from the centre
      discriminant=SQR(direction_x*direction_x+direction_y*direction_y)
      IF discriminant>0
        ' radius of the arc
        direction_x=element_start_x-arc_centre_x
        direction_y=element_start_y-arc_centre_y
        arc_radius=SQR(direction_x*direction_x+direction_y*direction_y)
        IF 1E-06>ABS(arc_radius)
          search_found!=FALSE
        ELSE
          search_found!=TRUE
          IF 9.99999999999997E-06>ABS(ray_direction_x)
            ' vertical ray: the circle at u=test_point_x
            point_distance=test_point_x-arc_centre_x
            discriminant=arc_radius*arc_radius-point_distance*point_distance
            IF .001>ABS(discriminant)
              discriminant=0
            ENDIF
            IF discriminant<0
              search_found!=FALSE
            ELSE
              ' the two cuts of the vertical ray with the circle
              first_crossing_x=test_point_x
              second_crossing_x=first_crossing_x
              first_crossing_y=arc_centre_y-SQR(discriminant)
              second_crossing_y=SQR(discriminant)+arc_centre_y
            ENDIF
          ELSE
            ' the arc ends at the ray's end point: that point is taken as both cuts, without solving the quadratic
            IF .001>ABS(ray_end_x-element_end_x) AND .001>ABS(ray_end_y-element_end_y)
              first_crossing_x=ray_end_x
              first_crossing_y=ray_end_y
              second_crossing_x=element_end_x
              second_crossing_y=element_end_y
            ELSE
              ' ray line v=line_slope*u+line_intercept against the circle: a quadratic in u
              line_slope=ray_direction_y/ray_direction_x
              line_intercept=ray_end_y-line_slope*ray_end_x
              basic_variables=line_intercept-arc_centre_y
              segment_length=arc_centre_x-line_slope*basic_variables
              second_operand=basic_variables*basic_variables+arc_centre_x*arc_centre_x-arc_radius*arc_radius
              quadratic_factor=line_slope*line_slope
              INC quadratic_factor
              discriminant=segment_length*segment_length-quadratic_factor*second_operand
              IF .001>ABS(discriminant)
                discriminant=0
              ENDIF
              IF discriminant<0
                search_found!=FALSE
              ELSE
                ' first root, taken for numerical safety from the larger term
                IF segment_length>=0
                  first_crossing_x=(SQR(discriminant)+segment_length)/quadratic_factor
                ELSE
                  first_crossing_x=(segment_length-SQR(discriminant))/quadratic_factor
                ENDIF
                ' second root from the product of the roots
                first_crossing_y=line_slope*first_crossing_x+line_intercept
                IF quadratic_factor<>0 AND first_crossing_x<>0
                  second_crossing_x=second_operand/first_crossing_x/quadratic_factor
                  second_crossing_y=line_slope*second_crossing_x+line_intercept
                ENDIF
              ENDIF
            ENDIF
          ENDIF
          IF search_found!
            ' first cut: must lie on the ray
            crossing_point_x=first_crossing_x
            crossing_point_y=first_crossing_y
            IF ray_direction_x=0
              line_parameter=(crossing_point_y-ray_end_y)/ray_direction_y
              IF line_parameter<0 OR line_parameter>1
                first_point_valid!=FALSE
              ENDIF
            ELSE
              IF ray_direction_y=0
                line_parameter=(crossing_point_x-ray_end_x)/ray_direction_x
                IF line_parameter<0 OR line_parameter>1
                  first_point_valid!=FALSE
                ENDIF
              ELSE
                perpendicular_x=-ray_direction_y
                perpendicular_y=ray_direction_x
                IF perpendicular_x=0 AND ray_direction_x<>0
                  line_parameter=ray_end_y-crossing_point_y
                  line_parameter=line_parameter+ray_direction_y/ray_direction_x*(crossing_point_x-ray_end_x)
                  DIV line_parameter,perpendicular_y-ray_direction_y*perpendicular_x/ray_direction_x
                  foot_x=line_parameter*perpendicular_x+crossing_point_x
                  foot_y=line_parameter*perpendicular_y+crossing_point_y
                ELSE
                  IF perpendicular_x<>0
                    line_parameter=crossing_point_y-ray_end_y
                    line_parameter=line_parameter+perpendicular_y/perpendicular_x*(ray_end_x-crossing_point_x)
                    DIV line_parameter,ray_direction_y-perpendicular_y*ray_direction_x/perpendicular_x
                    foot_x=line_parameter*ray_direction_x+ray_end_x
                    foot_y=line_parameter*ray_direction_y+ray_end_y
                  ENDIF
                ENDIF
                foot_position_y=(foot_y-ray_end_y)/ray_direction_y
                foot_position_x=(foot_x-ray_end_x)/ray_direction_x
                IF foot_position_y<0 OR foot_position_y>1 OR foot_position_x<0 OR foot_position_x>1
                  first_point_valid!=FALSE
                ENDIF
              ENDIF
            ENDIF
            ' and within the arc
            IF first_point_valid!
              vector_x=element_start_x-arc_centre_x
              vector_y=element_start_y-arc_centre_y
              point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
              arc_start_angle=vector_x/point_distance
              arc_start_angle=@clamped_arc_cosine(arc_start_angle)
              IF vector_y<0
                arc_start_angle=two_pi-arc_start_angle
              ENDIF
              vector_x=element_end_x-arc_centre_x
              vector_y=element_end_y-arc_centre_y
              point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
              arc_end_angle=vector_x/point_distance
              arc_end_angle=@clamped_arc_cosine(arc_end_angle)
              IF vector_y<0
                arc_end_angle=two_pi-arc_end_angle
              ENDIF
              angle_within_arc!=TRUE
              IF 9.99999999999997E-06<ABS(arc_start_angle-arc_end_angle)
                vector_x=crossing_point_x-arc_centre_x
                vector_y=crossing_point_y-arc_centre_y
                point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                point_angle=vector_x/point_distance
                point_angle=@clamped_arc_cosine(point_angle)
                IF vector_y<0
                  point_angle=two_pi-point_angle
                ENDIF
                IF arc_positive!
                  IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                    angle_within_arc!=FALSE
                  ENDIF
                ELSE
                  IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                    angle_within_arc!=FALSE
                  ENDIF
                ENDIF
              ENDIF
              IF angle_within_arc!
                INC element_count&
              ENDIF
            ENDIF
            ' second cut: must lie on the ray
            crossing_point_x=second_crossing_x
            crossing_point_y=second_crossing_y
            IF ray_direction_x=0
              line_parameter=(crossing_point_y-ray_end_y)/ray_direction_y
              IF line_parameter<0 OR line_parameter>1
                second_point_valid!=FALSE
              ENDIF
            ELSE
              IF ray_direction_y=0
                line_parameter=(crossing_point_x-ray_end_x)/ray_direction_x
                IF line_parameter<0 OR line_parameter>1
                  second_point_valid!=FALSE
                ENDIF
              ELSE
                perpendicular_x=-ray_direction_y
                perpendicular_y=ray_direction_x
                IF perpendicular_x=0 AND ray_direction_x<>0
                  line_parameter=ray_end_y-crossing_point_y
                  line_parameter=line_parameter+ray_direction_y/ray_direction_x*(crossing_point_x-ray_end_x)
                  DIV line_parameter,perpendicular_y-ray_direction_y*perpendicular_x/ray_direction_x
                  foot_x=line_parameter*perpendicular_x+crossing_point_x
                  foot_y=line_parameter*perpendicular_y+crossing_point_y
                ELSE
                  IF perpendicular_x<>0
                    line_parameter=crossing_point_y-ray_end_y
                    line_parameter=line_parameter+perpendicular_y/perpendicular_x*(ray_end_x-crossing_point_x)
                    DIV line_parameter,ray_direction_y-perpendicular_y*ray_direction_x/perpendicular_x
                    foot_x=line_parameter*ray_direction_x+ray_end_x
                    foot_y=line_parameter*ray_direction_y+ray_end_y
                  ENDIF
                ENDIF
                foot_position_y=(foot_y-ray_end_y)/ray_direction_y
                foot_position_x=(foot_x-ray_end_x)/ray_direction_x
                IF foot_position_y<0 OR foot_position_y>1 OR foot_position_x<0 OR foot_position_x>1
                  second_point_valid!=FALSE
                ENDIF
              ENDIF
            ENDIF
            ' and within the arc
            IF second_point_valid!
              vector_x=element_start_x-arc_centre_x
              vector_y=element_start_y-arc_centre_y
              point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
              arc_start_angle=vector_x/point_distance
              arc_start_angle=@clamped_arc_cosine(arc_start_angle)
              IF vector_y<0
                arc_start_angle=two_pi-arc_start_angle
              ENDIF
              vector_x=element_end_x-arc_centre_x
              vector_y=element_end_y-arc_centre_y
              point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
              arc_end_angle=vector_x/point_distance
              arc_end_angle=@clamped_arc_cosine(arc_end_angle)
              IF vector_y<0
                arc_end_angle=two_pi-arc_end_angle
              ENDIF
              angle_within_arc!=TRUE
              IF 9.99999999999997E-06<ABS(arc_start_angle-arc_end_angle)
                vector_x=crossing_point_x-arc_centre_x
                vector_y=crossing_point_y-arc_centre_y
                point_distance=SQR(vector_x*vector_x+vector_y*vector_y)
                point_angle=vector_x/point_distance
                point_angle=@clamped_arc_cosine(point_angle)
                IF vector_y<0
                  point_angle=two_pi-point_angle
                ENDIF
                IF arc_positive!
                  IF arc_start_angle>arc_end_angle AND (point_angle<arc_end_angle OR point_angle>arc_start_angle) OR (arc_start_angle<arc_end_angle AND point_angle>arc_start_angle AND point_angle<arc_end_angle)
                    angle_within_arc!=FALSE
                  ENDIF
                ELSE
                  IF arc_start_angle<arc_end_angle AND (point_angle>arc_end_angle OR point_angle<arc_start_angle) OR (arc_start_angle>arc_end_angle AND point_angle<arc_start_angle AND point_angle>arc_end_angle)
                    angle_within_arc!=FALSE
                  ENDIF
                ENDIF
              ENDIF
              IF angle_within_arc!
                INC element_count&
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' the end of this element starts the next
    element_start_x=element_end_x
    element_start_y=element_end_y
  UNTIL line_index&=arc_end_layer&
  ' an even number of crossings: the ray start is outside the path
  IF EVEN(element_count&)
    point_inside!=FALSE
  ENDIF
RETURN
' Reads the elements around a corner of contour current_contour| and works out where the tool centre is at the
' start and end of the corner element, offset by the tool radius tool_radius to the correction side, then
' hands the corner to compensate_tool_radius. corner_from_path!=TRUE: the corner at element path_line_index&
' of the tool path tool_path_elements$(current_contour|,...) (the element before it, or the last one when
' path_line_index&=0, and the element itself). corner_from_path!=FALSE: the closing corner of the contour in
' the NC program program_lines$, from the last element of block contour_label&(current_contour|) back to its
' first. Element kinds (first two characters): "L " line, "LP" polar line, "CC" circle centre followed by "C "
' arc, "CP" polar arc, "CR" arc by radius, "CT"/"CTP" tangential arcs. Lines that end in "}" are skipped
' (skip_to_next_block). When compensate_tool_radius reports with error_blocks&(0)=-10 that the tool does not
' fit inside the arc after the corner (rough-out only), the error is cleared, the element after that arc is
' read as the next element and the corner is worked out again, until it succeeds or another error stops it.
' Leaves previous_block_start()/move_end() = start/end of the element, previous_centre() = arc centre,
' move_compensated_start()/move_compensated_end() = offset start/end, compensation_side$ = correction side
' ("L"/"R"), move_arc_direction$/arc_direction$ = arc direction ("+"/"-"), first_is_line!/second_is_line! =
' the element / the next element is a line.
PROCEDURE offset_element_at_corner(corner_from_path!)
  LOCAL arc_end_layer&,line_index&,program_line$,following_block_text$,first_is_line!,second_is_line!,loop_index|,segment_length,offset_scale,element_arc_radius,uncompensated_radius,vector_x,vector_y,point_distance,work_point_y,direction_x,direction_y,search_found!
  ' a corner of the tool path
  IF corner_from_path!
    ' the first corner: its element before is the last one of the path
    IF path_line_index&=0
      line_index&=tool_path_line_count&(current_contour|)-2
    ELSE
      line_index&=path_line_index&-1
    ENDIF
    ' a circle centre belongs to the arc after it
    IF LEFT$(tool_path_elements$(current_contour|,line_index&),2)="CC"
      DEC line_index&
    ENDIF
    program_line$=tool_path_elements$(current_contour|,line_index&)
    following_block_text$=LEFT$(program_line$,2)
    ' line: end point into end_point()
    IF following_block_text$="L "
      read_line_target(program_line$)
    ELSE
      ' arc: end point at columns 9/21
      IF following_block_text$="C "
        read_arc_target(program_line$,9,21)
      ENDIF
    ENDIF
    ' start point of the corner element
    previous_block_start(1)=end_point(1)
    previous_block_start(2)=end_point(2)
    previous_block_start(3)=end_point(3)
    INC line_index&
    program_line$=tool_path_elements$(current_contour|,line_index&)
    following_block_text$=LEFT$(program_line$,2)
    ' line
    IF following_block_text$="L "
      first_is_line!=TRUE
      read_line_target(program_line$)
    ELSE
      ' arc by radius
      IF following_block_text$="CR"
        first_is_line!=FALSE
        interpret_radius_arc(program_line$)
      ELSE
        ' circle centre: read it, the arc follows
        set_plane_from_centre(program_line$)
        read_circle_centre(program_line$)
        INC line_index&
        program_line$=tool_path_elements$(current_contour|,line_index&)
        following_block_text$=LEFT$(program_line$,2)
        ' polar line after the centre
        IF following_block_text$="LP"
          first_is_line!=TRUE
          interpret_polar_line(program_line$)
        ELSE
          ' arc after the centre; move_arc_direction$ = its direction sign at column 33
          IF following_block_text$="C "
            first_is_line!=FALSE
            read_arc_target(program_line$,9,21)
            move_arc_direction$=@read_arc_direction$(program_line$,33)
          ELSE
            ' polar arc after the centre
            IF following_block_text$="CP"
              first_is_line!=FALSE
              interpret_polar_arc(program_line$)
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    ' end point, arc centre and current position
    move_end(1)=end_point(1)
    move_end(2)=end_point(2)
    move_end(3)=end_point(3)
    previous_centre(1)=circle_centre(1)
    previous_centre(2)=circle_centre(2)
    previous_centre(3)=circle_centre(3)
    start_point(1)=end_point(1)
    start_point(2)=end_point(2)
    start_point(3)=end_point(3)
    ' correction side of the path
    compensation_side$=path_side$(current_contour|)
    ' the element after the corner
    IF path_line_index&=0
      line_index&=1
    ELSE
      INC line_index&
    ENDIF
    program_line$=tool_path_elements$(current_contour|,line_index&)
    following_block_text$=LEFT$(program_line$,2)
    IF following_block_text$="L "
      second_is_line!=TRUE
      read_line_target(program_line$)
    ELSE
      IF following_block_text$="CR"
        second_is_line!=FALSE
        interpret_radius_arc(program_line$)
      ELSE
        set_plane_from_centre(program_line$)
        read_circle_centre(program_line$)
        INC line_index&
        program_line$=tool_path_elements$(current_contour|,line_index&)
        following_block_text$=LEFT$(program_line$,2)
        IF following_block_text$="LP"
          second_is_line!=TRUE
          interpret_polar_line(program_line$)
        ELSE
          IF following_block_text$="C "
            second_is_line!=FALSE
            read_arc_target(program_line$,9,21)
            arc_direction$=@read_arc_direction$(program_line$,33)
          ELSE
            IF following_block_text$="CP"
              second_is_line!=FALSE
              interpret_polar_arc(program_line$)
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    radius_correction$=compensation_side$
  ELSE
    ' the closing corner of the contour in the NC program: from its last element round to its first
    line_index&=label_start_line&(contour_label&(current_contour|))
    arc_end_layer&=label_end_line&(contour_label&(current_contour|))
    skip_to_previous_block(arc_end_layer&)
    REPEAT
      ON MENU
      previous_block_start(1)=move_end(1)
      previous_block_start(2)=move_end(2)
      previous_block_start(3)=move_end(3)
      move_end(1)=end_point(1)
      move_end(2)=end_point(2)
      move_end(3)=end_point(3)
      start_point(1)=end_point(1)
      start_point(2)=end_point(2)
      start_point(3)=end_point(3)
      previous_centre(1)=circle_centre(1)
      previous_centre(2)=circle_centre(2)
      previous_centre(3)=circle_centre(3)
      current_draw_block&=line_index&
      skip_to_next_block(line_index&)
      program_line$=program_lines$(line_index&)
      following_block_text$=LEFT$(program_line$,2)
      ' WHILE NOT ((following_block_text$="L " AND LEN(program_line$)>20) OR following_block_text$="LP" OR
      ' following_block_text$="CC" OR following_block_text$="C " OR following_block_text$="CP" OR
      ' following_block_text$="CR" OR following_block_text$="CT" OR line_index&=arc_end_layer&): skip lines that are
      ' not contour elements
      WHILE NOT (following_block_text$="L ") AND LEN(program_line$)>20 OR (following_block_text$="LP") OR (following_block_text$="CC") OR (following_block_text$="C ") OR (following_block_text$="CP") OR (following_block_text$="CR") OR (following_block_text$="CT") OR line_index&=arc_end_layer&
        skip_to_next_block(line_index&)
        program_line$=program_lines$(line_index&)
        following_block_text$=LEFT$(program_line$,2)
      WEND
      IF following_block_text$="L "
        first_is_line!=TRUE
        read_line_target(program_line$)
      ELSE
        IF following_block_text$="CR"
          first_is_line!=FALSE
          interpret_radius_arc(program_line$)
        ELSE
          IF following_block_text$="CC"
            set_plane_from_centre(program_line$)
            read_circle_centre(program_line$)
          ELSE
            IF following_block_text$="LP"
              first_is_line!=TRUE
              interpret_polar_line(program_line$)
            ELSE
              IF following_block_text$="C "
                first_is_line!=FALSE
                read_arc_target(program_line$,9,21)
                arc_direction$=@read_arc_direction$(program_line$,33)
              ELSE
                IF following_block_text$="CP"
                  first_is_line!=FALSE
                  interpret_polar_arc(program_line$)
                ELSE
                  ' tangential polar arc: the previous element's kind tells which way it leaves
                  IF LEFT$(program_line$,3)="CTP"
                    after_line_element!=first_is_line!
                    first_is_line!=FALSE
                    current_block&=line_index&
                    interpret_polar_tangential_arc(program_line$)
                  ELSE
                    ' tangential arc
                    IF following_block_text$="CT"
                      after_line_element!=first_is_line!
                      first_is_line!=FALSE
                      current_block&=line_index&
                      interpret_tangential_arc(program_line$)
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    UNTIL line_index&=arc_end_layer&
    previous_block_start(1)=move_end(1)
    previous_block_start(2)=move_end(2)
    previous_block_start(3)=move_end(3)
    move_end(1)=end_point(1)
    move_end(2)=end_point(2)
    move_end(3)=end_point(3)
    previous_centre(1)=circle_centre(1)
    previous_centre(2)=circle_centre(2)
    previous_centre(3)=circle_centre(3)
    start_point(1)=end_point(1)
    start_point(2)=end_point(2)
    start_point(3)=end_point(3)
    ' correction side of the contour
    compensation_side$=contour_side$(current_contour|)
    move_arc_direction$=arc_direction$
    ' go round to the start of the contour for the element after the corner
    line_index&=label_start_line&(contour_label&(current_contour|))
    loop_index|=FALSE
    REPEAT
      skip_to_next_block(line_index&)
      program_line$=program_lines$(line_index&)
      following_block_text$=LEFT$(program_line$,2)
      WHILE NOT (following_block_text$="L ") AND LEN(program_line$)>20 OR (following_block_text$="LP") OR (following_block_text$="CC") OR (following_block_text$="C ") OR (following_block_text$="CP") OR (following_block_text$="CR")
        skip_to_next_block(line_index&)
        program_line$=program_lines$(line_index&)
        following_block_text$=LEFT$(program_line$,2)
      WEND
      INC loop_index|
    UNTIL loop_index|=2
    IF following_block_text$="L "
      second_is_line!=TRUE
      read_line_target(program_line$)
    ELSE
      IF following_block_text$="CR"
        second_is_line!=FALSE
        interpret_radius_arc(program_line$)
      ELSE
        set_plane_from_centre(program_line$)
        read_circle_centre(program_line$)
        skip_to_next_block(line_index&)
        program_line$=program_lines$(line_index&)
        following_block_text$=LEFT$(program_line$,2)
        IF following_block_text$="LP"
          second_is_line!=TRUE
          interpret_polar_line(program_line$)
        ELSE
          IF following_block_text$="C "
            second_is_line!=FALSE
            read_arc_target(program_line$,9,21)
            arc_direction$=@read_arc_direction$(program_line$,33)
          ELSE
            IF following_block_text$="CP"
              second_is_line!=FALSE
              interpret_polar_arc(program_line$)
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    radius_correction$=compensation_side$
  ENDIF
  ' repeated while the element after the corner has to be passed over (the -10 check at the end)
  search_found!=FALSE
  REPEAT
    current_block&=line_index&
    find_lookahead_blocks
    ' a line: offset its ends perpendicular to it
    IF first_is_line!
      direction_x=move_end(first_plane_axis|)-previous_block_start(first_plane_axis|)
      direction_y=move_end(second_plane_axis|)-previous_block_start(second_plane_axis|)
      ' a line of no length: no offset
      IF direction_x=0 AND direction_y=0
        move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
        move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
        move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
        move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
      ELSE
        segment_length=SQR(direction_x*direction_x+direction_y*direction_y)
        ' tool radius over line length
        offset_scale=tool_radius/segment_length
        ' tool left of the line
        IF compensation_side$="L"
          IF direction_x=0
            IF direction_y>0
              move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-tool_radius
            ELSE
              move_compensated_start(first_plane_axis|)=tool_radius+previous_block_start(first_plane_axis|)
            ENDIF
            move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
          ELSE
            IF direction_y=0
              IF direction_x<0
                move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-tool_radius
              ELSE
                move_compensated_start(second_plane_axis|)=tool_radius+previous_block_start(second_plane_axis|)
              ENDIF
              move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
            ELSE
              move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-direction_y*offset_scale
              move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)+direction_x*offset_scale
            ENDIF
          ENDIF
        ELSE
          ' tool right of the line
          IF compensation_side$="R"
            IF direction_x=0
              IF direction_y<0
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)-tool_radius
              ELSE
                move_compensated_start(first_plane_axis|)=tool_radius+previous_block_start(first_plane_axis|)
              ENDIF
              move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x>0
                  move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-tool_radius
                ELSE
                  move_compensated_start(second_plane_axis|)=tool_radius+previous_block_start(second_plane_axis|)
                ENDIF
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)
              ELSE
                move_compensated_start(first_plane_axis|)=previous_block_start(first_plane_axis|)+direction_y*offset_scale
                move_compensated_start(second_plane_axis|)=previous_block_start(second_plane_axis|)-direction_x*offset_scale
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' the end point the same way
        IF compensation_side$="L"
          IF direction_x=0
            IF direction_y>0
              move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-tool_radius
            ELSE
              move_compensated_end(first_plane_axis|)=tool_radius+move_end(first_plane_axis|)
            ENDIF
            move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
          ELSE
            IF direction_y=0
              IF direction_x<0
                move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-tool_radius
              ELSE
                move_compensated_end(second_plane_axis|)=tool_radius+move_end(second_plane_axis|)
              ENDIF
              move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
            ELSE
              move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-direction_y*offset_scale
              move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)+direction_x*offset_scale
            ENDIF
          ENDIF
        ELSE
          IF compensation_side$="R"
            IF direction_x=0
              IF direction_y<0
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)-tool_radius
              ELSE
                move_compensated_end(first_plane_axis|)=tool_radius+move_end(first_plane_axis|)
              ENDIF
              move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)
            ELSE
              IF direction_y=0
                IF direction_x>0
                  move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-tool_radius
                ELSE
                  move_compensated_end(second_plane_axis|)=tool_radius+move_end(second_plane_axis|)
                ENDIF
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)
              ELSE
                move_compensated_end(first_plane_axis|)=move_end(first_plane_axis|)+direction_y*offset_scale
                move_compensated_end(second_plane_axis|)=move_end(second_plane_axis|)-direction_x*offset_scale
              ENDIF
            ENDIF
          ENDIF
        ENDIF
        ' the corner needs a line of some length
        IF direction_x<>0 OR direction_y<>0
          compensate_tool_radius(line_index&,0,arc_direction$,-1,second_is_line!)
        ENDIF
      ENDIF
    ELSE
      ' an arc: move its ends along the radius
      vector_x=previous_block_start(first_plane_axis|)-previous_centre(first_plane_axis|)
      vector_y=previous_block_start(second_plane_axis|)-previous_centre(second_plane_axis|)
      ' radius of the arc
      element_arc_radius=SQR(vector_x*vector_x+vector_y*vector_y)
      IF element_arc_radius>0
        uncompensated_radius=element_arc_radius
        ' tool right: an anticlockwise arc grows by the tool radius, a clockwise one shrinks
        IF compensation_side$="R"
          IF move_arc_direction$="+"
            element_arc_radius=element_arc_radius+tool_radius
          ELSE
            SUB element_arc_radius,tool_radius
          ENDIF
        ELSE
          ' tool left: the other way round
          IF compensation_side$="L"
            IF move_arc_direction$="-"
              element_arc_radius=element_arc_radius+tool_radius
            ELSE
              SUB element_arc_radius,tool_radius
            ENDIF
          ENDIF
        ENDIF
        move_compensated_start(first_plane_axis|)=element_arc_radius/uncompensated_radius*vector_x+previous_centre(first_plane_axis|)
        move_compensated_start(second_plane_axis|)=element_arc_radius/uncompensated_radius*vector_y+previous_centre(second_plane_axis|)
        point_distance=move_end(first_plane_axis|)-previous_centre(first_plane_axis|)
        work_point_y=move_end(second_plane_axis|)-previous_centre(second_plane_axis|)
        move_compensated_end(first_plane_axis|)=element_arc_radius/uncompensated_radius*point_distance+previous_centre(first_plane_axis|)
        move_compensated_end(second_plane_axis|)=element_arc_radius/uncompensated_radius*work_point_y+previous_centre(second_plane_axis|)
        compensate_tool_radius(line_index&,element_arc_radius,arc_direction$,0,second_is_line!)
      ENDIF
    ENDIF
    ' the tool does not fit inside the arc after the corner: clear the error (-1: none) and read the element after
    ' it as the next element, then work out the corner again
    IF run_aborted! AND error_blocks&(0)=-10
      run_aborted!=FALSE
      error_blocks&(0)=-1
      ' in the tool path; with path_line_index&=0 this reads element 1 again, the same element as before
      IF corner_from_path!
        IF path_line_index&=0
          line_index&=1
        ELSE
          INC line_index&
        ENDIF
        program_line$=tool_path_elements$(current_contour|,line_index&)
        following_block_text$=LEFT$(program_line$,2)
        IF following_block_text$="L "
          second_is_line!=TRUE
          read_line_target(program_line$)
        ELSE
          IF following_block_text$="CR"
            second_is_line!=FALSE
            interpret_radius_arc(program_line$)
          ELSE
            set_plane_from_centre(program_line$)
            read_circle_centre(program_line$)
            INC line_index&
            program_line$=tool_path_elements$(current_contour|,line_index&)
            following_block_text$=LEFT$(program_line$,2)
            IF following_block_text$="LP"
              second_is_line!=TRUE
              interpret_polar_line(program_line$)
            ELSE
              IF following_block_text$="C "
                second_is_line!=FALSE
                read_arc_target(program_line$,9,21)
                arc_direction$=@read_arc_direction$(program_line$,33)
              ELSE
                IF following_block_text$="CP"
                  second_is_line!=FALSE
                  interpret_polar_arc(program_line$)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ELSE
        ' in the NC program: on to the next contour element
        skip_to_next_block(line_index&)
        program_line$=program_lines$(line_index&)
        following_block_text$=LEFT$(program_line$,2)
        WHILE NOT (following_block_text$="L ") AND LEN(program_line$)>20 OR (following_block_text$="LP") OR (following_block_text$="CC") OR (following_block_text$="C ") OR (following_block_text$="CP") OR (following_block_text$="CR")
          skip_to_next_block(line_index&)
          program_line$=program_lines$(line_index&)
          following_block_text$=LEFT$(program_line$,2)
        WEND
        IF following_block_text$="L "
          second_is_line!=TRUE
          read_line_target(program_line$)
        ELSE
          IF following_block_text$="CR"
            second_is_line!=FALSE
            interpret_radius_arc(program_line$)
          ELSE
            set_plane_from_centre(program_line$)
            read_circle_centre(program_line$)
            skip_to_next_block(line_index&)
            program_line$=program_lines$(line_index&)
            following_block_text$=LEFT$(program_line$,2)
            IF following_block_text$="LP"
              second_is_line!=TRUE
              interpret_polar_line(program_line$)
            ELSE
              IF following_block_text$="C "
                second_is_line!=FALSE
                read_arc_target(program_line$,9,21)
                arc_direction$=@read_arc_direction$(program_line$,33)
              ELSE
                IF following_block_text$="CP"
                  second_is_line!=FALSE
                  interpret_polar_arc(program_line$)
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      radius_correction$=compensation_side$
    ELSE
      ' the corner is done
      search_found!=TRUE
    ENDIF
  UNTIL search_found!
RETURN
' Reverses the direction of the tool path tool_path_elements$(current_contour|,..) of the current contour. A
' path of fewer than two blocks stops the run with an alert. Otherwise the path is copied backwards into
' reversed_path_elements$(): line 0 stays first; every line or arc end ("L ", "C ") takes as its end point the
' X/Y/Z of the element before it (take_previous_end_point), arcs swap "R+" and "R-" and keep their "CC" centre
' line in front of them. Unless the run was stopped (run_aborted!, stop_requested!) the reversed lines replace
' the path.
PROCEDURE reverse_tool_path
  LOCAL x_axis_flag!,y_axis_flag!,z_axis_flag!,element_count&,arc_end_layer&,item_count&,line_index&,program_line$,following_block_text$,scan_index&,input_column&,input_row&,z_value_column&,alert_button|
  ' last element of the tool path
  arc_end_layer&=tool_path_line_count&(current_contour|)-1
  ' the path has only its start point and one block
  IF tool_path_line_count&(current_contour|)<2
    ALERT 3,"Eine Teilkontur muû mehr|als einen Satz enthalten!",1,"Abbruch",alert_button|
    ' stop the run
    run_aborted!=TRUE
    ' the line to show: the sub-contour's LBL
    error_blocks&(0)=label_start_line&(contour_label&(current_contour|))
    error_messages$(0)="TEILKONTUR MUSS MEHR ALS EINEN SATZ ENTHALTEN!"
  ELSE
    element_count&=0
    ' the reversed path is built here
    DIM reversed_path_elements$(arc_end_layer&)
    ' the first line (start of the path) stays first
    reversed_path_elements$(0)=tool_path_elements$(current_contour|,0)
    ' next line of the reversed path
    item_count&=1
    ' walk the path from its last element back
    line_index&=arc_end_layer&
    REPEAT
      ON MENU
      ' element to reverse
      program_line$=tool_path_elements$(current_contour|,line_index&)
      following_block_text$=LEFT$(program_line$,2)
      ' a line or an arc end: its end point is replaced by its start point
      IF (following_block_text$="L ") OR (following_block_text$="C ")
        ' find the X, Y and Z columns of the element
        scan_index&=4
        x_axis_flag!=FALSE
        y_axis_flag!=FALSE
        z_axis_flag!=FALSE
        REPEAT
          INC scan_index&
          ' X value follows at input_column&
          IF MID$(program_line$,scan_index&,1)="X"
            x_axis_flag!=TRUE
            input_column&=scan_index&+1
          ELSE
            ' Y value follows at input_row&
            IF MID$(program_line$,scan_index&,1)="Y"
              y_axis_flag!=TRUE
              input_row&=scan_index&+1
            ELSE
              ' Z value follows at z_value_column&
              IF MID$(program_line$,scan_index&,1)="Z"
                z_axis_flag!=TRUE
                z_value_column&=scan_index&+1
              ENDIF
            ENDIF
          ENDIF
        UNTIL scan_index&=33
        ' take X/Y/Z from the end of the elements before (the start of this one)
        take_previous_end_point(-1,0,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,program_line$)
        ' an arc runs the other way when reversed
        IF MID$(program_line$,32,2)="R+"
          MID$(program_line$,32,2)=("R-")
        ELSE
          IF MID$(program_line$,32,2)="R-"
            MID$(program_line$,32,2)=("R+")
          ENDIF
        ENDIF
        ' an arc: its centre line goes before it
        IF LEFT$(tool_path_elements$(current_contour|,PRED(line_index&)),2)="CC"
          ' centre line first
          reversed_path_elements$(item_count&)=tool_path_elements$(current_contour|,PRED(line_index&))
          INC item_count&
          ' then the arc end
          reversed_path_elements$(item_count&)=program_line$
          DEC line_index&
        ELSE
          reversed_path_elements$(item_count&)=program_line$
        ENDIF
      ELSE
        reversed_path_elements$(item_count&)=program_line$
      ENDIF
      INC item_count&
      DEC line_index&
      ' down to the start, or the run was stopped
    UNTIL line_index&=0 OR run_aborted! OR stop_requested!
    ' not stopped: the reversed path replaces the old one
    IF (NOT run_aborted!) AND (NOT stop_requested!)
      FOR search_line&=0 TO PRED(item_count&)
        tool_path_elements$(current_contour|,search_line&)=reversed_path_elements$(search_line&)
      NEXT search_line&
    ENDIF
    ERASE reversed_path_elements$()
  ENDIF
RETURN
' Fills in the end point of element program_line$ from the elements before element line_index& of contour
' current_contour|: for each of X, Y, Z still wanted (x_axis_flag!, y_axis_flag!, z_axis_flag!) it walks back to
' the nearest line or arc end that has that axis and copies its 11-character value into program_line$ at column
' input_column&, input_row& or z_value_column&. read_offset_contour! TRUE reads the offset contour
' offset_contour_elements$(), FALSE the tool path tool_path_elements$(). write_coordinates! is not used.
PROCEDURE take_previous_end_point(write_coordinates!,read_offset_contour!,line_index&,x_axis_flag!,y_axis_flag!,z_axis_flag!,input_column&,input_row&,z_value_column&,VAR program_line$)
  LOCAL work_text$,previous_element_prefix$,scan_index&,corner_text_h$,corner_text_v$,z_value_text$
  ' keep the menus alive while searching
  ON MENU
  REPEAT
    ' one element further back
    DEC line_index&
    ' read from the offset contour offset_contour_elements$() / ELSE the tool path tool_path_elements$()
    IF read_offset_contour!
      work_text$=offset_contour_elements$(current_contour|,line_index&)
    ELSE
      work_text$=tool_path_elements$(current_contour|,line_index&)
    ENDIF
    previous_element_prefix$=LEFT$(work_text$,2)
    ' this element has an end point
    IF (previous_element_prefix$="L ") OR (previous_element_prefix$="C ")
      ' the X value is still wanted
      IF x_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="X") OR scan_index&=32
        ' this element has an X value
        IF scan_index&<32
          INC scan_index&
          ' its X value (11 characters)
          corner_text_h$=MID$(work_text$,scan_index&,11)
          MID$(program_line$,PRED(input_column&),1)=("X")
          ' goes into the element being reversed
          MID$(program_line$,input_column&,11)=(corner_text_h$)
          x_axis_flag!=FALSE
        ENDIF
      ENDIF
      ' the Y value is still wanted
      IF y_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="Y") OR scan_index&=32
        IF scan_index&<32
          INC scan_index&
          corner_text_v$=MID$(work_text$,scan_index&,11)
          MID$(program_line$,PRED(input_row&),1)=("Y")
          MID$(program_line$,input_row&,11)=(corner_text_v$)
          y_axis_flag!=FALSE
        ENDIF
      ENDIF
      ' the Z value is still wanted
      IF z_axis_flag!
        scan_index&=4
        REPEAT
          INC scan_index&
        UNTIL (MID$(work_text$,scan_index&,1)="Z") OR scan_index&=33
        IF scan_index&<33
          INC scan_index&
          z_value_text$=MID$(work_text$,scan_index&,11)
          MID$(program_line$,PRED(z_value_column&),1)=("Z")
          MID$(program_line$,z_value_column&,11)=(z_value_text$)
          z_axis_flag!=FALSE
        ENDIF
      ENDIF
    ENDIF
    ' until every wanted value is found
  UNTIL (NOT x_axis_flag!) AND (NOT y_axis_flag!) AND (NOT z_axis_flag!)
RETURN
' Saves (pending_store! TRUE) or restores (FALSE) the state of the NC program run around a contour cycle: the
' line pointers current_block&, current_draw_block&, next_block&, block_after_next&, third_block_ahead&, the
' plane and infeed axes pending_first_axis|..pending_tool_axis|, the block start and end points, arc centres,
' programmed position, datum offset and axis vectors of the transformation (start_point() ..
' previous_datum_second_axis()), the correction strings and the mirroring, rotation and scaling state
' (datum_shift_on!..scaling_active!, rotation_angle, rotation_spare_value, scaling_factor, after_line_element!,
' arc_pending!, state_extra_flag!).
PROCEDURE save_restore_program_state(pending_store!)
  ' TRUE saves the state, FALSE restores it
  IF pending_store!
    ' line pointers
    saved_element_line&=current_draw_block&
    saved_program_line&=current_block&
    state_saved_current_line&=next_block&
    state_saved_next_line&=block_after_next&
    state_saved_following_line&=third_block_ahead&
    ' programmed plane and infeed axes
    state_saved_plane_first_axis|=pending_first_axis|
    state_saved_plane_second_axis|=pending_second_axis|
    state_saved_infeed_axis|=pending_tool_axis|
    ' block and transformation coordinates, X/Y/Z
    saved_block_start_x=start_point(1)
    saved_block_start_y=start_point(2)
    saved_block_start_z=start_point(3)
    saved_previous_start_x=previous_block_start(1)
    saved_previous_start_y=previous_block_start(2)
    saved_previous_start_z=previous_block_start(3)
    saved_block_end_x=end_point(1)
    saved_block_end_y=end_point(2)
    saved_block_end_z=end_point(3)
    saved_previous_end_x=move_end(1)
    saved_previous_end_y=move_end(2)
    saved_previous_end_z=move_end(3)
    saved_block_target_x=programmed_position(1)
    saved_block_target_y=programmed_position(2)
    saved_block_target_z=programmed_position(3)
    saved_programmed_position_x=rotated_position(1)
    saved_programmed_position_y=rotated_position(2)
    saved_programmed_position_z=rotated_position(3)
    saved_next_centre_x=circle_centre(1)
    saved_next_centre_y=circle_centre(2)
    saved_previous_centre_x=previous_centre(1)
    saved_previous_centre_y=previous_centre(2)
    saved_direction_x=start_tangent(1)
    saved_direction_y=start_tangent(2)
    saved_direction_z=start_tangent(3)
    saved_datum_offset_x=datum_shift(1)
    saved_datum_offset_y=datum_shift(2)
    saved_datum_offset_z=datum_shift(3)
    saved_programmed_datum_x=datum_shift_in_plane(1)
    saved_programmed_datum_y=datum_shift_in_plane(2)
    saved_programmed_datum_z=datum_shift_in_plane(3)
    saved_first_axis_vector_x=rotated_first_axis(1)
    saved_first_axis_vector_y=rotated_first_axis(2)
    saved_first_axis_vector_z=rotated_first_axis(3)
    saved_previous_first_axis_x=previous_rotated_first_axis(1)
    saved_previous_first_axis_y=previous_rotated_first_axis(2)
    saved_previous_first_axis_z=previous_rotated_first_axis(3)
    saved_second_axis_vector_x=rotated_second_axis(1)
    saved_second_axis_vector_y=rotated_second_axis(2)
    saved_second_axis_vector_z=rotated_second_axis(3)
    saved_previous_second_axis_x=previous_rotated_second_axis(1)
    saved_previous_second_axis_y=previous_rotated_second_axis(2)
    saved_previous_second_axis_z=previous_rotated_second_axis(3)
    saved_datum_first_axis_x=datum_first_axis(1)
    saved_datum_first_axis_y=datum_first_axis(2)
    saved_datum_first_axis_z=datum_first_axis(3)
    saved_previous_datum_first_axis_x=previous_datum_first_axis(1)
    saved_previous_datum_first_axis_y=previous_datum_first_axis(2)
    saved_previous_datum_first_axis_z=previous_datum_first_axis(3)
    saved_datum_second_axis_x=datum_second_axis(1)
    saved_datum_second_axis_y=datum_second_axis(2)
    saved_datum_second_axis_z=datum_second_axis(3)
    saved_previous_datum_second_axis_x=previous_datum_second_axis(1)
    saved_previous_datum_second_axis_y=previous_datum_second_axis(2)
    saved_previous_datum_second_axis_z=previous_datum_second_axis(3)
    ' programmed radius correction
    chamfer_saved_correction$=radius_correction$
    ' correction side
    saved_compensation$=compensation_side$
    ' side at the start
    saved_start_side$=previous_compensation$
    ' arc direction
    saved_next_arc_direction$=arc_direction$
    ' mirroring, rotation and scaling state
    saved_mirroring!=datum_shift_on!
    saved_mirror_x!=mirror_x!
    saved_mirror_y!=mirror_y!
    saved_mirror_z!=mirror_z!
    saved_mirror_reversal!=mirror_reverses_direction!
    saved_x_unrotated!=mirror_x_after_rotation!
    saved_y_unrotated!=mirror_y_after_rotation!
    saved_z_unrotated!=mirror_z_after_rotation!
    saved_rotation_active!=rotation_active!
    ' rotation angle
    cycle_saved_rotation_angle=rotation_angle
    cycle_saved_rotation_value=rotation_spare_value
    saved_scaling_active!=scaling_active!
    ' scale factor
    cycle_saved_scale_factor=scaling_factor
    saved_after_line_state!=after_line_element!
    cycle_saved_arc_pending!=arc_pending!
    cycle_saved_state_extra_flag!=state_extra_flag!
  ELSE
    ' restore everything saved above
    current_draw_block&=saved_element_line&
    current_block&=saved_program_line&
    next_block&=state_saved_current_line&
    block_after_next&=state_saved_next_line&
    third_block_ahead&=state_saved_following_line&
    pending_first_axis|=state_saved_plane_first_axis|
    pending_second_axis|=state_saved_plane_second_axis|
    pending_tool_axis|=state_saved_infeed_axis|
    start_point(1)=saved_block_start_x
    start_point(2)=saved_block_start_y
    start_point(3)=saved_block_start_z
    previous_block_start(1)=saved_previous_start_x
    previous_block_start(2)=saved_previous_start_y
    previous_block_start(3)=saved_previous_start_z
    end_point(1)=saved_block_end_x
    end_point(2)=saved_block_end_y
    end_point(3)=saved_block_end_z
    move_end(1)=saved_previous_end_x
    move_end(2)=saved_previous_end_y
    move_end(3)=saved_previous_end_z
    programmed_position(1)=saved_block_target_x
    programmed_position(2)=saved_block_target_y
    programmed_position(3)=saved_block_target_z
    rotated_position(1)=saved_programmed_position_x
    rotated_position(2)=saved_programmed_position_y
    rotated_position(3)=saved_programmed_position_z
    circle_centre(1)=saved_next_centre_x
    circle_centre(2)=saved_next_centre_y
    previous_centre(1)=saved_previous_centre_x
    previous_centre(2)=saved_previous_centre_y
    start_tangent(1)=saved_direction_x
    start_tangent(2)=saved_direction_y
    start_tangent(3)=saved_direction_z
    datum_shift(1)=saved_datum_offset_x
    datum_shift(2)=saved_datum_offset_y
    datum_shift(3)=saved_datum_offset_z
    datum_shift_in_plane(1)=saved_programmed_datum_x
    datum_shift_in_plane(2)=saved_programmed_datum_y
    datum_shift_in_plane(3)=saved_programmed_datum_z
    rotated_first_axis(1)=saved_first_axis_vector_x
    rotated_first_axis(2)=saved_first_axis_vector_y
    rotated_first_axis(3)=saved_first_axis_vector_z
    previous_rotated_first_axis(1)=saved_previous_first_axis_x
    previous_rotated_first_axis(2)=saved_previous_first_axis_y
    previous_rotated_first_axis(3)=saved_previous_first_axis_z
    rotated_second_axis(1)=saved_second_axis_vector_x
    rotated_second_axis(2)=saved_second_axis_vector_y
    rotated_second_axis(3)=saved_second_axis_vector_z
    previous_rotated_second_axis(1)=saved_previous_second_axis_x
    previous_rotated_second_axis(2)=saved_previous_second_axis_y
    previous_rotated_second_axis(3)=saved_previous_second_axis_z
    datum_first_axis(1)=saved_datum_first_axis_x
    datum_first_axis(2)=saved_datum_first_axis_y
    datum_first_axis(3)=saved_datum_first_axis_z
    previous_datum_first_axis(1)=saved_previous_datum_first_axis_x
    previous_datum_first_axis(2)=saved_previous_datum_first_axis_y
    previous_datum_first_axis(3)=saved_previous_datum_first_axis_z
    datum_second_axis(1)=saved_datum_second_axis_x
    datum_second_axis(2)=saved_datum_second_axis_y
    datum_second_axis(3)=saved_datum_second_axis_z
    previous_datum_second_axis(1)=saved_previous_datum_second_axis_x
    previous_datum_second_axis(2)=saved_previous_datum_second_axis_y
    previous_datum_second_axis(3)=saved_previous_datum_second_axis_z
    radius_correction$=chamfer_saved_correction$
    compensation_side$=saved_compensation$
    previous_compensation$=saved_start_side$
    arc_direction$=saved_next_arc_direction$
    datum_shift_on!=saved_mirroring!
    mirror_x!=saved_mirror_x!
    mirror_y!=saved_mirror_y!
    mirror_z!=saved_mirror_z!
    mirror_reverses_direction!=saved_mirror_reversal!
    mirror_x_after_rotation!=saved_x_unrotated!
    mirror_y_after_rotation!=saved_y_unrotated!
    mirror_z_after_rotation!=saved_z_unrotated!
    rotation_active!=saved_rotation_active!
    rotation_angle=cycle_saved_rotation_angle
    rotation_spare_value=cycle_saved_rotation_value
    scaling_active!=saved_scaling_active!
    scaling_factor=cycle_saved_scale_factor
    after_line_element!=saved_after_line_state!
    arc_pending!=cycle_saved_arc_pending!
    state_extra_flag!=cycle_saved_state_extra_flag!
  ENDIF
RETURN
' Opens file work_text$ for output as channel parameter_number&. The file is first made with Fcreate to see
' whether that is possible; then the handle is closed and OPEN "o" opens it. Returns 0 on success, otherwise the
' negative TOS error from Fcreate.
FUNCTION create_output_file(parameter_number&,work_text$)
  $F%
  LOCAL file_handle&
  ~FRE(0)
  work_text$=work_text$+CHR$(0)
  ' Fcreate: test that the file can be made
  file_handle&=GEMDOS(60,L:V:work_text$,0)
  ' a handle: it can
  IF file_handle&>0
    ~GEMDOS(62,file_handle&)
    OPEN "o",#parameter_number&,work_text$
    RETURN 0
  ENDIF
  ' the TOS error
  RETURN file_handle&
ENDFUNC
' The program's file selector: work_text$ is the title, program_directory$ the path with its wildcard,
' selected_file_name$ the file name offered. AES 3.20 and later get FSEL_EXINPUT with the title
' (file_selector_with_title), older ones FSEL_INPUT. Returns the folder of the chosen path with the chosen file
' name, or "" on Cancel or an error.
FUNCTION select_file$(work_text$,program_directory$,selected_file_name$)
  LOCAL file_selector_result&,rect_width&
  ~WIND_UPDATE(1)
  ~FRE(0)
  ' AES before 3.20 has no titled file selector
  IF INT{LONG{GB+4}}<320
    file_selector_result&=FSEL_INPUT(program_directory$,selected_file_name$,rect_width&)
  ELSE
    file_selector_result&=@file_selector_with_title(work_text$,program_directory$,selected_file_name$,rect_width&)
  ENDIF
  ~WIND_UPDATE(0)
  IF file_selector_result&=0 OR rect_width&=0
    RETURN ""
  ENDIF
  ' the folder of the path with the chosen name
  RETURN LEFT$(program_directory$,RINSTR(program_directory$,"\"))+selected_file_name$
ENDFUNC
' FSEL_EXINPUT (AES 91) by hand: title work_text$, path program_directory$ and file name selected_file_name$
' (both given room to grow and read back as C strings). rect_width& gets the button, 0 for Cancel.
FUNCTION file_selector_with_title(work_text$,VAR program_directory$,selected_file_name$,rect_width&)
  $F%
  work_text$=work_text$+CHR$(0)
  program_directory$=program_directory$+CHR$(0)+SPACE$(400)
  selected_file_name$=selected_file_name$+CHR$(0)+SPACE$(150)
  ' FSEL_EXINPUT
  GCONTRL(0)=91
  GCONTRL(1)=0
  GCONTRL(2)=2
  GCONTRL(3)=3
  GCONTRL(4)=0
  ~FRE(0)
  ADDRIN(0)=V:program_directory$
  ADDRIN(1)=V:selected_file_name$
  ADDRIN(2)=V:work_text$
  GEMSYS
  program_directory$=CHAR{V:program_directory$}
  selected_file_name$=CHAR{V:selected_file_name$}
  ' the button (0 = Cancel)
  rect_width&=GINTOUT(1)
  RETURN GINTOUT(0)
ENDFUNC
' Program clean-up, not called anywhere: puts the starting screen back, frees the extra screen buffer and the
' resource (END if that fails), stops the resource module and, when loaded, stops and shuts down the dialog
' module.
PROCEDURE release_system_resources
  ' Setscreen back to the screen the program started with
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
  IF work_memory_block%>0
    ' free the extra screen buffer
    ~GEMDOS(73,L:work_memory_block%)
  ENDIF
  ' free the resource
  IF @rsc_free_file=0
    END
  ENDIF
  rsc_module_stop
  ' the dialog module is loaded
  IF dialog_module_loaded!
    ~@dial_module_stop
    ~@dial_exit
  ENDIF
  ON BREAK
RETURN
' The ON ERROR GOSUB handler. It sets the fill and text attributes, the program's own screen and clipping back,
' arms itself again and then, by ERR: -13 (write-protected disk): nothing more; 3, 10: alert "Das Satzformat ist
' falsch" (the block format is wrong); 4: alert that the coordinates are out of range and are ignored
' (redraw_requested! set for the loop at label_34f56); 8: alert that memory is short, and the window and line
' counts are put back to their smaller values; 61: alert that memory could not be reserved; anything else: the
' runtime's error text. It then resumes at the main loop label_0e112 or, by the mode flags editor_mode!,
' manual_mode!, program_run_mode! (and simulation_running!), at label_0da10, label_0deaa or label_34f56.
PROCEDURE handle_program_error
  LOCAL alert_button|
  DEFFILL 0,1,1
  DEFTEXT 1,0,0,text_height|
  ~XBIOS(5,L:logical_screen%,L:physical_screen%,-1)
  CLIP work_x&,work_y&,work_w&,work_h& OFFSET work_x&,work_y&
  GRAPHMODE 1
  ' arm the handler again for the next error
  ON ERROR GOSUB handle_program_error
  SELECT ERR
  CASE -13
    DEFMOUSE 3
    ' resume the loop of the mode the program is in
    IF editor_mode!
      RESUME edit_mode_setup
    ELSE
      IF manual_mode!
        RESUME manual_mode_setup
      ELSE
        IF program_run_mode!
          RESUME run_mode_setup
        ENDIF
      ENDIF
    ENDIF
  CASE 3,10
    ' CASE 3,10: "the block format is wrong, please enter the block again"
    ALERT 3,"Das Satzformat ist falsch!|Bitte geben Sie den Satz|neu ein!",1," Weiter ",alert_button|
    RESUME edit_mode_setup
  CASE 4
    ' CASE 4: "the coordinates are outside the allowed range and are ignored"
    ALERT 3,"Die Koordinaten befinden|sich auûerhalb des erlaubten|Bereiches und werden|deshalb ignoriert!",1," Weiter ",alert_button|
    IF program_run_mode!
      ' tell the loop at label_34f56 the coordinates were dropped
      redraw_requested!=TRUE
      RESUME handle_redraw_request
    ELSE
      RESUME edit_mode_setup
    ENDIF
  CASE 8
    ' CASE 8: "not enough memory for the application"
    ALERT 3,"Der vorhandene Speicher|reicht fÅr die Anwendung|nicht aus!",1,"Abbruch",alert_button|
    ' back to the smaller window and line counts
    window_x&=saved_window_x&
    window_y&=saved_window_y&
    window_w&=saved_window_w&
    window_h&=saved_window_h&
    depth_levels|=saved_depth_levels|
    IF depth_levels|<=depth_levels_max|
      depth_levels_used|=layer_depth_count|
    ELSE
      depth_levels|=depth_levels_max|
      depth_levels_used|=depth_levels_max|
    ENDIF
    depth_levels_less_one|=PRED(depth_levels|)
    depth_level_slots|=SUCC(depth_levels|)
    layer_depth_count|=depth_levels|
    top_level|=SUCC(layer_depth_count|)
    depth_copy_less_one|=PRED(layer_depth_count|)
    depth_used_plus_one|=SUCC(depth_levels_used|)
    depth_used_less_one|=PRED(depth_levels_used|)
    IF program_run_mode!
      RESUME run_mode_setup
    ELSE
      RESUME edit_mode_setup
    ENDIF
  CASE 61
    ' CASE 61: "error reserving the memory needed"
    ALERT 3,"Fehler beim Reservieren|des benîtigten Speichers!",1,"Abbruch",alert_button|
    RESUME edit_mode_setup
  DEFAULT
    ~FORM_ALERT(1,ERR$(ERR))
    DEFMOUSE 3
    IF editor_mode!
      RESUME edit_mode_setup
    ELSE
      IF manual_mode!
        RESUME manual_mode_setup
      ELSE
        IF program_run_mode!
          IF simulation_running!
            redraw_requested!=TRUE
            RESUME handle_redraw_request
          ELSE
            RESUME run_mode_setup
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDSELECT
RETURN
$C+
' Loads the resource overlay MODUL1.OVL from the program folder program_folder$ (asking for it with the file
' selector when it is missing; END when it is not found or memory is under 12000 bytes). It is loaded with Pexec
' mode 3 and started with its basepage; on success resource_module_block% is its call block,
' resource_module_entry% its entry and resource_module_loaded! is set.
PROCEDURE load_resource_module
  LOCAL overlay_file_name$,overlay_command_line$,selected_file$,load_overlay!,alert_button|,work_text$
  IF FRE(0)<12000
    ' "not enough memory for the program"
    ALERT 3,"Der vorhandene Speicher|reicht fÅr das Programm|nicht aus!",1,"Abbruch",alert_button|
    END
  ELSE
    ' the resource overlay
    overlay_file_name$="MODUL1.OVL"
    overlay_command_line$=program_folder$
    ' in the program folder
    selected_file$=overlay_command_line$+"\"+overlay_file_name$
    load_overlay!=TRUE
    ' not there
    IF NOT @file_found(selected_file$)
      ' "not found, please find the extra module with the file selector"
      ALERT 3,">MODUL1.OVL< konnte nicht|gefunden werden. Bitte suchen|Sie das Zusatzmodul mit der|Fileselectorbox!",1," Weiter ",alert_button|
      ' "load module 1"
      work_text$=@select_file$("Modul1 laden",program_folder$+"\*.OVL","MODUL1.OVL")
      DEFMOUSE 3
      ' not chosen
      IF RIGHT$(work_text$,10)<>"MODUL1.OVL"
        ' "the extra module could not be loaded, so the program ends"
        ALERT 3,"Das Zusatzmodul konnte|nicht geladen werden.|Deshalb wird das Programm|nun beendet!",1,"Abbruch",alert_button|
        END
      ENDIF
      selected_file$=work_text$
    ENDIF
    IF load_overlay!
      selected_file$=selected_file$+CHR$(0)
      ' empty command line and environment
      overlay_command_line$=STRING$(25,0)
      ' Pexec mode 3: load the overlay without starting it
      overlay_basepage%=GEMDOS(75,3,L:V:selected_file$,L:V:overlay_command_line$,L:V:overlay_command_line$)
      ' its basepage, freed at the end
      modul_one_block%=overlay_basepage%
      ' loaded
      IF overlay_basepage%>=0
        ' start of its text: the module's call block
        resource_module_block%=LONG{overlay_basepage%+8}
        ' a buffer for the module
        selected_file$=STRING$(100,0)
        LONG{resource_module_block%+4}=V:selected_file$
        ' run the module's start-up with its basepage
        overlay_result%=C:resource_module_block%(L:overlay_basepage%)
        ' started
        IF overlay_result%=0
          ' the module's entry for calls
          resource_module_entry%=LONG{resource_module_block%+42}
          resource_module_loaded!=TRUE
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Loads the dialog overlay MODUL2.OVL the same way (END when it is missing or memory is under 38000 bytes):
' dialog_module_block% is its call block, dialog_module_entry% its entry, dialog_module_loaded! is set; then the
' module and its dialog library are started (dial_module_start, dial_init), END when that fails.
PROCEDURE load_dialog_module
  LOCAL overlay_file_name$,overlay_command_line$,selected_file$,load_overlay!,alert_button|,work_text$
  IF FRE(0)<38000
    ALERT 3,"Der vorhandene Speicher|reicht fÅr das Programm|nicht aus!",1,"Abbruch",alert_button|
    END
  ELSE
    ' the dialog overlay
    overlay_file_name$="MODUL2.OVL"
    overlay_command_line$=program_folder$
    selected_file$=overlay_command_line$+"\"+overlay_file_name$
    load_overlay!=TRUE
    IF NOT @file_found(selected_file$)
      ALERT 3,">MODUL2.OVL< konnte nicht|gefunden werden. Bitte suchen|Sie das Zusatzmodul mit der|Fileselectorbox!",1," Weiter ",alert_button|
      ' "load module 2"
      work_text$=@select_file$("Modul2 laden",program_folder$+"\*.OVL","MODUL2.OVL")
      DEFMOUSE 3
      IF RIGHT$(work_text$,10)<>"MODUL2.OVL"
        ALERT 3,"Das Zusatzmodul konnte|nicht geladen werden.|Deshalb wird das Programm|nun beendet!",1,"Abbruch",alert_button|
        END
      ENDIF
      selected_file$=work_text$
    ENDIF
    IF load_overlay!
      selected_file$=selected_file$+CHR$(0)
      overlay_command_line$=STRING$(25,0)
      ' Pexec mode 3: load without starting
      overlay_basepage%=GEMDOS(75,3,L:V:selected_file$,L:V:overlay_command_line$,L:V:overlay_command_line$)
      ' its basepage, freed at the end
      modul_two_block%=overlay_basepage%
      IF overlay_basepage%>=0
        ' the module's call block
        dialog_module_block%=LONG{overlay_basepage%+8}
        selected_file$=STRING$(100,0)
        LONG{dialog_module_block%+4}=V:selected_file$
        overlay_result%=C:dialog_module_block%(L:overlay_basepage%)
        IF overlay_result%=0
          ' the module's entry for calls
          dialog_module_entry%=LONG{dialog_module_block%+42}
          ' dialog module ready
          dialog_module_loaded!=TRUE
          ~@dial_module_start
          overlay_result%=0
          dialog_init_word&=0
          dialog_init_flags&=0
          IF @dial_init(dialog_init_word&,overlay_result%,dialog_init_flags&)=0
            END
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
RETURN
' Works out the program folder into third_block_text$: from the command line when it starts "cnc" followed by a
' length byte and the folder, else the current drive and folder.
PROCEDURE get_program_folder(VAR third_block_text$)
  LOCAL file_byte|,loop_index|
  ' the command line starts "cnc": the folder follows
  IF PEEK(128+BASEPAGE)=99 AND PEEK(129+BASEPAGE)=110 AND PEEK(130+BASEPAGE)=99
    ' its length
    file_byte|=PEEK(131+BASEPAGE)
    third_block_text$=""
    FOR loop_index|=1 TO file_byte|
      third_block_text$=third_block_text$+CHR$(PEEK(loop_index|+(131+BASEPAGE)))
    NEXT loop_index|
  ELSE
    ' else the current drive
    third_block_text$=CHR$(65+GEMDOS(25))+":"+STRING$(128,0)
    ~GEMDOS(71,L:V:third_block_text$+2,0)
    third_block_text$=CHAR{V:third_block_text$}
  ENDIF
RETURN
' Returns TRUE (-1) when file third_block_text$ exists (Fsfirst), else FALSE.
FUNCTION file_found(third_block_text$)
  $F%
  IF LEN(third_block_text$)=0
    RETURN 0
  ELSE
    third_block_text$=third_block_text$+CHR$(0)
    ' Fsfirst found it
    IF GEMDOS(78,L:V:third_block_text$,0)=0
      RETURN -1
    ELSE
      RETURN 0
    ENDIF
  ENDIF
ENDFUNC
' RESERVE with the size reserve_size% rounded up to whole 256 bytes (a negative size gives memory back). Nothing
' calls it: the program's memory is fixed by $m800000 and is not given back.
PROCEDURE reserve_memory_rounded(reserve_size%)
  LOCAL negative_size!
  ' a negative size gives memory back
  IF reserve_size%<0
    negative_size!=TRUE
    reserve_size%=-reserve_size%
  ENDIF
  ' round up to 256 bytes
  reserve_size%=255+reserve_size% AND -256
  IF negative_size!
    reserve_size%=-reserve_size%
  ENDIF
  RESERVE reserve_size%+FRE(0)
RETURN
' Loads resource file resource_file_name$: through the resource module (function 1) when it is loaded, else with
' RSRC_LOAD. Returns the result (0 = error).
FUNCTION rsc_load_file(resource_file_name$)
  LOCAL module_call_result%
  ' through the resource module
  IF resource_module_loaded!
    resource_file_name$=resource_file_name$+CHR$(0)
    ' function 1: load a resource file
    CARD{resource_module_block%+40}=1
    LONG{resource_module_block%+20}=V:resource_file_name$
    module_call_result%=C:resource_module_entry%()
  ELSE
    module_call_result%=RSRC_LOAD(resource_file_name$)
  ENDIF
  RETURN module_call_result%
ENDFUNC
' Frees the resource: resource module function 2, or RSRC_FREE. Returns the result (0 = error).
FUNCTION rsc_free_file
  LOCAL module_call_result%
  IF resource_module_loaded!
    ' function 2: free the resource
    CARD{resource_module_block%+40}=2
    module_call_result%=C:resource_module_entry%()
  ELSE
    module_call_result%=RSRC_FREE()
  ENDIF
  RETURN module_call_result%
ENDFUNC
' RSRC_GADDR: address of tree or object resource_index& of type resource_type& into resource_address%, through
' resource module function 3 when loaded.
FUNCTION rsc_get_address(resource_type&,resource_index&,VAR resource_address%)
  LOCAL module_call_result%
  IF resource_module_loaded!
    ' function 3: address of a tree or object
    CARD{resource_module_block%+40}=3
    CARD{resource_module_block%+4}=resource_type&
    CARD{resource_module_block%+6}=resource_index&
    LONG{resource_module_block%+20}=V:resource_address%
    module_call_result%=C:resource_module_entry%()
  ELSE
    module_call_result%=RSRC_GADDR(resource_type&,resource_index&,resource_address%)
  ENDIF
  RETURN module_call_result%
ENDFUNC
' RSRC_SADDR, through resource module function 4 when loaded. Not called.
FUNCTION rsc_set_address(resource_type&,resource_index&,VAR resource_address%)
  LOCAL module_call_result%
  IF resource_module_loaded!
    ' function 4: set an address
    CARD{resource_module_block%+40}=4
    CARD{resource_module_block%+4}=resource_type&
    CARD{resource_module_block%+6}=resource_index&
    LONG{resource_module_block%+20}=V:resource_address%
    module_call_result%=C:resource_module_entry%()
  ELSE
    module_call_result%=RSRC_SADDR(resource_type&,resource_index&,resource_address%)
  ENDIF
  RETURN module_call_result%
ENDFUNC
' RSRC_OBFIX for object resource_object& of tree resource_address%, through resource module function 5 when
' loaded. Not called.
FUNCTION rsc_fix_object(resource_address%,resource_object&)
  LOCAL module_call_result%
  IF resource_module_loaded!
    ' function 5: object to screen coordinates
    CARD{resource_module_block%+40}=5
    CARD{resource_module_block%+4}=resource_object&
    LONG{resource_module_block%+20}=resource_address%
    module_call_result%=C:resource_module_entry%()
  ELSE
    module_call_result%=RSRC_OBFIX(resource_address%,resource_object&)
  ENDIF
  RETURN module_call_result%
ENDFUNC
' Starts the resource module (function 128) when it is loaded.
PROCEDURE rsc_module_start
  IF resource_module_loaded!
    ' start the module
    CARD{resource_module_block%+40}=128
    module_call_result%=C:resource_module_entry%()
  ENDIF
RETURN
' Stops the resource module (function 129) when it is loaded.
PROCEDURE rsc_module_stop
  IF resource_module_loaded!
    ' stop the module
    CARD{resource_module_block%+40}=129
    module_call_result%=C:resource_module_entry%()
  ENDIF
RETURN
